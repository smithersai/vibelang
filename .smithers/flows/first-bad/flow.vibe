import { Action, Flow } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { finish, parseTests, run as steps, start } from "./lib/steps.mjs"

// One execution answers: which of these targets, failing at bad, did a commit
// after good break, and which commit? Each step reads and writes the run
// directory, so a stopped execution resumes where it stopped. No step calls a
// model. README.md describes the run.

const implementationVersion = "first-bad/v2"

schema Outcome {
  readonly step: string
  readonly ok: boolean
  readonly summary: string
}

export schema error StepFailed {
  step: string
  message: string
}

// targets: graph labels, space-separated. tries: runs at bad before a failing
// target counts as broken rather than flaky; absent is 3. jobs: --jobs for
// scripts/ci.sh; absent is 8. tests: "<target>=<Test>,<Test> ...", the failing
// tests to run alone in a Go target at every commit; absent or "" runs every
// target whole at bad.
const StartPayload = {
  run: Schema.String,
  repo: Schema.String,
  good: Schema.String,
  bad: Schema.String,
  targets: Schema.String,
  tries: Schema.optional(Schema.Number),
  jobs: Schema.optional(Schema.Number),
  tests: Schema.optional(Schema.String),
  keep: Schema.optional(Schema.Boolean)
}
const RunPayload = { run: Schema.String }
// keep: leave the flow's jj workspace in the run directory after the report.
const ReportPayload = { run: Schema.String, keep: Schema.Boolean }

type StartInput = Schema.Struct.Type<typeof StartPayload>

const declare = <const Tag extends string, P extends Schema.Struct.Fields>(tag: Tag, payload: P) =>
  Action.make(tag, { implementationVersion, payload, success: Outcome, error: StepFailed })

export const Prepare = declare("first-bad/Prepare", StartPayload)
export const Reproduce = declare("first-bad/Reproduce", RunPayload)
export const Bisect = declare("first-bad/Bisect", RunPayload)
export const Report = declare("first-bad/Report", ReportPayload)

const failed = (name: string) => (error: unknown) =>
  new StepFailed({ step: name, message: error instanceof Error ? error.message : String(error) })

effect function step(name: keyof typeof steps, run: string) {
  const result = try Effect.try({
    try: () => steps[name](run) as { readonly ok: boolean; readonly summary: string },
    catch: failed(name)
  })
  return { step: name, ok: result.ok, summary: result.summary }
}

effect function begin(input: StartInput) {
  try Effect.try({
    try: () => start(input.run, {
      ...input,
      tries: input.tries ?? 3,
      jobs: input.jobs ?? 8,
      targets: input.targets.split(/\s+/).filter(Boolean),
      tests: parseTests(input.tests ?? "")
    }),
    catch: failed("prepare")
  })
  return try step("prepare", input.run)
}

effect function report(run: string, keep: boolean) {
  const outcome = try step("report", run)
  if (!keep) {
    try Effect.try({
      try: () => finish(run),
      catch: failed("report")
    })
  }
  return outcome
}

/** The steps' implementations, which the flow's host composes. */
export const layer = Layer.mergeAll(
  Prepare.toLayer((input) => begin(input), { implementationVersion }),
  Reproduce.toLayer(({ run }) => step("reproduce", run), { implementationVersion }),
  Bisect.toLayer(({ run }) => step("bisect", run), { implementationVersion }),
  Report.toLayer(({ run, keep }) => report(run, keep), { implementationVersion })
)

export default Flow.make("first-bad", {
  description: "Rerun the graph targets that fail at a bad commit, then bisect the ones that reproduce to the first commit after a good one that fails them",
  capabilities: [],
  // The steps write the run directory and a jj workspace inside it, both named
  // by the payload, so the flow declares no paths here.
  effects: { reads: [], writes: [], mode: "expected", onConflict: "serialize" },
  payload: StartPayload,
  success: Outcome,
  error: StepFailed,
  body: Node.capture({ implementationVersion }, (input: StartInput) => {
    const run = { run: input.run }
    return Prepare.call(input).pipe(
      Node.andThen(Reproduce.call(run)),
      Node.andThen(Bisect.call(run)),
      Node.andThen(Report.call({ ...run, keep: input.keep ?? false }))
    )
  })
})
