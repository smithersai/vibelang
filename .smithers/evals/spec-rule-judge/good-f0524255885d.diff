+  for try (const item of items) { fork work(item) }
+  try parentWork() // plain children may still run while this consuming fiber continues
+}
+```
+
+```ts effect
+// Stream consuming-fiber witness: VIP-17, VIP-20, VIP-31
+import { Deferred, Effect, Exit, Fiber, Stream } from "effect"
+
+const trace: string[] = []
+const result = await Effect.runPromiseExit(Effect.gen(function* () {
+  const started = yield* Deferred.make<void>()
+  const release = yield* Deferred.make<void>()
+  const children: Array<Fiber.Fiber<void>> = []
+  yield* Stream.runForEachWhile(Stream.make(1), () => Effect.gen(function* () {
+    children.push(yield* Effect.forkChild(Effect.gen(function* () {
+      yield* Deferred.succeed(started, undefined)
+      yield* Deferred.await(release)
+      trace.push("child")
+    })))
+    yield* Deferred.await(started)
+    trace.push("item")
+    return true
+  }))
+  trace.push("loop")
+  yield* Deferred.succeed(release, undefined)
+  yield* Fiber.join(children[0])
+  trace.push("joined")
+}))
+if (!Exit.isSuccess(result) || trace.join() !== "item,loop,child,joined") throw new Error("consuming-fiber ownership changed")
+```
