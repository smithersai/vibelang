import { Panic } from "smithers:exceptions"
import { parseInteger } from "./foreign.ts"

function parse(text: string): Result<number, RangeError | Panic> {
  return parseInteger(text)
}

export function main(): string[] {
  return [
    parse("41").match({ ok: (value) => `ok ${value}`, error: (error) => `error ${error.message}` }),
    parse("oops").match({ ok: (value) => `ok ${value}`, error: (error) => `error ${error.message}` }),
  ]
}
