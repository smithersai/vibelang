import { panic } from "vibelang:exceptions"

// `guarded` keeps a plain return type: the panic is not in its expected-error
// channel, so it leaves the function by unwinding. `Result.try` is the explicit
// boundary that turns that unwind into a value; nothing implicit does.
function guarded(ok: boolean): string {
  if (!ok) panic("forged value")
  return "real"
}

export function main(): string[] {
  const caught = Result.try(() => guarded(false))
  caught.isError() // Do not defer the obligation across a panicking call.
  return [
    guarded(true),
    caught.match({ ok: (value) => value, error: (error) => `panic: ${error.message}` }),
  ]
}
