import { config } from "./trusted-relay-to-trusted-middle.ts"

// Two properly marked relays in front of the same unmarked module the
// depth-two case reaches through one. The verdict must not change: a trust
// marker certifies the module that writes it, and the number of marked hops in
// front of an unmarked initializer is not a bound on the rule. Only `typeof`
// is applied to the binding, so the declared diagnostic is the trust rule
// itself and nothing else.
export function main(): string[] {
  return [typeof config]
}
