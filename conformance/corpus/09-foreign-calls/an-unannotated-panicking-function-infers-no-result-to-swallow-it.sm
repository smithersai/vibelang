import { panic } from "smithers:exceptions"

// No return annotation at all. Inference must not put the panic in E either:
// there is no Result on this function, so `unwrapOr`, `recover` and `match`
// have nothing to swallow the panic with.
function guarded(ok: boolean) {
  if (!ok) panic("forged value")
  return "real"
}

export function main(): string[] {
  const caught = Result.try(() => guarded(false))
  return [
    guarded(true),
    caught.match({ ok: (value) => value, error: (error) => `panic: ${error.message}` }),
  ]
}
