import { Panic } from "smithers:exceptions"
import { makeParser } from "./order-unsafe.ts"

function parse(text: string): Result<number, Panic> {
  const parseText = makeParser()
  return parseText(text)
}

export function main(): string[] {
  return [
    parse("41").match({ ok: (value) => `ok ${value}`, error: () => "panic" }),
    parse("oops").match({ ok: (value) => `ok ${value}`, error: () => "panic" }),
  ]
}
