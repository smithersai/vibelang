import { Panic } from "smithers:exceptions"
import { untrustedAsync } from "./throws-claims.ts"

async function read(): Promise<Result<string, Panic>> {
  return await untrustedAsync()
}

export async function main(): Promise<string[]> {
  const rejected = await read()
  return [rejected.match({ ok: (value) => `ok ${value}`, error: () => "panic" })]
}
