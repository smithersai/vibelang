// The OBSERVATION for `a-statement-branch-holding-an-action-in-each-arm-is-rejected.sm`, which
// exports a Flow declaration and nothing else.
//
// The program under test may not be edited to make itself observable, so the
// entry module is this one: it imports the compiled Flow and prints what the
// compiler made of the program. `.sm` bytes of the case itself are unchanged.
//
// The expensive member of the branch class: each arm calls a DIFFERENT Action,
// and the Manifest names BOTH. That is the anti-folding observation this case
// was written for, now stated on the accepting side of the line.
import { Flow } from "./a-statement-branch-holding-an-action-in-each-arm-is-rejected.sm"

export function main(): string[] {
  const manifest = Flow.manifest
  return [
    Flow.artifactSource,
    Flow.id,
    manifest.actions.map((action) => action.id).join(" "),
    String(manifest.sites.length),
  ]
}
