// The OBSERVATION for `an-optional-projection-on-a-durable-input-is-rejected.sm`, which
// exports a Flow declaration and nothing else.
//
// The program under test may not be edited to make itself observable, so the
// entry module is this one: it imports the compiled Flow and prints what the
// compiler made of the program. `.sm` bytes of the case itself are unchanged.
//
// `?.` is a branch wearing the syntax of a projection, and a branch is ordinary
// control flow inside a Flow body. The Manifest carries the Action the
// projection feeds and says nothing about whether the receiver was present.
import { Flow } from "./an-optional-projection-on-a-durable-input-is-rejected.sm"

export function main(): string[] {
  const manifest = Flow.manifest
  return [
    Flow.artifactSource,
    Flow.id,
    manifest.actions.map((action) => action.id).join(" "),
    String(manifest.sites.length),
  ]
}
