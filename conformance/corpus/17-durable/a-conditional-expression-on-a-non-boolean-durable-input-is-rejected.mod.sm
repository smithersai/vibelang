// The OBSERVATION for `a-conditional-expression-on-a-non-boolean-durable-input-is-rejected.sm`, which
// exports a Flow declaration and nothing else.
//
// The program under test may not be edited to make itself observable, so the
// entry module is this one: it imports the compiled Flow and prints what the
// compiler made of the program. `.sm` bytes of the case itself are unchanged.
//
// Both arms call a DIFFERENT Action, and both are named below. A lowering that
// answered the condition — which is what evaluating the body against a stand-in
// object does — would name one of them and drop the other.
import { Flow } from "./a-conditional-expression-on-a-non-boolean-durable-input-is-rejected.sm"

export function main(): string[] {
  const manifest = Flow.manifest
  return [
    Flow.artifactSource,
    Flow.id,
    manifest.actions.map((action) => action.id).join(" "),
    String(manifest.sites.length),
  ]
}
