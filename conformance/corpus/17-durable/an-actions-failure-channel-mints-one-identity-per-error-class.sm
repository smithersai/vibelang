import { durable, Action } from "smithers:flows"

// An Action's failure channel is compiled into durable type evidence before
// TypeScript erases the signature, and each Error class in it becomes a variant
// carrying a compiler-minted identity. That identity is the key a decoder on the
// far side of a persistence boundary selects a handler by, so two declared Error
// classes must arrive as two variants under two DIFFERENT identities, each
// derived from the declaring module and the class's own name.
class Failed extends Error {
  constructor(readonly code: string) { super(`failed: ${code}`) }
}

class Denied extends Error {
  constructor(readonly who: string) { super(`denied: ${who}`) }
}

class Pick extends Action<(input: { key: string }) => Result<{ value: string }, Failed | Denied>> {}

export const Flow = durable((input: { key: string }) => {
  return Pick.run({ key: input.key })
})

export function main(): string[] {
  const action = Flow.manifest.actions[0]
  if (action === undefined) return ["the manifest carries no action descriptor"]
  const schema = action.errorSchema
  if (schema.shape !== "structural") return ["the error schema is not structural type evidence"]
  const descriptor = schema.descriptor
  if (descriptor.kind !== "union") return ["the error schema is not a union of variants"]
  const rows = descriptor.variants.map((variant) =>
    variant.kind === "error"
      ? { identity: variant.identity, name: variant.name }
      : { identity: "a variant that is not an Error", name: "a variant that is not an Error" }
  )
  const identities = rows.map((row) => row.identity)
  return [
    String(rows.length),
    String(new Set(identities).size),
    rows.map((row) => row.name).join(" "),
    String(rows.every((row) => row.identity.includes(row.name))),
    String(identities.every((identity) =>
      identity.includes("an-actions-failure-channel-mints-one-identity-per-error-class.sm")
    ))
  ]
}
