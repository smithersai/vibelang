import { durable as compileFlow, Action, sequential, sleep, waitSignal } from "smithers:flows"

class Lookup extends Action<(input: { key: string }) => Result<{ value: string }, Error>> {}
class Audit extends Action<(input: { value: string }) => Result<{ saved: boolean }, Error>> {}

export const Build = compileFlow((input: { key: string; live: boolean }) => {
  const found = Lookup.run({ key: input.key })!
  const selected = input.live ? found.value : "offline"
  sleep(25)
  const pair = sequential(
    Lookup.run({ key: selected }),
    Audit.run({ value: selected })
  )
  const approval = waitSignal<string>("build.approval")
  return { approval, pair, selected }
})

export function main(): string[] {
  const plan = Build.plan
  const first = plan.nodes[0]
  const second = plan.nodes[1]
  const fourth = plan.nodes[3]
  const fifth = plan.nodes[4]
  if (first === undefined || second === undefined || fourth === undefined || fifth === undefined) {
    return ["the plan does not have the five nodes this case pins"]
  }
  return [
    Build.artifactSource,
    plan.nodes.map((node) => node.kind).join(","),
    String(plan.digest.length),
    String(second.controlDependencies[0] === first.id),
    String(fifth.controlDependencies[0] === fourth.id),
    plan.requirements.join(",")
  ]
}
