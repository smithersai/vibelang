// The OBSERVATION for `an-in-test-on-a-durable-input-is-rejected.sm`, which
// exports a Flow declaration and nothing else.
//
// The program under test may not be edited to make itself observable, so the
// entry module is this one: it imports the compiled Flow and prints what the
// compiler made of the program. `.sm` bytes of the case itself are unchanged.
//
// `"mode" in input` is the member of the operator family whose runtime operand
// is on the RIGHT. Nothing inspects either operand at compile time any more.
import { Flow } from "./an-in-test-on-a-durable-input-is-rejected.sm"

export function main(): string[] {
  const manifest = Flow.manifest
  return [
    Flow.artifactSource,
    Flow.id,
    manifest.actions.map((action) => action.id).join(" "),
    String(manifest.sites.length),
  ]
}
