// The OBSERVATION for `statement-branch-fails-closed.sm`, which exports a Flow
// declaration and nothing else.
//
// The program under test may not be edited to make itself observable, so the
// entry module is this one: it imports the compiled Flow and prints what the
// compiler made of the program. `.sm` bytes of the case itself are unchanged.
//
// This is the minimal branch — `if (input.live) return "yes"` over two plain
// strings, no Action in either arm — so what it observes is that the branch
// alone is enough to leave the Plan and reach the Manifest. The counts are
// printed rather than the ids because there are none of either: a Flow with no
// Action and no request is a legitimate Manifest, and a lowering that quietly
// dropped the whole body would print the same two zeroes, which is why the
// FIRST line, the artifact the descriptor came from, is the one that separates
// them.
import { Bad } from "./statement-branch-fails-closed.sm"

export function main(): string[] {
  const manifest = Bad.manifest
  return [
    Bad.artifactSource,
    Bad.id,
    String(manifest.actions.length),
    String(manifest.sites.length),
  ]
}
