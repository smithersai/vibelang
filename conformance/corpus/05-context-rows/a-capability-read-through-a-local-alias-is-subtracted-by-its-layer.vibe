import { Context } from "vibelang/context"
import { Layer } from "vibelang/provider"

abstract class Clock extends Context {
  abstract now(): number
}

const Chronometer = Clock

function timestamp(): number {
  return Chronometer.context().now()
}

const live: Clock = { now: () => 7 }

export function main(): string[] {
  return Layer.provide(Layer.succeed(Clock, live), () => [`${timestamp()}`])
}
