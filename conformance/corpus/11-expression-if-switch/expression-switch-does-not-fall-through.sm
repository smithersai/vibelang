type Grade = "pass" | "fail" | "retry"

// In expression position a switch selects exactly one clause value. It must NOT
// fall through into the next clause the way a statement switch does.
function describe(grade: Grade): string {
  return switch (grade) {
    case "pass": "met the bar"
    case "fail": "below the bar"
    case "retry": "resit scheduled"
  }
}

export function main(): string[] {
  return [describe("pass"), describe("fail"), describe("retry")]
}
