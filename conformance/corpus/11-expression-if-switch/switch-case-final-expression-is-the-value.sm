type Grade = "pass" | "fail" | "retry"

const seen: string[] = []

function record(message: string): void {
  seen.push(message)
}

function describe(grade: Grade): string {
  return switch (grade) {
    case "pass": record("pass"); "met the bar"
    case "fail": record("fail"); "below the bar"
    case "retry": record("retry"); "resit scheduled"
  }
}

export function main(): string[] {
  return [describe("pass"), describe("retry"), seen.join(",")]
}
