const seen: string[] = []

function classify(label: string): void {
  switch (label) {
    case "a":
      seen.push("a")
    case "b":
      seen.push("b")
      break
    default:
      seen.push("d")
  }
}

export function main(): string[] {
  classify("a")
  classify("b")
  classify("z")
  return [seen.join(",")]
}
