export function main(): string[] {
  const events: string[] = []
  // Statement-position `if` keeps ordinary TypeScript behavior: a braceless
  // branch is fine and an `else` is not required. Only a VALUE-producing `if`
  // needs both (11-expression-if-switch/if-expression-requires-an-else-branch
  // and if-expression-with-a-braceless-branch-is-rejected).
  if (events.length === 0) events.push("first")
  if (events.length > 5) events.push("never")
  else events.push("second")
  return events
}
