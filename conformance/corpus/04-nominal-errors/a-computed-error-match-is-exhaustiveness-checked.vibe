export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}
export class Timeout extends Error {
  constructor() { super("timed out") }
}

function lookup(key: string): Result<string, Missing | Timeout> {
  if (key === "slow") throw new Timeout()
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

export function main(): string[] {
  return [lookup("ada").match({
    ok: (value) => value,
    error: (error) => error["match"]({ Missing: (item) => item.message }),
  })]
}
