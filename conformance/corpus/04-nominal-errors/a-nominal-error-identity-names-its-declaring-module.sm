import { Missing } from "./a-nominal-error-identity-names-its-declaring-module.mod.sm"

export function lookup(key: string): Result<string, Missing> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

export function main(): Result<string[], Missing> {
  const found = lookup("zoe")!
  return [found]
}
