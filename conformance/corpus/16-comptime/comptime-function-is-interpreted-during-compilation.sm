import { comptime } from "smithers:comptime"

const rows = ["alpha", "beta", "gamma", "delta"]

const index = comptime((items: string[]) => {
  const widths: Record<string, number> = {}
  let total = 0
  for (const item of items) {
    if (item === "gamma") {
      continue
    }
    widths[item] = item.length
    total += item.length
    if (total > 12) {
      break
    }
  }
  const steps: number[] = []
  let countdown = 3
  while (countdown > 0) {
    steps.push(countdown)
    countdown--
  }
  return { widths, total, steps }
})

const folded = comptime(() => [1, 2, 3, 4].reduce((sum: number, value: number) => sum + value, 0))()

export function main(): string[] {
  return [JSON.stringify(index(rows)), String(folded)]
}
