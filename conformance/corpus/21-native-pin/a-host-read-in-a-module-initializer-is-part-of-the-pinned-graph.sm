import { native } from "smithers:native"
import { pid } from "./initializer-host.mod.sm"

// The host read is in no function at all. It is in the INITIALIZER of a binding
// in another module, and that initializer runs when the module loads, which
// reading `pid` here does. An analysis that walks function bodies and import
// lists certifies this program, and running the certified program reads
// `process`. The route must name the binding whose initializer ran.
function pinned(): number {
  return pid
}

native(pinned)

export function main(): string[] {
  return [String(pinned())]
}
