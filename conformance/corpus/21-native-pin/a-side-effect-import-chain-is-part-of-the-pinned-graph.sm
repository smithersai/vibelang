import { native } from "smithers:native"
import "./loads-host.mod.sm"

// Nothing in the pinned function names a host, and nothing in this file names
// one either: the only binding-free import on line 2 is an ordinary relative
// project path. Importing it evaluates it, and evaluating it loads `node:fs`,
// so running anything in this module loads `node:fs`. A pin checked over what
// the function's body reaches, rather than over what running it loads,
// certifies this program.
function pinned(input: string): number {
  return input.length
}

native(pinned)

export function main(): string[] {
  return [String(pinned("smithers"))]
}
