import { native } from "smithers:native"

// `any` and `eval` are both valid in authored .sm and both contribute the
// built-in `TypeScript` requirement. A native pin is the checked assertion
// that no reachable operation contributes it, so this pin must fail.
function widen(source: string): any {
  return eval(source)
}

function checksum(input: string): number {
  return `${widen(input)}`.length
}

native(checksum)

export function main(): string[] {
  return [String(checksum("1 + 1"))]
}
