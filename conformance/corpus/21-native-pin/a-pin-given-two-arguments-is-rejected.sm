import { native } from "smithers:native"

// The other branch of the same rule, and the one a backend can most easily
// leave out: the pin takes exactly ONE reference. Given two, an implementation
// that reads only the first argument would pin `checksum` and silently discard
// the rest of what the author wrote, which is an assertion the program does not
// make. The refusal is reported at the CALL rather than at an argument, because
// no single argument is the thing that is wrong.
function checksum(input: string): number {
  return input.length
}

native(checksum, checksum)

export function main(): string[] {
  return [String(checksum("smithers"))]
}
