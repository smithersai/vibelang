import { native } from "smithers:native"
import { run } from "./invoking-callee.mod.sm"

// The `eval` is inside a closure this function never calls itself. It is
// reached because `run`'s VISIBLE BODY invokes the callback it is handed, so
// the requirement belongs to the pinned graph and the route must name the
// callee whose body ran it. Read this case with its twin,
// a-callback-a-callee-only-stores-still-satisfies-the-pin: the two programs are
// identical at the call and differ only in what the callee's body does, so an
// implementation that charges callback arguments as a class answers one of them
// wrongly whichever way it answers.
function pinned(): number {
  return run(() => `${eval("1 + 1")}`.length)
}

native(pinned)

export function main(): string[] {
  return [String(pinned())]
}
