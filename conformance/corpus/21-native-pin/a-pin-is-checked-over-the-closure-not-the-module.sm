import { native } from "smithers:native"

// Portability is determined from the satisfied dependency closure, not from
// the source module's import path or from what else the module happens to
// contain. `widen` contributes the `TypeScript` requirement through `any` and
// `eval`; `checksum` never reaches it. The pin over `checksum` therefore holds
// even though a blocked function is compiled in the same module.
function widen(source: string): any {
  return eval(source)
}

export function describe(source: string): string {
  return `${widen(source)}`
}

function mix(seed: number, byte: number): number {
  return (seed * 31 + byte) % 65536
}

function checksum(input: string): number {
  let seed = 7
  for (const character of input) {
    seed = mix(seed, character.charCodeAt(0))
  }
  return seed
}

native(checksum)

export function main(): string[] {
  return [String(checksum("smithers")), describe("1 + 1")]
}
