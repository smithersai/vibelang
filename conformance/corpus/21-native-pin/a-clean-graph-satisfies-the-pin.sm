import { native } from "smithers:native"

// A native pin is a checked assertion over the complete transitive graph. This
// one holds: nothing `checksum` reaches requires a JavaScript host, so the
// assertion adds no diagnostic and the program compiles and runs unchanged.
function mix(seed: number, byte: number): number {
  return (seed * 31 + byte) % 65536
}

function checksum(input: string): number {
  let seed = 7
  for (const character of input) {
    seed = mix(seed, character.charCodeAt(0))
  }
  return seed
}

native(checksum)

export function main(): string[] {
  return [String(checksum("smithers"))]
}
