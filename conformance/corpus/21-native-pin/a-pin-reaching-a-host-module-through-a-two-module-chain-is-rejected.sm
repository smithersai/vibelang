import { native } from "smithers:native"
import { readFileSync } from "./chain-outer-host-module.mod.sm"

// Two hops. Following one re-binding is not enough: the walk has to keep
// going until it reaches something that is not a re-binding, and the reported
// route has to name every module it passed through.
function hostBacked(): number {
  return typeof readFileSync === "function" ? 1 : 0
}

function checksum(input: string): number {
  return input.length + hostBacked()
}

native(checksum)

export function main(): string[] {
  return [String(checksum("smithers"))]
}
