import { native } from "smithers:native"
import { readFileSync } from "node:fs"

// A host module is a dependency on the JavaScript host itself rather than a
// service some Layer can supply, so it blocks the pin exactly as `TypeScript`
// does. The binding is only inspected, never called, so the failure declared
// below is the pin rule and the host module's own trust rule, with no
// foreign-call cascade on top.
function hostBacked(): number {
  return typeof readFileSync === "function" ? 1 : 0
}

function checksum(input: string): number {
  return input.length + hostBacked()
}

native(checksum)

export function main(): string[] {
  return [String(checksum("smithers"))]
}
