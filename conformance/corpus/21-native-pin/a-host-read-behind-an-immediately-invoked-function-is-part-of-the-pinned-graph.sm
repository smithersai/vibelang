import { native } from "smithers:native"
import { pid } from "./iife-host.mod.sm"

// The same laundering as a-host-read-in-a-module-initializer-is-part-of-the-
// pinned-graph, with the read moved inside a function. The function is called
// where it is written, so nothing about the program's behaviour changed: the
// read still happens when the module loads. A walk that treats "inside a
// function" as "deferred" certifies this one and refuses its twin, and the two
// programs run the same code.
function pinned(): number {
  return pid
}

native(pinned)

export function main(): string[] {
  return [String(pinned())]
}
