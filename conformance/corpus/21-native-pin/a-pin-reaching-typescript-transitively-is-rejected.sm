import { native } from "smithers:native"

// Four hops separate the pin from the operation that introduced the
// requirement. The specification asks the diagnostic to show the dependency
// path, so the failure must name every hop rather than only the endpoints.
function boundary(source: string): any {
  return eval(source)
}

function third(source: string): string {
  return `${boundary(source)}`
}

function second(source: string): string {
  return third(source)
}

function first(source: string): string {
  return second(source)
}

function checksum(source: string): number {
  return first(source).length
}

native(checksum)

export function main(): string[] {
  return [String(checksum("1 + 1"))]
}
