import { native } from "smithers:native"
import { Context } from "smthrs/context"
import { Layer } from "smthrs/provider"

// `Layer.provide` keeps its environment active THROUGH the callback, which is
// another way of saying the callback runs. A pin checked over a graph that
// stops at the provide site never looks inside it, so a host read one keyword
// away is certified. The provided capability is beside the point here: nothing
// a layer can supply makes `process` portable.
abstract class Config extends Context {
  abstract retries(): number
}

const config: Config = { retries: () => 1 }

function scoped(): number {
  return Layer.provide(Layer.succeed(Config, config), () => process.pid)
}

native(scoped)

export function main(): string[] {
  return [String(scoped())]
}
