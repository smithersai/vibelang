import { native } from "smithers:native"
import { readFileSync } from "./reexport-host-module.mod.sm"

// Nothing in this file names a host module. The specifier the pinned graph
// imports is an ordinary relative `.sm` path, and the `node:fs` edge lives one
// module away behind a re-export. A pin checked over the module's own import
// list certifies this program; a pin checked over the complete transitive
// graph must refuse it, and must say which module launders the edge.
function hostBacked(): number {
  return typeof readFileSync === "function" ? 1 : 0
}

function checksum(input: string): number {
  return input.length + hostBacked()
}

native(checksum)

export function main(): string[] {
  return [String(checksum("smithers"))]
}
