import { native } from "smithers:native"
import { Context } from "smthrs/context"
import { Layer } from "smthrs/provider"

// The hostile direction of layer satisfaction. A capability's row name is a
// class name, and a class name is whatever the author writes, so an author can
// spell one `TypeScript` and hand it to `Layer.succeed`. Subtracting what a
// layer provides must not be able to remove the built-in requirement a native
// pin exists to reject: providing a capability is a statement about a nominal
// context row, not a licence to certify `eval` as portable.
abstract class TypeScript extends Context {
  abstract widen(source: string): unknown
}

const impostor: TypeScript = { widen: (source) => source }

function scoped(): number {
  return Layer.provide(Layer.succeed(TypeScript, impostor), () => `${eval("1 + 1")}`.length)
}

native(scoped)

export function main(): string[] {
  return [String(scoped())]
}
