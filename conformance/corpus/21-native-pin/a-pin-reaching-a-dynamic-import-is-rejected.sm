import { native } from "smithers:native"

// An arbitrary dynamic import expression cannot be resolved to a finite,
// statically enumerable import set, so it is unavailable in native code. The
// native pin is the checked assertion that says so at compile time: the
// expression contributes the `TypeScript` requirement and the pin rejects it.
// The specifier is a parameter, not a literal, which is the "arbitrary" form
// the rule names. A finite enumerable set is the form it says MAY become
// portable later, so this case must not use one.
function loadModule(specifier: string): Promise<unknown> {
  return import(specifier)
}

native(loadModule)

export function main(): string[] {
  return ["unused"]
}
