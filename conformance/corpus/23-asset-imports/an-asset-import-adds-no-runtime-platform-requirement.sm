import { native } from "smithers:native"
import config from "./config.json" with { type: "json", mode: "const" }

// Loading happens during compilation, so reading the loaded value must not put
// a platform requirement in this function's row. The native pin is the check:
// it is an assertion over the complete transitive graph and fails if anything
// reachable requires a JavaScript host, so a pinned function that reads an
// asset compiles only when the asset edge contributed no requirement.
function describe(): string {
  return `${config.mode}/${config.ports.length}`
}

native(describe)

export function main(): string[] {
  return [describe()]
}
