export function firstPair(rows: number[][]): string {
  const found = outer: for (const row of rows) {
    const inner = search: for (const value of row) {
      // Breaking out of the enclosing value construct from inside another one:
      // nested label selection is not finalized in the specification.
      if (value > 10) break :outer "big"
      break :search `${value}`
    } else "empty row"
    if (inner === "empty row") break :outer inner
  } else "nothing"
  return found
}

export function main(): string[] {
  return [firstPair([[1], [20]])]
}
