export function firstMultiple(of: number, limit: number): number {
  const found = search: for (let value = 1; value <= limit; value++) {
    if (value % of === 0) break :search value
  } else -1
  return found
}

export function main(): string[] {
  return [`${firstMultiple(3, 10)}`, `${firstMultiple(11, 10)}`]
}
