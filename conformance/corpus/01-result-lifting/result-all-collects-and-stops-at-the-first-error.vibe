export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function lookup(key: string): Result<string, Missing> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

export function main(): string[] {
  const every = Result.all([lookup("ada"), lookup("ada")])
  // Two failures: the collected Result must carry the FIRST one.
  const partial = Result.all([lookup("ada"), lookup("zoe"), lookup("nemo")])
  return [
    every.match({ ok: (values) => values.join(","), error: (error) => error.message }),
    partial.match({ ok: (values) => values.join(","), error: (error) => error.message }),
  ]
}
