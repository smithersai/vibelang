export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function lookup(key: string): Result<string, Missing> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

export function main(): string[] {
  // isOk/isError are the explicit inspection forms, and inspecting a Result is
  // one of the listed ways to consume it.
  return [
    `present isOk ${lookup("ada").isOk()}`,
    `present isError ${lookup("ada").isError()}`,
    `absent isOk ${lookup("zoe").isOk()}`,
    `absent isError ${lookup("zoe").isError()}`,
  ]
}
