export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function inner(key: string): Result<string, Missing> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

function outer(key: string): Result<string, Missing> {
  return inner(key)
}

export function main(): string[] {
  const describe = (key: string): string =>
    outer(key).match({ ok: (value) => value, error: (error) => error.message })
  return [describe("ada"), describe("zoe")]
}
