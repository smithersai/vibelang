export function classify(score: number): string {
  // Two reachable break values with different types; the compiler must combine
  // them when determining the labeled expression's type.
  const verdict = label: {
    if (score < 0) break :label "invalid"
    break :label score * 2
  }
  return `${verdict}`
}

export function main(): string[] {
  return [classify(-1), classify(21)]
}
