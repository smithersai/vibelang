import { attempt, Timeout } from "./callback-row-must-be-nominally-covered.mod.sm"

export class NotFound extends Error {
  constructor(readonly id: string) { super(`no record ${id}`) }
}

export class Conflict extends Error {
  constructor(readonly id: string) { super(`conflicting record ${id}`) }
}

export function unsound(id: string): Result<string, NotFound | Timeout> {
  return attempt<string, NotFound>(1, (): Result<string, Conflict> => {
    if (id === "x") throw new Conflict(id)
    return id
  })!
}
