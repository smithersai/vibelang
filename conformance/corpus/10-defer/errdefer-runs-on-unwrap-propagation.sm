const events: string[] = []

function record(message: string): void {
  events.push(message)
}

export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function scoreOf(key: string): Result<number, Missing> {
  if (key !== "ada") throw new Missing(key)
  return 96
}

function doubled(key: string): Result<number, Missing> {
  errdefer record(`${key}:failed`)
  const score = scoreOf(key).unwrap()
  return score * 2
}

export function main(): string[] {
  const found = doubled("ada").match({ ok: (value) => `${value}`, error: (error) => error.message })
  const missing = doubled("zoe").match({ ok: (value) => `${value}`, error: (error) => error.message })
  return [found, missing, events.join(",")]
}
