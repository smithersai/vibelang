class Directory {
  private readonly names = new Map<number, string>([[1, "Ada"]])

  lookup(id: number): Optional<string> {
    const found = this.names.get(id)
    if (found === undefined) return undefined
    return found
  }
}

const directory = new Directory()

export function main(): string[] {
  return [
    `1 -> ${directory.lookup(1).unwrapOr("Guest")}`,
    `2 -> ${directory.lookup(2).unwrapOr("Guest")}`,
  ]
}
