const entries = new Map<string, string>([["ada", "Ada Lovelace"]])

export function main(): string[] {
  const present = Optional.fromNullable(entries.get("ada") ?? null)
  const absent = Optional.fromNullable(entries.get("zoe") ?? null)
  return [
    `present ${present.unwrapOr("Guest")}`,
    `absent ${absent.unwrapOr("Guest")}`,
    `toNullable ${absent.toNullable()}`,
  ]
}
