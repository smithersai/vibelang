export class Missing extends Error {
  constructor(readonly id: number) { super(`no record ${id}`) }
}

function lookup(id: number): Optional<string> {
  if (id === 1) return "Ada"
  return null
}

// The declared type is Result<Optional<string>, Missing> and the returned value
// is already an Optional. Lifting follows the written type from outside in, so
// the existing Optional becomes the Result SUCCESS rather than being wrapped
// again, and an Error throw is still the Result error.
function load(id: number): Result<Optional<string>, Missing> {
  if (id < 0) throw new Missing(id)
  return lookup(id)
}

export function main(): string[] {
  return [
    load(1).match({ ok: (name) => `ok ${name.unwrapOr("absent")}`, error: (failure) => `error ${failure.message}` }),
    load(2).match({ ok: (name) => `ok ${name.unwrapOr("absent")}`, error: (failure) => `error ${failure.message}` }),
    load(-1).match({ ok: (name) => `ok ${name.unwrapOr("absent")}`, error: (failure) => `error ${failure.message}` }),
  ]
}
