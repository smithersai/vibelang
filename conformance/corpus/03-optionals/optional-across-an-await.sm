async function lookup(id: number): Promise<Optional<string>> {
  if (id === 1) return "Ada"
  return undefined
}

export async function main(): Promise<string[]> {
  // await removes only the Promise layer; the Optional survives it intact.
  const present = await lookup(1)
  const absent = await lookup(2)
  return [
    present.match({ some: (value) => value, none: () => "none" }),
    absent.match({ some: (value) => value, none: () => "none" }),
  ]
}
