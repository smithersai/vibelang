function lookup(id: number): Optional<string> {
  if (id === 1) return "Ada"
  return undefined
}

export function main(): string[] {
  const seen: string[] = []
  // filter keeps a present value only when the predicate holds; tap observes
  // only the present variant.
  const kept = lookup(1).filter((value) => value.length === 3).unwrapOr("-")
  const dropped = lookup(1).filter((value) => value.length === 9).unwrapOr("-")
  lookup(1).tap((value) => { seen.push(`tap ${value}`) })
  lookup(2).tap((value) => { seen.push(`tap ${value}`) })
  return [
    kept,
    dropped,
    `isSome ${lookup(1).isSome()}`,
    `isNone ${lookup(2).isNone()}`,
    ...seen,
  ]
}
