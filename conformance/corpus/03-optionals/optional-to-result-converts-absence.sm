export class Missing extends Error {
  constructor(readonly id: number) { super(`no entry for ${id}`) }
}

function lookup(id: number): Optional<string> {
  if (id === 1) return "Ada"
  return undefined
}

// Absence and typed failure are separate concepts; toResult is the explicit
// conversion between them.
function required(id: number): Result<string, Missing> {
  return lookup(id).toResult(new Missing(id))
}

export function main(): string[] {
  return [
    required(1).match({ ok: (value) => value, error: (error) => error.message }),
    required(2).match({ ok: (value) => value, error: (error) => error.message }),
  ]
}
