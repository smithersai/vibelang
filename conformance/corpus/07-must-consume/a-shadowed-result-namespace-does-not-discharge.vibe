export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function lookup(key: string): Result<string, Missing> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

// A plain object that happens to be spelled `Result` and to have a member
// spelled `all`. It is not the compiler-owned Result namespace and collects
// nothing, so passing the produced Result to it consumes nothing either.
const Result = { all: (values: readonly unknown[]) => values }

export function main(): string[] {
  const found = lookup("ada")
  Result.all([found])
  return ["done"]
}
