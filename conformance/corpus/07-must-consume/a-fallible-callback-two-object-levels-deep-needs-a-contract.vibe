export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

function apply(key: string, config: { handlers: { transform: (key: string) => unknown } }): string {
  return String(config.handlers.transform(key))
}

export function main(): string[] {
  return [apply("ada", { handlers: { transform: (key) => {
    if (key !== "ada") throw new Missing(key)
    return "Ada Lovelace"
  } } })]
}
