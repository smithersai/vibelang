export class Boom extends Error {
  constructor() { super("boom") }
}

function tag(parts: TemplateStringsArray): Result<string, Boom> {
  if (parts[0] === "bad") throw new Boom()
  return "ok"
}

function plainCall(): Result<string, Boom> {
  throw new Boom()
}

function dropATaggedTemplate(): void {
  tag`bad`
}

function dropACall(): void {
  plainCall()
}

tag`bad`
plainCall()
