export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

async function load(key: string): Promise<Result<string, Missing>> {
  if (key !== "ada") throw new Missing(key)
  return "Ada Lovelace"
}

export async function main(): Promise<string[]> {
  // The real ambient combinator, handed a Promise that has a name. The bound
  // form is the one the shadowing case uses, so the pair differs only in which
  // `Promise` the call resolves to.
  const started = load("ada")
  const settled = await Promise.all([started])
  return settled.map((outcome) => outcome.unwrapOr("-"))
}
