export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

const seen: string[] = []

export function scoreOf(key: string): Result<number, Missing> {
  seen.push(key)
  if (key !== "ada") throw new Missing(key)
  return 96
}

export function collect(): Result<string[], Missing> {
  const first = scoreOf("ada")!
  const second = scoreOf("zoe")!
  const third = scoreOf("bob")!
  return [`${first} ${second} ${third}`]
}

export function main(): Result<string[], Missing> {
  const lines = collect()!
  return [...lines, `seen ${seen.join(",")}`]
}
