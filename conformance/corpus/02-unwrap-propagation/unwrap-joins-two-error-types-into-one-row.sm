export class Missing extends Error {
  constructor(readonly key: string) { super(`no entry for ${key}`) }
}

export class Invalid extends Error {
  constructor(readonly text: string) { super(`not a number: ${text}`) }
}

function lookup(key: string): Result<string, Missing> {
  if (key !== "ada" && key !== "bad") throw new Missing(key)
  return key === "bad" ? "twelve" : "41"
}

function parse(text: string): Result<number, Invalid> {
  const value = Number.parseInt(text, 10)
  if (Number.isNaN(value)) throw new Invalid(text)
  return value
}

// Two unwraps of two different Results: the enclosing failure row is the UNION
// of both error types, and the annotation has to spell both.
function scoreOf(key: string): Result<number, Missing | Invalid> {
  const text = lookup(key).unwrap()
  return parse(text).unwrap()
}

export function main(): string[] {
  const describe = (key: string): string =>
    scoreOf(key).match({ ok: (value) => `${value}`, error: (error) => error.message })
  return [describe("ada"), describe("bad"), describe("zoe")]
}
