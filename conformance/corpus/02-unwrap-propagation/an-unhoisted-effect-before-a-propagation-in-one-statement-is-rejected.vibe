class Missing extends Error {}

function scoreOf(key: string): Result<number, Missing> {
  if (key === "a") {
    return 2
  }
  throw new Missing()
}

function bump(): number {
  return 1
}

function total(): Result<number, Missing> {
  return bump() + scoreOf("a")!
}

export function main(): Result<string[], Missing> {
  return [`${total()!}`]
}
