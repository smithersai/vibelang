{
  "name": "vibelang-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build": "vocs build",
    "preview": "vocs preview",
    "deploy": "alchemy deploy --stage prod",
    "postdeploy": "node ../docs/tools/deployed-release.mjs",
    "deploy:plan": "alchemy plan --stage prod",
    "dev:cloudflare": "alchemy dev",
    "postinstall": "node scripts/patch-vocs-search.mjs",
    "prebuild": "bun scripts/build-docs.ts",
    "predev": "node scripts/patch-vocs-search.mjs",
    "postbuild": "bun scripts/build-docs.ts --markdown && node scripts/publication.mjs && bun ../docs/tools/check-site.ts dist/public && bun ../docs/tools/prepare-site.ts dist",
    "test:404": "node --test scripts/cloudflare-stack.test.mjs scripts/not-found.test.mjs",
    "test:llms": "node --test scripts/llms.test.mjs",
    "social-card": "node scripts/render-social-card.mjs",
    "test:contrast": "node --test scripts/contrast.test.mjs",
    "test:infrastructure": "node --test scripts/cloudflare-stack.test.mjs scripts/deploy-load.test.mjs scripts/patch-vocs-search.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vocs": "2.8.5",
    "waku": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "playwright": "1.64.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "@alchemy.run/cloudflare": "2.0.0-beta.84"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@effect/sql-d1": "4.0.6",
    "@effect/sql-sqlite-do": "4.0.6"
  }
}
