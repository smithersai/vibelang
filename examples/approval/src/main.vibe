task Deploy {
  static readonly tier = "irreversible"
  static readonly idempotencyKey = (version: string) => `deploy:${version}`
  effect call(version: string): string!never {
    return `released ${version}`
  }
}

// The workflow parks on each approval wait without holding a process, then
// resumes when an answer is recorded through Experimental.Human.answer.
export workflow Release {
  effect call(version: string) {
    const staging = try Experimental.Human.confirm("staging", `deploy ${version} to staging`, { timeout: "6 hours" })
    if (!staging) return "staging declined"
    const production = try Experimental.Human.confirm("production", `deploy ${version} to production`, { timeout: "6 hours" })
    if (!production) return "production declined"
    return try Deploy(version)
  }
}

effect function waitForApproval(run: string, name: string) {
  while (true) {
    const waits = try Experimental.Durable.waiting(run)
    const found = waits.find((wait) => wait.reason === "approval" && wait.name === name)
    if (found !== undefined) return found
    try Effect.sleep("2 millis")
  }
}

export effect function reviewRelease(version: string, stagingApproved: boolean, productionApproved: boolean) {
  const handle = try Experimental.Durable.spawn(Release, { version })
  const stagingWait = try waitForApproval(handle.id, "staging")
  const stagingPrompt = (stagingWait.request as Experimental.Human.Question).prompt
  try Console.log(`review: ${stagingPrompt}: ${stagingApproved ? "yes" : "no"}`)
  try Experimental.Human.answer(Release, handle.id, "staging", stagingApproved)

  if (stagingApproved) {
    const prodWait = try waitForApproval(handle.id, "production")
    const prodPrompt = (prodWait.request as Experimental.Human.Question).prompt
    try Console.log(`review: ${prodPrompt}: ${productionApproved ? "yes" : "no"}`)
    try Experimental.Human.answer(Release, handle.id, "production", productionApproved)
  }

  return try handle.result
}

export effect function main() {
  provide Layer.provideMerge(Release.layer, Experimental.Durable.memory) {
    const approved = try reviewRelease("v1", true, true)
    try Console.log(`approved: ${approved}`)
    const declined = try reviewRelease("v2", true, false)
    try Console.log(`declined: ${declined}`)
  }
}
