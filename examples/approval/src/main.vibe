export service Approval {
  approve(request: string): boolean!!
}

// The business program knows neither the reviewer nor the approval policy.
export effect function release(version: string) {
  const approval = try Approval
  if (!try approval.approve(`deploy ${version} to staging`)) return "staging declined"
  if (!try approval.approve(`deploy ${version} to production`)) return "production declined"
  return `released ${version}`
}

export effect function autoApprove(version: string) {
  provide Approval = { effect approve(_request: string) { return true } } {
    return try release(version)
  }
}

export effect function scriptedReview(version: string, decisions: ReadonlyArray<boolean>) {
  let next = 0
  provide Approval = {
    effect approve(request: string) {
      const approved = decisions[next] ?? false
      next++
      try Console.log(`review: ${request}: ${approved ? "yes" : "no"}`)
      return approved
    }
  } {
    return try release(version)
  }
}

export effect function main() {
  try Console.log(`automatic: ${try autoApprove("v1")}`)
  try Console.log(`scripted: ${try scriptedReview("v1", [true, false])}`)
}
