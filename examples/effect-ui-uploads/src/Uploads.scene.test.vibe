import { HtmlLocator, HtmlScene } from "@effect/ui/html/testing"
import { Locator } from "@effect/ui/testing"
import { describe, it } from "@effect/vitest"
import { FAKE_FILES, UploadFile, Uploads, UploadsMessage } from "./Uploads.vibe"

const [firstFile] = FAKE_FILES
const completedFirst = UploadsMessage.CompletedUploadFile({ uploadId: 0 })

const uploadButton = HtmlLocator.role("button", { name: "Upload a file" })
const cancelFirst = HtmlLocator.role("button", { name: "Cancel upload 0" })
const restartFirst = HtmlLocator.role("button", { name: "Restart upload 0" })
const cancelAll = HtmlLocator.role("button", { name: "Cancel all" })

describe("Uploads scene", () => {
  it.effect("initial view shows start button and empty state", () => effect {
    const scene = try HtmlScene.make(Uploads, {})
    scene.expect(HtmlLocator.role("heading", { name: "File Uploads" })).toExist()
      .expect(uploadButton).toExist()
      .expect(Locator.text("Nothing here yet. Start an upload.")).toExist()
  })

  it.effect("starting an upload streams progress ticks and completes to Done", () => effect {
    const scene = try HtmlScene.make(Uploads, {})
    scene.click(uploadButton)
      .expect(Locator.text(firstFile!.name)).toExist()
      .expect(Locator.text("Uploading (0%)")).toExist()
      .expect(cancelFirst).toExist()
      .subscription("uploadProgress:0,0", UploadsMessage.ProgressedUpload({ uploadId: 0, progress: 40 }))
      .expect(Locator.text("Uploading (40%)")).toExist()
      .resolve(UploadFile, completedFirst)
      .expect(Locator.text("Done")).toExist()
  })

  it.effect("cancelling an upload marks it Cancelled and restarting resumes it", () => effect {
    const scene = try HtmlScene.make(Uploads, {})
    scene.click(uploadButton)
      .click(cancelFirst)
      .expect(Locator.text("Cancelled")).toExist()
      .click(restartFirst)
      .expect(Locator.text("Uploading (0%)")).toExist()
      .resolve(UploadFile, completedFirst)
      .expect(Locator.text("Done")).toExist()
  })

  it.effect("cancel all button appears only while an upload is active", () => effect {
    const scene = try HtmlScene.make(Uploads, {})
    scene.expect(cancelAll).toBeAbsent()
      .click(uploadButton)
      .click(cancelAll)
      .expect(cancelAll).toBeAbsent()
      .expect(Locator.text("Cancelled")).toExist()
  })
})
