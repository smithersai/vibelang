export interface User {
  id: string
  name: string
}

export error UserNotFound { id: string }

export service Directory {
  lookup(id: string): (User | undefined)!!
}

export service Users {
  find(id: string): User!UserNotFound
}

export const DirectoryLive = Layer.succeed(Directory, {
  effect lookup(id) { return id === "42" ? { id, name: "Ada" } : undefined }
})

export const UsersLive = Layer.effect(Users, effect {
  const directory = try Directory
  return {
    effect find(id) {
      const user = try directory.lookup(id)
      if (user === undefined) throw new UserNotFound({ id })
      return user
    }
  }
})

export const UsersTest = Layer.succeed(Users, {
  effect find(id) { return ({ id, name: "Grace" }) }
})

export const AppLive = wire(UsersLive, DirectoryLive)

export effect function greet(id: string) {
  try {
    const user = try Users.find(id)
    return `Welcome, ${user.name}!`
  } catch (error) {
    return `No user ${error.id}`
  }
}

export effect function main() {
  provide AppLive {
    try Console.log(try greet("42"))
    try Console.log(try greet("missing"))
  }
}
