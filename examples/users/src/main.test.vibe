import { assert, it } from "@effect/vitest"
import { AppLive, greet, UsersTest } from "./main.vibe"

it.effect("uses the test layer", effect () => {
  provide UsersTest {
    const message = try greet("42")
    try Effect.try(() => assert.strictEqual(message, "Welcome, Grace!"))
  }
})

it.effect("recovers a typed missing-user failure", effect () => {
  provide AppLive {
    const message = try greet("missing")
    try Effect.try(() => assert.strictEqual(message, "No user missing"))
  }
})
