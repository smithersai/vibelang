import "vibelang/platform/node"
import { FileSystem } from "effect/FileSystem"
import { Path } from "effect/Path"
import { PlatformError } from "effect/PlatformError"

// collectFiles is recursive, so its contract is written out.
effect function collectFiles(directory: string, found: string[], visited: Set<string>): void!PlatformError!FileSystem | Path {
  const canonical = try FileSystem.realPath(directory)
  if (visited.has(canonical)) return
  visited.add(canonical)
  const names = (try FileSystem.readDirectory(directory)).sort()
  for (const name of names) {
    const path = try Path.join(directory, name)
    const info = try FileSystem.stat(path)
    if (info.type === "Directory") try collectFiles(path, found, visited)
    else if (info.type === "File") found.push(path)
  }
}

function* walk(directory: string) {
  const files: string[] = []
  try collectFiles(directory, files, new Set<string>())
  for (const path of files) yield path
}

effect function summarize(root: string) {
  const files: string[] = []
  for try (const path of walk(root)) files.push(path)
  const lengths = try forEach(files, effect (path) => {
    const text = try FileSystem.readFileString(path)
    return { path: try Path.relative(root, path), lines: text.trimEnd().split("\n").length }
  }, { concurrency: 4 })
  for (const file of lengths) try Console.log(`${file.path}: ${file.lines} lines`)
}

export effect function main() {
  try summarize("fixtures")
}
