import { assert, it } from "@effect/vitest"
import { TestClock } from "effect/testing"
import { deadline, fetchReport, scenario } from "./main.vibe"

it.effect("retries, races and joins under virtual time", effect () => {
  const pending = fork scenario()
  TestClock.adjust("1 second")
  const result = join pending
  assert.deepStrictEqual(result, {
    fastest: "cached report", timed: "TimeoutError", report: "report after 3 attempts"
  })
})

it.effect("does not finish retries before their scheduled time", effect () => {
  const completed = Deferred.make<string>()
  const pending = fork {
    const report = fetchReport()
    completed.succeed(report)
    return report
  }
  TestClock.adjust("19 millis")
  const before = completed.isDone()
  assert.isFalse(before)
  TestClock.adjust("1 millis")
  const report = join pending
  assert.strictEqual(report, "report after 3 attempts")
})

it.effect("interrupts a slow request at its deadline", effect () => {
  const pending = fork deadline()
  TestClock.adjust("20 millis")
  const result = join pending
  assert.strictEqual(result, "TimeoutError")
})
