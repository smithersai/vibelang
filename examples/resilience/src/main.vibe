export error Unavailable { attempt: number }

export effect function fetchReport() {
  let attempts = 0
  return try retry(effect {
    attempts++
    if (attempts < 3) throw new Unavailable({ attempt: attempts })
    return `report after ${attempts} attempts`
  }, { schedule: Schedule.spaced("10 millis"), times: 2 })
}

export effect function cachedReport() {
  try sleep("5 millis")
  return "cached report"
}

export effect function slowReport() {
  try sleep("1 second")
  return "remote report"
}

export effect function deadline() {
  try {
    return try timeout(slowReport(), "20 millis")
  } catch (error) {
    return error._tag
  }
}

export effect function scenario() {
  const pending = fork fetchReport()
  const fastest = try race(cachedReport(), slowReport())
  const timed = try deadline()
  const report = join pending
  return { fastest, timed, report }
}

export effect function main() {
  // timed is also an Effect data method. The written type says it is this
  // object's field (EK9101).
  const result: { fastest: string; timed: string; report: string } = try scenario()
  try Console.log(result.fastest)
  try Console.log(result.timed)
  try Console.log(result.report)
}
