import { EmptyName, greeting } from "./greeting.vibe"

service Greeter {
  greet(name: string): string!EmptyName
}

const GreeterLive = Layer.succeed(Greeter, {
  effect greet(name: string) {
    return try greeting(name)
  },
})

export effect function main() {
  provide GreeterLive {
    try Console.log(try Greeter.greet("VibeLang"))
    try {
      try Greeter.greet("")
    } catch (error) {
      try Console.log(`Recovered from ${error._tag}`)
    }
  }
}
