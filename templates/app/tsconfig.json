{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "rootDir": "src",
    "rootDirs": [
      "src",
      ".vibe/declarations"
    ],
    "outDir": "dist",
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.vibe",
    "src/**/*.test.vibex"
  ],
  "vibe": {
    "severities": {},
    "sidecarDir": ".vibe/declarations"
  }
}
