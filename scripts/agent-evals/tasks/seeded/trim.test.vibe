import { assert, it } from "@effect/vitest"
import { load } from "./profile.vibe"
import { Store } from "./store.vibe"

it.effect("trims the id before reading the Store", () => effect {
  const seen: Array<string> = []
  provide Layer.succeed(Store, {
    effect get(id: string) {
      seen.push(id)
      return id
    },
  }) {
    const actual = try load("  ada ")
    try Effect.try(() => assert.strictEqual(actual, "ADA"))
  }
  try Effect.try(() => assert.deepStrictEqual(seen, ["ada"]))
})
