import { assert, it } from "@effect/vitest"
import { fetchWithRetry, Timeout } from "./fetch.vibe"

it.effect("retries a Timeout twice", effect () => {
  let calls = 0
  const result = fetchWithRetry(() => {
    calls += 1
    if (calls < 3) throw new Timeout({ ms: 100 })
    return "ok"
  })
  try Effect.try(() => assert.strictEqual(result, "OK"))
  try Effect.try(() => assert.strictEqual(calls, 3))
})

it.effect("fails after the third Timeout", effect () => {
  let calls = 0
  try Effect.catch(effect {
    fetchWithRetry(() => {
      calls += 1
      throw new Timeout({ ms: 100 })
    })
    try Effect.try(() => assert.fail("expected Timeout"))
  }, effect (error) => {
    try Effect.try(() => assert.instanceOf(error, Timeout))
  })
  try Effect.try(() => assert.strictEqual(calls, 3))
})
