import { assert, it } from "@effect/vitest"
import { load } from "./profile.vibe"
import { Missing, Store, Unavailable } from "./store.vibe"

// A Store that fails with Unavailable for its first `failures` calls.
function flakyStore(failures: number, calls: { mutable count: number }) {
  return Layer.succeed(Store, {
    get(id: string) {
      calls.count += 1
      if (calls.count <= failures) throw new Unavailable({ attempt: calls.count })
      if (id === "") throw new Missing({ id })
      return ` ${id} `
    },
  })
}

it.effect("loads a name", effect () => {
  const calls = { count: 0 }
  provide flakyStore(0, calls) {
    const actual = load("ada")
    try Effect.try(() => assert.strictEqual(actual, "ADA"))
  }
  try Effect.try(() => assert.strictEqual(calls.count, 1))
})

it.effect("retries Unavailable", effect () => {
  const calls = { count: 0 }
  provide flakyStore(2, calls) {
    const actual = load("ada")
    try Effect.try(() => assert.strictEqual(actual, "ADA"))
  }
  try Effect.try(() => assert.strictEqual(calls.count, 3))
})

it.effect("gives up after 3 retries", effect () => {
  const calls = { count: 0 }
  provide flakyStore(10, calls) {
    try Effect.catch(effect {
      load("ada")
      try Effect.try(() => assert.fail("expected Unavailable"))
    }, effect (error) => {
      try Effect.try(() => assert.instanceOf(error, Unavailable))
    })
  }
  try Effect.try(() => assert.strictEqual(calls.count, 4))
})

it.effect("does not retry Missing", effect () => {
  const calls = { count: 0 }
  provide flakyStore(0, calls) {
    try Effect.catch(effect {
      load("")
      try Effect.try(() => assert.fail("expected Missing"))
    }, effect (error) => {
      try Effect.try(() => assert.instanceOf(error, Missing))
    })
  }
  try Effect.try(() => assert.strictEqual(calls.count, 1))
})
