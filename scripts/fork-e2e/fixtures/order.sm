import { reserve, OutOfStock } from "./stock.sm"
import { print } from "./host.ts"

export function place(sku: string, wanted: number, available: number): Result<string, OutOfStock> {
  const remaining = reserve(sku, wanted, available).unwrap()
  return `${sku}: reserved ${wanted}, ${remaining} left`
}

function line(sku: string, wanted: number, available: number): string {
  return place(sku, wanted, available).match({
    ok: (text) => text,
    error: (error) => `${error.sku}: rejected`,
  })
}

print(line("widget", 3, 10))
print(line("gizmo", 7, 4))
