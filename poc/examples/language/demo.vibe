import { Layer } from "vibelang:provider"

error NotFound { id: number }
error Timeout { ms: number }

interface User { id: number; name: string }

abstract class Db {
  abstract find(id: number): Promise<User | null>
}

abstract class Logger {
  abstract readonly label: string
  abstract info(message: string): void
}

async function fetchUser(id: number): !User uses db: Db, log: Logger {
  log.info(`fetch ${id}`)
  if (id === 408) throw Timeout({ ms: 250 })
  const user = try await db.find(id)
  if (user === null) throw NotFound({ id })
  return user
}

// Both the failure row and requirement row are inferred transitively.
async function displayName(id: number): !string {
  const user = try await fetchUser(id)
  return user.name
}

function cachedUser(id: number): ?User {
  return id === 1 ? { id: 1, name: "cached Ada" } : null
}

function currentLogger(delay: number): Promise<string> uses log: Logger {
  return new Promise((resolve) => setTimeout(() => resolve(log.label), delay))
}

function defect(): string {
  throw new RangeError("ordinary defect")
}

const db = {
  async find(id: number): Promise<User | null> {
    await new Promise((resolve) => setTimeout(resolve, 2))
    return id === 1 ? { id, name: "Ada" } : null
  },
}

const loggerA = { label: "A", info: (message: string) => console.log(`[A] ${message}`) }
const loggerB = { label: "B", info: (message: string) => console.log(`[B] ${message}`) }
const App = Layer.merge(Layer.succeed(Db, db), Layer.succeed(Logger, loggerA))
const Alternate = Layer.succeed(Logger, loggerB)

await Layer.provide(App, async () => {
  console.log("happy:", await displayName(1))

  const guest = await fetchUser(404) catch |failure| switch (failure) {
    NotFound => ({ id: -1, name: `guest:${failure.id}` }),
    Timeout => throw failure,
  }
  console.log("catch:", guest.name)

  const cached = cachedUser(1) orelse { id: -1, name: "fallback" }
  console.log("optional:", cached.name, cachedUser(1).?.name)

  const tier = if (guest.id < 0) "fallback" else "real"
  console.log("if expression:", tier)

  // Two overlapping async scopes prove capability lookup is not a global stack.
  const scoped = await Promise.all([
    Layer.provide(App, () => currentLogger(10)),
    Layer.provide(Alternate, () => currentLogger(1)),
  ])
  console.log("async layers:", scoped.join(","))

  try {
    defect() catch |failure| "incorrectly swallowed"
  } catch (error) {
    console.log("defect escaped:", (error as Error).message)
  }
})
