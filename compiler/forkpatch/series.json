  "patches": [
    {
      "file": "patches/0100-defer-errdefer-grammar.patch",
      "sha256": "c78f71c7d8e55d05bcfd2fd755010706087b1bb8d43d52c7951117642c285061",
      "kind": "handwritten",
      "summary": "defer/errdefer as real statement kinds, plus the NodeFlagsSmithers dialect gate keyed off .sm and .sm.ts file names"
    },
    {
      "file": "patches/0200-break-label-value-grammar.patch",
      "sha256": "420a7ff490d08e2c0a0848a4c2400b52a39348017226b1548ad4890d50a829ba",
      "kind": "handwritten",
      "summary": "break :label value — an optional Value member on the existing BreakStatement, with binder ordering and a checker arm"
    },
    {
      "file": "patches/0300-if-conditional-declaration-grammar.patch",
      "sha256": "4912fc1cfdb8f6677c88478bbd40d6a86e87a0315c4360bb5c320618e5e26acd",
      "kind": "handwritten",
      "summary": "if (const x = f(); cond) — an optional Initializer member on IfStatement plus LocalsContainerBase, so the binding is visible in every else branch and out of scope after the construct"
    },
    {
      "file": "patches/0400-loop-else-completion-grammar.patch",
      "sha256": "7a93b8180881b9edcf38b8d6a03eaaa34cae52ca0e84ee6624d1d5ff2f71961c",
      "kind": "handwritten",
      "summary": "label: loop else value — an optional ElseValue member on LabeledStatement, with a real extra flow-graph edge so a value break skips the else while normal completion and valueless breaks flow into it"
    },
    {
      "file": "patches/0500-value-position-if-switch-grammar.patch",
      "sha256": "a72138664a2b74c4732749e02f7ad9028a17ba6249fc2a49a514e8343e13905e",
      "kind": "handwritten",
      "summary": "value-position if/switch as real expression grammar: IfExpression and SwitchExpression node kinds, a Value member on CaseOrDefaultClause, branch joins in the binder, and union typing with closed-literal-union exhaustiveness in the checker"
    },
    {
      "file": "patches/0600-labeled-expression-values-grammar.patch",
      "sha256": "f4bf65e8bbe877f7eed3530cda0bb60bfe8d3a6e2d0877be6430f0cb32d29d26",
      "kind": "handwritten",
      "summary": "expression-position labeled block and loop values — one LabeledExpression kind wrapping the existing LabeledStatement, so both forms reuse the landed label binding, the loop-else flow graph and the value-break member; the type is the join of the break values plus the else completion, and a block that can finish without one carries undefined"
    },
    {
      "file": "patches/0700-switch-expression-flow-analysis.patch",
      "sha256": "c2e644aff22ffe673e4efe02fd3cb425e3f7809b9cc0d46c6f8398e7ef10b681",
      "kind": "handwritten",
      "summary": "flow analysis for the value switch and for every Smithers member that holds an expression: FlowSwitchClause nodes per clause so the scrutinee narrows inside a clause value, one ast.SwitchClauses accessor shared by both switch kinds at every site a FlowSwitchClause reaches, one exhaustiveness function for both, the clause Value bound at all, preSwitchCaseFlow set for a value switch, IsInExpressionContext arms for defer/errdefer/break-value/loop-else/clause-value, and ForEachReturnStatement descending through expression-position labeled values"
    },
    {
      "file": "patches/0750-value-clause-statements-and-braceless-if-grammar.patch",
      "sha256": "e748dc61594036414b5ff945a6f464fa07a9e4d1a5efcbf2c05048761cb54cd8",
      "kind": "handwritten",
      "summary": "the last two conformance-corpus gaps, and neither needed a node kind or an AST member: a switch-expression clause may run statements before the final expression that is its value (parsed by trying the single-expression spelling first and falling back to a statement list, so a keyword-initial clause value stays an expression), and a value if may take braceless branches in the one host that bounds them — a variable initializer, keyed on the position it starts at. Plus the three enumerated switches those two forms reached: checker.getContextualType, transformers.IsIdentifierReference and binder.isStatementCondition, all of which switch on the PARENT kind"
    },
    {
      "file": "patches/0800-regenerate-ast.patch",
      "sha256": "e3003adc3c298fec369a33d677cee5d651c1827167d99e6bc8b3433863089390",
      "kind": "generated",
      "summary": "output of tools/scripts/tsc/generate.ts and the Kind stringer for the six grammar patches above; re-derivable with `verify --regenerate`"
    },
    {
      "file": "patches/0900-smithers-grammar-tests.patch",
      "sha256": "001d2b93020e19fffd9b36855f17b2a27c39a77310e7af8d78a35c5c1263567f",
      "kind": "forkowned",
      "summary": "new fork-owned tests: round-trip, node shape, generic-accessor parity and member-reachability sweeps, dialect gate, checker-arm proofs, conditional-declaration scope and locals, loop-else flow graph, value-expression typing, labeled-value typing and flow graph, the value-break traversal, the ast.IsExpressionNode reachability sweep, value-switch clause narrowing and its bypass edge, the shared exhaustiveness function, the IsInExpressionContext member sweep, return-statement collection through a labeled value and through a value clause, the value-clause body shape and its bounded braceless-if host, clause-statement checking, clause completion totality, clause locals under noUnusedLocals, contextual typing of every value operand, identifier substitution in emitted CommonJS, and compound-condition narrowing in a value if"
    }
  ],
