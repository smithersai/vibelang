+// parseDeferStatement parses the Smithers `defer Expression ;` statement.
+// Modelled on parseThrowStatement: `defer` has the same no-LineTerminator
+// restriction so that ASI cannot silently split the statement.
+func (p *Parser) parseDeferStatement() *ast.Node {
+	pos := p.nodePos()
+	jsdoc := p.jsdocScannerInfo()
+	p.parseExpected(ast.KindDeferKeyword)
+	var expression *ast.Expression
+	if !p.hasPrecedingLineBreak() {
+		expression = p.parseExpressionAllowIn()
+	} else {
+		expression = p.createMissingIdentifier()
+	}
+	if !p.tryParseSemicolon() {
+		p.parseErrorForMissingSemicolonAfter(expression)
+	}
+	result := p.finishNode(p.factory.NewDeferStatement(expression), pos)
+	p.withJSDoc(result, jsdoc)
+	return result
+}
+
+// parseErrdeferStatement parses the Smithers `errdefer Expression ;` statement.
+func (p *Parser) parseErrdeferStatement() *ast.Node {
+	pos := p.nodePos()
+	jsdoc := p.jsdocScannerInfo()
+	p.parseExpected(ast.KindErrdeferKeyword)
+	var expression *ast.Expression
+	if !p.hasPrecedingLineBreak() {
+		expression = p.parseExpressionAllowIn()
+	} else {
+		expression = p.createMissingIdentifier()
+	}
+	if !p.tryParseSemicolon() {
+		p.parseErrorForMissingSemicolonAfter(expression)
+	}
+	result := p.finishNode(p.factory.NewErrdeferStatement(expression), pos)
+	p.withJSDoc(result, jsdoc)
+	return result
+}
