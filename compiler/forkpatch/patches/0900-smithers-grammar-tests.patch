+// The Smithers dialect is selected by file name, never by a builtin extension
+// registration: `.sm` stays a content-mapper extension and `.sm.ts` is the
+// virtual file name contentmapper.ParseResult produces for it. Both must select
+// the dialect and `.ts` must not.
+
+func parseSmithers(fileName string, text string) *ast.SourceFile {
+	return parser.ParseSourceFile(ast.SourceFileParseOptions{
+		FileName: fileName,
+		Path:     tspath.Path(fileName),
+	}, text, core.ScriptKindTS)
+}
+
+func printSmithers(file *ast.SourceFile) string {
+	p := printer.NewPrinter(
+		printer.PrinterOptions{NewLine: core.NewLineKindLF},
+		printer.PrintHandlers{},
+		nil,
+	)
+	return strings.TrimSuffix(p.EmitSourceFile(file), "\n")
+}
