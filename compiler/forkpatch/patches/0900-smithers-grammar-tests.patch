@@ -0,0 +1,92 @@
+package printer_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/ast"
+	"github.com/microsoft/TypeScript/tsc/internal/core"
+	"github.com/microsoft/TypeScript/tsc/internal/parser"
+	"github.com/microsoft/TypeScript/tsc/internal/printer"
+	"github.com/microsoft/TypeScript/tsc/internal/tspath"
+	"gotest.tools/v3/assert"
+)
+
+func parseSmithersConditional(fileName string, text string) *ast.SourceFile {
+	return parser.ParseSourceFile(ast.SourceFileParseOptions{
+		FileName: fileName,
+		Path:     tspath.Path(fileName),
+	}, text, core.ScriptKindTS)
+}
+
+func printSmithersConditional(file *ast.SourceFile) string {
+	p := printer.NewPrinter(
+		printer.PrinterOptions{NewLine: core.NewLineKindLF},
+		printer.PrintHandlers{},
+		nil,
+	)
+	return strings.TrimSuffix(p.EmitSourceFile(file), "\n")
+}
+
+func TestSmithersConditionalDeclarationRoundTrip(t *testing.T) {
+	t.Parallel()
+	data := []struct {
+		title string
+		input string
+	}{
+		{"conditional const", "if (const u = lookup(k); u !== null) {\n    use(u);\n}"},
+		{"conditional let", "if (let u = lookup(k); u) {\n    use(u);\n}"},
+		{"conditional destructuring", "if (const { a, b } = pair(); a) {\n    use(b);\n}"},
+		{"conditional with else", "if (const u = lookup(k); u) {\n    use(u);\n}\nelse {\n    other(u);\n}"},
+		{"conditional else-if chain", "if (const a = f(); a) {\n    use(a);\n}\nelse if (const b = g(); b) {\n    use(b);\n}"},
+		{"plain if unchanged", "if (c) {\n    use(1);\n}"},
+		{"let remains an identifier", "if (let > 3) {\n    use(1);\n}"},
+	}
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			for _, fileName := range []string{"/main.sm", "/main.sm.ts"} {
+				file := parseSmithersConditional(fileName, rec.input)
+				assert.Equal(t, len(file.Diagnostics()), 0, "unexpected parse diagnostics in "+fileName)
+				actual := printSmithersConditional(file)
+				file = parseSmithersConditional(fileName, actual)
+				assert.Equal(t, len(file.Diagnostics()), 0, "unexpected reparse diagnostics")
+				assert.Equal(t, printSmithersConditional(file), actual, "printer is not idempotent")
+			}
+		})
+	}
+}
+
+func TestSmithersConditionalDeclarationNodeShape(t *testing.T) {
+	t.Parallel()
+	file := parseSmithersConditional("/main.sm", "if (const u = f(); u) { g(u); } else { h(u); }")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	statement := file.Statements.Nodes[0]
+	assert.Equal(t, statement.Kind, ast.KindIfStatement)
+	assert.Assert(t, statement.AsIfStatement().Initializer != nil)
+	assert.Assert(t, ast.IsVariableDeclarationList(statement.AsIfStatement().Initializer))
+	var children []ast.Kind
+	statement.ForEachChild(func(node *ast.Node) bool {
+		children = append(children, node.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{
+		ast.KindVariableDeclarationList, ast.KindIdentifier, ast.KindBlock, ast.KindBlock,
+	})
+	assert.Assert(t, ast.IsBlockScope(statement, statement.Parent),
+		"an if with a conditional declaration must be a block scope")
+	plain := parseSmithersConditional("/main.sm", "if (u) { g(u); }").Statements.Nodes[0]
+	assert.Assert(t, plain.AsIfStatement().Initializer == nil)
+	assert.Assert(t, !ast.IsBlockScope(plain, plain.Parent), "a plain if must not become a block scope")
+}
+
+func TestSmithersConditionalDeclarationDialectGate(t *testing.T) {
+	t.Parallel()
+	tsFile := parseSmithersConditional("/main.ts", "if (const u = f(); u) { g(u); }")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "a conditional declaration must not be accepted in .ts")
+	assert.Assert(t, tsFile.Statements.Nodes[0].AsIfStatement().Initializer == nil,
+		"a .ts if must never carry a conditional declaration")
+	file := parseSmithersConditional("/main.sm", "if (let > 3) { g(); }")
+	assert.Equal(t, len(file.Diagnostics()), 0, "let must remain an identifier in a condition")
+	assert.Assert(t, file.Statements.Nodes[0].AsIfStatement().Initializer == nil)
+}
