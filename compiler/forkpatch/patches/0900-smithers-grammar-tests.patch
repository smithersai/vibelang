+// TestSmithersLabeledValueBodyIsChecked is the checker-arm proof for the labeled
+// value's *body*, and it is deliberately not written the obvious way.
+//
+// The obvious probe — an undefined name inside the construct — passes with
+// `checkLabeledExpression`'s checkSourceElement call deleted, because collecting
+// the construct's type checks every value break expression anyway. That is the
+// lazy-resolution trap in a new shape: a statement subtree hanging off an
+// expression is reached by nothing in the ordinary statement walk, so the proof
+// has to use a diagnostic that only the statement check pass can produce — an
+// error in a statement that is not itself one of the exits.
+func TestSmithersLabeledValueBodyIsChecked(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function use(value: unknown): void;
+declare function cond(): boolean;
+declare const scores: number[];
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"an undefined name in a non-exit statement is reported",
+			"const k = verdict: {\n    totallyUndefinedIdentifier();\n    break :verdict 1;\n};\nuse(k);",
+			[]int32{2304},
+		},
+		{
+			"a bad annotation on a binding nothing reads is reported",
+			"const k = verdict: {\n    const ignored: string = 42;\n    break :verdict 1;\n};\nuse(k);",
+			[]int32{2322},
+		},
+		{
+			"a missing property in a non-exit statement is reported",
+			"declare const h: { a: number };\nconst k = verdict: {\n    use(h.nope);\n    break :verdict 1;\n};\nuse(k);",
+			[]int32{2339},
+		},
+		{
+			"the same holds inside a loop value body",
+			"const f = search: for (const s of scores) {\n    const ignored: string = 42;\n    break :search s;\n} else -1;\nuse(f);",
+			[]int32{2322},
+		},
+		{
+			"...and in a loop value's else completion",
+			"const f = search: for (const s of scores) {\n    break :search s;\n} else totallyUndefinedIdentifier();\nuse(f);",
+			[]int32{2304},
+		},
+		{
+			"a well-typed body reports nothing",
+			"const k = verdict: {\n    const ok: number = 42;\n    use(ok);\n    break :verdict ok;\n};\nuse(k);",
+			[]int32{},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
