+// TestSmithersExpressionNodesAreReachable closes a trap that neither the
+// accessor sweep nor any diagnostic test can see.
+//
+// ast.IsExpressionNode is a THIRD enumerated expression-kind switch. It does not
+// delegate to isExpressionKind or isLeftHandSideExpressionKind — it restates the
+// list — so adding an expression kind to those two leaves it answering false
+// here. Everything that asks "what is the type of the node under the cursor"
+// goes through it: getTypeOfNode, getSymbolAtLocation, isInExpressionContext,
+// and the type/symbol baseline writer. A Smithers expression missing from it
+// still parses, binds and type-checks perfectly, and reports every diagnostic it
+// should, while answering with no type at all — which is exactly why it has to
+// be asserted rather than inferred.
+func TestSmithersExpressionNodesAreReachable(t *testing.T) {
+	t.Parallel()
+
+	const source = `declare const scores: number[];
+declare const flag: boolean;
+declare const two: 1 | 2;
+const blockValue = verdict: { break :verdict "x"; };
+const loopValue = search: for (const s of scores) { break :search s; } else -1;
+const ifValue = if (flag) { 1 } else { 2 };
+const switchValue = switch (two) { case 1: "a" case 2: "b" };
+`
+	expected := []struct {
+		kind ast.Kind
+		text string
+	}{
+		{ast.KindLabeledExpression, `"x"`},
+		{ast.KindLabeledExpression, "number"},
+		{ast.KindIfExpression, "1 | 2"},
+		{ast.KindSwitchExpression, `"a" | "b"`},
+	}
+
+	fs := vfstest.FromMap(map[string]string{
+		smithersLangTestFile: source,
+		"/tsconfig.json": smithersLangTestConfig,
+	}, false /*useCaseSensitiveFileNames*/)
+	fs = bundled.WrapFS(fs)
+	host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	assert.Equal(t, len(errors), 0, "unexpected command line errors")
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	file := program.GetSourceFile(smithersLangTestFile)
+	assert.Assert(t, file != nil, "source file missing from program")
+	assert.Equal(t, len(program.GetSemanticDiagnostics(t.Context(), file)), 0)
+
+	c, done := program.GetTypeCheckerForFile(t.Context(), file)
+	defer done()
+
+	var initializers []*ast.Node
+	for _, statement := range file.Statements.Nodes {
+		if statement.Kind != ast.KindVariableStatement {
+			continue
+		}
+		declaration := statement.AsVariableStatement().
+			DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0]
+		if declaration.Initializer() != nil {
+			initializers = append(initializers, declaration.Initializer())
+		}
+	}
+	assert.Equal(t, len(initializers), len(expected), "the probe must produce one initializer per Smithers expression kind")
+
+	for i, rec := range expected {
+		node := initializers[i]
+		assert.Equal(t, node.Kind, rec.kind)
+		assert.Assert(t, ast.IsExpressionNode(node),
+			"ast.IsExpressionNode must answer true for a "+rec.kind.String())
+		assert.Equal(t, c.TypeToString(c.GetTypeAtLocation(node)), rec.text,
+			"getTypeOfNode must answer with the expression's real type for a "+rec.kind.String())
+	}
+}
