+// TestSmithersValueClauseStatementsAreChecked is the checker-arm proof for the
+// statements a switch-expression clause runs before its final expression.
+//
+// Nothing in the ordinary statement walk reaches them: they hang off an
+// expression, and checkSourceElementWorker has no default arm, so without the
+// checkSourceElements call in checkSwitchExpression the entire clause body is
+// silently NOT type-checked and produces zero diagnostics. Every row requires
+// the SAME diagnostic the identical statement produces outside the construct.
+func TestSmithersValueClauseStatementsAreChecked(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `type Grade = "pass" | "fail";
+declare const grade: Grade;
+declare const handle: { close(): void };
+declare function use(value: unknown): void;
+`
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"control: the same statements outside the switch",
+			"handle.nonExistentMethod();\ntotallyUndefinedIdentifier();\nuse(1);",
+			[]int32{2304, 2339},
+		},
+		{
+			"a case clause's leading statements are checked",
+			"const d = switch (grade) {\n    case \"pass\":\n        handle.nonExistentMethod();\n        totallyUndefinedIdentifier();\n        1\n    default: 0\n};\nuse(d);",
+			[]int32{2304, 2339},
+		},
+		{
+			"a default clause's leading statements are checked",
+			"const d = switch (grade) {\n    case \"pass\": 1\n    default:\n        handle.nonExistentMethod();\n        totallyUndefinedIdentifier();\n        0\n};\nuse(d);",
+			[]int32{2304, 2339},
+		},
+		{
+			// LAZY TYPE RESOLUTION masks a missing checker arm: an undefined name in
+			// a clause is reported anyway once the switch's own type is demanded.
+			// A declaration whose ANNOTATION its initializer violates is a diagnostic
+			// only the check pass can produce, and nothing else asks for it.
+			"a binding declared in a clause is checked against its own annotation",
+			"const d = switch (grade) {\n    case \"pass\":\n        const wrong: number = \"not a number\";\n        wrong\n    default: 0\n};\nuse(d);",
+			[]int32{2322},
+		},
+		{
+			"correct statements in a clause are accepted",
+			"const d = switch (grade) {\n    case \"pass\":\n        handle.close();\n        1\n    default: 0\n};\nuse(d);",
+			[]int32{},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+item.body), item.expected)
+		})
+	}
+}
+
+// TestSmithersValueClauseCompletionIsTotal proves every clause contributes a
+// type: its final expression when it has one, and `undefined` when it can
+// complete without one.
+//
+// The permissive failure here is SILENT — a clause that simply drops out of the
+// union makes an incomplete switch look complete, and the resulting type is
+// narrower than the values the construct can actually produce. Divergence is the
+// only reason a clause may contribute nothing, and that is a reachability
+// question about the end of the clause, not a syntactic one.
+func TestSmithersValueClauseCompletionIsTotal(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `type Grade = "pass" | "fail";
+declare const grade: Grade;
+declare function record(message: string): void;
+declare function use(value: unknown): void;
+`
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"a clause with a final expression contributes it",
+			"const d: string = switch (grade) {\n    case \"pass\": record(\"p\"); \"met\"\n    default: \"other\"\n};\nuse(d);",
+			[]int32{},
+		},
+		{
+			"a clause whose body ends in a statement contributes undefined",
+			"const d: string = switch (grade) {\n    case \"pass\":\n        record(\"p\");\n    default: \"other\"\n};\nuse(d);",
+			[]int32{2322},
+		},
+		{
+			"an empty clause contributes undefined",
+			"const d: string = switch (grade) {\n    case \"pass\":\n    default: \"other\"\n};\nuse(d);",
+			[]int32{2322},
+		},
+		{
+			"a clause ending in an if statement contributes undefined",
+			"const d: string = switch (grade) {\n    case \"pass\":\n        if (grade === \"pass\") {\n            record(\"p\");\n        }\n    default: \"other\"\n};\nuse(d);",
+			[]int32{2322},
+		},
+		{
+			// The reachability half. A clause that throws never completes, so it
+			// contributes nothing rather than `undefined` — which is what makes this
+			// a flow question and not "the last statement is not an expression".
+			"a clause that throws contributes nothing",
+			"const d: string = switch (grade) {\n    case \"pass\":\n        throw new Error(\"nope\");\n    default: \"other\"\n};\nuse(d);",
+			[]int32{},
+		},
+		{
+			"a clause that returns contributes nothing",
+			"function f(): string {\n    const d: string = switch (grade) {\n        case \"pass\":\n            return \"early\";\n        default: \"other\"\n    };\n    return d;\n}\nuse(f);",
+			[]int32{},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+item.body), item.expected)
+		})
+	}
+}
