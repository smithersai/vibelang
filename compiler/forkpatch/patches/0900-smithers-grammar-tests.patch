+// TestSmithersValueClauseLocalsAreCheckedForUnusedIdentifiers closes the
+// second half of the block-scope trap. ast.IsBlockScope and
+// binder.GetContainerFlags both already say KindCaseBlock owns a locals table,
+// so the table exists — but a locals container ALSO needs the unused-identifier
+// plumbing, and checkSwitchExpression never registered its case block. Without
+// the registration noUnusedLocals never looks inside a value `switch` at all.
+func TestSmithersValueClauseLocalsAreCheckedForUnusedIdentifiers(t *testing.T) {
+	t.Parallel()
+
+	const config = `{ "compilerOptions": { "strict": true, "noEmit": true, "noUnusedLocals": true }, "files": ["main.sm.ts"] }`
+	const prelude = `type Grade = "pass" | "fail";
+declare const grade: Grade;
+declare function use(value: unknown): void;
+`
+
+	codes := smithersLangDiagnosticCodesWithOptions(t, prelude+
+		"const d = switch (grade) {\n    case \"pass\":\n        const unusedBinding = 1;\n        \"met\"\n    default: \"other\"\n};\nuse(d);",
+		config)
+	assert.DeepEqual(t, codes, []int32{6133})
+
+	// ...and a used one is not reported, so the arm reports rather than merely fires.
+	codes = smithersLangDiagnosticCodesWithOptions(t, prelude+
+		"const d = switch (grade) {\n    case \"pass\":\n        const usedBinding = 1;\n        `${usedBinding}`\n    default: \"other\"\n};\nuse(d);",
+		config)
+	assert.DeepEqual(t, codes, []int32{})
+}
