+// TestSmithersSwitchClausesIsKindAware proves the one abstraction the six
+// flow-analysis sites share.
+//
+// ast.SwitchClauses is what replaced `node.AsSwitchStatement().CaseBlock…` at
+// every site a FlowSwitchClause can reach. It must answer for both switch kinds
+// and it must PANIC rather than answer emptily for anything else, because an
+// empty clause list is a perfectly plausible-looking wrong answer that would
+// make every switch look non-narrowing and non-exhaustive.
+func TestSmithersSwitchClausesIsKindAware(t *testing.T) {
+	t.Parallel()
+
+	const source = `declare const grade: "pass" | "fail";
+declare function use(value: unknown): void;
+switch (grade) { case "pass": use(1); break; default: use(2); }
+const value = switch (grade) { case "pass": 1 default: 2 };
+`
+	file, _, done := smithersLangProgram(t, source)
+	defer done()
+
+	var statementSwitch *ast.Node
+	var expressionSwitch *ast.Node
+	var walk func(*ast.Node) bool
+	walk = func(node *ast.Node) bool {
+		switch node.Kind {
+		case ast.KindSwitchStatement:
+			statementSwitch = node
+		case ast.KindSwitchExpression:
+			expressionSwitch = node
+		}
+		node.ForEachChild(walk)
+		return false
+	}
+	file.AsNode().ForEachChild(walk)
+
+	assert.Assert(t, statementSwitch != nil, "the probe must contain a statement switch")
+	assert.Assert(t, expressionSwitch != nil, "the probe must contain a value switch")
+	assert.Equal(t, len(ast.SwitchClauses(statementSwitch)), 2)
+	assert.Equal(t, len(ast.SwitchClauses(expressionSwitch)), 2)
+	assert.Equal(t, ast.SwitchClauses(expressionSwitch)[0].Kind, ast.KindCaseClause)
+	assert.Equal(t, ast.SwitchClauses(expressionSwitch)[1].Kind, ast.KindDefaultClause)
+
+	defer func() {
+		assert.Assert(t, recover() != nil, "ast.SwitchClauses must panic on a kind that is not a switch")
+	}()
+	ast.SwitchClauses(file.AsNode())
+}
+
+// TestSmithersExpressionContextMembersAreReachable closes a FOURTH enumerated
+// expression-kind switch, one level below ast.IsExpressionNode.
+//
+// IsExpressionNode answers for an Identifier or a literal by delegating to
+// IsInExpressionContext, which switches on the PARENT's kind and asks whether
+// the node is the member that parent evaluates. Every Smithers member that
+// holds an expression needs an arm there, and a missing one is completely
+// silent: the construct parses, binds, type-checks and reports every diagnostic
+// it should while getTypeOfNode answers `any` for the expression inside it.
+//
+// The `default:` clause of a value switch was worse than silent. Its arm read
+// `parent.Expression()`, which has no KindDefaultClause case, so asking for the
+// type of an identifier used as a default clause's value PANICKED. That arm was
+// safe upstream only because a default clause's other children are statements
+// and a statement never reaches IsInExpressionContext.
+//
+// The label of a labeled statement and of a `break :label value` are identifiers
+// with those same parents and are NOT expressions, so they are asserted false in
+// the same sweep: an arm written as "any identifier child" would pass the
+// positive half and be wrong.
+func TestSmithersExpressionContextMembersAreReachable(t *testing.T) {
+	t.Parallel()
+
+	const source = `declare const subject: string;
+declare const scores: number[];
+declare const two: 1 | 2;
+declare function use(value: unknown): void;
+function deferred(): void { defer subject; }
+function errdeferred(): void { errdefer subject; }
+const blockValue = verdict: { break :verdict subject; };
+const loopValue = search: for (const s of scores) { break :search subject; } else subject;
+const switchValue = switch (two) { case 1: subject default: subject };
+use([deferred, errdeferred, blockValue, loopValue, switchValue]);
+`
+	file, c, done := smithersLangProgram(t, source)
+	defer done()
+
+	expectedParents := []ast.Kind{
+		ast.KindVariableDeclaration, // the `declare const subject` name — not an expression
+		ast.KindDeferStatement,
+		ast.KindErrdeferStatement,
+		ast.KindBreakStatement,   // `break :verdict subject`
+		ast.KindBreakStatement,   // `break :search subject`
+		ast.KindLabeledStatement, // the loop `else` completion value
+		ast.KindCaseClause,
+		ast.KindDefaultClause,
+	}
+
+	var parents []ast.Kind
+	var walk func(*ast.Node) bool
+	walk = func(node *ast.Node) bool {
+		if node.Kind == ast.KindIdentifier && node.Text() == "subject" {
+			parents = append(parents, node.Parent.Kind)
+			isDeclarationName := node.Parent.Kind == ast.KindVariableDeclaration
+			assert.Equal(t, ast.IsExpressionNode(node), !isDeclarationName,
+				"ast.IsExpressionNode under a "+node.Parent.Kind.String())
+			if !isDeclarationName {
+				// getTypeOfNode answers errorType — printed as `any` — for a node
+				// IsExpressionNode rejects, so this is the assertion that fails when
+				// an arm is missing.
+				assert.Equal(t, c.TypeToString(c.GetTypeAtLocation(node)), "string",
+					"getTypeOfNode under a "+node.Parent.Kind.String())
+			}
+		}
+		if node.Kind == ast.KindIdentifier && (node.Text() == "verdict" || node.Text() == "search") {
+			assert.Assert(t, !ast.IsExpressionNode(node),
+				"a label is not an expression, under a "+node.Parent.Kind.String())
+		}
+		node.ForEachChild(walk)
+		return false
+	}
+	file.AsNode().ForEachChild(walk)
+	assert.DeepEqual(t, parents, expectedParents)
+}
+
+// TestSmithersReturnStatementsInsideLabeledValues proves that return-type
+// inference sees a `return` written inside an expression-position labeled value.
+//
+// ast.ForEachReturnStatement is an allowlist of statement kinds, complete for
+// ordinary TypeScript because a `return` is only legal in a statement position.
+// A labeled block value hangs statements off an expression, so a `return` inside
+// one sits under a VariableStatement the allowlist does not even enter. Missing
+// it produces a WRONG INFERRED RETURN TYPE and a wrong `.d.ts` rather than a
+// diagnostic, so the probe is written to make the difference a diagnostic: the
+// inferred type is used at a site that only accepts the narrower one.
+//
+// The second row is the function-boundary stop, which the every-child walk needs
+// and the allowlist got for free by never entering an expression.
+func TestSmithersReturnStatementsInsideLabeledValues(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"a return inside a labeled block value contributes to the inferred type",
+			"function f(x: number) {\n  const k: number = verdict: {\n    if (x > 0) { return \"early\"; }\n    break :verdict 1;\n  };\n  return k;\n}\nconst n: number = f(1);\nuse(n);",
+			[]int32{2322},
+		},
+		{
+			"a return inside a nested function does not",
+			"function g(x: number) {\n  const k: number = verdict: {\n    const inner = function (): string { return \"not mine\"; };\n    const arrow = (): boolean => { return true; };\n    use([inner, arrow, x]);\n    break :verdict 1;\n  };\n  return k;\n}\nconst n: number = g(1);\nuse(n);",
+			[]int32{},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t,
+				"declare function use(value: unknown): void;\n"+item.body), item.expected)
+		})
+	}
+}
