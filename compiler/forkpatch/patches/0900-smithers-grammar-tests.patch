+// TestSmithersLabeledValueFlowGraph observes each exit of an expression-position
+// labeled value separately, so a wrong flow edge changes the reported
+// diagnostics instead of passing silently. The construct has two exits — the
+// value breaks, and normal completion — and the type depends on telling them
+// apart.
+func TestSmithersLabeledValueFlowGraph(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function use(value: unknown): void;
+declare function takesString(value: string): void;
+declare function cond(): boolean;
+declare const scores: number[];
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			// The value break exit skips the else value entirely, so a block whose
+			// every path takes a value break has no undefined in its type.
+			"a block whose every path value-breaks is exhaustive",
+			"const k = verdict: {\n    if (cond()) {\n        break :verdict \"a\";\n    }\n    break :verdict \"b\";\n};\ntakesString(k);",
+			[]int32{},
+		},
+		{
+			"a throw is not a value exit but does not leave the block open either",
+			"const k = verdict: {\n    if (cond()) throw new Error();\n    break :verdict \"b\";\n};\ntakesString(k);",
+			[]int32{},
+		},
+		{
+			// A plain `break label` completes the construct without a value, so it
+			// reaches the normal-completion exit and undefined enters the type.
+			"a plain labeled break reaches the completion exit",
+			"const k = verdict: {\n    if (cond()) break verdict;\n    break :verdict \"b\";\n};\ntakesString(k);",
+			[]int32{2345},
+		},
+		{
+			// ...and in a loop value the same path flows into the else value rather
+			// than into undefined.
+			"a plain labeled break flows into the else value",
+			"const f = search: for (const s of scores) {\n    if (cond()) break search;\n    break :search \"a\";\n} else 1;\ntakesString(f);",
+			[]int32{2345},
+		},
+		{
+			"normal loop completion flows into the else value",
+			"const f = search: for (const s of scores) {\n    if (cond()) break :search \"a\";\n} else 1;\ntakesString(f);",
+			[]int32{2345},
+		},
+		{
+			"a continue flows into the else value",
+			"const f = search: for (const s of scores) {\n    if (cond()) continue;\n    break :search \"a\";\n} else 1;\ntakesString(f);",
+			[]int32{2345},
+		},
+		{
+			"an unlabeled break flows into the else value",
+			"const f = search: for (const s of scores) {\n    if (cond()) break;\n    break :search \"a\";\n} else 1;\ntakesString(f);",
+			[]int32{2345},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
