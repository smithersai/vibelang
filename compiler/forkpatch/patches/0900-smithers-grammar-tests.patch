+package checker_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/ast"
+	"github.com/microsoft/TypeScript/tsc/internal/bundled"
+	"github.com/microsoft/TypeScript/tsc/internal/compiler"
+	"github.com/microsoft/TypeScript/tsc/internal/core"
+	"github.com/microsoft/TypeScript/tsc/internal/tsoptions"
+	"github.com/microsoft/TypeScript/tsc/internal/vfs/vfstest"
+	"gotest.tools/v3/assert"
+)
+
+const smithersConditionalTestFile = "/main.sm.ts"
+const smithersConditionalTestConfig = `{ "compilerOptions": { "strict": true, "noEmit": true }, "files": ["main.sm.ts"] }`
+
+func smithersConditionalDiagnosticCodes(t *testing.T, content string) []int32 {
+	t.Helper()
+	return smithersConditionalDiagnosticCodesWithOptions(t, content, smithersConditionalTestConfig)
+}
+
+func smithersConditionalDiagnosticCodesWithOptions(t *testing.T, content string, config string) []int32 {
+	t.Helper()
+	fs := vfstest.FromMap(map[string]string{
+		smithersConditionalTestFile: content,
+		"/tsconfig.json": config,
+	}, false /*useCaseSensitiveFileNames*/)
+	fs = bundled.WrapFS(fs)
+	host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	assert.Equal(t, len(errors), 0, "unexpected command line errors")
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	file := program.GetSourceFile(smithersConditionalTestFile)
+	assert.Assert(t, file != nil, "source file missing from program")
+	syntactic := program.GetSyntacticDiagnostics(t.Context(), file)
+	assert.Equal(t, len(syntactic), 0, "unexpected syntactic diagnostics: %v", conditionalDiagnosticCodes(syntactic))
+	return conditionalDiagnosticCodes(program.GetSemanticDiagnostics(t.Context(), file))
+}
+
+func conditionalDiagnosticCodes(diagnostics []*ast.Diagnostic) []int32 {
+	codes := make([]int32, 0, len(diagnostics))
+	for _, diagnostic := range diagnostics {
+		codes = append(codes, diagnostic.Code())
+	}
+	slices.Sort(codes)
+	return codes
+}
+
+func TestSmithersConditionalDeclarationScope(t *testing.T) {
+	t.Parallel()
+	const prelude = `declare function get(): { name: string } | null;
+declare function takes(value: { name: string }): void;
+declare function use(value: unknown): void;
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{"narrowed in the then branch", "if (const u = get(); u !== null) { takes(u); }", []int32{}},
+		{"visible in the else branch", "if (const u = get(); u !== null) { takes(u); } else { use(u); }", []int32{}},
+		{"narrowed in the else branch", "if (const u = get(); u !== null) { use(u); } else { const n: null = u; use(n); }", []int32{}},
+		{"the else branch lacks the then narrowing", "if (const u = get(); u !== null) { use(u); } else { takes(u); }", []int32{2345}},
+		{"out of scope after the construct", "if (const u = get(); u !== null) { takes(u); } use(u);", []int32{2304}},
+		{"else-if scopes compose", "if (const a = get(); a !== null) { takes(a); } else if (const b = get(); b !== null) { takes(b); use(a); }", []int32{}},
+		{"an outer name is restored afterward", "const u = 1; if (const u = get(); u !== null) { takes(u); } use(u.toFixed(2));", []int32{}},
+	}
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersConditionalDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
+
+func TestSmithersConditionalDeclarationInitializerIsChecked(t *testing.T) {
+	t.Parallel()
+	const prelude = `declare function use(value: unknown): void;`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{"an unreferenced initializer is checked", "if (const ignored = totallyUndefinedIdentifier(); true) { use(1); }", []int32{2304}},
+		{"an initializer is checked against its annotation", "if (const n: string = 42; n) { use(n); }", []int32{2322}},
+		{"an uninitialized const is rejected", "if (const n; true) { use(n); }", []int32{1155, 7005}},
+	}
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersConditionalDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
+
+func TestSmithersConditionalDeclarationLocals(t *testing.T) {
+	t.Parallel()
+	const config = `{ "compilerOptions": { "strict": true, "noEmit": true, "noUnusedLocals": true }, "files": ["main.sm.ts"] }`
+	codes := smithersConditionalDiagnosticCodesWithOptions(t,
+		"declare function get(): number; if (const unusedBinding = get(); get()) { get(); }", config)
+	assert.DeepEqual(t, codes, []int32{6133})
+	codes = smithersConditionalDiagnosticCodesWithOptions(t,
+		"declare function get(): number; if (const usedBinding = get(); usedBinding > 1) { get(); }", config)
+	assert.DeepEqual(t, codes, []int32{})
+}
