+// TestSmithersContextualTypeReachesValueOperands closes a FIFTH enumerated
+// switch, and — like ast.IsInExpressionContext — it switches on the PARENT kind.
+//
+// checker.getContextualType has an arm for KindConditionalExpression and had
+// none for the value `if` or the value `switch`, so every branch and every clause
+// value was checked with NO contextual type: a contextually typed arrow reports
+// TS7006 on a correct program, and an object literal widens instead of matching
+// the discriminated union it was written for. It survived every grammar patch
+// because nothing in a diagnostic-shaped test of the CONSTRUCT looks at it — the
+// probes below are correct programs whose only errors come from the missing arm.
+func TestSmithersContextualTypeReachesValueOperands(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `type Grade = "pass" | "fail";
+type Action = { readonly kind: "inc" } | { readonly kind: "dec" };
+declare const grade: Grade;
+declare const flag: boolean;
+declare function use(value: unknown): void;
+`
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"control: a conditional expression already had the arm",
+			"const f: (n: number) => number = flag ? (n) => n : (n) => n + 1;\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a value if branch contextually types an arrow parameter",
+			"const f: (n: number) => number = if (flag) { (n) => n } else { (n) => n + 1 };\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a braceless value if branch does too",
+			"const f: (n: number) => number = if (flag) (n) => n else (n) => n + 1;\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a value switch clause value contextually types an arrow parameter",
+			"const f: (n: number) => number = switch (grade) {\n    case \"pass\": (n) => n\n    default: (n) => n + 1\n};\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a clause value after leading statements does too",
+			"const f: (n: number) => number = switch (grade) {\n    case \"pass\": use(1); (n) => n\n    default: (n) => n + 1\n};\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a value if branch keeps a discriminated-union literal from widening",
+			"const a: Action = if (flag) { { kind: \"inc\" } } else { { kind: \"dec\" } };\nuse(a);",
+			[]int32{},
+		},
+		{
+			"a value switch clause value does too",
+			"const a: Action = switch (grade) {\n    case \"pass\": { kind: \"inc\" }\n    default: { kind: \"dec\" }\n};\nuse(a);",
+			[]int32{},
+		},
+		{
+			// The arms answer for the MEMBER, not for any child. The condition of a
+			// value `if` is a truthiness position and a `case` label is a comparison
+			// against the scrutinee; neither takes the construct's contextual type,
+			// exactly as for a conditional expression. Both rows fail by going
+			// GREEN — the implicit-any goes away — if the member guard is dropped.
+			"the condition of a value if takes no contextual type",
+			"const f: (n: number) => number = if ((n) => n) { (n) => n } else { (n) => n + 1 };\nuse(f);",
+			[]int32{2872, 7006},
+		},
+		{
+			"a case label takes no contextual type",
+			"const f: (n: number) => number = switch (grade) {\n    case ((n) => n): (n) => n\n    default: (n) => n + 1\n};\nuse(f);",
+			[]int32{2678, 7006},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+item.body), item.expected)
+		})
+	}
+
+	// ...and the arm reports rather than merely firing: a genuinely wrong branch
+	// value is still rejected against the contextual type.
+	assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+
+		"const f: (n: number) => number = if (flag) { (n: string) => n } else { (n) => n + 1 };\nuse(f);"),
+		[]int32{2322})
+}
