+// TestSmithersNodeShape proves the generated AST nodes are real: correct kind,
+// correct children, reachable through the generated ForEachChild, and inside the
+// statement kind range as ast.IsStatement (an explicit 18-arm switch, not a range
+// check) understands it.
+func TestSmithersNodeShape(t *testing.T) {
+	t.Parallel()
+	file := parseSmithers("/main.sm", "defer close();\nerrdefer rollback();")
+	stmts := file.Statements.Nodes
+	assert.Equal(t, len(stmts), 2)
+	assert.Equal(t, stmts[0].Kind, ast.KindDeferStatement)
+	assert.Equal(t, stmts[1].Kind, ast.KindErrdeferStatement)
+	assert.Assert(t, ast.IsDeferStatement(stmts[0]))
+	assert.Assert(t, ast.IsErrdeferStatement(stmts[1]))
+	assert.Assert(t, ast.IsStatement(stmts[0]), "DeferStatement must satisfy ast.IsStatement")
+	assert.Assert(t, ast.IsStatement(stmts[1]), "ErrdeferStatement must satisfy ast.IsStatement")
+	assert.Assert(t, ast.KindFirstStatement <= stmts[0].Kind && stmts[0].Kind <= ast.KindLastStatement,
+		"DeferStatement must be inside the statement kind range")
+	assert.Assert(t, ast.KindFirstStatement <= stmts[1].Kind && stmts[1].Kind <= ast.KindLastStatement,
+		"ErrdeferStatement must be inside the statement kind range")
+
+	var seen int
+	stmts[0].ForEachChild(func(n *ast.Node) bool {
+		seen++
+		assert.Assert(t, ast.IsCallExpression(n))
+		return false
+	})
+	assert.Equal(t, seen, 1)
+	assert.Assert(t, stmts[0].AsDeferStatement().Expression != nil)
+
+	assert.Equal(t, stmts[0].Pos(), 0)
+	assert.Equal(t, stmts[0].End(), len("defer close();"))
+
+	// break :label value
+	file = parseSmithers("/main.sm", "outer: {\n    break :outer f();\n}")
+	labeled := file.Statements.Nodes[0]
+	assert.Equal(t, labeled.Kind, ast.KindLabeledStatement)
+	brk := labeled.AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0]
+	assert.Equal(t, brk.Kind, ast.KindBreakStatement)
+	assert.Assert(t, brk.AsBreakStatement().Label != nil)
+	assert.Assert(t, brk.AsBreakStatement().Value != nil)
+	assert.Assert(t, ast.IsCallExpression(brk.AsBreakStatement().Value))
+
+	var children []ast.Kind
+	brk.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{ast.KindIdentifier, ast.KindCallExpression})
+
+	// Subtree facts must propagate out of the value, or transformers silently
+	// skip a construct that needs downleveling.
+	file = parseSmithers("/main.sm", "async function f() {\n    outer: {\n        break :outer await g();\n    }\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	fn := file.Statements.Nodes[0]
+	blk := fn.AsFunctionDeclaration().Body.AsBlock().Statements.Nodes[0]
+	brk = blk.AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0]
+	assert.Assert(t, brk.SubtreeFacts()&ast.SubtreeContainsES2017 != 0,
+		"await inside a break value must propagate subtree facts to the break statement")
+
+	// if (const x = f(); cond) — the conditional declaration is the first child,
+	// so every position-ordered consumer (astnav, formatting, the services token
+	// walk) sees children in source order.
+	file = parseSmithers("/main.sm", "if (const u = f(); u) {\n    g(u);\n}\nelse {\n    h(u);\n}")
+	ifStatement := file.Statements.Nodes[0]
+	assert.Equal(t, ifStatement.Kind, ast.KindIfStatement)
+	assert.Assert(t, ifStatement.AsIfStatement().Initializer != nil)
+	assert.Assert(t, ast.IsVariableDeclarationList(ifStatement.AsIfStatement().Initializer))
+	children = nil
+	ifStatement.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{
+		ast.KindVariableDeclarationList, ast.KindIdentifier, ast.KindBlock, ast.KindBlock,
+	})
+
+	// ast.IsBlockScope decides where GetEnclosingBlockScopeContainer stops, and it
+	// must agree with binder.GetContainerFlags: only a conditional declaration
+	// makes an `if` a block scope, never a plain one.
+	assert.Assert(t, ast.IsBlockScope(ifStatement, ifStatement.Parent),
+		"an if with a conditional declaration must be a block scope")
+	plainIf := parseSmithers("/main.ts", "if (u) { g(u); }").Statements.Nodes[0]
+	assert.Assert(t, !ast.IsBlockScope(plainIf, plainIf.Parent),
+		"a plain if must not become a block scope")
+
+	// label: loop else value — the else value is the labeled statement's third
+	// child, again in source order.
+	file = parseSmithers("/main.sm", "search: for (const s of xs) {\n    break :search s;\n} else fallback;")
+	labeled = file.Statements.Nodes[0]
+	assert.Equal(t, labeled.Kind, ast.KindLabeledStatement)
+	assert.Equal(t, labeled.AsLabeledStatement().Statement.Kind, ast.KindForOfStatement)
+	assert.Assert(t, labeled.AsLabeledStatement().ElseValue != nil)
+	children = nil
+	labeled.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{
+		ast.KindIdentifier, ast.KindForOfStatement, ast.KindIdentifier,
+	})
+
+	// Subtree facts must propagate out of the else value too.
+	file = parseSmithers("/main.sm", "async function f() {\n    search: while (c()) {\n        break :search 1;\n    } else await g();\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	labeled = file.Statements.Nodes[0].AsFunctionDeclaration().Body.AsBlock().Statements.Nodes[0]
+	assert.Assert(t, labeled.SubtreeFacts()&ast.SubtreeContainsES2017 != 0,
+		"await inside a loop else value must propagate subtree facts to the labeled statement")
+}
+
+// labeledValue returns the LabeledExpression a probe's first declaration is
+// initialized with.
+func labeledValue(t *testing.T, text string) *ast.Node {
+	t.Helper()
+	file := parseSmithers("/main.sm", text)
+	assert.Equal(t, len(file.Diagnostics()), 0, "probe source must parse cleanly: "+text)
+	return file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+}
+
+// TestSmithersLabeledExpressionShape proves the expression-position labeled
+// block and loop values are one real expression node wrapping the LabeledStatement
+// that already exists, rather than two new kinds restating it, and that the two
+// shapes the reference has to diagnose are unrepresentable here instead.
+func TestSmithersLabeledExpressionShape(t *testing.T) {
+	t.Parallel()
+
+	block := labeledValue(t, "const k = verdict: {\n    break :verdict 1;\n};")
+	assert.Equal(t, block.Kind, ast.KindLabeledExpression)
+	assert.Assert(t, ast.IsExpression(block), "a labeled value must satisfy ast.IsExpression")
+	assert.Assert(t, ast.IsLeftHandSideExpression(block))
+	assert.Equal(t, ast.GetExpressionPrecedence(block), ast.OperatorPrecedencePrimary)
+	assert.Assert(t, !ast.IsStatement(block), "a labeled value must not satisfy ast.IsStatement")
+
+	// The wrapped node is an ordinary LabeledStatement, which is what lets the
+	// binder and checker functions that already handle one do all the work.
+	inner := block.AsLabeledExpression().Statement
+	assert.Equal(t, inner.Kind, ast.KindLabeledStatement)
+	assert.Equal(t, inner.AsLabeledStatement().Statement.Kind, ast.KindBlock)
+	assert.Assert(t, inner.AsLabeledStatement().ElseValue == nil, "a block value has no else value")
+	assert.Equal(t, block.Pos(), inner.Pos())
+	assert.Equal(t, block.End(), inner.End())
+
+	var children []ast.Kind
+	block.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{ast.KindLabeledStatement})
+
+	loop := labeledValue(t, "const f = search: for (const s of xs) {\n    break :search s;\n} else -1;")
+	assert.Equal(t, loop.Kind, ast.KindLabeledExpression)
+	innerLoop := loop.AsLabeledExpression().Statement.AsLabeledStatement()
+	assert.Equal(t, innerLoop.Statement.Kind, ast.KindForOfStatement)
+	assert.Assert(t, innerLoop.ElseValue != nil, "a loop value carries its else completion value")
+	children = nil
+	loop.AsLabeledExpression().Statement.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{
+		ast.KindIdentifier, ast.KindForOfStatement, ast.KindPrefixUnaryExpression,
+	})
+
+	// Subtree facts must propagate out of a value break and out of an else value,
+	// or a transformer that gates on SubtreeContainsES2017 silently skips the
+	// construct.
+	file := parseSmithers("/main.sm", "async function f() {\n    const k = verdict: {\n        break :verdict await g();\n    };\n    return k;\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	declaration := file.Statements.Nodes[0].AsFunctionDeclaration().Body.AsBlock().Statements.Nodes[0]
+	assert.Assert(t, declaration.SubtreeFacts()&ast.SubtreeContainsES2017 != 0,
+		"await inside a labeled block value must propagate subtree facts")
+	file = parseSmithers("/main.sm", "async function f() {\n    const k = search: while (c()) {\n        break :search 1;\n    } else await g();\n    return k;\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	declaration = file.Statements.Nodes[0].AsFunctionDeclaration().Body.AsBlock().Statements.Nodes[0]
+	assert.Assert(t, declaration.SubtreeFacts()&ast.SubtreeContainsES2017 != 0,
+		"await inside a labeled loop else value must propagate subtree facts")
+
+	// Statement position is untouched: the label is claimed for a LabeledStatement
+	// exactly as upstream does, so an ordinary labeled block keeps working and a
+	// statement-position value loop keeps its landed statement form.
+	statement := parseSmithers("/main.sm", "outer: {\n    g();\n}").Statements.Nodes[0]
+	assert.Equal(t, statement.Kind, ast.KindLabeledStatement)
+	statement = parseSmithers("/main.sm", "search: while (c()) {\n    break :search 1;\n} else 0;").Statements.Nodes[0]
+	assert.Equal(t, statement.Kind, ast.KindLabeledStatement)
+
+	// The two productions that claim a following `:` for themselves must keep it.
+	// Without the suppression each of these is read as a labeled value and stops
+	// being valid TypeScript at all.
+	file = parseSmithers("/main.sm", "switch (x) {\n    case a: {\n        g();\n    }\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0, "`case a: { … }` must stay a case clause")
+	clause := file.Statements.Nodes[0].AsSwitchStatement().CaseBlock.AsCaseBlock().Clauses.Nodes[0]
+	assert.Equal(t, clause.AsCaseOrDefaultClause().Statements.Nodes[0].Kind, ast.KindBlock)
+	file = parseSmithers("/main.sm", "const t = c ? a : { k: 1 };")
+	assert.Equal(t, len(file.Diagnostics()), 0, "`c ? a : { … }` must stay a conditional")
+	assert.Equal(t, labeledValue(t, "const t = c ? a : { k: 1 };").Kind, ast.KindConditionalExpression)
+	// The value switch added by the previous lane parses its case label the same
+	// way, so it needs the same suppression — and only a clause *value* that
+	// begins with `{` can show it.
+	file = parseSmithers("/main.sm", "const s = switch (g) {\n    case a: { k: 1 }\n    default: 2\n};")
+	assert.Equal(t, len(file.Diagnostics()), 0, "a value-switch case label must keep its colon")
+	clause = file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer().
+		AsSwitchExpression().CaseBlock.AsCaseBlock().Clauses.Nodes[0]
+	assert.Equal(t, clause.AsCaseOrDefaultClause().Value.Kind, ast.KindObjectLiteralExpression)
+
+	// Suppression is keyed on the position of the expression that starts at the
+	// ambiguous site and on nothing else, so a labeled value nested inside one of
+	// those expressions is still legal.
+	file = parseSmithers("/main.sm", "f(verdict: {\n    break :verdict 1;\n});")
+	assert.Equal(t, len(file.Diagnostics()), 0, "a labeled value nested in a statement expression must parse")
+	file = parseSmithers("/main.sm", "const t = c ? f(verdict: {\n    break :verdict 1;\n}) : 0;")
+	assert.Equal(t, len(file.Diagnostics()), 0, "a labeled value nested in a conditional whenTrue must parse")
+
+	// The reference's two fail-closed rules are grammar here rather than
+	// diagnostics: a loop value with no `else` completion (SMITHERS1715) is a parse
+	// error, and an unlabeled block or loop in expression position (SMITHERS1702) is
+	// not expressible at all.
+	assert.Assert(t, len(parseSmithers("/main.sm", "const f = search: while (c()) { break :search 1; };").Diagnostics()) > 0,
+		"a loop value with no else completion must fail closed")
+	assert.Assert(t, len(parseSmithers("/main.sm", "const f = for (const s of xs) { break 1; };").Diagnostics()) > 0,
+		"an unlabeled loop in expression position must fail closed")
+	assert.Assert(t, len(parseSmithers("/main.sm", "const f = { break :x 1; };").Diagnostics()) > 0,
+		"an unlabeled block in expression position must fail closed")
+
+	// .ts is unaffected.
+	assert.Assert(t, len(parseSmithers("/main.ts", "const k = verdict: { break :verdict 1; };").Diagnostics()) > 0,
+		"a labeled block value must not be accepted in .ts")
+	assert.Assert(t, len(parseSmithers("/main.ts", "const f = search: for (const s of xs) { break :search s; } else -1;").Diagnostics()) > 0,
+		"a labeled loop value must not be accepted in .ts")
+}
+
+// TestSmithersValueBreakTraversal pins ast.ForEachValueBreakStatement, which is
+// where a labeled value's type comes from. It has to stop exactly where the
+// binder's own label resolution stops: a `break` cannot cross a function
+// boundary, and a nested label of the same name captures the breaks below it.
+// Collecting one break too many silently widens the construct's type; collecting
+// one too few silently narrows it. Neither shows up as a diagnostic.
+func TestSmithersValueBreakTraversal(t *testing.T) {
+	t.Parallel()
+
+	collect := func(text string) []string {
+		value := labeledValue(t, text)
+		labeled := value.AsLabeledExpression().Statement.AsLabeledStatement()
+		var found []string
+		ast.ForEachValueBreakStatement(labeled.Statement, labeled.Label.Text(), func(stmt *ast.Node) bool {
+			found = append(found, stmt.AsBreakStatement().Value.Text())
+			return false
+		})
+		return found
+	}
+
+	assert.DeepEqual(t, collect("const k = v: {\n    if (c) break :v \"a\";\n    break :v \"b\";\n};"),
+		[]string{"a", "b"})
+
+	// A value break nested inside another value construct's block still targets
+	// this label, and that block hangs off an expression — which is why the walk
+	// cannot use ForEachReturnStatement's statement-kind allowlist.
+	assert.DeepEqual(t, collect("const k = v: {\n    const i = w: {\n        break :v \"inner\";\n    };\n    break :v \"outer\";\n};"),
+		[]string{"inner", "outer"})
+
+	// A jump cannot cross a function boundary, so a break inside a nested
+	// function is not one of this label's exits even when the name matches. The
+	// probe must NOT rebind the name inside the function, or the rebound-label
+	// stop below would mask the boundary stop and either could be deleted
+	// undetected.
+	assert.DeepEqual(t, collect("const k = v: {\n    const f = function () {\n        break :v \"nested\";\n    };\n    break :v \"outer\";\n};"),
+		[]string{"outer"})
+	assert.DeepEqual(t, collect("const k = v: {\n    const f = () => {\n        break :v \"arrow\";\n    };\n    break :v \"outer\";\n};"),
+		[]string{"outer"})
+
+	// A nested label of the same name captures the breaks below it, exactly as
+	// binder.findActiveLabel returns the nearest match.
+	assert.DeepEqual(t, collect("const k = v: {\n    v: {\n        break :v \"inner\";\n    }\n    break :v \"outer\";\n};"),
+		[]string{"outer"})
+
+	// A break to a different label is never this label's exit.
+	assert.DeepEqual(t, collect("const k = v: {\n    w: {\n        break :w \"other\";\n    }\n    break :v \"outer\";\n};"),
+		[]string{"outer"})
+}
+
+// TestSmithersAccessorMembersReachable is the other half of the accessor sweep.
+// Parity against a same-shaped node proves a new member changed nothing, but it
+// cannot prove a member is *reachable*: if both the subject and the reference
+// panic, they agree. This test asserts the positive invariant directly — every
+// member whose name matches one of ast.go's 21 generic accessors must be
+// returned by that accessor, by pointer identity.
+func TestSmithersAccessorMembersReachable(t *testing.T) {
+	t.Parallel()
+
+	statement := func(fileName string, text string) *ast.Node {
+		file := parseSmithers(fileName, text)
+		assert.Equal(t, len(file.Diagnostics()), 0, "probe source must parse cleanly: "+text)
+		return file.Statements.Nodes[0]
+	}
+
+	deferStatement := statement("/main.sm", "defer e;")
+	errdeferStatement := statement("/main.sm", "errdefer e;")
+	conditionalIf := statement("/main.sm", "if (const u = f(); u) { g(u); }")
+	labeledLoop := statement("/main.sm", "search: while (c()) { break :search 1; } else 0;")
+	valueBreak := statement("/main.sm", "outer: { break :outer e; }").
+		AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0]
+	valueSwitch := statement("/main.sm", "const s = switch (g) { case 1: \"a\" default: \"b\" };").
+		AsVariableStatement().DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	labeledExpression := statement("/main.sm", "const k = verdict: { break :verdict 1; };").
+		AsVariableStatement().DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+
+	data := []struct {
+		title    string
+		node     *ast.Node
+		accessor func(*ast.Node) *ast.Node
+		expected *ast.Node
+	}{
+		{"DeferStatement.Expression", deferStatement, (*ast.Node).Expression, deferStatement.AsDeferStatement().Expression},
+		{"ErrdeferStatement.Expression", errdeferStatement, (*ast.Node).Expression, errdeferStatement.AsErrdeferStatement().Expression},
+		{"IfStatement.Initializer", conditionalIf, (*ast.Node).Initializer, conditionalIf.AsIfStatement().Initializer},
+		{"IfStatement.Expression", conditionalIf, (*ast.Node).Expression, conditionalIf.AsIfStatement().Expression},
+		{"LabeledStatement.Label", labeledLoop, (*ast.Node).Label, labeledLoop.AsLabeledStatement().Label},
+		{"LabeledStatement.Statement", labeledLoop, (*ast.Node).Statement, labeledLoop.AsLabeledStatement().Statement},
+		{"BreakStatement.Label", valueBreak, (*ast.Node).Label, valueBreak.AsBreakStatement().Label},
+		{"SwitchExpression.Expression", valueSwitch, (*ast.Node).Expression, valueSwitch.AsSwitchExpression().Expression},
+		{"LabeledExpression.Statement", labeledExpression, (*ast.Node).Statement, labeledExpression.AsLabeledExpression().Statement},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.Assert(t, rec.expected != nil, "the probe did not produce the member")
+			assert.Equal(t, rec.accessor(rec.node), rec.expected,
+				"the generic accessor must return the member itself")
+		})
+	}
+
+	// A plain `if` must keep answering the new accessor without panicking, or
+	// every upstream caller that reaches an IfStatement generically crashes.
+	plainIf := statement("/main.ts", "if (u) { g(u); }")
+	assert.Assert(t, plainIf.Initializer() == nil, "a plain if has no conditional declaration")
+}
+
+// TestSmithersAccessorParity is the generic-accessor trap sweep. ast.go has 21
+// hand-written accessors, each with a panicking default arm; a new node kind
+// needs an arm in exactly the accessors whose name matches one of its members.
+// This test does not assert that by hand: it calls every accessor on the new
+// kind and on an upstream kind with the same member shape, and requires the
+// return-versus-panic behaviour to be identical. A missed arm makes them differ.
+func TestSmithersAccessorParity(t *testing.T) {
+	t.Parallel()
+
+	accessors := map[string]func(*ast.Node) any{
+		"Expression":        func(n *ast.Node) any { return n.Expression() },
+		"RawText":           func(n *ast.Node) any { return n.RawText() },
+		"Arguments":         func(n *ast.Node) any { return n.Arguments() },
+		"TypeArguments":     func(n *ast.Node) any { return n.TypeArguments() },
+		"TypeParameterList": func(n *ast.Node) any { return n.TypeParameterList() },
+		"MemberList":        func(n *ast.Node) any { return n.MemberList() },
+		"StatementList":     func(n *ast.Node) any { return n.StatementList() },
+		"Initializer":       func(n *ast.Node) any { return n.Initializer() },
+		"TagName":           func(n *ast.Node) any { return n.TagName() },
+		"CommentList":       func(n *ast.Node) any { return n.CommentList() },
+		"Label":             func(n *ast.Node) any { return n.Label() },
+		"Attributes":        func(n *ast.Node) any { return n.Attributes() },
+		"Children":          func(n *ast.Node) any { return n.Children() },
+		"ModuleSpecifier":   func(n *ast.Node) any { return n.ModuleSpecifier() },
+		"ImportClause":      func(n *ast.Node) any { return n.ImportClause() },
+		"Statement":         func(n *ast.Node) any { return n.Statement() },
+		"PropertyList":      func(n *ast.Node) any { return n.PropertyList() },
+		"ElementList":       func(n *ast.Node) any { return n.ElementList() },
+		"QuestionDotToken":  func(n *ast.Node) any { return n.QuestionDotToken() },
+		"TypeExpression":    func(n *ast.Node) any { return n.TypeExpression() },
+		"ClassName":         func(n *ast.Node) any { return n.ClassName() },
+	}
+
+	// Guard the sweep itself: if upstream grows a 22nd panicking accessor this
+	// count must be updated, otherwise a new node kind can be shipped with an
+	// unswept accessor and this test would still pass.
+	assert.Equal(t, len(accessors), 21, "ast.go's panicking accessor set changed; re-sweep every Smithers node kind")
+
+	probe := func(n *ast.Node, call func(*ast.Node) any) (result string) {
+		defer func() {
+			if r := recover(); r != nil {
+				result = "panic"
+			}
+		}()
+		if value := call(n); value == nil {
+			return "nil"
+		} else {
+			return fmt.Sprintf("%T", value)
+		}
+	}
+
+	firstStatement := func(fileName string, text string) *ast.Node {
+		file := parseSmithers(fileName, text)
+		assert.Equal(t, len(file.Diagnostics()), 0, "probe source must parse cleanly: "+text)
+		return file.Statements.Nodes[0]
+	}
+
+	// DeferStatement and ErrdeferStatement have the exact member shape of the
+	// upstream ThrowStatement: one required Expression on StatementBase.
+	// BreakStatement is compared against itself parsed without a value, which
+	// proves the added Value member did not change any accessor's behaviour.
+	cases := []struct {
+		title     string
+		reference *ast.Node
+		subject   *ast.Node
+	}{
+		{
+			"DeferStatement vs ThrowStatement",
+			firstStatement("/main.ts", "throw e;"),
+			firstStatement("/main.sm", "defer e;"),
+		},
+		{
+			"ErrdeferStatement vs ThrowStatement",
+			firstStatement("/main.ts", "throw e;"),
+			firstStatement("/main.sm", "errdefer e;"),
+		},
+		{
+			"BreakStatement with value vs without",
+			firstStatement("/main.ts", "outer: { break outer; }").AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0],
+			firstStatement("/main.sm", "outer: { break :outer e; }").AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0],
+		},
+		{
+			"IfStatement with conditional declaration vs without",
+			firstStatement("/main.ts", "if (u) { g(u); }"),
+			firstStatement("/main.sm", "if (const u = f(); u) { g(u); }"),
+		},
+		{
+			"LabeledStatement with else value vs without",
+			firstStatement("/main.ts", "search: while (c()) { break; }"),
+			firstStatement("/main.sm", "search: while (c()) { break :search 1; } else 0;"),
+		},
+	}
+
+	for _, rec := range cases {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			for name, call := range accessors {
+				expected := probe(rec.reference, call)
+				actual := probe(rec.subject, call)
+				assert.Equal(t, actual, expected,
+					"Node."+name+"() behaves differently on "+rec.subject.Kind.String()+
+						" than on "+rec.reference.Kind.String())
+			}
+		})
+	}
+
+	// LabeledExpression has no same-shaped upstream node to pair with — nothing
+	// upstream is an expression with a single Statement member — so parity has
+	// nothing to say about it. Assert the closure directly instead: Statement is
+	// its only accessor-named member, so exactly one of the 21 may answer and the
+	// other 20 must still panic. An arm added to the wrong accessor is caught here
+	// rather than at the first generic consumer.
+	labeledExpression := firstStatement("/main.sm", "const k = verdict: { break :verdict 1; };").
+		AsVariableStatement().DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	assert.Equal(t, labeledExpression.Kind, ast.KindLabeledExpression)
+	for name, call := range accessors {
+		expected := "panic"
+		if name == "Statement" {
+			expected = "*ast.Node"
+		}
+		assert.Equal(t, probe(labeledExpression, call), expected,
+			"Node."+name+"() answers wrongly for a LabeledExpression")
+	}
+}
+
+// TestSmithersDialectGate is the P0 interop gate: the new grammar must be
+// invisible in .ts files, the .ts parse tree must be unchanged, and both new
+// keywords must remain ordinary identifiers everywhere.
+func TestSmithersDialectGate(t *testing.T) {
+	t.Parallel()
+
+	// Both keywords sit after KindLastReservedWord, and p.isIdentifier() is
+	// `token > KindLastReservedWord`, so existing code using them as names keeps
+	// working in every dialect.
+	for _, fileName := range []string{"/main.ts", "/main.sm", "/main.sm.ts"} {
+		file := parseSmithers(fileName, "const errdefer = 1;\nconst defer = 2;\nerrdefer + defer;")
+		assert.Equal(t, len(file.Diagnostics()), 0, "contextual keywords must remain identifiers in "+fileName)
+	}
+
+	// The Smithers statement forms must NOT parse in a .ts file: the tree must be
+	// the same shape upstream produces today.
+	tsFile := parseSmithers("/main.ts", "defer close();")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "defer statement must not be accepted in .ts")
+	assert.Equal(t, tsFile.Statements.Nodes[0].Kind, ast.KindExpressionStatement)
+
+	tsFile = parseSmithers("/main.ts", "errdefer close();")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "errdefer statement must not be accepted in .ts")
+	assert.Equal(t, tsFile.Statements.Nodes[0].Kind, ast.KindExpressionStatement)
+
+	tsFile = parseSmithers("/main.ts", "outer: { break :outer 1; }")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "value break must not be accepted in .ts")
+	brk := tsFile.Statements.Nodes[0].AsLabeledStatement().Statement.AsBlock().Statements.Nodes[0]
+	assert.Equal(t, brk.Kind, ast.KindBreakStatement)
+	assert.Assert(t, brk.AsBreakStatement().Value == nil, "a .ts break must never carry a value")
+
+	// ASI: `break` keeps ECMAScript's no-LineTerminator rule for the label even
+	// in Smithers files, so a newline before the colon must not be consumed.
+	file := parseSmithers("/main.sm", "outer: {\n    break\n    :outer 1;\n}")
+	assert.Assert(t, len(file.Diagnostics()) > 0, "a line break before `:` must not produce a value break")
+
+	// ...and a newline after the label ends the statement rather than swallowing
+	// the following expression statement as a value.
+	file = parseSmithers("/main.sm", "outer: {\n    break :outer\n    f();\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	block := file.Statements.Nodes[0].AsLabeledStatement().Statement.AsBlock()
+	assert.Equal(t, len(block.Statements.Nodes), 2)
+	assert.Assert(t, block.Statements.Nodes[0].AsBreakStatement().Value == nil,
+		"ASI must end the break before the next line")
+
+	// A conditional declaration must not parse in .ts, and the .ts tree upstream
+	// produces today must be unchanged.
+	tsFile = parseSmithers("/main.ts", "if (const u = f(); u) { g(u); }")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "a conditional declaration must not be accepted in .ts")
+	assert.Assert(t, tsFile.Statements.Nodes[0].AsIfStatement().Initializer == nil,
+		"a .ts if must never carry a conditional declaration")
+
+	// `let` must stay usable as an ordinary identifier in a Smithers condition:
+	// the declaration form is only claimed behind a binding-identifier lookahead.
+	file = parseSmithers("/main.sm", "if (let > 3) {\n    g();\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0, "`let` must remain an identifier in a condition")
+	assert.Assert(t, file.Statements.Nodes[0].AsIfStatement().Initializer == nil)
+
+	// A loop else must not parse in .ts.
+	tsFile = parseSmithers("/main.ts", "search: while (c()) { break; } else 1;")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "a loop else must not be accepted in .ts")
+	assert.Assert(t, tsFile.Statements.Nodes[0].AsLabeledStatement().ElseValue == nil,
+		"a .ts labeled statement must never carry an else value")
+
+	// The else is claimed only for an iteration statement, so a labeled block with
+	// an else fails closed rather than silently acquiring a completion value.
+	file = parseSmithers("/main.sm", "outer: {\n    break :outer 1;\n}\nelse 2;")
+	assert.Assert(t, len(file.Diagnostics()) > 0, "a labeled block must not take an else value")
+
+	// ...and a labeled `if` keeps its own else, which is not a completion value.
+	file = parseSmithers("/main.sm", "l: if (c) {\n    a();\n}\nelse {\n    b();\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	assert.Assert(t, file.Statements.Nodes[0].AsLabeledStatement().ElseValue == nil,
+		"the else of a labeled if belongs to the if")
+
+	// An expression-position labeled value must not parse in .ts, and the .ts tree
+	// must be the one upstream produces today.
+	tsFile = parseSmithers("/main.ts", "const k = verdict: { break :verdict 1; };")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "a labeled block value must not be accepted in .ts")
+	tsFile = parseSmithers("/main.ts", "const f = search: for (const s of xs) { break :search s; } else -1;")
+	assert.Assert(t, len(tsFile.Diagnostics()) > 0, "a labeled loop value must not be accepted in .ts")
+
+	// ...and the ambiguous shapes must still be exactly what .ts makes of them.
+	for _, fileName := range []string{"/main.ts", "/main.sm", "/main.sm.ts"} {
+		file = parseSmithers(fileName, "switch (x) {\n    case a: {\n        g();\n    }\n}\nconst t = c ? a : { k: 1 };\nouter: {\n    g();\n}")
+		assert.Equal(t, len(file.Diagnostics()), 0,
+			"the three colon-claiming productions must be unchanged in "+fileName)
+		assert.Equal(t, file.Statements.Nodes[0].Kind, ast.KindSwitchStatement)
+		assert.Equal(t, file.Statements.Nodes[1].AsVariableStatement().
+			DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer().Kind,
+			ast.KindConditionalExpression)
+		assert.Equal(t, file.Statements.Nodes[2].Kind, ast.KindLabeledStatement)
+	}
+}
+
+// TestSmithersValueExpressionShape proves the value-position `if`/`switch` are
+// real expression nodes rather than statements smuggled into an expression slot:
+// they satisfy ast.IsExpression through isLeftHandSideExpressionKind, they carry
+// primary precedence so they are never parenthesized and never parenthesize
+// their operands, and statement-position `if`/`switch` are untouched.
+func TestSmithersValueExpressionShape(t *testing.T) {
+	t.Parallel()
+
+	file := parseSmithers("/main.sm", "const x = if (b) { 10 } else { 0 };")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	initializer := file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	assert.Equal(t, initializer.Kind, ast.KindIfExpression)
+	assert.Assert(t, ast.IsExpression(initializer), "a value if must satisfy ast.IsExpression")
+	assert.Assert(t, ast.IsLeftHandSideExpression(initializer))
+	assert.Equal(t, ast.GetExpressionPrecedence(initializer), ast.OperatorPrecedencePrimary)
+
+	var children []ast.Kind
+	initializer.ForEachChild(func(n *ast.Node) bool {
+		children = append(children, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, children, []ast.Kind{
+		ast.KindIdentifier, ast.KindNumericLiteral, ast.KindNumericLiteral,
+	})
+
+	file = parseSmithers("/main.sm", "const s = switch (g) {\n    case 1: \"a\"\n    default: \"b\"\n};")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	initializer = file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	assert.Equal(t, initializer.Kind, ast.KindSwitchExpression)
+	assert.Assert(t, ast.IsExpression(initializer), "a value switch must satisfy ast.IsExpression")
+	assert.Equal(t, ast.GetExpressionPrecedence(initializer), ast.OperatorPrecedencePrimary)
+	clauses := initializer.AsSwitchExpression().CaseBlock.AsCaseBlock().Clauses.Nodes
+	assert.Equal(t, len(clauses), 2)
+	for _, clause := range clauses {
+		assert.Assert(t, clause.AsCaseOrDefaultClause().Value != nil,
+			"a switch-expression clause carries a value")
+		assert.Equal(t, len(clause.AsCaseOrDefaultClause().Statements.Nodes), 0,
+			"a switch-expression clause carries no statements")
+	}
+
+	// Subtree facts must propagate out of a branch value, or a transformer
+	// silently skips a construct that needs downleveling.
+	file = parseSmithers("/main.sm", "async function f() {\n    const x = if (b) { await g() } else { 0 };\n    return x;\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	declaration := file.Statements.Nodes[0].AsFunctionDeclaration().Body.AsBlock().Statements.Nodes[0]
+	assert.Assert(t, declaration.SubtreeFacts()&ast.SubtreeContainsES2017 != 0,
+		"await inside a value if branch must propagate subtree facts")
+
+	// Statement position is untouched: parseStatement claims a statement-initial
+	// `if`/`switch` before any expression parse runs.
+	assert.Equal(t, parseSmithers("/main.sm", "if (b) { g(); }").Statements.Nodes[0].Kind, ast.KindIfStatement)
+	assert.Equal(t, parseSmithers("/main.sm", "switch (g) { case 1: h(); break; }").Statements.Nodes[0].Kind,
+		ast.KindSwitchStatement)
+
+	// ...including after a `case` label and after a statement label, the two
+	// places the POC's text pre-pass had to disambiguate by hand.
+	file = parseSmithers("/main.sm", "switch (g) {\n    case 1:\n        if (b) {\n            h();\n        }\n        break;\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	clause := file.Statements.Nodes[0].AsSwitchStatement().CaseBlock.AsCaseBlock().Clauses.Nodes[0]
+	assert.Equal(t, clause.AsCaseOrDefaultClause().Statements.Nodes[0].Kind, ast.KindIfStatement)
+	assert.Assert(t, clause.AsCaseOrDefaultClause().Value == nil,
+		"a statement switch clause must never acquire a value")
+	file = parseSmithers("/main.sm", "l: if (b) {\n    h();\n}")
+	assert.Equal(t, file.Statements.Nodes[0].AsLabeledStatement().Statement.Kind, ast.KindIfStatement)
+
+	// The grammar refuses the shape the reference refuses without needing a
+	// diagnostic of its own: a value `if` with no else branch (SMITHERS1705) has no
+	// value, and is a parse error rather than a checked node.
+	assert.Assert(t, len(parseSmithers("/main.sm", "const x = if (b) { 1 };").Diagnostics()) > 0,
+		"a value if with no else branch must fail closed")
+
+	// A braceless branch is the specification's own spelling
+	// (`const value = if (condition) consequent else alternate`) and is accepted
+	// in the one host that bounds it. TestSmithersBracelessValueIfIsBoundedToItsHost
+	// is where the boundary itself is proved.
+	file = parseSmithers("/main.sm", "const x = if (b) 1 else 2;")
+	assert.Equal(t, len(file.Diagnostics()), 0, "a braceless value if is accepted in a variable initializer")
+	initializer = file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	assert.Equal(t, initializer.Kind, ast.KindIfExpression)
+	assert.Equal(t, initializer.AsIfExpression().WhenTrue.Kind, ast.KindNumericLiteral)
+	assert.Equal(t, initializer.AsIfExpression().WhenFalse.Kind, ast.KindNumericLiteral)
+
+	// .ts is unaffected.
+	assert.Assert(t, len(parseSmithers("/main.ts", "const x = if (b) { 10 } else { 0 };").Diagnostics()) > 0,
+		"a value if must not be accepted in .ts")
+	assert.Assert(t, len(parseSmithers("/main.ts", "const s = switch (g) { case 1: \"a\" default: \"b\" };").Diagnostics()) > 0,
+		"a value switch must not be accepted in .ts")
+}
+
+// TestSmithersBracelessValueIfIsBoundedToItsHost is the boundary itself.
+//
+// The specification writes the value `if` as `const value = if (c) a else b`,
+// and the conformance corpus accepts exactly that while refusing the same
+// spelling in a general expression placement (`f(x, if (c) a else b)`) as
+// SMITHERS1709. The refusal is a GRAMMAR decision, not a diagnostic: the branch
+// brace is simply required outside the bounded host, so the illegal shape has no
+// node anyone could report on.
+//
+// It is keyed on the POSITION the initializer starts at, so every one of the
+// placements below fails for the same reason — the `if` begins somewhere other
+// than that position — including a parenthesized initializer, whose `if` starts
+// one character later. A context flag would have had to be cleared by hand at
+// each of them.
+func TestSmithersBracelessValueIfIsBoundedToItsHost(t *testing.T) {
+	t.Parallel()
+
+	accepted := []struct{ title, input string }{
+		{"variable initializer", "const x = if (b) 1 else 2;"},
+		{"let initializer", "let x = if (b) 1 else 2;"},
+		{"for-statement initializer", "for (const x = if (b) 1 else 2; c;) { }"},
+		{"else-if chain inherits the host", "const x = if (a) 1 else if (b) 2 else 3;"},
+		{"second declarator in the same list", "const a = 1, b = if (c) 2 else 3;"},
+		{"braced branches still work", "const x = if (b) { 1 } else { 2 };"},
+	}
+	for _, rec := range accepted {
+		t.Run("accepted/"+rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.Equal(t, len(parseSmithers("/main.sm", rec.input).Diagnostics()), 0, rec.input)
+		})
+	}
+
+	refused := []struct{ title, input string }{
+		{"call argument", "f(a, if (b) 1 else 2);"},
+		{"return statement", "function g() { return if (b) 1 else 2; }"},
+		{"array element", "const x = [if (b) 1 else 2];"},
+		{"object property value", "const x = { k: if (b) 1 else 2 };"},
+		{"assignment right side", "let x;\nx = if (b) 1 else 2;"},
+		{"parenthesized initializer", "const x = (if (b) 1 else 2);"},
+		{"nested inside a braceless branch", "const x = if (a) if (b) 1 else 2 else 3;"},
+		{"parameter default", "function g(p = if (b) 1 else 2) { }"},
+		{"class property initializer", "class K { p = if (b) 1 else 2; }"},
+	}
+	for _, rec := range refused {
+		t.Run("refused/"+rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.Assert(t, len(parseSmithers("/main.sm", rec.input).Diagnostics()) > 0,
+				"a braceless branch outside the bounded host must fail closed: "+rec.input)
+		})
+	}
+
+	// The dialect gate still holds: braceless or braced, `.ts` gets neither.
+	assert.Assert(t, len(parseSmithers("/main.ts", "const x = if (b) 1 else 2;").Diagnostics()) > 0,
+		"a braceless value if must not be accepted in .ts")
+}
+
+// TestSmithersValueClauseBodyShape proves a switch-expression clause carries the
+// statements it runs AND the final expression that is its value, and that the
+// value is the expression itself rather than the ExpressionStatement it was
+// parsed inside.
+//
+// The single shape is what keeps every consumer honest: the binder binds
+// clause.Value, the checker unions it, and ast.IsInExpressionContext compares
+// against it. If the trailing statement were left in place instead, each of
+// those would need a second code path that finds it.
+func TestSmithersValueClauseBodyShape(t *testing.T) {
+	t.Parallel()
+
+	file := parseSmithers("/main.sm", "const s = switch (g) {\n    case 1:\n        h();\n        \"a\"\n    default:\n        throw e;\n};")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	initializer := file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	assert.Equal(t, initializer.Kind, ast.KindSwitchExpression)
+	clauses := initializer.AsSwitchExpression().CaseBlock.AsCaseBlock().Clauses.Nodes
+	assert.Equal(t, len(clauses), 2)
+
+	withValue := clauses[0].AsCaseOrDefaultClause()
+	assert.Equal(t, len(withValue.Statements.Nodes), 1, "the leading statement stays a statement")
+	assert.Equal(t, withValue.Statements.Nodes[0].Kind, ast.KindExpressionStatement)
+	assert.Assert(t, withValue.Value != nil, "the final expression becomes the clause value")
+	assert.Equal(t, withValue.Value.Kind, ast.KindStringLiteral,
+		"the value is the expression, not the ExpressionStatement that held it")
+	assert.Equal(t, withValue.Value.Parent, clauses[0],
+		"the value is reparented onto the clause")
+
+	// A clause that diverges has no final expression and no value. That is legal:
+	// it never completes, so it contributes nothing to the switch's type.
+	diverging := clauses[1].AsCaseOrDefaultClause()
+	assert.Equal(t, len(diverging.Statements.Nodes), 1)
+	assert.Equal(t, diverging.Statements.Nodes[0].Kind, ast.KindThrowStatement)
+	assert.Assert(t, diverging.Value == nil, "a diverging clause has no value")
+
+	// ForEachChild reaches all three members, or a transformer walks past one.
+	var kinds []ast.Kind
+	clauses[0].ForEachChild(func(n *ast.Node) bool {
+		kinds = append(kinds, n.Kind)
+		return false
+	})
+	assert.DeepEqual(t, kinds, []ast.Kind{
+		ast.KindNumericLiteral, ast.KindExpressionStatement, ast.KindStringLiteral,
+	})
+
+	// A single-expression clause keeps the shape it already had: no statements.
+	file = parseSmithers("/main.sm", "const s = switch (g) {\n    case 1: \"a\"\n    default: \"b\"\n};")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	initializer = file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	for _, clause := range initializer.AsSwitchExpression().CaseBlock.AsCaseBlock().Clauses.Nodes {
+		assert.Equal(t, len(clause.AsCaseOrDefaultClause().Statements.Nodes), 0)
+		assert.Assert(t, clause.AsCaseOrDefaultClause().Value != nil)
+	}
+
+	// The expression parse gets the first look, which is the only reason a
+	// statement-initial keyword can still be a clause's VALUE: parseStatement
+	// would have claimed the `if` and left the clause with no final expression.
+	file = parseSmithers("/main.sm", "const s = switch (g) {\n    case 1: if (b) { 1 } else { 2 }\n    default: 0\n};")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	initializer = file.Statements.Nodes[0].AsVariableStatement().
+		DeclarationList.AsVariableDeclarationList().Declarations.Nodes[0].Initializer()
+	first := initializer.AsSwitchExpression().CaseBlock.AsCaseBlock().Clauses.Nodes[0].AsCaseOrDefaultClause()
+	assert.Equal(t, len(first.Statements.Nodes), 0)
+	assert.Assert(t, first.Value != nil)
+	assert.Equal(t, first.Value.Kind, ast.KindIfExpression)
+
+	// A statement `switch` clause never acquires a value, no matter how its
+	// statements end.
+	file = parseSmithers("/main.sm", "switch (x) {\n    case a:\n        g();\n        h();\n        break;\n}")
+	assert.Equal(t, len(file.Diagnostics()), 0)
+	clause := file.Statements.Nodes[0].AsSwitchStatement().CaseBlock.AsCaseBlock().Clauses.Nodes[0]
+	assert.Assert(t, clause.AsCaseOrDefaultClause().Value == nil,
+		"a statement switch clause must never acquire a value")
+	assert.Equal(t, len(clause.AsCaseOrDefaultClause().Statements.Nodes), 3)
+}
+
+// TestSmithersIdentifierReferenceNamesTheMember is the positive/negative half of
+// the transformers.IsIdentifierReference sweep.
+//
+// The emit-level proof lives in the checker package, where a whole program can
+// be emitted; this one asks the predicate directly, because the arms have to
+// name the MEMBER rather than answer true for any identifier child. A label is
+// an identifier with exactly the same parent as the value beside it — `break
+// :verdict alpha` and `search: while (…) {…} else alpha` both put one of each
+// under one node — and rewriting a jump target as `mod_1.verdict` is not a
+// diagnostic either.
+func TestSmithersIdentifierReferenceNamesTheMember(t *testing.T) {
+	t.Parallel()
+
+	const source = `defer alpha;
+errdefer beta;
+const viaIf = if (alpha) { beta } else { gamma };
+const viaSwitch = switch (alpha) {
+    case beta: gamma
+    default: delta
+};
+const viaBreak = verdict: {
+    break :verdict alpha;
+};
+const viaLoop = search: while (alpha) {
+    break :search beta;
+} else gamma;
+`
+	file := parseSmithers("/main.sm", source)
+	assert.Equal(t, len(file.Diagnostics()), 0)
+
+	references := map[ast.Kind]int{}
+	labels := 0
+	var walk func(n *ast.Node) bool
+	walk = func(n *ast.Node) bool {
+		if n.Kind == ast.KindIdentifier && n.Parent != nil {
+			if n.Parent.Kind == ast.KindVariableDeclaration && n.Parent.Name() == n {
+				// A declaration name is not a reference; that is upstream's answer
+				// and this probe is not about it.
+				return false
+			}
+			isRef := transformers.IsIdentifierReference(n, n.Parent)
+			switch n.Text() {
+			case "verdict", "search":
+				labels++
+				assert.Assert(t, !isRef,
+					"a jump-target label must not be an identifier reference (parent "+n.Parent.Kind.String()+")")
+			default:
+				assert.Assert(t, isRef,
+					"an identifier in a Smithers value position must be an identifier reference (parent "+n.Parent.Kind.String()+")")
+				references[n.Parent.Kind]++
+			}
+		}
+		return n.ForEachChild(walk)
+	}
+	file.AsNode().ForEachChild(walk)
+
+	// Four labels: the two `break :label` targets and the two statement labels.
+	assert.Equal(t, labels, 4)
+	// Every Smithers parent that can hold an identifier value is exercised.
+	for _, kind := range []ast.Kind{
+		ast.KindDeferStatement, ast.KindErrdeferStatement, ast.KindIfExpression,
+		ast.KindSwitchExpression, ast.KindCaseClause, ast.KindDefaultClause,
+		ast.KindBreakStatement, ast.KindLabeledStatement,
+	} {
+		assert.Assert(t, references[kind] > 0, "no identifier reference under a "+kind.String())
+	}
+}
