+// TestSmithersImportedNamesAreSubstitutedInValuePositions closes a SIXTH
+// enumerated switch — transformers.IsIdentifierReference — and, like
+// ast.IsInExpressionContext and checker.getContextualType, it switches on the
+// PARENT kind, so a new MEMBER trips it with no new node kind involved.
+//
+// It is the predicate the CommonJS module transformer and the enum/namespace
+// transformer gate identifier SUBSTITUTION on. A `false` answer is not a
+// diagnostic and not a type: it is JavaScript that references a name that does
+// not exist in the emitted scope, compiled with exit code 0. Measured before the
+// fix, `exports.viaIf = if (flag) { alpha } else { beta }` — every one of the
+// three names unqualified, against `dep_1.flag ? dep_1.alpha : dep_1.beta` for
+// the identical conditional expression one line below it.
+//
+// KindCaseClause sat in the Expression()-only group (so it answered for the case
+// LABEL and never the value) and KindDefaultClause was in no group at all.
+func TestSmithersImportedNamesAreSubstitutedInValuePositions(t *testing.T) {
+	t.Parallel()
+
+	const dep = `export const alpha = "alpha";
+export const beta = "beta";
+export const flag = true;
+`
+	const main = `import { alpha, beta, flag } from "./dep";
+declare const two: 1 | 2;
+export const viaConditional = flag ? alpha : beta;
+export const viaIf = if (flag) { alpha } else { beta };
+export const viaBracelessIf = if (flag) alpha else beta;
+export const viaSwitch = switch (two) {
+    case 1: alpha
+    default: beta
+};
+export const viaClauseStatements = switch (two) {
+    case 1: use(alpha); beta
+    default: alpha
+};
+export const viaBreakValue = verdict: {
+    break :verdict alpha;
+};
+export const viaLoopElse = search: while (flag) {
+    break :search beta;
+} else alpha;
+declare function use(value: unknown): void;
+`
+
+	fs := vfstest.FromMap(map[string]string{
+		"/dep.ts":        dep,
+		"/main.sm.ts":    main,
+		"/tsconfig.json": `{ "compilerOptions": { "strict": true, "module": "commonjs", "target": "es2022" }, "files": ["dep.ts", "main.sm.ts"] }`,
+	}, false /*useCaseSensitiveFileNames*/)
+	fs = bundled.WrapFS(fs)
+	host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	assert.Equal(t, len(errors), 0, "unexpected command line errors")
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	file := program.GetSourceFile("/main.sm.ts")
+	assert.Assert(t, file != nil, "source file missing from program")
+	assert.Equal(t, len(program.GetSyntacticDiagnostics(t.Context(), file)), 0)
+
+	emitted := map[string]string{}
+	program.Emit(t.Context(), compiler.EmitOptions{
+		TargetSourceFiles: []*ast.SourceFile{file},
+		WriteFile: func(fileName string, text string, data *compiler.WriteFileData) error {
+			emitted[fileName] = text
+			return nil
+		},
+	})
+	js, ok := emitted["/main.sm.js"]
+	assert.Assert(t, ok, "main.sm.js was not emitted: %v", emitted)
+
+	// The control. If this line ever stops being substituted the probe is broken,
+	// not the arm.
+	assert.Assert(t, strings.Contains(js, "dep_1.flag ? dep_1.alpha : dep_1.beta"),
+		"the conditional-expression control must be substituted:\n"+js)
+
+	for _, expected := range []string{
+		"exports.viaIf = if (dep_1.flag) { dep_1.alpha } else { dep_1.beta }",
+		"exports.viaBracelessIf = if (dep_1.flag) { dep_1.alpha } else { dep_1.beta }",
+		"case 1: dep_1.alpha",
+		"default: dep_1.beta",
+		"use(dep_1.alpha);",
+		"break :verdict dep_1.alpha;",
+		"break :search dep_1.beta;",
+		"} else dep_1.alpha;",
+	} {
+		assert.Assert(t, strings.Contains(js, expected),
+			"emitted JavaScript must substitute the imported name: "+expected+"\n"+js)
+	}
+
+	// ...and the arm names the MEMBER: a jump-target label is an identifier with
+	// the same parent and must NOT be rewritten, or `break :verdict` becomes
+	// `break :dep_1.verdict`.
+	assert.Assert(t, !strings.Contains(js, "dep_1.verdict") && !strings.Contains(js, "dep_1.search"),
+		"a label is a jump target, not a reference:\n"+js)
+}
+
+// TestSmithersValueIfConditionNarrowsThroughLogicalOperators closes a SEVENTH
+// enumerated switch — binder.isStatementCondition — which also keys on the
+// PARENT.
+//
+// isTopLevelLogicalExpression reads it to decide whether a `&&` / `||` /
+// optional chain creates its OWN post-expression flow label instead of binding
+// against the enclosing true/false targets. KindConditionalExpression is in it
+// and KindIfExpression was not, so bindIfExpressionFlow set the targets and
+// bindBinaryExpressionFlow immediately threw them away: a value `if` with a
+// compound condition lost its narrowing completely and reported TS18047 on a
+// correct program, while the identical conditional expression was clean.
+func TestSmithersValueIfConditionNarrowsThroughLogicalOperators(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare const a: string | null;
+declare const b: number | null;
+declare function use(value: unknown): void;
+`
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"control: a conditional expression keeps the narrowing",
+			"const v = a !== null && b !== null ? a.length + b : 0;\nuse(v);",
+			[]int32{},
+		},
+		{
+			"a value if narrows through &&",
+			"const v = if (a !== null && b !== null) { a.length + b } else { 0 };\nuse(v);",
+			[]int32{},
+		},
+		{
+			"a value if narrows through ||",
+			"const v = if (a === null || b === null) { 0 } else { a.length + b };\nuse(v);",
+			[]int32{},
+		},
+		{
+			"a braceless value if narrows too",
+			"const v = if (a !== null && b !== null) a.length + b else 0;\nuse(v);",
+			[]int32{},
+		},
+		{
+			// ...and the arm reports rather than merely firing: the false branch of
+			// an && condition is NOT narrowed, so this stays an error.
+			"the else branch is not narrowed by the && condition",
+			"const v = if (a !== null && b !== null) { 0 } else { a.length };\nuse(v);",
+			[]int32{18047},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+item.body), item.expected)
+		})
+	}
+}
