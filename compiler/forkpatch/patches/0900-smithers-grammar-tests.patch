+// smithersLangProgram builds a one-file Smithers program and hands back its source
+// file and a type checker, for the proofs that have to ask the checker a
+// question directly rather than read a diagnostic.
+func smithersLangProgram(t *testing.T, source string) (*ast.SourceFile, *checker.Checker, func()) {
+	t.Helper()
+	fs := vfstest.FromMap(map[string]string{
+		smithersLangTestFile: source,
+		"/tsconfig.json": smithersLangTestConfig,
+	}, false /*useCaseSensitiveFileNames*/)
+	fs = bundled.WrapFS(fs)
+	host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	assert.Equal(t, len(errors), 0, "unexpected command line errors")
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	file := program.GetSourceFile(smithersLangTestFile)
+	assert.Assert(t, file != nil, "source file missing from program")
+	assert.Equal(t, len(program.GetSyntacticDiagnostics(t.Context(), file)), 0,
+		"the probe must parse cleanly")
+	assert.Equal(t, len(program.GetSemanticDiagnostics(t.Context(), file)), 0,
+		"the probe must type-check cleanly")
+	c, done := program.GetTypeCheckerForFile(t.Context(), file)
+	return file, c, done
+}
+
+const smithersLangSwitchPrelude = `type State =
+  | { kind: "ready"; value: number }
+  | { kind: "failed"; message: string }
+  | { kind: "idle" };
+type Grade = "pass" | "fail" | "retry";
+declare const state: State;
+declare const grade: Grade;
+declare const mixed: string | number;
+declare function takesNumber(value: number): void;
+declare function takesString(value: string): void;
+declare function onlyPass(value: "pass"): void;
+declare function use(value: unknown): void;
+`
+
+// TestSmithersSwitchExpressionNarrowing is the proof that a value `switch`
+// narrows its scrutinee inside a clause value, which is what makes the
+// specification's locked exhaustiveness rule mean anything: a clause body is
+// only well typed if the scrutinee is the constituent that clause selected.
+//
+// The binder creates one FlowSwitchClause per clause and checker/flow.go reads
+// its clauses back through ast.SwitchClauses. Getting either half wrong is
+// SILENT in the permissive direction — the clause value simply keeps the
+// declared type — so every row below is written so that the narrowed and
+// unnarrowed answers differ in the diagnostics.
+func TestSmithersSwitchExpressionNarrowing(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"the discriminant property narrows into every clause value",
+			"const d = switch (state.kind) { case \"ready\": state.value case \"failed\": state.message default: 0 };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"a member of the wrong constituent is still reported",
+			"const d = switch (state.kind) { case \"ready\": state.message default: 0 };\nuse(d);",
+			[]int32{2339},
+		},
+		{
+			"the scrutinee itself narrows to the clause literal",
+			"const d = switch (grade) { case \"pass\": onlyPass(grade) default: 0 };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"the default clause narrows to the residual, not to everything",
+			"const d = switch (grade) { case \"pass\": 0 default: onlyPass(grade) };\nuse(d);",
+			[]int32{2345},
+		},
+		{
+			"narrowing does not leak past the switch expression",
+			"const d = switch (grade) { case \"pass\": 0 default: 1 };\nonlyPass(grade);\nuse(d);",
+			[]int32{2345},
+		},
+		{
+			"a typeof switch expression narrows by the witness",
+			"const d = switch (typeof mixed) { case \"string\": mixed.length case \"number\": mixed.toFixed(0) default: 0 };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"a typeof default clause narrows away every handled witness",
+			"const d = switch (typeof mixed) { case \"string\": 0 default: mixed.toFixed(0) };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"switch (true) narrows by each clause condition",
+			"const d = switch (true) { case typeof mixed === \"string\": mixed.length default: mixed.toFixed(0) };\nuse(d);",
+			[]int32{},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangSwitchPrelude+item.body), item.expected)
+		})
+	}
+}
+
+// TestSmithersSwitchExpressionClauseValueIsBound closes a trap one level below
+// narrowing.
+//
+// bindChildren dispatches bindCaseOrDefaultClause instead of bindEachChild, and
+// that function enumerates the clause's members. A clause `Value` it does not
+// name is never bound at all, so every identifier in it carries a nil flow node
+// — not merely unnarrowed by the switch, but unnarrowed by ANYTHING, including
+// an `if` wrapped around the whole construct. The probe therefore establishes
+// the narrowing entirely OUTSIDE the switch and switches on a constant, so the
+// switch itself contributes nothing and only the binding is under test.
+func TestSmithersSwitchExpressionClauseValueIsBound(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"narrowing established outside the switch reaches a case clause value",
+			"if (typeof mixed === \"string\") { const d = switch (1) { case 1: mixed.length default: 0 }; use(d); }",
+			[]int32{},
+		},
+		{
+			"narrowing established outside the switch reaches a default clause value",
+			"if (typeof mixed === \"string\") { const d = switch (1) { case 1: 0 default: mixed.length }; use(d); }",
+			[]int32{},
+		},
+		{
+			"an assignment inside a clause value is tracked after the switch",
+			"let seen: string | undefined = undefined;\nconst d = switch (1) { case 1: (seen = \"a\") default: (seen = \"b\") };\ntakesString(seen);\nuse(d);",
+			[]int32{},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangSwitchPrelude+item.body), item.expected)
+		})
+	}
+}
+
+// TestSmithersSwitchExpressionCaseLabelFlow proves the value `switch` sets
+// preSwitchCaseFlow.
+//
+// bindCaseOrDefaultClause binds a case LABEL at b.preSwitchCaseFlow, which
+// bindSwitchStatement sets and which nothing set for a switch expression. The
+// label was therefore bound at whatever flow an enclosing switch statement had
+// left behind, or at nil outside one. This is a separate probe from the clause
+// value because the label and the value are bound at different flows and either
+// could be right while the other is wrong.
+func TestSmithersSwitchExpressionCaseLabelFlow(t *testing.T) {
+	t.Parallel()
+
+	assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangSwitchPrelude+
+		"declare const key: string;\n"+
+		"if (typeof mixed === \"string\") {\n"+
+		"  const d = switch (key) { case mixed.toUpperCase(): 1 default: 0 };\n"+
+		"  use(d);\n"+
+		"}"), []int32{})
+}
+
+// TestSmithersSwitchExpressionBypassEdge proves the no-default bypass edge is a
+// FlowSwitchClause with an empty clause range rather than the plain pre-switch
+// flow.
+//
+// The empty range is what isReachableFlowNodeWorker recognises as "no clause
+// matched", and it consults isExhaustiveSwitch to decide whether that path can
+// happen at all. Definite assignment is the sharpest observation of it: with an
+// exhaustive value switch every path assigns, and with a partial one the bypass
+// reaches the use unassigned. A plain pre-switch antecedent answers "reachable"
+// for both, so the exhaustive row goes red.
+func TestSmithersSwitchExpressionBypassEdge(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"an exhaustive value switch makes the bypass unreachable",
+			"function f(): string {\n  let out: string;\n  const d = switch (grade) { case \"pass\": (out = \"p\") case \"fail\": (out = \"f\") case \"retry\": (out = \"r\") };\n  use(d);\n  return out;\n}\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a partial value switch leaves the bypass reachable",
+			"function f(): string {\n  let out: string;\n  const d = switch (grade) { case \"pass\": (out = \"p\") case \"fail\": (out = \"f\") };\n  use(d);\n  return out;\n}\nuse(f);",
+			[]int32{2454},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangSwitchPrelude+item.body), item.expected)
+		})
+	}
+}
+
+// TestSmithersSwitchExhaustivenessIsOneFunction is trap C — two switches
+// deciding one fact — applied to exhaustiveness.
+//
+// checkSwitchExpression decides whether the expression's type carries
+// `undefined`, and isReachableFlowNodeWorker decides whether the binder's bypass
+// edge for the SAME node can be taken. Both answers come from isExhaustiveSwitch
+// so they cannot disagree. A second, value-switch-only implementation would:
+// it would have to re-derive the clause types itself, and the obvious
+// re-derivation handles only a literal-union scrutinee, so a `typeof` switch
+// covering every witness would carry `undefined` in its type while its own flow
+// graph called the bypass unreachable.
+func TestSmithersSwitchExhaustivenessIsOneFunction(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"a closed literal union with full coverage needs no default",
+			"const d: string = switch (grade) { case \"pass\": \"p\" case \"fail\": \"f\" case \"retry\": \"r\" };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"a missing union member keeps the undefined",
+			"const d: string = switch (grade) { case \"pass\": \"p\" case \"fail\": \"f\" };\nuse(d);",
+			[]int32{2322},
+		},
+		{
+			"a typeof switch covering every witness needs no default either",
+			"const d: string = switch (typeof mixed) { case \"string\": \"s\" case \"number\": \"n\" };\nuse(d);",
+			[]int32{},
+		},
+		{
+			"an open scrutinee keeps the undefined",
+			"declare const looseKey: string;\nconst d: string = switch (looseKey) { case \"a\": \"p\" case \"b\": \"f\" };\nuse(d);",
+			[]int32{2322},
+		},
+	}
+
+	for _, item := range data {
+		t.Run(item.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangSwitchPrelude+item.body), item.expected)
+		})
+	}
+}
