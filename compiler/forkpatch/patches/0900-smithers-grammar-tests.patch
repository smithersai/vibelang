+package checker_test
+
+import (
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/ast"
+	"github.com/microsoft/TypeScript/tsc/internal/bundled"
+	"github.com/microsoft/TypeScript/tsc/internal/checker"
+	"github.com/microsoft/TypeScript/tsc/internal/compiler"
+	"github.com/microsoft/TypeScript/tsc/internal/core"
+	"github.com/microsoft/TypeScript/tsc/internal/tsoptions"
+	"github.com/microsoft/TypeScript/tsc/internal/vfs/vfstest"
+	"gotest.tools/v3/assert"
+)
+
+// checkSourceElementWorker has no default arm and does not panic, so a node kind
+// without a checker case is silently NOT type-checked: its whole subtree
+// produces zero diagnostics. That failure mode is invisible in a round-trip or
+// emit test, so every Smithers construct that carries an expression is proved
+// here by requiring the SAME diagnostic the identical expression produces
+// outside the construct.
+//
+// The Smithers dialect is selected by file name. `.sm.ts` is the virtual file
+// name contentmapper.ParseResult produces for a `.sm` source, so it is both a
+// legal TypeScript extension for program construction and a Smithers file for
+// the parser. `.sm` itself stays a content-mapper extension and is deliberately
+// not registered as a builtin one.
+const smithersLangTestFile = "/main.sm.ts"
+
+const smithersLangTestConfig = `{ "compilerOptions": { "strict": true, "noEmit": true }, "files": ["main.sm.ts"] }`
+
+func smithersLangDiagnosticCodes(t *testing.T, content string) []int32 {
+	t.Helper()
+	return smithersLangDiagnosticCodesWithOptions(t, content, smithersLangTestConfig)
+}
+
+func smithersLangDiagnosticCodesWithOptions(t *testing.T, content string, config string) []int32 {
+	t.Helper()
+	fs := vfstest.FromMap(map[string]string{
+		smithersLangTestFile: content,
+		"/tsconfig.json": config,
+	}, false /*useCaseSensitiveFileNames*/)
+	fs = bundled.WrapFS(fs)
+
+	host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	assert.Equal(t, len(errors), 0, "unexpected command line errors")
+
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	file := program.GetSourceFile(smithersLangTestFile)
+	assert.Assert(t, file != nil, "source file missing from program")
+
+	syntactic := program.GetSyntacticDiagnostics(t.Context(), file)
+	assert.Equal(t, len(syntactic), 0, "unexpected syntactic diagnostics: %v", diagnosticCodes(syntactic))
+
+	return diagnosticCodes(program.GetSemanticDiagnostics(t.Context(), file))
+}
+
+func diagnosticCodes(diagnostics []*ast.Diagnostic) []int32 {
+	codes := make([]int32, 0, len(diagnostics))
+	for _, diagnostic := range diagnostics {
+		codes = append(codes, diagnostic.Code())
+	}
+	slices.Sort(codes)
+	return codes
+}
+
+const smithersLangCheckerPrelude = `declare function open(): { close(): void };
+declare function use(value: unknown): void;
+`
+
+// TestSmithersCheckerReportsErrorsInsideNewStatements is the checker-arm proof.
+// TS2339 (property does not exist) and TS2304 (cannot find name) must be
+// reported for expressions inside every new construct, exactly as they are for
+// the same expression written as a plain expression statement.
+func TestSmithersCheckerReportsErrorsInsideNewStatements(t *testing.T) {
+	t.Parallel()
+
+	const ts2339 = int32(2339)
+	const ts2304 = int32(2304)
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"control: plain expression statement",
+			"const h = open();\nh.nonExistentMethod();\ntotallyUndefinedIdentifier();",
+			[]int32{ts2304, ts2339},
+		},
+		{
+			"defer",
+			"const h = open();\ndefer h.nonExistentMethod();\ndefer totallyUndefinedIdentifier();",
+			[]int32{ts2304, ts2339},
+		},
+		{
+			"errdefer",
+			"const h = open();\nerrdefer h.nonExistentMethod();\nerrdefer totallyUndefinedIdentifier();",
+			[]int32{ts2304, ts2339},
+		},
+		{
+			"break value",
+			"const h = open();\nouter: {\n    break :outer h.nonExistentMethod();\n}\nouter2: {\n    break :outer2 totallyUndefinedIdentifier();\n}",
+			[]int32{ts2304, ts2339},
+		},
+		{
+			"conditional declaration",
+			"if (const a = open().nonExistentMethod(); a) {\n    use(a);\n}\nif (const b = totallyUndefinedIdentifier(); b) {\n    use(b);\n}",
+			[]int32{ts2304, ts2339},
+		},
+		{
+			"loop else value",
+			"const h = open();\nsearch: while (true) {\n    break :search 1;\n} else h.nonExistentMethod();\nsearch2: while (true) {\n    break :search2 1;\n} else totallyUndefinedIdentifier();",
+			[]int32{ts2304, ts2339},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			codes := smithersLangDiagnosticCodes(t, smithersLangCheckerPrelude+rec.body)
+			assert.DeepEqual(t, codes, rec.expected)
+		})
+	}
+}
+
+// TestSmithersCheckerAcceptsWellTypedStatements proves the checker arms do not
+// merely fire errors: correct code inside the new constructs is accepted, so the
+// arms are checking rather than rejecting.
+func TestSmithersCheckerAcceptsWellTypedStatements(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title string
+		body  string
+	}{
+		{"defer", "const h = open();\ndefer h.close();"},
+		{"errdefer", "const h = open();\nerrdefer h.close();"},
+		{"both", "const h = open();\ndefer h.close();\nerrdefer h.close();"},
+		{"break value", "const h = open();\nouter: {\n    break :outer use(h.close());\n}"},
+		{"break value in loop", "outer: while (true) {\n    break :outer use(1);\n}"},
+		{"conditional declaration", "if (const h = open(); h) {\n    h.close();\n}"},
+		{"conditional declaration with else", "if (const h = open(); h) {\n    h.close();\n} else {\n    use(h);\n}"},
+		{"loop else value", "search: while (true) {\n    break :search use(1);\n} else use(2);"},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			codes := smithersLangDiagnosticCodes(t, smithersLangCheckerPrelude+rec.body)
+			assert.DeepEqual(t, codes, []int32{})
+		})
+	}
+}
+
+// TestSmithersBreakValueFlowAnalysis proves the value expression is bound while
+// the flow into the break statement is still reachable. bindBreakStatement
+// replaces currentFlow with unreachableFlow, so binding the value afterwards
+// would attach an unreachable flow node to a reachable expression and narrowing
+// inside the value would be computed against the wrong antecedent.
+func TestSmithersBreakValueFlowAnalysis(t *testing.T) {
+	t.Parallel()
+
+	// `x` is narrowed to string on the path that reaches the break, so passing it
+	// to a string parameter must be accepted.
+	codes := smithersLangDiagnosticCodes(t, `declare function takesString(value: string): void;
+declare const x: string | number;
+outer: {
+    if (typeof x === "string") {
+        break :outer takesString(x);
+    }
+}
+`)
+	assert.DeepEqual(t, codes, []int32{})
+
+	// ...and the same value must still be reported when the narrowing does not
+	// hold, which proves the expression is genuinely flow-analyzed rather than
+	// skipped.
+	codes = smithersLangDiagnosticCodes(t, `declare function takesString(value: string): void;
+declare const x: string | number;
+outer: {
+    break :outer takesString(x);
+}
+`)
+	assert.DeepEqual(t, codes, []int32{2345})
+}
+
+// TestSmithersConditionalDeclarationScope proves the scoping decision the
+// reference calls provisional, as real grammar rather than as a text rewrite:
+// the binding IS visible in every `else`/`else if` branch, matching Go's
+// `if v := f(); cond { } else { }`, and it is NOT visible after the construct.
+//
+// It also proves the scope is a real flow-analyzed one rather than only a
+// symbol-table one: the binding is narrowed in the then branch and narrowed the
+// other way in the else branch.
+func TestSmithersConditionalDeclarationScope(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function get(): { name: string } | null;
+declare function takes(value: { name: string }): void;
+declare function use(value: unknown): void;
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"narrowed in the then branch",
+			"if (const u = get(); u !== null) {\n    takes(u);\n}",
+			[]int32{},
+		},
+		{
+			"visible in the else branch",
+			"if (const u = get(); u !== null) {\n    takes(u);\n} else {\n    use(u);\n}",
+			[]int32{},
+		},
+		{
+			"narrowed the other way in the else branch",
+			"if (const u = get(); u !== null) {\n    use(u);\n} else {\n    const n: null = u;\n    use(n);\n}",
+			[]int32{},
+		},
+		{
+			"the else branch does not get the then narrowing",
+			"if (const u = get(); u !== null) {\n    use(u);\n} else {\n    takes(u);\n}",
+			[]int32{2345},
+		},
+		{
+			"not visible after the construct",
+			"if (const u = get(); u !== null) {\n    takes(u);\n}\nuse(u);",
+			[]int32{2304},
+		},
+		{
+			"else-if chains compose and the outer binding stays visible",
+			"if (const a = get(); a !== null) {\n    takes(a);\n} else if (const b = get(); b !== null) {\n    takes(b);\n    use(a);\n}",
+			[]int32{},
+		},
+		{
+			"the binding shadows an outer name only inside the construct",
+			"const u = 1;\nif (const u = get(); u !== null) {\n    takes(u);\n}\nuse(u.toFixed(2));",
+			[]int32{},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
+
+// TestSmithersConditionalDeclarationLocals proves the IfStatement genuinely owns
+// a locals table rather than leaking its binding into the enclosing block: with
+// noUnusedLocals the unused conditional binding is reported against the `if`
+// itself, which only happens when GetContainerFlags made it a block-scoped
+// container AND checkIfStatement registered it for the unused-identifier pass.
+func TestSmithersConditionalDeclarationLocals(t *testing.T) {
+	t.Parallel()
+
+	codes := smithersLangDiagnosticCodesWithOptions(t,
+		`declare function get(): number;
+if (const unusedBinding = get(); get()) {
+    get();
+}
+`,
+		`{ "compilerOptions": { "strict": true, "noEmit": true, "noUnusedLocals": true }, "files": ["main.sm.ts"] }`)
+	assert.DeepEqual(t, codes, []int32{6133})
+
+	// ...and a used one is not reported, so the arm reports rather than merely fires.
+	codes = smithersLangDiagnosticCodesWithOptions(t,
+		`declare function get(): number;
+if (const usedBinding = get(); usedBinding > 1) {
+    get();
+}
+`,
+		`{ "compilerOptions": { "strict": true, "noEmit": true, "noUnusedLocals": true }, "files": ["main.sm.ts"] }`)
+	assert.DeepEqual(t, codes, []int32{})
+}
+
+// TestSmithersLoopElseFlowGraph proves the loop `else` completion value is a real
+// extra edge in the flow graph rather than an expression parked at the end of a
+// labeled statement.
+//
+// The reference semantics: normal loop completion, `continue` off the end, an
+// unlabeled `break`, and a plain `break label` all flow INTO the else value;
+// `break :label value` carries its own value and SKIPS it. Each direction is
+// observed through narrowing, so a wrong edge changes the reported diagnostics.
+func TestSmithersLoopElseFlowGraph(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function takesString(value: string): void;
+declare function cond(): boolean;
+declare function use(value: unknown): void;
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			// The only path that assigns a number is the one that value-breaks, and
+			// that path must not reach the else value, so `v` is still string there.
+			// If a value break flowed into the else, this would be TS2345.
+			"a value break skips the else value",
+			"let v: string | number = \"a\";\nsearch: while (cond()) {\n    v = 1;\n    break :search 0;\n} else takesString(v);",
+			[]int32{},
+		},
+		{
+			// The mirror image: a plain labeled break must flow INTO the else value,
+			// so the number assignment reaches it. If the edge were missing this
+			// would silently be accepted.
+			"a plain labeled break flows into the else value",
+			"let v: string | number = \"a\";\nsearch: while (cond()) {\n    v = 1;\n    break search;\n} else takesString(v);",
+			[]int32{2345},
+		},
+		{
+			"an unlabeled break flows into the else value",
+			"let v: string | number = \"a\";\nsearch: while (cond()) {\n    v = 1;\n    break;\n} else takesString(v);",
+			[]int32{2345},
+		},
+		{
+			"normal loop completion flows into the else value",
+			"let v: string | number = \"a\";\nsearch: while (cond()) {\n    v = 1;\n    continue;\n} else takesString(v);",
+			[]int32{2345},
+		},
+		{
+			// The loop's own block-scoped bindings end with the loop, not with the
+			// construct, so the else value cannot see them.
+			"the else value cannot see the loop's own bindings",
+			"search: for (const item of [1]) {\n    break :search item;\n} else use(item);",
+			[]int32{2304},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
+
+// TestSmithersConditionalDeclarationIsChecked is the checker-arm proof for the
+// conditional declaration, and it is deliberately NOT written the obvious way.
+//
+// The obvious test — an undefined identifier inside the declaration, referenced
+// in the branch — passes even with checkIfStatement's initializer arm deleted,
+// because referencing the binding resolves its symbol's type lazily and that
+// resolution reports the error anyway. Lazy type resolution MASKS the missing
+// arm, so the usual "same diagnostic as outside the construct" proof is not
+// enough here.
+//
+// These three cases are only reachable from the check pass itself:
+//
+//   - an unreferenced binding: nothing ever asks for its type;
+//   - assignability of an initializer against its own annotation, which lives in
+//     checkVariableDeclaration and not in type resolution;
+//   - the TS1155 grammar error for an uninitialized `const`.
+//
+// With the arm removed all three drop to zero, which is exactly the silent
+// unchecked-subtree failure mode.
+func TestSmithersConditionalDeclarationIsChecked(t *testing.T) {
+	t.Parallel()
+
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"an unreferenced conditional binding is still checked",
+			"if (const ignored = totallyUndefinedIdentifier(); true) {\n    use(1);\n}",
+			[]int32{2304},
+		},
+		{
+			"the initializer is checked against its own annotation",
+			"if (const n: string = 42; n) {\n    use(n);\n}",
+			[]int32{2322},
+		},
+		{
+			"grammar errors on the declaration are reported",
+			"if (const n; true) {\n    use(n);\n}",
+			[]int32{1155, 7005},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, smithersLangCheckerPrelude+rec.body), rec.expected)
+		})
+	}
+}
+
+// TestSmithersValueExpressionTypes proves the value-position `if`/`switch` are
+// typed rather than merely parsed: the type is the join of the branch values,
+// narrowing flows into each branch, errors inside a branch are reported, and the
+// missing-value-branch rule is enforced through the type system instead of a new
+// diagnostic.
+func TestSmithersValueExpressionTypes(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function use(value: unknown): void;
+declare function takesNumber(value: number): void;
+declare function takesString(value: string): void;
+declare function cond(): boolean;
+type Grade = "pass" | "fail" | "retry";
+declare const grade: Grade;
+declare const anyKey: string;
+declare const n: string | number;
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"the value if joins its branches",
+			"const x = if (cond()) { 10 } else { 0 };\ntakesNumber(x);",
+			[]int32{},
+		},
+		{
+			"a mixed join is a union, not the first branch",
+			"const x = if (cond()) { 10 } else { \"a\" };\ntakesNumber(x);",
+			[]int32{2345},
+		},
+		{
+			"the condition narrows into each branch",
+			"const x = if (typeof n === \"string\") { n.length } else { n };\ntakesNumber(x);",
+			[]int32{},
+		},
+		{
+			"errors inside a branch are reported",
+			"const x = if (cond()) { totallyUndefinedIdentifier() } else { 0 };\nuse(x);",
+			[]int32{2304},
+		},
+		{
+			"an else-if chain joins every branch",
+			"const x = if (cond()) { 1 } else if (cond()) { 2 } else { 3 };\ntakesNumber(x);",
+			[]int32{},
+		},
+		{
+			"a value if in argument position is typed",
+			"takesNumber(if (cond()) { 1 } else { 2 });",
+			[]int32{},
+		},
+		{
+			"a value switch joins its clause values",
+			"const s = switch (grade) {\n    case \"pass\": \"met\"\n    default: \"other\"\n};\ntakesString(s);",
+			[]int32{},
+		},
+		{
+			// SMITHERS1716: full literal coverage of a closed union removes the
+			// default-clause requirement.
+			"a proven-exhaustive value switch needs no default",
+			"const s = switch (grade) {\n    case \"pass\": \"met\"\n    case \"fail\": \"below\"\n    case \"retry\": \"resit\"\n};\ntakesString(s);",
+			[]int32{},
+		},
+		{
+			// ...and a missing member keeps it: the type carries `undefined`, so the
+			// ordinary strict assignability rules report the gap without a new
+			// diagnostic being invented for it.
+			"a value switch missing a union member is not exhaustive",
+			"const s = switch (grade) {\n    case \"pass\": \"met\"\n    case \"fail\": \"below\"\n};\ntakesString(s);",
+			[]int32{2345},
+		},
+		{
+			"a value switch over an open scrutinee type keeps the default requirement",
+			"const s = switch (anyKey) {\n    case \"a\": 1\n    case \"b\": 2\n};\ntakesNumber(s);",
+			[]int32{2345},
+		},
+		{
+			"a case label that cannot match the scrutinee is reported",
+			"const s = switch (grade) {\n    case 42: \"met\"\n    default: \"other\"\n};\ntakesString(s);",
+			[]int32{2678},
+		},
+		{
+			"errors inside a clause value are reported",
+			"const s = switch (grade) {\n    case \"pass\": totallyUndefinedIdentifier()\n    default: \"other\"\n};\nuse(s);",
+			[]int32{2304},
+		},
+		{
+			"a duplicated default clause is reported",
+			"const s = switch (grade) {\n    default: \"a\"\n    default: \"b\"\n};\nuse(s);",
+			[]int32{1113},
+		},
+		{
+			// The statement forms and their narrowing must be exactly what upstream
+			// produces today.
+			"the statement switch and its discriminant narrowing are unaffected",
+			"declare const u: string | number;\nswitch (typeof u) {\n    case \"string\":\n        takesString(u);\n        break;\n    default:\n        use(u);\n}",
+			[]int32{},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
+
+// TestSmithersLabeledValueTypes proves the expression-position labeled block and
+// loop values are typed rather than merely parsed. The value comes from the
+// `break :label value` exits that target the label, plus the loop `else`
+// completion value; the reference's "every reachable exit must carry a value"
+// rule (SMITHERS1714) is enforced through the type system rather than as a new
+// diagnostic, exactly as the missing-default rule is for a value switch.
+func TestSmithersLabeledValueTypes(t *testing.T) {
+	t.Parallel()
+
+	const prelude = `declare function use(value: unknown): void;
+declare function takesNumber(value: number): void;
+declare function takesString(value: string): void;
+declare function cond(): boolean;
+declare const scores: number[];
+declare const mixed: (string | number)[];
+declare const table: Record<string, number>;
+`
+	data := []struct {
+		title    string
+		body     string
+		expected []int32
+	}{
+		{
+			"a labeled block value is its single break value",
+			"const k = verdict: {\n    break :verdict \"short\";\n};\ntakesString(k);",
+			[]int32{},
+		},
+		{
+			"every value break joins into the type",
+			"const k = verdict: {\n    if (cond()) break :verdict \"a\";\n    break :verdict \"b\";\n};\ntakesString(k);",
+			[]int32{},
+		},
+		{
+			"a mixed join is a union, not the first exit",
+			"const k = verdict: {\n    if (cond()) break :verdict \"a\";\n    break :verdict 1;\n};\ntakesString(k);",
+			[]int32{2345},
+		},
+		{
+			// SMITHERS1714: a block that can finish without reaching a value break has
+			// no value on that path, so the type carries `undefined` and ordinary
+			// strict assignability reports it.
+			"a block that may complete normally is not exhaustive",
+			"const k = verdict: {\n    if (cond()) break :verdict \"a\";\n};\ntakesString(k);",
+			[]int32{2345},
+		},
+		{
+			"a block with no value break at all has no value",
+			"const k = verdict: {\n    use(1);\n};\ntakesString(k);",
+			[]int32{2345},
+		},
+		{
+			"narrowing flows into a value break",
+			"const k = verdict: {\n    for (const m of mixed) {\n        if (typeof m === \"string\") break :verdict m;\n    }\n    break :verdict \"\";\n};\ntakesString(k);",
+			[]int32{},
+		},
+		{
+			"a labeled loop value joins its breaks with the else completion",
+			"const f = search: for (const s of scores) {\n    if (s >= 60) break :search s;\n} else -1;\ntakesNumber(f);",
+			[]int32{},
+		},
+		{
+			"the else completion value is part of the type",
+			"const f = search: for (const s of scores) {\n    break :search s;\n} else \"none\";\ntakesNumber(f);",
+			[]int32{2345},
+		},
+		{
+			"a loop value narrows into its value break",
+			"const f = search: for (const m of mixed) {\n    if (typeof m === \"string\") break :search m;\n} else \"\";\ntakesString(f);",
+			[]int32{},
+		},
+		{
+			"an unnarrowed loop value keeps the wider type",
+			"const f = search: for (const m of mixed) {\n    break :search m;\n} else \"\";\ntakesString(f);",
+			[]int32{2345},
+		},
+		{
+			"the while form works",
+			"const f = search: while (cond()) {\n    break :search 1;\n} else 0;\ntakesNumber(f);",
+			[]int32{},
+		},
+		{
+			"the for-in form works",
+			"const f = search: for (const key in table) {\n    break :search key;\n} else \"\";\ntakesString(f);",
+			[]int32{},
+		},
+		{
+			"the do-while form works",
+			"const f = search: do {\n    break :search 1;\n} while (cond()) else 0;\ntakesNumber(f);",
+			[]int32{},
+		},
+		{
+			"a labeled value in argument position is typed",
+			"takesNumber(verdict: {\n    break :verdict 1;\n});",
+			[]int32{},
+		},
+		{
+			"...and reports a mismatch there",
+			"takesNumber(verdict: {\n    break :verdict \"a\";\n});",
+			[]int32{2345},
+		},
+		{
+			"a labeled value in return position is typed",
+			"function f(): number {\n    return search: for (const s of scores) {\n        break :search s;\n    } else -1;\n}\nuse(f);",
+			[]int32{},
+		},
+		{
+			"a labeled value as a property value is typed",
+			"const o: { k: number } = { k: verdict: {\n    break :verdict 1;\n} };\nuse(o);",
+			[]int32{},
+		},
+		{
+			"nested labeled values each take their own exits",
+			"const k = outer: {\n    const i = inner: {\n        break :inner 1;\n    };\n    break :outer i;\n};\ntakesNumber(k);",
+			[]int32{},
+		},
+		{
+			// A value break inside another value construct still targets this
+			// label, which is why the traversal cannot use a statement-kind
+			// allowlist: that block hangs off an expression.
+			"a value break from inside a nested construct still joins",
+			"const k = outer: {\n    const i = inner: {\n        break :outer \"cross\";\n    };\n    break :outer 1;\n};\ntakesNumber(k);",
+			[]int32{2345},
+		},
+		{
+			"the else value cannot see the loop's own bindings",
+			"const f = search: for (const s of scores) {\n    break :search s;\n} else s;\nuse(f);",
+			[]int32{2304},
+		},
+		{
+			"the statement forms are unaffected",
+			"outer: {\n    use(1);\n}\nsearch: while (cond()) {\n    break :search 1;\n} else 0;",
+			[]int32{},
+		},
+	}
+
+	for _, rec := range data {
+		t.Run(rec.title, func(t *testing.T) {
+			t.Parallel()
+			assert.DeepEqual(t, smithersLangDiagnosticCodes(t, prelude+rec.body), rec.expected)
+		})
+	}
+}
