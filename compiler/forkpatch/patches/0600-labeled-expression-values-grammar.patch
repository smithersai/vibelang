+// ForEachValueBreakStatement visits every `break :name value` inside body that
+// targets the label `name` — the exits a Smithers expression-position labeled
+// value takes its type from.
+//
+// Traversal stops exactly where the binder's own label resolution stops, so the
+// set it reports is the set that actually reaches the label: a `break` cannot
+// cross a function or class-static-block boundary, and a nested label of the
+// same name captures the breaks below it. It deliberately walks every child
+// rather than an allowlist of statement kinds the way ForEachReturnStatement
+// does, because a value break can sit inside another value construct's block and
+// that block hangs off an expression.
+//
+// Warning: this has the same semantics as the forEach family in that traversal
+// terminates when visitor returns true.
+func ForEachValueBreakStatement(body *Node, name string, visitor func(stmt *Node) bool) bool {
+	var traverse func(*Node) bool
+	traverse = func(node *Node) bool {
+		switch {
+		case IsFunctionLikeOrClassStaticBlockDeclaration(node):
+			return false
+		case node.Kind == KindBreakStatement:
+			breakStatement := node.AsBreakStatement()
+			if breakStatement.Value != nil && breakStatement.Label != nil && breakStatement.Label.Text() == name {
+				return visitor(node)
+			}
+			return false
+		case node.Kind == KindLabeledStatement && node.AsLabeledStatement().Label.Text() == name:
+			return false
+		}
+		return node.ForEachChild(traverse)
+	}
+	return body.ForEachChild(traverse)
