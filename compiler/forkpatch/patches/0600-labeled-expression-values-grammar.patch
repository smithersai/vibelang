+// checkLabeledExpression types the Smithers expression-position labeled block
+// and labeled loop values. Its value comes from the `break :label value` exits
+// that target its own label, plus the loop `else` completion value when there is
+// one; the two exits are already separated in the flow graph, so this only has to
+// read them back.
+//
+// The body is a statement subtree hanging off an expression, so nothing in the
+// ordinary statement walk ever reaches it: without the checkSourceElement call
+// below the whole block is silently unchecked, and checkSourceElementWorker has
+// no default arm to say so.
+func (c *Checker) checkLabeledExpression(node *ast.Node, checkMode CheckMode) *Type {
+	expr := node.AsLabeledExpression()
+	labeled := expr.Statement.AsLabeledStatement()
+	c.checkSourceElement(expr.Statement)
+
+	var types []*Type
+	ast.ForEachValueBreakStatement(labeled.Statement, labeled.Label.Text(), func(breakStatement *ast.Node) bool {
+		t := c.checkExpressionEx(breakStatement.AsBreakStatement().Value, checkMode)
+		types = core.AppendIfUnique(types, t)
+		return false
+	})
+
+	switch {
+	case labeled.ElseValue != nil:
+		// Normal completion, `continue` off the end, an unlabeled `break` and a
+		// plain `break label` all flow into the else value, so it is the value of
+		// every exit a value break does not take.
+		types = core.AppendIfUnique(types, c.checkExpressionEx(labeled.ElseValue, checkMode))
+	case expr.CompletionFlowNode != nil && c.isReachableFlowNode(expr.CompletionFlowNode):
+		// A labeled block that can finish without reaching a value break has no
+		// value on that path. That is the fail-closed rule for a missing value
+		// exit expressed in the type system rather than as a new diagnostic: under
+		// strict, the resulting `T | undefined` is reported by the ordinary
+		// assignability rules wherever the expression is used.
+		types = core.AppendIfUnique(types, c.undefinedType)
+	}
+	if len(types) == 0 {
+		return c.undefinedType
+	}
+	return c.getUnionTypeEx(types, UnionReductionSubtype, nil, nil)
+}
