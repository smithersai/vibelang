diff --git a/tsc/internal/parser/parser.go b/tsc/internal/parser/parser.go
index 658c0744..59018f54 100644
--- a/tsc/internal/parser/parser.go
+++ b/tsc/internal/parser/parser.go
@@ -1354,9 +1354,25 @@ func (p *Parser) parseBreakStatement() *ast.Node {
 	pos := p.nodePos()
 	jsdoc := p.jsdocScannerInfo()
 	p.parseExpected(ast.KindBreakKeyword)
-	label := p.parseIdentifierUnlessAtSemicolon()
+	var label *ast.IdentifierNode
+	var value *ast.Expression
+	// Smithers: `break [no LineTerminator here] : Identifier [Expression] ;` — a
+	// labeled break that carries a value out of the labeled block or loop. `:`
+	// directly after `break` is unambiguously an error in TypeScript today, so
+	// the form is conflict-free. The colon is only consulted when a semicolon
+	// cannot be inserted, which keeps ECMAScript's no-LineTerminator rule for
+	// the label intact.
+	if p.contextFlags&ast.NodeFlagsSmithers != 0 && !p.canParseSemicolon() && p.token == ast.KindColonToken {
+		p.nextToken()
+		label = p.parseIdentifier()
+		if !p.canParseSemicolon() {
+			value = p.parseExpressionAllowIn()
+		}
+	} else {
+		label = p.parseIdentifierUnlessAtSemicolon()
+	}
 	p.parseSemicolon()
-	result := p.finishNode(p.factory.NewBreakStatement(label), pos)
+	result := p.finishNode(p.factory.NewBreakStatement(label, value), pos)
 	p.withJSDoc(result, jsdoc)
 	return result
 }
diff --git a/tsc/internal/printer/printer.go b/tsc/internal/printer/printer.go
index 3da9c340..a65f33b7 100644
--- a/tsc/internal/printer/printer.go
+++ b/tsc/internal/printer/printer.go
@@ -3596,8 +3596,18 @@ func (p *Printer) emitBreakStatement(node *ast.BreakStatement) {
 	p.emitToken(ast.KindBreakKeyword, node.Pos(), WriteKindKeyword, node.AsNode())
 	if node.Label != nil {
 		p.writeSpace()
+		// Smithers value breaks are written `break :label value`. The colon is
+		// part of the authored syntax and is only reproduced for value breaks,
+		// so plain `break label` round-trips unchanged.
+		if node.Value != nil {
+			p.writePunctuation(":")
+		}
 		p.emitLabelIdentifier(node.Label.AsIdentifier())
 	}
+	if node.Value != nil {
+		p.writeSpace()
+		p.emitExpressionNoASI(node.Value, ast.OperatorPrecedenceLowest)
+	}
 	p.writeTrailingSemicolon()
 	p.exitNode(node.AsNode(), state)
 }
