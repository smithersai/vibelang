 func (b *Binder) bindBreakStatement(node *ast.Node) {
+	// Smithers: a value break evaluates its operand before control leaves the
+	// labeled statement, so the value must be bound while the current flow is
+	// still reachable. bindBreakOrContinueStatement sets currentFlow to
+	// unreachableFlow, and binding the value after that would attach an
+	// unreachable flow node to a reachable expression.
+	if value := node.AsBreakStatement().Value; value != nil {
+		b.bind(value)
+	}
 	b.bindBreakOrContinueStatement(node.Label(), b.currentBreakTarget, (*ActiveLabel).BreakTarget)
 }
 
diff --git a/tsc/internal/checker/checker.go b/tsc/internal/checker/checker.go
index 9c990ccb..571d01dc 100644
--- a/tsc/internal/checker/checker.go
+++ b/tsc/internal/checker/checker.go
@@ -4091,6 +4091,15 @@ func (c *Checker) checkBreakOrContinueStatement(node *ast.Node) {
 	if !c.checkGrammarStatementInAmbientContext(node) {
 		c.checkGrammarBreakOrContinueStatement(node)
 	}
+	// Smithers: the operand of a value break must be checked, or the whole
+	// subtree is silently unchecked. checkSourceElementWorker has no default
+	// arm, so an unchecked expression produces no diagnostics at all rather
+	// than an error.
+	if node.Kind == ast.KindBreakStatement {
+		if value := node.AsBreakStatement().Value; value != nil {
+			c.checkExpression(value)
+		}
+	}
 }
 
