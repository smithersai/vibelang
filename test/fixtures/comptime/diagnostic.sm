import { comptime as staticValue } from "smithers:comptime"

const config = staticValue(
  {
    mode: "diagnostic",
    enabled: true,
  },
)

export class Boom extends Error {
  constructor(readonly mode: string) { super(mode) }
}

export function describe(mode: string) {
  if (mode === config.mode) throw new Boom(mode)
  return mode
}
