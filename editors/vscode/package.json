{
  "name": "vibelang",
  "displayName": "VibeLang",
  "description": "VibeLang language support: the vibelang language server, diagnostics with EK codes, hovers with inferred contracts, and syntax highlighting for .vibe and .vibex files.",
  "version": "0.0.11",
  "publisher": "vibelang",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "effect",
    "vibelang",
    "typescript"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs the workspace's vibelang binary, which a workspace you do not trust could replace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onLanguage:vibe",
    "workspaceContains:**/*.vibe",
    "onLanguage:vibex",
    "workspaceContains:**/*.vibex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vibe",
        "aliases": [
          "VibeLang",
          "vibelang"
        ],
        "extensions": [
          ".vibe"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vibelang.svg",
          "dark": "./icons/vibelang.svg"
        }
      },
      {
        "id": "vibex",
        "aliases": [
          "VibeLang JSX"
        ],
        "extensions": [
          ".vibex"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vibelang.svg",
          "dark": "./icons/vibelang.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "vibe",
        "scopeName": "source.vibe",
        "path": "./syntaxes/VibeLang.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "tokenTypes": {
          "meta.template.expression": "other",
          "meta.template.expression string": "string",
          "meta.template.expression comment": "comment",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        }
      },
      {
        "scopeName": "documentation.injection.vibe",
        "path": "./syntaxes/jsdoc.vibe.injection.tmLanguage.json",
        "injectTo": [
          "source.vibe"
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vibe",
        "scopes": {
          "property": [
            "variable.other.property.ts"
          ],
          "property.readonly": [
            "variable.other.constant.property.ts"
          ],
          "variable": [
            "variable.other.readwrite.ts"
          ],
          "variable.readonly": [
            "variable.other.constant.object.ts"
          ],
          "function": [
            "entity.name.function.ts"
          ],
          "namespace": [
            "entity.name.type.module.ts"
          ],
          "variable.defaultLibrary": [
            "support.variable.ts"
          ],
          "function.defaultLibrary": [
            "support.function.ts"
          ]
        }
      },
      {
        "language": "vibex",
        "scopes": {
          "property": [
            "variable.other.property.ts"
          ],
          "property.readonly": [
            "variable.other.constant.property.ts"
          ],
          "variable": [
            "variable.other.readwrite.ts"
          ],
          "variable.readonly": [
            "variable.other.constant.object.ts"
          ],
          "function": [
            "entity.name.function.ts"
          ],
          "namespace": [
            "entity.name.type.module.ts"
          ],
          "variable.defaultLibrary": [
            "support.variable.ts"
          ],
          "function.defaultLibrary": [
            "support.function.ts"
          ]
        }
      }
    ],
    "configuration": {
      "title": "VibeLang",
      "properties": {
        "vibelang.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `vibelang` binary that serves as the language server. A relative path is relative to the first workspace folder. When empty, the extension uses the nearest `node_modules/.bin/vibelang`, then `vibelang` on `PATH`."
        },
        "vibelang.server.typeScriptFiles": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Serve .ts and .js files too when the built-in TypeScript features are off: the built-in extension \"TypeScript and JavaScript Language Features\" is disabled, or, in Cursor, `typescript.experimental.useTsgo` is true.",
            "Always serve .ts and .js files too. VS Code's built-in TypeScript features then report the same files a second time unless they are off.",
            "Serve only .vibe and .vibex files."
          ],
          "default": "auto",
          "markdownDescription": "Whether the VibeLang language server also serves `.ts` and `.js` files. It always checks them as part of the program; this decides whether it reports their diagnostics, hovers, and completions in the editor."
        },
        "vibelang.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the VibeLang language server to the VibeLang output."
        }
      }
    },
    "commands": [
      {
        "command": "vibelang.restartServer",
        "title": "Restart Language Server",
        "category": "VibeLang"
      },
      {
        "command": "vibelang.showOutput",
        "title": "Show Language Server Output",
        "category": "VibeLang"
      },
      {
        "command": "vibelang.serveTypeScriptFiles",
        "title": "Serve TypeScript Files in This Workspace",
        "category": "VibeLang"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit -p . && node scripts/build.mjs",
    "package": "bun run build && vsce package --no-dependencies --allow-missing-repository --out vibelang.vsix && node --test test/*.test.mjs",
    "test": "node test/run.mjs",
    "test:grammar": "node --test scripts/vibelang-grammar.test.mjs",
    "test:unit": "bun test --coverage test/unit.test.ts",
    "derive-grammar": "node scripts/derive-grammar.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "shiki": "4.4.3",
    "typescript": "6.0.3"
  }
}
