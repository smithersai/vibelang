string("-- main.vibe --\n// expect: EK2110 EK2119 TS2322 TS2345\n// A resume that is not its clause's last step returns what the handle ends\n// with next: the try block's result, or what a clause returns when the block\n// performs an operation again before it ends (D97). Each function below\n// compiled before and failed or returned the wrong value when it ran.\n\ncontrol Steps {\n  first(): void!!\n  second(): void!!\n}\n\neffect function work() {\n  try Steps.first()\n  try Steps.second()\n  return 42\n}\n\n// TS2322: the second clause ends the statement with \"early\", which the first\n// clause's resume then returns.\nexport effect function early() {\n  try {\n    return try work()\n  } handle Steps.first() {\n    const n: number = try resume()\n    return n.toFixed(1)\n  } handle Steps.second() {\n    return \"early\"\n  }\n}\n\nfunction half(n: number) {\n  return n / 2\n}\n\n// TS2345: the same result, passed where a number is expected.\nexport effect function passed() {\n  try {\n    return try work()\n  } handle Steps.first() {\n    return half(try resume())\n  } handle Steps.second() {\n    return \"early\"\n  }\n}\n\ncontrol Once {\n  step(): void!!\n}\n\neffect function twice() {\n  try Once.step()\n  try Once.step()\n  return 42\n}\n\n// TS2322: the clause answers the second step first, and its string reaches\n// the resume that answers the first.\nexport effect function nested() {\n  try {\n    return try twice()\n  } handle Once.step() {\n    const n: number = try resume()\n    return n.toFixed(1)\n  }\n}\n\n// TS2322: a try block that ends without returning ends the statement with\n// undefined.\nexport effect function falls() {\n  try {\n    try twice()\n  } handle Once.step() {\n    const n: number = try resume()\n    try Console.log(n.toFixed(1))\n  }\n}\n\n// TS2322: a break out of the statement ends it with undefined too.\nexport effect function breaks() {\n  for (const round of [1, 2]) {\n    try {\n      try twice()\n      break\n    } handle Once.step() {\n      const n: number = try resume()\n      try Console.log(round, n.toFixed(1))\n    }\n  }\n}\n\nlet calls = 0\n\n// TS2322: a clause that ends without resuming ends the statement with\n// undefined, which the first step's resume then returns.\nexport effect function stops() {\n  try {\n    return try twice()\n  } handle Once.step() {\n    calls++\n    if (calls === 2) {\n      try Console.log(\"second step stops\")\n    } else {\n      const n: number = try resume()\n      return n + 1\n    }\n  }\n}\n\n// EK2110: handle types resume's result with the program's, number, but the\n// second clause can end the handle with \"early\" first.\nexport effect function expression() {\n  return try handle(effect { return try work() }, Steps, {\n    effect first(k) {\n      const n: number = try resume(k, undefined)\n      return n.toFixed(1)\n    },\n    effect second(k) {\n      return \"early\"\n    }\n  })\n}\n\n// EK2110: with onReturn, resume's result is typed never.\nexport effect function transformed() {\n  return try handle(effect { return try work() }, Steps, {\n    effect first(k) {\n      const n: number = try resume(k, undefined)\n      return n + 1\n    },\n    effect second(k) {\n      return try resume(k, undefined)\n    }\n  }, effect (n) => `${n}`)\n}\n\n// D351: the inferred answer type excludes this resume-dependent return.\n// This used to run in handle-resume-result with only an EK2119 warning.\nexport effect function unwritten() {\n  try {\n    return try work()\n  } handle Steps.first() {\n    return `${try resume()} first`\n  } handle Steps.second() {\n    try resume()\n  }\n}\n-- package.json --\n{\"private\":true,\"type\":\"module\",\"dependencies\":{\"effect\":\"4.1.1\",\"vibelang-runtime\":\"0.0.1\"}}\n-- tsconfig.json --\n{\n  \"compilerOptions\": {\n    \"target\": \"es2022\",\n    \"lib\": [\n      \"esnext\",\n      \"dom\"\n    ],\n    \"module\": \"nodenext\",\n    \"moduleResolution\": \"nodenext\",\n    \"strict\": true,\n    \"types\": [],\n    \"skipLibCheck\": true,\n    \"outDir\": \"out\",\n    \"declaration\": true\n  },\n  \"include\": [\n    \"*.vibe\"\n  ]\n}\n")
