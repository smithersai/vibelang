string("-- approval.vibe --\nexport abstract class Approval extends Control {\n  abstract approve(request: string): Effect<boolean, never, never>\n}\n-- helpers.ts --\n// TypeScript functions: one whose declared requirements hold the control\n// operation Approval, and a generic one whose requirements come from its\n// argument.\nimport { Effect } from \"effect\"\nimport type { Approval } from \"./approval.js\"\n\nexport declare function retryApproval(request: string): Effect.Effect<boolean, never, Approval>\n\nexport const twice = <A, E, R>(program: Effect.Effect<A, E, R>): Effect.Effect<[A, A], E, R> =>\n  Effect.zip(program, program)\n-- main.vibe --\n// expect: EK4202\n// A TypeScript function whose requirements include a control operation can\n// perform it on another fiber, where no handler on this fiber can reach it\n// (D20). A generic TypeScript function that only passes its argument's\n// requirements through is allowed.\nimport { Approval } from \"./approval.vibe\"\nimport { retryApproval, twice } from \"./helpers.ts\"\n\nexport effect function release() {\n  return try retryApproval(\"deploy\")\n}\n\nexport effect function allowed() {\n  return try twice(effect { return try Approval.approve(\"deploy\") })\n}\n-- package.json --\n{\"private\":true,\"type\":\"module\",\"dependencies\":{\"effect\":\"4.1.1\",\"vibelang-runtime\":\"0.0.1\"}}\n-- tsconfig.json --\n{\n  \"compilerOptions\": {\n    \"target\": \"es2022\",\n    \"lib\": [\"esnext\", \"dom\"],\n    \"module\": \"nodenext\",\n    \"moduleResolution\": \"nodenext\",\n    \"strict\": true,\n    \"types\": [],\n    \"skipLibCheck\": true,\n    \"rewriteRelativeImportExtensions\": true,\n    \"outDir\": \"out\"\n  },\n  \"include\": [\"*.vibe\", \"*.ts\"]\n}\n")
