// A project that sets EK4403 to "warning" (D34) gets a warning, and the read
// compiles as a trusted sync call: no EK4402 for crypto, no boundary needed.
import { Effect } from "effect"

effect function stamp() {
  try Effect.sleep("1 millis")
  return performance.now()
}

function uuid() {
  return crypto.randomUUID()
}

// expect-result: [true,36]
export effect function main() {
  return [try stamp() > 0, (uuid()).length]
}
