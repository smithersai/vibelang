// expect-result: {"a":"released v1","b":"declined","c":"stopped: full","d":["deploy v2","released v2","approval done"],"e":"cleanup then cancelled","f":"busy deploy v3","g":[1,3],"h":"hi/info,bye/default","i":"two controls","j":["acquire held","answer true","release held"]}
error ReviewBusy { request: string }

control Approval {
  approve(request: string): boolean!ReviewBusy
  note(text: string): void!!
}

control Log {
  write(message: string, level?: string): void!!
}

control Stop {
  stop(reason: string): never!!
}

function release(version: string) {
  if (!try Approval.approve(`deploy ${version}`)) return "declined"
  try Approval.note(`released ${version}`)
  return `released ${version}`
}

// A tail resume continues the try block, whose return returns from the
// function.
function autoApprove(version: string) {
  try {
    return try release(version)
  } handle Approval.approve(request) {
    try resume(true)
  } handle Approval.note(text) {
    try resume()
  }
}

function decline(version: string) {
  try {
    return try release(version)
  } handle Approval.approve(request) {
    try resume(request.endsWith("v9"))
  } handle Approval.note(text) {
    try resume()
  }
}

// A clause that returns without resuming returns from the function, and the
// try block stops.
function search(limit: number) {
  let total = 0
  try {
    for (let i = 0; ; i++) {
      total += i
      if (total > limit) try Stop.stop("full")
    }
  } handle Stop.stop(reason) {
    return `stopped: ${reason}`
  }
}

// After a resume, the clause goes on once the try block finishes, and the
// block's return then returns from the function.
function audit(version: string) {
  const events: Array<string> = []
  try {
    events.push(try release(version))
    return events
  } handle Approval.approve(request) {
    events.push(request)
    try resume(true)
    events.push("approval done")
  } handle Approval.note(text) {
    try resume()
  }
}

// abandon() runs the try block's cleanup; then the clause goes on, and the
// statement completes.
function cancel() {
  const steps: Array<string> = []
  try {
    try {
      try Approval.approve("deploy now")
      steps.push("deployed")
    } finally {
      steps.push("cleanup")
    }
  } handle Approval.approve(request) {
    try abandon()
    steps.push("cancelled")
  } handle Approval.note(text) {
    try resume()
  }
  return steps.join(" then ")
}

// resumeWith raises the operation's error at the call; catch clauses after
// the handle clauses see it.
function busy(version: string) {
  try {
    return try release(version)
  } handle Approval.approve(request) {
    try resumeWith(() => { throw new ReviewBusy({ request }) })
  } handle Approval.note(text) {
    try resume()
  } catch (e) {
    return `busy ${(e as { readonly request: string }).request}`
  }
}

// A continue in a clause continues the enclosing loop.
function skipEven(items: ReadonlyArray<number>) {
  const kept: Array<number> = []
  for (const item of items) {
    try {
      if (!try Approval.approve(`${item}`)) continue
      kept.push(item)
    } handle Approval.approve(request) {
      if (Number(request) % 2 === 0) continue
      try resume(true)
    } handle Approval.note(text) {
      try resume()
    }
  }
  return kept
}

// A parameter may have a default; an optional argument left out gets it.
function logs() {
  const lines: Array<string> = []
  try {
    try Log.write("hi", "info")
    try Log.write("bye")
  } handle Log.write(message, level = "default") {
    lines.push(`${message}/${level}`)
    try resume()
  }
  return lines.join(",")
}

// One statement can handle several controls.
function both() {
  try {
    try Log.write("x")
    return try Approval.approve("y") ? "two controls" : "no"
  } handle Log.write(message) {
    try resume()
  } handle Approval.approve(request) {
    try resume(true)
  } handle Approval.note(text) {
    try resume()
  }
}

function resource(name: string, events: Array<string>) {
  return try Effect.acquireRelease(
    () => {
      events.push(`acquire ${name}`)
      return name
    },
    () => {
      events.push(`release ${name}`)
    }
  )
}

// A resume inside a block with using releases the block's resources after
// the resumed try block finishes.
function scoped() {
  const events: Array<string> = []
  try {
    events.push(`answer ${try Approval.approve("scoped")}`)
    return events
  } handle Approval.approve(request) {
    if (request === "scoped") {
      using held = try resource("held", events)
      try resume(true)
    } else {
      try resume(false)
    }
  } handle Approval.note(text) {
    try resume()
  }
}

export function main() {
  return {
    a: try autoApprove("v1"),
    b: try decline("v1"),
    c: try search(10),
    d: try audit("v2"),
    e: try cancel(),
    f: try busy("v3"),
    g: try skipEven([1, 2, 3]),
    h: try logs(),
    i: try both(),
    j: try scoped()
  }
}
