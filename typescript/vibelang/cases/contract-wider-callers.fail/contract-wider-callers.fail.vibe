// expect: EK2002 EK2001
// A contract wider than the body binds its callers: the call below can fail
// with Gone and needs Needed, although longForm's body runs nothing.
error Gone {}

service Needed {
  id: string
}

effect function longForm(): number!Gone!Needed {
  return 1
}

// R = never, but the call needs Needed.
export effect function needsNothing(): number!Gone! {
  return try longForm()
}

// E = never, but the call can fail with Gone.
export effect function failsNever(): number!!Needed {
  return try longForm()
}
