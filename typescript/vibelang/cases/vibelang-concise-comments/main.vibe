// A concise arrow body that the lowering turns into a block keeps the
// comment after it outside the block, and the file keeps its last comment.
import { Effect } from "effect"

abstract class Settings {
  abstract readonly greeting: string
}

effect function findName(id: number) {
  return id === 1 ? try Effect.succeed("ada") : try Effect.succeed("grace")
}

export const greeting = effect () => (try Settings()).greeting
// Effect<string, never, Settings>

export const nameLength = effect () => (try findName(1)).length
// Effect<number, never, never>
