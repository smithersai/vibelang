
// 003-failures.md: infer Name is a per-channel annotation; inferred channels appear in emitted declarations
// rule: docs/design/src/003-failures.md#dd3bf3c87b734282
// 003-failures.md: written infer channels preserve A, E and R inference in bang and Effect annotations
// rule: docs/design/src/003-failures.md#96f21c3029bb6387
// A written contract is the function's whole computation: returns are checked
// against A, and E and R may be wider than the body needs, never narrower.
// The declaration file carries the contract as written. The partial
// annotations below once wrote channels as infer; that form is retired
// (VIP-3, amended 2026-11-02), and --fix wrote the types the bodies gave them,
// or removed the annotation that wrote every channel as infer.
import { Data } from "effect"

export class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}
export class Invalid extends Data.TaggedError("Invalid")<{ readonly raw: string }> {}

export interface User {
  id: string
  name: string
}

const users = new Map<string, User>([["42", { id: "42", name: "Ada" }]])

export effect function find(id: string): Effect<User, UserNotFound, never> {
  const user = users.get(id)
  if (user === undefined) throw new UserNotFound({ id })
  return user
}

// Wider than the body: Invalid can never happen here.
export effect function wide(id: string): Effect<string, UserNotFound | Invalid, never> {
  return (try find(id)).name
}

// A contract makes a function an Effect even when its body runs nothing.
export effect function answer(): Effect<number, never, never> {
  return 42
}

// The returned object literal is checked against A.
export effect function point(): Effect<{ x: number; kind: "point" }, never, never> {
  return { x: 1, kind: "point" }
}

// Annotations --fix wrote from infer E, infer R and infer A.
export effect function greeting(id: string): Effect<string, UserNotFound, never> {
  return `Hello, ${(try find(id)).name}`
}

export effect function safe(id: string): Effect<string, never, never> {
  { const $nativeTryCompletion = try Effect.catch(effect {
    return { kind: "return:" as const, value: (try find(id)).name };
  }, effect (e) => {
    return { kind: "return:" as const, value: `missing ${e.id}` };
  });
return $nativeTryCompletion.value;
}
}

export effect function named(id: string): Effect<{ id: string; name: string; }, UserNotFound, never> {
  return { id, name: (try find(id)).name }
}

export effect function everything(id: string) {
  return try find(id)
}

// A lambda with a plain return type.
export const twice = (n: number): number => n * 2

// expect-result: {"find":"Ada","wide":"Ada","answer":42,"point":"point","greeting":"Hello, Ada","safe":"missing 7","named":"Ada","everything":"42","twice":8}
export effect function main() {
  return {
    find: (try find("42")).name,
    wide: try wide("42"),
    answer: try answer(),
    point: (try point()).kind,
    greeting: try greeting("42"),
    safe: try safe("7"),
    named: (try named("42")).name,
    everything: (try everything("42")).id,
    twice: twice(4)
  }
}
