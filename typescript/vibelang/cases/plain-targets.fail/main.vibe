// expect:
// VIP-1/detail303: function values, object members and class instances retain
// native TypeScript assignability at declared callback destinations.
// A void return type can ignore an Effect result, and neither void nor
// unknown changes the function kind or runs its returned program.
import { runAll, register, resetAll } from "./helpers.ts"

effect function tick() {
  try Console.log("tick")
}
effect function logged(n: number) {
  try Console.log(n)
}
interface Resettable {
  reset(): void
}
class Counter {
  n = 5
  effect reset() {
    try Console.log("reset")
    this.n = 0
  }
}
const both: () => number | Effect<void> = tick

// Held aggregates.
export function held() {
  const fs = [tick, tick]
  runAll(fs)
  runAll([...fs])
}
export function handlers() {
  const handlers = { effect onSave(doc: string) { try Console.log(doc) } }
  register(handlers)
  register({ ...handlers })
}

// Interface members.
export function members() {
  const r: Resettable = new Counter()
  resetAll([new Counter()])
  const o = { effect run() { try Console.log("run") } }
  const p: { run(): void } = o
  return [r, p]
}

// Void callbacks and erased possible Effects.
export function callbacks() {
  const cb: (n: number) => void = logged
  const erased: () => unknown = tick
  const alsoErased: () => unknown = both
  return [cb, erased, alsoErased]
}
