// expect-result: [[3,102],[3,102],[3,102,3,4]]
// A source binding spelled like a compiler name (the retired $direct variant
// of a plain function), in any scope, keeps its own meaning, and a call of
// the function keeps calling the function. A plain function is plain
// JavaScript (VIP-1), so Effect.forEach gets it through an effect arrow.
import { inc, inc$direct } from "./lib.vibe"
import * as Lib from "./lib.vibe"

function add(n: number) { return n + 1 }

// A local spelled like add's variant: add(2) still calls add.
function shadow() {
  const add$direct = (n: number): number => n + 100
  return [add(2), add$direct(2)]
}

// A function of its own beside twice, in the same scope.
function twice(n: number) { return n + 1 }
function twice$direct(n: number): number { return n + 100 }

export effect function main() {
  return [shadow(), [twice(2), twice$direct(2)], [inc(2), inc$direct(2), Lib.inc(2), (try Effect.forEach([3], effect (n: number) => inc(n)))[0]]]
}
