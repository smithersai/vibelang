// expect-result: {"built":0,"some":7,"afterSome":1,"none":1,"afterNone":2,"exact":[7,1],"afterExact":3,"control":[7,1],"afterControl":5}
// VIP-1 flip acceptance case 1 (foldkit-65; spec ruling 2026-10-31 21:45Z).
// In a plain arrow, match picks a value eagerly and runs nothing (VIP-1:
// plain code returns the Effect unrun; VIP-2: effect { } is the Effect
// itself). pick behaves like Option.match(fallback, { onSome: (v) =>
// Effect.succeed(v), onNone: () => program }): the counter proves that
// neither arm runs until the caller runs the result.
let runs = 0
const counted: number!! = effect { runs += 1; return 1 }

// The source exactly as the acceptance case writes it.
export const pick = (program: number!!, fallback: Option.Option<number>): number!! => match (fallback) {
  when Option.Some(let value): effect { return value };
  when Option.None: program;
}

// The same, with a counter in the Some arm.
export const pickCounted = (program: number!!, fallback: Option.Option<number>): number!! => match (fallback) {
  when Option.Some(let value): effect { runs += 1; return value };
  when Option.None: program;
}

const control = (program: number!!, fallback: Option.Option<number>): number!! =>
  Option.match(fallback, { onSome: (v) => effect { runs += 1; return v }, onNone: () => program })

export effect function main() {
  const some = pickCounted(counted, Option.some(7))
  const none = pickCounted(counted, Option.none())
  const built = runs
  const a = try some
  const afterSome = runs
  const b = try none
  const afterNone = runs
  const exact = [try pick(counted, Option.some(7)), try pick(counted, Option.none())]
  const afterExact = runs
  const c = [try control(counted, Option.some(7)), try control(counted, Option.none())]
  return { built, some: a, afterSome, none: b, afterNone, exact, afterExact, control: c, afterControl: runs }
}
