import { Effect } from "effect"
export effect function main() {
 const observations: unknown[] = []
 for (const bad of [false, true]) {
  const events: string[] = []
  effect function id() { events.push("id"); if (bad) throw "no id"; return 7 }
  effect function worker(n: number) { events.push("worker"); throw "worker failed" }
  effect function handled(n: number) { return worker(n) catch () => {events.push("handler"); return 0} }
  const result = try Effect.exit(effect {
   const f = fork handled(try id())
   events.push("started")
   join f
   return "started"
  })
  observations.push({events, tag: result._tag, value: result._tag === "Success" ? result.value : result.cause.reasons.map(r => r._tag === "Fail" ? r.error : r._tag)})
 }
 return observations
}

