// D312: main needs FileSystem, which Effect's NodeServices.layer provides,
// and Process, which only the experimental bundle provides (D313), so the
// entry provides both, the experimental bundle inside Effect's.
import "vibelang/platform/node"
import { FileSystem } from "effect/FileSystem"
import { Process } from "vibelang-runtime/experimental/Process"

export function main() {
  try Console.log(`${try Process.pid()}: ${try FileSystem.readFileString("pid.txt")}`)
}
