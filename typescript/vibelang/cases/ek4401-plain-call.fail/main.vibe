// expect: EK0403 EK4401
// D5: a synchronous unknown TypeScript call inside effect code is EK0403; plain
// functions (VIP-1), plain callbacks (D263), boundaries, trust, and the top
// level (D51) allow it.
import { Effect } from "effect"
import { fetchName, formatName, parseHidden, shout, type User } from "./helpers.ts"

export effect function card(user: User) {
  return formatName(user)
}

export effect function later(id: string) {
  return fetchName(id)
}

export function cards(users: ReadonlyArray<User>) {
  return users.map((user) => formatName(user))
}

export effect function hidden(text: string) {
  return parseHidden(text)
}

// Allowed: a trusted contract, a boundary, and the module's top level.
export function loud(text: string) {
  return shout(text)
}

export effect function bounded(user: User) {
  return try Effect.try(() => formatName(user))
}

export const ada = formatName({ name: "Ada" })
