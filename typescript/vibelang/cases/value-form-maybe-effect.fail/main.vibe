// expect: EK4301
// A function whose return type may be an Effect, a union with an Effect
// member, does not satisfy a plain function type whose caller drops what it
// returns: the program would never run. map keeps the results as data, so it
// accepts it (VIP-1).
import { each } from "./helpers.ts"

effect function tick(n: number) {
  try Console.log(n)
}

// Accepted: the binding declares that it holds either form.
const both: (n: number) => number | Effect<void> = tick

export function mapped() {
  return [1, 2].map(both)
}

export function dropped() {
  [1, 2].forEach(both)
}

export function passed() {
  each([1, 2], both)
}

// Accepted: the destination takes either form too.
export function kept(): (n: number) => number | Effect<void> {
  return both
}
