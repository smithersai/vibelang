// expect-result: ["Sub","x","Sub","x","Sub","y"]
import { TaggedError, $errorSubclass, type $ErrorArgs } from "vibelang-runtime"
class Base extends TaggedError("Base" as string)<{ readonly _tag: string }> {}
class Sub extends $errorSubclass(Base, "Sub") {
    declare readonly _tag: "Sub"
    declare readonly who: string
  constructor(args: $ErrorArgs<typeof Base, Pick<Sub, "who">>) {
    super()
    this["who"] = args["who"]
  }
}
effect function fail(): never!Sub { throw new Sub({ who: "x" }) }
export effect function main() {
  const sub = new Sub({ who: "x" })
  const input = { who: "y", _tag: "spoof" }
  const extra = new Sub(input)
  try Console.log(sub._tag, sub.who)
  try { try fail() } catch (e) {
    try Console.log(e._tag, e.who)
    return [sub._tag, sub.who, e._tag, e.who, extra._tag, extra.who]
  }
}
