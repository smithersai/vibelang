import { Effect } from "effect"
service Needed { value(): number!! }
function work() { return try Effect.succeed(1) }
export function bad(): number!! { log("early"); return () => 1 }
export function tail(flag: boolean): number!! { if (flag) return () => 1; return work() }
export function service(): number!! { Needed(); return () => 1 }
