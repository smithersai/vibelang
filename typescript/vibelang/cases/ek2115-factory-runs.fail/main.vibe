// expect: EK2115 EK2115 EK2115
import { Effect } from "effect"
service Needed { value(): number!! }
effect function work() { return try Effect.succeed(1) }
export function bad(): number!! { log("early"); return effect { return 1 } }
export function tail(flag: boolean): number!! { if (flag) return effect { return 1 }; return work() }
export function service(): number!! { Needed(); return effect { return 1 } }
