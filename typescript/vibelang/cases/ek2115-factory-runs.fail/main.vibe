// expect: EK0501 EK4801
// A plain function that returns an Effect is plain JavaScript (VIP-1; D269's
// factories and EK2115 are retired): running an Effect in its body is
// written try, which there is EK0501, and the Effect it leaves unrun is EK4801.
// tail only returns Effects, which is fine.
import { Effect } from "effect"
service Needed { value(): number!! }
effect function work() { return try Effect.succeed(1) }
export function bad(): number!! { try log("early"); return effect { return 1 } }
export function tail(flag: boolean): number!! { if (flag) return effect { return 1 }; return work() }
export function service(): number!! { try Needed(); return effect { return 1 } }
