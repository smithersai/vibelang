// expect-result: {"name":"Ada","greeting":"hi Ada","approved":"released v1"}
// The older spellings still compile and run the same way, with warnings:
// service class and control class (D220, now EK2120) and the layer
// declaration (EK2121). Their quick fixes write the current spellings.
service class Names {
  name(): string!!
}

service class Greeter {
  greet(name: string): string!!
}

control class Approval {
  approve(request: string): boolean!!
}

layer NamesLive: Names {
  effect name() { return "Ada" }
}

layer GreeterLive: Greeter {
  const prefix = "hi"
  effect greet(name) { return `${prefix} ${name}` }
}

effect function release(version: string) {
  if (!try Approval.approve(`deploy ${version}`)) return "declined"
  return `released ${version}`
}

effect function approveAll(version: string) {
  try {
    return try release(version)
  } handle Approval.approve(_request) {
    try resume(true)
  }
}

effect function names() {
  provide NamesLive, GreeterLive {
    const name = try Names.name()
    return { name, greeting: try Greeter.greet(name) }
  }
}

export effect function main() {
  return { ...try names(), approved: try approveAll("v1") }
}
