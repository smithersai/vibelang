// expect-result: {"name":"Ada","greeting":"hi Ada","approved":"released v1"}
// Layer declarations were migrated with vibelang --fix; the result stays the same.
service class Names {
  name(): string!!
}

service class Greeter {
  greet(name: string): string!!
}

service Approval {
  approve(request: string): boolean!!
}

const NamesLive = Layer.succeed(Names, {
  effect name() { return "Ada" }
})

const GreeterLive = Layer.effect(Greeter, effect {
  const prefix = "hi"
  return {
    effect greet(name) { return `${prefix} ${name}` }
  }
})

effect function release(version: string) {
  if (!try (try Approval).approve(`deploy ${version}`)) return "declined"
  return `released ${version}`
}

effect function approveAll(version: string) {
  provide Approval = { effect approve(_request: string) { return true } } {
    return try release(version)
  }
}

effect function names() {
  provide NamesLive, GreeterLive {
    const name = try (try Names).name()
    return { name, greeting: try (try Greeter).greet(name) }
  }
}

export effect function main() {
  return { ...try names(), approved: try approveAll("v1") }
}
