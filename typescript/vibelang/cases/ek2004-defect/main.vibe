import * as $nativeTryEffect from "effect/Effect";
import { Effect, Exit } from "effect"

effect function defect() {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    try Effect.succeed(0)
    try Effect.die("bug")
    return { kind: "return:" as const, value: ("finished") };
  }, effect () => {
    return { kind: "return:" as const, value: ("caught") };
  });
return $nativeTryCompletion.value;
}
}

// expect-result: ["Die"]
export effect function main() {
  const result = try Effect.exit(effect { return try defect() })
  return Exit.isFailure(result) ? (result.cause.reasons as ReadonlyArray<(typeof result.cause.reasons)[number]>).map((reason) => reason._tag) : ["Success"]
}
