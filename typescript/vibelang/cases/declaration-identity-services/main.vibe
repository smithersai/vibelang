// A service declaration declares what the Effect TypeScript in
// typescript/main.ts declares, Effect's own Context.Service class, and a
// body's static readonly key keeps the original's key (D501), from foldkit
// and alchemy.
// foldkit: runtime/dispatch.
/** Effect service tag that provides message dispatching to the view layer. */
export service Dispatch {
  static readonly key = "@foldkit/Dispatch"
  dispatchAsync: (message: unknown) => void!!
  dispatchSync: (message: unknown) => void
}

// alchemy: Domain/Telemetry.
export service Correlation {
  static readonly key = "alchemy/Domain/Correlation"
  id: string
}

// alchemy: Domain/Model documents its Internals service fields. A member
// comment stays before its whole signature, never between the readonly
// the signature adds and the name.
export service Store {
  static readonly key = "alchemy/Domain/Store"
  /** The stored values. */
  items: ReadonlyArray<string>
  // A line comment.
  count: number
  /* A block comment. */
  cursor: number
  /** Reads the first value. */
  first: () => string!!
}
