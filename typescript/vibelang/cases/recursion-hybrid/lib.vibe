import { odd } from "./odd.vibe"

export default effect function down(n: number): number!! {
  return n === 0 ? 0 : try down(n - 1)
}
export effect function even(n: number): boolean!! {
  return n === 0 ? true : try odd(n - 1)
}
export function tree(n: number): number {
  if (n === 0) return 1
  if (n % 2 === 0) return tree(n - 1)
  return [n - 1].map(x => tree(x))[0]
}
export effect function guarded(n: number): Effect<number> {
  try {
    if (n === 0) return JSON.parse("7")
    return try guarded(n - 1)
  } catch (e) {
    return -1
  }
}
error Stop { value: number }
export effect function caught(n: number): Effect<number> {
  try {
    if (n === 0) throw new Stop({ value: 7 })
    return try caught(n - 1)
  } catch (e) {
    return 7
  }
}
export effect function typed(n: number): Effect<number, Stop> {
  if (n === 0) throw new Stop({ value: 9 })
  return try typed(n - 1)
}
export effect function catchTyped(n: number) {
  try { return try typed(n) } catch (e) { return e.value }
}
export effect function boom(n: number): Effect<number> {
  if (n === 0) return (null as any).x
  return try boom(n - 1)
}
let defaults = 0
function nextDefault(): number { defaults++; return 3 }
export effect function complex(n: number, { value } = { value: nextDefault() }, ...rest: number[]): Effect<number> {
  return n === 0 ? value + rest.length : try complex(n - 1, { value }, ...rest)
}
export function defaultCount(): number { return defaults }
export effect function args(n: number, ...rest: number[]): Effect<number> {
  if (n === 0) return arguments.length + rest.length
  return try args(n - 1, ...rest)
}
