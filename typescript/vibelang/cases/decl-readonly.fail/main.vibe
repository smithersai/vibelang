// expect: TS2540
// A member written readonly is readonly, as in TypeScript.
interface Point {
  readonly x: number
  y: number
}

export function move(point: Point) {
  point.x = point.x + 1
  return point
}

// So is an object type's member written readonly.
export function rename(user: { readonly name: string }) {
  user.name = "Ada"
  return user
}

// A schema's fields keep their readonly default: Schema.Struct's keys are readonly.
schema Draft { title: string }

export function edit(draft: Draft) {
  draft.title = "Ada"
  return draft
}
