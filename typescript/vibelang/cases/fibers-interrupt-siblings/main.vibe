error Bad

effect function joined(log: string[]) {
  const startedA = try Deferred.make<void>()
  const startedB = try Deferred.make<void>()
  const releasedB = try Deferred.make<void>()
  const a = fork effect {
    try Deferred.succeed(startedA, undefined)
    return try Effect.onExit(Effect.never, () => effect {
      log.push("A waits")
      try releasedB.await()
      log.push("A done")
    })
  }
  const b = fork effect {
    try Deferred.succeed(startedB, undefined)
    return try Effect.onExit(Effect.never, () => effect {
      log.push("B done")
      try Deferred.succeed(releasedB, undefined)
    })
  }
  try startedA.await()
  try startedB.await()
  const bad = fork effect { throw new Bad() }
  const canceled: void!! = Fiber.interruptAll([bad, a, b])
  try Effect.catch(Effect.onError(Effect.all([
    Effect.interruptible(Fiber.join(bad)), Effect.interruptible(Fiber.join(a)), Effect.interruptible(Fiber.join(b))
  ], { concurrency: "unbounded" }), () => canceled), effect (e) => {
    log.push("caught " + e._tag)
  })
}

effect function all(log: string[]) {
  const startedA = try Deferred.make<void>()
  const startedB = try Deferred.make<void>()
  const releasedB = try Deferred.make<void>()
  try Effect.catch(Effect.all([
    effect {
      try Deferred.succeed(startedA, undefined)
      return try Effect.onExit(Effect.never, () => effect {
        log.push("A waits"); try releasedB.await(); log.push("A done")
      })
    },
    effect {
      try Deferred.succeed(startedB, undefined)
      return try Effect.onExit(Effect.never, () => effect {
        log.push("B done"); try Deferred.succeed(releasedB, undefined)
      })
    },
    effect { try startedA.await(); try startedB.await(); throw new Bad() }
  ], { concurrency: "unbounded" }), effect (e) => {
    log.push("caught " + e._tag)
  })
}

effect function racePrograms(log: string[]) {
  const releasedB = try Deferred.make<void>()
  log.push(try.race [
    Effect.onExit(Effect.never, () => effect { log.push("A waits"); try releasedB.await(); log.push("A done") }),
    Effect.onExit(Effect.never, () => effect { log.push("B done"); try Deferred.succeed(releasedB, undefined) }),
    effect { return "winner" }
  ])
}

// expect-result: {"joined":["A waits","B done","A done","caught Bad"],"all":["A waits","B done","A done","caught Bad"],"racePrograms":["A waits","B done","A done","winner"]}
export effect function main() {
  const joinedLog: string[] = [], allLog: string[] = [], raceLog: string[] = []
  try joined(joinedLog)
  try all(allLog)
  try racePrograms(raceLog)
  return { joined: joinedLog, all: allLog, racePrograms: raceLog }
}
