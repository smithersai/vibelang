// docs/design/src/900-appendices.md#3db8393ccb5b21c4 — Chapter 900: cov900-plain-generators.
function* sequential() { yield 1; return 7 }
async function* asynchronous() { yield 2; return 8 }
export effect function main() {
 const a = try Effect.try(() => { const it = sequential(); return [it.next().value, it.next().value] })
 const b = try Effect.tryPromise(async () => { const it = asynchronous(); return [(await it.next()).value, (await it.next()).value] })
 return [a,b]
}
