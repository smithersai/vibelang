// TypeScript-authored Context.Service classes and Effect services use explicit
// lookup as .vibe services do (VIP-10). Run an Effect-valued member with try;
// actual key properties keep their native TypeScript meaning. Even plain
// implementation methods require their service lookup.
import { Effect, Layer } from "effect"
import { layer as PathLayer, Path } from "effect/Path"
import { UserRepo, UserRepoLive } from "./repo.ts"

export effect function describe(id: string) {
  const user = try (try UserRepo).byId(id)
  const everyone = try (try UserRepo).all
  return `${user.name} of ${everyone.length}`
}

export effect function piped() {
  return try (try UserRepo).pipe("label")
}

export effect function joined(a: string, b: string) {
  return (try Path).join(a, b)
}

// A lambda whose body only looks a service up is an Effect function too.
const underRoot = effect (part: string) => (try Path).join("root", part)

effect function everything() {
  return [try describe("2"), try piped(), try joined("a", "b"), try underRoot("c")]
}

// expect-result: ["Grace of 2","piped label","a/b","root/c"]
export effect function main() {
  return try Effect.provide(effect { return try everything() }, Layer.mergeAll(UserRepoLive, PathLayer))
}
