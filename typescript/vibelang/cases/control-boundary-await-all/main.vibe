// expect-result: {"all":[1,2],"keyed":{"first":3,"second":4},"held":[5,6]}
// await.all runs each element in its own fiber, so an element that handles
// its own control operations runs (chapter 9, "Handlers and concurrency"). A
// fiber already running is waited for, not started again.
control Ask { ask(): number!! }

effect function answered(n: number) {
  try {
    return try Ask.ask()
  } handle Ask.ask() {
    try resume(n)
  }
}

export effect function main() {
  const running = fork answered(5)
  return {
    all: await.all [answered(1), answered(2)],
    keyed: await.all { first: answered(3), second: answered(4) },
    held: await.all [join running, answered(6)]
  }
}
