// expect: EK3207 EK2002
// A list of layers provides what its required entries provide (D362): an
// array value may be empty, which is EK3207, and a rest entry may be absent,
// so they discharge nothing, while the entries of a tuple and of an array
// literal do.
service A { value: string }
service B { value: string }

const LA = Layer.succeed(A, { value: "a" })
const LB = Layer.succeed(B, { value: "b" })

export effect function empty(): string!! {
  const layers: Layer.Layer<A>[] = []
  provide layers {
    return (try A()).value
  }
}

export effect function rest(more: Layer.Layer<B>[]): string!! {
  provide [LA, ...more] {
    return (try A()).value + (try B()).value
  }
}

export effect function tuple(): string!! {
  const pair = [LA, LB] as const
  provide pair {
    return (try A()).value + (try B()).value
  }
}

export effect function literal(): string!! {
  provide [LA, LB] {
    return (try A()).value + (try B()).value
  }
}
