import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"results":["stepped","stepped","stepped"],"events":["step","after concise","step","after nested","step","after block","stop concise","stop nested","stop block"]}
// Concise, nested and block Effect helpers all run on their caller's fiber.
// Their children remain alive after each helper returns and stop when the
// parent fiber completes, including inside an explicitly scoped program.
const events: string[] = []

effect function ticker(name: string, started: Deferred.Deferred<void>) {
  { const $nativeTryCompletion = try $nativeTryEffect.onExit(effect {
    try Deferred.succeed(started, undefined)
    while (true) try sleep("1 millis")
  
;return { kind: "normal" } as const;
}, () => effect {
    events.push(`stop ${name}`)
  });

}
}

effect function step(started: Deferred.Deferred<void>) {
  try started.await()
  events.push("step")
  return "stepped"
}

const concise = effect (name: string, started: Deferred.Deferred<void>) => (fork ticker(name, started), try step(started))

effect function nested() {
  const started = try Deferred.make<void>()
  const inner = effect () => (fork ticker("nested", started), try step(started))
  return try inner()
}

effect function block(name: string) {
  const started = try Deferred.make<void>()
  fork ticker(name, started)
  return try step(started)
}

export effect function main() {
  return try Effect.scoped(effect {
    const started = try Deferred.make<void>()
    const a = try concise("concise", started)
    events.push("after concise")
    const b = try nested()
    events.push("after nested")
    const c = try block("block")
    events.push("after block")
    return { results: [a, b, c], events }
  })
}
