// expect: EK4802
// Each returned arm or operand that is an Effect value is what the caller
// gets, as a returned Effect value is: the call in the other arm runs, and
// this one is the success value. EK4802 is an error here (tsconfig.json).
interface Hooks {
  emit: (n: number) => void!never
  sleep: (n: number) => void!never
  cached: (n: number | undefined) => void!never
}

export const hooks: Hooks = {
  emit: effect (n) => {
    return n === 0 ? Effect.interrupt : try Console.log("emit", n)
  },
  sleep: effect (n) => n <= 2 ? try Console.log("sleep", n) : (Effect.never),
  cached: effect (n) => n ?? Effect.interrupt,
}

export effect function unannotated(n: number) {
  return n === 0 ? Effect.interrupt : n === 1 ? Effect.never : try Console.log("call", n)
}

// Both arms are programs: a factory, which runs the chosen one.
export const both = (n: number): void!! => n === 0 ? Effect.interrupt : Effect.void

// A called arm runs, as EK4802's quick fix writes it.
export const called = effect (n: number): void!! => n === 0 ? try Effect.interrupt() : try Console.log("emit", n)
