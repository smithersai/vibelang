
import * as $nativeTryEffect3 from "effect/Effect";

import * as $nativeTryEffect2 from "effect/Effect";
import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"describe":["user 1","no user missing","retry"],"partial":"missing","partialSlow":"Timeout","chain":["missing missing","other"],"cause":["user 1","failed"]}
error NotFound { id: string }
error Timeout

effect function find(id: string): string!(NotFound | Timeout)! {
  if (id === "missing") throw new NotFound({ id })
  if (id === "slow") throw new Timeout()
  return `user ${id}`
}

// A complete match over the caught failure needs no rethrow.
effect function describe(id: string): string!! {
  { const $nativeTryCompletion2 = try $nativeTryEffect2.catch(effect {
    return { kind: "return:" as const, value: try find(id) };
  }, effect (e) => {
    return { kind: "return:" as const, value: match (e) {
      when NotFound and { let id }: `no user ${id}`;
      when Timeout: "retry";
      default: match (void 0 as unknown) { when 0: (void 0 as never); };
    }
 };
  });
return $nativeTryCompletion2.value;
}
}

// Partial handling rethrows the rest with a throw expression.
effect function partial(id: string): string!Timeout! {
  { const $nativeTryCompletion3 = try $nativeTryEffect3.catch(effect {
    return { kind: "return:" as const, value: try find(id) };
  }, effect (e) => {
    return { kind: "return:" as const, value: match (e) {
      when NotFound: "missing";
      default: throw e;
    }
 };
  });
return $nativeTryCompletion3.value;
}
}

// An is chain narrows statement bodies.
effect function chain(id: string): string!! {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try find(id)) };
  }, effect (e) => {
    if (e is NotFound) {
      return { kind: "return:" as const, value: (`missing ${e.id}`) };
    }
    return { kind: "return:" as const, value: ("other") };
  });
return $nativeTryCompletion.value;
}
}

// A whole cause: match on the exit.
effect function outcome(id: string): string!! {
  return match (try exit(find(id))) {
    when Exit.Success(let value): value;
    when Exit.Failure(let cause): Cause.hasFails(cause) ? "failed" : "other";
  }
}

export effect function main() {
  let partialSlow = "none"
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    try partial("slow")
  
;return { kind: "normal" } as const;
}, effect (e) => {
    partialSlow = e._tag
  
;return { kind: "normal" } as const;
});

}
  return {
    describe: [try describe("1"), try describe("missing"), try describe("slow")],
    partial: try partial("missing"),
    partialSlow,
    chain: [try chain("missing"), try chain("slow")],
    cause: [try outcome("1"), try outcome("missing")]
  }
}

