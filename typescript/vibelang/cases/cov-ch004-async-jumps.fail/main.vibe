// Chapter 004, async-jumps: docs/design/src/004-match.md#9f27ae8885d90798
// Chapter 004, async-jumps: docs/design/src/004-match.md#d8ef0a53190a9e9b
export function arm() { return async match (true) { default: do { return 7 }; } }
export function subject() { return async match (do { return 7 }) { default: 0; } }
export function guard() { return async match (true) { when true and if (do { return true }): 1; default: 0; } }
export function outer() { while (true) { async match (true) { default: do { break }; }; } }

