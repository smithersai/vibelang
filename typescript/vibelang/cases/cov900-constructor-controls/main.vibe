// docs/design/src/900-appendices.md#43d9c9be2a00ae88 — Chapter 900: cov900-constructor-controls.
class Point { value = 1 }
const point = { constructor: Point }
const opaque: any = () => 1
export effect function main() { return [new point.constructor().value, typeof opaque.constructor] }
