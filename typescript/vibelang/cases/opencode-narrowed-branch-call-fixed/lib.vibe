// opencode cli auth/form.ts: a guard proves a property, and the call that reads
// it is the if's whole branch, unbraced or alone in a block on the guard's line.
// Effect.try's function does not know what the guard proved.
import { note, seen, size } from "./plain.ts"

type Field = { readonly description?: string }

export const unbraced = effect (field: Field) => {
  if (field.description) {
    const message = field.description
    try Effect.orDie(Effect.try({ try: () => note(message), catch: (error) => error }))
  }
  return seen.length
}

export const sameLine = effect (field: Field) => {
  if (field.description) { const message = field.description; try Effect.orDie(Effect.try({ try: () => note(message), catch: (error) => error })) }
  return seen.length
}

export const otherwise = effect (field: Field) => {
  if (!field.description) return 0
  else {
    const message = field.description
    try Effect.orDie(Effect.try({ try: () => note(message), catch: (error) => error }))
  }
  return seen.length
}

export const chained = effect (field: Field, n: number) => {
  if (n > 0) return n
  else if (field.description) {
    const message = field.description
    return try Effect.orDie(Effect.try({ try: () => size(message), catch: (error) => error }))
  }
  return 0
}
