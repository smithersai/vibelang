// expect: EK3101 EK3101 EK3101 EK3101 EK3101 EK2001 TS2345
// The object a Layer.effect program returns is typed by the service (D222), so
// each member's failures and call-time requirements must fit its contract, as
// in Layer.succeed (Chapter 4, "Requirements that would leak"). The block
// param used to widen the service's shape to the returned object instead:
// these layers compiled, and a member that looked a service up died with
// "Service not found".
error Oops { n: number }
service Clock2 { now(): number!! }
service Greeter { greet(name: string): string!! }
service Files { open(name: string): string!! }

effect function stamp(): number!!Clock2 { return try Clock2.now() }
effect function helper(name: string) { return `hi ${name} at ${try Clock2.now()}` }

export const Lookup = Layer.effect(Greeter) {
  return {
    effect greet(name) { return `hi ${name} at ${try Clock2.now()}` }
  }
}

export const ArrowHelper = Layer.effect(Greeter) { return { greet: effect (name) => `hi ${name} ${try stamp()}` } }

export const Variable = Layer.effect(Greeter) {
  const impl = { effect greet(name: string) { return try helper(name) } }
  return impl
}

export const VariableArrow = Layer.effect(Greeter, effect {
  const impl = { greet: effect (name: string) => try helper(name) }
  return impl
})

export const Acquires = Layer.effect(Files) {
  return {
    effect open(name) {
      return try Effect.acquireRelease(sync((name) => `handle:${name}`, name), effect (h) => try Console.log("closed", h))
    }
  }
}

export const Fails = Layer.effect(Greeter) {
  return { effect greet(name) { if (name === "") throw new Oops({ n: 0 }); return name } }
}

export const Missing = Layer.effect(Greeter) {
  return {}
}
