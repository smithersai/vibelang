// expect-result: ["left","right","left","right"]
error Failure { label: string }
effect function statement(cond: boolean) {
  throw cond ? new Failure({ label: "left" }) : new Failure({ label: "right" })
}
effect function expression(cond: boolean) {
  return statement(true) catch effect (_) => throw (cond ? new Failure({ label: "left" }) : new Failure({ label: "right" }))
}
export effect function main() {
  const a = statement(true) catch (e) => e.label
  const b = statement(false) catch (e) => e.label
  const c = expression(true) catch (e) => e.label
  const d = expression(false) catch (e) => e.label
  return [a, b, c, d]
}
