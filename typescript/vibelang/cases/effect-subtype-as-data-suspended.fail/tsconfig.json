{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out",
    "declaration": true,
    "vibelang": {
      "diagnostics": {
        "EK4802": "error"
      }
    }
  },
  "include": [
    "*.vibe",
    "*.ts"
  ]
}
