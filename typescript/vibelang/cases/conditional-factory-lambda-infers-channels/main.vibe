// A factory lambda in a branch of a conditional argument, `() => Effect.void`,
// keeps TypeScript's type as it does when it is the argument itself, so the
// callee's channels E2 and R2 infer from both branches rather than from
// themselves.
const run = effect <E2, R2>(record: (n: number) => void!E2!R2): void!E2!R2 => {
  try record(1)
  try record(2)
}

const watch = effect (seen: Array<number>, watching: boolean): void!! => {
  const observe = effect (n: number): void!! => {
    seen.push(n)
  }
  try run(watching ? observe : () => Effect.void)
}

// expect-result: [[1,2],[]]
export effect function main() {
  const watched: Array<number> = []
  const ignored: Array<number> = []
  try watch(watched, true)
  try watch(ignored, false)
  return [watched, ignored]
}
