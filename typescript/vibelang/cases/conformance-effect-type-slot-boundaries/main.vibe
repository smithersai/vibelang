// expect:
import type { Effect } from "effect"
export type RequiredObjects = number!{ reason: string }!{ service: number };
type Same<X, Y> = (<T>() => T extends X ? 1 : 2) extends (<T>() => T extends Y ? 1 : 2) ? true : false
type Check<T extends true> = T
type Proof = Check<Same<RequiredObjects, Effect.Effect<number, { reason: string }, { service: number }>>>
