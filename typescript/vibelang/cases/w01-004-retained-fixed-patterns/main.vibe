function errorRow(row: Row, other: string): readonly unknown[] {
  const subjects: unknown[] = [{ _tag: row.name, [row.brand]: row.brand }, { _tag: row.name }, { _tag: row.name, [other]: other }, null]
  const agrees = subjects.every((s) => {
    const [bare, bound, rest, zero] = row.check(s)
    const expected = row.guard(s)
    return bare === expected && bound === expected && rest === expected && zero === false
  })
  return [row.name, agrees && row.guard(subjects[0]) && !row.guard(subjects[1])]
}
function fixed(): readonly boolean[] {
  return [
    match (Option.some(1) as unknown) { when Option.Some(let v): v === 1; default: false; },
    match (Option.none() as unknown) { when Option.None: true; default: false; },
    match (Exit.succeed(2) as unknown) { when Exit.Success(let v): v === 2; default: false; },
    match (Exit.fail("x") as unknown) { when Exit.Failure(let c): Exit.isExit(Exit.failCause(c)); default: false; },
    match (Result.succeed(3) as unknown) { when Result.Success(let v): v === 3; default: false; },
    match (Result.fail("y") as unknown) { when Result.Failure(let e): e === "y"; default: false; },
  ]
}
function zero(): readonly boolean[] {
  const missing = new NotFound({ id: "1" })
  return [
    match (Option.none() as unknown) { when Option.None(): true; default: false; },
    match (Option.some(1) as unknown) { when Option.None(): true; default: false; },
    match (missing as unknown) { when NotFound(): true; default: false; },
    match (missing as unknown) { when NotFound(let e): e !== missing; default: true; },
  ]
}
export effect function main() {
  return { errors: rows.map((row, i) => errorRow(row, rows[(i + 1) % rows.length].brand)), fixed: fixed(), zero: zero() }
}
