// expect: TS2483 TS2483 TS2483 TS2483 TS2483 TS2483 TS2304 TS2322 TS1334 TS1333
// A rejected head annotation is checked but does not type the item.
export effect function identifier(xs: number[]) {
  for concurrent (const x: string of xs) { const n: number = x; void n }
}
export effect function pattern(rows: Array<{ n?: number }>) {
  for concurrent(1) (let { n = 1 }: { n?: string } of rows) { const value: number = n; void value }
}
export effect function missingType(xs: number[]) {
  for concurrent (const x: Missing of xs) { void x }
}
export effect function bodyError(xs: number[]) {
  for concurrent(2) (const x: number of xs) { const n: string = x; void n }
}

export effect function unique(xs: number[]) {
  for concurrent (const x: unique symbol of xs) { void x }
}

export effect function uniquePattern(xs: Array<{n: number}>) {
  for concurrent (const {n}: unique symbol of xs) { void n }
}
