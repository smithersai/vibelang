// expect: TS2348 TS2349
// An Effect is not a function: calling one is TypeScript's own error, in
// effect code and plain code alike. Only try runs an Effect (VIP-5), and a
// service is read with try Tag (VIP-10). Old VibeLang ran body() where it
// stood (D501, D24); vibelang --fix-vip-only rewrites it as try body.
service Tag {
  value: number
}

effect function direct(body: number!!) {
  return body()
}

function plain(body: number!!) {
  return body()
}

// The call was typed as the Effect but ran it, so this compiled and died
// with "Not a valid effect".
effect function operand(body: number!!, flag: boolean) {
  return try Effect.provideService(flag ? body() : Effect.succeed(2), Tag, { value: 1 })
}

effect function service() {
  return Tag().value
}
