// expect: TS2304 TS2322
// Conformance probes of written forms that fail (VIP-1).
import { takesPlain } from "./helpers.ts"

error TxError
const cached: number!! = effect { return 1 }

// An Effect function does not fit where a plain one must return a number.
export function annotatedAtPlain() {
  return takesPlain(effect (x): number!! => x + 1)
}

// A plain callback may return the program flatMap runs; an effect callback
// returns it as data, unrun (VIP-5).
export effect function nested() {
  return try Effect.flatMap(Effect.succeed(1), (v) => cached)
}

// A union of a plain and an Effect function is a TypeScript union: its call
// returns the member's result, a number or an unrun Effect (VIP-1).
effect function twice(n: number) {
  return n * 2
}
export function mixed(flag: boolean) {
  return (flag ? twice : Math.abs)(3)
}

// A callback's channels are type parameters: E and R are not declared here.
export effect function channels<A>(work: () => A): A!TxError | E!R {
  return work()
}
