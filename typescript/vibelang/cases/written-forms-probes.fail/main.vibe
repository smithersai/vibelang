// expect: EK4301 TS2304 TS2322
// Conformance probes of written forms that fail (D500, Chapter 30).
import { takesPlain } from "./helpers.ts"

error TxError
const cached: number!! = effect { return 1 }

// An Effect annotation makes an Effect function where only a plain one fits.
export function annotatedAtPlain() {
  return takesPlain(effect (x): number!! => x + 1)
}

// A literal at a destination that returns an Effect is an Effect function, so
// returning the program cached returns it unrun; write cached().
export effect function nested() {
  return try Effect.flatMap(Effect.succeed(1), effect (v) => cached)
}

// A union of a plain and an Effect function: its call would build the Effect
// member's program and never run it.
function twice(n: number) {
  return n * 2
}
export function mixed(flag: boolean) {
  return (flag ? twice : Math.abs)(3)
}

// A callback's channels are type parameters: E and R are not declared here.
export effect function channels<A>(work: () => A): A!TxError | E!R {
  return work()
}
