// Chapter 5. Programs as values: retry, timeout, and pipe.
// NOTE: durations are shortened from the proposal's (100 millis, 1 second) so the run is fast.
import { Clock, Schedule } from "effect"

class FetchError extends TaggedError("FetchError")<{ readonly attempt: number }> {}
class SyncError extends TaggedError("SyncError")<{ readonly store: string }> {}

interface User {
  id: string
  name: string
}

interface Store {
  name: string
}

interface SyncReport {
  store: string
  items: number
}

service Inventory {
  sync(store: Store): Effect<SyncReport, SyncError, never>
}

service Http {
  listen(port: number): Effect<string, never, never>
}

let fetchCalls = 0
let syncRuns = 0
let configLoads = 0

// Fails on the first two calls, then succeeds.
effect function fetchUser(id: string) {
  fetchCalls++
  if (fetchCalls < 3) throw new FetchError({ attempt: fetchCalls })
  const user: User = { id, name: "Ada" }
  return user
}

effect function fromCache(id: string) {
  try Effect.sleep("1 millis")
  return "cache"
}

effect function fromNetwork(id: string) {
  try Effect.sleep("50 millis")
  return "network"
}

effect function slowQuery(id: string) {
  try Effect.sleep("50 millis")
  return "slow"
}

effect function syncInventory(store: Store) {
  syncRuns++
  return try Inventory.sync(store)
}

// The one rule

effect function oneRule(store: Store) {
  try syncInventory(store)                    // runs now

  const job = effect () => try syncInventory(store)  // a program: nothing has run
  const before = syncRuns
  try job()                                   // runs it
  try job()                                   // runs it again, from scratch
  return { before, after: syncRuns }
}

effect function combinators(id: string) {
  const user = try Effect.retry(effect { return try fetchUser(id) }, Schedule.exponential("1 millis"))
  const fresh = try Effect.timeout(effect { return try fetchUser(id) }, "1 second")
  const fastest = try Effect.race(effect { return try fromCache(id) }, effect { return try fromNetwork(id) })
  let timedOut = "no"
  try {
    try Effect.timeout(effect { return try slowQuery(id) }, "5 millis")
  } catch (e) {
    timedOut = e._tag
  }
  return { user: user.name, fresh: fresh.name, fastest, timedOut }
}

// Pipe

effect function piped(id: string) {
  const user = do {
    const $pipe0: User!FetchError! = effect { return try fetchUser(id) }
    const $pipe1 = { times: 3 }
    const $pipe2 = Effect.withSpan("load-user")
    try $pipe2(effect { return try Effect.timeout(effect { return try Effect.retry($pipe0, $pipe1) }, "2 seconds") })
  }
  // user: User;  E gains TimeoutError from Effect.timeout
  return user.name
}

// Storing, returning, and composing programs

function makeSync(store: Store): () => Effect<SyncReport, SyncError, Inventory> {
  return effect () => try syncInventory(store)            // returns a program
}
// A plain function (D9): calling makeSync runs nothing.

// NOTE: stores.map(makeSync) passes the plain makeSync to Array.prototype.map (D9), so
// syncAll is an array of program functions; Effect.all must then convert each element to an Effect.
effect function syncEverything(stores: ReadonlyArray<Store>) {
  const syncAll = stores.map(makeSync)                    // an array of programs; nothing ran
  return try Effect.all(syncAll, { concurrency: 4 })          // now they run
}

function loadConfig() {
  configLoads++
  return { port: 8080 }
}

effect function startServer() {
  const cachedConfig = try Effect.cached(effect { return try loadConfig() })  // Effect.cached returns a program
  const config = try cachedConfig()                           // loads once
  const again = try cachedConfig()                            // returns the cached value
  return try Http.listen(config.port)
}

// An Effect value from TypeScript is a program: calling it runs it.
effect function clockKind() {
  const millis = try Clock.currentTimeMillis()
  return typeof millis
}

const stores: ReadonlyArray<Store> = [{ name: "north" }, { name: "south" }, { name: "east" }]

const InventoryTest = Layer.succeed(Inventory, {
  sync: effect (store) => ({ store: store.name, items: store.name.length })
})

const HttpTest = Layer.succeed(Http, {
  listen: effect (port) => `listening on ${port}`
})

effect function scenario() {
  const rule = try oneRule(stores[0])
  const combined = try combinators("42")
  const pipedName = try piped("42")
  const reports = try syncEverything(stores)
  const server = try startServer()
  const clock = try clockKind()
  return {
    rule,
    combined,
    piped: pipedName,
    reports: (reports as ReadonlyArray<(typeof reports)[number]>).map((report) => report.store),
    syncRuns,
    server,
    configLoads,
    clock,
    fetchCalls
  }
}

// expect-result: {"rule":{"before":1,"after":3},"combined":{"user":"Ada","fresh":"Ada","fastest":"cache","timedOut":"TimeoutError"},"piped":"Ada","reports":["north","south","east"],"syncRuns":6,"server":"listening on 8080","configLoads":1,"clock":"number","fetchCalls":5}
export effect function main() {
  return try Effect.provide(effect { return try scenario() }, Layer.mergeAll(InventoryTest, HttpTest))
}
