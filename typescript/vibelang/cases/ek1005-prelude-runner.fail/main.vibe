// expect: EK1005
// The prelude's runPromise leads back in from TypeScript, such as a hatch's
// body (D148). Called in code a fiber runs, it starts a second root: EK1005.
effect function later() {
  try Effect.sleep("1 millis")
  return "later"
}

export effect function main() {
  const fine = try sync(async (later) => runPromise(later()), later)
  runPromise(later())
  return fine
}
