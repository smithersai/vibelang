// A data type named Option is matched by tag like any data type; its
// variants are not effect's Option matchers, and a class pattern naming one
// is EK0702 (match-data-own-option-pattern.fail).
data Option {
  Some { value: number }
  None
}

function ownOption(x: Option) {
  return match (x) {
    when { _tag: "Some", let value }: value;
    when { _tag: "None" }: -1;
  }
}

function isNone(x: Option) {
  if (x is { _tag: "None" }) return "none"
  return "some"
}

// expect-result: [5,-1,"none","some"]
export effect function main() {
  return [ownOption(Option.Some({ value: 5 })), ownOption(Option.None()), isNone(Option.None()), isNone(Option.Some({ value: 1 }))]
}
