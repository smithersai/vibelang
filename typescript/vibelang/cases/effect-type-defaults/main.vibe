// expect-result: {"plain":3,"failing":"Gone","found":"Ada","guest":"guest","inferred":"Ada","onlyErrors":"x","partial":"Ada","count":2,"all":["Ada"],"ran":3}
// D308, D309: an Effect<...> contract, the spelling accepted beside the !
// form, means what the same type means in TypeScript. A type argument left
// out is never: Effect<A> cannot fail and needs nothing, and Effect<A, E>
// needs nothing, on a function with a body as everywhere.
// infer in a return annotation still takes a channel from the body (D57),
// and a service's members write Effect types with the same defaults.
// effect-type-defaults.fail holds the bodies these contracts reject.
error Gone { id: string }

service Users {
  find(id: string): Effect<string, Gone>
  count(): Effect<number>
  all(): Effect<ReadonlyArray<string>, never, never>
}

const UsersLive = Layer.succeed(Users, {
  effect find(id: string) {
    if (id !== "42") throw new Gone({ id })
    return "Ada"
  },
  effect count() {
    return 2
  },
  effect all() {
    return ["Ada"]
  }
})

export effect function plain(): Effect<number> {
  return 3
}

export effect function failing(id: string): Effect<string, Gone> {
  if (id === "") throw new Gone({ id })
  return id
}

export effect function found(id: string): Effect<string, Gone, Users> {
  return try Users.find(id)
}

export effect function guest(id: string): Effect<string, never, Users> {
  return Users.find(id) catch "guest"
}

export effect function inferred(id: string): Effect<string, Gone, infer R> {
  return try Users.find(id)
}

export effect function onlyErrors(id: string): Effect<string, infer E> {
  if (id === "") throw new Gone({ id })
  return id
}

export effect function partial(id: string): Effect<string, infer E, infer R> {
  return try Users.find(id)
}

export effect function run(program: Effect<number>): Effect<number> {
  return try program()
}

export effect function main() {
  provide UsersLive {
    return {
      plain: try plain(),
      failing: failing("") catch (e) => e._tag,
      found: try found("42"),
      guest: try guest("7"),
      inferred: try inferred("42"),
      onlyErrors: try onlyErrors("x"),
      partial: try partial("42"),
      count: try Users.count(),
      all: try Users.all(),
      ran: try run(plain())
    }
  }
}
