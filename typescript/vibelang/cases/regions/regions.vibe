error Boom { n: number }

const events: string[] = []

effect function risky(n: number) {
  if (n % 3 === 0) throw new Boom({ n })
  return n
}
// Cleanup runs once per iteration before the enclosing loop takes its jump.
effect function loop(stopAt: number) {
  let total = 0
  outer: for (let i = 1; i <= 10; i++) {
    for (let j = 0; j < 2; j++) {
      const next = try ensuring(effect {
        if (i === stopAt) return "stop" as const
        if (j === 1) return "outer" as const
        if (i % 2 === 0) return "inner" as const
        return risky(i) catch effect (e) => {
          events.push(`caught ${e.n}`)
          return e.n === 9 ? "return" as const : 0
        }
      }, effect { events.push(`finally ${i}.${j}`) })
      if (next === "stop") break outer
      if (next === "outer") continue outer
      if (next === "inner") continue
      if (next === "return") return -total
      total += next
    }
  }
  return total
}

effect function lease(name: string) {
  return try Effect.acquireRelease(
    effect {
      events.push(`open ${name}`)
      return name
    },
    effect () => {
      events.push(`close ${name}`)
    }
  )
}

// Each acquisition has its own scope, including the iterations that jump.
effect function leases() {
  for (const name of ["a", "b", "c", "d"]) {
    const held = try scoped(effect {
      const resource = try lease(name)
      if (resource !== "b" && resource !== "c") events.push(`use ${resource}`)
      return resource
    })
    if (held === "b") continue
    if (held === "c") break
  }
  return try scoped(lease("e"))
}

// expect-result: {"stop8":13,"stop11":-13,"held":"e","events":["finally 1.0","finally 1.1","finally 2.0","finally 2.1","caught 3","finally 3.0","finally 3.1","finally 4.0","finally 4.1","finally 5.0","finally 5.1","finally 6.0","finally 6.1","finally 7.0","finally 7.1","finally 8.0","finally 1.0","finally 1.1","finally 2.0","finally 2.1","caught 3","finally 3.0","finally 3.1","finally 4.0","finally 4.1","finally 5.0","finally 5.1","finally 6.0","finally 6.1","finally 7.0","finally 7.1","finally 8.0","finally 8.1","caught 9","finally 9.0","open a","use a","close a","open b","close b","open c","close c","open e","close e"]}
export effect function main() {
  const stop8 = try loop(8)
  const stop11 = try loop(11)
  const held = try leases()
  return { stop8, stop11, held, events }
}
