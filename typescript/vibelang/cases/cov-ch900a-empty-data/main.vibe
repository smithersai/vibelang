import { Effect } from "effect"
data Empty {}
type Equal<X,Y> = (<T>() => T extends X ? 1 : 2) extends (<T>() => T extends Y ? 1 : 2) ? true : false
const emptyType: Equal<Empty, never> = true
export effect function main() { return emptyType }

