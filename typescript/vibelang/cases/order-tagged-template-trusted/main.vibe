// expect-result: {"call":"caught","tagged":"caught","effect":"caught","value":"a7b","effect value":"a7b"}
// A tagged template calls its tag with the tag's contract, as a call does: a
// failure the tag lists is an expected failure that catch receives, also when
// a substitution runs an Effect (chapter 13).
import { tag } from "./helper.js"

effect function number(n: number) {
  try Effect.yieldNow()
  return n
}

export effect function main() {
  let call = ""
  let tagged = ""
  let effect = ""
  try { tag(Object.assign(["a", "b"], { raw: ["a", "b"] }), 0) } catch { call = "caught" }
  try { tag`a${0}b` } catch { tagged = "caught" }
  try { tag`a${try number(0)}b` } catch { effect = "caught" }
  return { call, tagged, effect, value: tag`a${7}b`, "effect value": tag`a${try number(7)}b` }
}
