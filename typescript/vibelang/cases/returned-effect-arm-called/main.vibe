// expect-result: [true,true,true,true]
// The spelling EK4802's quick fix writes for a returned arm: a called Effect
// value runs, so emit(0) interrupts and emit(1) logs.
interface Hooks {
  emit: (n: number) => void!never
  cached: (n: number | undefined) => void!never
}

const hooks: Hooks = {
  emit: effect (n) => n === 0 ? try Effect.interrupt() : try Console.log("emit", n),
  cached: effect (n) => n ?? try Effect.interrupt(),
}

export effect function main() {
  return [
    Exit.isFailure(try exit(hooks.emit(0))),
    Exit.isSuccess(try exit(hooks.emit(1))),
    Exit.isFailure(try exit(hooks.cached(undefined))),
    Exit.isSuccess(try exit(hooks.cached(2))),
  ]
}
