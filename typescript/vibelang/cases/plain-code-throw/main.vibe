// expect-result: ["Bad(empty)","Bad(negative)","Bad(unread)","Bad(read-only)","Bad(boom)","Bad(first)","Bad(local)",["Bad(static)","Bad(top)","Bad(nested)","Bad(expression)"]]
// A constructor, an accessor, a class static block and a module's top level
// are plain JavaScript (VIP-1, VIP-26), so a throw there is JavaScript's
// throw (VIP-4), which a plain caller's catch catches.
import { Data } from "effect"
import { Bad } from "./bad.vibe"

// A constructor of an Effect TypeScript error class and of an ordinary class.
// An error declaration has no constructor (EK1301, VIP-13).
class Invalid extends Data.TaggedError("Invalid")<{}> {
  constructor(raw: string) {
    super()
    if (raw === "") throw new Bad({ why: "empty" })
  }
}

class Port {
  constructor(readonly value: number) {
    if (value < 0) throw new Bad({ why: "negative" })
  }
}

// Accessors of a class and of an object literal.
class Gauge {
  get level(): number { throw new Bad({ why: "unread" }) }
  set level(value: number) { throw new Bad({ why: "read-only" }) }
}

export const hostile = {
  get boom(): never { throw new Bad({ why: "boom" }) }
}

// A rethrow from a constructor's own catch.
class Retry {
  constructor() {
    try {
      throw new Bad({ why: "first" })
    } catch (e) {
      throw e
    }
  }
}

// A class inside a function: its constructor is still plain JavaScript.
export function make() {
  class Local {
    constructor() { throw new Bad({ why: "local" }) }
  }
  return new Local()
}

function named(e: unknown): string {
  return e instanceof Bad ? `Bad(${e.why})` : `other: ${String(e)}`
}

function caught(f: () => unknown): string {
  try {
    f()
    return "returned"
  } catch (e) {
    return named(e)
  }
}

async function loads(load: () => Promise<unknown>): Promise<string> {
  try {
    await load()
    return "loaded"
  } catch (e) {
    return named(e)
  }
}

export effect function main() {
  const modules = try Effect.promise(() => Promise.all([
    loads(() => import("./registry.vibe")),
    loads(() => import("./top-statement.vibe")),
    loads(() => import("./top-block.vibe")),
    loads(() => import("./top-expression.vibe"))
  ]))
  return [
    caught(() => new Invalid("")),
    caught(() => new Port(-1)),
    caught(() => new Gauge().level),
    caught(() => { new Gauge().level = 1 }),
    caught(() => hostile.boom),
    caught(() => new Retry()),
    caught(() => make()),
    modules
  ]
}
