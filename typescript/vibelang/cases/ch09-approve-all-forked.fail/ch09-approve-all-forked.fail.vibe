// expect: EK4201
// Chapter 9 "Handlers and concurrency": Approval.approve is a control operation, and forEach with
// concurrency 4 runs its callback on other fibers, where the Approval handler cannot be reached.

class ReviewBusy extends TaggedError("ReviewBusy")<{ readonly request: string }> {}

abstract class Approval extends Control {
  abstract approve(request: string): Effect<boolean, ReviewBusy, never>
}

function approveAll(ids: ReadonlyArray<string>) {
  return try Effect.forEach(ids, (id) => Approval.approve(id), { concurrency: 4 })
}
