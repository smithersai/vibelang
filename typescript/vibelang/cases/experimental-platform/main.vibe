// The Experimental namespace (D313) is in scope without an import. Its
// FileSystem and Crypto extend Effect's services, and the experimental Node
// bundle provides them and Effect's from one implementation. Each addition
// runs here on the real file system and WebCrypto.
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { isLink, kind, size } from "./links.vibe"

function hex(bytes: Uint8Array) {
  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
}

export effect function inspect(dir: string) {
  const fs = try Experimental.FileSystem.FileSystem()
  try fs.writeFileString(`${dir}/data`, "1234")
  try fs.chmod(`${dir}/data`, 0o644)
  try fs.symlink("data", `${dir}/link`)
  const denied = (try Effect.flip(fs.access(`${dir}/data`, { executable: true }))).reason._tag;
  {
    using file = try fs.open(`${dir}/data`, { flag: "r+", noFollow: true, nonBlocking: true })
    try fs.rename(`${dir}/data`, `${dir}/moved`)
    try file.chmod(0o600)
  }
  const key = Redacted.make(new TextEncoder().encode("Jefe"))
  const mac = try Experimental.Crypto.Crypto.hmac("SHA-256", key, new TextEncoder().encode("what do ya want for nothing?"))
  return {
    link: (try fs.lstat(`${dir}/link`)).type,
    isLink: try isLink(`${dir}/link`),
    kind: try kind(fs, `${dir}/link`),
    followed: try isLink(`${dir}/moved`),
    size: Number(try size(`${dir}/moved`)),
    denied,
    mode: ((try fs.stat(`${dir}/moved`)).mode & 0o777).toString(8),
    mac: hex(mac)
  }
}

// expect-result: {"link":"SymbolicLink","isLink":true,"kind":"SymbolicLink","followed":false,"size":4,"denied":"PermissionDenied","mode":"600","mac":"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"}
export effect function main() {
  provide ExperimentalNodeServices.layer {
    using dir = try Experimental.FileSystem.FileSystem.makeTempDirectoryScoped()
    return try inspect(dir)
  }
}
