// A file imports an experimental service by name from its subpath; the
// import shadows the prelude's FileSystem, and Effect's members keep working
// on the same service.
import { FileSystem } from "vibelang-runtime/experimental/FileSystem"

export function isLink(path: string) {
  return (try FileSystem.lstat(path)).type === "SymbolicLink"
}

export function size(path: string) {
  return (try FileSystem.stat(path)).size
}

// A parameter of the prelude namespace's implementation type: the declaration file
// imports Experimental from vibelang-runtime.
export function kind(fs: Experimental.FileSystem.Service, path: string) {
  return (try fs.lstat(path)).type
}
