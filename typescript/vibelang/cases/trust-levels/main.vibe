// Trust levels (D5, D22, D249): what a call to code that is not Effect means.
import { Cause, Effect, Exit, Option } from "effect"
import { legacyParse, parseJson, parsePort, offsetPort } from "./parsers.ts"

// A library function trusted as a value: parseJson lists SyntaxError, which
// joins E, so a catch receives it.
function config(text: string) {
  try {
    return (parseJson(text) as { port: number }).port
  } catch (e) {
    return e instanceof SyntaxError ? -1 : -2
  }
}

// A trusted function: PortError joins E.
function port(text: string) {
  try {
    return parsePort(text)
  } catch (e) {
    return e._tag
  }
}

// An exception the contract does not list is a defect that no catch sees.
effect function crash() {
  return try Effect.exit(effect { return parsePort("boom") })
}

// The arguments run their Effects before the trusted call.
effect function loaded() {
  return parsePort(try Effect.succeed("8443"))
}

// Value contracts are Effects; catch their failures in a VibeLang function.
function parseOr(text: string, fallback: number) {
  try {
    return parseJson(text) as number
  } catch (e) {
    return fallback
  }
}

// Effect's own exports are trusted, and so are the functions they return.
function first(values: ReadonlyArray<number>) {
  return Option.getOrElse(Option.fromNullishOr(values[0]), () => 0)
}

// A boundary: inside Effect.try, a plain TypeScript call is allowed.
effect function legacy(text: string) {
  try {
    return try Effect.try({ try: () => legacyParse(text), catch: () => "bad port" })
  } catch (e) {
    return e
  }
}

// A trusted library function, and a method trusted through an adapter.
function reexported(text: string) {
  try {
    return parseJson(text)
  } catch (e) {
    return e.name
  }
}

function offset(by: number) {
  try {
    return offsetPort(65530, by)
  } catch (e) {
    return e._tag
  }
}

// A parameter's callee is its caller's choice.
function apply(f: (x: number) => number, x: number) {
  return f(x)
}

function parsedValues() {
  const values: number[] = []
  for (const text of ["1", "{"]) values.push(parseOr(text, 0))
  return values
}

// expect-result: {"config":[8080,-1],"port":[80,"PortError"],"crash":true,"loaded":8443,"parsed":[1,0],"first":3,"legacy":[81,"bad port"],"reexported":[{"a":1},"SyntaxError"],"offset":[65535,"PortError"],"apply":4}
export effect function main() {
  const exit = try crash()
  return {
    config: [config(`{"port":8080}`), config("{")],
    port: [port("80"), port("x")],
    crash: Exit.isFailure(exit) && Cause.hasDies(exit.cause),
    loaded: try loaded(),
    parsed: parsedValues(),
    first: first([3, 4]),
    legacy: [try legacy("81"), try legacy("x")],
    reexported: [reexported(`{"a":1}`), reexported("{")],
    offset: [offset(5), offset(6)],
    apply: apply((x) => x * 2, 2)
  }
}
