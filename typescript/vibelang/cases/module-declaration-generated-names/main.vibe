// expect-result: 2
// The file and its module declaration both import effect/Effect. The module
// is a JavaScript module of its own (D403), so the two imports never share a
// scope; inlined, both took the generated name Effect_1 and the file declared
// it twice.
module bridge {
  import * as Effect from "effect/Effect"

  /** @vibelang trusted */
  export const run = <A, E>(effect: Effect.Effect<A, E>): A => Effect.runSync(effect)
}

import { run } from bridge

const decode = Schema.decodeUnknownEffect(Schema.Number)

export const same = effect <A, E>(effect: A!E!): A!E! => try effect()

export function main() {
  return run(decode(2))
}
