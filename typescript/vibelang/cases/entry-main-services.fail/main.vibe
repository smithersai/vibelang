// The entry statement runs an exported main with a root runner (D135), which
// supplies no services, so EK3205 warns of each service main still needs
// (D122). It is a warning: a module that exports main may also be a library
// whose importer provides them (imported.vibe).
import { Users } from "./services.vibe"

export effect function main() {
  try Console.log(try (try Users).find("1"))
}

