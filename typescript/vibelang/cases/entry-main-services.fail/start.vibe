// Runs the mains that imported.vibe, namespaced.vibe and reexported.vibe
// export, with the services they need.
import { main } from "./imported.vibe"
import * as namespaced from "./namespaced.vibe"
import { UsersLive } from "./services.vibe"

export { main as reexported } from "./reexported.vibe"

Effect.runPromise(() => {
  provide UsersLive {
    try main()
    try namespaced.main()
  }
})
