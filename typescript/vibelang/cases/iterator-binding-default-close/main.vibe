import { Effect } from "effect"
import { pairs, events } from "./helper.js"
effect function boom(): number!string { throw "boom" }
effect function main() {
 effect {
   for (const [n = try boom()] of pairs()) { events.push("body:"+n) }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("binding", events.join(","))
 events.length = 0
 effect {
   for (const pair of pairs()) { const [n = try boom()] = pair; events.push("body:"+n) }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("body", events.join(","))
}
Effect.runPromise(main())
