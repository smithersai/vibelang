// Exactly one owner releases a using value, decided by what an acquisition
// recorded at run time, never by Scope in a contract (D401). An acquisition
// that registers the value's release records it, and using adds nothing:
// Effect.acquireRelease of a Disposable whose release disposes it closes once
// ("released", opus-7's t33), behind a wrapper function ("wrapped"), as an
// Effect value using calls ("value"), and Effect.acquireDisposable behind a
// wrapper ("disposable"). A value that nothing recorded is disposed by using
// once: a plain Disposable ("plain"), one an Effect returns ("unscoped"), and
// one from a function whose contract names Scope but registers nothing
// ("lease").
const events: string[] = []

function handle(name: string) {
  return { [Symbol.dispose](): void { events.push(`dispose ${name}`) } }
}

effect function unscoped(name: string) {
  try yieldNow()
  return handle(name)
}

effect function lease(name: string): Disposable!!Scope {
  try yieldNow()
  return handle(name)
}

effect function open(name: string) {
  return try Effect.acquireRelease(effect { return try handle(name) }, effect (h) => { h[Symbol.dispose]() })
}

effect function openDisposable(name: string) {
  return try Effect.acquireDisposable(effect { return try handle(name) })
}

const leasedValue: Disposable!!Scope = Effect.acquireRelease(effect { return try handle("value") }, effect (h) => { h[Symbol.dispose]() })

function closes(name: string) {
  return events.filter((event) => event === `dispose ${name}`).length
}

effect function work() {
  using plain = handle("plain")
  using fromEffect = try unscoped("unscoped")
  using leased = try lease("lease")
  using released = try Effect.acquireRelease(effect { return try handle("released") }, effect (h) => { h[Symbol.dispose]() })
  using wrapped = try open("wrapped")
  using value = try leasedValue()
  using disposable = try openDisposable("disposable")
  events.push("body")
}

// expect-result: {"released":1,"wrapped":1,"value":1,"disposable":1,"plain":1,"unscoped":1,"lease":1,"events":["body","dispose disposable","dispose value","dispose wrapped","dispose released","dispose lease","dispose unscoped","dispose plain"]}
export effect function main() {
  try work()
  return {
    released: closes("released"),
    wrapped: closes("wrapped"),
    value: closes("value"),
    disposable: closes("disposable"),
    plain: closes("plain"),
    unscoped: closes("unscoped"),
    lease: closes("lease"),
    events
  }
}
