// expect: EK3201
// Reference program 2 / D27: no provider for Smtp. wire(MailerLive) leaves Smtp in the layer's
// inputs, as Layer.provide would, and the compiler reports it with its dependency path where the
// program's R must be empty: here, at the runner.

service Smtp {
  deliver(to: string): Effect<void, never, never>
}

service Mailer {
  send(to: string): Effect<void, never, never>
}

const MailerLive = Layer.effect(Mailer, effect {
  const smtp = try Smtp()
  return {
    send: effect (to) => try smtp.deliver(to)
  }
})

const AppLive = wire(MailerLive)

effect function welcome() {
  try Mailer.send("ada@example.com")
}

effect function main() {
  try Effect.provide(effect { return try welcome() }, AppLive)
}

Effect.runFork(effect { return try main() })
