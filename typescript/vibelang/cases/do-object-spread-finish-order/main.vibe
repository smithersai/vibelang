// expect-result: [["object-spread",true,[["get:x:1","do"],[["x",1],["y",5],["last",3]]]],["object-spread-null",true,[["do"],[["last",3]]]],["object-spread-throws",true,[["get:x:1"],"throw:get"]],["object-spread-order",true,[["get:x:1","do","get:x:2"],[["x0",0],["x",2],["y",5],["y0",3]]]],["outward",["get:x:1","do"]]]

// VIP-2 pins TC39 do expressions: "The block runs where the do expression stands."

// Every operand before a do is finished first: a spread is iterated, an object

// spread copies its properties, a computed key is converted (ToPropertyKey), an

// untagged substitution is converted to a string and a tag is read. Each scenario

// runs twice, with do and with each do as an immediately invoked function; main

// reports whether both agree and the do run's trace and value.

import { Box, iter, key, shape, src, str, sum, sym, tags, Trace, withArrayIterator } from "./operands.ts"

function s6Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...src(t, false), last: do { t.ev('do'); t.state = 2; 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s6Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...src(t, false), last: (function (): number { t.ev('do'); t.state = 2; return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s7Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...(null as null | { x: number }), last: do { t.ev('do'); 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s7Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...(null as null | { x: number }), last: (function (): number { t.ev('do'); return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s8Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...src(t, true), last: do { t.ev('do'); 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s8Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ ...src(t, true), last: (function (): number { t.ev('do'); return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s9Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ x0: 0, ...src(t, false), y0: do { t.ev('do'); t.state = 2; 3 }, ...src(t, false) })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s9Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ x0: 0, ...src(t, false), y0: (function (): number { t.ev('do'); t.state = 2; return 3 })(), ...src(t, false) })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function outward(): string[] {
  const t = new Trace()
  const value = { ...src(t, false), last: do { t.ev("do"); return t.events } }
  return [String(value)]
}

const scenarios: [string, () => unknown, () => unknown][] = [["object-spread",s6Do,s6Fn],["object-spread-null",s7Do,s7Fn],["object-spread-throws",s8Do,s8Fn],["object-spread-order",s9Do,s9Fn]]

export effect function main() {
  const results: unknown[] = []
  for (const [name, viaDo, viaFunction] of scenarios) {
    const a = viaDo(), b = viaFunction()
    results.push([name, JSON.stringify(a) === JSON.stringify(b), a])
  }

  results.push(["outward", outward()])
  return results
}
