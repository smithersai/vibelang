import {nativeValues} from "./native.js"
function* fromArm(source:{field:number}):Generator<number,number,number>{
 return match(source){when {field:let value}:yield value;default:0;}
}
function* fromSubject(source:{field:number}):Generator<number,number,{field:number}>{
 return match(yield source.field){when {field:let value}:value;default:0;}
}
function* asStatement(source:{field:number}):Generator<number,number,number>{
 match(source){when {field:let value}:yield value;default:0;};return 0
}
function* asExpression(source:{field:number}):Generator<number,number,number>{
 return 1+(match(source){when {field:let value}:yield value;default:0;})
}
function* asInitializer(source:{field:number}):Generator<number,number,number>{
 const result=match(source){when {field:let value}:yield value;default:0;};return result
}
