// expect: EK4607 EK1802 EK4604
effect function load(): number!! {
  return 1
}

export effect function replaced() {
  select {
    case const n = load(): return n
  }
}

export effect function retired() {
  return await.race [load(), load()]
}

export effect function inHatch() {
  return try sync(() => {
    await Promise.resolve(1)
  })
}
