// expect: EK4607 EK4608 EK4604
effect function load(): number!! {
  return 1
}

export effect function replaced() {
  select {
    case const n = load(): return n
  }
}

export effect function keyed() {
  return await.race { a: load(), b: load() }
}

export effect function inHatch() {
  return try sync(() => {
    await.all [Promise.resolve(1)]
  })
}
