// expect: EK4607 EK4608 EK4604
function load(): number!! {
  return 1
}

export function replaced() {
  select {
    case const n = load(): return n
  }
}

export function keyed() {
  return await.race { a: load(), b: load() }
}

export function inHatch() {
  return try sync(() => {
    await.all [Promise.resolve(1)]
  })
}
