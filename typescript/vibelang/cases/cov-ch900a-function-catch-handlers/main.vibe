import { Effect } from "effect"
export effect function main() {
 const a = Effect.fail(1) catch function (e: number) { return e + 1 }
 const b = Effect.fail(1) catch effect function (e: number) { return try Effect.succeed(e + 2) }
 const c = Effect.fail(1) catch (function (e: number) { return e + 1 })
 const d = Effect.fail(1) catch (effect function (e: number) { return try Effect.succeed(e + 2) })
 return [a,b,c,d]
}

