export effect function main() {
 const values: number[] = []
 let n = 0
 own: for concurrent(1) (const x of [1, 2]) {
  const value = do { if(x===1)continue own; 7 }
  n += value
 }
 values.push(n); n = 0
 for concurrent(1) (const x of [1, 2]) {
  const value = do { if(x===1)continue; 7 }
  n += value
 }
 values.push(n); n = 0
 named: alias: for concurrent(1) (const x of [1, 2]) {
  const value = match(x) { when 1: do { continue named }; default: 7; }
  void value
  n += 7
 }
 values.push(n); n = 0
 suspended: for concurrent(1) (const x of [1, 2]) {
  const value = do { if(x===1)continue suspended; try succeed(7) }
  n += value
 }
 values.push(n); n = 0
 for concurrent(1) (const x of [1, 2]) {
  for(const y of [1, 2]) {
   const value = do { if(y===1)continue; 7 }
   n += value
  }
 }
 values.push(n); n = 0
 maskedDo: for concurrent(1) (const x of [1, 2]) {
  const value = do { uninterruptible { if(x===1)continue maskedDo }; 7 }
  n += value
 }
 values.push(n); n = 0
 scan: for try(const x of Stream.make(1, 2)) {
  const value = do { if(x===1)continue scan; 7 }
  n += value
 }
 values.push(n)
 return values
}
