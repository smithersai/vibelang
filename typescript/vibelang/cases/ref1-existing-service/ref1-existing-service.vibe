// Reference program 1. Existing Effect service: import a generic, overloaded, aliased TypeScript
// Effect function; compose it without changing E or R; provide a Layer from TypeScript.
// NOTE: the proposal states this program in prose only. The contract comments below are this
// file's expectations ("without changing E or R"), not contracts printed in the proposal.
import { fetchUser, findBy, getUser, loadUser, lookup, UserRepo, UserRepoLive } from "./ref1-users-repo.ts"

effect function teamOf(id: string) {
  return (try lookup(id)).team                     // overloaded: the single-id signature
}
// Effect<string, UserNotFound | DbError, UserRepo>

effect function teamNames(ids: ReadonlyArray<string>) {
  const members = try lookup(ids)                // overloaded: the many-ids signature
  return (members as ReadonlyArray<(typeof members)[number]>).map((member) => member.name)
}
// Effect<string[], UserNotFound | DbError, UserRepo>

effect function coreLead() {
  return (try findBy("team", "core")).name         // generic: K = "team"
}
// Effect<string, UserNotFound | DbError, UserRepo>

effect function aliases(id: string) {
  const a = (try fetchUser(id)).name
  const b = (try getUser(id)).name
  const c = (try loadUser(id)).name
  return [a, b, c]
}
// Effect<string[], UserNotFound | DbError, UserRepo>

// The TypeScript-authored Context.Service class is used like a .vibe service.
// NOTE: UserRepo.all is an Effect-valued member, not a method; calling it runs it (Chapter 11's
// "a value of type Effect, called as p()"). Whether `UserRepo.all()` is the right spelling is open.
effect function directly(id: string) {
  const user = try UserRepo.byId(id)
  const everyone = try UserRepo.all()
  return `${user.name} of ${everyone.length}`
}
// Effect<string, UserNotFound | DbError, UserRepo>

effect function scenario() {
  let missing = "none"
  try {
    try teamOf("9")
  } catch (e) {
    missing = e._tag
  }
  return {
    team: try teamOf("2"),
    names: try teamNames(["1", "3"]),
    lead: try coreLead(),
    aliases: try aliases("2"),
    direct: try directly("3"),
    missing
  }
}

// expect-result: {"team":"compilers","names":["Ada","Edsger"],"lead":"Ada","aliases":["Grace","Grace","Grace"],"direct":"Edsger of 3","missing":"UserNotFound"}
export effect function main() {
  return try Effect.provide(effect { return try scenario() }, UserRepoLive)
}
