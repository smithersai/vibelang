// expect-result: {"ternary":[0,7,-1],"and":[false,7,-1],"if":[0,7,-1],"typeof":[0,7,-1],"bracket":[0,7,-1],"nested":[0,7,-1],"rethrow":7,"getter":[7,2]}
type Read = () => Effect.Effect<number, string, never>
interface Source { readonly read?: Read }

export effect function ternary(source: Source): number!! {
  return source.read === undefined ? 0 : (source.read() catch -1)
}

export effect function and(source: Source): number | false!! {
  return source.read !== undefined && (source.read() catch -1)
}

export effect function guardedIf(source: Source): number!! {
  if (source.read !== undefined) return source.read() catch -1
  return 0
}

export effect function guardedTypeof(source: Source): number!! {
  return typeof source.read === "function" ? (source.read() catch -1) : 0
}

export effect function bracket(source: Source): number!! {
  return source["read"] === undefined ? 0 : (source["read"]() catch -1)
}

export effect function nested(source: Source): number!! {
  return source.read === undefined ? 0 : ((source.read() catch effect (error) => (throw error)) catch -1)
}

// The original Smithers repro uses an arrow and a rethrowing handler.
export const rethrow = effect (source: Source): Effect.Effect<number, string, never> => {
  return source.read === undefined ? 0 : (source.read() catch effect (error) => (throw error))
}

effect function read(): number!string! { return 7 }
effect function failed(): number!string! { throw "failed" }

export effect function main() {
  const absent: Source = {}
  const present: Source = { read }
  const failure: Source = { read: failed }
  let reads = 0
  const getter: Source = { get read(): Read { reads++; return read } }
  const getterValue = try ternary(getter)
  return {
    ternary: [try ternary(absent), try ternary(present), try ternary(failure)],
    and: [try and(absent), try and(present), try and(failure)],
    if: [try guardedIf(absent), try guardedIf(present), try guardedIf(failure)],
    typeof: [try guardedTypeof(absent), try guardedTypeof(present), try guardedTypeof(failure)],
    bracket: [try bracket(absent), try bracket(present), try bracket(failure)],
    nested: [try nested(absent), try nested(present), try nested(failure)],
    rethrow: rethrow(present) catch -1,
    getter: [getterValue, reads]
  }
}
