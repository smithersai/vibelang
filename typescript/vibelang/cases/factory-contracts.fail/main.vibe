// expect: TS2322
// A plain function returning effect { } is checked as TypeScript checks any
// return value: effect { } is the same as (effect () => { … })() (VIP-2), so
// a block whose failure, requirement or success the written Effect type
// rejects is TS2322. Before VIP-1 these were factories (D269), checked as
// Effect contracts (EK9201, EK9202).
import { Effect } from "effect"
error Gone {}
service Needed { value(): number!! }
export function fails(): number!! { return effect { throw new Gone() } }
export function needs(): number!! { return effect { return try Needed.value() } }
export function wrong(): number!! { return effect { return "wrong" } }
