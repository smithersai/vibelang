{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": false,
    "outDir": "out",
    "declaration": true,
    "allowJs": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.vibe",
    "*.js"
  ]
}
