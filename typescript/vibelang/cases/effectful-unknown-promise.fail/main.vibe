// expect: EK0401
// Returning a Promise does not establish a synchronous never-throw contract.
import { Effect } from "effect"
import { raw, safe } from "./lib.js"
export effect function effectDefault(p = raw()) { return p }
export effect function* producerDefault(p = raw()) { yield p }
export function factory(): Effect.Effect<number> { raw(); return Effect.succeed(1) }
export function factoryDefault(p = raw()): Effect.Effect<number> { return Effect.succeed(1) }
export const arrowDefault = (p = raw()): Effect.Effect<number> => Effect.succeed(1)
export function caught(): Effect.Effect<number> { try { raw() } catch {} return Effect.succeed(1) }
export function ordinary(p = raw()) { return p }
export async function native(p = raw()) { return p }
export effect function safeDefault(p = safe()) { return p }
export effect function intrinsicDefault(p = Promise.resolve(1)) { return p }
async function local() { return 1 }
export effect function localDefault(p = local()) { return p }
