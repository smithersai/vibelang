{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out",
    "vibelang": { "diagnostics": { "EK9204": "loud", "EK9201": "off" }, "tracing": "sometimes", "tracng": "all" }
  },
  "include": ["*.vibe", "*.ts"]
}
