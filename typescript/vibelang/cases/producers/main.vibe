import * as $nativeTryEffect from "effect/Effect";
// Producers (chapter 8, D26): lazy, one value at a time, cleanup on early
// exit by break, return, and continue to an outer label, one pass per run,
// service calls between yields, iteration over another producer, a producer passed
// to Stream.take, for...of over a Stream, and 100,000 elements in constant
// stack.
import { Data, Stream } from "effect"
import { hooks } from "vibelang-runtime/kernel"

class Missing extends Data.TaggedError("Missing")<{ readonly key: string }> {}

service Store {
  get(key: string): Effect<number, Missing, never>
}

effect function* numbers(limit: number, log: string[]) {
  try addFinalizer(effect () => { log.push("closed") })
  let n = 0
  while (n < limit) {
    log.push(`yield ${n}`)
    yield n
    n++
  }
}

// A producer calls a service between yields.
effect function* lookups(keys: ReadonlyArray<string>) {
  for (const key of keys) yield try (try Store).get(key)
}

// Iterate a producer to yield each of its elements (VIP-21).
effect function* withTen(log: string[]) {
  for try (const value of numbers(2, log)) yield value
  yield 10
}

class Broken extends Data.TaggedError("Broken")<{ readonly at: number }> {}

// A producer that fails after two elements.
export effect function* failing() {
  yield 1
  yield 2
  throw new Broken({ at: 3 })
}

effect function* pairs() {
  yield [1, "one"] as const
  yield [2, "two"] as const
}

effect function* count(n: number) {
  let i = 0
  while (i < n) {
    yield i
    i++
  }
}

function lazy() {
  const log: string[] = []
  const producer = numbers(3, log)
  return log.length
}

effect function returnInside() {
  const log: string[] = []
  let result = -1
  for try (const n of numbers(100, log)) {
    if (n > 1) { result = n; break }
  }
  return { n: result, log }
}

effect function breakInside() {
  const log: string[] = []
  let sum = 0
  for try (const n of numbers(10, log)) {
    if (n === 3) break
    sum += n
  }
  log.push("after loop")
  return { sum, log }
}

effect function continueOuter() {
  const log: string[] = []
  const pairs: string[] = []
  for try (const a of numbers(3, log)) {
    for try (const b of numbers(3, log)) {
      if (b > a) break
      pairs.push(`${a}${b}`)
    }
  }
  return { pairs, closed: log.filter((line) => line === "closed").length }
}

effect function twoPasses() {
  const log: string[] = []
  const producer = numbers(2, log)
  let count = 0
  for try (const n of producer) count++
  for try (const n of producer) count++
  return count
}

effect function services() {
  let total = 0
  for try (const value of lookups(["a", "b", "c"])) total += value
  return total
}

effect function delegated() {
  const values: number[] = []
  for try (const n of withTen([])) values.push(n)
  return values
}

effect function taken() {
  const log: string[] = []
  const values = try Stream.runCollect(Stream.take(numbers(100, log), 2))
  return { values, log }
}

effect function overStream() {
  let sum = 0
  for try (const n of Stream.make(1, 2, 3, 4)) {
    if (n === 4) break
    sum += n
  }
  return sum
}

// A loop's binding can be a const or let declaration, including a pattern.
effect function bindings() {
  const names: string[] = []
  for try (const [n, name] of pairs()) names.push(`${n}:${name}`)
  let last = 0
  for try (const value of count(3)) { last = value; names.push(`last ${last}`) }
  for try (let v of count(2)) names.push(`var ${v}`)
  return { names, last }
}

// A failing producer's error reaches the catch around its loop, after the
// elements before it.
effect function caught() {
  const seen: number[] = []
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    for try (const n of failing()) seen.push(n)
  
;return { kind: "normal" } as const;
}, effect (e) => {
    return { kind: "return:" as const, value: ({ seen, error: e._tag, at: e.at }) };
  });
if ($nativeTryCompletion.kind === "return:") return $nativeTryCompletion.value;
}
  return { seen, error: "none", at: 0 }
}

// break to a label of an enclosing JavaScript loop leaves the producer loop.
effect function outerBreak() {
  const seen: string[] = []
  let stop = false
  for (let row = 0; row < 3; row++) {
    for try (const n of count(5)) {
      if (n === 2) break
      if (row === 2) { stop = true; break }
      seen.push(`${row}${n}`)
    }
    if (stop) break
  }
  return seen
}

effect function big() {
  let maxDepth = 0
  hooks.onResume = (fiber): void => {
    maxDepth = Math.max(maxDepth, fiber._stack.length)
  }
  let sum = 0
  for try (const n of count(100000)) sum += n
  hooks.onResume = undefined
  return { sum, bounded: maxDepth < 50 }
}

const StoreLive = Layer.succeed(Store, {
  get: effect (key) => key.charCodeAt(0) - 96
})

effect function scenario() {
  return {
    lazy: lazy(),
    returned: try returnInside(),
    broke: try breakInside(),
    labeled: try continueOuter(),
    passes: try twoPasses(),
    services: try services(),
    delegated: try delegated(),
    taken: try taken(),
    stream: try overStream(),
    bindings: try bindings(),
    caught: try caught(),
    outerBreak: try outerBreak(),
    big: try big()
  }
}

// expect-result: {"lazy":0,"returned":{"n":2,"log":["yield 0","yield 1","yield 2","yield 3","yield 4","closed"]},"broke":{"sum":3,"log":["yield 0","yield 1","yield 2","yield 3","yield 4","yield 5","closed","after loop"]},"labeled":{"pairs":["00","10","11","20","21","22"],"closed":4},"passes":4,"services":6,"delegated":[0,1,10],"taken":{"values":[0,1],"log":["yield 0","yield 1","yield 2","yield 3","closed"]},"stream":6,"bindings":{"names":["1:one","2:two","last 0","last 1","last 2","var 0","var 1"],"last":2},"caught":{"seen":[1,2],"error":"Broken","at":3},"outerBreak":["00","01","10","11"],"big":{"sum":4999950000,"bounded":true}}
export effect function main() {
  return try Effect.provide(effect { return try scenario() }, StoreLive)
}
