let seen=0, bodies=0
function* declared(x = do { seen++; return 7 }) { bodies++; yield 1 }
const expression = function* (x = do { seen++; return 7 }) { bodies++; yield 1 }
const object = { *method(x = do { seen++; return 7 }) { bodies++; yield 1 } }
async function* asyncDeclared(x = do { seen++; return 7 }) { bodies++; yield 1 }
const asyncExpression = async function* (x = do { seen++; return 7 }) { bodies++; yield 1 }
const asyncObject = { async *method(x = do { seen++; return 7 }) { bodies++; yield 1 } }
export async function probe() {
 const a=declared(), b=expression(), c=object.method()
 const d=asyncDeclared(), e=asyncExpression(), f=asyncObject.method()
 const afterCall=[seen,bodies]
 return {afterCall, values:[a.next(),b.next(),c.next(),await d.next(),await e.next(),await f.next()],
  bodies, prototype:Object.getPrototypeOf(a)===declared.prototype, length:declared.length,
  kind:declared.constructor.name}
}

