import { Effect } from "effect"
let counter = 0
const events: number[] = []
const state = { value: 1 }
export function reset() { counter = 0; events.length = 0; state.value = 1 }
export function snapshot() { return { counter, events: [...events] } }
export function change(value: number) { state.value = value }
function tick(weight: number) { counter += weight; events.push(counter); return counter }

export effect function fromState(value = state.value) { return value }
export effect function fromArgument(input: { branch: string }, value = input.branch) { return value }
export effect function fresh(options: { seen?: number } = {}) { options.seen = (options.seen ?? 0) + 1; return options }
export effect function freshArray(values: number[] = []) { values.push(1); return values }
export effect function effectValue(value = Effect.succeed(tick(1))) { return try value }
export function make(weights: number[], supplied?: number) {
  const f = effect (a = tick(weights[0]), b = a + tick(weights[1]), c = b + tick(weights[2])) => {
    events.push(-c)
    return [a, b, c]
  }
  return f(supplied)
}
export const generator = { effect *values(value = tick(3)) { yield value; yield tick(1) } }

// Preserve Effect.fn's execution-time initialization using a cold block.
export function migrated(input: { branch: string }, value?: string, options?: { seen?: number }) {
  return effect {
    const resolved = value === undefined ? input.branch : value
    const allocated = options === undefined ? {} as { seen?: number } : options
    allocated.seen = (allocated.seen ?? 0) + 1
    return { resolved, allocated }
  }
}

export function migratedState(value?: number) {
  return effect { return value === undefined ? state.value : value }
}
export function migratedWeights(weights: number[], a?: number, b?: number, c?: number) {
  return effect {
    const first = a === undefined ? tick(weights[0]) : a
    const second = b === undefined ? first + tick(weights[1]) : b
    const third = c === undefined ? second + tick(weights[2]) : c
    events.push(-third)
    return [first, second, third]
  }
}
