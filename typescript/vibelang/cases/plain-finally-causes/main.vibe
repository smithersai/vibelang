// A function that compiles to plain JavaScript keeps JavaScript's try, catch
// and finally (VIP-4): a failure its finally block raises replaces the one in
// flight. An Effect function's finally block joins the two instead (D15,
// Effect.onExit), so an outer catch recovers the first. Only framed yields,
// so every other function here compiles to plain JavaScript.
error First
error Second
error Cleanup

function replaced() {
  try {
    try { throw new First() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

effect function framed() {
  try yieldNow()
  try {
    try { throw new First() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

// A failure the catch block raises is in flight when the finally block runs.
function catchRaises() {
  try {
    try { throw new First() }
    catch { throw new Second() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

// With nothing in flight, the finally block's failure is the outcome.
function cleanupOnly() {
  try {
    try { return "returned" }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

// Jumps leave the try block through the finally block, which runs once each.
function jumps(steps: string[]) {
  outer: for (const n of [1, 2, 3]) {
    if (n === 2) try { continue } finally { steps.push("continue " + n) }
    try {
      if (n === 3) break outer
      steps.push("body " + n)
    } finally { steps.push("finally " + n) }
  }
  try { return steps } finally { steps.push("returned") }
}

// expect-result: {"replaced":"Cleanup","framed":"First","catchRaises":"Cleanup","cleanupOnly":"Cleanup","jumps":["body 1","finally 1","continue 2","finally 3","returned"]}
export effect function main() {
  const steps: string[] = []
  jumps(steps)
  return {
    replaced: replaced(),
    framed: try framed(),
    catchRaises: catchRaises(),
    cleanupOnly: cleanupOnly(),
    jumps: steps
  }
}
