// A function that compiles to plain JavaScript keeps its try, catch and
// finally, but a failure its finally block raises joins the failure in
// flight instead of replacing it, as an Effect function's finally does
// (D15, Effect.onExit): an outer catch recovers the first expected failure,
// and a defect on either side makes the whole a defect (D305). Only framed
// yields, so every other function here compiles to plain JavaScript.
error First
error Second
error Cleanup

function joined() {
  try {
    try { throw new First() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

function framed() {
  try yieldNow()
  try {
    try { throw new First() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

// A failure the catch block raises is in flight when the finally block runs.
function catchRaises() {
  try {
    try { throw new First() }
    catch { throw new Second() }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

// With nothing in flight, the finally block's failure is the outcome.
function cleanupOnly() {
  try {
    try { return "returned" }
    finally { throw new Cleanup() }
  } catch (e) { return e._tag }
}

function crash(): number {
  return (undefined as any).crash
}

// A defect in the finally block makes First a defect too; the outer catch
// does not run.
function defect() {
  try {
    try { throw new First() }
    finally { crash() }
  } catch { return "caught" }
}

// Jumps leave the try block through the finally block, which runs once each.
function jumps(steps: string[]) {
  outer: for (const n of [1, 2, 3]) {
    if (n === 2) try { continue } finally { steps.push("continue " + n) }
    try {
      if (n === 3) break outer
      steps.push("body " + n)
    } finally { steps.push("finally " + n) }
  }
  try { return steps } finally { steps.push("returned") }
}

function described(outcome: Exit<string, never>): string {
  if (outcome is Exit.Success(let value)) return value
  const reason = outcome.cause.reasons[0]
  return reason._tag === "Die" ? "Die:" + (reason.defect as { _tag?: string })._tag : reason._tag
}

// expect-result: {"joined":"First","framed":"First","catchRaises":"Second","cleanupOnly":"Cleanup","defect":"Die:First","jumps":["body 1","finally 1","continue 2","finally 3","returned"]}
export function main() {
  const steps: string[] = []
  try jumps(steps)
  return {
    joined: try joined(),
    framed: try framed(),
    catchRaises: try catchRaises(),
    cleanupOnly: try cleanupOnly(),
    defect: described(try exit(defect())),
    jumps: steps
  }
}
