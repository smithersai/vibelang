// expect-result: [true, true]
service Flags {
 static readonly key = "tsforms/Flags"
 static readonly default: Flags.Shape = { enabled: true, count: 2 }
 enabled: boolean
 count: number
}
export type Value = typeof Flags.default
export type Indexed = (typeof Flags)["default"]
export type Enabled = (typeof Flags.default)["enabled"]
export type Count = typeof Flags.default.count
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
export const same: [Equal<Value, Flags.Shape>, Equal<Indexed, Flags.Shape>, Equal<Enabled, boolean>, Equal<Count, number>] = [true, true, true, true]
export function main(): [boolean, boolean]!! {
 return [Flags.default.enabled, Flags["default"].count === 2]
}
