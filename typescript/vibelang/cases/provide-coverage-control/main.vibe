// VIP-12 source-completions-and-finalizer-payloads
service NumberService {value:number}
const observed:unknown[]=[]
const Live=Layer.effectDiscard(Effect.acquireRelease(Effect.succeed(undefined),(_,ex)=>Effect.sync(()=>{observed.push(Exit.isSuccess(ex)?ex.value??"undefined":ex._tag)})))
effect function returned():number!!{
 const effect=Live
 provide (effect),NumberService={value:7}{return (try NumberService).value}
}
effect function completed():number!!{return do {provide Live {12}}}
effect function jumps(){
 const seen:number[]=[]
 outer:for(let i=0;i<5;i++){
  provide Live{
   if(i===1)continue outer
   if(i===3)break outer
   seen.push(i)
  }
 }
 return seen
}
effect function bare():void!!{provide Live{return}}
export effect function main(){
 const a=try returned()
 const b=try completed()
 const xs=try jumps()
 try bare()
 return [a,b,xs,observed]
}
// VIP-12 source-completions-and-finalizer-payloads
