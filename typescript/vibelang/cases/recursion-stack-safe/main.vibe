// A function whose contract is an Effect is as stack-safe as its Effect.gen
// equivalent, even when it can neither fail nor pause: recursion through a
// call cycle starts eagerly, then continues on heap frames at the depth bound.
export effect function countdown(n: number): Effect<number> {
  if (n === 0) return 0
  return try countdown(n - 1)
}

export effect function isEven(n: number): Effect<boolean> {
  if (n === 0) return true
  return try isOdd(n - 1)
}

export effect function isOdd(n: number): Effect<boolean> {
  if (n === 0) return false
  return try isEven(n - 1)
}

export effect function sumTo(n: number): Effect<number> {
  return n === 0 ? 0 : n + try sumTo(n - 1)
}

// A caller outside the cycle still reads a number.
function deep() {
  return try countdown(100000) + 1
}

// expect-result: {"countdown":0,"even":true,"odd":false,"sum":5000050000,"deep":1,"mapped":[0,0]}
export effect function main() {
  return {
    countdown: try countdown(100000),
    even: try isEven(100000),
    odd: try isOdd(100000),
    sum: try sumTo(100000),
    deep: deep(),
    mapped: try Effect.forEach([3, 100000], countdown)
  }
}
