// Chapter 002: Effect-only forms in async bodies
import { Fiber, Deferred } from "effect"
export async function invalid(f: Fiber.Fiber<number>, d: Deferred.Deferred<number>) { const a = join f; const b = try Deferred.await(d); return [a,b] }
