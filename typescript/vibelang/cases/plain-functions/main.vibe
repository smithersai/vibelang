// Functions that perform no Effect operation compile to plain JavaScript
// (design D10). VibeLang callers call them inline through their $direct
// variant; TypeScript callers see an Effect, the one calling convention.
import { Effect } from "effect"

const order: string[] = []

function double(n: number): number {
  return n * 2
}

function traced(label: string, n: number) {
  order.push(label)
  return n
}

// Pure recursion runs on the JavaScript stack. A function annotated with a
// plain type keeps it, and its callers call it as it is.
function sumTo(n: number): number {
  return n === 0 ? 0 : n + sumTo(n - 1)
}

// Mutual recursion: the pair is plain because each is plain with the calls
// between them counted as plain (a greatest fixpoint, D56).
function isEven(n: number): boolean {
  return n === 0 ? true : isOdd(n - 1)
}

function isOdd(n: number): boolean {
  return n === 0 ? false : isEven(n - 1)
}

function parity(n: number) {
  return isEven(n) ? "even" : "odd"
}

// Calls pure helpers and an Effect, so it is an Effect itself; the helper
// calls run in source order, before the Effect runs.
effect function area(w: number, h: number) {
  const scaled = traced("w", double(w)) * traced("h", double(h))
  try Effect.sleep("1 millis")
  return scaled
}

// D9: a pure function passed where JavaScript expects a plain function is its
// $direct variant; where Effect expects an Effect function, its Effect form.
effect function maps(xs: ReadonlyArray<number>) {
  const doubled = xs.map(double)
  const viaLambda = xs.map((x) => double(x) + 1)
  const viaEffect = try Effect.forEach(xs, effect (x) => double(x))
  return { doubled, viaLambda, viaEffect }
}

// expect-result: {"sum":500500,"parity":["even","odd"],"area":24,"order":["w","h"],"maps":{"doubled":[2,4],"viaLambda":[3,5],"viaEffect":[2,4]}}
export effect function main() {
  return {
    sum: sumTo(1000),
    parity: [parity(10), parity(7)],
    area: try area(2, 3),
    order,
    maps: try maps([1, 2])
  }
}
