// expect: EK2105 EK0503
error Busy

export effect function attempt() {
  try {
    throw new Busy()
  } catch (e: Error) {
    return "error"
  }
}
// Chapter 900: EK2105 diagnostic - spec-rule: docs/design/src/900-appendices.md#2ad16cbec46d7848

// rule-evidence: docs/design/src/900-appendices.md#appendix-b-diagnostics | The legacy typed catch still warns; its native replacement destructures an any binding without a typed failure filter.
export function readNativeCode(source: { readonly code: number }): number {
  try { return source.code }
  catch ({ code = 1 }: any) { return code }
}
