// expect-result: {"caught":"expected","defect":["Die"],"combined":["Fail","Die"],"escaped":["Fail"],"value":"cause object"}
// Effect.failCause fails with every reason a cause holds, as in Effect code;
// `throw` fails with the value it is given, so a Cause thrown as unknown is
// itself the expected failure (D406).
error Expected

effect function fail() {
  try Effect.failCause(Cause.fail(new Expected()))
}

effect function defect() {
  try Effect.failCause(Cause.die("defect"))
}

effect function combined() {
  try Effect.failCause(Cause.combine(Cause.fail(new Expected()), Cause.die("combined defect")))
}

effect function caught() {
  try {
    try fail()
    return "missing"
  } catch (e) {
    return match (e) {
      when Expected: "expected";
      default: throw e;
    }
  }
}

function value() {
  const cause: unknown = Cause.die("not rethrown")
  try {
    throw cause
  } catch (e) {
    return Cause.isCause(e) ? "cause object" : "other"
  }
}

function reasons(outcome: Exit.Exit<unknown, Expected>) {
  return match (outcome) {
    when Exit.Success(let value): ["Success"];
    when Exit.Failure(let cause): (cause.reasons as ReadonlyArray<(typeof cause.reasons)[number]>).map((reason) => reason._tag);
  }
}

export effect function main() {
  return {
    caught: try caught(),
    defect: reasons(try exit(defect())),
    combined: reasons(try exit(combined())),
    escaped: reasons(try exit(fail())),
    value: value()
  }
}
