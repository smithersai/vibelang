// Chapter 4. Dependency injection: the R channel.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}
class MailError extends TaggedError("MailError")<{ readonly reason: string }> {}
class DbError extends TaggedError("DbError")<{ readonly reason: string }> {}
class ConnectError extends TaggedError("ConnectError")<{ readonly url: string }> {}

interface User {
  id: string
  name: string
  email: string
}

interface Row {
  id: string
  name: string
  email: string
}

// Declaring a service

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
  abstract rename(id: string, name: string): Effect<void, UserNotFound, never>
}

const outbox: string[] = []

// D1's static layer idiom: the provider lives on the service class.
abstract class Mailer {
  abstract send(to: string, body: string): Effect<void, MailError, never>

  static readonly layer = Layer.succeed(Mailer, {
    send: effect (to, body) => {
      outbox.push(`${to}: ${body}`)
    }
  })
}

abstract class Database {
  abstract query(sql: string, params: ReadonlyArray<string>): Effect<ReadonlyArray<Row>, DbError, never>
  abstract execute(sql: string, params: ReadonlyArray<string>): Effect<void, DbError, never>
}

abstract class Config {
  abstract readonly url: string
}

// Using a service: Settings() gives the implementation, for value members

abstract class Settings {
  abstract readonly baseUrl: string
  abstract scale(): Effect<number, never, never>
}

effect function apiUrl(path: string) {
  return `${(try Settings()).baseUrl}/${path}`
}
// Effect<string, never, Settings>

effect function welcome(id: string) {
  const user = try Users.find(id)
  try Mailer.send(user.email, `Welcome, ${user.name}!`)
  return user.name
}
// Effect<string, UserNotFound | MailError, Users | Mailer>

function toUser(row: Row) {
  const user: User = { id: row.id, name: row.name, email: row.email }
  return user
}

// Writing a provider (the version without Effect.orDie is ch04-provider-escapes.fail.vibe)

const UsersLive = Layer.effect(Users, effect {
  const db = try Database()              // runs once, when the layer is built
  return {
    effect find(id) {
      const rows = try Effect.orDie(effect { return try db.query("select * from users where id = $1", [id]) })
      if (rows.length === 0) throw new UserNotFound({ id })
      return toUser(rows[0])
    },
    effect rename(id, name) {
      try Effect.orDie(effect { return try db.execute("update users set name = $1 where id = $2", [name, id]) })
    }
  }
})
// Layer<Users, never, Database>

// Providers that hold resources

interface Pool {
  query(sql: string, params: ReadonlyArray<string>): Effect<ReadonlyArray<Row>, DbError, never>
  execute(sql: string, params: ReadonlyArray<string>): Effect<void, DbError, never>
}

const table = new Map<string, Row>([["1", { id: "1", name: "Ada", email: "ada@example.com" }]])
const poolEvents: string[] = []

function memoryPool() {
  const pool: Pool = {
    query: effect (sql, params) => {
      const row = table.get(params[0])
      return row === undefined ? [] : [row]
    },
    execute: effect (sql, params) => {
      const row = table.get(params[1])
      if (row !== undefined) table.set(row.id, { ...row, name: params[0] })
    }
  }
  return pool
}

// NOTE: the proposal's `Postgres.connect` is an unspecified library function returning
// Effect<Pool, ConnectError, Scope>; it is modeled as an object holding a .vibe function.
effect function connect(url: string) {
  if (url.length === 0) throw new ConnectError({ url })
  return try Effect.acquireRelease(
    effect {
      poolEvents.push(`open ${url}`)
      return memoryPool()
    },
    effect () => {
      poolEvents.push(`close ${url}`)
    }
  )
}

const Postgres = { connect }

const DatabaseLive = Layer.effect(Database, effect {
  const pool = try Postgres.connect((try Config()).url)    // no `using`: the pool lives as long as the layer
  return {
    query: effect (sql, params) => try pool.query(sql, params),
    execute: effect (sql, params) => try pool.execute(sql, params)
  }
})
// Layer<Database, ConnectError, Config>

// Requirements that would leak: see ch04-users-audited.fail.vibe (EK3101).

// Composing an application
// NOTE: the proposal composes with `wire` (Proposed); ch04-wire.vibe exercises it. This file uses
// Effect's Layer functions through the pipe built-in applied to plain data.

const ConfigLive = Layer.succeed(Config, { url: "postgres://test" })

const AppLive = pipe(
  Layer.mergeAll(UsersLive, Mailer.layer),
  Layer.provideMerge(DatabaseLive),
  Layer.provideMerge(ConfigLive)
)

// Testing with fake services

const UsersTest = Layer.succeed(Users, {
  find: effect (id) => ({ id, name: "Ada", email: "ada@example.com" }),
  rename: effect () => {}
})

effect function welcomeQuietly(id: string) {
  return try Effect.provideService(effect { return try welcome(id) }, Mailer, { send: effect () => {} })
}

effect function renameAndWelcomeQuietly() {
  try Users.rename("1", "Augusta")
  const renamed = (try Users.find("1")).name
  const quiet = try welcomeQuietly("1")
  return { renamed, quiet }
}

// Running with providers: each Effect.provide builds its layers once (D21), so the pool opens
// and closes once per provide.
// expect-result: {"name":"Ada","renamed":"Augusta","quiet":"Augusta","test":"Ada","url":"https://api.example.com/users","scale":3,"outbox":["ada@example.com: Welcome, Ada!","ada@example.com: Welcome, Ada!"],"poolEvents":["open postgres://test","close postgres://test","open postgres://test","close postgres://test"]}
export effect function main() {
  const name = try Effect.provide(effect { return try welcome("1") }, AppLive)
  const after = try Effect.provide(effect { return try renameAndWelcomeQuietly() }, AppLive)
  const test = try Effect.provide(effect { return try welcome("42") }, Layer.mergeAll(UsersTest, Mailer.layer))
  const url = try Effect.provideService(effect { return try apiUrl("users") }, Settings, {
    baseUrl: "https://api.example.com",
    scale: effect () => 3
  })
  const scale = try Effect.provideService(effect { return try Settings.scale() }, Settings, { baseUrl: "unused", scale: effect () => 3 })
  return { name, renamed: after.renamed, quiet: after.quiet, test, url, scale, outbox, poolEvents }
}
