import { Effect, Layer } from "effect"
service Counter { static readonly key="coverage/Memo"; value:number }
let built=0,released=0
const Live=Layer.effect(Counter,Effect.acquireRelease(Effect.sync(()=>({value:++built})),()=>Effect.sync(()=>{released++})))
export effect function main() {
 const values:number[]=[]
 provide Live {
  values.push((try Counter).value)
  provide Live { values.push((try Counter).value) }
 }
 provide Live { values.push((try Counter).value) }
 return {values,built,released}
}

