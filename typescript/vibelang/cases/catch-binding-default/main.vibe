// A catch binding's defaults run in the handler, after the try block, so a
// failure one raises escapes the try statement and joins the function's E
// (D13), as a failure of the catch block does. Its declaration says so.
export error Fallback

effect function fallback(): number!Fallback! { throw new Fallback() }

export effect function read(found?: number) {
  return effect {
    throw { id: found } as { id?: number }
  } catch effect (error) => {
    let { id = try fallback() } = error
    return id
  }
}

// expect-result: {"missing":"Fallback","found":7}
export effect function main() {
  return { missing: read() catch (e) => e._tag, found: try read(7) }
}
