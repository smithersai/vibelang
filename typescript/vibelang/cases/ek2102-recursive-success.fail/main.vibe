// expect: EK9206
// When an Effect function's A depends on its own result, TypeScript cannot
// infer A, and the contract must be written (D52). The functions throw, so
// they are Effects; a plain annotation such as : boolean would be EK9203.
class Negative extends TaggedError("Negative")<{ readonly n: number }> {}

export effect function isEven(n: number) {
  if (n < 0) throw new Negative({ n })
  if (n === 0) return true
  return try isOdd(n - 1)
}

export effect function isOdd(n: number) {
  if (n === 0) return false
  return try isEven(n - 1)
}

export effect function countDown(n: number) {
  if (n < 0) throw new Negative({ n })
  if (n === 0) return 0
  return try countDown(n - 1) + 1
}

// A pure function keeps TypeScript's rules: it compiles to plain JavaScript,
// and a plain annotation is allowed (D67).
export function depth(n: number): number {
  return n === 0 ? 0 : depth(n - 1) + 1
}
