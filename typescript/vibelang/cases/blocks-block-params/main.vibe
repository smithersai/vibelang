// expect-result: {"spanned":"ADA","timed":"in time","guarded":"guarded","appended":42,"method":"job:done","bare":"once","nested":"outer:inner"}
effect function getName(): string!! {
  return "Ada"
}

// An Effect dual takes its program first, or returns a function that takes
// it, so its program is an arrow: a block is the call's last argument (D376).
effect function spanned() {
  return try withSpan(effect {
    const name = try getName()
    return name.toUpperCase()
  }, "load")
}

effect function timed() {
  return try timeout(effect {
    try sleep("1 millis")
    return "in time"
  }, "1 second")
}

effect function guarded() {
  const semaphore = try Semaphore.make(1)
  return try semaphore.withPermits(1)(effect {
    return "guarded"
  })
}

// A function that takes the program as its last argument gets the block there.
effect function twice(label: string, program: () => number!!) {
  return label.length + try program() + try program()
}

effect function appended() {
  return try twice("abcd") {
    return 19
  }
}

class Runner {
  effect run(name: string, program: () => string!!) {
    return `${name}:${try program()}`
  }
}

effect function method() {
  const runner = new Runner()
  return try runner.run("job") {
    return "done"
  }
}

// A name followed by a block passes the block as the only argument.
effect function once(program: () => string!!) {
  return try program()
}

effect function bare() {
  return try once {
    return "once"
  }
}

effect function nested() {
  return try (runnerOf()).run("outer") {
    return try once { return "inner" }
  }
}

function runnerOf() {
  return new Runner()
}

export effect function main() {
  return { spanned: try spanned(), timed: try timed(), guarded: try guarded(), appended: try appended(), method: try method(), bare: try bare(), nested: try nested() }
}
