// expect: TS2322 EK2001
// A service's static default is an implementation of the service (D40), so
// it is checked as Layer.succeed's value is: against the service's shape,
// with each member's contract. Without a type annotation it has the
// service's type; with one, the annotation must fit the service.
export service Flags {
  enabled: boolean
  static readonly defaultValue = () => ({ enabled: "not a boolean" })
}

export service Prefix: string {
  static readonly defaultValue = () => 42
}

export service Version: number {
  static readonly defaultValue: () => string = () => "4"
}

export service Reader {
  read(): string!!
  static readonly defaultValue = () => ({
    effect read() {
      throw "hidden"
    }
  })
}

export effect function flag(): boolean!! {
  return (try Flags()).enabled
}

export effect function prefix(): string!! {
  return try Prefix()
}

export effect function version(): number!! {
  return try Version()
}

export effect function read(): string!! {
  return try Reader.read()
}
