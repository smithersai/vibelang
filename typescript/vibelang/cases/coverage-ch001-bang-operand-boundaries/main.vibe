export type Required = number!{ reason: string }!{ service: number }
export type Optional = number!!({ service: number })
export type Negative = number!!-1
type as = { service: number }
type satisfies = { other: string }
export type Named = number!!as
export type Other = number!string!satisfies
export function f(x: unknown) {
 const a = x as number!! as unknown
 const b = x as number!! satisfies unknown
 const c = x as number!!as satisfies unknown
 const d = x as number!![0]
 return [a, b, c, d]
}

export {}

