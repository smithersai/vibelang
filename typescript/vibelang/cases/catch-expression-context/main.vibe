// expect-result: {"select":["Found","Error"],"fallback":["Some","None"],"declared":"Error","argument":"Found","block":"Error","chained":["first","second","last"],"mode":"slow"}
export error Missing { code: string }

type Outcome = { _tag: "Found"; value: number } | { _tag: "Error"; error: Missing }
type Maybe = { _tag: "Some"; value: number } | { _tag: "None" }
type Mode = "fast" | "slow"

effect function find(n: number): number!Missing {
  if (n < 0) throw new Missing({ code: "negative" })
  return n
}

effect function found(n: number): { _tag: "Found"; value: number }!Missing {
  return { _tag: "Found", value: try find(n) }
}

effect function some(n: number): { _tag: "Some"; value: number }!Missing {
  return { _tag: "Some", value: try find(n) }
}

// D293: a catch expression's handler takes the expression's contextual type,
// as a conditional's branches do, so literal tags stay literal. The left side
// is an Effect (VIP-5), whose success type its function declares.
effect function select(n: number): Outcome!! {
  return found(n) catch (error) => ({ _tag: "Error", error })
}

effect function fallback(n: number): Maybe!! {
  return some(n) catch () => ({ _tag: "None" })
}

effect function declared(n: number) {
  const outcome: Outcome = found(n) catch (error) => ({ _tag: "Error", error })
  return outcome._tag
}

function report(outcome: Outcome): string {
  return outcome._tag
}

effect function block(n: number): Outcome!! {
  return found(n) catch (error) => {
    const failed: Missing = error
    return { _tag: "Error", error: failed }
  }
}

effect function step(label: "first" | "second", n: number): ("first" | "second")!Missing {
  if (n < 0) throw new Missing({ code: label })
  return label
}

effect function chained(a: number, b: number): ("first" | "second" | "last")!! {
  return (step("first", a) catch effect () => try step("second", b)) catch () => "last"
}

effect function mode(n: number): Mode!! {
  return (effect { return (try find(n)) > 10 ? "fast" : "slow" }) catch () => "slow"
}

export effect function main() {
  return {
    select: [(try select(1))._tag, (try select(-1))._tag],
    fallback: [(try fallback(1))._tag, (try fallback(-1))._tag],
    declared: try declared(-1),
    argument: report(found(2) catch (error) => ({ _tag: "Error", error })),
    block: (try block(-1))._tag,
    chained: [try chained(1, 1), try chained(-1, 1), try chained(-1, -1)],
    mode: try mode(-1)
  }
}
