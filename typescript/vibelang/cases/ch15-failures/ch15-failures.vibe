// Chapter 15. Failures, defects, interruption, and cleanup.
import { Exit, Scope } from "effect"

class UploadError extends TaggedError("UploadError")<{ readonly file: string }> {}
class Expected extends TaggedError("Expected")<{}> {}

interface TempFile {
  name: string
  write(row: string): Effect<void, never, never>
}

interface Account {
  id: string
}

service TempFiles {
  create(): Effect<TempFile, never, Scope.Scope>
}

service Reports {
  rows(id: string): Effect<ReadonlyArray<string>, never, never>
}

service Storage {
  upload(file: TempFile): Effect<string, UploadError, never>
  queueRetry(id: string): Effect<string, never, never>
}

service Metrics {
  increment(name: string): Effect<void, never, never>
}

service Ledger {
  debit(account: Account, amount: number): Effect<void, never, never>
  credit(account: Account, amount: number): Effect<void, never, never>
}

const events: string[] = []
let tempFiles = 0
let uploadDelay = 0
let uploadFails = false

// NOTE: writeRows is unspecified in the proposal; it writes each row to the temporary file.
effect function writeRows(file: TempFile, rows: ReadonlyArray<string>) {
  for (const row of rows) try file.write(row)
}

effect function exportReport(id: string) {
  using tmp = try TempFiles.create()
  try {
    try writeRows(tmp, try Reports.rows(id))
    return try Storage.upload(tmp)
  } catch (e) {                    // e: UploadError
    return try Storage.queueRetry(id)
  } finally {
    try Metrics.increment("exports")
  }
}

effect function exportWithDeadline(id: string) {
  return try Effect.timeout(effect { return try exportReport(id) }, "30 seconds")
}

// NOTE: the same deadline at 10 millis, so the run interrupts a slow upload quickly.
effect function exportWithShortDeadline(id: string) {
  return try Effect.timeout(effect { return try exportReport(id) }, "10 millis")
}

// A defect is not caught by catch (D13): a JavaScript TypeError is a defect.
function defectThroughCatch() {
  try {
    const broken: any = undefined
    return broken.name
  } catch (e) {
    events.push("catch saw a defect")      // must not run
    return "caught"
  }
}

// Codex review R1 / D13: a cause holding both an expected failure and a defect is not caught.
effect function mixedCause() {
  try {
    try {
      throw new Expected()
    } finally {
      try Effect.die("release-defect")
    }
  } catch (e) {
    events.push("catch saw a mixed cause")  // must not run
    return "recovered"
  }
}

effect function moveFunds(from: Account, to: Account, amount: number) {
  try Effect.uninterruptible(effect {
    try Ledger.debit(from, amount)
    try Ledger.credit(to, amount)     // an interruption waits until both have run
  })
}

const TempFilesTest = Layer.succeed(TempFiles, {
  create: effect () => try Effect.acquireRelease(
    effect {
      tempFiles++
      const name = `tmp${tempFiles}`
      events.push(`create ${name}`)
      const file: TempFile = {
        name,
        write: effect (row) => {
          events.push(`write ${name} ${row}`)
        }
      }
      return file
    },
    effect (file) => {
      events.push(`remove ${file.name}`)
    }
  )
})

const ReportsTest = Layer.succeed(Reports, {
  rows: effect (id) => ["a"]
})

const StorageTest = Layer.succeed(Storage, {
  upload: effect (file) => {
    try Effect.sleep(uploadDelay)
    if (uploadFails) throw new UploadError({ file: file.name })
    events.push(`upload ${file.name}`)
    return `uploaded ${file.name}`
  },
  queueRetry: effect (id) => {
    events.push(`queue ${id}`)
    return `queued ${id}`
  }
})

const MetricsTest = Layer.succeed(Metrics, {
  increment: effect (name) => {
    events.push(`metric ${name}`)
  }
})

const LedgerTest = Layer.succeed(Ledger, {
  debit: effect (account, amount) => {
    try Effect.sleep("20 millis")
    events.push(`debit ${account.id} ${amount}`)
  },
  credit: effect (account, amount) => {
    events.push(`credit ${account.id} ${amount}`)
  }
})

effect function scenario() {
  const first = try exportReport("r1")
  uploadFails = true
  const second = try exportReport("r2")
  uploadFails = false
  uploadDelay = 50
  let third = "none"
  try {
    try exportWithShortDeadline("r3")
  } catch (e) {
    third = e._tag
  }
  uploadDelay = 0
  const deadline = try exportWithDeadline("r4")
  const defect = try Effect.exit(effect { return try defectThroughCatch() })
  const mixed = try Effect.exit(effect { return try mixedCause() })
  let moved = "none"
  try {
    try Effect.timeout(effect { return try moveFunds({ id: "a" }, { id: "b" }, 10) }, "5 millis")
  } catch (e) {
    moved = e._tag
  }
  return {
    first,
    second,
    third,
    deadline,
    defect: Exit.isFailure(defect) ? (defect.cause.reasons as ReadonlyArray<(typeof defect.cause.reasons)[number]>).map((reason) => reason._tag) : ["Success"],
    mixed: Exit.isFailure(mixed) ? (mixed.cause.reasons as ReadonlyArray<(typeof mixed.cause.reasons)[number]>).map((reason) => reason._tag) : ["Success"],
    moved,
    events
  }
}

// expect-result: {"first":"uploaded tmp1","second":"queued r2","third":"TimeoutError","deadline":"uploaded tmp4","defect":["Die"],"mixed":["Die","Die"],"moved":"TimeoutError","events":["create tmp1","write tmp1 a","upload tmp1","metric exports","remove tmp1","create tmp2","write tmp2 a","queue r2","metric exports","remove tmp2","create tmp3","write tmp3 a","metric exports","remove tmp3","create tmp4","write tmp4 a","upload tmp4","metric exports","remove tmp4","debit a 10","credit b 10"]}
export effect function main() {
  return try Effect.provide(
    effect { return try scenario() },
    Layer.mergeAll(TempFilesTest, ReportsTest, StorageTest, MetricsTest, LedgerTest)
  )
}
