// An Effect method's body runs in a generator, and so do an Effect arrow's
// body and a try block's regions. JavaScript binds super and arguments
// afresh in a generator, so the lowering reads the enclosing method's own:
// super keeps the method's receiver, and arguments its call's arguments.

// An error family (D278, D304) whose subclass calls its base's method.
error Base {
  _tag: string
  code: number
  describe() {
    try Console.log("base describe")
    return `code ${this.code}`
  }
}
error Sub extends Base {
  describe() {
    const text = try super.describe()
    try Console.log("sub describe")
    return `sub ${text}`
  }
}

class Shape {
  name() {
    try Console.log("shape name")
    return "shape"
  }
  get kind() { return "plain" }
  sizeValue = 1
  get size() { return this.sizeValue }
  set size(value: number) { this.sizeValue = value }
  static make() {
    try Console.log("shape make")
    return "made"
  }
}

class Square extends Shape {
  name() {
    const base = try super.name()
    try Console.log("square name")
    return `${base}/square/${super.kind}/${super["kind"]}`
  }
  static make() {
    try Console.log("square make")
    return `${try super.make()}+square`
  }
  // super in an Effect arrow inside a plain method.
  later() {
    return () => {
      try Console.log("later")
      return try super.name()
    }
  }
  // Assignments to a super accessor: plain, compound and logical.
  grow() {
    try Console.log("grow")
    super.size = 2
    super.size += 3
    super.size ||= 9
    return this.size
  }
  // super in try and finally regions.
  guarded() {
    try {
      try Console.log("guarded")
      return try super.name()
    } finally {
      try Console.log(super.kind)
    }
  }
}

class Counter {
  count(a: number, b?: number) {
    try Console.log("count")
    return arguments.length
  }
  counted(a: number) {
    try {
      try Console.log("counted")
      return arguments.length
    } finally {
      try Console.log("counted done")
    }
  }
}

// arguments in an Effect arrow inside a function expression.
const outer = function (a: number, b: number) {
  const inner = () => {
    try Console.log("inner")
    return arguments.length
  }
  return try inner()
}

// An Effect function declaration's generator already gets its arguments.
function declared(a: number, b: number, c: number) {
  try Console.log("declared")
  return arguments.length
}

// expect-result: {"sub":"sub code 7","square":"shape/square/plain/plain","make":"made+square","later":"shape","grow":5,"guarded":"shape","count":2,"counted":1,"outer":2,"declared":3}
export function main() {
  const square = new Square()
  const later = try square.later()
  return {
    sub: try new Sub({ code: 7 }).describe(),
    square: try square.name(),
    make: try Square.make(),
    later: try later(),
    grow: try square.grow(),
    guarded: try square.guarded(),
    count: try new Counter().count(1, 2),
    counted: try new Counter().counted(1),
    outer: try outer(1, 2),
    declared: try declared(1, 2, 3)
  }
}
