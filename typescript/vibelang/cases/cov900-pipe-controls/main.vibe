export effect function main() {
 const left = 2 |> % + 1 |> % * 2
 const captured = 7 |> (effect () => %)
 const closed = Effect.succeed(5) |> % catch () => { return 0 } |> % + 1
 const grouped = (Effect.succeed(5) |> % catch () => 0) |> % + 1
 return [left,try captured(),closed,grouped,1 |> % + 2]
}
