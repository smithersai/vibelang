import * as $nativeTryEffect from "effect/Effect";
// Effectful callbacks can take their debug names from reserved or quoted keys.
error Busy { attempt: number }

effect function retryWhileBusy() {
  let attempts = 0
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try retry(effect {
      attempts++
      throw new Busy({ attempt: attempts })
    }, {
      times: 5,
      while: effect (error): boolean!! => {
        try sleep("1 millis")
        return error.attempt < 3
      }
    })) };
  }, effect (error) => {
    return { kind: "return:" as const, value: (attempts) };
  });
return $nativeTryCompletion.value;
}
}

// expect-result: {"attempts":3,"reserved":2,"quoted":3,"strict":4,"generator":5,"named":"async"}
export effect function main() {
  const named = effect function async() {
    try sleep("1 millis")
    return async.name
  }
  const handlers = {
    default: effect (n: number) => { try sleep("1 millis"); return n + 1 },
    "not-an-identifier": effect (n: number) => { try sleep("1 millis"); return n + 2 },
    arguments: effect (n: number) => { try sleep("1 millis"); return n + 3 },
    yield: effect (n: number) => { try sleep("1 millis"); return n + 4 }
  }
  return {
    attempts: try retryWhileBusy(),
    reserved: try handlers.default(1),
    quoted: try handlers["not-an-identifier"](1),
    strict: try handlers.arguments(1),
    generator: try handlers.yield(1),
    named: try named()
  }
}
