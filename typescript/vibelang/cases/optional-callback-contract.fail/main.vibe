// expect: EK9201 EK9202
// An optional call of an Effect callback runs the callback, as a required call
// does, so the channels its type declares reach the contract (D500).
export error Late { label: string }

export const coalesced = effect <E, R>(label?: (seconds: number) => Late!E!R): Late!! => {
  return try label?.(2) ?? new Late({ label: "default" })
}

export effect function announced<E, R>(log?: (n: number) => void!E!R): boolean!! {
  try log?.(2)
  return true
}
