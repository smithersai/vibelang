// VIP-6 qualified-collisions-and-JavaScript-undefined
import * as Native from "effect"
export const collisions=[
Effect.catch===Native.Effect.catch,
Effect.interruptible===Native.Effect.interruptible,
Effect.let===Native.Effect.let,
Effect.match===Native.Effect.match,
Effect.provide===Native.Effect.provide,
Effect.service===Native.Effect.service,
Effect.try===Native.Effect.try,
Effect.undefined===Native.Effect.undefined,
Effect.uninterruptible===Native.Effect.uninterruptible,
Effect.void===Native.Effect.void,
Effect.when===Native.Effect.when
]
export effect function main(){const empty:undefined=undefined;return [collisions,empty===undefined]}
