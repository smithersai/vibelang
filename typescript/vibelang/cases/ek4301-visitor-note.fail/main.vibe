// expect: EK0501
// A plain callback cannot use try (EK0501). Passing an effect function as
// data to forEach is native-compatible and drops its program (VIP-1/detail303).
import { Effect } from "effect"
const visit = <A>(callback: () => A): A => callback()
effect function work() { return try Effect.succeed(1) }
export function main() {
  const used = visit(() => try work())
  ;[1].forEach(work)
  return used
}
