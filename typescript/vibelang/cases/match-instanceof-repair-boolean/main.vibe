import { Effect, Match } from "effect"
export function choose(value: unknown): string {
  return Match.value(value).pipe(
    Match.when(Match.instanceOf(Boolean), (): string => "hit"),
    Match.orElse((): string => "miss"))
}
export function main() { return Effect.succeed([true, new Boolean(true), false, new Boolean(false), 7, null].map(choose)) }
