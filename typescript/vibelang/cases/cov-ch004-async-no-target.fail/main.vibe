// expect: TS1107
// Chapter 004, async-no-target: docs/design/src/004-match.md#bdc802fca3013f43
export function nope() { return async match (true) { default: do { break }; } }

// Chapter 004 rule: Ownership and targets come from the source, not from the generated async function; a `break` or `continue` with no target anywhere keeps TypeScript's own error.

// Stock TypeScript 5.9.3 reports TS1107 for both a plain function's targetless break and its async-arrow twin.
