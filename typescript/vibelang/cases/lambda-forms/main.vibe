// A lambda takes the form the overload candidate under check declares
// (design D56): a plain function, an Effect function, or a program. The first
// candidate that accepts it in that form wins, as TypeScript's first-applicable
// rule says.
import { Effect } from "effect"
import { apply, attach, find, register, start } from "./helpers.ts"

// No call in the body: overload 1 accepts the plain form.
function plainBody() {
  return register((x): number => x + 1)
}

// A plain call: still overload 1.
function plainCall() {
  return register((x): number => Math.max(x, 0))
}

// The body runs an Effect, which a plain function cannot do, so overload 1
// rejects the lambda and overload 2 accepts it as an Effect function.
effect function effectCall() {
  return try register(effect (x): number!! => (try find(String(x))).id.length)
}

// The Effect callback comes first, so it wins even for a body with no call.
effect function effectFirst() {
  return try attach(effect (x): number!! => x + 1)
}

// A program comes first: firstProgram, a lambda with no parameters, is a
// program because its annotation is an Effect.
effect function programFirst() {
  return try start(firstProgram)
}

// No expected type: the lambda's plain annotation makes it plain (D500).
function bare() {
  const f = apply((x: number): number => Math.max(x, 0))
  return f(-3)
}

// No expected type and a body that runs an Effect: an Effect function.
effect function bareEffect() {
  const f = apply(effect (id: string): string!! => (try find(id)).id)
  return try f("z")
}

// A lambda a function returns has no expected type: an Effect function (D500),
// which the caller runs where it calls it.
effect function returned(n: number) {
  try Effect.sleep("1 millis")
  return effect (x: number) => Math.max(x, n)
}

// Array.prototype.map declares a plain callback; Effect.forEach an Effect one.
effect function traversals(ids: ReadonlyArray<string>) {
  const trimmed = ids.map((id) => id.trim())
  const found = try Effect.forEach(trimmed, effect (id) => (try find(id)).id)
  return found.join("")
}

const firstProgram: number!! = effect { return Math.max(1, 2) }

// expect-result: {"plainBody":"plain 2","plainCall":"plain 1","effectCall":"effect 1","effectFirst":"effect 2","programFirst":"program 2","bare":0,"bareEffect":"z","traversals":"ab","returned":5}
export effect function main() {
  return {
    plainBody: plainBody(),
    plainCall: plainCall(),
    effectCall: try effectCall(),
    effectFirst: try effectFirst(),
    programFirst: try programFirst(),
    bare: bare(),
    bareEffect: try bareEffect(),
    traversals: try traversals([" a", "b "]),
    returned: try (try returned(5))(3)
  }
}
