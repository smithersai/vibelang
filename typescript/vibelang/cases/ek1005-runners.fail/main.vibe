// expect: EK1005
// D38: a runner may be called only where no fiber runs the code: at the
// module's top level, and in a plain callback that such a place passes to a
// TypeScript function. Anywhere else it is EK1005.
import { Context, Effect, Layer, ManagedRuntime } from "effect"
import { NodeRuntime } from "@effect/platform-node"
import { describe, it, layer } from "@effect/vitest"
import { onRequest } from "./server.ts"

effect function refresh(id: string) {
  try Effect.sleep("1 millis")
  return id
}

function refreshAll(ids: ReadonlyArray<string>) {
  for (const id of ids) Effect.runFork(effect { return try refresh(id) })
}

const runtime = ManagedRuntime.make(Layer.empty)

function viaRuntime() {
  return runtime.runPromise(effect { return try refresh("r") })
}

function withContext() {
  return Effect.runSyncWith(Context.empty())(effect { return try refresh("w") })
}

function nestedMain() {
  NodeRuntime.runMain(effect { return try refresh("m") })
}

const handlers: unknown[] = []

function register(f: () => void): void {
  handlers.push(f)
}

register(() => {
  Effect.runFork(effect { return try refresh("e") })
})

it.effect("a test", effect () => {
  it.effect("nested", effect () => try refresh("n"))
  return try refresh("t")
})

// A runner bound to the fiber's services is a value: building one starts
// nothing, so a fiber may hand it to a callback host. Applying it starts a
// root.
effect function bridge() {
  return Effect.runPromiseWith(try Effect.context<never>())
}

effect function boundRunner() {
  const run = Effect.runPromiseWith(try Effect.context<never>())
  return run(effect { return try refresh("b") })
}

// Allowed: the module's top level, and plain callbacks passed from there to
// TypeScript functions.
Effect.runFork(effect { return try refresh("top") })
NodeRuntime.runMain(effect { return try refresh("main") })
onRequest(() => {
  Effect.runFork(effect { return try refresh("request") })
})
describe("suite", () => {
  it.effect("works", effect () => try refresh("ok"))
  it.effect.each([1, 2])("each", effect (n) => try refresh(String(n)))
})
layer(Layer.empty)("with a layer", (it) => {
  it.effect("works", effect () => try refresh("layer"))
})
