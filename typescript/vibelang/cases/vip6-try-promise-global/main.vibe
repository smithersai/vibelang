// VIP-6: tryPromise is a global, Effect.tryPromise with no prefix, no import.
// Its arrow captures locals as in Effect TypeScript; a local shadows the global.
import { queryDb } from "./helper.ts"

effect function shadowed() {
  const tryPromise = (text: string) => `local ${text}`
  return tryPromise("x")
}

effect function load(q: string) {
  return try tryPromise((signal) => queryDb(q, { signal }))
}

// expect-result: {"row":"row a true","failed":"Rejected","shadow":"local x","retried":"row b false"}
export effect function main() {
  const row = try load("a")
  const failed = load("bad") catch () => "Rejected"
  const retried = try retry(tryPromise(() => queryDb("b")), { times: 1 })
  return { row, failed, shadow: try shadowed(), retried }
}
// Chapter 900: follow tracked throws contracts and wrap - spec-rule: docs/design/src/900-appendices.md#638e7327cd5bd7d0
