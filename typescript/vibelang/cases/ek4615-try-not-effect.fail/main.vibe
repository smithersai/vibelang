// expect: EK0502 EK0502 TS2769
// try runs an Effect (VIP-5): before a plain call or a value that is not an
// Effect, it runs nothing (EK0502). A try in an argument runs there, as await
// does: no argument is passed by name (VIP-1, D147 retired), so retry gets
// sleep's void (TS2769).
function plain(n: number) {
  return n + 1
}

export effect function main() {
  try yieldNow()
  const a = try plain(1)
  const b = try 42
  const c = try retry(try sleep("1 millis"), Schedule.recurs(1))
  return [a, b, c]
}
