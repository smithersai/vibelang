// The equivalent explicit namespace imports keep TypeScript's meaning: a
// namespace used as a type is TS2709 and an absent namespace member is
// TS2339, as tsc reports for the same .ts source. No EK code is involved.
import { FileSystem, Option, Scope } from "effect"

export type Maybe = Option<number>

export function scoped(scope: Scope): number {
  return 1
}

export const make = FileSystem.of
