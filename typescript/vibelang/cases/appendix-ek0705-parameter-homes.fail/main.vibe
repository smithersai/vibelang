// expect: EK0705
// Appendix B: EK4703 successor, accepted binding homes follow the chapter and formal/catch parameter restrictions use EK0705 — spec-rule: docs/design/src/900-appendices.md#15e5342f210b2816
function work() {}
function consume(value: boolean) { return value }

// Formal and catch parameter initialization: EK0705.
export function bad(a = (1 is let captured)) { return a }
export function nested({ a = (1 is const captured) } = {}) { return a }
export function key({ [(1 is let captured) ? "x" : "y"]: value }: { x?: number; y?: number } = {}) { return value }
export function caught() { try { work() } catch ({ code = (1 is let c) }: any) { return code } }

// Accepted homes: a binding-free test, an explicit block or arm, a nested body, a caller's block.
export function testOnly(a = (1 is 1)) { return a }
export function good(a = do { const ok = 1 is let captured; [ok, captured] }) { return a }
export function body(a = () => (1 is let captured)) { return a }
export function caller() { consume(1 is let captured); return captured }
