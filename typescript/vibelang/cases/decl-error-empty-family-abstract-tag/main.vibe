// expect-result: ["Sub","x","Sub","x","Sub","y",7]
import { TaggedError, $errorSubclass, type $ErrorArgs } from "vibelang-runtime"
abstract class Base extends TaggedError("Base" as string)<{ readonly _tag: string }> {}
class Sub extends $errorSubclass(Base, "Sub") {
    declare readonly _tag: "Sub"
    declare readonly who: string
    declare readonly count?: number
  constructor(args: $ErrorArgs<typeof Base, Pick<Sub, "who" | "count">>) {
    super()
    this["who"] = args["who"]
    this["count"] = args["count"]
  }
}
effect function fail(): never!Sub { throw new Sub({ who: "x" }) }
export effect function main() {
  const sub = new Sub({ who: "x" })
  const input = { who: "y", count: 7, _tag: "spoof" }
  const extra = new Sub(input)
  try Console.log(sub._tag, sub.who)
  try { try fail() } catch (e) {
    try Console.log(e._tag, e.who)
    return [sub._tag, sub.who, e._tag, e.who, extra._tag, extra.who, extra.count]
  }
}
