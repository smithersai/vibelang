// expect: EK4201
// try.all, try.allSettled and an unbounded all start each element in its
// own fiber (D196), which cannot reach a handler on this one (chapter 9,
// "Handlers and concurrency"). EK4201 reports each element that performs the
// operation.
control Ask { ask(): number!! }

effect function asks() {
  return try Ask.ask() + 1
}

export effect function both() {
  try {
    return try.all [Ask.ask(), Ask.ask()]
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function keyed() {
  try {
    return try all({ first: asks(), second: Ask.ask() }, { concurrency: "unbounded" })
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function settled() {
  try {
    return try.allSettled [Ask.ask()]
  } handle Ask.ask() {
    try resume(1)
  }
}
