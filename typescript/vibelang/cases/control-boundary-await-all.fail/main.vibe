// expect: EK4201
// await.all and await.allSettled start each element in its own fiber
// (D196), which cannot reach a handler on this one (chapter 9, "Handlers and
// concurrency"). EK4201 reports each element that performs the operation.
control Ask { ask(): number!! }

effect function asks() {
  return try Ask.ask() + 1
}

export effect function all() {
  try {
    return await.all [Ask.ask(), Ask.ask()]
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function keyed() {
  try {
    return await.all { first: asks(), second: Ask.ask() }
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function settled() {
  try {
    return await.allSettled [Ask.ask()]
  } handle Ask.ask() {
    try resume(1)
  }
}
