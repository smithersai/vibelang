export class Counter {
  constructor(readonly offset: number) {}
  compact(n: number): Effect<number, never, never> { return ++n + this.offset }
  expanded(n: number): Effect<number, never, never> {
    const result = ++n
    return result + this.offset
  }
  static compound(n: number): Effect<number, never, never> {
    n += 1
    return n
  }
  assignment(n: number): Effect<number, never, never> {
    n = n + 1
    return n + this.offset
  }
  destructured({ n }: { n: number }): Effect<number, never, never> {
    const result = ++n
    return result
  }
  redeclared(n: number): Effect<number, never, never> {
    var n = n + 1
    return n
  }
  argumentsRead(n: number): Effect<number, never, never> {
    n += 1
    return n + arguments.length
  }
  #increment(n: number): Effect<number, never, never> { return ++n }
  get operation() { return this.#increment }
  privateRead(n: number): Effect<number, never, never> { return try this.#increment(n) }
  loop(n: number): Effect<number, never, never> {
    let before = n
    for (n of [2]) {}
    return before + n
  }
}
export const object = {
  read(n: number): Effect<number, never, never> {
    const result = ++n
    return result
  }
}
export const nested = (n: number): Effect<number, never, never> => [0].map(() => ++n)[0]!
export const destructuringAssignment = (n: number): Effect<number, never, never> => ([n] = [n + 1], n)
export const objectAssignment = (n: number): Effect<number, never, never> => ({ n } = { n: n + 1 }, n)
export const postfix = (n: number): Effect<number, never, never> => n++
export const logical = (n: number): Effect<number, never, never> => (n ||= 2, n++)
export class Base {
  read(n: number): Effect<number, never, never> { return n }
}
export class Derived extends Base {
  read(n: number): Effect<number, never, never> {
    n += 1
    return try super.read(n)
  }
}
