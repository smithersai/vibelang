// expect: TS2322
// D351: the written success type is H even without a dependent return.
control Step { next(): void!! }

export effect function resumeWritten(): number | string!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    const n: number = try resume()
    return n
  }
}

export effect function resumeWithWritten(): number | string!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    const n: number = try resumeWith(effect { return undefined })
    return n
  }
}

// Every ordinary return still has to fit the written success type.
export effect function invalidTry(): number!! {
  try {
    try Step.next()
    return "bad"
  } handle Step.next() {
    try resume()
  }
}

export effect function invalidClause(): number!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    return "bad"
  }
}

// Normal completion of the try block adds undefined to the written H.
export effect function fallthroughWritten(): number!! {
  try {
    try Step.next()
  } handle Step.next() {
    const n: number = try resume()
    n.toFixed(0)
  }
  return 1
}

// A clause that can stop without resuming also adds undefined to H.
export effect function stopWritten(stop: boolean): number!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    if (!stop) {
      const n: number = try resume()
      n.toFixed(0)
    }
  }
  return 2
}

// Non-return jumps from the try block have the same rule.
export effect function breakWritten(): number!! {
  for (const round of [1, 2]) {
    try {
      try Step.next()
      break
    } handle Step.next() {
      const n: number = try resumeWith(effect { return undefined })
      n.toFixed(0)
    }
  }
  return 1
}
