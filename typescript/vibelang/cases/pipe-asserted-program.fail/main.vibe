// expect: TS2352
import { Effect } from "effect"
effect function load(): Effect.Effect<unknown, never, never> { return 1 }
// % is one value, so a topic may be a program and the value of another (VIP-23).
export effect function main() {
  return (load() as Effect.Effect<number>) |> try Effect.race(%, Effect.succeed(%))
}

function known() { return 1 }
// A value position still checks the assertion against the completed value.
export effect function valuePosition() {
  return (known() as Effect.Effect<number>) |> try Effect.succeed(%)
}
