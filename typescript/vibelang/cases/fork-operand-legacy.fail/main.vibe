// expect: EK1703 EK1703
// This source compiled on VibeLang 0.0.10, where fork ran a program value
// and an Exit, and converted a function to its program. fork e now forks the
// Effect e (VIP-17); an operand that is not an Effect is EK1703 (decided
// detail 88). fork-operand-legacy-fixed is this source written for VIP-17.
effect function work(n: number) {
  try sleep("1 millis")
  return n
}

export effect function main() {
  const program: number!! = Effect.succeed(1)
  const job = effect () => try work(2)
  const exited = Exit.succeed(5)
  const a = fork program
  const b = fork job
  const c = fork(effect { return try work(3) })
  const d = fork(effect {
    try sleep("1 millis")
    return 4
  })
  const e = fork exited
  return [join a, join b, join c, join d, join e]
}
