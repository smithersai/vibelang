// expect: EK4613 EK1023
// This source compiled on VibeLang 0.0.10, where fork ran a program value
// and an Exit, and converted a function to its program. fork's operand is
// now a program by syntax whose result is its value (D322, D433);
// fork-operand-legacy-fixed is what vibelang --fix writes.
function work(n: number) {
  try sleep("1 millis")
  return n
}

export function main() {
  const program: number!! = Effect.succeed(1)
  const job = () => work(2)
  const exited = Exit.succeed(5)
  const a = fork program
  const b = fork job
  const c = fork(() => work(3))
  const d = fork(() => {
    try sleep("1 millis")
    return 4
  })
  const e = fork exited
  return [join a, join b, join c, join d, join e]
}
