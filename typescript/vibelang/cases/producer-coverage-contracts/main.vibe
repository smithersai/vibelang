import { Effect, Stream, Queue, Scope } from "effect"
// VIP-21 aliases normalize to a single Stream; channel unions remain Streams.
export effect function main(): Effect.Effect<Array<number | string>> {
 type Numbers = Stream.Stream<number>
 effect function* one(): Numbers | never { yield 1 }
 effect function* union(): Stream.Stream<number | string> { yield 2; yield "x" }
 effect function* scopes() { yield try Effect.scope }
 const check: Stream.Stream<Scope.Scope> = scopes()
 const a = try Stream.runCollect(one())
 const b = try Stream.runCollect(union())
 return [...a, ...b]
}


// docs/design/vips/0021-producers.md#da6b6b0c357df4f6 | VIP-21 written-Stream-contract-and-methods
// **A producer's written return annotation must expose its Stream contract, just as an Effect function's annotation exposes its Effect contract.** (R10 Opus OPUS-3; accepted VIP-21, chapter002's existing `EK2102` row, chapter001's `EK0106` rule; principles1/4/8.) After normal type-alias resolution, an explicit producer annotation must resolve to `Stream.Stream<A,E,R>`.

// docs/design/vips/0021-producers.md#13eb8bac10836d21 | VIP-21 written-Stream-contract-and-methods
