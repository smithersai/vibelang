// A catch handles a failure only when the cause holds expected failures alone
// (D13): a defect, an interruption, or a mixed cause passes through it. A
// finally runs on every exit, and a failure inside it is never dropped (D15).
import { Data, Effect, Exit } from "effect"

class Expected extends Data.TaggedError("Expected")<{}> {}
class Cleanup extends Data.TaggedError("Cleanup")<{}> {}

const events: string[] = []

function reasons(exit: Exit.Exit<unknown, unknown>) {
  return Exit.isFailure(exit) ? (exit.cause.reasons as ReadonlyArray<(typeof exit.cause.reasons)[number]>).map((reason) => reason._tag) : ["Success"]
}

// A JavaScript TypeError is a defect: the catch does not run, the finally does.
effect function defect() {
  try {
    try Effect.sleep("1 millis")
    const broken: any = undefined
    return broken.name
  } catch (e) {
    events.push("catch saw a defect")
    return "caught"
  } finally {
    events.push("finally after a defect")
  }
}

// An expected failure plus a defect from cleanup is a mixed cause. Effect 4.1.0
// makes the failure a defect beside the cleanup's (Effect-TS/effect#9433).
effect function mixed() {
  try {
    try {
      throw new Expected()
    } finally {
      try Effect.die("release-defect")
    }
  } catch (e) {
    events.push("catch saw a mixed cause")
    return "recovered"
  }
}

// A failure inside finally is kept; when the body failed too, both are.
effect function failingFinally(bodyFails: boolean) {
  try {
    if (bodyFails) throw new Expected()
    return "body"
  } finally {
    throw new Cleanup()
  }
}

// Interruption runs finally and skips catch.
effect function slow() {
  try {
    try Effect.sleep("1 second")
    return "finished"
  } catch (e) {
    events.push("catch saw an interruption")
    return "caught"
  } finally {
    events.push("finally after interruption")
  }
}

// expect-result: {"defect":["Die"],"mixed":["Die","Die"],"cleanup":["Fail"],"both":["Fail","Fail"],"timeout":["Fail"],"events":["finally after a defect","finally after interruption"]}
export effect function main() {
  return {
    defect: reasons(try Effect.exit(effect { return try defect() })),
    mixed: reasons(try Effect.exit(effect { return try mixed() })),
    cleanup: reasons(try Effect.exit(effect { return try failingFinally(false) })),
    both: reasons(try Effect.exit(effect { return try failingFinally(true) })),
    timeout: reasons(try Effect.exit(effect { return try Effect.timeout(effect { return try slow() }, "10 millis") })),
    events
  }
}
