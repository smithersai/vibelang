// using is one Effect program for every initializer (D490):
// Effect.acquireRelease(e, release, { interruptible: true }), whose restore
// runs e with the interruptibility in force where the using stands, as
// yield* runs it, and which registers the value's release in the
// uninterruptible step that ends the acquire. An interruption that arrives
// at a wait in the initializer ends the wait, and nothing is acquired,
// whether the initializer requires Scope or not: a wait in a helper that
// returns a Disposable ("waiting"), a helper whose own using acquires an
// interruptible lock ("nested"), a pause in a helper whose contract names
// Scope ("scoped"), and an acquireRelease with { interruptible: true } behind
// a wrapper ("interruptible"). One that arrives while the initializer runs
// in a mask of its own is delivered as that mask ends, as Effect delivers
// it, inside the initializer: the initializer gives no value, so using
// registers nothing, and a Disposable it made is its own to release
// ("ending"). Effect.acquireDisposable registers the Disposable's release
// inside its mask, so the same interruption lands after that, and the value
// is disposed once ("acquireDisposable").
// expect-result: {"ending":["acquired"],"acquireDisposable":["acquired","disposed"],"waiting":[],"nested":[],"scoped":[],"interruptible":[]}
export effect function main() {
  return { ending: try endingInMask(), acquireDisposable: try acquireDisposable(), waiting: try waiting(), nested: try nested(), scoped: try scoped(), interruptible: try interruptible() }
}

effect function endingInMask() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function work() {
    using resource = try Effect.uninterruptible(effect {
      try Deferred.succeed(entered, undefined)
      try Deferred.await(gate)
      events.push("acquired")
      return { [Symbol.dispose](): void { events.push("disposed") } }
    })
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}

effect function acquireDisposable() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function work() {
    using resource = try Effect.acquireDisposable(effect {
      try Deferred.succeed(entered, undefined)
      try Deferred.await(gate)
      events.push("acquired")
      return { [Symbol.dispose](): void { events.push("disposed") } }
    })
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}

effect function waiting() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function open() {
    try Deferred.succeed(entered, undefined)
    try Deferred.await(gate)
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  effect function work() {
    using resource = try open()
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}

effect function nested() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function lock() {
    return try Effect.acquireRelease(
      effect {
        try Deferred.succeed(entered, undefined)
        try Deferred.await(gate)
        events.push("locked")
        return { held: true }
      },
      effect () => {
        events.push("unlocked")
      },
      { interruptible: true }
    )
  }

  // Its using supplies the lock's Scope, so open requires no Scope.
  effect function open() {
    using held = try lock()
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  effect function work() {
    using resource = try open()
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}

effect function scoped() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function open(): object!!Scope {
    try Deferred.succeed(entered, undefined)
    try Deferred.await(gate)
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  effect function work() {
    using resource = try open()
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}

effect function interruptible() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()

  effect function connect() {
    return try Effect.acquireRelease(
      effect {
        try Deferred.succeed(entered, undefined)
        try Deferred.await(gate)
        events.push("acquired")
        return { socket: "open" }
      },
      effect () => {
        events.push("released")
      },
      { interruptible: true }
    )
  }

  effect function work() {
    using resource = try connect()
    events.push("body")
  }

  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}
