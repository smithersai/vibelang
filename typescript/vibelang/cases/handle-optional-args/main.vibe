// The expression form of handle passes a clause the operation's arguments and
// then its continuation. An optional argument left out at the call site still
// takes its position, so the continuation stays last, also when the clause
// gives that parameter a default.
control Log {
  write(message: string, level?: string): string!!
}

function program(level?: string) {
  return level === undefined ? try Log.write("hi") : try Log.write("hi", level)
}

function run(level?: string) {
  return try handle(() => program(level), Log, {
    write(message, given, k) {
      return try resume(k, `${message}/${given ?? "default"}`)
    }
  })
}

function runWithDefault() {
  return try handle(() => Log.write("hi"), Log, {
    write(message, level = "info", k) {
      return try resume(k, `${message}/${level}`)
    }
  })
}

// expect-result: {"omitted":"hi/default","given":"hi/warn","withDefault":"hi/info"}
export function main() {
  return { omitted: try run(), given: try run("warn"), withDefault: try runWithDefault() }
}
