import { Effect } from "effect"
enum Tag{A,B}
function shared(s:{_tag:"A";x:number}|{_tag:"A";y:number}):number{return match(s){when {_tag:"A"}:1;}}
function unions(s:{_tag:"A"|"B"}|{_tag:"C"}):number{return match(s){when {_tag:"A"}:1;when {_tag:"B"}:2;when {_tag:"C"}:3;}}
function numbers(s:{_tag:1|2}):number{return match(s){when {_tag:1}:1;when {_tag:2}:2;}}
