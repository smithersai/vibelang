// A Scope region supplies Scope to its using acquisitions and to the fibers
// it forks, so Scope leaves R only there (D14, D19, D47). contracts.ts checks
// each function's contract.
export interface Conn {
  id: number
}

export class Down extends TaggedError("Down")<{}> {}

export abstract class Pool {
  abstract acquire(): Effect<Conn, Down, Scope>
}

export abstract class Audit {
  abstract record(event: string): Effect<void, never, never>
}

// using: the block's Scope; Pool and Down remain.
export effect function query() {
  using conn = try Pool.acquire()
  return conn.id
}

// No using: the caller's Scope owns the connection.
export effect function lease() {
  const conn = try Pool.acquire()
  return conn.id
}

// An acquisition without using and one with using in the same block.
export effect function both() {
  const kept = try Pool.acquire()
  using held = try Pool.acquire()
  return kept.id + held.id
}

// A block-owned fork adds its program's requirements, not Scope.
export effect function audited() {
  fork Audit.record("start")
  return "audited"
}

// A forked program that acquires without using still needs the caller's Scope.
export effect function forkedLease() {
  fork lease()
  return "forked"
}

// An arrow's expression body owns its fork too (D353): Scope leaves R.
export const background = effect () => join fork(Audit.record("background"))

// Effect.forkScoped keeps Effect's contract inside a region too.
export effect function scopedFork() {
  using conn = try Pool.acquire()
  try Effect.forkScoped(effect { return try Audit.record(`conn ${conn.id}`) })
  return conn.id
}

let next = 0
const PoolTest = Layer.succeed(Pool, {
  acquire: effect () => try Effect.acquireRelease(effect { return ({ id: ++next }) }, effect () => {})
})
const AuditTest = Layer.succeed(Audit, { record: effect () => {} })

effect function all() {
  const q = try query()
  const b = try Effect.scoped(effect { return try both() })
  const a = try audited()
  return [q, b, a]
}

// expect-result: [1,5,"audited"]
export effect function main() {
  return try Effect.provide(effect { return try all() }, Layer.mergeAll(PoolTest, AuditTest))
}
