// expect: EK9204
// A plain function's catch receives expected failures only (D282). Where its
// try block can fail, as JSON.parse can with SyntaxError (D101), an exception
// that TypeScript code in the same block throws passes through the catch,
// where TypeScript's catch received it. EK9204 is an error here
// (tsconfig.json).
import { identity } from "./identity.ts"

error Empty

// A trusted package's decoder, whose name says it throws, beside JSON.parse.
export const decoded = (text: string): string | undefined => {
  try {
    return Schema.decodeUnknownSync(Schema.String)(JSON.parse(text))
  } catch {
    return undefined
  }
}

// A .ts helper inside JSON.parse's argument.
export const document = (schema: unknown): unknown => {
  try {
    return JSON.parse(JSON.stringify(identity(schema)))
  } catch {
    return undefined
  }
}

// A throw the catch handles, beside a .ts helper.
export function checked(text: string): unknown {
  try {
    if (text === "") throw new Empty()
    return identity(text)
  } catch {
    return undefined
  }
}

// Not reported: the catch receives everything the block can throw, a
// trusted package's function that never throws, a built-in, a call bounded by
// Result.try, and a call in a nested function.
export const parsed = (text: string): unknown => {
  try {
    return JSON.parse(text)
  } catch {
    return undefined
  }
}
export const bounded = (text: string): unknown => {
  try {
    const value = JSON.parse(text)
    return Option.getOrUndefined(Option.some(Result.try(() => identity(value)).getOrElse(() => undefined)))
  } catch {
    return undefined
  }
}
export const nested = (texts: string[]): unknown => {
  try {
    const first = JSON.parse(texts[0] ?? "null")
    return [first, ...texts.slice(1).map((text) => identity(text))]
  } catch {
    return undefined
  }
}
