// expect: EK0403
// Partial Stream views are not Stream results and keep their foreign contracts.
import type { Marker } from "./lib.js"
import { marker, noChannel, noPipe, whole, view, knownMarker, safeMarker, untagged } from "./lib.js"
export effect function markerResult() { return marker() }
export effect function missingChannel() { return noChannel() }
export effect function missingPipe() { return noPipe() }
export effect function knownResult() { return knownMarker() }
export effect function completeResult() { return whole() }
export effect function structuralResult() { return view() }
export effect function neverResult() { return safeMarker() }
export function plainFactory(): Marker { untagged(); return marker() }
export function plainDefault(p = untagged()): Marker { return marker() }
