import { Effect } from "effect"
function* numbers(log: string[]) { try { yield 1; yield 2 } finally { log.push("closed") } }
effect function typed(log: string[]) { return match (numbers(log)) { when [let a, ...]: throw "bad"; default: 0; } }
export effect function main(): unknown!! { const log: string[] = []; const result = try exit(typed(log)); return [result._tag, log] }
