// expect: EK4409
// A call of a value of type any returns its value (D24): nothing says whether
// it is a program. Where that value is what a program or an Effect function
// returns, a program the callee returns would never run. EK4409 is an error
// here (tsconfig.json).
export const register = effect (execute: any) => try Effect.updateContext(effect { return execute() }, (context) => context)

export const each = effect (handler: any, items: Array<number>) => try Effect.forEach(items, effect (item) => handler.run(item))

export effect function load(loader: any) {
  try sleep("1 millis")
  return (loader as any)()
}

// A typed callee says which it returns, so these are not reported.
export const typed = effect (execute: () => number!!) => try Effect.updateContext(effect { return try execute() }, (context) => context)

export effect function parse(text: string) {
  try sleep("1 millis")
  return JSON.parse(text)
}

// A plain function's call returns the value to its caller as JavaScript does.
export const plain = (execute: any): unknown => execute()
