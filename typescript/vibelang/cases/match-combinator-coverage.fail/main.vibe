// expect: EK4701 EK4701 EK4701 EK4701 EK4701 EK4701
export function andTest(x: boolean) {
  return match (x) { when true and true: 1; when false: 0; }
}
export function notTest(x: boolean) {
  return match (x) { when not false: 1; when false: 0; }
}
export function bindingTest(x: boolean) {
  return match (x) { when true and Boolean: true; when false: false; }
}
export function nestedTest(x: boolean) {
  return match (x) { when (true and true) or false: 1; }
}

type Tagged = { _tag: "A"; n: number } | { _tag: "B" }
export function fieldBindings(x: Tagged) {
  return match (x) { when { _tag: "A", n: (let a and Number) }: 1; when { _tag: "B" }: 0; }
}
error NestedA
error NestedB
export function extractorBindings(x: NestedA | NestedB) {
  return match (x) { when NestedA(let a and Number): 1; when NestedB: 0; }
}
