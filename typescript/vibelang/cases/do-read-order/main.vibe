// expect-result: [3,4,5,[6,7]]
import "vibelang/platform/node"

export effect function main() {
  let n: number = 1
  const sum = n + do { n = 10; 2 }
  const box = { value: 3 }
  const getter = { get value() { return box.value } }
  const property = getter.value + do { box.value = 30; 1 }
  let first: number = 4
  const array = [first, do { first = 40; 1 }]
  let shorthand: number = 6
  const object = { shorthand, next: do { shorthand = 60; 7 } }
  try Console.log("done")
  return [sum, property, array[0] + array[1], [object.shorthand, object.next]]
}
