// expect-result: {"arrowLine":1,"arrowBlock":2,"blockArrow":3,"expression":4,"method":5,"classMethod":6,"handlerLine":"line failed","handlerBlock":"block failed","topicLine":8,"topicBlock":9,"parsed":[1],"stepped":9,"matchEffect":[10,11],"matchPlain":[12,13],"doValue":14,"throwLine":"throw line","throwBlock":["kept","throw block"],"produced":[15,16],"generated":[17,18],"awaited":20,"jumps":3,"counted":307,"sum":21,"byName":22}
// A comment before an expression stays a comment wherever the compiler
// writes the expression: after a return it adds (an arrow's body, a
// handler's value, a match arm), after throw or yield, and in labeled
// jumps, increments and arrow parameters. A line break after return, throw
// or yield, or before ++, -- or =>, would change the program (ASI).
error Bad { message: string }

const later = effect (n: number): number!! => {
  try sleep("1 millis")
  return n
}

const failing = effect (): string!Bad => {
  try sleep("1 millis")
  throw new Bad({ message: "failed" })
}

// return: an arrow's concise body, a direct Effect
const arrowLine = effect (): number!! =>
  // line
  try later(1)

const arrowBlock = effect (): number!! =>
  /* block */
  try later(2)

// return: a parenthesized value of a block-bodied arrow, a function
// expression and methods
const blockArrow = effect (): number!! => {
  return (
    // line
    try later(3)
  )
}

const expression = effect function (): number!! {
  return (
    /* block */
    try later(4)
  )
}

const box = {
  effect read(): number!! {
    return (
      // line
      try later(5)
    )
  }
}

class Holder {
  effect read(): number!! {
    return (
      /* block */
      try later(6)
    )
  }
}

// return: a catch handler's value
effect function handlerLine(): string!! {
  return failing() catch (e) =>
    // line
    "line " + e.message
}

effect function handlerBlock(): string!! {
  return failing() catch (e) =>
    /* block */
    "block " + e.message
}

// return: a closure in a pipe stage that reads the topic
effect function topicLine(): number!! {
  return try later(1) |> try Effect.map(Effect.succeed(7),
    // line
    (n) => n + %)
}

effect function topicBlock(): number!! {
  return try later(1) |> try Effect.map(Effect.succeed(8),
    /* block */
    (n) => n + %)
}

// return: hatches as an arrow's body
const parsed = effect (text: string) =>
  // line
  try Effect.try({ try: () => ((text) => JSON.parse(text) as unknown)(text), catch: (cause) => new Bad({ message: String(cause) }) })

const stepped = effect (n: number) =>
  /* block */
  try sync((n) => n + 1, n)

// return: match arms, in an Effect function and a plain function
effect function matchEffect(x: string): number!! {
  try later(0)
  return match (x) {
    when "a":
      // line
      10;
    default:
      /* block */
      11;
  }
}

function matchPlain(x: string): number {
  return match (x) {
    when "a":
      // line
      12;
    default:
      /* block */
      13;
  }
}

// return: a do block's value
effect function doValue(): number!! {
  const v = do {
    const a = try later(13)
    // line
    a + 1
  }
  return v
}

// throw: a statement and an expression
effect function throwLine(): string!Bad {
  try later(0)
  throw (
    // line
    new Bad({ message: "throw line" })
  )
}

effect function throwBlock(flag: boolean): string!Bad {
  const v = flag ? "kept" : throw (
    /* block */
    new Bad({ message: "throw block" })
  )
  return v
}

// yield: a producer and a JavaScript generator
function* produced() {
  yield (
    // line
    try later(15)
  )
  yield (
    /* block */
    16
  )
}

effect function produce(): number[]!! {
  const values: number[] = []
  for (const x of produced()) values.push(x)
  return values
}

function* generated(): Generator<number> {
  yield (
    // line
    17
  )
  yield (
    /* block */
    18
  )
}

// await: in a module body
module text {
  export async function loaded(): Promise<number> {
    const a = await (
      // line
      Promise.resolve(19)
    )
    return a + await (
      /* block */
      Promise.resolve(1)
    )
  }
}

import { loaded } from text

effect function awaited(): number!! {
  return try sync(async () => loaded())
}

// break and continue with a label, across a finally region
effect function jumps(): number!! {
  let total = 0
  outer: for (const i of [1, 2, 3]) {
    for (const j of [1, 2, 3]) {
      try {
        try later(0)
        // line
        if (j === 2) continue outer
        if (i === 3) break /* block */ outer
        total += i * j
      } finally {
        try later(0)
      }
    }
  }
  return total
}

// postfix ++ and --
effect function counted(): number!! {
  let up = 0
  let down = 10
  for (const x of [1, 2, 3]) {
    try later(x)
    // line
    up++
    down /* block */ --
  }
  return up * 100 + down
}

// =>: arrow parameters with comments
const sum = effect (
  // line
  a: number,
  /* block */
  b: number
): number!! => try later(a + b)

// by-name arguments
effect function byName(): number!! {
  return try retry(
    // line
    later(22),
    /* block */
    { times: 1 }
  )
}

export effect function main() {
  return {
    arrowLine: try arrowLine(),
    arrowBlock: try arrowBlock(),
    blockArrow: try blockArrow(),
    expression: try expression(),
    method: try box.read(),
    classMethod: try new Holder().read(),
    handlerLine: try handlerLine(),
    handlerBlock: try handlerBlock(),
    topicLine: try topicLine(),
    topicBlock: try topicBlock(),
    parsed: try parsed("[1]"),
    stepped: try stepped(8),
    matchEffect: [try matchEffect("a"), try matchEffect("b")],
    matchPlain: [matchPlain("a"), matchPlain("b")],
    doValue: try doValue(),
    throwLine: throwLine() catch (e) => e.message,
    throwBlock: [try throwBlock(true), throwBlock(false) catch (e) => e.message],
    produced: try produce(),
    generated: [...generated()],
    awaited: try awaited(),
    jumps: try jumps(),
    counted: try counted(),
    sum: try sum(20, 1),
    byName: try byName()
  }
}
