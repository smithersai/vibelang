import { Effect, Stream } from "effect"
export effect function main() {
 const value = do { switch (0) {} 7 }
 const empty = do { switch (0) {} }
 const first = do { for try (const row of Stream.make(1)) {} 7 }
 const second = do { for concurrent (const row of [1]) {} 7 }
 const limited = do { for concurrent(1) (const row of [1]) {} 7 }
 return [value, empty === undefined, first, second, limited]
}

