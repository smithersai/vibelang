import { Effect, Schema } from "effect"
import { ChildRunError } from "./child.vibe"

export class Failure extends Schema.TaggedError<Failure>()("Failure", { message: Schema.String }) {}
export class OtherFailure extends Schema.TaggedError<OtherFailure>()("OtherFailure", { message: Schema.String }) {}
export type RunError = Failure | OtherFailure

// Resolving suspend's lambda reaches ChildRunError's type query while run's
// free form is still being decided.
export const run = effect (fail: boolean): Effect.Effect<number, RunError, never> =>
  try Effect.suspend(effect () => {
    if (fail) {
      const child = new ChildRunError(new Failure({ message: "failed" }))
      throw child.error
    }
    return 42
  })
