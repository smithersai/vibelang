// expect: EK1002
// VIP-21: Effect.gen expects a JavaScript generator;
// an explicit effect function* is a Stream producer.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

const findName = effect (id: string) => try Effect.gen(effect function* () {
  const users = try Users
  const user = try users.find(id)
  yield user.name
})
