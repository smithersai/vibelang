// expect: EK1002
// Chapter 10 "Generator-style code stays in TypeScript": Effect.gen expects a JavaScript generator,
// but in VibeLang function* declares a producer.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

const findName = effect (id: string) => try Effect.gen(function* () {
  const users = yield* Users
  const user = yield* try users.find(id)
  return user.name
})
