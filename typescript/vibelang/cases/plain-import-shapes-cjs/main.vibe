// In a CommonJS package, a call of a plain function imported from a .vibe
// module runs its plain variant through every import shape, as it does in an
// ES module (plain-default-import-shapes). run.mjs loads it with require.
import solo from "./named.vibe"
import mixed, { other } from "./named.vibe"
import { other as renamed, "quoted name" as quoted, tag } from "./named.vibe"
import withNamespace, * as ns from "./named.vibe"
import empty, {} from "./named.vibe"
import { default as named } from "./named.vibe"
import reexported, { forwarded, forwardedOther, early } from "./barrel.vibe"

function logged(s: string) {
  try Console.log(s)
  return other(s)
}

export function program() {
  const a: string = try solo("solo")
  const b: string = try mixed("mixed")
  const c: string = try withNamespace("namespace")
  const d: string = try empty("empty")
  const e: string = try named("named")
  const f: string = try reexported("reexported")
  return {
    solo: a,
    mixed: b,
    other: other("other"),
    renamed: renamed("renamed"),
    quoted: try quoted("quoted"),
    tagged: try tag`a${"b"}c`,
    mapped: ["mapped"].map(other),
    logged: try logged("logged"),
    withNamespace: c,
    namespace: ns.other("ns"),
    namespaceDefault: try ns.default("ns-default"),
    empty: d,
    named: e,
    reexported: f,
    forwarded: try forwarded("forwarded"),
    forwardedOther: forwardedOther("forwarded"),
    early: early("early")
  }
}
