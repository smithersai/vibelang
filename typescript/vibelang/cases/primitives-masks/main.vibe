// expect-result: {"masked":"done","restored":"Failure","forced":"Failure","returned":7,"call":"work"}

// An uninterruptible block finishes even when its fiber is interrupted.
effect function masked() {
  const done = try Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      try sleep("20 millis")
      try Deferred.succeed(done, "done")
    }
  }
  try sleep("5 millis")
  try fiber.interrupt()
  return try done.await()
}

// restore brings back the interruptibility the block began with.
effect function restored() {
  const started = try Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      restore {
        try Deferred.succeed(started, "started")
        try sleep("1 second")
      }
    }
  }
  try started.await()
  try fiber.interrupt()
  return (try exit(fiber.join()))._tag
}

// interruptible makes code interruptible inside an uninterruptible block.
effect function forced() {
  const started = try Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      interruptible {
        try Deferred.succeed(started, "started")
        try sleep("1 second")
      }
    }
  }
  try started.await()
  try fiber.interrupt()
  return (try exit(fiber.join()))._tag
}

// A return inside the block returns from the function.
effect function returned() {
  uninterruptible {
    return 7
  }
}

function work() {
  return "work"
}

// The call form runs a program the same way.
effect function call() {
  return try uninterruptible(work())
}

export effect function main() {
  return { masked: try masked(), restored: try restored(), forced: try forced(), returned: try returned(), call: try call() }
}
