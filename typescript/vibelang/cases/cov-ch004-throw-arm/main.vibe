import { Effect } from "effect"
// Chapter 004, throw-arm: docs/design/src/004-match.md#775867f17b1d945e
// Chapter 004, throw-arm: docs/design/src/004-match.md#ef6dac64feb1fdbb
import { plainThrown } from "./plain-native.js"
effect function typed(){return match(true){default:throw "bad";}}
export function main():Effect.Effect<unknown>{return Effect.gen(function*(){const thrown=yield* plainThrown;const result=yield* Effect.exit(typed());return [thrown,result._tag,result._tag==="Failure"&&result.cause.reasons.map(r=>r._tag)]})}

// Chapter 004 rule: An arm's body may be `throw e`, as VIP-5's example writes it.

// Plain match throws are EK0401; the negative companion preserves that source check.
