import { throwingPlain, throwingProducer } from "./native.js"
import { Effect } from "effect"
function plain(): number { return 7 }
function* producer(): Generator<number> { yield 7 }
export effect function main() {
 const annotations: [number, Generator<number>] = [plain(), producer()]; void annotations
 const a = try Effect.exit(Effect.try(() => throwingPlain()))
 const b = try Effect.exit(Effect.try(() => throwingProducer().next()))
 return [a._tag, b._tag]
}

