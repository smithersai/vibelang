// VIP-27: shipped global annotations use the @throws {T} spelling.
// run.mjs parses every shipped annotation as a JSDoc `@throws {T}` tag and
// checks that a global and a .ts declaration written with its annotation
// compile to the same diagnostics.
export const witness = 1
