// expect-result: "news"
import { isResolved, accepts, type News } from "./foreign.ts"
export effect function read(news: News | undefined): string!! {
  const resolved = try Effect.orDie(Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }))
  if (resolved === undefined) return "absent"
  const title: string = resolved.title
  return title
}
export effect function main() { return try read({ title: "news" }) }
