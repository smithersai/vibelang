// expect: EK3005
service Generic<T> { static readonly key = "coverage/Generic"; value: T }
function outer<T>() {
  type Alias<U> = { value: U }
  service Captured { static readonly key = "coverage/Captured"; value: Alias<T> }
  service Constraint { static readonly key = "coverage/Constraint"; read<U extends T>(): U }
  service Defaulted { static readonly key = "coverage/Defaulted"; read<U = T>(): U }
  return 0
}
export {}

