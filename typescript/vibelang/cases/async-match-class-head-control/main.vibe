import { Effect } from "effect"

async function run() {
  const trace: string[] = []
  return await async match (1) {
    default: do {
      class C extends do { trace.push("base"); (class {}) } {
        [do { trace.push("key"); local: { break local }; "m" }]() { return 1 }
        value = () => { return 7 }
        get result() { return this.value() }
      }
      const instance = new C();
      [instance.result, trace]
    };
  }
}

// expect-result: [7,["base","key"]]
export effect function main() { return try Effect.promise(run) }
