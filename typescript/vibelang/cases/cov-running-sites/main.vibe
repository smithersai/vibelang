import { Effect, Exit, Fiber, Stream, Scope, Context, Layer, Config } from "effect"
const nativeRun = Effect.runSync(Effect.succeed(11))
service Counter { value: number }
export effect function main() {
 const events: string[] = []
 let runs = 0
 const task = (effect () => { runs++; return runs })()
 const before = runs
 const first = try task
 const second = try task
 const unary = try Effect.succeed(6) + 1
 const fallback = Effect.fail("bad") catch (e) => e.length
 const fiber = fork Effect.succeed(8)
 const joined = join fiber
 const failed = try exit(effect { throw "failed" })
 const all = try.all [Effect.succeed(1), Effect.succeed(2)]
 const raced = try.race [Effect.succeed(3)]
 const any = try.any [Effect.fail("bad"), Effect.succeed(4)]
 const settled = try.allSettled [Effect.succeed(5), Effect.fail("bad")]
 let active = 0, maximum = 0
 for concurrent (const item of [1, 2, 3]) {
   active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--
 }
 const seen: number[] = []
 for try (const item of Stream.make(1, 2)) { seen.push(item) }
 let supplied = 0
 provide Counter = { value: 9 } { supplied = (try Counter).value }
 uninterruptible { events.push("mask"); restore { events.push("restore") } }
 interruptible { events.push("interruptible") }
 function limit() { events.push("limit"); return 1 }
 function items() { events.push("items"); return [1] }
 for concurrent(limit()) (const item of items()) { events.push("item") }
 const config = try Config.succeed(7)
 const exitValue = try Exit.succeed(8)
 return { nativeRun, before, first, second, unary, fallback, joined, failed: failed._tag, all, raced, any, settled: settled.map(x => x._tag), maximum, seen, supplied, config, exitValue, events }
}
