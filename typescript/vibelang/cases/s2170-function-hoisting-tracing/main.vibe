import { Cause } from "effect"

function outer() {
  "use strict"
  const first = try nested()
  function nested(): string!Cause.NoSuchElementError! {
    return (try Effect.currentSpan()).name
  }
  {
    const second = try inBlock()
    function inBlock(): string!Cause.NoSuchElementError! {
      return (try Effect.currentSpan()).name
    }
    return [first, second]
  }
}

// expect-result: ["nested","inBlock"]
export function main() {
  return try outer()
}
