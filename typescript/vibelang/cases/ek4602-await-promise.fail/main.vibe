// expect: EK0102
// Effect code cannot await a Promise (VIP-1/VIP-5). Wrap it with
// tryPromise and run it with try; native async code keeps await.
declare const pending: Promise<number>

export effect function total() {
  const n = await pending
  return n + 1
}
