// expect-result: {"restored":"Failure","value":3}

// A restore block uses the lexical mask in its source activation.
// The region retains outward returns and the original interruption state.
effect function restored() {
  const started = try Deferred.make<string>()
  const fiber = fork effect {
    uninterruptible {
      restore {
        try Deferred.succeed(started, "started")
        try sleep("1 second")
      }
      return "finished"
    }
  }
  try started.await()
  try fiber.interrupt()
  return (try exit(fiber.join()))._tag
}

// The restore block runs where it stands, inside the region.
effect function value(): number!! {
  let ran = 0
  uninterruptible {
    restore {
      ran = 1
    }
    return ran + 2
  }
}

export effect function main() {
  return { restored: try restored(), value: try value() }
}
