// expect-result: {"restored":"Failure","value":3}

// A restore block inside an uninterruptible block written as an expression,
// `return uninterruptible { … }`, restores the interruptibility the region
// began with, as it does inside the statement form (D180).
effect function restored() {
  const started = try Deferred.make<string>()
  const fiber = fork {
    return try uninterruptible {
      restore {
        try Deferred.succeed(started, "started")
        try sleep("1 second")
      }
      return "finished"
    }
  }
  try started.await()
  try fiber.interrupt()
  return (try exit(fiber.join()))._tag
}

// The restore block runs where it stands, inside the region.
effect function value(): number!! {
  let ran = 0
  return try uninterruptible {
    restore {
      ran = 1
    }
    return ran + 2
  }
}

export effect function main() {
  return { restored: try restored(), value: try value() }
}
