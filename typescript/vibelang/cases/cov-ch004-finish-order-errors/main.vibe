import { Effect } from "effect"
// Chapter 004, finish-order-errors: docs/design/src/004-match.md#be940783bf26cb71
// Chapter 004, finish-order-errors: docs/design/src/004-match.md#1fef4e4772f443b4

// The iterators' JavaScript throws live in TypeScript. In effect code an
// implicit throw from a match, the no-match TypeError and closing errors
// included, is a defect.
module iterators {
  import { Exit } from "effect"
  /** @throws {never} */
  export function iterator(log: string[], name: string, value: unknown): Iterable<unknown> {
    const it = { [Symbol.iterator]() { return it }, next() { return { done: false as const, value } }, return(): IteratorResult<unknown> { log.push(name); throw name + "-close" }, get Value(): never { throw "private Value read" }, get IteratorsToClose(): never { throw "private registry read" } }
    return it
  }
  /** @throws {never} */
  export function errorsOf(exit: Exit.Exit<unknown, unknown>): unknown {
    if (exit._tag === "Success") return exit.value
    const defect = exit.cause.reasons.map((r) => r._tag === "Die" ? r.defect : r._tag)[0]
    return defect instanceof AggregateError ? defect.errors.map((e) => e instanceof TypeError ? "TypeError" : e) : defect
  }
}
import { iterator, errorsOf } from iterators

// The no-match TypeError is the pending throw; both closing errors follow it.
effect function noMatch(outer: Iterable<unknown>): number!! { return match (outer) { when [[0]]: 0; } }
// The first closing error replaces the value; the second makes an AggregateError.
effect function valued(outer: Iterable<unknown>): number!! { return match (outer) { when [[0]]: 0; default: 1; } }

export effect function main(): unknown!! {
  const thrown: string[] = [], replaced: string[] = []
  const pending = try exit(noMatch(iterator(thrown, "outer", iterator(thrown, "inner", 1))))
  const closing = try exit(valued(iterator(replaced, "outer", iterator(replaced, "inner", 1))))
  return [errorsOf(pending), thrown, errorsOf(closing), replaced]
}

// Chapter 004 rule: Iterator registration/closing stays in insertion order and skips empty registry slots; bookkeeping never reads user properties named `Value` or `IteratorsToClose`.

// Chapter 004 rule: With a pending throw, or a second closing error, the `match` throws an `AggregateError` whose `errors` lists the pending throw and then the closing errors, where `for…of` keeps the pending throw alone |

// Chapter 004, rule witness: docs/design/src/004-match.md#f017769fa8394e32

// Chapter 004 rule: | a JavaScript throw, the no-match `TypeError` included | the iterators close, then the throw goes on |
