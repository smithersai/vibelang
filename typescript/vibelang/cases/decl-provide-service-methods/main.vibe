// expect-result: {"all":["b"],"count":2}
// A method in the value of provide Key = value is a service member, as in
// Layer.succeed (D92, D173): its body runs Effects, and calling it returns
// an Effect.
service Names {
  all(): ReadonlyArray<string>!!
  count(): number!!
}

export effect function main() {
  provide Names = {
    effect all() { return ["b"] },
    effect count(): number!! {
      try sleep("1 millis")
      return 2
    }
  } {
    return { all: try Names.all(), count: try Names.count() }
  }
}
