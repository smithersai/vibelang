// A for...of keeps Effect.gen's meaning (chapter 8, Abandonment). JavaScript
// completions close the iterator: a break and a return call return(). A failed
// or interrupted yield* abandons the generator, so a typed failure thrown in the
// body or by a call in it, and an interruption, leave the iterator open.
error Stop { at: number }

const events: string[] = []

function counting(name: string): Iterable<number> {
  let i = 0
  return {
    [Symbol.iterator]() {
      return {
        next(): IteratorResult<number> {
          i++
          return i <= 5 ? { value: i, done: false } : { value: undefined, done: true }
        },
        return(): IteratorResult<number> {
          events.push(name)
          return { value: undefined, done: true }
        }
      }
    }
  }
}

effect function throwing(): number!Stop {
  for (const x of counting("throw")) {
    if (x === 2) throw new Stop({ at: x })
  }
  return 0
}

effect function throwingAfterEffect(): number!Stop {
  for (const x of counting("throw after an effect")) {
    try sleep("0 millis")
    if (x === 2) throw new Stop({ at: x })
  }
  return 0
}

effect function failingCall(): number!Stop {
  for (const x of counting("failing call")) {
    if (x === 2) try throwing()
  }
  return 0
}

effect function breaking(): number!! {
  for (const x of counting("break")) {
    try sleep("0 millis")
    if (x === 2) break
  }
  return 1
}

effect function returning(): number!! {
  outer: for (const x of counting("return")) {
    try sleep("0 millis")
    if (x === 1) continue outer
    if (x === 2) return x
  }
  return 0
}

effect function exhausted(): number!! {
  let sum = 0
  for (const x of counting("exhausted")) {
    try sleep("0 millis")
    sum += x
  }
  return sum
}

effect function slow(): number!! {
  for (const x of counting("interrupted")) {
    try sleep("1 second")
  }
  return 0
}

// expect-result: {"results":[-1,-1,-1,1,2,15,-1],"events":["break","return"]}
export effect function main() {
  const results = [
    throwing() catch () => -1,
    throwingAfterEffect() catch () => -1,
    failingCall() catch () => -1,
    try breaking(),
    try returning(),
    try exhausted(),
    timeout(slow(), "10 millis") catch () => -1
  ]
  return { results, events }
}
