import * as $effectPrograms from "effect/Effect"
// Programs as values (design D7): a function with no parameters is a
// program, and nothing runs until something calls it. A function value is
// not converted where Effect expects an Effect (VIP-1): calling it, or
// Effect.suspend, gives the Effect.
import { Effect, Schedule } from "effect"

let runs = 0

effect function work(name: string) {
  runs++
  try Effect.sleep("1 millis")
  return name.toUpperCase()
}

// Returns a program; calling makeJob runs nothing.
function makeJob(name: string): () => Effect.Effect<string> {
  return effect () => try work(name)
}

let failuresLeft = 2

effect function flakyWork() {
  if (failuresLeft > 0) {
    failuresLeft--
    try Effect.fail("not yet")
  }
  return "FLAKY"
}

effect function stored() {
  const job = effect () => try work("stored")
  const returned = makeJob("returned")
  const flaky = effect () => try flakyWork()
  const before = runs
  const once = try job()
  const retried = try Effect.retry($effectPrograms.suspend(flaky), Schedule.recurs(3))
  const pair = try Effect.all([$effectPrograms.suspend(job), $effectPrograms.suspend(returned)], { concurrency: 2 })
  const record = try Effect.all({ a: $effectPrograms.suspend(job), b: $effectPrograms.suspend(returned) })
  return { before, once, retried, pair, record }
}

// Arrays and records of programs built at run time: each program is called
// to give its Effect (VIP-1).
effect function built() {
  const jobs = ["x", "y"].map(makeJob)
  const table: Record<string, () => Effect.Effect<string>> = { p: makeJob("p"), q: makeJob("q") }
  const effects: Record<string, Effect.Effect<string>> = {}
  for (const key in table) effects[key] = table[key]()
  return { jobs: try Effect.all(jobs.map((job) => job())), table: try Effect.all(effects) }
}

// expect-result: {"stored":{"before":0,"once":"STORED","retried":"FLAKY","pair":["STORED","RETURNED"],"record":{"a":"STORED","b":"RETURNED"}},"built":{"jobs":["X","Y"],"table":{"p":"P","q":"Q"}},"runs":9}
export effect function main() {
  const s = try stored()
  const b = try built()
  return { stored: s, built: b, runs }
}
