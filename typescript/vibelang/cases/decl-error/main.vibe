// expect-result: {"timeout":"Timeout","missing":"NotFound:42","wrapped":7,"label":"plain"}
error Timeout
export error NotFound { id: string }
error Wrapped<T> { value: T; note?: string }

effect function find(id: string) {
  if (id === "slow") throw new Timeout()
  throw new NotFound({ id })
}

effect function describe(id: string) {
  try {
    return try find(id)
  } catch (error) {
    return error._tag === "NotFound" ? `${error._tag}:${error.id}` : error._tag
  }
}

function unwrap() {
  try {
    throw new Wrapped({ value: 7 })
  } catch (error) {
    return error.value
  }
}

// `error` is still an ordinary name when no identifier follows it.
function label(error: string) {
  const copy = error
  return copy
}

export effect function main() {
  return { timeout: try describe("slow"), missing: try describe("42"), wrapped: unwrap(), label: label("plain") }
}
