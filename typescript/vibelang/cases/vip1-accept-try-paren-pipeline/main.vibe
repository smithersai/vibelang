// expect-result: {"two":[1,2],"listed":[1,2,2,3],"nested":[[5],[6]]}
// VIP-1 flip acceptance case 7 (alchemy ELBv2/Listener.vibe:348,
// IAM/LoginProfile.vibe:159): try of a parenthesized pipeline runs the
// pipeline (VIP-5: try e runs the Effect e; parentheses are transparent).
export const two = effect () => {
  const pages: Array<number> = Array.from(try (Stream.make(1, 2) |> Stream.runCollect(%)))
  return pages
}

const pagesOf = (n: number) => Stream.make([n, n + 1], [n + 1, n + 2])

// The real sites: a multi-line parenthesized pipeline, then a method chain.
export const listed = effect () => {
  const items = Array.from(
    try (pagesOf(1)
      |> Stream.runCollect(%)),
  ).flatMap((page) => page)
  return items
}

// Inside an effect callback of Effect.forEach, as Listener.vibe nests it.
export const nested = effect () =>
  try Effect.forEach([5, 6], effect (n) =>
    Array.from(
      try (Stream.make(n) |> Stream.runCollect(%)),
    ))

export effect function main() {
  return { two: try two(), listed: try listed(), nested: try nested() }
}
