import { Effect } from "effect"
export function ordinary(s: Date | { kind: string }) { return match(s) { when not Date: s.kind; default: s.getUTCFullYear(); } }
class Plain { n = 1 }
export function named(s: Plain | { kind: string }) { return match(s) { when not Plain: s.kind; default: s.n; } }
export function main(): Effect.Effect<unknown> { return Effect.sync(() => [ordinary(new Date(0)), ordinary({kind:"k"}), named(new Plain()), named({kind:"v"})]) }
