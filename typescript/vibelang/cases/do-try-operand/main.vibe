// expect-result: [3,"block",["ran","after"]]
// try do { … } runs the do expression's value (VIP-2, VIP-5): the block
// runs where it stands, then try runs the Effect it gives. Inside an effect
// block the do runs when the block does.
export effect function main() {
  const order: string[] = []
  const n = try do { const k = 1; effect { return k + 2 } }
  const e = effect { return try do { try sleep("1 millis"); order.push("ran"); effect { return "block" } } }
  const value = try e
  order.push("after")
  return [n, value, order]
}

