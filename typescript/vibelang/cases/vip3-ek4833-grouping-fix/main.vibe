// rule-evidence: docs/design/vips/0003-effect-type-shorthand.md#footnote-old-vibelang
// VIP-3, amended: EK4833 writes the grouping the shorthand requires, because
// added parentheses leave declaration output unchanged. It refuses where
// declaration output would drop source-written parentheses or the rewrite
// would lose a comment between type arguments. EK4856's own repair writes
// the qualified type; a full --fix run continues to the grouped shorthand.
export type Union = Effect.Effect<number | string>
export type List = Effect.Effect<number>[]
export type Paren = Effect.Effect<(number | string)>
export type Commented = Effect.Effect</* success */ number, Error>
export type Legacy = Effect<number | string>
