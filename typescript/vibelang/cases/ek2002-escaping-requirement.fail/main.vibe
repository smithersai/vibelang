// expect: EK9202
// A requirement that the body adds must be in R (Chapter 14).
class MailError extends TaggedError("MailError")<{ readonly reason: string }> {}

service Users {
  find(id: string): Effect<{ email: string; name: string }, never, never>
}

service Mailer {
  send(to: string, body: string): Effect<void, MailError, never>
}

export effect function welcome(id: string): Effect<string, MailError, Users> {
  const user = try Users.find(id)
  try Mailer.send(user.email, "Welcome")
  return user.name
}
