// expect: EK0107
// A pattern binds a name with let or const. var is EK0107 there, as it is
// everywhere in a .vibe file (chapter 004, Pattern bindings).
export function bare(b: boolean) {
  return match (b) { when var x: x; }
}
export function inObject(o: { id: string }) {
  return match (o) { when { var id }: id; default: ""; }
}
export function inArray(xs: number[]) {
  return match (xs) { when [var first]: first; default: 0; }
}
export function inIs(o: unknown) {
  if (o is [var only]) return only
  return 0
}
export function allowed(o: { id: string }) {
  return match (o) { when { let id }: id; default: ""; }
}
