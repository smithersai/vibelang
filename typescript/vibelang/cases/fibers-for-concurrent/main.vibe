import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"total":6,"maxRunning":2,"evens":[2,4],"failed":"Boom","stopped":true}
error Boom

effect function total() {
  let sum = 0
  for concurrent (const n of [1, 2, 3]) {
    try sleep("1 millis")
    sum += n
  }
  return sum
}

// At most two items run at once.
effect function limited() {
  let running = 0
  let maxRunning = 0
  for concurrent(2) (const n of [1, 2, 3, 4, 5]) {
    running++
    maxRunning = Math.max(maxRunning, running)
    try sleep("2 millis")
    running--
  }
  return maxRunning
}

// continue ends one item.
effect function evens() {
  const found: number[] = []
  for concurrent (const n of [1, 2, 3, 4]) {
    if (n % 2 === 1) continue
    try sleep("1 millis")
    found.push(n)
  }
  return found.sort()
}

effect function failed() {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    for concurrent (const n of [1, 2]) {
      if (n === 1) throw new Boom()
      try sleep("1 second")
    }
    return { kind: "return:" as const, value: ("no") };
  }, effect (e) => {
    return { kind: "return:" as const, value: (e._tag) };
  });
return $nativeTryCompletion.value;
}
}

// A failure interrupts the items still running.
effect function stopped() {
  let finished = false
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    for concurrent (const n of [1, 2]) {
      if (n === 1) {
        try sleep("1 millis")
        throw new Boom()
      }
      try sleep("50 millis")
      finished = true
    }
  
;return { kind: "normal" } as const;
}, effect () => {
;return { kind: "normal" } as const;
});

}
  try sleep("100 millis")
  return !finished
}

export effect function main() {
  return { total: try total(), maxRunning: try limited(), evens: try evens(), failed: try failed(), stopped: try stopped() }
}
