// expect-result: {"ran":"Found","stored":"Found"}
// try e stands for e's success, so a contextual value type infers that
// success, as const o: Outcome = await f() infers f's T (VIP-5): the literal
// tag stays "Found" instead of widening to string (TS2322).
type Outcome = { _tag: "Found"; value: number } | { _tag: "Error" }

export effect function main() {
  const ran: Outcome = try Effect.succeed({ _tag: "Found", value: 1 })
  let stored: Outcome = { _tag: "Error" }
  stored = try Effect.succeed({ _tag: "Found", value: 2 })
  return { ran: ran._tag, stored: stored._tag }
}
