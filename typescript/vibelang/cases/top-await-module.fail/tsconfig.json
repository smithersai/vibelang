{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": [],
    "rewriteRelativeImportExtensions": true,
    "outDir": "out"
  },
  "include": [
    "*.vibe"
  ],
  "vibe": {
    "effectGlobals": false,
    "effectModules": false
  }
}
