// Built-in contracts (D5): JSON.parse's shipped contract lists SyntaxError.
import { Effect } from "effect"

// An Effect function that lets the SyntaxError escape fails with it: the
// contract makes it an expected failure, so it joins E.
effect function parse(text: string) {
  return JSON.parse(text) as { port: number }
}

// A catch in an Effect function receives the typed SyntaxError.
effect function config(text: string) {
  try {
    return (try parse(text)).port
  } catch (e) {
    return e instanceof SyntaxError ? -1 : -2
  }
}

// A plain-annotated function that catches its own failures is plain (D54,
// D500), so Array.prototype.map can call it, and its catch still receives
// the SyntaxError.
function parseOr(text: string, fallback: number): number {
  try {
    return JSON.parse(text) as number
  } catch (e) {
    return fallback
  }
}

// expect-result: {"parsed":{"port":8080},"config":[8080,-1],"failure":"SyntaxError","plain":[1,0]}
export effect function main() {
  return {
    parsed: try parse(`{"port":8080}`),
    config: [try config(`{"port":8080}`), try config("{")],
    failure: (try Effect.flip(effect { return try parse("{") })).name,
    plain: ["1", "{"].map((text) => parseOr(text, 0))
  }
}
