// expect-result: ["expired","gone"]
// A declaration file's error class is closed when it extends effect's
// YieldableError and declares no membership test of its own (D501), as a
// Data.TaggedError class does, whoever wrote its declaration file. Expired's
// arm covers it, so the match needs no default arm.
import { Expired } from "legacy-errors"

error Gone { id: string }

export function describe(e: Expired | Gone): string {
  return match (e) {
    when Expired: "expired";
    when Gone: "gone";
  }
}

export function main() {
  return [describe(new Expired({ at: 1 })), describe(new Gone({ id: "1" }))]
}
