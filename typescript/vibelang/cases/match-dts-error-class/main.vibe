// expect-result: ["expired","gone"]
// A declaration file's error class is an ordinary tagged class: its class
// arm covers nothing (chapter 004, Coverage), so the match tests its tag with
// an object pattern. An error declaration's own arm covers its case, so the
// match needs no default arm.
import { Expired } from "legacy-errors"

error Gone { id: string }

export function describe(e: Expired | Gone): string {
  return match (e) {
    when { _tag: "Expired" }: "expired";
    when Gone: "gone";
  }
}

export effect function main() {
  return [describe(new Expired({ at: 1 })), describe(new Gone({ id: "1" }))]
}
