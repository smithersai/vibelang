// expect: EK2102 EK2102 EK2102 EK2102
// A recursive function whose contract leaves E or R to inference must write
// every channel when a call of itself stands where TypeScript needs the
// contract to type it: an argument, a logical operand, or a generic call.
// EK2102 suggests the whole contract, which compiles (D52).
error Neg { n: number }
service Audit { note(n: number): void!! }

export function biggest(n: number): number!Neg {
  try Audit.note(n)
  if (n < 0) throw new Neg({ n })
  return n === 0 ? 0 : Math.max(try biggest(n - 1), n)
}

export function either(n: number): number!Neg {
  if (n < 0) throw new Neg({ n })
  return n === 0 ? 0 : (try either(n - 1) || n)
}

export function depth<T>(xs: ReadonlyArray<T>, n: number): number!Neg {
  if (n < 0) throw new Neg({ n })
  return xs.length === 0 ? n : 1 + try depth(xs.slice(1), n)
}

export function plain(n: number) {
  if (n < 0) throw new Neg({ n })
  return n === 0 ? 0 : Math.max(try plain(n - 1), n)
}
