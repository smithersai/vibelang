import { Effect } from "effect"
import { reject, throws, summary } from "./foreign.js"
export effect function main() {
 const fail = try Effect.exit(Effect.tryPromise(reject))
 const thrown = try Effect.exit(Effect.tryPromise(throws))
 const die = try Effect.exit(Effect.promise(reject))
 const ok = try Effect.promise(() => Promise.resolve(7))
 return [summary(fail),summary(thrown),summary(die),ok]
}

