// expect: EK4201 EK4201 EK4201
// A producer is one value, a Stream (D402): whatever binding or type it
// reaches a consumer through, a consumer other than for...of pulls it on a
// fiber of its own, so a Stream whose requirements hold a control operation
// is EK4201 where it reaches one: an argument of a Stream runner or operator,
// or the receiver of a Stream method. for...of runs it on the loop's fiber,
// and a .vibe function it is passed to only passes it on.
control Ask {
  ask(): number!!
}

function* asks() {
  yield try Ask.ask()
}

function viaBinding() {
  const stream: Stream.Stream<number, never, Ask> = asks()
  return try Stream.runCollect(stream)
}

function viaMethod() {
  const stream = asks()
  return stream.take(1)
}

function viaCall() {
  return try Stream.runCollect(asks())
}

function loop(stream: Stream.Stream<number, never, Ask>) {
  let total = 0
  for (const n of stream) total += n
  return total
}

function passedOn() {
  const stream: Stream.Stream<number, never, Ask> = asks()
  return try loop(stream)
}
