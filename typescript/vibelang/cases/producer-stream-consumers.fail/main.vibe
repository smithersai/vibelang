// expect: EK4201 EK4201 EK4201 EK4201
// A producer is one value, a Stream (D402): whatever binding or type it
// reaches a consumer through, the consumer runs it on a fiber of its own
// (VIP-21), so a Stream whose requirements hold a control operation is
// EK4201 where it reaches one: an argument of a Stream runner or operator,
// the receiver of a Stream method, or a for...of. A .vibe function it is
// passed to only passes it on.
control Ask {
  ask(): number!!
}

function* asks() {
  yield try Ask.ask()
}

effect function viaBinding() {
  const stream: Stream.Stream<number, never, Ask> = asks()
  return try Stream.runCollect(stream)
}

function viaMethod() {
  const stream = asks()
  return stream.take(1)
}

effect function viaCall() {
  return try Stream.runCollect(asks())
}

effect function loop(stream: Stream.Stream<number, never, Ask>) {
  let total = 0
  for (const n of stream) total += n
  return total
}

effect function passedOn() {
  const stream: Stream.Stream<number, never, Ask> = asks()
  return try loop(stream)
}
