// expect: EK4201
// fork, detach, and forkIn start a new fiber, which cannot reach a handler
// on this one (chapter 9, "Handlers and concurrency"). EK4201 reports the
// control operation each runs there, whether passed by name (D147), written
// in a block, or performed by a function it calls.
import { Scope } from "effect"

control Ask { ask(): number!! }

effect function asks() {
  return try Ask.ask() + 1
}

export effect function byName() {
  try {
    const f = fork Ask.ask()
    return join f
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function block() {
  try {
    const f = fork { return try Ask.ask() }
    return join f
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function called() {
  try {
    const f = fork asks()
    return join f
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function detached() {
  try {
    const f = try detach(Ask.ask())
    return join f
  } handle Ask.ask() {
    try resume(1)
  }
}

export effect function inScope(scope: Scope.Scope) {
  try {
    const f = try forkIn(scope, Ask.ask())
    return join f
  } handle Ask.ask() {
    try resume(1)
  }
}
