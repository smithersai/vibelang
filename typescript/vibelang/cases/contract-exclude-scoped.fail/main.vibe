// expect: EK2002
import * as Effect from "effect/Effect"
service Host { field: string }
service Outside { value: number }
export effect function run<A, E, R>(body: Effect.Effect<A, E, R>): A!E!(Exclude<R, Host>) {
  try Outside()
  return try Effect.scoped(Effect.provideService(body, Host, { field: "host" }))
}
