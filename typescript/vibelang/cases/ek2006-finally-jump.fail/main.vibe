// expect: EK2006
// Control cannot leave a finally block of effect code: a return, break, or
// continue there would discard the failure in flight. Plain code keeps
// JavaScript's finally (plain-finally-return, -break, -continue).
class Boom extends TaggedError("Boom")<{}> {}

export effect function swallow(n: number) {
  try {
    if (n > 0) throw new Boom()
    return n
  } finally {
    return -1
  }
}

export effect function loop(items: ReadonlyArray<number>) {
  let total = 0
  for (const item of items) {
    try {
      if (item < 0) throw new Boom()
      total += item
    } finally {
      if (item === 0) continue
      // A jump that stays inside the finally block is fine.
      for (let i = 0; i < 2; i++) {
        if (i === 1) break
      }
    }
  }
  return total
}
