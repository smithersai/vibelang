// expect: EK0401
// A throw in a plain catch handler is EK0401, as in synchronous VibeLang code.
// A throw caught by the handler's own try statement remains an error.
// A nested effect function and an effect handler keep typed failures.
// Catch executes its operand directly; its success value needs no outer try.
effect function load(): number!string { throw "missing" }

export effect function main() {
  const plain = (load() catch (e) => { throw `wrapped ${e}` })
  const caught = (load() catch (e) => { try { throw e } catch { return 0 } })
  const nested = (load() catch (e) => { const g = effect () => { throw e }; return 0 })
  const typed = (load() catch effect (e) => { throw `wrapped ${e}` })
  return { plain, caught, nested, typed }
}
