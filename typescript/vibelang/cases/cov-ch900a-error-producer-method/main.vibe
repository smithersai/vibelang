import { Effect, Stream } from "effect"
error Missing { code: number; effect * values() { yield this.code }; effect() { return 4 } }
export effect function main() {
 const item = new Missing({ code: 2 })
 return [(try Stream.runCollect(item.values())).length, item.effect()]
}

