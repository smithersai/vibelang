// join takes an object of fibers whatever its type names them with:
// properties, an index signature, or both (D225). Its value keeps the keys.
interface Named {
  [key: string]: Fiber.Fiber<number>
  first: Fiber.Fiber<number>
}

// expect-result: {"record":{"first":42,"second":7},"named":{"first":42,"second":7}}
export effect function main() {
  const first = fork { return 42 }
  const second = fork { return 7 }
  const record: Record<string, Fiber.Fiber<number>> = { first, second }
  const named: Named = { first, second }
  const joined: Record<string, number> = join record
  return { record: joined, named: join named }
}
