// expect: EK3203
// Reference program 2: providers form a cycle, CacheLive -> Database -> DatabaseLive -> Cache -> CacheLive.

service Cache {
  get(key: string): Effect<string, never, never>
}

service Database {
  query(sql: string): Effect<string, never, never>
}

const CacheLive = Layer.effect(Cache, effect {
  const db = try Database()
  return {
    get: effect (key) => try db.query(key)
  }
})

const DatabaseLive = Layer.effect(Database, effect {
  const cache = try Cache()
  return {
    query: effect (sql) => try cache.get(sql)
  }
})

const AppLive = wire(CacheLive, DatabaseLive)
