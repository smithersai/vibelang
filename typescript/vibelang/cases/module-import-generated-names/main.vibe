// A module declaration's import of effect/Effect stays in the module's own
// JavaScript (D403), apart from the Effect import the file's lowering adds.
// When the module was inlined, its import moved to the file's top level as
// Effect_1, the lowering's import was named Effect_1 too, and loading the file
// failed with "Identifier 'Effect_1' has already been declared".
module helpers {
  import * as Effect from "effect/Effect"

  export const twice = <A>(effect: Effect.Effect<A>): Effect.Effect<[A, A]> => Effect.all([effect, effect])
}

import { twice } from helpers

export const pair = () => twice(Effect.succeed(1))

// expect-result: [1,1]
export function main() {
  return try pair()
}
