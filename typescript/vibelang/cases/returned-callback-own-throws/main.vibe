// expect-result: [[7,7,7,7,"callback",true],["create","callback-safe","create","callback-safe","create","callback-safe","create","callback-safe","create-throwing","callback-throwing","create-fail"]]
import { create, createThrowing, consume, invoke, factoryError, events, Safe, Throwing, Shape } from "./lib.js"

function assignment() {
  try {
    const saved = create()
    const callback: Safe = saved
    return callback()
  } catch { return -1 }
}

function argument() {
  try {
    const saved = create()
    return consume(saved)
  } catch { return -1 }
}

function rethrowing() {
  try {
    const saved = create()
    return invoke(saved)
  } catch { return -1 }
}

function implementation() {
  try {
    const saved = create()
    class Holder implements Shape { run = saved }
    return new Holder().run()
  } catch { return -1 }
}

function callbackFailure() {
  try {
    const saved = createThrowing()
    const callback: Throwing = saved
    return callback()
  } catch (error) { return error }
}

function factoryFailure() {
  try { create(true); return false }
  catch (error) { return error === factoryError }
}

export effect function main() {
  return [[assignment(), argument(), rethrowing(), implementation(), callbackFailure(), factoryFailure()], events]
}
