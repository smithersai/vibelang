// A lambda's return annotation writes its form (D500). Where only a plain
// function fits, a plain annotation returns A, so Schema.suspend receives a
// schema, and SchemaTransformation.transform infers its types from A.
import { Schema, SchemaTransformation } from "effect"

interface Crate {
  count: number
  children: ReadonlyArray<Crate>
}
interface CrateWire {
  count: string
  children: ReadonlyArray<CrateWire>
}

const Crate = Schema.Struct({
  count: Schema.FiniteFromString,
  children: Schema.Array(Schema.suspend((): Schema.Codec<Crate, CrateWire> => Crate))
})

const SemicolonNumbers = Schema.String.pipe(
  Schema.decodeTo(Schema.Array(Schema.String), SchemaTransformation.transform({
    decode: (text): ReadonlyArray<string> => text.split(";"),
    encode: (items) => items.join(";")
  })),
  Schema.decodeTo(Schema.Array(Schema.FiniteFromString))
)

// expect-result: {"crate":{"count":2,"children":[{"count":1,"children":[]}]},"numbers":[2,5,8]}
export effect function main() {
  const crate = try Schema.decodeUnknownEffect(Crate)({ count: "2", children: [{ count: "1", children: [] }] })
  const numbers = try Schema.decodeEffect(SemicolonNumbers)("2;5;8")
  return { crate, numbers }
}
