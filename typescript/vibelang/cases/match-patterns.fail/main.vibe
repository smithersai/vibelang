// expect: EK4701 EK4702 EK4703 EK4704 EK4705 EK0107
error NotFound { id: string }
error Timeout

export function missing(e: NotFound | Timeout) {
  return match (e) {
    when NotFound: "no user";
  }
}

export function bindInOr(x: unknown) {
  return match (x) {
    when [let a] or { length: let a }: 1;
    default: 0;
  }
}

export function bindInForHead(xs: number[]) {
  // A for head whose initializer is a var list has no let list to hold the
  // bindings of its test (is-home-for-head gives every other head form a
  // home).
  for (var i = 0; xs is [let first]; i++) i++
  return xs.length
}

export function regex(s: string) {
  return match (s) {
    when /^a/: "a";
    default: "other";
  }
}

export function mixed(n: number) {
  return match (n) {
    when 1 and Number or 3: "mixed";
    default: "other";
  }
}
