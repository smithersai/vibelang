// expect: EK0501
// Chapter 10 "Callbacks into plain JavaScript": Array.prototype.map calls this
// callback synchronously, as a plain function (VIP-1), so it can't run the
// lookup: try there is EK0501. Without try it returns each Effect unrun, as data.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

function allUsers(ids: ReadonlyArray<string>) {
  const users = ids.map((id) => try (try Users).find(id))   // rejected
  return users
}
