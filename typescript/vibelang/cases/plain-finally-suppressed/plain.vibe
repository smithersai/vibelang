// A finally block that fails while a defect is in flight, in a function that
// compiles to plain JavaScript, replaces it, as JavaScript's does (VIP-4):
// the cleanup's exception leaves alone, and no SuppressedError is made. In an
// Effect function the two join (D340), and the Exit holds both reasons, in
// order (D341).
error Bad

function crash(label: string): number {
  return (undefined as any)[label]
}

// Plain, so a TypeScript caller calls it directly.
export function both(): number {
  try { return crash("first") }
  finally { crash("second") }
}

// A defect in flight, replaced by a third.
export function nested(): number {
  try { return both() }
  finally { crash("third") }
}

// Unannotated, and still plain: a function is an Effect function only when
// marked effect (VIP-1).
export function direct() {
  try { return crash("first") }
  finally { crash("second") }
}

// The cleanup's exception replaces the Bad in flight, and a plain function's
// catch is JavaScript's catch (VIP-4), which catches it, so mixed returns.
function mixed() {
  try {
    try { raise(new Bad()) }
    finally { crash("cleanup") }
  } catch { return "caught" }
}

// The same code in frames.
effect function framed() {
  try yieldNow()
  try { return crash("first") }
  finally { crash("second") }
}

function name(defect: unknown): string {
  if (defect instanceof Bad) return defect._tag
  return defect instanceof Error ? defect.message.split("'")[1] ?? defect.message : String(defect)
}

export function reasons(outcome: Exit<unknown, unknown>): string {
  if (outcome is Exit.Success(let value)) return "ok"
  return outcome.cause.reasons.map((reason) => reason._tag === "Die" ? `Die(${name(reason.defect)})` : reason._tag).join("+")
}

export effect function report() {
  return {
    both: reasons(try exit(effect { return both() })),
    nested: reasons(try exit(effect { return nested() })),
    direct: reasons(try exit(effect { return direct() })),
    mixed: reasons(try exit(effect { return mixed() })),
    framed: reasons(try exit(framed()))
  }
}

// A synchronous VibeLang function never throws (Will, 2026-10-31): the throw
// these tests need lives in raise.ts, which keeps JavaScript's throw.
import { raise } from "./raise.js"
