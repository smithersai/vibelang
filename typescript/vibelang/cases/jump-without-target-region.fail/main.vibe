// expect: TS1107 TS1107 TS1107 TS1107
// A break or continue with no target is a grammar error, and the file still
// emits, since noEmitOnError is off. Inside a region (a using block, a try
// statement), lowering returns the jump's completion record to the
// function's own body, which has no target to dispatch it to either: it
// emits the jump as written instead of crashing.
error Missing { key: string }

effect function find(key: string): number!Missing {
  if (key === "") throw new Missing({ key })
  return key.length
}

export effect function owned() {
  {
    using r = try Effect.acquireRelease(effect { return 1 }, effect () => {})
    break
  }
}

export effect function caught(keys: ReadonlyArray<string>) {
  const kept: number[] = []
  try {
    kept.push(try find(keys[0]))
  } catch (_) {
    continue
  }
  return kept
}

export effect function labeled() {
  try {
    try find("a")
    break outer
  } finally {
    try Console.log("done")
  }
}

export effect function looped() {
  for (const key of ["a", ""]) {
    try {
      try find(key)
    } catch (_) {
      continue missing
    }
  }
}
