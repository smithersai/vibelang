// "tracing": "all" compiles every named function that compiles to frames
// with a span named after it (D34): declarations, lambdas a variable names,
// and methods, whose span names their class. A lambda without a name, such as
// a callback, runs in its caller's span.
import { Cause } from "effect"

service Greeter {
  greet(): Effect<string, Cause.NoSuchElementError, never>
}

class Hello implements Greeter {
  effect greet() {
    return (try Effect.currentSpan()).name
  }
}

effect function inner() {
  return (try Effect.currentSpan()).name
}

const viaArrow = effect (): string!Cause.NoSuchElementError! => (try Effect.currentSpan()).name

// expect-result: ["inner","viaArrow","Hello.greet",["main"]]
export effect function main() {
  const callback = try Effect.forEach([1], effect () => (try Effect.currentSpan()).name)
  return [try inner(), try viaArrow(), try new Hello().greet(), callback]
}
