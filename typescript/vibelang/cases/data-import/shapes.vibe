// Data types a module exports (D307): the type, the constructors and, for a
// generic one, its definition.
export data Shape {
  Circle { radius: number }
  Square { side: number }
  Dot
}

export data Tree<A> {
  Leaf { value: A }
  Node { left: Tree<A>; right: Tree<A> }
}

export function area(shape: Shape) {
  return match (shape) {
    when { _tag: "Circle", let radius }: 3 * radius * radius;
    when { _tag: "Square", let side }: side * side;
    when { _tag: "Dot" }: 0;
  }
}
