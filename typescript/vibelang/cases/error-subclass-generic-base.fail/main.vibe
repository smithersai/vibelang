// expect: TS2322
// The generated constructor of a subclass of Base<number> takes a number
// value (D278), so a string is rejected where it is written.
class Base<T> extends Data.TaggedError("Base" as string)<{
    readonly _tag: string;
    readonly value: T;
}> {
}
error Child extends Base<number> { own: string }

export function wrong() {
  return new Child({ value: "wrong type", own: "ok" })
}
