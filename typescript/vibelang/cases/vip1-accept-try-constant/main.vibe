// expect-result: {"stamp":true,"constant":8,"voided":"undefined","spanned":true,"bound":"s","cached":["v1","v1"],"annotated":[8,7]}
// VIP-1 flip acceptance cases 7 and 9 (t3code ProviderLatestVersions.vibe:37,
// alchemy stripe Retrieve*Http.vibe): try of an Effect that is not a call (a
// constant, a property, an identifier) runs it, in an argument position too.
const seven: number!! = Effect.succeed(7)

export const stamp = effect () => {
  const now = DateTime.toEpochMillis(try DateTime.now)
  return typeof now === "number"
}

export const constant = effect () => Math.max(try seven, 1) + 1

// The t3code site: inside effect { } passed to withSpan.
export const spanned = effect () =>
  try withSpan(
    effect {
      const now = DateTime.toEpochMillis(try DateTime.now)
      return now > 0
    },
    "spanned",
  )

// The stripe sites: an Effect bound to a name, run in an object literal.
export const bound = effect (s: string) => {
  const id = Effect.succeed(s)
  return effect () => {
    const request = { id: try id }
    return request.id
  }
}

// The t3code site exactly: a generic service member written as an effect
// arrow in Service.of({ … }), whose withSpan block runs try DateTime.now.
export service Versions {
  static readonly key = "Versions"
  cached: <E, R>(key: string, lookup: string!E!R) => string!E!R
}

export const makeVersions = effect () =>
  try withSpan(
    effect {
      const entries = try Ref.make(new Map<string, { readonly version: string; readonly at: number }>())
      return Versions.of({
        cached: effect (key, lookup) =>
          try withSpan(
            effect {
              const now = DateTime.toEpochMillis(try DateTime.now)
              const existing = (try Ref.get(entries)).get(key)
              if (existing) return existing.version
              const version = try lookup
              try Ref.update(entries, (current) => new Map(current).set(key, { version, at: now }))
              return version
            },
            "Versions.cached",
          ),
      })
    },
    "Versions.make",
  )

// Under an annotated declaration, in an argument and an array.
export const annotated = effect () => {
  const a: number = Math.abs(try seven) + 1
  const b: Array<number> = [try seven]
  return [a, b[0]]
}

export effect function main() {
  const versions = try makeVersions()
  const cached = [try versions.cached("k", Effect.succeed("v1")), try versions.cached("k", Effect.succeed("v2"))]
  const voided = try Effect.void
  const inner = try bound("s")
  return {
    stamp: try stamp(),
    constant: try constant(),
    voided: typeof voided,
    spanned: try spanned(),
    bound: try inner(),
    cached,
    annotated: try annotated(),
  }
}
