// expect: EK0402 EK0402 EK0402 EK0402 EK0402 EK0402 EK0402
// Loop round 4, OPUS-1: VIP-39 makes a JSX attribute an object member under
// the VIP-4 assignability rule, so <button onClick={risky}> must give what
// take({ onClick: risky }) gives in .vibe. A foreign function whose @throws
// does not fit an untagged callback type is EK0402 as an argument, an object
// member, a spread member, an initializer, an array element, a return
// against a written type and an argument to a .vibe function's callback
// parameter alike; @throws {never} fits.
import { risky, safe, take, call } from "./handlers.ts"

function run(f: () => void) {
  f()
}

function back(): () => void {
  return risky
}

export function sites() {
  call(risky)
  take({ onClick: risky })
  take({ ...{ onClick: risky } })
  const handler: () => void = risky
  const handlers: Array<() => void> = [risky]
  run(risky)
  call(safe)
  take({ onClick: safe })
  take({ ...{ onClick: safe } })
  const fine: () => void = safe
  const fines: Array<() => void> = [safe]
  run(safe)
  return [handler, handlers, fine, fines, back]
}

// Appendix B: EK0402 — spec-rule: docs/design/src/900-appendices.md#c728c39fcabeee37
