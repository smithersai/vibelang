service Flags {
  static readonly key = "vip-types/Flags"
  static readonly defaultValue = () => ({ enabled: true })
  enabled: boolean
}

abstract class Value { abstract value: string }
class Concrete extends Value { value = "ordinary" }

export effect function read(): boolean!! { return (try Flags).enabled }

// expect-result: {"defaultValue":true,"override":false,"key":"vip-types/Flags","ordinary":"ordinary"}
export effect function main() {
  const defaultValue = try read()
  let override = true
  provide Layer.succeed(Flags, { enabled: false }) { override = try read() }
  return { defaultValue, override, key: Flags.key, ordinary: new Concrete().value }
}
