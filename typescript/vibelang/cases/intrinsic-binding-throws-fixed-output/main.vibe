// expect: EK0403
// expect-result: [["Success","value"],["Failure",["Fail"]],["Failure",["Die"]],3]
import { parse, describe, count } from "./lib.js"
export effect function probe(s:string):unknown!RangeError! { return try ((foreignRangeErrorClass: typeof RangeError) => Effect.catch(Effect.try({ try: () => parse(s), catch: (error) => error }), (error) => error instanceof foreignRangeErrorClass ? Effect.fail(error) : Effect.die(error)))(RangeError) }
export effect function main() {
 const good = try Effect.exit(probe('"value"'))
 const bad = try Effect.exit(probe("listed"))
 const unexpected = try Effect.exit(probe("defect"))
 return [describe(good),describe(bad),describe(unexpected),count()]
}
