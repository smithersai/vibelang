// expect-result: {"answered":{"_tag":"Updated"},"overridden":{"_tag":"Updated"},"hung":true}
// A lambda given for an optional member, as in a `Partial<Service>` of
// overrides, takes its contract from the member's function type: one that
// returns a program returns it unrun (D269), as it does for a required member.
interface Outcome {
  _tag: "Updated"
}

interface Store {
  heartbeat: (runId: string) => Outcome!never
}

const layerNoop = (overrides: Partial<Store> = {}): Store => ({
  heartbeat: effect () => ({ _tag: "Updated" as const }),
  ...overrides
})

const hanging = layerNoop({ heartbeat: () => Effect.never })
const answering = layerNoop({ heartbeat: effect () => try Effect.succeed({ _tag: "Updated" as const }) })

export effect function main() {
  const answered = try layerNoop().heartbeat("run")
  const overridden = try answering.heartbeat("run")
  const hung = hanging.heartbeat("run") |> try Effect.timeoutOption(%, "20 millis")
  return { answered, overridden, hung: Option.isNone(hung) }
}
