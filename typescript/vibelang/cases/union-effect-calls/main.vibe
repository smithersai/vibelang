// expect-result: ["ok",42,"ok",42,1,"refused",6]
import { Effect } from "effect"
import { choose, bootstrap, counts } from "./callbacks.js"

export effect function direct(flag: boolean) {
  const value = try choose(flag)
  return value
}
export effect function byName(flag: boolean) {
  return try Effect.map(choose(flag), (value) => value)
}
function readCounts(): number { return counts() }
export effect function main() {
  const a = try direct(true)
  const b = try direct(false)
  const c = try byName(true)
  const d = try byName(false)
  const args = try bootstrap(false)
  let failure = "missing"
  try { try bootstrap(true) } catch (error) { failure = error }
  try choose(true)
  return [a, b, c, d, args.length, failure, readCounts()]
}
