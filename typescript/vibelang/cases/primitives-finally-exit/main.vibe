// expect-result: {"ok":"Success","failing":"Failure:Boom","returned":"value"}
error Boom

effect function ok() {
  let tag = ""
  try {
    try sleep("1 millis")
  } finally (exit) {
    tag = exit._tag
  }
  return tag
}

// The finally block sees the failure; the failure still propagates.
effect function failing() {
  let tag = ""
  try {
    try {
      throw new Boom()
    } finally (exit) {
      tag = Exit.isFailure(exit) ? "Failure" : "Success"
    }
  } catch (e) {
    tag += ":" + e._tag
  }
  return tag
}

effect function returned() {
  try {
    return "value"
  } finally (exit) {
    try Console.log(exit._tag)
  }
}

export effect function main() {
  return { ok: try ok(), failing: try failing(), returned: try returned() }
}
