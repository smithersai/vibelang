// expect-result: {"ok":"Success","failing":"Failure:Boom","returned":"value"}
error Boom

effect function ok() {
  let tag = ""
  try Effect.onExit(effect { try sleep("1 millis") }, (exit) => effect {
    tag = exit._tag
  })
  return tag
}

// The finalizer sees the failure; recovery follows cleanup.
effect function failing() {
  let tag = ""
  effect {
    try Effect.onExit(effect { throw new Boom() }, (exit) => effect {
      tag = Exit.isFailure(exit) ? "Failure" : "Success"
    })
  } catch (e) => { tag += ":" + e._tag }
  return tag
}

effect function returned() {
  return try Effect.onExit(effect { return "value" }, (exit) => effect {
    try Console.log(exit._tag)
  })
}

export effect function main() {
  return { ok: try ok(), failing: try failing(), returned: try returned() }
}
