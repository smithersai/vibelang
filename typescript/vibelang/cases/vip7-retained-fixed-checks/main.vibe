function variants(): number {
  const some: unknown = Option.some(1)
  const none: unknown = Option.none()
  const success: unknown = Exit.succeed(2)
  const failure: unknown = Exit.fail("e")
  const ok: unknown = Result.succeed(3)
  const bad: unknown = Result.fail("f")
  return [
    match (some) { when Option.Some(let v): v === 1; default: false; },
    match (none) { when Option.None(): true; default: false; },
    match (success) { when Exit.Success(let v): v === 2; default: false; },
    match (failure) { when Exit.Failure(let cause): Cause.isCause(cause); default: false; },
    match (ok) { when Result.Success(let v): v === 3; default: false; },
    match (bad) { when Result.Failure(let e): e === "f"; default: false; },
  ].filter((x) => x).length
}

export effect function main() {
  return { tagged: tagged(), variants: variants(), misses }
}
