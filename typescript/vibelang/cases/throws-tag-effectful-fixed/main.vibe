// expect-result: {"tagged":1,"ran":2,"loaded":3,"arrow":4,"streamed":[5,6],"found":"repo","add":3,"maybe":true,"ts":7}
// VIP-4, amended 2026-10-31: VibeLang functions never throw, so they have no
// thrown type, and a @throws or @rethrows tag anywhere in a .vibe file is
// EK0406: on an effect function, arrow, method or producer, on a plain
// function, on a function returning a Stream, a Layer or a union, and on a
// type's member. Its quick fix removes the tag (throws-tag-effectful-fixed).
// Tags in TypeScript files are read as before (helpers.ts).
import { tsLoad } from "./helpers.ts"

error Absent

effect function badTag(fail: boolean): number!Absent {
  if (fail) throw new Absent()
  return 1
}

/**
 * Runs f.
 */
effect function run(f: () => number) { return f() }

effect function load(f: () => number): number!! { return f() }

const viaArrow = effect () => 4

function numbers(): Stream<number> { return Stream.make(5, 6) }

function live(): Layer<never> { return Layer.empty }

class Repo {
  effect find(): string!Absent { return "repo" }
}

function add(a: number, b: number): number { return a + b }

function maybe(): (number!!) | undefined { return undefined }

export type Reader = {
  read(): string
}

export effect function main() {
  const tagged = try badTag(false)
  const ran = try run(() => 2)
  const loaded = try load(() => 3)
  const arrow = try viaArrow()
  const streamed = try Stream.runCollect(numbers())
  try Effect.provide(Effect.void, live())
  const found = try new Repo().find()
  const ts = try tsLoad(() => 7)
  return { tagged, ran, loaded, arrow, streamed, found, add: add(1, 2), maybe: maybe() === undefined, ts }
}
