// expect: EK2118
// A subclass that declares fields and no constructor passes them to its

import * as $ErrorData from "effect/Data"
// base's constructor, which here takes positional arguments.
class Base extends $ErrorData.TaggedError("Base" as string)<{
    readonly _tag: string;
    readonly code: string;
}> {

  constructor(code: string, note: string) {
    super({ code: `${code}:${note}` })
  }
}

export error Child extends Base { extra: number }
