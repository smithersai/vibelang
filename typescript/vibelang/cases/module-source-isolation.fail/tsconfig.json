{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out"
  },
  "vibe": {
    "effectGlobals": false,
    "effectModules": false
  },
  "include": [
    "*.vibe"
  ]
}
