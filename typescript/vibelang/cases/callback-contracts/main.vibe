// A callback that may run Effects declares its channels as type parameters
// (design D500): mapAll's E and R come from each call's callback.
class NotFound extends TaggedError("NotFound")<{ readonly id: string }> {}

function find(id: string) {
  if (id === "") throw new NotFound({ id })
  try Effect.sleep("1 millis")
  return `user-${id}`
}

export function mapAll<A, B, E, R>(items: ReadonlyArray<A>, f: (a: A) => B!E!R) {
  const out: B[] = []
  for (const item of items) out.push(try f(item))
  return out
}

// A contract on the callback restricts it: this callback cannot fail.
export function mapSafe<A, B>(items: ReadonlyArray<A>, f: (a: A) => Effect<B, never, never>) {
  return items.length === 0 ? [] : [try f(items[0])]
}

export function withRetry<A, E, R>(times: number, program: () => A!E!R) {
  return try Effect.retry(program, { times })
}

let attempts = 0

function flaky() {
  attempts++
  if (attempts < 3) throw new NotFound({ id: `attempt ${attempts}` })
  return attempts
}

// expect-result: {"names":["user-1","user-2"],"sizes":[1,3],"safe":[2],"retried":3,"caught":"NotFound"}
export function main() {
  const names = try mapAll(["1", "2"], (id) => find(id))
  const sizes = try mapAll(["a", "bcd"], (w) => w.length)
  const safe = try mapSafe([1], (n) => n * 2)
  const retried = try withRetry(5, () => flaky())
  let caught = "none"
  try {
    try mapAll([""], (id) => find(id))
  } catch (e) {
    caught = e._tag
  }
  return { names, sizes, safe, retried, caught }
}
