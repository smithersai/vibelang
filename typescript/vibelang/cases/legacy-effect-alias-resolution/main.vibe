// Each use that resolves to the prelude alias warns; imported.vibe and
// shadow.vibe spell the same name for an imported and a local type and stay quiet.
export type Bare = Effect<number>
export type Full = Effect<number, string, never>
export type Nested = ReadonlyArray<Effect<string>>
