import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"found":"Ada","slow":"Timeout","missing":"none","count":3,"plain":"ok"}
error NotFound { id: string }
error Timeout

// Success, errors, and no dependencies.
export effect function find(id: string): string!NotFound! {
  if (id === "42") return "Ada"
  throw new NotFound({ id })
}

// Dependencies left out: the body supplies them. The union is the error slot.
export effect function lookup(id: string): string!(NotFound | Timeout) {
  if (id === "slow") throw new Timeout()
  return try find(id)
}

// Neither errors nor dependencies.
export effect function count(): number!! {
  return 3
}

// Effect types in an alias, a function type, and a parameter.
export type Finder = (id: string) => string!NotFound!
export type Scoped = string!NotFound!Scope
export type Values = ReadonlyArray<number!!>

effect function tryFind(f: Finder, id: string) {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try f(id)) };
  }, effect (error) => {
    return { kind: "return:" as const, value: ("none") };
  });
return $nativeTryCompletion.value;
}
}

effect function describe(id: string) {
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    return { kind: "return:" as const, value: (try lookup(id)) };
  }, effect (error) => {
    return { kind: "return:" as const, value: (error._tag) };
  });
return $nativeTryCompletion1.value;
}
}

export effect function main() {
  return { found: try lookup("42"), slow: try describe("slow"), missing: try tryFind(find, "7"), count: try count(), plain: "ok" }
}
