{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "*.vibe",
    "*.ts"
  ],
  "vibe": {
    "severities": {
      "EK3801": "warning",
      "EK38104": "warning"
    }
  }
}