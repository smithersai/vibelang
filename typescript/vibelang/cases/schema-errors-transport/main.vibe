import { Cause, Data, Effect, Exit, Schema } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
schema error Wire { value: Schema.BigIntFromString }
schema error Native { value: Schema.BigInt }
error Plain { value: bigint }
export effect function main() {
  const encoded = try Schema.encodeEffect(Wire)(new Wire({ value: 12n }))
  const decoded = try Schema.decodeUnknownEffect(Wire)({ _tag: "Wire", value: "15" })
  const json = try Effect.try(() => JSON.stringify(encoded))
  const native = try Schema.encodeEffect(Native)(new Native({ value: 12n }))
  const unsupported = try Effect.exit(Effect.try(() => JSON.stringify(native)))
  return [encoded.value, typeof encoded.value, decoded.value.toString(), json.includes('"value":"12"'), Exit.isFailure(unsupported), Schema.isSchema(Plain)]
}

