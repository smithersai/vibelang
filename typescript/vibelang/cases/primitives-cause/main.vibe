import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"typed":"NotFound","defect":"Die","rethrown":"Boom","onlyCause":"Fail","untyped":"Expected"}
error NotFound { id: string }
error Boom

effect function find(id: string): string!NotFound! {
  if (id === "missing") throw new NotFound({ id })
  if (id === "bug") try die(new Error("bug"))
  return id
}

effect function boom() {
  throw new Boom()
}

// Catch expected failures inside exit; defects remain in its Failure case.
effect function typed() {
  const outcome = try exit(effect { // exit takes an Effect; a do block is a value (VIP-1, VIP-2)
    return find("missing") catch (e) => e._tag
  })
  if (outcome._tag === "Success") return outcome.value
  return "cause"
}

effect function defect() {
  const outcome = try exit(find("bug"))
  if (outcome._tag === "Success") return outcome.value
  return outcome.cause.reasons[0]._tag
}

effect function rethrown() {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    const outcome = try exit(boom())
    if (outcome._tag === "Failure") try Effect.failCause(outcome.cause)
    return { kind: "return:" as const, value: ("no") };
  }, effect (e) => {
    return { kind: "return:" as const, value: (e._tag) };
  });
return $nativeTryCompletion.value;
}
}

effect function onlyCause() {
  const outcome = try exit(boom())
  if (outcome._tag === "Success") return "no"
  return outcome.cause.reasons[0]._tag
}

effect function untyped() {
  const outcome = try exit(effect {
    return effect { try boom(); return "no" } catch () => "Expected"
  })
  if (outcome._tag === "Success") return outcome.value
  return "cause"
}

export effect function main() {
  return { typed: try typed(), defect: try defect(), rethrown: try rethrown(), onlyCause: try onlyCause(), untyped: try untyped() }
}
