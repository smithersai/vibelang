{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "outDir": "out",
    "declaration": true,
    "vibelang": {
      "diagnostics": {
        "EK4840": "warning"
      }
    }
  },
  "include": [
    "*.vibe"
  ]
}
