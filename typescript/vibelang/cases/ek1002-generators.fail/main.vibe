// expect: EK1002
// In a .vibe file function* declares a producer, so APIs that take a JavaScript
// generator are EK1002 (Chapter 10). TypeScript's errors inside the generator
// are hidden, and .ts files in the same program may use these APIs.
import { Effect, Option } from "effect"
import { fromTypeScript } from "./helpers.ts"

export const findName = effect (id: string) => try Effect.gen(function* () {
  const n = yield* try Effect.succeed(id.length)
  return n
})

export const traced = Effect.fn("traced")(function* (n: number) {
  return yield* try Effect.succeed(n)
})

export const maybe = Option.gen(function* () {
  const a = yield* Option.some(1)
  return a + 1
})

function* body() {
  yield* try Effect.succeed(1)
  return 2
}

export const named = effect () => try Effect.gen(body)
export const fromTs = fromTypeScript
