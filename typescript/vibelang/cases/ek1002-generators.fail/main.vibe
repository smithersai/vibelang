// expect: EK1002
// VIP-21: effect function* declares a Stream producer. Passing one to an API
// that takes a JavaScript generator is EK1002; native function* is allowed.
// Each rejected argument is a well-formed producer, rather than a native generator.
import { Effect, Option } from "effect"
import { fromTypeScript } from "./helpers.ts"

export const findName = effect (id: string) => try Effect.gen(effect function* () {
  yield try Effect.succeed(id.length)
})

export const traced = Effect.fn("traced")(effect function* (n: number) {
  yield try Effect.succeed(n)
})

export const maybe = Option.gen(effect function* () {
  yield Option.some(1)
})

effect function* body() {
  yield try Effect.succeed(1)
}

export const named = effect () => try Effect.gen(body)
export const fromTs = fromTypeScript
