import { Effect } from "effect"
import { raise } from "./raise.js"
function mul(effect: number) { return effect * 2 }
function call(effect: (n: number) => number) { return effect(2) }
function caught() { try
  { raise(2) } catch (error) { return error as number }
}
const native = { async effect() { return 3 } }
const bare: (effect: number) => Promise<number> = async effect => effect + 1
const obj = { effect async() { return 6 }, effect get() { return 2 } }
export effect function main() {
  return [mul(3), call(n => n + 1), try obj.async(), try obj.get(), try Effect.promise(() => native.effect()), try Effect.promise(() => bare(8)), caught()]
}

