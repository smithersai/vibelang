import { Data, Effect } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
data Empty {}
export const exact: Equal<Empty, never> = true
export effect function main() { return Object.keys(Empty) }

