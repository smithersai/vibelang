import { Effect, Option, Data } from "effect"
export function ordinary(s:Date|{kind:string}) { return match(s) { when not Date: s.kind; default: s.getUTCFullYear(); } }
export function literal(s:"a"|"b"|null|undefined):"b"|"other" { return match(s) { when not ("a" or null or undefined): s; default: "other"; } }
export function predicate(s:string|number) { const p=(x:string|number):x is string=>typeof x==="string";return match(s) { when not p: s.toFixed(1); default:s.toUpperCase(); } }
export function opaque(s:string|number):string|number { const p=(x:unknown):boolean=>typeof x==="string";return match(s) { when not p: do { const a: typeof s=1; const b:typeof s="x"; s }; default: do { const a:typeof s=1; const b:typeof s="x"; s }; } }
export function own(s:string|number):string|number { class C { static [customMatcher](x:unknown):boolean {return typeof x==="string"} };return match(s){when not C:do{const a:typeof s=1;const b:typeof s="x";s};default:do{const a:typeof s=1;const b:typeof s="x";s};} }
class Plain {n=1}
function ordinaryClass(s:Plain|{kind:string}) {return match(s){when not Plain:s.kind;default:s.n;}}
function primitive(s:string|number){return match(s){when not String:s.toFixed(0);default:s.toUpperCase();}}
function fixed(s:Option.Option<number>){return match(s){when not Option.Some:do{const tag:"None"=s._tag;tag};default:s.value;}}
error E {id:string}
function tagged(s:E|{_tag:"Other";n:number}){return match(s){when not E:s.n;default:s.id;}}
export function main():Effect.Effect<readonly unknown[]> { return Effect.sync(()=>[ordinary(new Date(0)),ordinary({kind:"k"}),literal("a"),literal("b"),literal(null),literal(undefined),predicate("Ab"),predicate(2),opaque(2),opaque("x"),own(2),own("x"),ordinaryClass(new Plain()),ordinaryClass({kind:"k"}),primitive(2),primitive("x"),fixed(Option.none()),fixed(Option.some(3)),tagged(new E({id:"e"})),tagged({_tag:"Other",n:7})]) }
