// The prelude wire resolves to the retired intrinsic; the local wire in
// shadow() is an ordinary TypeScript binding and adds no diagnostic.
service A { static readonly key = "w02/wire-target/A"; value: string }
const LA = Layer.succeed(A, { value: "a" })
