// expect-result: {"value":"detached","held":"held","events":["acquired","released"]}
// An Effect whose success is a function: running it gives the function, which
// is its result, not a thunk to call. foldkit-15: port.vibe acquires a channel
// subscription whose resource is the function that detaches it. takes returns
// the Effect it is given (no by-name passing, VIP-1), so held is run with try.
const events: Array<string> = []

const takes = (program: (() => string)!!): (() => string)!! => program

export effect function main() {
  const value = try Effect.scoped(effect {
    const detach = try Effect.acquireRelease(
      Effect.sync((): (() => string) => {
        events.push("acquired")
        return (): string => "detached"
      }),
      effect (release) => try Effect.sync(() => { events.push("released"); release() }),
    )
    return detach()
  })
  const held = takes(Effect.sync((): (() => string) => (): string => "held"))
  return { value, held: (try held)(), events }
}
