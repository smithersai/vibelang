// expect-result: [true, true]
service Flags {
 static readonly key = "tsforms/Flags"
 static readonly defaultValue: () => Flags.Shape = () => ({ enabled: true, count: 2 })
 enabled: boolean
 count: number
}
export type Value = (typeof Flags.defaultValue extends (...args: any) => infer __VibeDefault ? __VibeDefault : never)
export type Indexed = ((typeof Flags)["defaultValue"] extends (...args: any) => infer __VibeDefault ? __VibeDefault : never)
export type Enabled = ((typeof Flags.defaultValue extends (...args: any) => infer __VibeDefault ? __VibeDefault : never))["enabled"]
export type Count = (typeof Flags.defaultValue extends (...args: any) => infer __VibeDefault ? __VibeDefault : never)["count"]
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
export const same: [Equal<Value, Flags.Shape>, Equal<Indexed, Flags.Shape>, Equal<Enabled, boolean>, Equal<Count, number>] = [true, true, true, true]
export effect function main(): [boolean, boolean]!! {
 return [Flags.defaultValue().enabled, Flags["defaultValue"]().count === 2]
}
