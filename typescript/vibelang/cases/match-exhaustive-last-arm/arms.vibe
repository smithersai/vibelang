// Every match here is one D209 proves exhaustive, so this module never
// imports $noMatch. The last arm keeps its tests as a check that adds no
// branch (D405).
export type Phase = "draft" | "review" | "published"

export error NotFound { id: string }
export error Timeout
export error Denied { user: string }

export type Failure = NotFound | Timeout | Denied

// After return.
export function phaseLabel(phase: Phase): string {
  return match (phase) {
    when "draft": "Draft";
    when "review": "Review";
    when "published": "Published";
  }
}

// Inside an expression, where the match runs in its own function.
export function width(phase: Phase): number {
  const label = match (phase) {
    when "draft": 5;
    when "review": 6;
    when "published": 9;
  }
  return label
}

// As a statement.
export function record(phase: Phase, log: Array<string>) {
  match (phase) {
    when "draft": log.push("draft");
    when "review": log.push("review");
    when "published": log.push("published");
  }
}

// The last arm still binds user and n.
export function describe(failure: Failure) {
  return match (failure) {
    when NotFound and { let id }: `no user ${id}`;
    when Timeout: "retry";
    when Denied and { let user }: `denied ${user}`;
  }
}

export function greeting(name: Option.Option<string>) {
  return match (name) {
    when Option.None: "Hello";
    when Option.Some(let n): `Hello, ${n}`;
  }
}

// In an Effect function, whose arms run Effects.
export function announce(phase: Phase) {
  match (phase) {
    when "draft": try Effect.log("draft");
    when "review": try Effect.log("review");
    when "published": try Effect.log("published");
  }
  return phase
}
