import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"masked":["hold","caught"],"record":["hold","caught"],"held":["hold","caught"]}

// join interrupts the fibers still running when one fails, waits for their
// cleanup, and then fails (Ch 7). Inside uninterruptible { } the join itself
// is masked, but the fibers it waits for are interrupted all the same.
error Bad {}

effect function bad(n: number) {
  if (n > 0) throw new Bad()
  return n
}

// A fiber that waits until something interrupts it, and traces its finally.
effect function hold(ready: Deferred.Deferred<void>, trace: string[]) {
  { const $nativeTryCompletion = try $nativeTryEffect.onExit(effect {
    try Deferred.succeed(ready, undefined)
    try Effect.never
  
;return { kind: "normal" } as const;
}, () => effect {
    trace.push("hold")
  });

}
}

effect function masked() {
  const trace: string[] = []
  uninterruptible {
    const ready = try Deferred.make<void>()
    const held = fork hold(ready, trace)
    try ready.await()
    const failing = fork bad(1)
    const canceled: void!! = Fiber.interruptAll([held, failing])
    Effect.onError(Effect.all([Effect.interruptible(Fiber.join(held)), Effect.interruptible(Fiber.join(failing))], { concurrency: "unbounded" }), () => canceled) catch () => { trace.push("caught") }
  }
  return trace
}

effect function record() {
  const trace: string[] = []
  uninterruptible {
    const ready = try Deferred.make<void>()
    const held = fork hold(ready, trace)
    try ready.await()
    const failing = fork bad(1)
    const canceled: void!! = Fiber.interruptAll([held, failing])
    Effect.onError(Effect.all({
      held: Effect.interruptible(Fiber.join(held)),
      failing: Effect.interruptible(Fiber.join(failing))
    }, { concurrency: "unbounded" }), () => canceled) catch () => { trace.push("caught") }
  }
  return trace
}

// The same join outside a mask, with the held fiber waiting in its own restore.
effect function held() {
  const trace: string[] = []
  const ready = try Deferred.make<void>()
  const fiber = fork effect {
    { const $nativeTryCompletion1 = try $nativeTryEffect1.onExit(effect {
      uninterruptible {
        try Deferred.succeed(ready, undefined)
        restore { try Effect.never }
        trace.push("not interrupted")
      }
    
;return { kind: "normal" } as const;
}, () => effect {
      trace.push("hold")
    });

}
  }
  try ready.await()
  const failing = fork bad(1)
  const canceled: void!! = Fiber.interruptAll([fiber, failing])
  Effect.onError(Effect.all([Effect.interruptible(Fiber.join(fiber)), Effect.interruptible(Fiber.join(failing))], { concurrency: "unbounded" }), () => canceled) catch () => { trace.push("caught") }
  return trace
}

export effect function main() {
  return { masked: try masked(), record: try record(), held: try held() }
}
