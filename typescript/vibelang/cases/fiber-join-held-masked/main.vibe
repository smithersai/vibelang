// expect-result: {"masked":["hold","caught"],"record":["hold","caught"],"held":["hold","caught"]}

// join interrupts the fibers still running when one fails, waits for their
// cleanup, and then fails (Ch 7). Inside uninterruptible { } the join itself
// is masked, but the fibers it waits for are interrupted all the same.
error Bad {}

effect function bad(n: number) {
  if (n > 0) throw new Bad()
  return n
}

// A fiber that waits until something interrupts it, and traces its finally.
effect function hold(ready: Deferred.Deferred<void>, trace: string[]) {
  try {
    try Deferred.succeed(ready, undefined)
    try Effect.never()
  } finally {
    trace.push("hold")
  }
}

effect function masked() {
  const trace: string[] = []
  uninterruptible {
    const ready = try Deferred.make<void>()
    const held = fork hold(ready, trace)
    try ready.await()
    const failing = fork bad(1)
    try {
      join [held, failing]
    } catch (e) {
      trace.push("caught")
    }
  }
  return trace
}

effect function record() {
  const trace: string[] = []
  uninterruptible {
    const ready = try Deferred.make<void>()
    const held = fork hold(ready, trace)
    try ready.await()
    const failing = fork bad(1)
    try {
      join { held, failing }
    } catch (e) {
      trace.push("caught")
    }
  }
  return trace
}

// The same join outside a mask, with the held fiber waiting in its own restore.
effect function held() {
  const trace: string[] = []
  const ready = try Deferred.make<void>()
  const fiber = fork {
    try {
      uninterruptible {
        try Deferred.succeed(ready, undefined)
        restore { try Effect.never() }
        trace.push("not interrupted")
      }
    } finally {
      trace.push("hold")
    }
  }
  try ready.await()
  const failing = fork bad(1)
  try {
    join [fiber, failing]
  } catch (e) {
    trace.push("caught")
  }
  return trace
}

export effect function main() {
  return { masked: try masked(), record: try record(), held: try held() }
}
