// expect: EK2110 EK2119 TS2322 TS2345
// A resume that is not its clause's last step returns what the handle ends
// with next: the try block's result, or what a clause returns when the block
// performs an operation again before it ends (D97). Each function below
// compiled before and failed or returned the wrong value when it ran.

control Steps {
  first(): void!!
  second(): void!!
}

effect function work() {
  try Steps.first()
  try Steps.second()
  return 42
}

// TS2322: the second clause ends the statement with "early", which the first
// clause's resume then returns.
export effect function early() {
  try {
    return try work()
  } handle Steps.first() {
    const n: number = try resume()
    return n.toFixed(1)
  } handle Steps.second() {
    return "early"
  }
}

function half(n: number) {
  return n / 2
}

// TS2345: the same result, passed where a number is expected.
export effect function passed() {
  try {
    return try work()
  } handle Steps.first() {
    return half(try resume())
  } handle Steps.second() {
    return "early"
  }
}

control Once {
  step(): void!!
}

effect function twice() {
  try Once.step()
  try Once.step()
  return 42
}

// TS2322: the clause answers the second step first, and its string reaches
// the resume that answers the first.
export effect function nested() {
  try {
    return try twice()
  } handle Once.step() {
    const n: number = try resume()
    return n.toFixed(1)
  }
}

// TS2322: a try block that ends without returning ends the statement with
// undefined.
export effect function falls() {
  try {
    try twice()
  } handle Once.step() {
    const n: number = try resume()
    try Console.log(n.toFixed(1))
  }
}

// TS2322: a break out of the statement ends it with undefined too.
export effect function breaks() {
  for (const round of [1, 2]) {
    try {
      try twice()
      break
    } handle Once.step() {
      const n: number = try resume()
      try Console.log(round, n.toFixed(1))
    }
  }
}

let calls = 0

// TS2322: a clause that ends without resuming ends the statement with
// undefined, which the first step's resume then returns.
export effect function stops() {
  try {
    return try twice()
  } handle Once.step() {
    calls++
    if (calls === 2) {
      try Console.log("second step stops")
    } else {
      const n: number = try resume()
      return n + 1
    }
  }
}

// EK2110: handle types resume's result with the program's, number, but the
// second clause can end the handle with "early" first.
export effect function expression() {
  return try handle(effect { return try work() }, Steps, {
    effect first(k) {
      const n: number = try resume(k, undefined)
      return n.toFixed(1)
    },
    effect second(k) {
      return "early"
    }
  })
}

// EK2110: with onReturn, resume's result is typed never.
export effect function transformed() {
  return try handle(effect { return try work() }, Steps, {
    effect first(k) {
      const n: number = try resume(k, undefined)
      return n + 1
    },
    effect second(k) {
      return try resume(k, undefined)
    }
  }, effect (n) => `${n}`)
}

// D351: the inferred answer type excludes this resume-dependent return.
// This used to run in handle-resume-result with only an EK2119 warning.
export effect function unwritten() {
  try {
    return try work()
  } handle Steps.first() {
    return `${try resume()} first`
  } handle Steps.second() {
    try resume()
  }
}
