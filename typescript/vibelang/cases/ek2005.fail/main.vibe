// expect: EK2005
// resumeWith runs its program at the perform site: it may need no service and
// may fail only with the operation's declared errors (D17). Two programs break
// those rules; the clause in allowed() keeps them.
import { Data, Effect } from "effect"
import { Control, handle, resumeWith } from "vibelang-runtime"

class Busy extends Data.TaggedError("Busy")<{}> {}
class Other extends Data.TaggedError("Other")<{}> {}

abstract class Approval extends Control {
  abstract approve(request: string): Effect.Effect<boolean, Busy, never>
}

service Secret {
  read(): Effect.Effect<boolean, never, never>
}

export effect function needsService() {
  return try handle(effect { return try Approval.approve("x") }, Approval, {
    effect approve(_request, k) { return try resumeWith(k, effect { return try Secret.read() }) }
  })
}

export effect function undeclaredError() {
  return try handle(effect { return try Approval.approve("x") }, Approval, {
    effect approve(_request, k) { return try resumeWith(k, effect { throw new Other() }) }
  })
}

export effect function allowed() {
  return try handle(effect { return try Approval.approve("x") }, Approval, {
    effect approve(_request, k) {
      const secret = try Secret.read()
      if (secret) return try resumeWith(k, effect { throw new Busy() })
      return try resumeWith(k, effect { return secret })
    }
  })
}
