// expect: EK4838
// A getter is a function literal, so a getter that returns an owned fiber
// captures it, even in an object literal that a const of the region holds
// and only join reads (D409). The literal itself may hold the fiber: join
// of such a const is allowed (fibers-join-record).
export effect function main() {
  const fiber = fork { return "A" }
  const tasks = {
    get task() {
      return fiber
    }
  }
  return join tasks
}
