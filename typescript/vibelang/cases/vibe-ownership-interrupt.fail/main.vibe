// expect: EK1002
// Effect.gen's function* is a producer here (VIP-21); calling onLapse only
// builds its Effect (VIP-1), so EK1002 is the one error.
import { Effect } from "effect"

const onLapse = effect (_unconfirmedMs: number) => Effect.void
export const expire = Effect.gen(function* () {
  yield* (try Effect.logWarning("run lease lapsed; interrupting owned work")).pipe(
    Effect.annotateLogs({ runId: "run", unconfirmedMs: 100 }),
    Effect.andThen(onLapse(100)),
    Effect.andThen(Effect.interrupt)
  )
})
