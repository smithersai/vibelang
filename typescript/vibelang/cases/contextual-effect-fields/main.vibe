// expect-result: [0,0,0,0,1,2,3,4,5,6,6]
import { Context, Effect, Layer } from "effect"
let runs = 0
interface JournalShape { read: Effect.Effect<number, never, never> }
class Journal extends Context.Service<Journal, JournalShape>()("Journal") {}
const makeNoop = (): JournalShape => ({ read: Effect.sync(() => ++runs) })
const layer = Layer.sync(Journal, () => ({ read: Effect.sync(() => ++runs) }))
const make = (value: JournalShape): JournalShape => value
effect function read() { return try Effect.sync(() => ++runs) }
function plainRead() { runs++; return runs }
const atTop: JournalShape = { read: Effect.sync(() => ++runs) }
export effect function main() {
  const before = runs
  const noop = makeNoop()
  const afterNoop = runs
  const passed = make({ read: read() })
  const afterPassed = runs
  const declared: JournalShape = { read: (plainRead()) }
  const afterDeclared = runs
  const a = try noop.read()
  const b = try passed.read()
  const c = try declared.read()
  const d = try Effect.provide(effect { return try Journal.read() }, layer)
  const eager: { read: number } = { read: try Effect.sync(() => ++runs) }
  const top = try atTop.read()
  return [before, afterNoop, afterPassed, afterDeclared, a, b, c, d, eager.read, top, runs]
}
