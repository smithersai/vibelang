// expect-result: {"tag":"NotFound","name":"NotFound","encoded":{"_tag":"NotFound","method":"read","attempts":2},"decoded":{"tag":"NotFound","method":"stat","family":true},"base":{"tag":"FsError","encoded":{"_tag":"FsError","method":"open","path":"/x"}},"isNotFound":false,"routed":"not found 2","locked":"held by ann"}
// D279: schema error declares an error class whose fields are schemas, so it
// encodes and decodes. D278's class rules apply: a subclass extends it with
// its own tag, and the body may hold methods.

/** The base of a family of file system failures. */
export schema error FsError {
  _tag: string
  method: string
  path?: string
}

export schema error NotFound extends FsError { attempts: number }

export schema error Locked {
  holder: string

  describe(): string {
    return `held by ${this.holder}`
  }
}

effect function fail(error: NotFound | Locked): never!(NotFound | Locked) {
  throw error
}

effect function route(error: NotFound | Locked): string!! {
  return fail(error)
    |> Effect.catchTag(%, "NotFound", effect (caught) => `not found ${caught.attempts}`)
    |> try Effect.catchTag(%, "Locked", effect (caught) => caught.describe())
}

export effect function main() {
  const notFound = new NotFound({ method: "read", attempts: 2 })
  const decoded = Schema.decodeUnknownSync(NotFound)({ _tag: "NotFound", method: "stat", attempts: 1 })
  const base = new FsError({ method: "open", path: "/x" })
  return {
    tag: notFound._tag,
    name: notFound.name,
    encoded: Schema.encodeSync(NotFound)(notFound),
    decoded: { tag: decoded._tag, method: decoded.method, family: decoded instanceof FsError },
    base: { tag: base._tag, encoded: Schema.encodeSync(FsError)(base) },
    isNotFound: Schema.is(NotFound)(base),
    routed: try route(notFound),
    locked: try route(new Locked({ holder: "ann" }))
  }
}
