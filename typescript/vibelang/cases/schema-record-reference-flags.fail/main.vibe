// expect: EK2109
// 006-data.md: optional finite Record values are rejected with EK2109
// rule: docs/design/src/006-data.md#a66d1875362e5adb
const Optional = Schema.optionalKey(Schema.Number)
const Mutable = Schema.mutableKey(Schema.Number)
const Alias = Optional
declare const Uncertain: typeof Schema.Number | typeof Optional
namespace Codecs { export const MutableNumber = Mutable }
export schema Writable = Record<"a", Optional>
export schema Frozen = Readonly<Record<"a", Mutable>>
export schema Aliased = Record<"a", Alias>
export schema Widened = Readonly<Record<"a", Uncertain>>
export schema Nested { readonly value: Readonly<Record<string, Codecs.MutableNumber>> }
schema error Problem { value: Record<"a", Optional> }

