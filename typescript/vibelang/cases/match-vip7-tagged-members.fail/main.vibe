// expect: EK4701 EK4701 EK4701
const A:unique symbol=Symbol();const B:unique symbol=Symbol();
interface IA{_tag:"A"};interface IB{_tag:"B"};
class CA{readonly _tag="A" as const};class CB{readonly _tag="B" as const};
function symbols(s:{_tag:typeof A}|{_tag:typeof B}){return match(s){when if(false):0;}}
function interfaces(s:IA|IB){return match(s){when {_tag:"A"}:1;}}
function classes(s:CA|CB){return match(s){when {_tag:"A"}:1;}}
