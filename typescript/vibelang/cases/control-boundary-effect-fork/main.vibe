// expect-result: {"forked":1,"detached":2,"timed":3}
// A program forked with Effect's forks that handles its own control
// operations runs: its handler is installed on the child's fiber (chapter 9,
// "Handlers and concurrency").
control Ask { ask(): number!! }

function answered(n: number) {
  try {
    return try Ask.ask()
  } handle Ask.ask() {
    try resume(n)
  }
}

export function main() {
  const forked = try Effect.forkChild(answered(1))
  const detached = try Effect.forkDetach(answered(2))
  return {
    forked: try Fiber.join(forked),
    detached: try Fiber.join(detached),
    timed: try Effect.timeout(answered(3), "1 second")
  }
}
