// expect-result: [2,[3,2,1]]
// A callback parameter whose type is named, such as Effect's Predicate or a
// type alias, keeps TypeScript's meaning: a plain function (D12 covers only a
// function type written in place). It may be passed on to JavaScript, and a
// caller's lambda compiles to plain JavaScript.
type Compare<T> = (a: T, b: T) => number

export function findFirst<T>(xs: ReadonlyArray<T>, p: Predicate.Predicate<T>) {
  return xs.find(p)
}

export function sorted<T>(xs: ReadonlyArray<T>, compare: Compare<T>) {
  return [...xs].sort(compare)
}

export function main() {
  return [findFirst([1, 2, 3], (x) => x > 1), sorted([1, 3, 2], (a, b) => b - a)]
}
