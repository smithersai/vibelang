// A hatch makes the arrow an Effect, whose body runs in a generator: it
// still compares the constructor call's new.target.
class Maker {
  run: () => boolean!!
  constructor() {
    this.run = effect () => {
      try sync(() => {})
      return new.target === Maker
    }
  }
}

// expect-result: true
export effect function main() {
  return try new Maker().run()
}
