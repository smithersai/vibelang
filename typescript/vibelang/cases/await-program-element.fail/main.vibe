// expect: EK4613 EK4609 EK4610
// An await element is a program by syntax whose result is its value (D394):
// an element whose type is a program is EK4613, since the operation would
// give it back unrun, and a Fiber or a Deferred element is EK4609 or EK4610.
// Through 0.0.10 each of these elements ran its program or waited for its
// fiber or Deferred; write job(), held(), join f and ready.await().
function slow(n: number): number!! {
  try sleep("1 millis")
  return n
}

export function main() {
  const job = () => slow(1)
  const held: number!! = () => {
    try Console.log("ran")
    return 42
  }
  const a = await.all [job]
  const b = await.all [held]
  const c = await.all [held, slow(2)]
  const f = fork slow(3)
  const d = await.all [f]
  const ready = try Deferred.make<number>()
  try Deferred.succeed(ready, 4)
  const e = await.all [ready]
  return { a, b, c, d, e }
}
