// The error classes main.vibe raises, written as Effect's TypeScript writes
// them. --fix writes the non-generic classes as error declarations; a
// generic tagged-error class keeps its TypeScript form (VIP-13).

/** An id that has no user. */
export error NotFound { id: string; count: number }
export error Timeout
export class Boxed<T> extends Data.TaggedError("Boxed")<{ readonly value: T }> {}
