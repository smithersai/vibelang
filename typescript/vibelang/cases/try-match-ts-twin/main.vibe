// expect-result: ["ran a",2,"one","no",[1,"x",0],7,"tail"]
// try before a match declares what its TypeScript twin declares: yield* of
// the conditional that picks the same arm (VIP-5: try e is yield* e). Each
// function's success type is the selected arm's success type, not an Effect.
import * as Effect from "effect/Effect"

effect function a() { return "ran a" }
effect function b() { return 2 }

export effect function pick(kind: "a" | "b") {
  return try match (kind) {
    when "a": a();
    when "b": b();
  }
}

export effect function mixed(n: number) {
  return try match (n) { when 1: Effect.succeed("one"); default: Effect.fail(new Error("no")); }
}

export effect function nested(n: number, m: number) {
  return try match (n) { when 1: match (m) { when 2: Effect.succeed(1); default: Effect.succeed("x"); }; default: Effect.succeed(0); }
}

export const inBlock = effect { return try match (((value: number) => value)(7)) { when 7: Effect.succeed(7); default: Effect.succeed(0); } }

export effect function tail(n: number) {
  return try do { match (n) { when 1: Effect.succeed("tail"); default: Effect.succeed(false); } }
}

export effect function main() {
  const failed = mixed(2) catch (error) => error.message
  return [try pick("a"), try pick("b"), try mixed(1), failed, [try nested(1, 2), try nested(1, 3), try nested(2, 2)], try inBlock, try tail(1)]
}
