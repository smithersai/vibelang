// D26: for...of over a Stream pulls it and closes it when the loop exits; wherever a Stream is
// expected, a producer is a Stream. Separate from ch08-producers.vibe because the producer-to-Stream
// adapter (G12) is the least settled part of producers.
import { Stream } from "effect"

const events: string[] = []

function* countdown(from: number) {
  try {
    let n = from
    while (n > 0) {
      yield n
      n--
    }
  } finally {
    events.push("countdown closed")
  }
}

// for...of over a Stream
effect function sumStream() {
  let total = 0
  for (const n of Stream.make(1, 2, 3, 4)) {
    total += n
    if (total > 5) break
  }
  return total
}

// A producer where a Stream is expected: taking three elements closes the producer early.
effect function firstThree() {
  return try Stream.runCollect(Stream.take(countdown(10), 3))
}

// expect-result: {"sum":6,"collected":[10,9,8],"events":["countdown closed"]}
export effect function main() {
  const sum = try sumStream()
  const collected = try firstThree()
  return { sum, collected, events }
}
