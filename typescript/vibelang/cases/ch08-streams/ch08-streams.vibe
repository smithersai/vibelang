// A producer returns a Stream. Its scope releases registered finalizers
// when the consumer completes or stops taking elements (VIP-20, VIP-21).
import { Effect, Stream } from "effect"

const events: string[] = []

effect function* countdown(from: number) {
  try Effect.addFinalizer(() => Effect.sync(() => { events.push("countdown closed") }))
  let n = from
  while (n > 0) {
    yield n
    n--
  }
}

// for try over a Stream
effect function sumStream() {
  let total = 0
  for try (const n of Stream.make(1, 2, 3, 4)) {
    total += n
    if (total > 5) break
  }
  return total
}

// A producer where a Stream is expected: taking three elements closes the producer early.
effect function firstThree() {
  return try Stream.runCollect(Stream.take(countdown(10), 3))
}

// expect-result: {"sum":6,"collected":[10,9,8],"events":["countdown closed"]}
export effect function main() {
  const sum = try sumStream()
  const collected = try firstThree()
  return { sum, collected, events }
}
