// A function that compiles to plain JavaScript throws what it is given, as an
// Effect function does (D406, D54): a Cause held as unknown is the expected
// failure itself, so the function's catch receives the Cause object, whatever
// reasons it holds. failed, died and mixed compile to plain JavaScript;
// framedDied, which yields, compiles to frames and agrees with them.
function caught(cause: unknown) {
  try { throw cause }
  catch (e) { return e === cause && Cause.isCause(e) ? "Cause" : "other" }
}

function failed() {
  return try caught(Cause.fail("bad"))
}

function died() {
  return try caught(Cause.die("boom"))
}

function mixed() {
  return try caught(Cause.combine(Cause.fail("bad"), Cause.die("boom")))
}

function framedDied() {
  try yieldNow()
  const cause: unknown = Cause.die("boom")
  try { throw cause }
  catch (e) { return e === cause ? "Cause" : "other" }
}

// expect-result: {"failed":"Cause","died":"Cause","framedDied":"Cause","mixed":"Cause"}
export function main() {
  return {
    failed: try failed(),
    died: try died(),
    framedDied: try framedDied(),
    mixed: try mixed()
  }
}
