import { Effect } from "effect"
const visit = <A>(callback: () => A): A => callback()
// expect-result: [0,1,2]
export effect function main() {
  let calls = 0
  effect function work() { calls++; return try Effect.succeed(calls) }
  const held = visit(() => effect () => try work())
  const before = calls
  return [before, try held(), try held()]
}
