// expect-result: {"order":["limit","items","1","2"],"seen":[1,2]}
// for concurrent(limit) (const x of items) evaluates its head in the order
// written (chapter 13): the limit, then the items it iterates.
export function main() {
  const order: string[] = []
  const seen: number[] = []
  let xs: number[] = []
  function limit() {
    order.push("limit")
    xs = [1, 2]
    return 1
  }
  function items() {
    order.push("items")
    return xs
  }
  for concurrent(try limit()) (const x of try items()) {
    order.push(String(x))
    seen.push(x)
  }
  return { order, seen }
}
