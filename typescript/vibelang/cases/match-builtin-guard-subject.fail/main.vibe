// expect: TS2345
// A built-in variant pattern runs the module's guard, Option.isNone, which
// reads the _tag of an Option, so its subject must be one, as a call of the
// guard requires: unknown, or a union with a string, is TS2345.
function unknownSubject(x: unknown) {
  return match (x) {
    when Option.None: "none";
    default: "other";
  }
}

function mixedSubject(x: string | Option<number>) {
  return match (x) {
    when Option.Some(let v): v;
    default: 0;
  }
}

export function main() {
  return [unknownSubject(null), mixedSubject("a")]
}
