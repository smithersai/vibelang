// expect: TS2850
// An initializer that does not require Scope must give using a Disposable,
// an AsyncDisposable, null, or undefined, as TypeScript's TS2850 requires
// (D401): using owns its value's disposal. Scope in the requirements lets
// using bind a value it cannot dispose, which the acquisition releases.
function count() {
  try yieldNow()
  return 5
}

function lease() {
  return try Effect.acquireRelease(() => 5, () => {})
}

export function main() {
  using leased = try lease()
  using counted = try count()
  return leased + counted
}
