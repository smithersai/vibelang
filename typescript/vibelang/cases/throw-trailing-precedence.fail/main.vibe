// expect: EK1010 EK9201 TS2322
error Missing { id: string }
// D186: a throw that ends an operator's left operand or a conditional's
// condition throws only its unary operand, as one that starts it does.
export effect function conditional(c: boolean, x: number | undefined): number!Missing {
  return x ?? throw c ? new Missing({ id: "a" }) : new Missing({ id: "b" })
}
export effect function logical(x: unknown) {
  return x || throw x || 1
}
export effect function nested(x: unknown) {
  return x && throw x ? 1 : 2
}
