// expect-result: {"bumped":[2,0],"plain":[2,0],"thrown":[2,1],"beside":[0,1,2],"unwritten":[2,0]}

// A written contract on a function whose try block returns a do block, or a
// throw expression beside a match, types the catch binding from the try
// block's failures, as the same function without the contract does.
error E1 { n: number }

function bump(n: number) { return n + 1 }

effect function bumped(p0: number): number!! {
  try {
    if (p0 > 0) throw new E1({ n: 0 })
    return do { const v: number = bump(p0); 0 }
  } catch (e) {
    return e._tag.length
  }
}

effect function plain(p0: number): number!! {
  try {
    if (p0 > 0) throw new E1({ n: 0 })
    return do { 0 }
  } catch (e) {
    return e._tag.length
  }
}

effect function thrown(p0: number): number!! {
  try {
    return do { if (p0 > 0) throw new E1({ n: 2 }); bump(p0) }
  } catch (e) {
    return e.n
  }
}

effect function beside(p0: number): number!! {
  try {
    return p0 < 0 ? throw new E1({ n: 0 }) : match (p0) { when 0: 1; default: 2 }
  } catch (e) {
    return e.n
  }
}

effect function unwritten(p0: number) {
  try {
    if (p0 > 0) throw new E1({ n: 0 })
    return do { const v: number = bump(p0); 0 }
  } catch (e) {
    return e._tag.length
  }
}

export effect function main() {
  return {
    bumped: [try bumped(1), try bumped(0)],
    plain: [try plain(1), try plain(0)],
    thrown: [try thrown(1), try thrown(0)],
    beside: [try beside(-1), try beside(0), try beside(5)],
    unwritten: [try unwritten(1), try unwritten(0)]
  }
}
