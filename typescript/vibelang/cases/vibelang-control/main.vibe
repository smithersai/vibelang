// A control operation is an abstract class that extends Control (D2). It
// compiles like a service whose key also registers one kernel operation per
// abstract method, and performing it joins R until a handler answers it.
import { Effect } from "effect"
import { Control, handle, resume } from "vibelang-runtime"

abstract class Approval extends Control {
  abstract approve(request: string): Effect.Effect<boolean, never, never>
}

export effect function checkout(cartId: string) {
  const ok = try Approval.approve(`charge cart ${cartId}`)
  return ok ? `charged ${cartId}` : `declined ${cartId}`
}

const requests: string[] = []

effect function approved() {
  return try handle(effect { return try checkout("c42") }, Approval, {
    approve: effect (request: string, k) => {
      requests.push(request)
      return try resume(k, true)
    }
  })
}

effect function declined() {
  return try handle(effect { return try checkout("c7") }, Approval, { approve: effect (_request: string, k) => try resume(k, false) })
}

// expect-result: {"approved":"charged c42","declined":"declined c7","requests":["charge cart c42"]}
export effect function main() {
  return { approved: try approved(), declined: try declined(), requests }
}
