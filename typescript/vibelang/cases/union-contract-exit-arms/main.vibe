// expect-result: ["ok","failed",3,"curried",2]
import { Effect, Exit } from "effect"
error Refused { reason: string }
// A contract whose arms are decided Exits. An effect function's return type
// is one Effect (Chapter 1, EK0106), so the contract joins both arms'
// channels, string!Refused, rather than writing a union of Effects. An
// effect function's returned value stays unrun (VIP-5), so each arm runs its
// Exit with try, and a call runs the chosen one. curried is a plain function
// that returns an effect arrow (VIP-1).
const decide = effect (flag: boolean): string!Refused =>
  flag ? try Exit.succeed("ok") : try Exit.fail(new Refused({ reason: "no" }))
const curried = <A>(value: A) => effect (flag: boolean): A!Refused =>
  flag ? try Exit.succeed(value) : try Exit.fail(new Refused({ reason: "curried" }))
// A nested conditional's arms run the same way.
const nested = effect (n: number): number!Refused =>
  n > 1 ? (n > 5 ? try Exit.succeed(n) : try Exit.succeed(2)) : try Exit.fail(new Refused({ reason: "small" }))
export effect function main() {
  const a = try decide(true)
  const b = decide(false) catch (_) => "failed"
  const c = try curried(3)(true)
  const d = curried(4)(false) catch (failure) => failure.reason
  const e = try nested(3)
  return [a, b, c, d, e]
}
