// expect-result: [["assignment-key-late",true,[["do","key:string:2"],[["k2",3]]]],["assignment-key-throws-late",true,[["do","key:string:2"],"throw:key"]],["computed-key",true,[["key:string:1","do"],[["k1",3]]]],["computed-key-later",true,[["key:string:1","value:1","do"],[["k1",1],["b",3]]]],["computed-key-symbol",true,[["key:string:1","do"],[["symbol:key",3]]]],["computed-key-throws",true,[["key:string:1"],"throw:key"]],["computed-key-overwrite",true,[["key:string:1","do"],[["k1",3],["z",9]]]],["computed-key-this",true,[["key:string:1","do"],[["k1",[["name","self"],["run",null]]],["b",3]]]],["method-key",true,[["key:string:1","key:string:1","do"],[["k1",2],["b",3]]]],["outward",["key:string:1","do"]]]

// VIP-2 pins TC39 do expressions: "The block runs where the do expression stands."

// Every operand before a do is finished first: a spread is iterated, an object

// spread copies its properties, a computed key is converted (ToPropertyKey), an

// untagged substitution is converted to a string and a tag is read. Each scenario

// runs twice, with do and with each do as an immediately invoked function; main

// reports whether both agree and the do run's trace and value.

import { Box, iter, key, shape, src, str, sum, sym, tags, Trace, withArrayIterator } from "./operands.ts"

function s10Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')]: do { t.ev('do'); t.state = 2; 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s10Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')]: (function (): number { t.ev('do'); t.state = 2; return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s11Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')]: (t.ev('value:' + t.state), 1), b: do { t.ev('do'); t.state = 2; 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s11Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')]: (t.ev('value:' + t.state), 1), b: (function (): number { t.ev('do'); t.state = 2; return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

