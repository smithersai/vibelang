}

function s13Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'throw')]: (function (): number { t.ev('do'); return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s14Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ k1: 0, [key(t, 'string')]: do { t.ev('do'); 3 }, z: 9 })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s14Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ k1: 0, [key(t, 'string')]: (function (): number { t.ev('do'); return 3 })(), z: 9 })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s15Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ name: 'self', run(t: Trace): unknown { return { [key(t, 'string')]: this, b: do { t.ev('do'); 3 } } } }).run(t)
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s15Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ name: 'self', run(t: Trace): unknown { return { [key(t, 'string')]: this, b: (function (): number { t.ev('do'); return 3 })() } } }).run(t)
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s16Do(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')](): number { return 1 }, get [key(t, 'string')](): number { return 2 }, b: do { t.ev('do'); t.state = 2; 3 } })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s16Fn(): unknown {
  const t = new Trace()
  try {
    const value: unknown = ({ [key(t, 'string')](): number { return 1 }, get [key(t, 'string')](): number { return 2 }, b: (function (): number { t.ev('do'); t.state = 2; return 3 })() })
    return [t.events, shape(value)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

// An element assignment converts its key after its right-hand side.
function s90Do(): unknown {
  const t = new Trace()
  try {
    const record: Record<string, unknown> = {}
    record[key(t, 'string')] = do { t.ev('do'); t.state = 2; 3 }
    return [t.events, shape(record)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s90Fn(): unknown {
  const t = new Trace()
  try {
    const record: Record<string, unknown> = {}
    record[key(t, 'string')] = (function (): number { t.ev('do'); t.state = 2; return 3 })()
    return [t.events, shape(record)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s91Do(): unknown {
  const t = new Trace()
  try {
    const record: Record<string, unknown> = {}
    record[key(t, 'throw')] = do { t.ev('do'); t.state = 2; 3 }
    return [t.events, shape(record)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function s91Fn(): unknown {
  const t = new Trace()
  try {
    const record: Record<string, unknown> = {}
    record[key(t, 'throw')] = (function (): number { t.ev('do'); t.state = 2; return 3 })()
    return [t.events, shape(record)]
  } catch (e) {
    return [t.events, "throw:" + (e instanceof Error ? e.message : String(e))]
  }
}

function outward(): string[] {
  const t = new Trace()
  const value = { [key(t, "string")]: do { t.ev("do"); return t.events } }
  return [String(value)]
}

const scenarios: [string, () => unknown, () => unknown][] = [["assignment-key-late",s90Do,s90Fn],["assignment-key-throws-late",s91Do,s91Fn],["computed-key",s10Do,s10Fn],["computed-key-later",s11Do,s11Fn],["computed-key-symbol",s12Do,s12Fn],["computed-key-throws",s13Do,s13Fn],["computed-key-overwrite",s14Do,s14Fn],["computed-key-this",s15Do,s15Fn],["method-key",s16Do,s16Fn]]

export effect function main() {
  const results: unknown[] = []
  for (const [name, viaDo, viaFunction] of scenarios) {
    const a = viaDo(), b = viaFunction()
    results.push([name, JSON.stringify(a) === JSON.stringify(b), a])
  }

  results.push(["outward", outward()])
  return results
}
