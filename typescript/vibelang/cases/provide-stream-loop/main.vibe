// A for...of over a Stream adds the Stream's failures and requirements with
// the loop as their source. The provide block around the loop discharges
// Prefix and lets Suffix escape to the caller; the checker panicked here
// (index out of range in provideFlow) because the loop added its requirements
// without a source.
service Prefix: string
service Suffix: string

const decorated = Stream.mapEffect(Stream.make("a", "b"), effect (word) => `${try Prefix()}${word}${try Suffix()}`)

export effect function collect() {
  const seen: Array<string> = []
  provide Prefix = "> " {
    for (const word of decorated) seen.push(word)
  }
  return seen.join(",")
}

// expect-result: "> a!,> b!"
export effect function main() {
  provide Suffix = "!" {
    return try collect()
  }
}
