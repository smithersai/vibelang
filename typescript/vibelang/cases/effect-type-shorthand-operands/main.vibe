// VIP-3 ordinary required and optional operands; rule: docs/design/vips/0003-effect-type-shorthand.md#89cc14f182a5602e
import { Effect } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
type ObjectSlots = number!{ reason: string }!{ service: number }
type ObjectRequirement = number!!({ service: number })
type Negative = number!!-1
type TupleRequirement = number!![0]
type GenericRequirement = number!!(<T>() => T)
type Find = (id: string) => number!string
type Make = new () => number!string
export const checks: [
  Equal<ObjectSlots, Effect.Effect<number, { reason: string }, { service: number }>>,
  Equal<ObjectRequirement, Effect.Effect<number, never, { service: number }>>,
  Equal<Negative, Effect.Effect<number, never, -1>>,
  Equal<TupleRequirement, Effect.Effect<number, never, [0]>>,
  Equal<GenericRequirement, Effect.Effect<number, never, <T>() => T>>,
  Equal<ReturnType<Find>, Effect.Effect<number, string>>,
  Equal<InstanceType<Make>, Effect.Effect<number, string>>
] = [true, true, true, true, true, true, true]
export effect function main(): number!! { return 1 }
