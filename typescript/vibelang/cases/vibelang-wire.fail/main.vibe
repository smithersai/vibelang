// expect: EK3202 EK3203 EK3204
// wire rejects a graph it cannot order (D27): two providers for one service
// (EK3202), providers that need each other (EK3203), and an argument whose
// type does not name its outputs (EK3204).
import { Effect, Layer } from "effect"
import { wire } from "vibelang-runtime"

service Users {
  find(id: string): Effect.Effect<string, never, never>
}

service Cache {
  get(key: string): Effect.Effect<string, never, never>
}

service Database {
  query(sql: string): Effect.Effect<string, never, never>
}

const UsersLive = Layer.succeed(Users, { find: effect (id: string) => try Effect.succeed(`live-${id}`) })
const UsersTest = Layer.succeed(Users, { find: effect (id: string) => try Effect.succeed(`test-${id}`) })

const CacheLive = Layer.effect(Cache, effect {
  const db = try Database()
  return { get: effect (key: string) => try db.query(key) }
})

const DatabaseLive = Layer.effect(Database, effect {
  const cache = try Cache()
  return { query: effect (sql: string) => try cache.get(sql) }
})

const UsersOpaque: Layer.Any = Layer.succeed(Users, { find: effect (id: string) => try Effect.succeed(id) })

export const Ambiguous = wire(UsersLive, UsersTest)
export const Cyclic = wire(CacheLive, DatabaseLive)
export const Opaque = wire(UsersOpaque)
