// A .vibe module: welcome is an Effect function, shout a pure helper.
export class EmptyName extends TaggedError("EmptyName")<{}> {}

export const events: string[] = []

export function shout(text: string) {
  return text.toUpperCase()
}

export function welcome(name: string) {
  if (name.length === 0) try Effect.fail(new EmptyName())
  try Effect.sync(() => events.push(`welcome ${name}`))
  return `Welcome, ${try shout(name)}!`
}
