// The comment written before a statement stays before the statement: printed
// again inside generated code, between a return and the expression, a line
// comment would end the return, and the program would return undefined
// instead of the journal's receipt. make is an Effect function, so try runs
// it (VIP-5); before VIP-1 its call ran as a by-name operand (D147).
interface Journal { emit: (input: { value: number }) => number!string }
const recorded: Array<number> = []
const journal: Journal = {
  emit: effect (input) => {
    recorded.push(input.value)
    return recorded.length
  }
}
const make = effect (state: { mutable runs: number }): number!! => {
  state.runs++
  return state.runs * 10
}

// expect-result: [[10,20],2]
export effect function main() {
  const state = { runs: 0 }
  // A comment on the statement: the left side runs a call, so the program is a generator.
  journal.emit({ value: try make(state) }) |> try Effect.orDie(%)
  // A comment on the second statement.
  journal.emit({ value: try make(state) }) |> try Effect.orDie(%)
  return [recorded, state.runs]
}
