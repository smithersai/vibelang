// expect: TS2345 TS2554 TS2769 EK0502
// This accepted 0.0.10 source wrote a block where an Effect dual takes its
// program (D188). A block is its call's last argument (D376), so each call
// keeps TypeScript's error with a note that gives the effect block spelling,
// and a call whose appended form still type-checks is EK1023 (D382). The
// block is a program (VIP-2), so options' appended form no longer
// type-checks either: TS2769 there.
// dual-block-legacy-fixed is what vibelang --fix writes.
effect function work() {
  try sleep("1 millis")
  return "done"
}

function spanned() {
  return withSpan("load") {
    return try work()
  }
}

function timed() {
  return timeout("1 second") {
    return try work()
  }
}

function guarded() {
  const semaphore = Semaphore.makeUnsafe(1)
  return semaphore.withPermits(1) {
    return try work()
  }
}

function options() {
  return withSpan("options") { return { attributes: { checked: true } } }
}

export effect function main() {
  return [try spanned(), try timed(), try guarded(), try options()]
}
