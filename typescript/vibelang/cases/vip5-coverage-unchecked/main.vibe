import { Effect } from "effect"
// VIP-5: any preserves native delegation and all three inferred channels.
export effect function tail(value: any) { return try value }
export effect function statement(value: any) { const result = try value; return result }
export effect function contextual(value: any) {
  const checked: string = try value
  return checked
}
export effect function resolver(loose: any, port: number) {
  const host: string = try loose
  return { endpoint: `${host}:${port}` }
}
declare const loose: any
export const named = Effect.fn("resolve")(effect (port: number) => {
  const host: string = try loose
  return { endpoint: `${host}:${port}` }
})
type Exact<A,B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
const directSuccessIsAny: Exact<Effect.Success<ReturnType<typeof tail>>,any> = true
const namedErrorIsUnknown: Exact<Effect.Error<ReturnType<typeof named>>,unknown> = true
const namedServicesAreUnknown: Exact<Effect.Services<ReturnType<typeof named>>,unknown> = true
const namedSuccess: Exact<Effect.Success<ReturnType<typeof named>>,{ endpoint: string }> = true
