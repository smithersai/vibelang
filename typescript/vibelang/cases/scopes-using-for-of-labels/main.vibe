// Labels on the same closing loop are aliases for one iteration target.
// Keep continues inside $forOf rather than emitting a continue to its block.
function disposable(events: string[]) {
  return { [Symbol.dispose](): void { events.push("dispose") } }
}
module iterators {
  export function* elements(events: string[]): Generator<Disposable> {
    try {
      yield { [Symbol.dispose](): void { events.push("dispose") } }
      yield { [Symbol.dispose](): void { events.push("dispose") } }
    } finally { events.push("closed") }
  }
}
import { elements } from iterators
effect function* produce(events: string[], count: number = 2) {
  try addFinalizer(() => Effect.sync(() => { events.push("closed") }))
  for (let i = 0; i < count; i++) yield disposable(events)
}

effect function array(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of [disposable(events), disposable(events)]) {
    events.push("body")
    try yieldNow
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

effect function iterator(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of try sync((e: string[]) => elements(e), events)) {
    events.push("body")
    try yieldNow
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

export effect function producer(reverse: boolean, count: number = 2) {
  const events: string[] = []
  outer: inner: for try (const item of produce(events, count)) {
    using x = item
    events.push("body")
    try yieldNow
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

effect function stream(reverse: boolean) {
  const events: string[] = []
  outer: inner: for try (const item of Stream.ensuring(Stream.fromIterable([disposable(events), disposable(events)]), effect { events.push("closed") })) {
    using x = item
    events.push("body")
    try yieldNow
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

effect function cStyle() {
  const events: string[] = []
  outer: inner: for (using h = disposable(events); ;) {
    events.push("body")
    try yieldNow
    if (events.length < 2) continue outer
    break inner
  }
  return events
}
effect function nested() {
  const events: string[] = []
  let i = 0
  outer: alias: for (using x of try sync((e: string[]) => elements(e), events)) {
    i++
    inner: innerAlias: for (using y of try sync((e: string[]) => elements(e), events)) {
      events.push("body")
      try yieldNow
      if (i === 1) continue outer
      break alias
    }
  }
  return events
}

// expect-result: {"array":["body","dispose","body","dispose"],"arrayReverse":["body","dispose","body","dispose"],"iterator":["body","dispose","body","dispose","closed"],"iteratorReverse":["body","dispose","body","dispose","closed"],"producer":["body","dispose","body","dispose","closed"],"producerReverse":["body","dispose","body","dispose","closed"],"stream":["body","dispose","body","dispose","closed"],"streamReverse":["body","dispose","body","dispose","closed"],"cStyle":["body","body","dispose"],"nested":["body","dispose","closed","dispose","body","dispose","closed","dispose","closed"]}
export effect function main() {
  return {
    array: try array(false), arrayReverse: try array(true),
    iterator: try iterator(false), iteratorReverse: try iterator(true),
    producer: try producer(false), producerReverse: try producer(true),
    stream: try stream(false), streamReverse: try stream(true),
    cStyle: try cStyle(), nested: try nested(),
  }
}
