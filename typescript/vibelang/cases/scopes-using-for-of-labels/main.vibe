  return events
}

function stream(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of Stream.ensuring(Stream.fromIterable([try disposable(events), try disposable(events)]), () => { events.push("closed") })) {
    events.push("body")
    try yieldNow()
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

function cStyle() {
  const events: string[] = []
  outer: inner: for (using h = try disposable(events); ;) {
    events.push("body")
    try yieldNow()
    if (events.length < 2) continue outer
    break inner
  }
  return events
}
function nested() {
  const events: string[] = []
  let i = 0
  outer: alias: for (using x of try sync((e: string[]) => elements(e), events)) {
    i++
    inner: innerAlias: for (using y of try sync((e: string[]) => elements(e), events)) {
      events.push("body")
      try yieldNow()
      if (i === 1) continue outer
      break alias
    }
  }
  return events
}

// expect-result: {"array":["body","dispose","body","dispose"],"arrayReverse":["body","dispose","body","dispose"],"iterator":["body","dispose","body","dispose","closed"],"iteratorReverse":["body","dispose","body","dispose","closed"],"producer":["body","dispose","body","dispose","closed"],"producerReverse":["body","dispose","body","dispose","closed"],"stream":["body","dispose","body","dispose","closed"],"streamReverse":["body","dispose","body","dispose","closed"],"cStyle":["body","body","dispose"],"nested":["body","dispose","closed","dispose","body","dispose","closed","dispose","closed"]}
export function main() {
  return {
    array: try array(false), arrayReverse: try array(true),
    iterator: try iterator(false), iteratorReverse: try iterator(true),
    producer: try producer(false), producerReverse: try producer(true),
    stream: try stream(false), streamReverse: try stream(true),
