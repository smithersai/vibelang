// Labels on the same closing loop are aliases for one iteration target.
// Keep continues inside $forOf rather than emitting a continue to its block.
function disposable(events: string[]) {
  return { [Symbol.dispose](): void { events.push("dispose") } }
}
module iterators {
  export function* elements(events: string[]): Generator<Disposable> {
    try {
      yield { [Symbol.dispose](): void { events.push("dispose") } }
      yield { [Symbol.dispose](): void { events.push("dispose") } }
    } finally { events.push("closed") }
  }
}
import { elements } from iterators
function* produce(events: string[]) {
  try {
    yield try disposable(events)
    yield try disposable(events)
  } finally { events.push("closed") }
}

function array(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of [try disposable(events), try disposable(events)]) {
    events.push("body")
    try yieldNow()
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

function iterator(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of try sync((e: string[]) => elements(e), events)) {
    events.push("body")
    try yieldNow()
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
  }
  return events
}

function producer(reverse: boolean) {
  const events: string[] = []
  outer: inner: for (using x of produce(events)) {
    events.push("body")
    try yieldNow()
    if (events.length < 2) {
      if (reverse) continue inner
      continue outer
    }
    if (reverse) break outer
    break inner
