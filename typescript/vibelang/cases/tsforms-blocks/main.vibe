// expect-result: {"traced":"Ada","provided":"eu","served":4,"many":"eu 4","logged":"done"}
// Effect.withSpan and Effect.provide have safe EK4836 rewrites.
// Effect.provideService keeps its native call: a Layer changes scope.
// Its warning explains why there is no automatic block rewrite.
// tsforms-blocks-fixed is what vibelang --fix writes.
service Region {
  name(): string!!
}

service Size {
  of(text: string): number!!
}

const RegionLive = Layer.succeed(Region, { effect name() { return "eu" } })
const SizeLive = Layer.succeed(Size, { effect of(text) { return text.length } })

effect function regionName() {
  return try (try Region).name()
}

effect function sizeOf(text: string) {
  return try (try Size).of(text)
}

effect function find() {
  return "Ada"
}

effect function traced() {
  return try Effect.withSpan(find(), "find")
}

effect function provided() {
  return try Effect.provide(regionName(), RegionLive)
}

effect function served() {
  return try Effect.provideService(sizeOf("abcd"), Size, { effect of(text: string) { return text.length } })
}

effect function describe() {
  return `${try regionName()} ${try sizeOf("four")}`
}

effect function many() {
  return try Effect.provide(describe(), [RegionLive, SizeLive])
}

effect function logged() {
  try Effect.provide(regionName(), RegionLive)
  return "done"
}

export effect function main() {
  return { traced: try traced(), provided: try provided(), served: try served(), many: try many(), logged: try logged() }
}
