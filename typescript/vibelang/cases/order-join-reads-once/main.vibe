// expect-result: {"joined":{"task":"A"},"reads":1}
// join reads each element of an object or array once (D225): the fiber it
// joins is the fiber it would interrupt, and a getter runs once. The getter
// returns fibers that this body does not own, which detach gives: a getter
// is a function literal, so one that returned an owned fiber would capture
// it (EK4838, D409; fork-escape-getter.fail).
export effect function main() {
  const a = try detach(effect { return "A" })
  const b = try detach(effect { return "B" })
  let reads = 0
  const tasks = {
    get task() {
      reads++
      return reads === 1 ? a : b
    }
  }
  const joined = join tasks
  return { joined, reads }
}
