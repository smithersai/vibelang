{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "types": [],
    "skipLibCheck": true,
    "outDir": "out",
    "plugins": [{ "name": "@effect/language-service", "diagnosticSeverity": { "floatingEffect": "error" } }]
  },
  "include": ["*.vibe"]
}
