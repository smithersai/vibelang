// expect: EK0107
// VIP-1 rejects the retained legacy arguments references in nested arrows,
// shorthand properties and plain functions. These original runtime
// witnesses now pin that rejection; legal bindings use rest parameters.
export effect function nested(a: number): number!! {
  const bump = effect () => {
    const tick = try Effect.sync(() => 0)
    return arguments[0]++
  }
  return try bump()
}

export effect function identity(a: number) {
  const tick = try Effect.sync(() => 0)
  const read = effect () => {
    const step = try Effect.sync(() => 0)
    return arguments
  }
  return try read() === arguments
}

// A shorthand property names the same arguments object.
export effect function shorthand(a: number) {
  const tick = try Effect.sync(() => 0)
  const read = effect () => {
    const step = try Effect.sync(() => 0)
    return { arguments }
  }
  return (try read()).arguments === arguments
}

// An anonymous function expression that refers to the variable it
// initializes runs as a method-form generator.
export const anonymous = effect function (a: number): number!! {
  const tick = try Effect.sync(() => 0)
  const read = effect () => {
    const step = try Effect.sync(() => 0)
    return arguments[0] as number
  }
  return try read() + anonymous.length
}

// A plain function (VIP-1) returns its effect arrow, which reads the plain
// function's arguments.
export function plain(a: number) {
  return effect () => {
    const tick = try Effect.sync(() => 0)
    return arguments[0] as number
  }
}
