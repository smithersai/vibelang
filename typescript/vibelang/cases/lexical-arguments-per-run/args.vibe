// A nested Effect arrow reads the arguments object of the function around
// it, on the same run. The arrow's generator binds its own arguments, so the
// lowering declares the enclosing function's arguments where its body runs:
// in the generator that runs again each time the Effect runs.
export function nested(a: number): number!! {
  const bump = () => {
    const tick = try Effect.sync(() => 0)
    return arguments[0]++
  }
  return try bump()
}

export function identity(a: number) {
  const tick = try Effect.sync(() => 0)
  const read = () => {
    const step = try Effect.sync(() => 0)
    return arguments
  }
  return try read() === arguments
}

// A shorthand property names the same arguments object.
export function shorthand(a: number) {
  const tick = try Effect.sync(() => 0)
  const read = () => {
    const step = try Effect.sync(() => 0)
    return { arguments }
  }
  return (try read()).arguments === arguments
}

// An anonymous function expression that refers to the variable it
// initializes runs as a method-form generator.
export const anonymous = function (a: number): number!! {
  const tick = try Effect.sync(() => 0)
  const read = () => {
    const step = try Effect.sync(() => 0)
    return arguments[0] as number
  }
  return try read() + anonymous.length
}

// A plain function's body runs in its $direct variant.
export function plain(a: number) {
  return () => {
    const tick = try Effect.sync(() => 0)
    return arguments[0] as number
  }
}
