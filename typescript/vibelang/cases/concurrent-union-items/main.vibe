// expect-result: [1,2,3,4,5,6,7,8]
// Native for-of element inference includes every member of an Iterable union.
export effect function main() {
 const seen:number[]=[]
 const arrays=(flag:boolean):string[]|number[]=>flag?["1","2"]:[3,4]
 const containers=(flag:boolean):number[]|Set<string>=>flag?[5,6]:new Set(["7","8"])
 for concurrent(const item of arrays(true)){seen.push(typeof item==="number"?item:Number(item))}
 for concurrent(1)(let item of arrays(false)){item=typeof item==="number"?item:Number(item);seen.push(item)}
 for concurrent("unbounded")(const item of containers(true)){seen.push(typeof item==="number"?item:Number(item))}
 for concurrent(const item of containers(false)){seen.push(typeof item==="number"?item:Number(item))}
 return seen.sort((a,b)=>a-b)
}
