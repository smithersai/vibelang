// wire (D27) composes layers from their Layer<Out, E, In> types. The
// arguments here are listed consumers first (L7), the order the runtime's
// fold needs, so one Database serves both Users and Orders, and Config
// reaches Database.
import { Data, Effect, Layer } from "effect"
import { wire } from "vibelang-runtime"

class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Config {
  readonly url: string
}

service Database {
  query(table: string, key: string): Effect.Effect<ReadonlyArray<string>, never, never>
}

service Users {
  find(id: string): Effect.Effect<User, UserNotFound, never>
}

service Orders {
  count(userId: string): Effect.Effect<number, never, never>
}

const events: string[] = []
const data = new Map<string, ReadonlyArray<string>>([["users/1", ["Ada"]], ["orders/1", ["o1", "o2"]]])

const ConfigLive = Layer.succeed(Config, { url: "memory://shop" })

const DatabaseLive = Layer.effect(Database, effect {
  const url = (try Config()).url
  try Effect.sync(() => events.push(`connect ${url}`))
  return {
    query: effect (table: string, key: string) => try Effect.succeed(data.get(`${table}/${key}`) ?? [])
  }
})

const UsersLive = Layer.effect(Users, effect {
  const db = try Database()
  return {
    effect find(id) {
      const rows = try db.query("users", id)
      if (rows.length === 0) return try Effect.fail(new UserNotFound({ id }))
      return try Effect.succeed({ id, name: rows[0] })
    }
  }
})

const OrdersLive = Layer.effect(Orders, effect {
  const db = try Database()
  return {
    effect count(userId) {
      return (try db.query("orders", userId)).length
    }
  }
})

const AppLive = wire(OrdersLive, UsersLive, DatabaseLive, ConfigLive)

effect function summary(id: string) {
  const user = try Users.find(id)
  return `${user.name}: ${try Orders.count(id)} orders`
}

// expect-result: {"summary":"Ada: 2 orders","events":["connect memory://shop"]}
export effect function main() {
  const text = try Effect.provide(effect { return try summary("1") }, AppLive)
  return { summary: text, events }
}
