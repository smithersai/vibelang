// Chapter 002: continue ends current item including own label
// Spec rule: docs/design/src/002-running.md#870eacce29298375
import {Effect} from "effect"
export effect function main():Effect.Effect<number[]> {
 const out:number[]=[]
 for concurrent(1)(const n of [1,2,3]){if(n===2)continue;out.push(n)}
 own:for concurrent(1)(const n of [4,5,6]){
  if(n===5)continue own
  for(const x of [0,1,2]){if(x===0)continue;out.push(n*10+x);break}
  switch(n){case 4:out.push(400);break;default:out.push(600)}
 }
 return out
}
