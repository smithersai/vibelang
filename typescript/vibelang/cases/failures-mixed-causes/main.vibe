// expect-result: {"rows":{"r0_fail":{"exit":"Fail(E)","catch":"ok(catch ran: E)","catchMatch":"ok(matched E)","catchValue":"ok(fallback)","retry":"Fail(E) x3","mapError":"Fail(M:E)","catchDefect":"Fail(E)"},"r1_finallyDies":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r1_finallyExitDies":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r1_finallyThrows":{"exit":"Fail(E)+Fail(E2)","catch":"ok(catch ran: E)","catchMatch":"ok(matched E)","catchValue":"ok(fallback)","retry":"Fail(E) x3","mapError":"Fail(M:E)+Fail(M:E2)","catchDefect":"Fail(E)+Fail(E2)"},"r1_dieThenFinallyThrows":{"exit":"Die(D)+Die(E2)","catch":"Die(D)+Die(E2)","catchMatch":"Die(D)+Die(E2)","catchValue":"Die(D)+Die(E2)","retry":"Die(D)+Die(E2) x1","mapError":"Die(D)+Die(E2)","catchDefect":"ok(defect D)"},"r2_usingReleaseDies":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_usingDisposeThrows":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r3_producerCleanupDies":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r3_producerIteratorCloseThrows":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r4_awaitAll":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r4_forConcurrent":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r5_awaitRace":{"exit":"Fail(E)","catch":"ok(catch ran: E)","catchMatch":"ok(matched E)","catchValue":"ok(fallback)","retry":"Fail(E) x3","mapError":"Fail(M:E)","catchDefect":"Fail(E)"},"r5_awaitAny":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r6_interruptThenFinallyThrows":{"exit":"Interrupt+Fail(E)","catch":"ok(catch ran: E)","catchMatch":"ok(matched E)","catchValue":"ok(fallback)","retry":"Fail(E) x3","mapError":"Interrupt+Fail(M:E)","catchDefect":"Interrupt+Fail(E)"},"r8_abandonMixed":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r8_allSettled":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_forUsingHead":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_forUsingOf":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_callableDispose":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_callableAsyncDispose":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r2_holder":{"exit":"Die(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Die(E)+Die(D)","catchDefect":"ok(defect E)"},"r9_handBuiltMixed":{"exit":"Fail(E)+Die(D)","catch":"Die(E)+Die(D)","catchMatch":"Die(E)+Die(D)","catchValue":"Die(E)+Die(D)","retry":"Die(E)+Die(D) x1","mapError":"Fail(M:E)+Die(D)","catchDefect":"ok(defect D)"}},"seenExit":"Failure","parity":true}
// Mixed causes (D305): a typed failure beside a defect or an interruption,
// from every VibeLang form that makes one, seen through every recovery form.
// VibeLang behaves as idiomatic Effect 4.0.6 does: where a failure meets a
// defect, from Effect's own finalizers and concurrency (Effect-TS/effect#9433)
// or from the kernel's abandonment, the failure becomes a defect, first, and
// no typed recovery runs (#9516). experiments/tests/defect-precedence.test.ts
// pins the Effect side. Without a defect, catch recovers the first failure
// and drops an interruption beside it, as Effect.catch does (D306).
import { referenceRows } from "./reference.js"

error E
error E2
error M { of: string }

control Ask {
  ask(): number!!
}

let attempts = 0

function name(value: unknown): string {
  if (typeof value === "string") return value
  if (typeof value === "object" && value !== null && "_tag" in value) {
    return value instanceof M ? `M:${value.of}` : String(value._tag)
  }
  if (value instanceof Error) return value.message
  return String(value)
}

function show(cause: Cause.Cause<unknown>): string {
  return cause.reasons.map((r) => r._tag === "Fail" ? `Fail(${name(r.error)})` : r._tag === "Die" ? `Die(${name(r.defect)})` : "Interrupt").join("+")
}

function outcome(program: unknown!unknown) {
  return match (try exit(program)) {
    when Exit.Success(let value): `ok(${name(value)})`;
    when Exit.Failure(let cause): show(cause);
  }
}

// Sources.
function failNow() {
  throw new E()
}

function dieNow() {
  try die("D")
}

function failLater() {
  try sleep("5 millis")
  throw new E()
}

function dieOnInterrupt() {
  try {
    try sleep("1 hour")
  } finally {
    try die("D")
  }
}

function finallyDies() {
  try {
    throw new E()
  } finally {
    try die("D")
  }
}

function finallyThrows() {
  try {
    throw new E()
  } finally {
    throw new E2()
  }
}

function dieThenFinallyThrows() {
  try {
    try die("D")
  } finally {
    throw new E2()
  }
}

let seenExit = ""

function finallyExitDies() {
  try {
    throw new E()
  } finally (outcome) {
    seenExit = outcome._tag
    try die("D")
  }
}

function usingReleaseDies() {
  using resource = try Effect.acquireRelease(() => 1, (_) => die("D"))
  throw new E()
}

function usingDisposeThrows() {
  using resource = try sync(() => ({ [Symbol.dispose]() { throw new Error("D") } }))
  throw new E()
}

function* numbers() {
  try {
    yield 1
    yield 2
  } finally {
    try die("D")
  }
}

function* closingItems() {
  const items = try sync(() => ({
    [Symbol.iterator]() {
      return { next: () => ({ done: false, value: 1 }), return(): IteratorResult<number> { throw new Error("D") } }
    }
  }))
  yield* items
}

function producerIteratorCloseThrows() {
  for (const n of closingItems()) {
    throw new E()
  }
}

function producerCleanupDies() {
  for (const n of numbers()) {
    throw new E()
  }
}

function awaitAllMixed() {
  return await.all [failLater(), dieOnInterrupt()]
}

function forConcurrentMixed() {
  for concurrent (const i of [0, 1]) {
    if (i === 0) try failLater()
    else try dieOnInterrupt()
  }
}

function awaitRaceMixed() {
  return await.race [failNow(), dieNow()]
}

function awaitAnyMixed() {
  return await.any [failNow(), dieNow()]
}

function interruptThenFinallyThrows() {
  try {
    try interrupt()
  } finally {
    throw new E()
  }
}

function asksWithCleanup() {
  try {
    return try Ask.ask()
  } finally {
    try die("D")
  }
}

function abandonMixed() {
  try {
    return try asksWithCleanup()
  } handle Ask.ask() {
    throw new E()
  }
}

function allSettledMixed() {
  const [settled] = await.allSettled [finallyDies()]
  return settled._tag
}

function forUsingHead() {
  for (using r = try sync(() => ({ [Symbol.dispose]() { throw new Error("D") } })); ;) {
    throw new E()
  }
}
function forUsingOf() {
  for (using r of try sync(() => [{ [Symbol.dispose]() { throw new Error("D") } }])) {
    throw new E()
  }
}
function callableDispose() {
  using r = try sync(() => Object.assign(() => {}, { [Symbol.dispose]() { throw new Error("D") } }))
  throw new E()
}
function callableAsyncDispose() {
  using r = try sync(() => Object.assign(() => {}, { async [Symbol.asyncDispose]() { throw new Error("D") } }))
  throw new E()
}
function holderDispose() {
  using holder = try Effect.acquireRelease(
    () => ({ value: try sync(() => ({ [Symbol.dispose]() { throw new Error("D") } })) }),
    (h) => sync((holder) => holder.value[Symbol.dispose](), h)
  )
  throw new E()
}
function handBuiltMixed() {
  try Effect.failCause(Cause.combine(Cause.fail(new E()), Cause.die("D")))
}

// Recovery forms.
function viaCatch(src: () => unknown!E | E2) {
  try {
    try src()
    return "no failure"
  } catch (e) {
    return `catch ran: ${e._tag}`
  }
}

function viaCatchMatch(src: () => unknown!E | E2) {
  return src() catch (e) => match (e) { when E: "matched E"; when E2: "matched E2"; }
}

function viaCatchValue(src: () => unknown!E | E2) {
  return src() catch "fallback"
}

function viaRetry(src: () => unknown!E | E2) {
  attempts = 0
  return try retry(() => {
    attempts++
    return try src()
  }, { times: 2 })
}

function viaMapError(src: () => unknown!E | E2) {
  return try Effect.mapError(src(), (e) => new M({ of: e._tag }))
}

function viaCatchDefect(src: () => unknown!E | E2) {
  return try Effect.catchDefect(src(), (d) => `defect ${name(d)}`)
}

function forms(src: () => unknown!E | E2) {
  const raw = try outcome(src())
  const caught = try outcome(viaCatch(src))
  const matched = try outcome(viaCatchMatch(src))
  const fallback = try outcome(viaCatchValue(src))
  const retried = try outcome(viaRetry(src))
  const tries = attempts
  const mapped = try outcome(viaMapError(src))
  const defect = try outcome(viaCatchDefect(src))
  return { exit: raw, catch: caught, catchMatch: matched, catchValue: fallback, retry: `${retried} x${tries}`, mapError: mapped, catchDefect: defect }
}

export function main() {
  const rows = {
    r0_fail: try forms(failNow),
    r1_finallyDies: try forms(finallyDies),
    r1_finallyExitDies: try forms(finallyExitDies),
    r1_finallyThrows: try forms(finallyThrows),
    r1_dieThenFinallyThrows: try forms(dieThenFinallyThrows),
    r2_usingReleaseDies: try forms(usingReleaseDies),
    r2_usingDisposeThrows: try forms(usingDisposeThrows),
    r3_producerCleanupDies: try forms(producerCleanupDies),
    r3_producerIteratorCloseThrows: try forms(producerIteratorCloseThrows),
    r4_awaitAll: try forms(awaitAllMixed),
    r4_forConcurrent: try forms(forConcurrentMixed),
    r5_awaitRace: try forms(awaitRaceMixed),
    r5_awaitAny: try forms(awaitAnyMixed),
    r6_interruptThenFinallyThrows: try forms(interruptThenFinallyThrows),
    r8_abandonMixed: try forms(abandonMixed),
    r8_allSettled: try forms(allSettledMixed),
    r2_forUsingHead: try forms(forUsingHead),
    r2_forUsingOf: try forms(forUsingOf),
    r2_callableDispose: try forms(callableDispose),
    r2_callableAsyncDispose: try forms(callableAsyncDispose),
    r2_holder: try forms(holderDispose),
    r9_handBuiltMixed: try forms(handBuiltMixed),
  }
  const expected = try referenceRows()
  const parity = try sync((actual, reference) => JSON.stringify(actual) === JSON.stringify(reference), rows, expected)
  return { rows, seenExit, parity }
}
