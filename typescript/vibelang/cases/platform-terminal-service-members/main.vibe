  columns: Effect.succeed(80),
  rows: Effect.succeed(24),
  readInput: Effect.die("unused input"),
  readLine: Effect.succeed("line"),
  size: Effect.die("unused resize"),
  display: (text: string) => Effect.void
})
// expect-result: "line"
export effect function main() {
  provide Layer.succeed(Terminal.Terminal, fixed) {
    return try (try Terminal.Terminal).readLine
  }
