// expect: EK2119
// astra-2: the second clause's string reaches the first clause's number.
control Steps { first(): void!!; second(): void!! }

export function probe() {
  try {
    try Steps.first()
    try Steps.second()
    return 42
  } handle Steps.first() {
    const n: number = try resume()
    n.toFixed(0)
  } handle Steps.second() {
    return `${try resume()}`
  }
}
