import { Effect } from "effect"
export const plain = () => fetch("/api")
export const asyncValue = async () => fetch("/api")
export const wrapped = () => Effect.try(() => fetch("/api"))
export const promised = () => Effect.tryPromise(() => fetch("/api"))
export const timer = () => setTimeout(() => {}, 1)
export const writer = () => console.log("x")
export const host = () => document.title

