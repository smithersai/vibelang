export const emptyChecked: (Effect.Effect<number> | undefined)!! = emptyResult()
export const thrownChecked: (Effect.Effect<number> | undefined)!! = thrownResult()
export const absentChecked: (Effect.Effect<number> | undefined)!! = absentResult()
