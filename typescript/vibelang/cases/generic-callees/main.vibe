// A call to a generic .vibe function adds the callee's E and R as the call
// instantiates them: run's E is whatever its argument fails with.
class Missing extends TaggedError("Missing")<{ readonly key: string }> {}

effect function run<A, E, R>(program: () => Effect<A, E, R>) {
  try Effect.sleep("1 millis")
  return try program()
}

effect function lookup(key: string) {
  if (key !== "a") throw new Missing({ key })
  return 1
}

// expect-result: {"found":1,"caught":"Missing b"}
export effect function main() {
  const found = try run(effect () => try lookup("a"))
  let caught = "none"
  try {
    try run(effect () => try lookup("b"))
  } catch (e) {
    caught = `${e._tag} ${e.key}`
  }
  return { found, caught }
}
