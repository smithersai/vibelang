// expect-result: {"call":"a-b","method":"x,y","indexed":"first","member":"m","fiber":3}
// VIP-17 reserves join in Effect code. Keep the ordinary helper under
// another name there; join remains an ordinary local in a plain function.
function joinText(a: string, b: string): string {
  return `${a}-${b}`
}

function indexed() {
  const join = ["first"]
  return join[0]
}

effect function count(): number!! {
  return 3
}

export effect function main() {
  const words = ["x", "y"]
  const obj = { join: effect () => "m" }
  const f = fork count()
  return {
    call: joinText("a", "b"),
    method: words.join(","),
    indexed: indexed(),
    member: try obj.join(),
    fiber: join f
  }
}
