// VIP-7, detail 67a: Date patterns use the current prototype chain,
// so a forged Date prototype matches in bare and extractor patterns.
const forged: unknown = Object.create(Date.prototype);
export const result = [
  match (forged) { when Date: true; default: false; },
  match (forged) { when Date(let d): true; default: false; },
  match (new Date(NaN)) { when Date: true; default: false; }
];
