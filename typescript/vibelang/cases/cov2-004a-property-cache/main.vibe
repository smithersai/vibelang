import { Effect } from "effect"
function probe(): unknown {
let reads = 0
const s = { get a() { return ++reads }, get b() { return ++reads } }
const result = match (s) { when { a: 0 }: 0; when { a: 1, b: 2 }: 7; default: -1; }
return [result, reads]
}
export function main(): Effect.Effect<unknown> { return Effect.sync(probe) }
