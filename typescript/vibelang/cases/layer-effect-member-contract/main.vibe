// A Layer.effect member may use a service the program captured when the layer
// was built, or look one up when it is called if its contract lists it
// (Chapter 4, "Requirements that would leak"); the program may build the
// object in a variable before returning it.
service Clock2 { now(): number!! }
service Greeter { greet(name: string): string!! }
service Stamped { greet(name: string): string!!Clock2 }
service Builder { greet(name: string): string!! }

const Clock2Live = Layer.succeed(Clock2, { effect now() { return 42 } })

const GreeterLive = Layer.effect(Greeter) {
  const clock = try Clock2()
  return { effect greet(name) { return `hi ${name} at ${try clock.now()}` } }
}

const StampedLive = Layer.effect(Stamped) {
  return { effect greet(name) { return `hi ${name} at ${try Clock2.now()}` } }
}

const BuilderLive = Layer.effect(Builder) {
  const clock = try Clock2()
  const impl = { effect greet(name: string) { return `built ${name} at ${try clock.now()}` } }
  return impl
}

// expect-result: ["hi a at 42","hi b at 42","built c at 42"]
export effect function main() {
  provide wire(Clock2Live, GreeterLive, StampedLive, BuilderLive) {
    return [try Greeter.greet("a"), try Stamped.greet("b"), try Builder.greet("c")]
  }
}
