// D18 / Codex R10 / Fable 1: producers and handler clauses whose last step is
// `resume` must run in constant stack. The kernel's `hooks.onResume` reports
// the fiber's stack depth at every resumption.
import { hooks } from "vibelang-runtime/kernel"

function* count(n: number) {
  let i = 0
  while (i < n) {
    yield i
    i++
  }
}

abstract class Tick extends Control {
  abstract tick(n: number): Effect<void, never, never>
}

effect function ticks(n: number) {
  let i = 0
  while (i < n) {
    try Tick.tick(i)
    i++
  }
  return i
}

const events: string[] = []
let maxDepth = 0

// A loop body with its own regions: cleanup runs per element, still in constant stack.
effect function sumWithFinally(n: number) {
  let sum = 0
  for (const x of count(n)) {
    try {
      sum += x
    } finally {
      if (x === n - 1) events.push("last finally")
    }
  }
  return sum
}

// expect-result: {"sum":4999950000,"loopDepthBounded":true,"seen":100000,"ticked":100000,"handlerDepthBounded":true,"withFinally":4999950000,"finallyDepthBounded":true,"events":["last finally"]}
export effect function main() {
  hooks.onResume = (fiber): void => {
    maxDepth = Math.max(maxDepth, fiber._stack.length)
  }
  let sum = 0
  for (const x of count(100000)) sum += x
  const loopDepth = maxDepth
  maxDepth = 0
  let seen = 0
  const ticked = try handle(effect { return try ticks(100000) }, Tick, {
    effect tick(n, k) {
      seen++
      return try resume(k, undefined)
    }
  })
  const handlerDepth = maxDepth
  maxDepth = 0
  const withFinally = try sumWithFinally(100000)
  const finallyDepth = maxDepth
  hooks.onResume = undefined
  return {
    sum,
    loopDepthBounded: loopDepth < 50,
    seen,
    ticked,
    handlerDepthBounded: handlerDepth < 50,
    withFinally,
    finallyDepthBounded: finallyDepth < 50,
    events
  }
}
