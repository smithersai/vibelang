// expect: EK4701
data Shape { Circle { r: number }; Rect { w: number }; Tri { a: number } }
data Wrap { Of { s: Shape } }
export function inspect(value: Wrap) {
  return match (value) {
    when { _tag: "Of", s: { _tag: "Circle" } }: 1;
    when { _tag: "Of", s: { _tag: "Rect" } }: 2;
   default: match (void 0 as unknown) { when 0: (void 0 as never); }; }
}

data Choice { One; Two }
data Inner { Box { a: Choice } }
data Outer { Hold { v: Inner } }
export function deep(value: Outer) {
  return match (value) {
    when { _tag: "Hold", v: { _tag: "Box", a: { _tag: "One" } } }: 1;
   default: match (void 0 as unknown) { when 0: (void 0 as never); }; }
}

error Missing
export function mixed(value: Wrap | Missing) {
  return match (value) {
    when { _tag: "Of", s: { _tag: "Circle" } }: 1;
    when { _tag: "Of", s: { _tag: "Rect" } }: 2;
   default: match (void 0 as unknown) { when 0: (void 0 as never); }; }
}
