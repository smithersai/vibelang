// expect: EK4701
// An error class arm covers each member with its tag; a family base
// still leaves an unrelated error with the same fields.
import { TaggedError as $ErrorTaggedError } from "vibelang-runtime"
import * as A from "./a.vibe"
import * as B from "./b.vibe"

error Timeout { ms: number }
class AppError extends $ErrorTaggedError("AppError" as string)<{
    readonly _tag: string;
    readonly code: string;
}> {
}
error Missing extends AppError { path: string }
error Other { code: string }

export function sameName(e: A.NotFound | B.NotFound | Timeout) {
  return match (e) {
    when A.NotFound: "A";
    when Timeout: "timeout";
  }
}

export function family(e: Missing | Other) {
  return match (e) {
    when AppError: "app";
  }
}
