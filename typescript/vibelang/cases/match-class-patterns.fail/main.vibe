// expect: EK4701
// An error class's arm covers each member with its tag (chapter 004,
// Coverage): its generated matcher tests _tag, so an arm for one of two
// error classes that share a name covers the other. A family's base leaves
// an unrelated error with the same fields.
import * as A from "./a.vibe"
import * as B from "./b.vibe"

error Timeout { ms: number }
error AppError { _tag: string; code: string }
error Missing extends AppError { path: string }
error Other { code: string }

export function sameName(e: A.NotFound | B.NotFound | Timeout) {
  return match (e) {
    when A.NotFound: "A";
    when Timeout: "timeout";
  }
}

export function family(e: Missing | Other) {
  return match (e) {
    when AppError: "app";
  }
}
