// expect: EK2001 EK3201
// A layer that provides nothing, such as one that only runs a startup
// program, keeps its errors and requirements through wire (D27): the
// contract of launch must name Offline, and the runner reports Mailer.
import { Effect, Layer } from "effect"
import { wire } from "vibelang-runtime"

service Mailer {
  send(to: string): Effect.Effect<void, never, never>
}

class Offline extends TaggedError("Offline")<{}> {}

const Announce = Layer.effectDiscard(effect {
  const sent = try Mailer.send("team@example.com")
  if (sent === undefined) throw new Offline()
})

const AppLive = wire(Announce)

export effect function launch(): Effect<never, never, infer R> {
  return try Layer.launch(AppLive)
}

Effect.runFork(effect { return try launch() })
