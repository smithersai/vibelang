// expect: TS7023
// docs/design/src/900-appendices.md#783ae99419b60bae — Chapter 900: cov900-recursive-inference.fail.
// TypeScript infers never for a direct, unconditional self-call.
export function diverges() { return diverges() }
const checkNever: () => never = diverges
export function recursive(n: number) { return n ? recursive(n - 1) : 0 }
