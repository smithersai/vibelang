import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// fork starts a fiber that the current fiber owns (VIP-17), as Effect.forkChild
// does: the child runs until it ends or its parent does, and the parent's end
// interrupts it and waits for its cleanup. No block, loop body or function
// around the fork owns it, and none of them stops it on the way out. Fiber.join
// waits for the fiber. Effect's own fork combinators keep their meaning, and
// Effect.forkScoped gives a fiber the caller's Scope.
import { Data, Effect, Fiber } from "effect"
import { fork } from "vibelang-runtime"

class Boom extends Data.TaggedError("Boom")<{}> {}

const events: string[] = []

effect function resource(name: string) {
  return try Effect.acquireRelease(
    effect {
      events.push(`acquire ${name}`)
      return name
    },
    effect () => {
      events.push(`release ${name}`)
    }
  )
}

// Runs until it is interrupted. A fiber interrupted before its first run never
// enters this try and runs no finally. Each caller awaits a Deferred signalled
// inside the try, so cleanup is installed before the owner can exit.
effect function ticker(name: string, started: Deferred.Deferred<void>) {
  { const $nativeTryCompletion = try $nativeTryEffect.onExit(effect {
    try Deferred.succeed(started, undefined)
    while (true) {
      try Effect.sleep("1 millis")
    }
  
;return { kind: "normal" } as const;
}, () => effect {
    events.push(`stop ${name}`)
  });

}
}

effect function compute(n: number) {
  try Effect.sleep("1 millis")
  events.push(`computed ${n}`)
  return n * 2
}

effect function boom() {
  try Effect.sleep("1 millis")
  throw new Boom()
}

// The ticker outlives this function and the server it acquired: main owns it.
effect function serve() {
  const started = try Deferred.make<void>()
  using server = try resource("server")
  fork ticker("ticker", started)
  try Deferred.await(started)
  try Effect.sleep("5 millis")
  return `served by ${server}`
}

// Fiber.join waits for the child and returns its result.
effect function joined() {
  const child = fork compute(21)
  events.push("parent goes on")
  return try Fiber.join(child)
}

// A block owns nothing, and neither does the function around it: the fiber
// belongs to the current fiber, so it runs on after both.
effect function inner() {
  const started = try Deferred.make<void>();
  {
    fork ticker("inner", started)
    try Deferred.await(started)
    try Effect.sleep("2 millis")
  }
  events.push("after inner block")
  return "inner done"
}

// A fork in a loop body runs on past its iteration, for the same reason.
effect function perIteration() {
  for (const n of [1, 2]) {
    const started = try Deferred.make<void>()
    fork ticker(`loop ${n}`, started)
    try Deferred.await(started)
    try Effect.sleep("2 millis")
    events.push(`end of iteration ${n}`)
  }
  return "loop done"
}

// The child's failure reaches the parent only through Fiber.join.
effect function failingChild() {
  const child = fork boom()
  return Effect.as(Fiber.join(child), "no failure") catch (e) => `joined ${e._tag}`
}

// A failure the caller handles leaves the child running: its parent goes on.
effect function failingBlock() {
  const started = try Deferred.make<void>()
  fork ticker("doomed", started)
  try Deferred.await(started)
  try Effect.sleep("2 millis")
  throw new Boom()
}

// Effect.forkScoped: the caller's Scope owns the fiber, so it stops when that
// scope closes, even though it was started in this arrow.
const background = effect (name: string, started: Deferred.Deferred<void>) => try Effect.forkScoped(effect { return try ticker(name, started) })

effect function scopedBackground() {
  return try Effect.scoped(effect {
    const started = try Deferred.make<void>()
    try background("background", started)
    try Deferred.await(started)
    try Effect.sleep("2 millis")
    events.push("scope closing")
    return "scoped done"
  })
}

// Effect.forkScoped keeps Effect's meaning: the caller's Scope owns the
// fiber, so it outlives the block that forked it.
effect function outlives() {
  const started = try Deferred.make<void>()
  using block = try resource("block")
  try Effect.forkScoped(effect { return try ticker("forkScoped", started) })
  try Deferred.await(started)
  return block
}

effect function scopedCaller() {
  return try Effect.scoped(effect {
    const result = try outlives()
    events.push("block exited")
    try Effect.sleep("2 millis")
    return result
  })
}

// Effect.forkDetach keeps Effect's meaning: the fiber outlives the block.
effect function detached() {
  const fiber = try Effect.forkDetach(effect { return try compute(1) })
  return fiber
}

function phase<A>(name: string, result: A) {
  events.push(`-- ${name}`)
  return result
}

// expect-result: {"served":"served by server","joined":42,"inner":"inner done","loop":"loop done","failing":"joined Boom","failedBlock":"Boom","scoped":"scoped done","outlives":"block","detached":2,"events":["acquire server","release server","-- served","parent goes on","computed 21","-- joined","after inner block","-- inner","end of iteration 1","end of iteration 2","-- loop","-- failing","-- failedBlock","scope closing","stop background","-- scoped","acquire block","release block","block exited","stop forkScoped","-- outlives","computed 1","-- detached","stop ticker","stop inner","stop loop 1","stop loop 2","stop doomed"]}
export effect function main() {
  const served = phase("served", try serve())
  const j = phase("joined", try joined())
  const i = phase("inner", try inner())
  const l = phase("loop", try perIteration())
  const f = phase("failing", try failingChild())
  let failedBlock = "none"
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    try failingBlock()
  
;return { kind: "normal" } as const;
}, effect (e) => {
    failedBlock = e._tag
  
;return { kind: "normal" } as const;
});

}
  phase("failedBlock", failedBlock)
  const s = phase("scoped", try scopedBackground())
  const o = phase("outlives", try scopedCaller())
  const fiber = try detached()
  const d = try Fiber.join(fiber)
  phase("detached", d)
  return { served, joined: j, inner: i, loop: l, failing: f, failedBlock, scoped: s, outlives: o, detached: d, events }
}
