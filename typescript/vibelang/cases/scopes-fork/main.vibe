// fork starts a fiber that the region around it owns (D19, D47, D408): the
// region is a Scope region even without using, and when it exits by any path
// it interrupts the fiber and waits for its cleanup before it releases what
// it acquired earlier. A bare block owns nothing. Fiber.join waits for the
// fiber. Effect's own fork combinators keep their meaning, and
// Effect.forkScoped gives a fiber the caller's Scope.
import { Data, Effect, Fiber } from "effect"
import { fork } from "vibelang-runtime"

class Boom extends Data.TaggedError("Boom")<{}> {}

const events: string[] = []

function resource(name: string) {
  return try Effect.acquireRelease(
    () => {
      events.push(`acquire ${name}`)
      return name
    },
    () => {
      events.push(`release ${name}`)
    }
  )
}

// Runs until it is interrupted.
function ticker(name: string) {
  try {
    while (true) {
      try Effect.sleep("1 millis")
    }
  } finally {
    events.push(`stop ${name}`)
  }
}

function compute(n: number) {
  try Effect.sleep("1 millis")
  events.push(`computed ${n}`)
  return n * 2
}

function boom() {
  try Effect.sleep("1 millis")
  throw new Boom()
}

// The ticker stops before the server, acquired earlier, is released.
function serve() {
  using server = try resource("server")
  fork ticker("ticker")
  try Effect.sleep("5 millis")
  return `served by ${server}`
}

// Fiber.join waits for the child and returns its result.
function joined() {
  const child = fork compute(21)
  events.push("parent goes on")
  return try Fiber.join(child)
}

// A bare block owns nothing (D408): the function's body owns the fiber, so
// it stops when the body exits, after the block.
function inner() {
  {
    fork ticker("inner")
    try Effect.sleep("2 millis")
  }
  events.push("after inner block")
  return "inner done"
}

// A fork in a loop body stops at the end of its iteration.
function perIteration() {
  for (const n of [1, 2]) {
    fork ticker(`loop ${n}`)
    try Effect.sleep("2 millis")
    events.push(`end of iteration ${n}`)
  }
  return "loop done"
}

// The child's failure reaches the parent only through Fiber.join.
function failingChild() {
  const child = fork boom()
  try {
    try Fiber.join(child)
  } catch (e) {
    return `joined ${e._tag}`
  }
  return "no failure"
}

// A block that fails still stops its fibers.
function failingBlock() {
  fork ticker("doomed")
  try Effect.sleep("2 millis")
  throw new Boom()
}

// Effect.forkScoped: the caller's Scope owns the fiber. An arrow's body owns
// a fork in it (D353), so returning that fiber would be EK4838 (D409).
const background = (name: string) => Effect.forkScoped(() => ticker(name))

function scopedBackground() {
  return try Effect.scoped(() => {
    try background("background")
    try Effect.sleep("2 millis")
    events.push("scope closing")
    return "scoped done"
  })
}

// Effect.forkScoped keeps Effect's meaning: the caller's Scope owns the
// fiber, so it outlives the block that forked it.
function outlives() {
  using block = try resource("block")
  try Effect.forkScoped(() => ticker("forkScoped"))
  return block
}

function scopedCaller() {
  return try Effect.scoped(() => {
    const result = try outlives()
    events.push("block exited")
    try Effect.sleep("2 millis")
    return result
  })
}

// Effect.forkDetach keeps Effect's meaning: the fiber outlives the block.
function detached() {
  const fiber = try Effect.forkDetach(() => compute(1))
  return fiber
}

function phase<A>(name: string, result: A) {
  events.push(`-- ${name}`)
  return result
}

// expect-result: {"served":"served by server","joined":42,"inner":"inner done","loop":"loop done","failing":"joined Boom","failedBlock":"Boom","scoped":"scoped done","outlives":"block","detached":2,"events":["acquire server","stop ticker","release server","-- served","parent goes on","computed 21","-- joined","after inner block","stop inner","-- inner","end of iteration 1","stop loop 1","end of iteration 2","stop loop 2","-- loop","-- failing","stop doomed","-- failedBlock","scope closing","stop background","-- scoped","acquire block","release block","block exited","stop forkScoped","-- outlives","computed 1","-- detached"]}
export function main() {
  const served = try phase("served", try serve())
  const j = try phase("joined", try joined())
  const i = try phase("inner", try inner())
  const l = try phase("loop", try perIteration())
  const f = try phase("failing", try failingChild())
  let failedBlock = "none"
  try {
    try failingBlock()
  } catch (e) {
    failedBlock = e._tag
  }
  try phase("failedBlock", failedBlock)
  const s = try phase("scoped", try scopedBackground())
  const o = try phase("outlives", try scopedCaller())
  const fiber = try detached()
  const d = try Fiber.join(fiber)
  try phase("detached", d)
  return { served, joined: j, inner: i, loop: l, failing: f, failedBlock, scoped: s, outlives: o, detached: d, events }
}
