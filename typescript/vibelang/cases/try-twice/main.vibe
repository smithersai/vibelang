// expect-result: {"two":1,"grouped":1,"runs":4}
// try works like await (VIP-5): each try runs one Effect, so try try f() runs
// the Effect f() gives and then the Effect that one succeeds with.
let runs = 0

effect function inner() {
  runs++
  return 1
}

effect function outer() {
  runs++
  return inner()
}

export effect function main() {
  const two = try try outer()
  const grouped = try (try outer())
  return { two, grouped, runs }
}
