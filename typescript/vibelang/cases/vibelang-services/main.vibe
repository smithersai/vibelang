// Services are abstract classes (D1, D45). A call to a member looks the
// service up and joins R (D41); Users() returns the implementation.
import { Data, Effect, Layer } from "effect"

class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Directory {
  lookup(id: string): Effect.Effect<User | undefined, never, never>
}

service Users {
  find(id: string): Effect.Effect<User, UserNotFound, never>
}

service Settings {
  readonly greeting: string
  shout(text: string): Effect.Effect<string, never, never>

  static readonly layer = Layer.succeed(Settings, {
    greeting: "Welcome",
    shout: effect (text: string) => try Effect.succeed(`${text}!`)
  })
}

const users = new Map<string, User>([["1", { id: "1", name: "Ada" }]])

const DirectoryLive = Layer.succeed(Directory, {
  lookup: effect (id: string) => try Effect.succeed(users.get(id))
})

// The provider captures Directory when the layer is built, so Directory is a
// requirement of the layer, not of Users.find.
effect function makeUsers() {
  const directory = try Directory()
  const impl: Users.Shape = {
    effect find(id) {
      const user = try directory.lookup(id)
      if (user === undefined) return try Effect.fail(new UserNotFound({ id }))
      return try Effect.succeed(user)
    }
  }
  return impl
}

const UsersLive = Layer.effect(Users, effect { return try makeUsers() })

// An implementation can be a class that implements the service.
class UsersInMemory implements Users {
  readonly rows = new Map<string, User>([["7", { id: "7", name: "Grace" }]])

  effect find(id: string) {
    const user = this.rows.get(id)
    if (user === undefined) return try Effect.fail(new UserNotFound({ id }))
    return try Effect.succeed(user)
  }
}

// A method that implements a service member compiles to an Effect even when
// its body runs nothing, in a class and in an object literal.
class UsersFake implements Users {
  effect find(id: string) {
    return { id, name: `fake ${id}` }
  }
}

const UsersGrace = Layer.succeed(Users, {
  effect find(id) {
    return { id, name: "Grace" }
  }
})

export effect function greet(id: string) {
  const user = try Users.find(id)
  return try Settings.shout(`${(try Settings()).greeting}, ${user.name}`)
}

export effect function lookupBoth(id: string) {
  const first = try (try Users()).find(id)
  return first.name
}

const Memory = Layer.mergeAll(Layer.succeed(Users, new UsersInMemory()), Settings.layer)

// expect-result: {"live":"Welcome, Ada!","memory":"Welcome, Grace!","direct":"Grace","missing":"UserNotFound","fake":"fake 3","grace":"Grace"}
export effect function main() {
  return {
    live: try Effect.provide(effect { return try greet("1") }, Layer.mergeAll(Layer.provide(UsersLive, DirectoryLive), Settings.layer)),
    memory: try Effect.provide(effect { return try greet("7") }, Memory),
    direct: try Effect.provide(effect { return try lookupBoth("7") }, Layer.succeed(Users, new UsersInMemory())),
    missing: (try Effect.flip(effect { return try Effect.provide(effect { return try greet("9") }, Memory) }))._tag,
    fake: try Effect.provide(effect { return try lookupBoth("3") }, Layer.succeed(Users, new UsersFake())),
    grace: try Effect.provide(effect { return try lookupBoth("4") }, UsersGrace)
  }
}
