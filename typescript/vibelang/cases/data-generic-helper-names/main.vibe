// rule-evidence: docs/design/vips/0028-generic-data.md#2e384c51dbec23d2 | **Amended 2026-10-29: the helper's name.** The helper for `data Outcome<A>` is named `$Outcome$Definition`; if the module already declares that name, the compiler appends `$2`, `$3`, … and takes the first free name.
export type $One$Definition = "kept"
export type $One$Definition$2 = 2
export data One<A> { V { first:A } }
export data Two<A,B> { V { first:A; second:B } }
export data Three<A,B,C> { V { first:A; second:B; third:C } }
export data Four<A,B,C,D> { V { first:A; second:B; third:C; fourth:D } }
export type $Two$Definition = "later"
export type $Hole$Definition = "taken"
export type $Hole$Definition$3 = 3
export data Hole<A> { V { first:A } }
export type $Fo\u0075r$Definition = "escaped"
// expect-result: ["V",1,"V","a",2,"V",true,"b",3,"V",1,"c",false,4]
export effect function main(): readonly unknown[]!never {
  const one=One.V({first:1})
  const two=Two.V({first:"a",second:2})
  const three=Three.V({first:true,second:"b",third:3})
  const four=Four.V({first:1,second:"c",third:false,fourth:4})
  return [one._tag,one.first,two._tag,two.first,two.second,three._tag,three.first,three.second,three.third,four._tag,four.first,four.second,four.third,four.fourth]
}
