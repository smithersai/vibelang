// expect-result: {"name":"Ada","region":"eu","size":3,"named":"named","port":8080}
// A Context.Service class draws EK4831 (D285). Its quick fix writes a service
// declaration with the key (D501) and, for an export, its shape as written,
// including named and non-object whole shapes (VIP-9, amended 2026-11-02).
// The conversion preserves each written shape and key.
// tsforms-services-fixed is what vibelang --fix writes.

export service Users: {
  find(id: string): string!!
  readonly region: string,
  size: (name: string) => number!!
} { static readonly key = "app/Users" }

interface NamedShape {
  read(): string!!
}
service Named: NamedShape { static readonly key = "app/Named";}
service Port: number { static readonly key = "app/Port";}

const UsersLive = Layer.succeed(Users, {
  effect find(id) { return id === "1" ? "Ada" : "?" },
  region: "eu",
  effect size(name) { return name.length }
})
const NamedLive = Layer.succeed(Named, { effect read() { return "named" } })
const PortLive = Layer.succeed(Port, 8080)

export effect function main() {
  provide UsersLive, NamedLive, PortLive {
    const users = try Users
    const name = try users.find("1")
    return { name, region: users.region, size: try users.size(name), named: try (try Named).read(), port: try Port }
  }
}
