// expect-result: {"name":"Ada","region":"eu","size":3,"named":"named","port":8080}
// A Context.Service class draws EK4831 (D285). Its quick fix writes a service
// declaration, keeping the key as static readonly key (D501), when the
// shape's members are written in place; a named shape keeps the warning
// without a fix, and a shape that is not an object type has no service form
// and draws nothing. tsforms-services-fixed is what vibelang --fix writes.

export service Users {
  static readonly key = "app/Users"
  find(id: string): string!!
  region: string
  size: (name: string) => number!!
}

interface NamedShape {
  read(): string!!
}
class Named extends Context.Service<Named, NamedShape>()("app/Named") {}
class Port extends Context.Service<Port, number>()("app/Port") {}

const UsersLive = Layer.succeed(Users, {
  find(id) { return id === "1" ? "Ada" : "?" },
  region: "eu",
  size(name) { return name.length }
})
const NamedLive = Layer.succeed(Named, { read() { return "named" } })
const PortLive = Layer.succeed(Port, 8080)

export function main() {
  provide UsersLive, NamedLive, PortLive {
    const name = Users.find("1")
    return { name, region: Users().region, size: Users.size(name), named: Named.read(), port: Port() }
  }
}
