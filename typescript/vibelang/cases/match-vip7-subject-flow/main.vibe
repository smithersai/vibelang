import {Effect} from "effect"
type Equal<A,B>=(<T>()=>T extends A?1:2) extends (<T>()=>T extends B?1:2)?true:false
type Input={_tag:"A";id:string|number}|{_tag:"B";value:number}
export function subject(s:"a"|"b"|1):"a"|"b"|1{return match(s){when "a":do{const exact:Equal<typeof s,"a">=true;s};when 1:do{const exact:Equal<typeof s,1>=true;s};default:do{const exact:Equal<typeof s,"b">=true;s};}}
export function guarded(s:Input):string{return match(s){when {_tag:"A",let id} and if(typeof id==="string"):id.toUpperCase();default:do{const exact:Equal<typeof s,Input>=true;s._tag};}}
export function main():Effect.Effect<readonly unknown[]>{return Effect.sync(()=>[subject("a"),subject("b"),subject(1),guarded({_tag:"A",id:"x"}),guarded({_tag:"A",id:1}),guarded({_tag:"B",value:1})])}
// VIP-7 subject narrowing and guarded default remainder; rule: docs/design/vips/0007-match.md#98bec1db55b535c1
