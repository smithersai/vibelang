// Reusing an Effect never reuses a parameter binding.
export const compact = (n: number): Effect<number, never, never> => n += 1
export const expanded = (n: number): Effect<number, never, never> => {
  const result = n += 1
  return result
}
export function declared(n: number): Effect<number, never, never> { return n += 1 }
export const expression = function (n: number): Effect<number, never, never> { return n += 1 }
export function declaredProgram(n: number): Effect<number, never, never> { return try Effect.succeed(n += 1) }
