// Reusing an Effect never reuses a parameter binding.
export const compact = effect (n: number): Effect<number, never, never> => n += 1
export const expanded = effect (n: number): Effect<number, never, never> => {
  const result = n += 1
  return result
}
export effect function declared(n: number): Effect<number, never, never> { return n += 1 }
export const expression = effect function (n: number): Effect<number, never, never> { return n += 1 }
export effect function declaredProgram(n: number): Effect<number, never, never> { return try Effect.succeed(n += 1) }
