// expect: EK0501
// rule-evidence: docs/design/src/002-running.md#00b70e6bf96d1cd9
// Chapter 002: Outside effect code a parser still parses these constructs, as TypeScript parses `await x` outside an `async` function, and reports the construct's "outside effect code" error.
// rule-evidence: docs/design/src/002-running.md#cd6a6a66d5e8f917
// Chapter 002: | `try` outside effect code; the same rule applies to `try.all`, `try.race`, `try.any` or `try.allSettled` | `EK0501` |
import { Effect } from "effect"
export function plain() { return [try Effect.succeed(1), try.all [Effect.succeed(1)], try.race [Effect.succeed(1)], try.any [Effect.succeed(1)], try.allSettled [Effect.succeed(1)]] }
