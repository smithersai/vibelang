import { Effect, Schedule } from "effect"
error Again {}
export const make = (state: { mutable setups: number, mutable runs: number }): Effect.Effect<number, Again, never> => {
  state.setups++
  return effect { state.runs++; throw new Again() }
}
// expect-result: [1,4,4,4]
export effect function main() {
  const heldState = { setups: 0, runs: 0 }
  const namedState = { setups: 0, runs: 0 }
  const held: Effect.Effect<number, Again, never> = make(heldState)
  try Effect.result(Effect.retry(held, Schedule.recurs(3)))
  try Effect.result(Effect.retry(make(namedState), Schedule.recurs(3)))
  return [heldState.setups, namedState.setups, heldState.runs, namedState.runs]
}
