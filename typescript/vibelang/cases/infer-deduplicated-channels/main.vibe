import * as $nativeTryEffect from "effect/Effect";
// expect-result: 14
export error Missing
export service Need { value(): number!! }

export effect function base(x: number) {
  if (x < 0) throw new Missing()
  return try (try Need).value()
}

export effect function twice(x: number) {
  const a = try base(x)
  return a > 0 ? a : try base(x + 1)
}

export effect function contracted(x: number): number!Missing!Need {
  { const $nativeTryCompletion = try $nativeTryEffect.onExit(effect { return { kind: "return:" as const, value: (try twice(x)) }; }, () => effect { try twice(x) });
return $nativeTryCompletion.value;
}
}

export class Chain {
  effect base(x: number) { return try base(x) }
  effect top(x: number) {
    const a = try this.base(x)
    return a > 0 ? a : try this.base(x + 1)
  }
}

export effect function main() {
  provide Layer.succeed(Need, { value: effect () => 7 }) {
    return try contracted(1) + try new Chain().top(1)
  }
}
