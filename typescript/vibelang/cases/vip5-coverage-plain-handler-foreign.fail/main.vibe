// expect: EK0401 EK0401
// rule-evidence: docs/design/vips/0005-try-runs-effects.md#0fe3f3053beae320
// VIP-5: a throwing call in a plain handler (EK0401 since VIP-4, amended 2026-10-31;
// an untagged call there stays an ordinary call, 003 Plain code never throws)
import { known } from "./foreign.js"
effect function body() { return Effect.fail("bad") catch () => known() }
effect function parameter() { return Effect.fail<number | undefined>(undefined) catch (e = known()) => e }

