// main provides Users itself, and the entry provides FileSystem: nothing is
// reported.
import "vibelang/platform/node"
import { FileSystem } from "effect/FileSystem"
import { Users, UsersLive } from "./services.vibe"

export effect function main() {
  provide UsersLive {
    try Console.log(`${try Users.find("1")}: ${try FileSystem.readFileString("users.json")}`)
  }
}
