// expect-result: {"a":{"id":"1","name":"Ada","role":"admin","tags":["x"],"home":{"city":"Paris"},"score":[1,"a"],"counts":{"a":1},"verified":null,"login":{"at":3}},"b":"invalid","c":true}
export schema Address {
  readonly city: string
  readonly zip?: string
}

export schema User {
  readonly id: string
  readonly name: string
  readonly nickname?: string
  readonly role: "admin" | "member"
  readonly tags: ReadonlyArray<string>
  readonly home: Address
  readonly score: readonly [number, string]
  readonly counts: Record<string, number>
  readonly verified: boolean | null
  readonly login: { readonly at: number }
}

effect function decode(input: unknown) {
  try {
    return try Schema.decodeUnknownEffect(User)(input)
  } catch (e) {
    return "invalid"
  }
}

// The type is the struct's decoded type.
function guest(): User {
  return { id: "2", name: "Bo", role: "member", tags: [], home: { city: "Rome" }, score: [2, "b"], counts: {}, verified: true, login: { at: 0 } }
}

export effect function main() {
  return {
    a: try decode({ id: "1", name: "Ada", role: "admin", tags: ["x"], home: { city: "Paris" }, score: [1, "a"], counts: { a: 1 }, verified: null, login: { at: 3 } }),
    b: try decode({ id: 1 }),
    c: guest().role === "member"
  }
}
