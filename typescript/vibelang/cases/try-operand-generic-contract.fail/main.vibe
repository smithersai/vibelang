// expect: EK0403
// A try operand keeps its callee's thrown contract. A generic signature is
// classified as effectful before type-argument substitution, through its
// constraints, and any is not effectful, so these foreign calls are EK0403
// even though try runs the Effect they are instantiated to.
import { get, loose } from "./foreign.js"
export effect function main() {
  const generic = try get<number!!>("key")
  const untyped = try loose()
  return generic + untyped
}
