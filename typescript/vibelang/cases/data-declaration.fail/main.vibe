// expect: TS2300 TS2717 EK1601 EK1602 EK1606 EK2126 EK2801
// What a data declaration (D307) cannot hold.

// Zero variants are permitted (VIP-16/detail 25).
data Empty {}

// TS2300: duplicate variant names follow TypeScript type literals.
data Twice {
  Same
  Same { x: string }
}

// EK1602: Data.taggedEnum reserves $is and $match; EK1601 reserves a variant's _tag.
data Reserved {
  $is
  $match
  Tagged { _tag: string }
}

// EK1606: a variant holds only fields, each typed and readonly.
data Members {
  Method { run(): void }
  Mutable { mutable count: number }
  Untyped { untyped }
  Indexed { [key: string]: unknown }
}

// EK2801 limits the parameter count; EK2126 rejects a constraint.
data Five<A, B, C, D, E> { Five { a: A; e: E } }
// rule-evidence: docs/design/vips/0028-generic-data.md#698d7b6fa614cd8f | **Amended 2026-10-29: no constraints.** A constraint on a generic `data` type parameter (`<A extends string>`) is a compile error, since this VIP doesn't add them (EK2126 keeps that part).
data Bound<A extends string> { Bound { a: A } }

// A user NameDefinition remains independent from the generated helper.
data Box<A> { Full { a: A } }
interface BoxDefinition { other: string }
