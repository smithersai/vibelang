// expect: EK2122 TS2300 TS2717 EK2124 EK2125 EK2126 EK2801 EK1013
// What a data declaration (D307) cannot hold.

// EK2122: no variants.
data Empty {}

// TS2300: duplicate variant names follow TypeScript type literals.
data Twice {
  Same
  Same { x: string }
}

// EK2124: names Data.taggedEnum reserves: its $is and $match, and a variant's _tag.
data Reserved {
  $is
  $match
  Tagged { _tag: string }
}

// EK2125: a variant holds only fields, each typed and readonly.
data Members {
  Method { run(): void }
  Mutable { mutable count: number }
  Untyped { untyped }
  Indexed { [key: string]: unknown }
}

// EK1013: ; or a new line separates fields and variants, as in an error's body.
data Commas {
  Point { x: number, y: number },
  Origin
}

// EK2801 limits the parameter count; EK2126 rejects a constraint.
data Five<A, B, C, D, E> { Five { a: A; e: E } }
data Bound<A extends string> { Bound { a: A } }

// A user NameDefinition remains independent from the generated helper.
data Box<A> { Full { a: A } }
interface BoxDefinition { other: string }
