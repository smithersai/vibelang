// expect: EK4301
// Reference program 4 / D9: an effect function (it calls Users.find) passed by name where
// Array.prototype.forEach drops what its callback returns: each Effect is dropped unrun, EK4301.
// map keeps them as data (VIP-1).

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

effect function findName(id: string) {
  return (try Users.find(id)).name
}

function names(ids: ReadonlyArray<string>) {
  ids.forEach(findName)
  return ids.map(findName)
}
