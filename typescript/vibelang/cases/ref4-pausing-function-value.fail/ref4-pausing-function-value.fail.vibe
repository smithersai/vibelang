// expect: EK4301
// Reference program 4 / D9: a .vibe function that can pause (it calls Users.find), passed by name
// where Array.prototype.map expects a plain JavaScript function. It has no plain variant.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

effect function findName(id: string) {
  return (try Users.find(id)).name
}

function names(ids: ReadonlyArray<string>) {
  return ids.map(findName)
}
