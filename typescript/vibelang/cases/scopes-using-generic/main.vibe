// A generic using is the same one program as the using written inline
// (D490): under timeout(…, "100 millis"), withResource(() => connect(…)) and
// withResource(() => openDb(…)) each end when the same using written inline
// ends, and so does a callback's that writes its channels. withResource's R is
// Exclude<R, Scope> (expected/generic.d.ts), so its caller needs no Scope,
// and withScoped, whose R extends Scope, binds a value with no disposal
// method.
// expect-result: {"socket":{"inline":["TimeoutError"],"generic":["TimeoutError"],"typed":["TimeoutError"]},"db":{"inline":["TimeoutError"],"generic":["TimeoutError"],"callback":["TimeoutError"]},"scoped":"scoped"}
import { withAnyResource } from "./callback.vibe"
import { withResource, withResourceTyped, withScoped } from "./generic.vibe"

/** Fails to compile unless T is never. */
type Never<T extends never> = T

type Left = Never<Effect.Services<ReturnType<typeof withResource<Socket, Scope>>>>
type LeftTyped = Never<Effect.Services<ReturnType<typeof withResourceTyped<Socket, Scope>>>>
type LeftCallback = Never<Effect.Services<ReturnType<typeof withAnyResource<never, Scope>>>>

export effect function main(): object!! {
  const left: Array<Left | LeftTyped | LeftCallback> = []
  return {
    socket: {
      inline: try deadline(effect (seen) => try holdSocket(seen)),
      generic: try deadline(effect (seen) => { try withResource(effect () => try connect(seen)) }),
      typed: try deadline(effect (seen) => { try withResourceTyped(effect () => try connect(seen)) })
    },
    db: {
      inline: try deadline(effect (seen) => try holdDb(seen)),
      generic: try deadline(effect (seen) => { try withResource(effect () => try openDb(seen)) }),
      callback: try deadline(effect (seen) => { try withAnyResource(effect () => try openDb(seen)) })
    },
    scoped: [try withScoped(effect () => try plainScoped()), ...left][0]
  }
}

// Runs work under a 100 ms deadline and returns what it recorded, then how
// the deadline ended.
effect function deadline(work: (seen: string[]) => void!!) {
  const seen: string[] = []
  try {
    try Effect.timeout(effect { return try work(seen) }, "100 millis")
    seen.push("finished")
  } catch (e) {
    seen.push(e._tag)
  }
  return seen
}

class Socket {
  [Symbol.dispose](): void {}
}

effect function connect(seen: string[]) {
  return try Effect.acquireRelease(
    effect {
      try sleep("2 seconds")
      seen.push("connected")
      return new Socket()
    },
    effect () => {
      seen.push("released")
    },
    { interruptible: true }
  )
}

effect function openDb(seen: string[]) {
  try sleep("2 seconds")
  seen.push("opened")
  return { [Symbol.dispose](): void { seen.push("disposed") } }
}

effect function plainScoped(): { name: string }!!Scope {
  return { name: "plain" }
}

effect function holdSocket(seen: string[]) {
  using socket = try connect(seen)
  seen.push("body")
}

effect function holdDb(seen: string[]) {
  using db = try openDb(seen)
  seen.push("body")
}
