// A module whose name names a service reads a value member from the
// service's implementation, as its key does (D311): (try Path.Path).sep is
// the separator. Terminal's columns is a program, as Effect declares it:
// (try Terminal.Terminal).columns is that program, and try runs it; an
// Effect is not a function, so only try runs it (VIP-5, VIP-10). Path.sep
// and Terminal.columns are EK4503 (module-service-values.fail).
const Fixed = Terminal.make({
  columns: Effect.succeed(80),
  rows: Effect.succeed(24),
  readInput: Effect.die("no input"),
  readLine: Effect.succeed("line"),
  size: Effect.die("no resize"),
  display: (text: string) => Effect.void
})

// expect-result: ["/",true,80,80]
export effect function main() {
  provide Path.layer, Layer.succeed(Terminal.Terminal, Fixed) {
    const columns = (try Terminal.Terminal).columns
    return [(try Path.Path).sep, Effect.isEffect(columns), try (try Terminal.Terminal).columns, try (try Terminal.Terminal).columns]
  }
}
