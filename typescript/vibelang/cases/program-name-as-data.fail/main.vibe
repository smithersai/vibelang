// expect: EK4802
// A program named by reference, a function with no parameters that returns
// an Effect, is data where the success type names no value (void, unknown,
// any, or a type parameter its call infers), as a program literal is (D24,
// D269), where Effect code would run it. EK4802 is an error here
// (tsconfig.json).
service Status { set(code: number): void!! }

const listFlows = effect () => {
  try Console.log("listing")
}
const handlers = { list: listFlows }

// A command handler whose contract is void!!.
const command = (name: string, handler: (n: number) => void!!): infer _ => handler
export const ls = command("ls", effect () => listFlows)
export const fromField = command("list", effect () => handlers.list)

// A written unknown success.
export const written = effect (): unknown!! => listFlows

// A callback whose success is a type parameter, and a parameter by name.
export const thunk = effect () => try Effect.suspend(effect () => listFlows)
export const param = effect (body: () => void!!) => try Effect.suspend(effect () => body)

// An arm of a conditional whose other arm runs.
export const arm = effect (code: number) => try Effect.suspend(effect () => code > 0 ? listFlows : try Status.set(code))

// Not reported: the call runs, the success type names the function, or no
// Effect is expected.
export const called = command("ls", effect () => try listFlows())
export const kept = effect (): (() => void!!)!! => listFlows
export const plain = effect (n: number) => listFlows
