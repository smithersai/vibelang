export effect function limitOmitted() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitLegacyThreeArgs() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; try $forConcurrent((collections++, events.push("items"), [1,2,3]), undefined, effect (item: number) => { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }); return { maximum, limits, collections, events } }
export effect function limitLegacyFalse() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; try $forConcurrent((collections++, events.push("items"), [1,2,3]), undefined, effect (item: number) => { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }, false); return { maximum, limits, collections, events } }
