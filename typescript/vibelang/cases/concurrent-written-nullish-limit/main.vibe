import { $forConcurrent } from "vibelang-runtime"
import { Effect } from "effect"
export effect function limitUndefined() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent((limits++, events.push("limit"), undefined as any)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitNull() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent((limits++, events.push("limit"), null as any)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitVoid() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent((limits++, events.push("limit"), (void 0) as any)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitHeldUndefined() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; const held: any = undefined; for concurrent((limits++, events.push("limit"), held)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitHeldNull() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; const held: any = null; for concurrent((limits++, events.push("limit"), held)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitFactoryUndefined() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; const make = (): any => { events.push("factory"); return undefined }; for concurrent((limits++, events.push("limit"), make())) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitFactoryNull() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; const make = (): any => { events.push("factory"); return null }; for concurrent((limits++, events.push("limit"), make())) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitGroupedUndefined() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent((limits++, events.push("limit"), ((undefined as any)))) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitShadowUndefined() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0; const undefined = 1; for concurrent((limits++, events.push("limit"), undefined)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
export effect function limitOne() { const events: string[] = []; let active = 0, maximum = 0, limits = 0, collections = 0;  for concurrent((limits++, events.push("limit"), 1)) (const item of (collections++, events.push("items"), [1,2,3])) { active++; maximum = Math.max(maximum, active); try Effect.yieldNow; active--; events.push("item:" + item); }; return { maximum, limits, collections, events } }
