// Without rewriteRelativeImportExtensions, a .vibe file still imports ./names.vibe
// and ./format.ts by their source names, with no TS5097, and the emitted
// JavaScript imports ./names.js and ./format.js (D31).
import { fullName } from "./names.vibe"
import { formatName } from "./format.ts"
export { fullName } from "./names.vibe"

// expect-result: ["Lovelace, Ada","Hopper, Grace"]
export effect function main() {
  return [try fullName("Ada", "Lovelace"), formatName("Grace", "Hopper")]
}
