// Readonly and nested object types retain the source's written property
// modifiers in declarations, just as typescript/main.ts does.
export type Info = Readonly<{
  path: ReadonlyArray<string>
  label?: string
  [key: string]: unknown
}>

export type Nested = Readonly<{ inner: { count: number } }>

export type Pair = Readonly<{ mutable left: number; right: number }>
