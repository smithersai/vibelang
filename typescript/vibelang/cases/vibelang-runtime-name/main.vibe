import * as $nativeTryEffect from "effect/Effect";
// Generated code imports vibelang-runtime as a namespace under a free
// name. This file declares runtime and Effect_1 itself, so the lowering
// picks other names for its imports.
class Missing extends TaggedError("Missing")<{ readonly key: string }> {}

const runtime = "node"
const Effect_1 = 1
const settings: Record<string, string> = { mode: "fast" }

effect function read(key: string) {
  const value = settings[key]
  if (value === undefined) throw new Missing({ key })
  return value
}

effect function readOr(key: string, fallback: string) {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try read(key)) };
  }, effect (e) => {
    return { kind: "return:" as const, value: (`${fallback} (${e._tag})`) };
  });
return $nativeTryCompletion.value;
}
}

// expect-result: {"runtime":"node","one":1,"mode":"fast","level":"info (Missing)"}
export effect function main() {
  return { runtime, one: Effect_1, mode: try readOr("mode", "slow"), level: try readOr("level", "info") }
}
