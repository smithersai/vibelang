// expect-result: [["a","b","c"],null]
import { Effect } from "effect"

const find = effect (
  target: string,
  start: string,
  parentsOf: (id: string) => Effect.Effect<ReadonlyArray<string>, never, never>
): Effect.Effect<ReadonlyArray<string> | undefined, never, never> =>
  try Effect.suspend(effect () => {
    const walk = effect (
      current: string,
      chain: ReadonlyArray<string>
    ): Effect.Effect<ReadonlyArray<string> | undefined, never, never> => {
      const parents = try parentsOf(current)
      for (const parent of parents) {
        if (parent === target) return [...chain, parent]
        const found = try walk(parent, [...chain, parent])
        if (found !== undefined) return found
      }
      return undefined
    }
    return try walk(start, [start])
  })

export effect function main() {
  const parentsOf = effect (id: string): Effect.Effect<ReadonlyArray<string>, never, never> =>
    try Effect.succeed(id === "a" ? ["b"] : id === "b" ? ["c"] : [])
  return [try find("c", "a", parentsOf), try find("missing", "a", parentsOf)]
}
