// expect: EK0501
// rule-evidence: docs/design/vips/0026-top-level-and-main.md#decision | `await` there is ES top-level await of a Promise (VIP-5), and `try` is not allowed, because a top level is not an `effect` function.
import { Effect } from "effect"
export const value = try Effect.succeed(1)
try Effect.log("statement")
if (value) { try Effect.log("block") }
{ const nested = try Effect.succeed(2); void nested }
// Control: inside an effect function, try is allowed.
export effect function main() { try Effect.log("allowed") }
