// expect: EK0401
import { Effect } from "effect"
import { risky } from "./foreign.js"
type Options = {try:()=>number,catch:(error:unknown)=>unknown}
export const mapper=Effect.try(({try:()=>1,catch:()=>risky("mapper",true)}) satisfies Options)
export const nested=Effect.try((()=> (()=>risky("nested",true))()) as ()=>number)
export const explicit=Effect.try((()=>{throw new RangeError()}) as ()=>number)
export const strict=Effect.sync((()=>risky("strict",true)) as ()=>number)
const stored=()=>risky("stored",true)
export const later=Effect.try((stored as ()=>number))
export const forwarded=Effect.try.apply(undefined, ([{try:()=>1,catch:()=>risky("forwarded",true)}] as [Options]))
