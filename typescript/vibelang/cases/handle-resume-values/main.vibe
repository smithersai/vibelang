// expect-result: {"statement":42,"expression":42,"override":"42 clause","normal":["body 1","undefined","clause done","after"],"breaks":["body 1","undefined","clause done","after"],"continues":["body 1","undefined","body 2","undefined","after"],"scoped":42,"inFinally":42,"withValue":42,"withError":"caught busy","record":{"kind":"return","value":"data"},"twiceStatements":["ContinuationAlreadyConsumed"],"twiceExpressions":["ContinuationAlreadyConsumed"],"events":["statement done","expression 42","scoped acquire","scoped 42","scoped release","finally 42","finally done","with 42","error caught busy","twice body true","twice first done","twice body true","twice first true"]}

error Busy { message: string }

control Ask {
  answer(): number!Busy
}

control Once {
  answer(): boolean!!
}

const events: string[] = []

effect function statement() {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    try resume(41)
    events.push("statement done")
  }
}

// The expression sees the body's value and fallthrough keeps its return.
effect function expression() {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    const value = (try resume(41))
    events.push(`expression ${value}`)
  }
}

// A clause return replaces the pending return, as in finally.
effect function override(): Effect<number | string, infer E, infer R> {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    return `${try resume(41)} clause`
  }
}

// Normal completion may have no record at all when no jump leaves the try.
effect function normal() {
  const steps: string[] = []
  try {
    steps.push(`body ${try Ask.answer()}`)
  } handle Ask.answer() {
    steps.push(String(try resume(1)))
    steps.push("clause done")
  }
  steps.push("after")
  return steps
}

effect function breaks() {
  const steps: string[] = []
  outer: for (;;) {
    try {
      steps.push(`body ${try Ask.answer()}`)
      break outer
    } handle Ask.answer() {
      steps.push(String(try resume(1)))
      steps.push("clause done")
    }
    steps.push("unreachable")
  }
  steps.push("after")
  return steps
}

effect function continues() {
  const steps: string[] = []
  outer: for (let i = 1; i <= 2; i++) {
    try {
      steps.push(`body ${try Ask.answer()}`)
      continue outer
    } handle Ask.answer() {
      steps.push(String(try resume(i)))
    }
    steps.push("unreachable")
  }
  steps.push("after")
  return steps
}

effect function scoped() {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    using held = try Effect.acquireRelease(effect {
      events.push("scoped acquire")
    }, effect () => {
      events.push("scoped release")
    })
    const value = try resume(41)
    events.push(`scoped ${value}`)
  }
}

effect function inFinally() {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    try {
      const value = try resume(41)
      events.push(`finally ${value}`)
    } finally {
      events.push("finally done")
    }
  }
}

effect function withValue() {
  try {
    return try Ask.answer() + 1
  } handle Ask.answer() {
    const value = try resumeWith(effect { return 41 })
    events.push(`with ${value}`)
  }
}

effect function withError() {
  try {
    try {
      return String(try Ask.answer())
    } catch (e) {
      return `caught ${e.message}`
    }
  } handle Ask.answer() {
    const value = try resumeWith(effect { throw new Busy({ message: "busy" }) })
    events.push(`error ${value}`)
  }
}

// User data that resembles a completion is unwrapped only once.
effect function record() {
  try {
    try Ask.answer()
    return { kind: "return", value: "data" }
  } handle Ask.answer() {
    const value = try resume(1)
    return value
  }
}

effect function twiceStatements() {
  try {
    const value = try Once.answer()
    events.push(`twice body ${value}`)
    return value
  } handle Once.answer() {
    try resume(true)
    events.push("twice first done")
    try resume(false)
  }
}

effect function twiceExpressions() {
  try {
    const value = try Once.answer()
    events.push(`twice body ${value}`)
    return value
  } handle Once.answer() {
    const first = try resume(true)
    events.push(`twice first ${first}`)
    const second = try resume(false)
    return second
  }
}

function defects(result: Exit.Exit<unknown, unknown>) {
  return Exit.isFailure(result)
    ? (result.cause.reasons as ReadonlyArray<(typeof result.cause.reasons)[number]>).map((reason) => reason._tag === "Die"
      ? (reason.defect as { _tag?: string })._tag
      : reason._tag)
    : ["Success"]
}

export effect function main() {
  return {
    statement: try statement(),
    expression: try expression(),
    override: try override(),
    normal: try normal(),
    breaks: try breaks(),
    continues: try continues(),
    scoped: try scoped(),
    inFinally: try inFinally(),
    withValue: try withValue(),
    withError: try withError(),
    record: try record(),
    twiceStatements: defects(try Effect.exit(effect { return try twiceStatements() })),
    twiceExpressions: defects(try Effect.exit(effect { return try twiceExpressions() })),
    events
  }
}
