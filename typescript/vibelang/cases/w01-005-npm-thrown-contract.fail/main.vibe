// expect: EK0403 EK0403
// rule-evidence: docs/design/src/005-services.md#effects-modules-are-in-scope | An npm signature without `@throws` throws `unknown`, so these non-effectful calls use `Effect.try` bridges; an actual explicit annotation keeps its ordinary contract ([Thrown types](003-failures.md#thrown-types)).
// An npm package's signature without `@throws` throws `unknown`, so its bare
// call in effect code is EK0403 and needs an `Effect.try` bridge. A written
// `@throws {never}` keeps its contract and needs none; a written
// `@throws {RangeError}` keeps its contract and is EK0403 bare.
import { unannotated, neverThrows, throwsRange } from "thrown-contract"

export effect function bare() {
  const d = unannotated(1)
  const e = neverThrows(1)
  const f = throwsRange(1)
  return [d, e, f]
}

// The bridges compile, for the npm calls and for the prelude's calls.
export effect function bridged() {
  const d = try Effect.try(() => unannotated(1))
  const f = try Effect.try(() => throwsRange(1))
  const two = try Effect.try(() => pipe(1, (n: number) => n + 1))
  const first = try Effect.try(() => Effect.Array.head([1, 2]))
  const o = try Effect.try(() => Option.some(1))
  return { d, f, two, first, o }
}
