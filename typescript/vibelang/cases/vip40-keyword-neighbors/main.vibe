// VIP-40: service, error, schema and data declarations are unchanged — spec-rule: docs/design/vips/0040-module-declarations.md#22300e94d451509c
error Bad {
  reason: string
}

schema Point {
  x: number
}

data Shape {
  Circle
  Square
}

module tools {
  export const n = 1
}

import { n } from tools

// expect-result: {"bad":"Bad","shape":"Circle","n":1}
export effect function main() {
  const bad = new Bad({ reason: "r" })
  return { bad: bad._tag, shape: Shape.Circle()._tag, n }
}
