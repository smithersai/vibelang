// expect-result: 7
import { Effect, Fiber } from "effect"
type Empty = never
type Unchecked = any

export function native0(input: any) {
  return Effect.gen(function*() { return yield* Fiber.join(input) })
}
export effect function actual0(input: any) {
  return join (input satisfies Fiber.Fiber<any, any>)
}
const forward0: typeof native0 = actual0
const backward0: typeof actual0 = native0
void forward0; void backward0

