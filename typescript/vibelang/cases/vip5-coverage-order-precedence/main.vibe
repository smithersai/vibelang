// rule-evidence: docs/design/vips/0005-try-runs-effects.md#cbf0664ecf3afd14
// VIP-5: The await analogy governs source placement, precedence and evaluation order.
import { Effect } from "effect"
export effect function main(): Effect.Effect<readonly unknown[]> {
  const events: string[] = []
  function mark(name: string, n: number) { events.push(name); return n }
  function head(n: number) { events.push("head" + n); return Effect.sync(() => { events.push("run" + n); return n }) }
  function args(a: number,b: number,c: number) { return [a,b,c] }
  const sum = mark("left",1) + try head(2) * mark("right",3)
  const values = args(mark("arg-left",1), try head(6), mark("arg-right",7))
  const selected = true ? try head(4) : try head(5)
  const member = try ({ program: Effect.succeed(8) }).program
  return [sum,values,selected,member,events]
}
