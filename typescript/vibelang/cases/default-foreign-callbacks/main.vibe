// expect:
import {capturedIntersection,intersectionFx,safe,fx,source,admit,fxOwner,constrained,type API,type Handler,type Admitting} from "./helpers.js"
import * as Effect from "effect/Effect"
function local(){return 1}
const captured=fxOwner.method
export const pure:Handler=local
export const safeValue:Handler=safe
export const fxValue:Handler=fx
export const capturedValue:Handler=captured
export const constrainedValue:Handler=constrained
export const open:Admitting=source
export function allowed(){admit(source);return Effect.try(source)}
export function computed(){return Effect.try({["try"]:source,catch:()=>0})}
export class Pure implements API {run=local}
export class Safe implements API {run=safe}
export class Fx implements API {run=fx}
export class Captured implements API {run=captured}
export class Constrained implements API {run=constrained}
export const intersectionValue:Handler=intersectionFx.method
export class IntersectionFx implements API {run=intersectionFx.method}
export const boundedValue:Handler=fxOwner.bounded
export const boundedChain:Handler=fxOwner.chain
export const boundedIntersection:Handler=capturedIntersection.bounded
export class Bounded implements API {run=fxOwner.bounded}
export class BoundedChain implements API {run=fxOwner.chain}
export class BoundedIntersection implements API {run=capturedIntersection.bounded}
