// expect-result: "n=7"
// The forms a workflow body admits (VIP-55): durable steps, try.all over
// them, pure code over results and branches on them, run on Experimental.Durable.
const limit = 3
const label = (n: number) => `n=${n}`

task Fetch {
  static readonly retryPolicy = { initialMs: 10, factor: 2, maxMs: 40, maxAttempts: 3 }
  effect call(id: string): number!string { return id.length }
}

export workflow Child {
  effect call(id: string): number!string { return try Fetch(`${id}!`) }
}

export workflow Plan {
  static readonly maxRounds = 5
  effect call(id: string, attempt: number): string!string {
    const n = try Fetch(id)
    const [a, b] = try.all [Fetch(id), Child(id)]
    if (n + a + b > 100 && attempt < 2) return label(attempt)
    return label(n + a + b - limit)
  }
}

export effect function main() {
  provide Layer.provideMerge(Plan.layer, Experimental.Durable.memory) {
    return try Plan("abc", 0)
  }
}
