import { defaultFailure } from "./foreign.js"
export { walk, even, odd, expand, bounded, invoke, defaulted } from "./foreign.js"
export function fib(n: number): number { return n < 2 ? n : fib(n-1) + fib(n-2) }
export async function asyncDefaulted(f?: () => number): Promise<number> { return f === undefined ? defaultFailure() : f() }
