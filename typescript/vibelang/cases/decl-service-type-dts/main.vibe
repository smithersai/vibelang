// The declaration file of service Name: Type (D281) declares a class whose
// static side is a Context key for the written shape, so TypeScript code
// yields it and provides it as it does a Context.Service class.
// consumer/main.ts does both; run.mjs compiles and runs it.
export interface SearchApi {
  find(query: string): string!!
}

export service Search: SearchApi {
  static readonly layer = Layer.succeed(Search, {
    find: effect (query: string) => `hit:${query}`
  })
}

export service Prefix: string

export service Version: number {
  static readonly defaultValue: () => number = () => 4
}

export effect function greet(query: string) {
  return `${try Prefix()}${try Search.find(query)} v${try Version()}`
}
