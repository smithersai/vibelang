// expect-result: [2,1,3,4,5]
service Counter {
  static readonly key = "provider-precedence/Counter"
  value: number
}
const one = { value: 1 }
const two = Layer.succeed(Counter, { value: 2 })
export effect function main() {
  const result: number[] = []
  provide Counter = one, two { result.push((try Counter).value) }
  provide two, Counter = one { result.push((try Counter).value) }
  provide Counter = one, Counter = { value: 3 } { result.push((try Counter).value) }
  provide two, Layer.succeed(Counter, { value: 4 }) { result.push((try Counter).value) }
  provide two {
    provide Counter = { value: 5 } { result.push((try Counter).value) }
  }
  return result
}
