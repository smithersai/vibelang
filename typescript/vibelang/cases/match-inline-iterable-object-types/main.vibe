type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
const same = <A, B>(_: Equal<A, B>) => undefined
function checks(s: Iterable<Item>) {
 return [s is [{ value: 0 }], s is not [{ value: 0 }], match(s) { when ([] or [{ value: 0 }]): true; default: false; }]
}
