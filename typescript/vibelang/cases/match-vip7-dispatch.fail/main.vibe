// expect: EK0704
class Point { constructor(readonly x: number, readonly y: number) {} }
class Custom { static [customMatcher](s: unknown) { return true } }
class Inherited extends Custom {}
export function empty(s: unknown) { return match (s) { when Point(): 0; default: 1; } }
export function fields(s: unknown) { return match (s) { when Point(let x, let y): 0; default: 1; } }
export function inherited(s: unknown) { return match (s) { when Inherited(let x): 0; default: 1; } }
