// expect-result: [[7,7],[1,2]]
// A parameter spelled like a plain function's variant does not capture the
// call of the function, and a function spelled like another's variant is a
// function of its own.
type Getter = () => number

function original() { return 7 }
function plain(f: Getter) { return try original() }
function shadowed(original$direct: Getter) { return try original() }

function ordinary() { return 1 }
function ordinary$direct() { return 2 }

export function main() {
  return [[try plain(() => 99), try shadowed(() => 99)], [try ordinary(), try ordinary$direct()]]
}
