// expect-result: [1,"two",0,3,-1,5,6]
// Chapter 004: a match arm is its own lexical scope, so an is in an arm's
// value or in its guard binds there, in an expression match and in a match
// statement; a class field or static field initializer is a separate
// method-like body, so an is in it binds there (decided detail 240).
export function arms(x: unknown, y: unknown) {
  return match (x) {
    when 1: (y is { n: let n }) ? n : 0;
    when "two" and if (y is { s: let s } && s === "two"): s;
    default: (y is { let n }) ? n : 0;
  }
}
export function statementArm(x: unknown) {
  let seen: unknown = 0
  match (x) {
    when { let v }: seen = (v is let w) ? w : 0;
    default: seen = -1;
  }
  return seen
}
export class Box {
  static base = ({ n: 5 } is { n: let n }) ? n : 0
  first = ([6, 7] is [let first, ...]) ? first : 0
}
export effect function main() {
  return [arms(1, { n: 1 }), arms("two", { s: "two" }), arms(1, {}), statementArm({ v: 3 }), statementArm(0), Box.base, new Box().first]
}
