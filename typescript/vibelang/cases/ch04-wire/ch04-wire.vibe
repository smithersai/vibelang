// Chapter 4 "Composing an application" with the proposed `wire` built-in (O6). Optional: this file
// is separate from ch04-services.vibe so a compiler without `wire` can skip it.
// Wire's compile-time errors are in ref2-missing-provider, ref2-ambiguous-provider, ref2-cycle (.fail.vibe).

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}
class MailError extends TaggedError("MailError")<{ readonly reason: string }> {}
class DbError extends TaggedError("DbError")<{ readonly reason: string }> {}
class ConnectError extends TaggedError("ConnectError")<{ readonly url: string }> {}
class ConfigError extends TaggedError("ConfigError")<{ readonly key: string }> {}

interface User {
  id: string
  name: string
  email: string
}

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

abstract class Mailer {
  abstract send(to: string, body: string): Effect<void, MailError, never>
}

abstract class Database {
  abstract query(sql: string, params: ReadonlyArray<string>): Effect<ReadonlyArray<User>, DbError, never>
}

abstract class Config {
  abstract readonly url: string
}

const events: string[] = []
const outbox: string[] = []
const env = new Map<string, string>([["DATABASE_URL", "postgres://wired"]])
const rows: ReadonlyArray<User> = [{ id: "1", name: "Ada", email: "ada@example.com" }]

effect function welcome(id: string) {
  const user = try Users.find(id)
  try Mailer.send(user.email, `Welcome, ${user.name}!`)
  return user.name
}
// Effect<string, UserNotFound | MailError, Users | Mailer>

effect function readEnv(key: string) {
  const value = env.get(key)
  if (value === undefined) throw new ConfigError({ key })
  return value
}

const ConfigLive = Layer.effect(Config, effect {
  const url = try readEnv("DATABASE_URL")
  return { url }
})

const DatabaseLive = Layer.effect(Database, effect {
  const url = (try Config()).url
  if (url.length === 0) throw new ConnectError({ url })
  try Effect.acquireRelease(
    effect {
      events.push(`open ${url}`)
    },
    effect () => {
      events.push(`close ${url}`)
    }
  )
  return {
    query: effect (sql, params) => rows.filter((row) => row.id === params[0])
  }
})

const UsersLive = Layer.effect(Users, effect {
  const db = try Database()
  return {
    effect find(id) {
      const found = try Effect.orDie(effect { return try db.query("select * from users where id = $1", [id]) })
      if (found.length === 0) throw new UserNotFound({ id })
      return found[0]
    }
  }
})

const MailerLive = Layer.succeed(Mailer, {
  send: effect (to, body) => {
    outbox.push(`${to}: ${body}`)
  }
})

const UsersTest = Layer.succeed(Users, {
  find: effect (id) => ({ id, name: "Grace", email: "grace@example.com" })
})

const AppLive = wire(UsersLive, MailerLive, DatabaseLive, ConfigLive)
// Layer<Users | Mailer | Database | Config, ConfigError | ConnectError, never>

// expect-result: {"live":"Ada","test":"Grace","events":["open postgres://wired","close postgres://wired"],"outbox":["ada@example.com: Welcome, Ada!","grace@example.com: Welcome, Grace!"]}
export effect function main() {
  const live = try Effect.provide(effect { return try welcome("1") }, AppLive)
  const test = try Effect.provide(effect { return try welcome("1") }, wire(UsersTest, MailerLive))
  return { live, test, events, outbox }
}
