// In a CommonJS package, the names a file takes from the prelude without a
// namespace, such as TaggedError (an error declaration's base), the bare
// Effect function sleep, and pipe and flow, are bound by a destructuring
// require: TypeScript's CommonJS transform does not rewrite the names the
// lowering imports, and they were unbound (ReferenceError: TaggedError is not
// defined). The starter's sources, in a package without "type": "module".
import { EmptyName, greeting } from "./greeting.vibe"

error Late { ms: number }

service Greeter {
  greet(name: string): string!EmptyName
}

const GreeterLive = Layer.succeed(Greeter, {
  greet(name: string) { return try greeting(name) }
})

export function main() {
  provide GreeterLive {
    try Console.log(try Greeter.greet("VibeLang"))
    try {
      try Greeter.greet("")
    } catch (error) {
      try Console.log(`Recovered from ${error._tag}`)
    }
  }
  try sleep("1 millis")
  const double = flow((n: number) => n + 1, (n: number) => n * 2)
  try Console.log(pipe(1, double), new Late({ ms: 5 })._tag)
}
