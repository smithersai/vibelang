import { Effect } from "effect"
import { h, type VNode } from "./jsx.js"
declare global {
 namespace JSX {
  type Element = VNode
  interface IntrinsicElements { task: {task?: Effect.Effect<number>; run?: unknown; onClick?: () => void}; [tag: string]: Record<string, unknown> }
 }
}
error Missing { id: string }
type User = { id: string }
function Task<T>(props: { run: T }): VNode { return <task run={props.run}/> }
const lift = effect <T extends User!Missing>(v: T) => v
export const identity = effect <T,>(x: T) => x
export effect function main(): Effect.Effect<Array<VNode>> {
 let calls = 0
 const work = effect { calls++; return 7 }
 const cold = <task task={work} onClick={effect () => { calls++; return 9 }}/>
 const before = <count>{calls}</count>
 const n = try identity(try work)
 const view = n |> <box f={() => %}>{%}{n % 2}</box>
 const value = match (n) { when 0: <small/>; default: <big/>; }
 const child = <root>{try Effect.succeed(2)}{do { 3 }}{match (n) { when 7: <seven/>; default: <other/>; }}</root>
 const nested = <box task={effect { return 1 }} value={{ effect: 1 }} />
 const typed = <Task<User!Missing> run={Effect.succeed({ id: "u" })} />
 const slots = <Task<User!!> run={Effect.succeed({ id: "v" })} />
 const props = do { const p: number!!=Effect.succeed(4); ({ p }); }
 const spread = <box {...props} />
 class C { effect render() { return <b/> } }
 const obj = { effect m<T>(x: T) { return x } }
 const rendered = try new C().render()
 const fromMethod = try obj.m(5)
 const recovered = Effect.fail("missing") catch <E,>(e: E) => 11
 return [cold, before, view, value, child, nested, typed, slots, spread, rendered, <count>{fromMethod}{recovered}{calls}</count>]
}
