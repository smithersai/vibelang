// Calling an effect function builds its Effect and runs nothing (VIP-1), so
// fork(fetchReport()) and Effect.retry(fetchReport()) pass a program with no
// by-name rule. A plain function's call evaluates where it stands, so a runner
// gets it through Effect.sync (VIP-6).
class Unavailable extends TaggedError("Unavailable")<{ readonly attempt: number }> {}

let attempts = 0
let fastRuns = 0

effect function fetchReport() {
  attempts++
  if (attempts < 3) throw new Unavailable({ attempt: attempts })
  return `report after ${attempts} attempts`
}

effect function slow() {
  try Effect.sleep("1 second")
  return "slow"
}

effect function fast() {
  fastRuns++
  try Effect.sleep("5 millis")
  return "fast"
}

effect function deadline() {
  try {
    return try Effect.timeout(slow(), "20 millis")
  } catch (error) {
    return error._tag
  }
}

function subtotal() {
  return 7 * 8
}

// subtotal() runs inside the program that runSync starts.
const total = Effect.runSync(Effect.sync(() => subtotal()))

// expect-result: {"report":"report after 3 attempts","winner":"fast","timed":"TimeoutError","joined":"fast","both":["fast","fast"],"logged":true,"attempts":3,"fastRuns":5,"total":56}
export effect function main() {
  const report = try Effect.retry(fetchReport(), { times: 5 })
  const winner = try Effect.race(fast(), slow())
  const timed = try deadline()
  const fiber = fork(fast())
  const joined = try Fiber.join(fiber)
  const both = try Effect.all([fast(), fast()])
  try Console.log(try fast())
  return { report, winner, timed, joined, both, logged: true, attempts, fastRuns, total }
}
