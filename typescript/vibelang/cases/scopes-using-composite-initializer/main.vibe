// using runs its whole initializer with the block's Scope, where the
// declaration stands (D401, D490), whatever form the initializer takes: a
// conditional ("conditional"), a comma expression ("comma"), a call whose
// argument runs an acquisition ("argument"), a plain call around one
// ("plain"), a method that reads this ("method"), a for head ("forHead"),
// and a generic callback ("generic"). Each acquisition in it registers its
// release in the block's Scope and records it there, so using adds no second
// release, the release runs when the block exits, and Scope leaves the
// function's R: each work function below is void!!, so it needs no Scope,
// and conditionalGeneric's R is Exclude<R, Scope>.
// The initializer evaluates its operands once, in source order ("order").
// expect-result: {"conditional":["body","disposed","after work"],"comma":["body","disposed","released","after work"],"argument":["body","disposed","after work"],"plain":["body","disposed","after work"],"method":["body","disposed","after work"],"forHead":["body","disposed","after work"],"generic":["disposed","after work"],"order":["a","acquired","b","body","disposed","after work"]}
import { conditionalGeneric } from "./generic.vibe"

/** Fails to compile unless T is never. */
type Never<T extends never> = T

type Left = Never<Effect.Services<ReturnType<typeof conditionalGeneric<Resource, Scope>>>>

export function main() {
  const left: Left[] = []
  const result = {
    conditional: try run((events) => conditional(events, true)),
    comma: try run((events) => comma(events)),
    argument: try run((events) => argument(events)),
    plain: try run((events) => plain(events)),
    method: try run((events) => new Holder(events, true).hold()),
    forHead: try run((events) => forHead(events)),
    generic: try run((events) => { try conditionalGeneric(() => acquire(events), true) }),
    order: try run((events) => order(events))
  }
  return [result, ...left][0]
}

// Runs work in a Scope of the caller's, which would also own an acquisition
// that ran outside the block's Scope, and returns what it recorded.
function run(work: (events: string[]) => void!!) {
  const events: string[] = []
  try Effect.scoped(() => {
    try work(events)
    events.push("after work")
  })
  return events
}

type Resource = { [Symbol.dispose](): void }

function handle(events: string[]): Resource {
  return { [Symbol.dispose](): void { events.push("disposed") } }
}

// Its release disposes the value it recorded.
function acquire(events: string[]) {
  return try Effect.acquireRelease(() => handle(events), (r) => { r[Symbol.dispose]() })
}

function keep<A>(value: A) {
  try yieldNow()
  return value
}

function same<A>(value: A): A {
  return value
}

function conditional(events: string[], flag: boolean): void!! {
  using r = flag ? try acquire(events) : try acquire(events)
  events.push("body")
}

function comma(events: string[]): void!! {
  using h = (try Effect.acquireRelease(() => "lease", () => { events.push("released") }), handle(events))
  events.push("body")
}

function argument(events: string[]): void!! {
  using r = try keep(try acquire(events))
  events.push("body")
}

function plain(events: string[]): void!! {
  using r = same(try acquire(events))
  events.push("body")
}

class Holder {
  events: string[]
  flag: boolean
  constructor(events: string[], flag: boolean) {
    this.events = events
    this.flag = flag
  }
  hold(): void!! {
    using r = this.flag ? try acquire(this.events) : try acquire(this.events)
    this.events.push("body")
  }
}

function forHead(events: string[]): void!! {
  for (using r = try keep(try acquire(events)); ; ) {
    events.push("body")
    break
  }
}

function step<A>(events: string[], name: string, value: A) {
  try yieldNow()
  events.push(name)
  return value
}

function pick<A>(first: unknown, value: A, last: unknown) {
  try yieldNow()
  return value
}

function order(events: string[]): void!! {
  using r = try pick(try step(events, "a", 1), try Effect.acquireRelease(() => {
    events.push("acquired")
    return handle(events)
  }, (h) => { h[Symbol.dispose]() }), try step(events, "b", 2))
  events.push("body")
}
