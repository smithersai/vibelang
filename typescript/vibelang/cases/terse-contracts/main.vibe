// expect-result: {"full":"Ada","noDependencies":1,"inferred":"Ada","neither":3,"onlyDependencies":2,"arrow":2,"find":"none","either":4,"unwrap":5}
// D309: the ! form of an Effect type is an alias of Effect<A, E, R> again.
// Each form here was EK1014 under D308 (0.0.8 and 0.0.9) and compiles and
// runs again: an empty slot is never, and dependencies left out are inferred
// on a function with a body and never elsewhere. effect-type-spellings is the
// same program in the Effect<...> spelling that 0.0.8's --fix wrote.
error NotFound { id: string }
error Timeout

service Users {
  find(id: string): string!NotFound
  count(): number!!
}

const UsersLive = Layer.succeed(Users, {
  effect find(id: string) {
    if (id !== "42") throw new NotFound({ id })
    return "Ada"
  },
  effect count() {
    return 2
  }
})

effect function full(id: string): string!NotFound!Users {
  return try Users.find(id)
}

effect function noDependencies(n: number): number!Timeout! {
  if (n < 0) throw new Timeout()
  return n
}

effect function inferred(id: string): string!NotFound {
  return try Users.find(id)
}

effect function neither(): number!! {
  return 3
}

effect function onlyDependencies(): number!!Users {
  return try Users.count()
}

const arrow = effect (n: number): number!Timeout => try noDependencies(n) + 1

type Finder = (id: string) => string!NotFound
type Maybe = (number!!) | undefined
type Nested = (number!!)!NotFound!

effect function find(finder: Finder, id: string): string!! {
  return finder(id) catch "none"
}

effect function either(program: Maybe): number!! {
  return program === undefined ? 0 : try program()
}

const five: Effect<number> = Effect.sync(() => 5)

effect function unwrap(program: Nested): number!NotFound! {
  const inner = try program()
  return try inner()
}

export effect function main() {
  provide UsersLive {
    return {
      full: try full("42"),
      noDependencies: try noDependencies(1),
      inferred: try inferred("42"),
      neither: try neither(),
      onlyDependencies: try onlyDependencies(),
      arrow: try arrow(1),
      find: try find(effect (id) => { if (id === "7") throw new NotFound({ id }); return id }, "7"),
      either: try either(Effect.succeed(4)),
      unwrap: try unwrap(Effect.succeed(five))
    }
  }
}
