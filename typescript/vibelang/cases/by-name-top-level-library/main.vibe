// A skipped generic call in runner inference must stay an Effect value.
effect function work() {
  try Console.log("ran")
  return 42
}

const running: Fiber.Fiber<number> = Effect.runFork(Effect.provide(work(), Logger.layer([])))
const total: number = Effect.runSync(Effect.provide(Effect.succeed(7), Logger.layer([])))
const pending: Promise<{ left: number; right: number }> = Effect.runPromise(Effect.all({
  left: Effect.succeed(1),
  right: Effect.succeed(2)
}))

Effect.runPromise {
  try Console.log(typeof try Fiber.join(running))
  try Console.log(total)
  try Console.log(JSON.stringify(try sync((value: Promise<{ left: number; right: number }>) => value, pending)))
}
