// expect: EK4201
// for concurrent runs each item in its own fiber (D169), which cannot reach a
// handler on this one (chapter 9, "Handlers and concurrency"). With a limit
// of 1 the items run one at a time on this fiber, and the handler is reached.
control Ask { ask(): number!! }

export effect function limited() {
  let total = 0
  try {
    for concurrent(2) (const n of [1, 2]) total += try Ask.ask()
  } handle Ask.ask() {
    try resume(1)
  }
  return total
}

export effect function unlimited() {
  let total = 0
  try {
    for concurrent (const n of [1, 2]) {
      total += try Ask.ask()
    }
  } handle Ask.ask() {
    try resume(1)
  }
  return total
}

export effect function one() {
  let total = 0
  try {
    for concurrent(1) (const n of [1, 2]) total += try Ask.ask()
  } handle Ask.ask() {
    try resume(1)
  }
  return total
}
