// expect: EK4301
// A function value whose return type is an Effect gives its Effect unrun
// (VIP-1), so a callback position that drops what it returns rejects it, as
// it rejects an Effect function. A position that keeps the result, such as
// map's, collects the programs as data. Before VIP-1 map rejected it too
// (D511).
import { passThrough } from "./helpers.ts"

function pick(p: number!!): infer _ {
  return p
}

export function fromSource(xs: Array<number!!>) {
  xs.forEach(pick)
  return xs.map(pick)
}

export function fromTypeScript(xs: Array<number!!>) {
  xs.forEach(passThrough)
  return xs.map(passThrough)
}

// A literal collects the programs as data.
export function asData(xs: Array<number!!>) {
  return xs.map((p): infer _ => p)
}
