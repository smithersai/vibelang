// expect:
// An Effect-returning factory is an ordinary value (VIP-1/detail303).
// A void callback destination accepts it under native TypeScript rules
// and ignores its returned program; map instead keeps those programs.
// Neither call changes its kind, runs its Effect, or rewrites the factory.
// Imported and local factories follow the same native assignment rules.
import { passThrough } from "./helpers.ts"

function pick(p: number!!): infer _ {
  return p
}

export function fromSource(xs: Array<number!!>) {
  xs.forEach(pick)
  return xs.map(pick)
}

export function fromTypeScript(xs: Array<number!!>) {
  xs.forEach(passThrough)
  return xs.map(passThrough)
}

// A literal collects the programs as data.
export function asData(xs: Array<number!!>) {
  return xs.map((p): infer _ => p)
}
