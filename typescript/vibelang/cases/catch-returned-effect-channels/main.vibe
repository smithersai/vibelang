// expect-result: ["outer",5,["make"],["make","inner"]]
import {Effect,Exit,Cause} from "effect"
function make(bad:boolean,events:string[]):Effect.Effect<Effect.Effect<number,"inner">,"outer"> {
 events.push("make")
 return bad ? Effect.fail("outer" as const) : Effect.succeed(Effect.fail("inner" as const))
}
effect function narrow(bad:boolean,events:string[]):number!"outer" {
 return (try make(bad,events)) catch e => {
  const typed:"inner"=e
  events.push(typed)
  return e.length
 }
}
export effect function main():unknown!! {
 const a:string[]=[],b:string[]=[]
 const first=try Effect.exit(narrow(true,a)),second=try Effect.exit(narrow(false,b))
 return [Exit.isFailure(first)?Cause.squash(first.cause):"wrong",Exit.isSuccess(second)?second.value:-1,a,b]
}
