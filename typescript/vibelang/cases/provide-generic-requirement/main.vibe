// A provide block over a program whose requirement is a type parameter R
// needs Exclude<R, Prefix>, as Effect.provideService gives it: a caller whose
// program needs only Prefix needs nothing. The block needed R itself.
service Prefix: string

export const withPrefix = effect <A, E, R>(body: A!E!R) => {
  provide Prefix = "> " {
    return try body()
  }
}

const greet = effect (name: string) => `${try Prefix()}${name}`

/** Fails to compile unless T is never. */
type Never<T extends never> = T

type Left = Never<Effect.Services<ReturnType<typeof withPrefix<string, never, Prefix>>>>

export const greeting = effect (): string!! => try withPrefix(greet("vibe"))

// expect-result: "> vibe"
export effect function main() {
  const left: Left[] = []
  return [try greeting(), ...left][0]
}
