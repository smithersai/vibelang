// expect: EK0401
// A generator with a JavaScript iterator annotation is plain synchronous code,
// so a throw in it is EK0401, caught by its own catch or not (Will,
// 2026-10-31). An async generator's throw rejects, as in TypeScript (detail
// 251).
error Invalid { value: string }

export function* steps(value: string): Generator<string> {
  if (value === "") throw new Invalid({ value })
  yield value
}

export async function* later(value: string): AsyncGenerator<string> {
  yield value
  throw new Invalid({ value })
}

export function* kept(): Iterator<string> {
  try {
    throw new Invalid({ value: "x" })
  } catch (e) {
    yield e.value
  }
}
