// expect: EK9202 TS2322
// A service's identifier is nominal (D361, D501): only a type that carries
// A's key, as Effect's Context.Service class declares it, is A. Widening A's requirement to a structural type with A's members
// is allowed, but that type is not B either, so providing B leaves it in R
// and assigning it to a requirement of B is TS2322. Each program used to
// compile, and the first two died with "Service not found: …#A".
service A { value: number }
service B { value: number }
type Shape = { value: number }

effect function needsA(): number!!A { return (try A()).value }

export effect function viaProvideService(): number!! {
  const p: Effect<number, never, Shape> = needsA()
  return try Effect.provideService(p, B, { value: 2 })
}

export effect function viaProvideBlock(): number!! {
  const p: Effect<number, never, Shape> = needsA()
  provide B = { value: 2 } {
    return try p()
  }
}

export function viaAssignment(): Effect<number, never, B> {
  const p: Effect<number, never, Shape> = needsA()
  const claimed: Effect<number, never, B> = p
  return claimed
}
