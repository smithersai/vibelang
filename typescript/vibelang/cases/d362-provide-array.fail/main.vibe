// expect: EK3207
service Count { value: number }

export function arrayProvider() {
  const providers: Layer.Layer<Count>[] = []
  provide providers { return (try Count()).value }
}

export function readonlyArrayProvider(providers: ReadonlyArray<Layer.Layer<Count>>) {
  provide providers { return (try Count()).value }
}

export function emptyList() {
  provide [] { return 0 }
}

export function spreadOnly(providers: Layer.Layer<Count>[]) {
  provide [...providers] { return (try Count()).value }
}

export function optionalOnly(providers: [Layer.Layer<Count>?]) {
  provide providers { return (try Count()).value }
}

export function contextList() {
  provide [Context.make(Count, { value: 1 })] { return (try Count()).value }
}

export function nestedList() {
  provide [[Layer.succeed(Count, { value: 1 })]] { return (try Count()).value }
}
