// expect: EK3207
service Count { value: number }

export effect function arrayProvider() {
  const providers: Layer.Layer<Count>[] = []
  provide providers { return (try Count()).value }
}

export effect function readonlyArrayProvider(providers: ReadonlyArray<Layer.Layer<Count>>) {
  provide providers { return (try Count()).value }
}

export effect function emptyList() {
  provide [] { return 0 }
}

export effect function spreadOnly(providers: Layer.Layer<Count>[]) {
  provide [...providers] { return (try Count()).value }
}

export effect function optionalOnly(providers: [Layer.Layer<Count>?]) {
  provide providers { return (try Count()).value }
}

export effect function contextList() {
  provide [Context.make(Count, { value: 1 })] { return (try Count()).value }
}

export effect function nestedList() {
  provide [[Layer.succeed(Count, { value: 1 })]] { return (try Count()).value }
}
