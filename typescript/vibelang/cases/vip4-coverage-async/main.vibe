// VIP-5: await fiber in async code has TypeScript's behavior, plus a
// rule-evidence: docs/design/vips/0005-try-runs-effects.md#32e337fdb6d046bf
// VIP-5: await deferred has TypeScript's behavior, plus a VIP-38 lint warning
import { Effect, Exit, Fiber, Deferred } from "effect"
async function rejects() { throw "async" }
const arrow = async () => { throw "arrow" }
class Worker { async method() { throw "method" } }
async function nested() { return Promise.resolve(7) }
async function observeFiber(f: Fiber.Fiber<number>) { return await f }
async function observeDeferred(d: Deferred.Deferred<number>) { return await d }
async function joinFiber(f: Fiber.Fiber<number>) { return await Effect.runPromise(Fiber.join(f)) }
async function waitDeferred(d: Deferred.Deferred<number>) { return await Effect.runPromise(Deferred.await(d)) }
export effect function main(): Effect.Effect<readonly unknown[],unknown> {
  const a = try Effect.exit(Effect.tryPromise({ try: rejects, catch: (e) => e }))
  const b = try Effect.exit(Effect.tryPromise({ try: arrow, catch: (e) => e }))
  const c = try Effect.exit(Effect.tryPromise({ try: () => new Worker().method(), catch: (e) => e }))
  const value = try Effect.tryPromise(nested)
  const fiber = try Effect.forkChild(Effect.succeed(8))
  const deferred = try Deferred.make<number>()
  try Deferred.succeed(deferred, 9)
  const fiberData = try Effect.tryPromise(() => observeFiber(fiber))
  const deferredData = try Effect.tryPromise(() => observeDeferred(deferred))
  const joined = try Effect.tryPromise(() => joinFiber(fiber))
  const waited = try Effect.tryPromise(() => waitDeferred(deferred))
  const failure = (x: Exit.Exit<unknown,unknown>) => Exit.isFailure(x) && x.cause.reasons[0]?._tag === "Fail" ? x.cause.reasons[0].error : null
  return [failure(a),failure(b),failure(c),value,fiberData === fiber,deferredData === deferred,joined,waited]
}
