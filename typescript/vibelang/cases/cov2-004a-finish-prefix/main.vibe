import { Effect } from "effect"
import { iterator } from "./native.js"
function probe(): unknown {
  const log: string[] = []
  let error: unknown
  try { match (iterator(log)) { when [0]: 0; default: 1; } } catch (e) { error = e }
  return [String(error), log]
}
export function main(): Effect.Effect<unknown> { return Effect.sync(probe) }
