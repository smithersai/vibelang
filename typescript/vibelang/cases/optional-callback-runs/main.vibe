// expect-result: ["custom 2","custom 2","default",true,20,"caught thrown",true,"ran 2","default",-1]
// An optional call preserves TypeScript evaluation. Explicitly guard its
// result before running the Effect; the callback type declares its channels.
error Late { label: string }

const coalesced = effect <E = never, R = never>(label?: (seconds: number) => Late!E!R) => {
  return try runOptional(label?.(2)) ?? new Late({ label: "default" })
}

const bound = effect <E = never, R = never>(label?: (seconds: number) => Late!E!R) => {
  const value = try runOptional(label?.(2))
  return value
}

const scaled = effect <E = never, R = never>(scale?: (n: number) => number!E!R) => try runOptional(scale?.(2))

const announced = effect <E = never, R = never>(log?: (n: number) => void!E!R) => {
  try runOptional(log?.(2))
  return true
}

// An omitted callback adds no failure and needs nothing: E and R default to never.
effect function defaulted(): Late!! {
  return try coalesced()
}

effect function unscaled(): number!! {
  return try scaled() ?? -1
}

export effect function main() {
  const ran: Array<string> = []
  const a = try coalesced(effect (s) => new Late({ label: "custom " + s }))
  const b = try bound(effect (s) => new Late({ label: "custom " + s }))
  const c = try coalesced()
  const d = try bound()
  const n = try scaled(effect (n) => {
    try sleep("1 millis")
    return n * 10
  })
  const caught = coalesced(effect (s) => {
    throw new Late({ label: "thrown" })
  }) catch (e) => new Late({ label: "caught " + e.label })
  const announcedOk = try announced(effect (n) => {
    ran.push("ran " + n)
  })
  return [a.label, b?.label, c.label, d === undefined, n, caught.label, announcedOk, ran[0], (try defaulted()).label, try unscaled()]
}

// VIP-5 / 002-running: try requires an Effect, not Effect | undefined.
// Preserve optional receiver/call/argument evaluation, then guard the result.
effect function runOptional<A, E, R>(program: (A!E!R) | undefined): (A | undefined)!E!R {
  return program === undefined ? undefined : try program
}
