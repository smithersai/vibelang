// expect-result: ["custom 2","custom 2","default",true,20,"caught thrown",true,"ran 2","default",-1]
// An optional call of an Effect callback runs the callback when it is
// present, as a required call does; the callback's type declares its
// channels (D500).
error Late { label: string }

const coalesced = <E = never, R = never>(label?: (seconds: number) => Late!E!R) => {
  return try label?.(2) ?? new Late({ label: "default" })
}

const bound = <E = never, R = never>(label?: (seconds: number) => Late!E!R) => {
  const value = try label?.(2)
  return value
}

const scaled = <E = never, R = never>(scale?: (n: number) => number!E!R) => scale?.(2)

const announced = <E = never, R = never>(log?: (n: number) => void!E!R) => {
  try log?.(2)
  return true
}

// An omitted callback adds no failure and needs nothing: E and R default to never.
function defaulted(): Late!! {
  return try coalesced()
}

function unscaled(): number!! {
  return try scaled() ?? -1
}

export function main() {
  const ran: Array<string> = []
  const a = try coalesced((s) => new Late({ label: "custom " + s }))
  const b = try bound((s) => new Late({ label: "custom " + s }))
  const c = try coalesced()
  const d = try bound()
  const n = try scaled((n) => {
    try sleep("1 millis")
    return n * 10
  })
  const caught = coalesced((s) => {
    throw new Late({ label: "thrown" })
  }) catch (e) => new Late({ label: "caught " + e.label })
  const announcedOk = try announced((n) => {
    ran.push("ran " + n)
  })
  return [a.label, b?.label, c.label, d === undefined, n, caught.label, announcedOk, ran[0], (try defaulted()).label, try unscaled()]
}
