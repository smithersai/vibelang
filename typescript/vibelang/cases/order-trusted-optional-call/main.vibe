// expect-result: {"method":[null,["getter"]],"receiver":[null,[]],"present":[7,["argument"]]}
// An optional call skips its arguments when its function or its receiver is
// absent (chapter 13), also when the function has expected failures and an
// argument runs an Effect, which the call's thunk cannot hold.
effect function method() {
  const trace: string[] = []
  const codec = {
    get parse(): typeof JSON.parse | undefined {
      trace.push("getter")
      return undefined
    }
  }
  effect function input() {
    trace.push("argument")
    try Effect.yieldNow
    return "7"
  }
  const callReceiver = codec
  const callTarget = callReceiver.parse
  let value: ReturnType<typeof JSON.parse> = undefined
  if (callTarget != null) {
    const callArgument = try input()
    value = try ((failureClass: typeof SyntaxError) => Effect.catch(Effect.try({ try: () => Reflect.apply(callTarget, callReceiver, [callArgument]), catch: (error) => error }), (error) => error instanceof failureClass ? Effect.fail(error) : Effect.die(error)))(SyntaxError)
  }
  return [value ?? null, trace]
}

effect function receiver(codec: { parse: typeof JSON.parse } | undefined) {
  const trace: string[] = []
  effect function input() {
    trace.push("argument")
    try Effect.yieldNow
    return "7"
  }
  const callReceiver = codec
  let value: ReturnType<typeof JSON.parse> = undefined
  if (callReceiver != null) {
    const callTarget = callReceiver.parse
    const callArgument = try input()
    value = try ((failureClass: typeof SyntaxError) => Effect.catch(Effect.try({ try: () => Reflect.apply(callTarget, callReceiver, [callArgument]), catch: (error) => error }), (error) => error instanceof failureClass ? Effect.fail(error) : Effect.die(error)))(SyntaxError)
  }
  return [value ?? null, trace]
}

export effect function main() {
  return { method: try method(), receiver: try receiver(undefined), present: try receiver(JSON) }
}
