// expect: EK1001 EK2001 EK2002 EK2003
const makeRuntime = (n: number): infer _ => {
  const p: Effect.Effect<{ n: number }, never, never> = () => { return { n } }
  return p
}
export const unannotated = makeRuntime(7)
export const plain = (): number => {
  const service = makeRuntime(7)
  return service.n
}

error Unavailable {}
service Needed { value: number }
const makeProgram = (input: Effect.Effect<number, Unavailable, Needed>): infer _ => {
  const p: Effect.Effect<number, Unavailable, Needed> = input
  return p
}
// The returned program's channels must survive the plain factory too.
export function missingChannels(input: Effect.Effect<number, Unavailable, Needed>): number!! {
  return try makeProgram(input)
}
