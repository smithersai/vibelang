// expect-result: {"traced":"Ada","provided":"eu","served":4,"many":"eu 4","logged":"done"}
// Effect.withSpan and Effect.provide have safe EK4836 rewrites.
// Effect.provideService keeps its native call: a Layer changes scope.
// Its warning explains why there is no automatic block rewrite.
// tsforms-blocks-fixed is what vibelang --fix writes.
service Region {
  name(): string!!
}

service Size {
  of(text: string): number!!
}

const RegionLive = Layer.succeed(Region, { name() { return "eu" } })
const SizeLive = Layer.succeed(Size, { of(text) { return text.length } })

function find() {
  return "Ada"
}

function traced() {
  return withSpan(() => find(), "find")
}

function provided() {
  provide RegionLive { return Region.name() }
}

function served() {
  return Effect.provideService(Size.of("abcd"), Size, { of(text: string) { return text.length } })
}

function describe() {
  return `${Region.name()} ${Size.of("four")}`
}

function many() {
  provide RegionLive, SizeLive { return describe() }
}

function logged() {
  provide RegionLive { Region.name() }
  return "done"
}

export function main() {
  return { traced: traced(), provided: provided(), served: served(), many: many(), logged: logged() }
}
