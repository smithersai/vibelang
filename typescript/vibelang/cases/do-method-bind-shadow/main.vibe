// rule-evidence: docs/design/src/002-running.md#do-expressions | Calls retain ECMA-262's `CallExpression` evaluation, `EvaluateCall` and `ArgumentListEvaluation` behavior, including the receiver, callee lookup, abrupt completions and native non-callable errors; generated invocation machinery must add no observable helper lookup.
// expect-result: [7,["argument","call"]]
// VIP-2: compiler invocation machinery performs no observable helper lookup.
export effect function main() {
  const events: string[] = []
  const receiver = {
    n: 3,
    f(x: number): number { events.push("call"); return this.n + x }
  }
  Object.defineProperty(receiver.f, "bind", {
    get(): (self: unknown) => (x: number) => number { events.push("wrong-bind"); return (_self: unknown): ((x: number) => number) => (_x: number): number => 99 }
  })
  const value = receiver.f(do { events.push("argument"); 4 })
  return [value, events]
}
