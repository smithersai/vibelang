// Exercise every exit for array, iterator, producer and Stream using loops.
// Each iteration releases its body resource before its head resource; an
// early exit then closes its iterator/producer. Unvisited values are not owned.
error Bad {}
function disposable(events: string[], name: string) {
  return { [Symbol.dispose](): void { events.push("dispose " + name) } }
}
module iterators {
  export function* elements(events: string[]): Generator<Disposable> {
    try {
      yield { [Symbol.dispose](): void { events.push("dispose x1") } }
      yield { [Symbol.dispose](): void { events.push("dispose x2") } }
    } finally { events.push("source closed") }
  }
}
import { elements } from iterators
function* produce(events: string[]) {
  try {
    yield try disposable(events, "x1")
    yield try disposable(events, "x2")
  } finally { events.push("source closed") }
}

function array(ending: string) {
  const events: string[] = []
  function work() {
    for (using x of [try disposable(events, "x1"), try disposable(events, "x2")]) {
      using local = try disposable(events, "local")
      events.push("body")
      try yieldNow()
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
function arrayInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  function work() {
    for (using x of [try disposable(events, "x1"), try disposable(events, "x2")]) {
      using local = try disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

function iterator(ending: string) {
  const events: string[] = []
  function work() {
    for (using x of try sync((e: string[]) => elements(e), events)) {
      using local = try disposable(events, "local")
      events.push("body")
      try yieldNow()
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
function iteratorInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  function work() {
    for (using x of try sync((e: string[]) => elements(e), events)) {
      using local = try disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

function producer(ending: string) {
  const events: string[] = []
  function work() {
    for (using x of produce(events)) {
      using local = try disposable(events, "local")
      events.push("body")
      try yieldNow()
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
function producerInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  function work() {
    for (using x of produce(events)) {
      using local = try disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

function stream(ending: string) {
  const events: string[] = []
  function work() {
    for (using x of Stream.ensuring(Stream.fromIterable([try disposable(events, "x1"), try disposable(events, "x2")]), () => { events.push("source closed") })) {
      using local = try disposable(events, "local")
      events.push("body")
      try yieldNow()
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
function streamInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  function work() {
    for (using x of Stream.ensuring(Stream.fromIterable([try disposable(events, "x1"), try disposable(events, "x2")]), () => { events.push("source closed") })) {
      using local = try disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

function concurrent(ending: string) {
  const events: string[] = []
  const outcome = try exit(() => {
    for concurrent(1) (const i of [1, 2]) {
      using item = try disposable(events, "x" + i)
      events.push("body")
      try yieldNow()
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "continue") continue
    }
  })
  return [Exit.isFailure(outcome), events]
}
function concurrentInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  function work() {
    for concurrent(1) (const i of [1, 2]) {
      using item = try disposable(events, "x" + i)
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

