// Exercise every exit for array, iterator, producer and Stream using loops.
// A JavaScript exit releases the body resource before the head resource, then
// closes the iterator. A failed, dying or interrupted try abandons the
// generator, so only a producer's own Scope still closes. Unvisited values are
// not owned.
error Bad {}
function disposable(events: string[], name: string) {
  return { [Symbol.dispose](): void { events.push("dispose " + name) } }
}
module iterators {
  export function* elements(events: string[]): Generator<Disposable> {
    try {
      yield { [Symbol.dispose](): void { events.push("dispose x1") } }
      yield { [Symbol.dispose](): void { events.push("dispose x2") } }
    } finally { events.push("source closed") }
  }
}
import { elements } from iterators
effect function* produce(events: string[]) {
  try Effect.acquireRelease(Effect.void, () => Effect.sync(() => { events.push("source closed") }))
  yield disposable(events, "x1")
  yield disposable(events, "x2")
}

effect function array(ending: string) {
  const events: string[] = []
  effect function work() {
    for (using x of [disposable(events, "x1"), disposable(events, "x2")]) {
      using local = disposable(events, "local")
      events.push("body")
      try yieldNow
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
effect function arrayInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  effect function work() {
    for (using x of [disposable(events, "x1"), disposable(events, "x2")]) {
      using local = disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

effect function iterator(ending: string) {
  const events: string[] = []
  effect function work() {
    for (using x of try sync((e: string[]) => elements(e), events)) {
      using local = disposable(events, "local")
      events.push("body")
      try yieldNow
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") return
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
effect function iteratorInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  effect function work() {
    for (using x of try sync((e: string[]) => elements(e), events)) {
      using local = disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

effect function producer(ending: string) {
  const events: string[] = []
  effect function work() {
    for try (const item of produce(events)) {
      using x = item
      using local = disposable(events, "local")
      events.push("body")
      try yieldNow
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") break
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
effect function producerInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  effect function work() {
    for try (const item of produce(events)) {
      using x = item
      using local = disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

effect function stream(ending: string) {
  const events: string[] = []
  effect function work() {
    for try (const item of Stream.ensuring(Stream.fromIterable([disposable(events, "x1"), disposable(events, "x2")]), effect { events.push("source closed") })) {
      using x = item
      using local = disposable(events, "local")
      events.push("body")
      try yieldNow
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "break") break
      if (ending === "return") break
      if (ending === "continue") continue
    }
  }
  const outcome = try exit(work())
  return [Exit.isFailure(outcome), events]
}
effect function streamInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  effect function work() {
    for try (const item of Stream.ensuring(Stream.fromIterable([disposable(events, "x1"), disposable(events, "x2")]), effect { events.push("source closed") })) {
      using x = item
      using local = disposable(events, "local")
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

effect function concurrent(ending: string) {
  const events: string[] = []
  const outcome = try exit(effect {
    for concurrent(1) (const i of [1, 2]) {
      using item = disposable(events, "x" + i)
      events.push("body")
      try yieldNow
      if (ending === "failure") throw new Bad()
      if (ending === "defect") try Effect.die("boom")
      if (ending === "continue") continue
    }
  })
  return [Exit.isFailure(outcome), events]
}
effect function concurrentInterrupted() {
  const events: string[] = []
  const started = try Deferred.make<void>()
  effect function work() {
    for concurrent(1) (const i of [1, 2]) {
      using item = disposable(events, "x" + i)
      events.push("body")
      try Deferred.succeed(started, undefined)
      try sleep("10 seconds")
    }
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(started)
  try Fiber.interrupt(child)
  return events
}

// expect-result: {"arraysuccess":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2"]],"arrayfailure":[true,["body"]],"arraydefect":[true,["body"]],"arraybreak":[false,["body","dispose local","dispose x1"]],"arrayreturn":[false,["body","dispose local","dispose x1"]],"arraycontinue":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2"]],"arrayInterrupted":["body"],"iteratorsuccess":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"iteratorfailure":[true,["body"]],"iteratordefect":[true,["body"]],"iteratorbreak":[false,["body","dispose local","dispose x1","source closed"]],"iteratorreturn":[false,["body","dispose local","dispose x1","source closed"]],"iteratorcontinue":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"iteratorInterrupted":["body"],"producersuccess":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"producerfailure":[true,["body","source closed"]],"producerdefect":[true,["body","source closed"]],"producerbreak":[false,["body","dispose local","dispose x1","source closed"]],"producerreturn":[false,["body","dispose local","dispose x1","source closed"]],"producercontinue":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"producerInterrupted":["body","source closed"],"streamsuccess":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"streamfailure":[true,["body","source closed"]],"streamdefect":[true,["body","source closed"]],"streambreak":[false,["body","dispose local","dispose x1","source closed"]],"streamreturn":[false,["body","dispose local","dispose x1","source closed"]],"streamcontinue":[false,["body","dispose local","dispose x1","body","dispose local","dispose x2","source closed"]],"streamInterrupted":["body","source closed"],"concurrentsuccess":[false,["body","dispose x1","body","dispose x2"]],"concurrentfailure":[true,["body"]],"concurrentdefect":[true,["body"]],"concurrentcontinue":[false,["body","dispose x1","body","dispose x2"]],"concurrentInterrupted":["body"]}
export effect function main() {
  return {
    arraysuccess: try array("success"),
    arrayfailure: try array("failure"),
    arraydefect: try array("defect"),
    arraybreak: try array("break"),
    arrayreturn: try array("return"),
    arraycontinue: try array("continue"),
    arrayInterrupted: try arrayInterrupted(),
    iteratorsuccess: try iterator("success"),
    iteratorfailure: try iterator("failure"),
    iteratordefect: try iterator("defect"),
    iteratorbreak: try iterator("break"),
    iteratorreturn: try iterator("return"),
    iteratorcontinue: try iterator("continue"),
    iteratorInterrupted: try iteratorInterrupted(),
    producersuccess: try producer("success"),
    producerfailure: try producer("failure"),
    producerdefect: try producer("defect"),
    producerbreak: try producer("break"),
    producerreturn: try producer("return"),
    producercontinue: try producer("continue"),
    producerInterrupted: try producerInterrupted(),
    streamsuccess: try stream("success"),
    streamfailure: try stream("failure"),
    streamdefect: try stream("defect"),
    streambreak: try stream("break"),
    streamreturn: try stream("return"),
    streamcontinue: try stream("continue"),
    streamInterrupted: try streamInterrupted(),
    concurrentsuccess: try concurrent("success"),
    concurrentfailure: try concurrent("failure"),
    concurrentdefect: try concurrent("defect"),
    concurrentcontinue: try concurrent("continue"),
    concurrentInterrupted: try concurrentInterrupted(),
  }
}
