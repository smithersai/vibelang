import { Data, Effect } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
data Delivery { Waiting; Sent { tracking: string }; Rejected { reason: string } }
export effect function main() {
  const sent = Delivery.Sent({ tracking: "parcel" })
  const tracking = "outer"
  const bound = match (sent) { when { _tag: "Sent", let tracking }: tracking; default: "none"; }
  const exists = match (sent) { when { tracking }: tracking; default: "none"; }
  return [Delivery.Waiting()._tag, sent._tag, bound, exists, Delivery.Rejected({ reason: "bad" }).reason, Delivery.$is("Sent")(sent)]
}

