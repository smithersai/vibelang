import {foreign} from "./foreign.js"
const awaited=await Promise.resolve(3)
let caught=""
try{foreign()}catch{caught="foreign"}
async function rejected(){throw new Error("async")}
const cold=effect {throw "typed"}
export effect function main(){
 const rejectedExit=try Effect.exit(Effect.tryPromise(()=>rejected()))
 const failedExit=try Effect.exit(cold)
 return [awaited,caught,Exit.isFailure(rejectedExit),Exit.isFailure(failedExit)]
}
