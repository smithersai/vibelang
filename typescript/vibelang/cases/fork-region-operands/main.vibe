// expect-result: {"all":[1,2],"record":{"f":1,"g":2},"settled":true,"raced":1,"any":1,"forked":1,"interrupted":true,"looped":true}
// Direct reads in concurrent operands stay with the owning region.
import { all as $tryAllEffects } from "effect/Effect"
import { $global as $tryGlobals } from "vibelang-runtime"
import { map as $tryMapResults } from "effect/Effect"
import { join as $tryJoinFiber } from "effect/Fiber"
effect function work(n: number) {
  try sleep("1 millis")
  return n
}

export effect function main() {
  const f = fork work(1)
  const g = fork work(2)
  const all = (try.all [$tryJoinFiber(f), $tryJoinFiber(g)])
  const record = (try $tryMapResults($tryAllEffects({ f: $tryJoinFiber(f), g: $tryJoinFiber(g) }, { concurrency: "unbounded" }), ($tryResults) => $tryGlobals.Object.fromEntries(["f","g"].map(($tryKey) => [$tryKey, $tryResults[$tryKey as keyof typeof $tryResults]])) as unknown as typeof $tryResults))
  const settled = (try $tryAllEffects([$tryJoinFiber(f), $tryJoinFiber(g)], { concurrency: "unbounded", mode: "result" }))
  const raced = (try.race [$tryJoinFiber(f), effect { return try do { try sleep("1 second"); 0 } }])
  const any = (try.any [$tryJoinFiber(f)])
  const waiter = fork (join f)
  const forked = join waiter
  const pending = fork sleep("1 minute")
  const stopper = fork { try Fiber.interrupt(pending) }
  join stopper
  const interrupted = Exit.isFailure(try Fiber.await(pending))
  const other = fork sleep("1 minute")
  for concurrent (const n of [1]) { try Fiber.interrupt(other) }
  for concurrent (const n of [1]) join f
  return { all, record, settled: settled.length === 2, raced, any, forked, interrupted, looped: Exit.isFailure(try Fiber.await(other)) }
}
