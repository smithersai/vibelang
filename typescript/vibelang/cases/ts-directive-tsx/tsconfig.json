{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "outDir": "out",
    "declaration": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "*.tsx"
  ]
}
