// expect: TS2345
// An unmarked function is plain (VIP-1), so plain code calls it and passes it
// anywhere: a module's top level, a class field, a constructor, an accessor, a
// parameter default, a function with a plain annotation, and a plain callback.
// An Effect function returns an Effect, so it does not fit a parameter that
// wants a number back, and TypeScript's error says so.
function twice(n: number) {
  return n * 2
}
effect function cmp(a: number, b: number): number!! {
  return a - b
}

export const mapped = [1, 2].map(twice)
export const sorted = [2, 1].sort(cmp)
export const called = [1, 2].map((n) => twice(n))
export const initial = twice(3)

export class Holder {
  field = twice(1)
  static shared = twice(2)
  readonly made: number
  constructor() {
    this.made = twice(3)
  }
  get value(): number {
    return twice(4)
  }
}

export function withDefault(n = twice(5)): number {
  return n
}

export function plain(n: number): number {
  return twice(n)
}
