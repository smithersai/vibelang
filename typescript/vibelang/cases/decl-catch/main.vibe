// expect-result: {"a":"missing 7","b":"busy","c":"offline","d":"other: Broken","e":"rethrown","f":"handled","g":"schema"}
error NotFound { id: string }
error Busy
error Offline
error Broken

effect function fail(kind: string) {
  if (kind === "missing") throw new NotFound({ id: "7" })
  if (kind === "busy") throw new Busy()
  if (kind === "offline") throw new Offline()
  if (kind === "ok") return "fine"
  throw new Broken()
}

effect function describe(kind: string) {
  try {
    return try fail(kind)
  } catch (e) {
    switch (e._tag) {
      case "NotFound": return `missing ${e.id}`
      case "Busy": return "busy"
      case "Offline": return "offline"
      default: return `other: ${e._tag}`
    }
  }
}

// The default rethrows failures this match does not handle.
effect function partial(kind: string): string!Broken! {
  try {
    return try fail(kind)
  } catch (e) {
    switch (e._tag) {
      case "NotFound": case "Busy": case "Offline": return "handled"
      default: throw e
    }
  }
}

// A failure raised inside a clause is not tested by the clauses after it.
effect function rethrow() {
  try {
    try {
      try fail("missing")
      return "none"
    } catch (e) {
      switch (e._tag) {
        case "NotFound": throw new Busy()
        case "Busy": return "wrongly caught"
        default: throw e
      }
    }
  } catch (e) {
    if (e._tag === "Busy") return "rethrown"
    throw e
  }
}

const Port = Schema.Struct({ port: Schema.Number })

effect function parsePort(input: unknown) {
  try {
    return `${(try Schema.decodeUnknownEffect(Port)(input)).port}`
  } catch (e) {
    if (e._tag === "SchemaError") return "schema"
    throw e
  }
}

export effect function main() {
  return {
    a: try describe("missing"),
    b: try describe("busy"),
    c: try describe("offline"),
    d: try describe("broken"),
    e: try rethrow(),
    f: try partial("busy"),
    g: try parsePort({ port: "x" })
  }
}
