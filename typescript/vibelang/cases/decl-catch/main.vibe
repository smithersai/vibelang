
import * as $nativeTryEffect4 from "effect/Effect";
import * as $nativeTryEffect3 from "effect/Effect";
import * as $nativeTryEffect2 from "effect/Effect";
import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"a":"missing 7","b":"busy","c":"offline","d":"other: Broken","e":"rethrown","f":"handled","g":"schema"}
error NotFound { id: string }
error Busy
error Offline
error Broken

effect function fail(kind: string) {
  if (kind === "missing") throw new NotFound({ id: "7" })
  if (kind === "busy") throw new Busy()
  if (kind === "offline") throw new Offline()
  if (kind === "ok") return "fine"
  throw new Broken()
}

effect function describe(kind: string) {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try fail(kind)) };
  }, effect (e) => {
    switch (e._tag) {
      case "NotFound": return { kind: "return:" as const, value: (`missing ${e.id}`) };
      case "Busy": return { kind: "return:" as const, value: ("busy") };
      case "Offline": return { kind: "return:" as const, value: ("offline") };
      default: return { kind: "return:" as const, value: (`other: ${e._tag}`) };
    }
  
;return { kind: "normal" } as const;
});
if ($nativeTryCompletion.kind === "return:") return $nativeTryCompletion.value;
}
}

// The default rethrows failures this match does not handle.
effect function partial(kind: string): string!Broken! {
  { const $nativeTryCompletion4 = try $nativeTryEffect4.catch(effect {
    return { kind: "return:" as const, value: try fail(kind) };
  }, effect (e) => {
    switch (e._tag) {
      case "NotFound": case "Busy": case "Offline": return { kind: "return:" as const, value: "handled" };
      default: throw e
    }
  });
return $nativeTryCompletion4.value;
}
}

// A failure raised inside a clause is not tested by the clauses after it.
effect function rethrow() {
  { const $nativeTryCompletion2 = try $nativeTryEffect2.catch(effect {
    { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
      try fail("missing")
      return { kind: "return:" as const, value: ("none") };
    }, effect (e) => {
      switch (e._tag) {
        case "NotFound": throw new Busy()
        case "Busy": return { kind: "return:" as const, value: ("wrongly caught") };
        default: throw e
      }
    
;return { kind: "normal" } as const;
});
if ($nativeTryCompletion1.kind === "return:") return { kind: "return:" as const, value: ($nativeTryCompletion1.value) };
}
  
;return { kind: "normal" } as const;
}, effect (e) => {
    if (e._tag === "Busy") return { kind: "return:" as const, value: ("rethrown") };
    throw e
  });
if ($nativeTryCompletion2.kind === "return:") return $nativeTryCompletion2.value;
}
}

const Port = Schema.Struct({ port: Schema.Number })

effect function parsePort(input: unknown) {
  { const $nativeTryCompletion3 = try $nativeTryEffect3.catch(effect {
    return { kind: "return:" as const, value: (`${(try Schema.decodeUnknownEffect(Port)(input)).port}`) };
  }, effect (e) => {
    if (e._tag === "SchemaError") return { kind: "return:" as const, value: ("schema") };
    throw e
  });
return $nativeTryCompletion3.value;
}
}

export effect function main() {
  return {
    a: try describe("missing"),
    b: try describe("busy"),
    c: try describe("offline"),
    d: try describe("broken"),
    e: try rethrow(),
    f: try partial("busy"),
    g: try parsePort({ port: "x" })
  }
}
