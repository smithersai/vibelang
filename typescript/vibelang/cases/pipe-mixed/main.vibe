// expect-result: true
// The left side evaluates once, and % is its value wherever it stands (VIP-23).
// race runs that Effect, and Effect.succeed holds the same Effect as data, so
// the value succeed gives wins the race, unrun.
effect function work() {
  try sleep("1 millis")
  return 1
}

export effect function main() {
  const winner = work() |> try race(%, Effect.succeed(%))
  return Effect.isEffect(winner)
}
