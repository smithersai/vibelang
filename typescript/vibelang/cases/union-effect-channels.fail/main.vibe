// expect: EK9201 EK9202 TS2322
import { Config, Effect } from "effect"
error First {}
error Second {}
service One { id: string }
service Two { id: string }
type Choose = () => Effect.Effect<string, First, One> | Effect.Effect<number, Second, Two>
export effect function missingError(f: Choose): Effect.Effect<string | number, First, One | Two> {
  return try f()
}
export effect function missingRequirement(f: Choose): Effect.Effect<string | number, First | Second, One> {
  return try f()
}
export effect function missingByName(f: Choose): Effect.Effect<string | number, never, never> {
  return try Effect.map(f(), (value) => value)
}
export function mixedIsData(f: () => Effect.Effect<number> | string) {
  const value: number | string = f()
  return value
}
export function structuredIsData(f: () => Effect.Effect<number> | Config.Config<number>) {
  const value: number = f()
  return value
}
