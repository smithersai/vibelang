// expect: TS2322 EK9201 EK9202
import * as Effect from "effect/Effect"
import * as Exit from "effect/Exit"
import { implement, needsAction } from "./host.js"

export effect function wrongSuccess() {
  return try implement(effect (n) => Exit.succeed("wrong"))
}

export effect function wrongAnnotation(): Effect.Effect<number, never, never> {
  return Exit.succeed("wrong")
}
export effect function wrongError(): Effect.Effect<number, never, never> {
  return Exit.fail("bad")
}
export effect function wrongRequirement(): Effect.Effect<number, never, never> {
  return needsAction()
}
