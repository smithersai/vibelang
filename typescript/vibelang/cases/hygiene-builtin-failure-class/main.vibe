
import * as $nativeTryEffect1 from "effect/Effect";

import * as $nativeTryEffect from "effect/Effect";
// expect-result: ["caught:SyntaxError","caught:SyntaxError","caught:Bad","caught:Bad","caught:Bad"]
// A call whose contract lists failures, such as parseJson's SyntaxError or a
// trusted function's classes, tests what it throws against those classes. A
// binding around the call spelled like a class, here a parameter, does not
// replace the class in that test: the failure stays expected, and catch
// receives it.
import { trusted } from "vibelang-runtime"
import { parse, parseDeclared, parseJson } from "./helpers.ts"

export error Bad

const parseTrusted = trusted(parse, [Bad])
const parseJsonTrusted = trusted(parseJson, [SyntaxError])

// A function that compiles to plain JavaScript.
function plainParse(SyntaxError: number) {
  try {
    parseJson("{")
    return "ok"
  } catch (e) {
    return "caught:" + e.name
  }
}

// An Effect function.
effect function effectParse(SyntaxError: number) {
  try sleep("0 millis")
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    parseJsonTrusted("{")
    return { kind: "return:" as const, value: "ok" };
  }, effect (e) => {
    return { kind: "return:" as const, value: "caught:" + e.name };
  });
return $nativeTryCompletion.value;
}
}

function plainTrusted(Bad: number) {
  try {
    parseTrusted("")
    return "ok"
  } catch (e) {
    return "caught:" + e._tag
  }
}

// A legacy trusted declaration lists Bad by name: the generated test names
// the class of this file, which the parameter shadows.
function plainDeclared(Bad: number) {
  try {
    parseDeclared("")
    return "ok"
  } catch (e) {
    return "caught:" + e._tag
  }
}

effect function effectTrusted(Bad: number) {
  try sleep("0 millis")
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    parseTrusted("")
    return { kind: "return:" as const, value: "ok" };
  }, effect (e) => {
    return { kind: "return:" as const, value: "caught:" + e._tag };
  });
return $nativeTryCompletion1.value;
}
}

export effect function main() {
  return [plainParse(0), try effectParse(0), plainTrusted(0), try effectTrusted(0), plainDeclared(0)]
}
