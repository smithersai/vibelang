// Every .vibe file sees the prelude without an import (D4, D48): Effect is the
// effect module and the type Effect<A, E, R>, Scope the module and the type
// Scope.Scope. The emitted JavaScript imports exactly the names the file uses
// as values: effect modules from effect, the rest from vibelang-runtime.
class NotFound extends TaggedError("NotFound")<{ readonly id: number }> {}

const names = ["ada", "grace"]

function lookup(id: number) {
  if (id >= names.length) try Effect.fail(new NotFound({ id }))
  return names[id]
}

const done: Effect<void, never, Scope> = Effect.void
const both: Effect.Effect<void, never, Scope.Scope> = done
const double = (n: number): number => n * 2

// The top level may not run a program (EK1001), so the Effect<number> value
// arrives as a program, a function with no parameters (D7).
function first(one: Effect<number>) {
  return try Effect.map(one, (x) => x)
}

// expect-result: {"found":"ada","tag":"NotFound","piped":8,"one":1}
export function main() {
  const found = try lookup(0)
  const tag = new NotFound({ id: 9 })._tag
  const piped = pipe(2, double, double)
  return { found, tag, piped, one: try first(() => Effect.succeed(1)) }
}

export const unused = both
