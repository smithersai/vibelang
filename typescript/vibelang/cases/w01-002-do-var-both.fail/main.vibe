// expect: EK0201 EK0203 EK0201 EK0203
// rule-evidence: docs/design/src/002-running.md#do-expressions | When both specific rules apply, report both `EK0201` and `EK0203`: ending in a declaration and declaring `var` in a parameter list are separate early errors.
// A final `var` in a parameter default's `do` is both early errors, at the same `var`.
export function finalParameterVar(x = do { var y = 1 }) { return x }

// Controls: each rule alone reports only its own code.
export function finalBodyVar() { return do { var y = 1 } }
export function nonfinalParameterVar(x = do { var y = 1; y }) { return x }
