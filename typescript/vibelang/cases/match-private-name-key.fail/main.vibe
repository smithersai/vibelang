// expect: EK0707
// A pattern key is a PropertyName, which has no private name (chapter 004,
// Syntax and meaning), even in a class that declares the name.
export function bare(x: any) {
  return match (x) { when { #a }: 1; default: 0; };
}
export function value(x: any) {
  return match (x) { when { #a: 1 }: 1; default: 0; };
}
export function nested(x: any) {
  return match (x) { when { b: [{ #a?: let y }] }: y; default: 0; };
}
export function operand(x: any) {
  if (x is { #a: 1 }) {
    return 1;
  }
  return 0;
}
export class C {
  #a = 1;
  m(x: any) {
    return [this.#a, match (x) { when { #a: let y }: y; default: 0; }];
  }
}
