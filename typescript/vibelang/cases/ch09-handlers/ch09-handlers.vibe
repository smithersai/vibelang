// Chapter 9. Handlers: defining your own effects.
// Control operations are abstract classes that extend the prelude Control (D2).
import { Scope } from "effect"

class ReviewBusy extends TaggedError("ReviewBusy")<{ readonly request: string }> {}
class Declined extends TaggedError("Declined")<{ readonly cartId: string }> {}
class PaymentError extends TaggedError("PaymentError")<{ readonly cartId: string }> {}

interface Receipt {
  cartId: string
  paid: boolean
}

interface Hold {
  cartId: string
}

interface Cell {
  row: number
  value: number
}

interface Cursor {
  cells: ReadonlyArray<Cell>
}

interface Grid {
  rows: ReadonlyArray<number>
  open(row: number): Effect<Cursor, never, Scope.Scope>
}

// Declaring and performing an operation

abstract class Approval extends Control {
  abstract approve(request: string): Effect<boolean, ReviewBusy, never>
}

abstract class Inventory {
  abstract reserve(cartId: string): Effect<Hold, never, Scope.Scope>
}

abstract class Payments {
  abstract charge(cartId: string): Effect<Receipt, PaymentError, never>
}

abstract class Reviewers {
  abstract decide(request: string): Effect<boolean, never, never>
  abstract busy(): Effect<boolean, never, never>
}

const events: string[] = []
let reviewersBusy = false

function checkout(cartId: string) {
  using hold = try Inventory.reserve(cartId)
  const ok = try Approval.approve(`charge cart ${cartId}`)
  if (!ok) throw new Declined({ cartId })
  return try Payments.charge(cartId)
}
// Effect<Receipt, ReviewBusy | Declined | PaymentError, Approval | Inventory | Payments>

// Handling it
// NOTE: the proposal shows `const receipt = handle(...)` as a fragment; wrapped in approvedCheckout.

function approvedCheckout() {
  const receipt = try handle(() => checkout("c-42"), Approval, {
    approve(request, k) {
      const decision = try Reviewers.decide(request)    // may take minutes: the fiber just waits
      return try resume(k, decision)                    // checkout continues from its call
    }
  })
  // receipt: Receipt
  return receipt
}

// Not continuing

abstract class Found extends Control {
  abstract found(cell: Cell): Effect<never, never, never>
}

function locate(grid: Grid, target: number) {
  return try handle(() => {
    for (const row of grid.rows) {
      using cursor = try grid.open(row)
      for (const cell of cursor.cells) if (cell.value === target) try Found.found(cell)
    }
    return undefined
  }, Found, {
    found(cell, _k) { return cell }      // stop: the open cursor is released before handle returns
  })
}
// Effect<Cell | undefined, never, never>

function makeGrid(values: ReadonlyArray<ReadonlyArray<number>>) {
  const grid: Grid = {
    rows: values.map((_, index) => index),
    open: (row) => Effect.acquireRelease(
      () => {
        events.push(`open row ${row}`)
        const cursor: Cursor = { cells: (values[row] as ReadonlyArray<number>).map((value) => ({ row, value })) }
        return cursor
      },
      () => {
        events.push(`close row ${row}`)
      }
    )
  }
  return grid
}

// Continuing with an error

function busyCheckout() {
  const outcome = try handle(() => checkout("c-42"), Approval, {
    approve(request, k) {
      if (try Reviewers.busy()) return try resumeWith(k, () => { throw new ReviewBusy({ request }) })
      return try resume(k, try Reviewers.decide(request))
    }
  })
  return outcome
}

// Testing with a handler
// NOTE: the proposal wraps this in it.effect(...) with assert.isTrue; here it returns the value.

function testApproved() {
  const receipt = try handle(() => checkout("c-42"), Approval, {
    approve: (_request, k) => resume(k, true)
  })
  return receipt.paid
}

// Handlers and concurrency: see ch09-approve-all-forked.fail.vibe (EK4201).

const ReviewersTest = Layer.succeed(Reviewers, {
  decide: (request) => {
    events.push(`decide ${request}`)
    return !request.includes("c-13")
  },
  busy: () => reviewersBusy
})

const InventoryTest = Layer.succeed(Inventory, {
  reserve: (cartId) => Effect.acquireRelease(
    () => {
      events.push(`reserve ${cartId}`)
      const hold: Hold = { cartId }
      return hold
    },
    () => {
      events.push(`release ${cartId}`)
    }
  )
})

const PaymentsTest = Layer.succeed(Payments, {
  charge: (cartId) => {
    events.push(`charge ${cartId}`)
    const receipt: Receipt = { cartId, paid: true }
    return receipt
  }
})

function scenario() {
  const receipt = try approvedCheckout()
  const tested = try testApproved()
  reviewersBusy = true
  let busy = "none"
  try {
    try busyCheckout()
  } catch (e) {
    busy = e._tag
  }
  reviewersBusy = false
  const cell = try locate(try makeGrid([[1, 2], [3, 5], [7]]), 5)
  events.push("locate returned")
  return { paid: receipt.paid, tested, busy, cell, events }
}

// expect-result: {"paid":true,"tested":true,"busy":"ReviewBusy","cell":{"row":1,"value":5},"events":["reserve c-42","decide charge cart c-42","charge c-42","release c-42","reserve c-42","charge c-42","release c-42","reserve c-42","release c-42","open row 0","close row 0","open row 1","close row 1","locate returned"]}
export function main() {
  return try Effect.provide(() => scenario(), Layer.mergeAll(ReviewersTest, InventoryTest, PaymentsTest))
}
