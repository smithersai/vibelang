// expect-result: {"a":2,"b":7,"c":8}
// fork x and fork { … } are syntax (rule H5, D391): a function the program
// declares named fork changes what fork(x) means, an ordinary call of that
// function, and never what the keyword forms mean. Through 0.0.10 the local
// function captured fork slow(), so f was a number and join f was EK4611.
function fork(x: number) {
  return x + 1
}

function slow(): number!! {
  try sleep("1 millis")
  return 7
}

export function main() {
  const a = try fork(1)
  const f = fork slow()
  const g = fork {
    try sleep("1 millis")
    return 8
  }
  return { a, b: join f, c: join g }
}
