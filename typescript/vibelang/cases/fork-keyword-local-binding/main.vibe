// expect-result: {"a":2,"b":7,"c":8}
// VIP-17 reserves fork in Effect code. A plain helper can still call an
// ordinary function named fork, while keyword forms start fibers.
function fork(x: number) {
  return x + 1
}

function ordinaryFork() { return fork(1) }

effect function slow(): number!! {
  try sleep("1 millis")
  return 7
}

export effect function main() {
  const a = ordinaryFork()
  const f = fork slow()
  const g = fork effect {
    try sleep("1 millis")
    return 8
  }
  return { a, b: join f, c: join g }
}
