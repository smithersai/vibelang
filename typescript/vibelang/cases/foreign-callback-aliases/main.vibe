function own() { return 2 }
const localAlias = own

export effect function main() {
  const admitted = allow(riskyAlias)
  const recovered = Effect.try(riskyAlias) catch () => 9
  return [safeAlias(), localAlias(), recovered, typeof admitted, try programAlias()]
