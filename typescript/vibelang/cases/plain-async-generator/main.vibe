// expect-result: [[1,2,3],[4,5,6]]
import { Effect } from "effect"

export async function* steps(): AsyncGenerator<number, void, unknown> {
  yield await Promise.resolve(1)
  for await (const value of [2, 3]) yield value
}
export async function* iterator(): AsyncIterator<number> { yield 4 }
export async function* iterableIterator(): AsyncIterableIterator<number> { yield 5 }
export async function* iterable(): AsyncIterable<number> { yield 6 }

export function main() {
  return try sync(async (steps, iterator, iterableIterator, iterable) => {
    const values: number[] = []
    for await (const value of steps()) values.push(value)
    const others = [(await iterator().next()).value]
    for await (const value of iterableIterator()) others.push(value)
    for await (const value of iterable()) others.push(value)
    return [values, others]
  }, steps, iterator, iterableIterator, iterable)
}
