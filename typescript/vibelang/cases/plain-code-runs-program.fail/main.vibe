// expect: EK1001 EK1001 EK1001 EK1001 EK1001 TS2362 TS2362 TS2365
// A class field's initializer, a default parameter value, a constructor, an
// accessor and a static block run as plain JavaScript wherever they stand,
// outside any program (D282). A running call there is always EK1001,
// including when its result has no contextual type.
// TypeScript can also report errors where the unrun Effect is used
// as a success value in arithmetic or a comparison.
function now(): number!! { return try Clock.currentTimeMillis() }

class Box {
  created = now()
  readonly size: number
  constructor() { this.size = now() * 2 }
  get age() { return now() - 1 }
  static { const late: boolean = now() > 0 }
}

function label(id: number = now()) { return `#${id}` }

export function main() {
  return [new Box().size, try label()]
}
