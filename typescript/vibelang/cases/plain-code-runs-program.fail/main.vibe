// expect: EK0501
// A class field's initializer, a default parameter value, a constructor, an
// accessor and a static block run as plain JavaScript wherever they stand,
// outside any Effect, and none can be marked effect (VIP-1). try there is
// always EK0501 (VIP-5), including where its result has no contextual type.
// Rejected try expressions keep their success type, as rejected await does.
effect function now(): number!! { return try Clock.currentTimeMillis }

class Box {
  created = try now()
  readonly size: number
  constructor() { this.size = (try now()) * 2 }
  get age() { return (try now()) - 1 }
  static { const late: boolean = (try now()) > 0 }
}

function label(id: number = try now()) { return `#${id}` }

export effect function main() {
  return [new Box().size, label()]
}
