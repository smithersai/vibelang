import { risky, safe } from "./helpers.ts"

declare global {
  namespace JSX {
    interface Element {}
    interface IntrinsicElements { button: { onClick: () => void } }
  }
}
const handler = risky
const safeHandler = safe
export function AliasHandler() { return <button onClick={handler} /> }
export function SpreadAliasHandler() { return <button {...{ onClick: handler }} /> }
