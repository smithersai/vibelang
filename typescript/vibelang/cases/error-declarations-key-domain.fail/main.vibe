// expect: EK2117
import { Brand } from "effect"
enum Key { Tag = "_tag", Count = "count" }
declare const key: Key
declare const branded: "_tag" & Brand.Brand<"Tag">
declare const broad: string & Brand.Brand<"Text">
declare const choice: "count" | "_tag"
schema error EnumDomain { [key]: number }
schema error BrandedTag { [branded]: number }
schema error BrandedString { [broad]: number }
schema error UnionDomain { [choice]: number }
function generic<K extends string>(key: K) {
  schema error GenericDomain { [key]: number }
  return GenericDomain
}
declare const anyKey: any
declare const broadKey: PropertyKey
schema error AnyDomain { [anyKey]: number }
schema error BroadKeyDomain { [broadKey]: number }
export {}

