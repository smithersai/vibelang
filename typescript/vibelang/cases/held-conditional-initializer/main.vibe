// A declared Effect const holds a conditional initializer (D269): its value
// is one of the branches, so neither branch runs when the const is
// initialized, and the chosen branch runs each time the const is run. Only
// the condition is evaluated at initialization.
const count = (state: { mutable runs: number }): number!! => {
  state.runs++
  return state.runs
}

const pick = effect (state: { mutable runs: number }, fixed: number | undefined): number!! => {
  const program: number!! = fixed === undefined ? count(state) : Effect.succeed(fixed)
  return try program() + try program()
}

// expect-result: [[0,0,1],[2,0,1],[3,14,3]]
export effect function main() {
  const left = { runs: 0 }
  const right = { runs: 0 }
  const checks = { runs: 0 }
  const fromCall: number!! = right.runs === 0 ? count(left) : count(right)
  const fromSucceed: number!! = ((checks.runs++, left.runs === 0) ? Effect.succeed(7) : count(right)) as number!!
  const before = [left.runs, right.runs, checks.runs]
  const a = try fromCall() + try fromCall()
  const after = [left.runs, right.runs, checks.runs]
  const b = try fromSucceed() + try fromSucceed()
  return [before, after, [a, b, try pick({ runs: 0 }, undefined)]]
}
