// expect-result: [true,true,true,true,7,20000]
// A named function expression binds its name to itself. When it compiles to
// an Effect function, the name is that Effect function, not the generator
// that runs its body, for a reference in its body or in a parameter default.
type Self = () => Self!!

const named = effect function inner(): Self!! {
  try sleep("1 millis")
  return inner
}

effect function declaration(f: Self = declaration): Self!! {
  try sleep("1 millis")
  return f
}

// Recursion through the name runs on Effect's frames, by name too.
const byName = effect function self(n: number): number!! {
  if (n === 0) return 7
  return try Effect.retry(self(n - 1), { times: 0 })
}

const deep = effect function count(n: number): number!! {
  const tick = try Effect.sync(() => 0)
  return n === 0 ? 0 : try count(n - 1) + 1
}

export effect function main() {
  const fromNamed = try named()
  const fromDeclaration = try declaration()
  // Calling a Self in TypeScript builds an Effect.
  const builds = try sync((a: Self, b: Self) => [Effect.isEffect(a()), Effect.isEffect(b())], fromNamed, fromDeclaration)
  return [fromNamed === named, builds[0], fromDeclaration === declaration, builds[1], try byName(2), try deep(20000)]
}
