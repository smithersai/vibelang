// Rest arrays belong to each execution, including the direct-return path.
export const compact = effect (...values: number[]): Effect<number | undefined, never, never> => values.pop()
export const expanded = effect (...values: number[]): Effect<number | undefined, never, never> => {
  const last = values.pop()
  return last
}
export effect function declared(...values: number[]): Effect<number | undefined, never, never> { return values.pop() }
export const expression = effect function (...values: number[]): Effect<number | undefined, never, never> { return values.pop() }
export class Counter {
  effect compact(...values: number[]): Effect<number | undefined, never, never> { return values.pop() }
  effect expanded(...values: number[]): Effect<number | undefined, never, never> {
    const last = values.pop()
    return last
  }
}
export const object = {
  effect read(...values: number[]): Effect<number | undefined, never, never> { return values.pop() }
}
export class Defaults {
  effect read(values: number[] = [1, 2]): Effect<number | undefined, never, never> { return values.pop() }
  effect destructured({ values = [1, 2] }: { values?: number[] } = {}): Effect<number | undefined, never, never> { return values.pop() }
}
export effect function declaredProgram(...values: number[]): Effect<number | undefined, never, never> { return try Effect.succeed(values.pop()) }
export const fresh = effect (...values: number[]): Effect<number[], never, never> => values
