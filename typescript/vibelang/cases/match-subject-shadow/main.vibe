// expect-result: [9,16,25,1,36,"3.0"]
data Shape { Sq { s: number }; Empty }

function area(s: Shape): number {
  return match (s) {
    when Shape.Sq { let s }: s * s;
    when Shape.Empty: 0;
  }
}

function expression(s: Shape): number {
  const area = match (s) {
    when Shape.Sq { let s }: s * s;
    when Shape.Empty: 0;
  }
  return area
}

// Existing matches still narrow the original subject in each arm.
function display(input: number | boolean): string {
  return match (input) {
    when Number: input.toFixed(1);
    when Boolean: input ? "enabled" : "disabled";
  }
}

export effect function main() {
  let size = 0
  const s: Shape = try sync((Shape) => Shape.Sq({ s: 5 }) as Shape, Shape)
  match (s) {
    when Shape.Sq { let s }: size = s * s;
    when Shape.Empty: size = 0;
  }
  let calls = 0
  function subject() { calls++; return Shape.Sq({ s: 6 }) }
  const once = area(subject())
  return [area(Shape.Sq({ s: 3 })), expression(Shape.Sq({ s: 4 })), size, calls, once, display(3)]
}
