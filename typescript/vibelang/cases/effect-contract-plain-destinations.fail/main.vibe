// expect: TS2322 TS2740
// A function's kind is its marker (VIP-1): an Effect function in a plain
// destination is TypeScript's own error, and map keeps the Effects it builds.
import { Schema, SchemaTransformation } from "effect"
effect function double(n: number): number!! { return n * 2 }
export function main() {
  [1, 2].map(double)
  Schema.suspend(effect (): Schema.Codec<string, string>!! => Schema.String)
  return SchemaTransformation.transform({
    decode: effect (text: string): ReadonlyArray<string>!! => text.split(";"),
    encode: (items: ReadonlyArray<string>) => items.join(";")
  })
}
