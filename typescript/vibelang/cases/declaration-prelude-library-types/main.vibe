// The declaration file imports each prelude name and effect root export that
// its declarations write. An inferred type that copies a library's own type
// node writes such a name only if the source does: Schema, but not SchemaAST
// (Schema.d.ts) or Types (Context.d.ts), which keep TypeScript's import type.
export const done = (value: typeof Schema.Json.Type): number => value === null ? 0 : 1
export const decodeName = Schema.decodeUnknownEffect(Schema.String)
export const makeContext = Context.make
