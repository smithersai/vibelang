// In a module cycle, an importer that passes a plain function as a callback
// before the exporter's body has run passes the hoisted function (D446, D500).
import { mapped } from "./user.vibe"
import { log } from "./log.vibe"

export function double(n: number): number {
  return n * 2
}

log.push("main")

// expect-result: {"mapped":[2,4],"log":["user","main"]}
export function main() {
  return { mapped, log }
}
