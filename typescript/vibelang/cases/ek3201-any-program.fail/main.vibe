// expect: EK1002 EK3201
// An Effect TypeScript program pasted into a .vibe file: Effect.gen takes a
// producer here (EK1002), so main has type any, and EK3201 at the runner says
// its services are unknown rather than "no provider for any". The top-level
// Effect.gen call only builds a value (VIP-1, VIP-26), so it is no EK1001.
import { Context, Effect } from "effect"

class Greeter extends Context.Service<Greeter, {
  readonly greet: (name: string) => Effect.Effect<string>
}>()("app/Greeter") {}

const main = Effect.gen(function* () {
  const greeter = yield* Greeter
  yield* try Effect.log(yield* try greeter.greet("VibeLang"))
})

Effect.runPromise(main)
