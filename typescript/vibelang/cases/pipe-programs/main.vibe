// Programs use explicit nested stages (D383). pipe passes its first
// argument as a value and remains useful for ordinary data pipelines.
import { Array as Arr, Schedule } from "effect"

let attempts = 0

function flaky() {
  attempts++
  if (attempts < 3) throw new Error(`attempt ${attempts}`)
  return `ok after ${attempts}`
}

function piped() {
  return do {
    const $pipe0: string!Error! = () => flaky()
    const $pipe1 = { times: 3 }
    const $pipe2 = Effect.withSpan("flaky")
    try $pipe2(() => Effect.timeout(() => Effect.retry($pipe0, $pipe1), "1 second"))
  }
}

// A stored program works the same way.
function stored() {
  const job = () => flaky()
  return do {
    const $pipe3 = job
    const $pipe4: string!Error! = () => $pipe3()
    const $pipe5 = Schedule.recurs(1)
    try Effect.retry($pipe4, $pipe5)
  }
}

// Plain data flows through plain stages.
function data() {
  return pipe([1, 2, 3], Arr.map((n) => n * 2), Arr.reduce(0, (sum, n) => sum + n))
}

// expect-result: {"piped":"ok after 3","stored":"ok after 4","data":12}
export function main() {
  return { piped: try piped(), stored: try stored(), data: try data() }
}
