// Reference program 6. Handlers: nested prompts, one resumption, a rejected double resumption,
// abandonment with finalization, a producer with early break, and a control operation rejected at a
// fork (ref6-fork.fail.vibe).
import { Exit } from "effect"

abstract class Ask extends Control {
  abstract ask(question: string): Effect<number, never, never>
}

abstract class Emit extends Control {
  abstract emit(message: string): Effect<void, never, never>
}

const events: string[] = []

// Nested prompts: the inner handler answers Ask, the outer one answers Emit.

effect function conversation() {
  const a = try Ask.ask("first")
  try Emit.emit(`got ${a}`)
  const b = try Ask.ask("second")
  try Emit.emit(`got ${b}`)
  return a + b
}

effect function nested() {
  return try handle(effect { return try handle(effect { return try conversation() }, Ask, {
    effect ask(question, k) { return try resume(k, question.length) }       // one resumption per operation
  }) }, Emit, {
    effect emit(message, k) {
      events.push(message)
      return try resume(k, undefined)
    }
  })
}

// Nested prompts for the same operation: the innermost handler answers.
effect function shadowed() {
  return try handle(effect {
    const outer = try Ask.ask("x")
    const inner = try handle(effect { return try Ask.ask("y") }, Ask, {
      effect ask(question, k) { return try resume(k, 100) }
    })
    return outer + inner
  }, Ask, {
    effect ask(question, k) { return try resume(k, 1) }
  })
}

// A rejected double resumption: the second resume is a defect (ContinuationAlreadyConsumed).
effect function doubleResume() {
  return try handle(effect { return try Ask.ask("twice") }, Ask, {
    effect ask(question, k) {
      const first = try resume(k, 1)
      const second = try resume(k, 2)
      return first + second
    }
  })
}

// Abandonment with finalization: a clause that returns without resuming; the body's finally runs
// before handle returns, and the body's code after the operation never runs.
effect function abandoning() {
  const result = try handle(effect {
    try {
      try Ask.ask("stop")
      events.push("continued")
      return "finished"
    } finally {
      events.push("finalizer ran")
    }
  }, Ask, {
    effect ask(question, _k) { return `abandoned at ${question}` }
  })
  events.push("handle returned")
  return result
}

// The same with an explicit abandon(k).
effect function explicitAbandon() {
  return try handle(effect {
    try {
      try Ask.ask("drop")
      return "finished"
    } finally {
      events.push("abandon finalizer ran")
    }
  }, Ask, {
    effect ask(question, k) {
      try abandon(k)
      return "dropped"
    }
  })
}

// A producer with early break: the producer's finally runs before the loop exits.

function* naturals() {
  try {
    let n = 0
    while (true) {
      yield n
      n++
    }
  } finally {
    events.push("naturals closed")
  }
}

effect function firstSquaresOver(limit: number) {
  const out: number[] = []
  for (const n of naturals()) {
    if (n * n > limit) {
      out.push(n * n)
      if (out.length === 3) break
    }
  }
  events.push("loop exited")
  return out
}

// D18: a long iteration must run in constant stack (the tail-resume shape).
effect function sumBelow(count: number) {
  let total = 0
  for (const n of naturals()) {
    if (n >= count) break
    total += n
  }
  return total
}

effect function scenario() {
  const sum = try nested()
  const shadow = try shadowed()
  const doubled = try Effect.exit(effect { return try doubleResume() })
  const abandoned = try abandoning()
  const dropped = try explicitAbandon()
  const squares = try firstSquaresOver(10)
  const total = try sumBelow(10000)
  return {
    sum,
    shadow,
    doubleResume: Exit.isFailure(doubled)
      ? (doubled.cause.reasons as ReadonlyArray<(typeof doubled.cause.reasons)[number]>).map((reason) => (reason._tag === "Die" ? (reason.defect as { _tag?: string })._tag : reason._tag))
      : ["Success"],
    abandoned,
    dropped,
    squares,
    total,
    events
  }
}

// expect-result: {"sum":11,"shadow":101,"doubleResume":["ContinuationAlreadyConsumed"],"abandoned":"abandoned at stop","dropped":"dropped","squares":[16,25,36],"total":49995000,"events":["got 5","got 6","finalizer ran","handle returned","abandon finalizer ran","naturals closed","loop exited","naturals closed"]}
export effect function main() {
  return try scenario()
}
