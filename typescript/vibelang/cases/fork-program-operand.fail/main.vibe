// expect: EK1703
// fork e forks the Effect e (VIP-17): fork held forks the program held, and
// fork(effect { ... }) forks the block. A function is not an Effect, so fork
// job is EK1703 (decided detail 88). Through 0.0.10 fork job ran the
// function's program; write fork job().
effect function heartbeat(): number!! {
  try sleep("1 millis")
  return 7
}

export effect function main() {
  const job = effect () => try heartbeat()
  const held: number!! = effect { return try heartbeat() }
  const a = fork job
  const b = fork(effect { return try heartbeat() })
  const c = fork held
  return [join a, join b, join c]
}
