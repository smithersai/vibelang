// Handlers (chapter 9): two handlers for one program, a clause that returns
// without resuming, abandon, resumeWith, onReturn, a rejected second resume,
// and a tail-resumptive clause that runs 100,000 times in constant stack.
import { Data, Effect, Exit } from "effect"
import { abandon, Control, handle, resume, resumeWith } from "vibelang-runtime"
import { hooks } from "vibelang-runtime/kernel"

class Busy extends Data.TaggedError("Busy")<{ readonly request: string }> {}

abstract class Ask extends Control {
  abstract ask(question: string): Effect.Effect<number, Busy, never>
}

abstract class Log extends Control {
  abstract log(message: string): Effect.Effect<void, never, never>
}

const events: string[] = []

effect function conversation() {
  const a = try Ask.ask("first")
  try Log.log(`got ${a}`)
  const b = try Ask.ask("second")
  try Log.log(`got ${b}`)
  return a + b
}

// Two handlers for one program: Ask inside, Log outside.
effect function twoHandlers() {
  return try handle(effect { return try handle(effect { return try conversation() }, Ask, {
    effect ask(question, k) { return try resume(k, question.length) }
  }) }, Log, {
    log: effect (message, k) => {
      events.push(message)
      return try resume(k, undefined)
    }
  })
}

// A clause that returns without resuming: the program's cleanup runs before
// handle returns, and the code after the operation never runs.
effect function stopEarly() {
  const result = try handle(effect {
    try {
      try Ask.ask("stop")
      events.push("not reached")
      return "finished"
    } finally {
      events.push("cleanup ran")
    }
  }, Ask, {
    effect ask(question, _k) { return `stopped at ${question}` }
  })
  events.push("handle returned")
  return result
}

// abandon(k) runs the program's cleanup inside the clause.
effect function abandonInClause() {
  return try handle(effect {
    try {
      return try Ask.ask("drop")
    } finally {
      events.push("abandoned cleanup")
    }
  }, Ask, {
    effect ask(_question, k) {
      try abandon(k)
      events.push("after abandon")
      return -1
    }
  })
}

// resumeWith raises the operation's declared error at the perform site, where
// the program catches it.
effect function busyAnswer() {
  return try handle(effect {
    try {
      return try Ask.ask("now")
    } catch (e) {
      return e._tag === "Busy" ? -2 : -3
    }
  }, Ask, {
    effect ask(request, k) { return try resumeWith(k, effect { throw new Busy({ request }) }) }
  })
}

// onReturn transforms what the program returns.
effect function doubled() {
  return try handle(effect { return try Ask.ask("four") }, Ask, {
    effect ask(question, k) { return try resume(k, question.length) }
  }, effect (n) => n * 2)
}

// A second resume of the same continuation is a defect.
effect function resumeTwice() {
  return try handle(effect { return try Ask.ask("twice") }, Ask, {
    effect ask(_question, k) {
      const first = try resume(k, 1)
      const second = try resume(k, 2)
      return first + second
    }
  })
}

// A clause that holds a resource with using releases it after the resumed
// program finishes, so its resume is not a tail resume.
effect function leaseWhileResuming() {
  const log: string[] = []
  const answer = try handle(effect {
    const n = try Ask.ask("lease")
    log.push(`program got ${n}`)
    return n
  }, Ask, {
    effect ask(_question, k) {
      using lease = try Effect.acquireRelease(effect {
        log.push("acquire")
      }, effect () => {
        log.push("release")
      })
      return try resume(k, 7)
    }
  })
  return { answer, log }
}

effect function count(n: number) {
  let i = 0
  while (i < n) {
    try Log.log("tick")
    i++
  }
  return i
}

// A clause whose last step is resume runs in constant stack (D18).
effect function manyTicks() {
  let maxDepth = 0
  let seen = 0
  hooks.onResume = (fiber): void => {
    maxDepth = Math.max(maxDepth, fiber._stack.length)
  }
  const total = try handle(effect { return try count(100000) }, Log, {
    effect log(_message, k) {
      seen++
      return try resume(k, undefined)
    }
  })
  hooks.onResume = undefined
  return { total, seen, bounded: maxDepth < 50 }
}

// expect-result: {"sum":11,"stopped":"stopped at stop","dropped":-1,"busy":-2,"twice":8,"again":["ContinuationAlreadyConsumed"],"leased":{"answer":7,"log":["acquire","program got 7","release"]},"many":{"total":100000,"seen":100000,"bounded":true},"events":["got 5","got 6","cleanup ran","handle returned","abandoned cleanup","after abandon"]}
export effect function main() {
  const sum = try twoHandlers()
  const stopped = try stopEarly()
  const dropped = try abandonInClause()
  const busy = try busyAnswer()
  const twice = try doubled()
  const exit = try Effect.exit(effect { return try resumeTwice() })
  const again = Exit.isFailure(exit)
    ? (exit.cause.reasons as ReadonlyArray<(typeof exit.cause.reasons)[number]>).map((reason) => (reason._tag === "Die" ? (reason.defect as { _tag?: string })._tag : reason._tag))
    : ["Success"]
  const leased = try leaseWhileResuming()
  const many = try manyTicks()
  return { sum, stopped, dropped, busy, twice, again, leased, many, events }
}
