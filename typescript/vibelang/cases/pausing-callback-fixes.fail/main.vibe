// expect: EK4301 EK4301 EK4301
// EK4301's fix fits the callee: a sort comparator cannot run an Effect, so
// its Effects run first; a VibeLang function that calls its callback as a
// plain function needs a contract that runs it (D12).
let count = 0
effect function tick(): number!! { try sleep("0 millis"); count++; return count }

function twice<A>(f: () => A): [A, A] { return [f(), f()] }

export function main() {
  const sorted = [3, 1, 2].sort((x, y) => tick() > 0 ? x - y : y - x)
  const copied = [3, 1, 2].toSorted((x, y) => x - y + tick())
  const pair = twice(() => tick())
  return [sorted, copied, pair]
}
