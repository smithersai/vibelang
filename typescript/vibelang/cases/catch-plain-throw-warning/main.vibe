// expect-result: {"plain":"Die","caught":0,"nested":0,"typed":"Fail"}
// Decided detail 239 (loop round 1, ASTRA-9): an explicit throw that can
// complete a plain catch handler is lint warning EK0511, since it makes the
// result a defect. A throw caught inside the handler or written in a nested
// function does not warn, and a throw in an effect handler is a typed failure.
effect function load(): number!string { throw "missing" }

const kind = <A, E>(exit: Exit.Exit<A, E>): string =>
  exit._tag === "Success" ? "Success" : exit.cause.reasons[0]._tag

export effect function main() {
  const plain = try Effect.exit(load() catch (e) => { throw `wrapped ${e}` })
  const caught = try (load() catch (e) => { try { throw e } catch { return 0 } })
  const nested = try (load() catch (e) => { const g = () => { throw e }; return 0 })
  const typed = try Effect.exit(load() catch effect (e) => { throw `wrapped ${e}` })
  return { plain: kind(plain), caught, nested, typed: kind(typed) }
}
