
import * as $nativeTryEffect1 from "effect/Effect";

import * as $nativeTryEffect from "effect/Effect";
// Chapter 24: the function whose region lowering both reviews examined.
// try/catch/finally compile to Effect frames; catch handles expected failures only (D13).
class InvalidId extends TaggedError("InvalidId")<{ readonly raw: string }> {}
class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

service Metrics {
  increment(name: string): Effect<void, never, never>
}

const guest: User = { id: "0", name: "guest" }

effect function parseId(raw: string) {
  if (!/^\d+$/.test(raw)) throw new InvalidId({ raw })
  return Number(raw)
}

effect function profile(raw: string) {
  const id = try parseId(raw)                 // may throw InvalidId
  { const $nativeTryCompletion = try $nativeTryEffect.onExit($nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: try (try Users).find(String(id)) };
  }, effect (e) => {                           // e: UserNotFound
    return { kind: "return:" as const, value: guest };
  }), () => effect {
    try (try Metrics).increment("profile")
  });
return $nativeTryCompletion.value;
}
}
// Effect<User, InvalidId, Users | Metrics>

const counts: string[] = []

const UsersTest = Layer.succeed(Users, {
  find: effect (id) => {
    if (id !== "42") throw new UserNotFound({ id })
    return { id, name: "Ada" }
  }
})

const MetricsTest = Layer.succeed(Metrics, {
  increment: effect (name) => {
    counts.push(name)
  }
})

// expect-result: {"found":"Ada","missing":"guest","invalid":"InvalidId","counts":["profile","profile"]}
export effect function main() {
  const found = try Effect.provide(effect { return try profile("42") }, Layer.mergeAll(UsersTest, MetricsTest))
  const missing = try Effect.provide(effect { return try profile("7") }, Layer.mergeAll(UsersTest, MetricsTest))
  let invalid = "none"
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    try Effect.provide(effect { return try profile("x") }, Layer.mergeAll(UsersTest, MetricsTest))
  
;return { kind: "normal" } as const;
}, effect (e) => {
    invalid = e._tag
  
;return { kind: "normal" } as const;
});

}
  return { found: found.name, missing: missing.name, invalid, counts }
}
