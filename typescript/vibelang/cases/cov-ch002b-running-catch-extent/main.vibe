// Chapter 002: catch runs its head after argument evaluation and catches only that Effect; docs/design/src/002-running.md#36c4117e3f64943d
import { Effect, Exit, Cause } from "effect"
function parse(bad: boolean, events: string[]): Effect.Effect<number,string> {
 events.push("parse");return bad ? Effect.fail("parse") : Effect.succeed(7)
}
function decode(n: number, events: string[]): Effect.Effect<number,string> {
 events.push("decode");return n === 7 ? Effect.fail("decode") : Effect.succeed(n)
}
effect function narrow(bad: boolean, events: string[]) {
 return decode(try parse(bad,events),events) catch e => { events.push("handler");return e.length }
}
effect function wide(events: string[]) {
 return (effect { return try decode(try parse(true,events),events) }) catch e => { events.push("handler");return e.length }
}
effect function joined() { const f=fork Effect.succeed(Effect.fail("inner"));return (join f) catch e => e.length }
export effect function main(): unknown!! {
 const a:string[]=[], b:string[]=[], c:string[]=[]
 const first=try Effect.exit(narrow(true,a)), second=try Effect.exit(narrow(false,b))
 const wideValue=try wide(c)
 const argument=(effect {return 7}) catch ()=>0
 const spanned=try Effect.withSpan(effect {return (effect {return 9}) catch ()=>0},"read")
 return [Exit.isFailure(first)?Cause.squash(first.cause):"wrong",Exit.isSuccess(second)?second.value:0,a,b,wideValue,c,try joined(),argument,spanned]
}
