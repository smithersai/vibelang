// docs/design/src/900-appendices.md#099a748a5772dd92 — Chapter 900: cov900-throw-wrappers.
import { each, later, User, failCallback } from "./helpers.js"
error BadJson { cause: unknown }
function summary(e: Exit.Exit<unknown, unknown>): unknown {
 if (e._tag === "Success") return e.value
 const reason = e.cause.reasons[0]
 return reason._tag === "Fail" ? typeof reason.error === "string" ? reason.error : (reason.error as {_tag: string})._tag : reason._tag
}
export effect function main() {
 const called = try Effect.exit(Effect.try({try: () => each([1], failCallback), catch: e => e}))
 const json = try Effect.exit(Effect.try({try: () => JSON.parse("{"), catch: cause => new BadJson({cause})}))
 const rejected = try Effect.exit(Effect.tryPromise(() => later()))
 const decoder = Schema.decodeUnknownSync(User)
 const invalid = try Effect.exit(Effect.try(() => decoder({name: 1})))
 const mapped = try Effect.succeed(2).pipe(Effect.map(n => n * 2),Effect.retry({times: 1}))
 return [summary(called),summary(json),summary(rejected),summary(invalid),mapped]
}
