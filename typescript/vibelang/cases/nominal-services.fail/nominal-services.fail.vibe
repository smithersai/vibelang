// expect: EK9202
// D1: service classes are nominal. Primary and Replica have identical members; providing only
// Primary must leave Replica in R, so onlyPrimary's contract (R = never) is violated. If the
// identities collapsed structurally, this file would compile and then die at run time with
// "Service not found" (experiments/tests/service-identity/probe.ts).

service Primary {
  query(sql: string): Effect<string, never, never>
}

service Replica {
  query(sql: string): Effect<string, never, never>
}

effect function both() {
  return `${try Primary.query("select 1")} / ${try Replica.query("select 1")}`
}

const PrimaryLive = Layer.succeed(Primary, {
  query: effect (sql) => `primary ${sql}`
})

export effect function onlyPrimary(): Effect<string, never, never> {
  return try Effect.provide(effect { return try both() }, PrimaryLive)
}
