// Every default import shape reaches the plain variant, including barrels.
import solo from "./named.vibe"
import mixed, { other } from "./named.vibe"
import withNamespace, * as ns from "./named.vibe"
import empty, {} from "./named.vibe"
import { default as named } from "./named.vibe"
import reexported, { forwarded, forwardedOther } from "./barrel.vibe"

// expect-result: {"solo":"solo#","mixed":"mixed#","other":"other?","withNamespace":"namespace#","namespace":"ns?","namespaceDefault":"ns-default#","empty":"empty#","named":"named#","reexported":"reexported#","forwarded":"forwarded#","forwardedOther":"forwarded?"}
export function main() {
  const a: string = solo("solo")
  const b: string = mixed("mixed")
  const c: string = withNamespace("namespace")
  const d: string = empty("empty")
  const e: string = named("named")
  const f: string = reexported("reexported")
  return {
    solo: a,
    mixed: b,
    other: other("other"),
    withNamespace: c,
    namespace: ns.other("ns"),
    namespaceDefault: ns.default("ns-default"),
    empty: d,
    named: e,
    reexported: f,
    forwarded: forwarded("forwarded"),
    forwardedOther: forwardedOther("forwarded")
  }
}
