// S5-1 delegates returned Prompt subtypes. A sync hatch keeps each Prompt as data.
import { Prompt } from "effect/cli"

// The written contract: a program whose success is a Prompt.
export const plainBody = effect (pick: boolean): Effect.Effect<Prompt.Prompt<string>, never, never> => {
  if (pick) return try sync(() => Prompt.succeed(""))
  return try sync(() => Prompt.succeed("x"))
}

// Same contract, with an additional Effect operation: emitted as declared.
export const effectBody = effect (pick: boolean): Effect.Effect<Prompt.Prompt<string>, never, never> => {
  const n = try Effect.succeed(1)
  if (pick) return try sync(() => Prompt.succeed(""))
  return try sync((n: number) => Prompt.succeed(`x${n}`), n)
}

export const noOperation = effect (): Effect.Effect<number, never, never> => { return 42 }
