// expect: EK2103 EK2103 EK2103
// The body of service Name: Type holds only static members (D281): the
// shape is the type, so an instance member is EK2103, with or without a body.
interface SearchApi {
  find(query: string): string!!
}

export service Search: SearchApi {
  find(query: string): string!!
  effect describe() {
    return "search"
  }
  region = "eu"
  static readonly label = "search"
}
