// expect: EK0902 EK0902 EK0902 EK0902
// The body of service Name: Type admits only key and defaultValue (VIP-9): the
// shape is the type, so another member is EK0902, with or without a body.
interface SearchApi {
  find(query: string): string!!
}

export service Search: SearchApi {
  find(query: string): string!!
  effect describe() {
    return "search"
  }
  region = "eu"
  static readonly label = "search"
}
