// expect: EK4405
// A hatch's TypeScript is self-contained (D229): it may use its own
// parameters and locals, globals, imports, and the file's error declarations,
// but no other binding of the .vibe file. Pass a value as an input instead.
import { String as Str } from "effect"

error Bad { reason: string }

type Label = string

const prefix = "item-"

function helper() {
  return 1
}

export effect function label(text: string) {
  const suffix = "!"
  // Allowed: an import, a global, a type, an error declaration, its own names.
  const ok = try sync((value: Label) => {
    const local = Str.trim(value)
    if (local === "") throw new Bad({ reason: JSON.stringify(local) })
    return local
  }, text)
  // Not allowed: a parameter, a local, a module constant, a module function,
  // and a shorthand property.
  const a = try sync(() => text.length)
  const b = try sync(() => suffix + ok)
  const c = try sync(() => prefix + "x")
  const d = try sync(() => helper)
  const e = try sync(() => ({ suffix }))
  return [a, b, c, d, e]
}
