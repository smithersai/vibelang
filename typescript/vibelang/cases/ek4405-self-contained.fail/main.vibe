// expect-result: [4,"!text","item-x","function",{"suffix":"!"}]
// VIP-6: wrapper arrows capture module bindings, parameters and locals.
import { String as Str } from "effect"

error Bad { reason: string }

type Label = string

const prefix = "item-"

function helper() {
  return 1
}

export effect function label(text: string) {
  const suffix = "!"
  // Allowed: an import, a global, a type, an error declaration, its own names.
  const ok = try sync((value: Label) => {
    const local = Str.trim(value)
    if (local === "") return new Bad({ reason: JSON.stringify(local) }).reason
    return local
  }, text)
  // Captures: a parameter, a local, a module constant, a module function,
  // and a shorthand property.
  const a = try sync(() => text.length)
  const b = try sync(() => suffix + ok)
  const c = try sync(() => prefix + "x")
  const d = try sync(() => helper)
  const e = try sync(() => ({ suffix }))
  return [a, b, c, typeof d, e]
}

export effect function main() { return try label("text") }
