{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "out"
  },
  "vibe": { "severities": { "EK4833": "off", "EK4856": "off" } },
  "include": ["*.vibe", "*.ts"]
}
