// expect: EK1801
export effect function main() { return try.all { x: Effect.succeed(1) } }

export effect function numbers() { return try.all [1, 2] }
export effect function functions() { return try.all [() => 1] }
export effect function functionArray(xs: ReadonlyArray<() => number>) { return try.all xs }
export effect function effectFunctionArray(xs: ReadonlyArray<() => Effect.Effect<number>>) { return try.all xs }

