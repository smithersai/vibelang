import { Config, Console, Effect } from "effect"
import { findName } from "./users.js"

// Pure: no call runs an Effect, so it stays a plain JavaScript function
// that Array.prototype.map can call.
function double(n: number): number {
  return n * 2
}

// Console.log returns an Effect, so calling it runs it, and greet becomes
// an Effect itself.
function greet(name: string) {
  try Console.log(`hello, ${name}`)
  return name.length
}

// An arrow function that runs an Effect becomes one too. Its body is a single
// call, so it returns that call's Effect, suspended until it runs, without a
// generator.
const shout = (text: string) => Console.log(text.toUpperCase())

export function main() {
  for (const id of [0, 1]) {
    const length = try greet(`user ${id}`) // a .vibe Effect: runs
    try Console.log(`greeted with ${length} letters`)
  }
  try shout("calls run in order")
  const total = try greet("a") + try greet("bc") // operands run left to right
  try Console.log(`total ${total}`)
  try Console.log(`doubled: ${[1, 2, 3].map(double).join(", ")}`) // plain calls stay plain
  // Config extends Effect, but only Effect itself runs: a Config is data (design D24).
  const port = Config.Port("PORT")
  try Console.log(`config is data: ${Config.isConfig(port)}`)
  // findName returns Effect<string>, so the call runs it and name is a string.
  const name = try findName(2)
  try Console.log(`found ${name.toUpperCase()}`)
}
