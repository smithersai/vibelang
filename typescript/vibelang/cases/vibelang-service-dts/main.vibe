// A service's declaration file is an interface for the identifier, which
// extends the shape and the runtime's brand for the key, merged with a class
// whose static side is a Context key and a namespace that holds the shape
// (D361), so TypeScript code uses a .vibe service as it uses a
// Context.Service class. consumer/main.ts implements Users.Shape, provides it
// with Layer.succeed, and yields Users and Flags in Effect.gen; run.mjs
// compiles and runs it.
import { Effect, Layer } from "effect"

export interface User {
  id: string
  name: string
}

export abstract class Users {
  abstract find(id: string): Effect.Effect<User, never, never>
  abstract readonly source: string

  static readonly layer = Layer.succeed(Users, {
    find: effect (id: string) => try Effect.succeed({ id, name: "Ada" }),
    source: "memory"
  })
}

export abstract class Flags {
  abstract readonly beta: boolean
  static readonly default: Flags.Shape = { beta: true }
}

export effect function greet(id: string) {
  const user = try Users.find(id)
  return `${user.name} via ${(try Users()).source}, beta ${(try Flags()).beta}`
}
