import { isResolved, accepts, type News } from "./foreign.ts"
export effect function read(news: unknown): string!! {
  if (try Effect.orDie(Effect.try({ try: () => accepts(news), catch: (e) => e }))) {
    return "accepted"
  }
  return "rejected"
}
export effect function main() { return try read(undefined) }
