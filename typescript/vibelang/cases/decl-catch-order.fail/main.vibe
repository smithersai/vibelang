// expect: EK2106
error Busy
error Offline

export effect function attempt(flag: boolean) {
  try {
    if (flag) throw new Busy()
    throw new Offline()
  } catch (e) {
    return "any"
  } catch (e: Busy) {
    return "busy"
  }
}

