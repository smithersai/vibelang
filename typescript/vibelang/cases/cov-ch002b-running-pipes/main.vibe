// Chapter 002: Hack topic identity, native precedence, chains, scopes, XOR and modulo; docs/design/src/002-running.md#827ed216503a8ad3
import { Effect, pipe } from "effect"
export effect function main(): unknown!! {
 let evaluations = 0
 const object = { n: 7 }
 function input() { evaluations++; return object }
 const same = input() |> % === object && %.n === 7
 const one = 1 |> % + 1
 const chain = 1 |> % + 1 |> % * 2
 const nested = 1 |> (% + 1 |> % * 2)
 const branch = true ? 1 : 2 |> % + 10
 const entire = (true ? 1 : 2) |> % + 10
 const identity = 7 |> %
 const xor = 1 ^ 3
 let assigned = 1; assigned ^= 3
 const modulo = 7 |> % % 4
 const test = (1 |> %) ? 1 : 2
 const body = 1 |> (% ? 1 : 2)
 const piped = pipe(2, n => n + 1)
 return [one,chain,nested,branch,entire,identity,same,xor,assigned,modulo,evaluations,test,body,piped]
}
