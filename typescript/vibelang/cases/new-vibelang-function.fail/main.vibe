// expect: TS7009 TS2554
// VIP-1 delegates new on functions to TypeScript, including casts and @ts-ignore.
module legacy {
  export function Point(this: { x: number }, x: number) {
    this.x = x
  }
}
import { Point } from legacy

function make() {
  return 1
}

const build = effect (n: number) => n

class Box {
  constructor(readonly n: number) {}
}

export function main() {
  const a = new make()
  const b = new (make as any)()
  // @ts-ignore
  const c = new build(1)
  const d = new make(make(2))
  const e = new Box(1)
  const f = new (Point as any)(2)
  return [a, b, c, d, e.n, f.x]
}
