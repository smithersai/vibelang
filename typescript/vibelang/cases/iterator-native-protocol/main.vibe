import { events, values, reference } from "./helper.js"

function boom(): number!string! { throw "boom" }
function choose(): number!! { try sync(() => {}); return 7 }

function nested() {
  try {
    const { items: [[n = try boom()]] } = { items: values("outer", [values("inner", [undefined])]) }
    events.push("unreachable:" + n)
  } catch { events.push("caught") }
  return events.splice(0)
}

function loopTarget() {
  let target = [0]
  try { for (target[try boom()] of values("loop-target", [1])) events.push("unreachable") }
  catch { events.push("caught") }
  return events.splice(0)
}

function target() {
  let target = [0]
  try { [target[try boom()]] = values("target", [1]); events.push("unreachable") }
  catch { events.push("caught") }
  return events.splice(0)
}

function restTarget() {
  let target: number[][] = []
  try { [...target[try boom()]] = values("rest", [1, 2]); events.push("unreachable") }
  catch { events.push("caught") }
  return events.splice(0)
}

function elision() {
  const [, n = try choose(), ...rest] = values("elision", [1, undefined, 3, 4])
  events.push(String(n) + ":" + rest.join(","))
  return events.splice(0)
}

function captures() {
  const input: [number | undefined, (() => number) | undefined, ...number[]] = [undefined, undefined, 3, 4]
  let [n = try choose(), read = () => n, ...rest] = input
  n++
  return [read(), rest]
}

class Reader {
  prefix = 10
  read(arg: number) {
    const [n = try choose()] = values("method", [undefined])
    return n + this.prefix + arguments[0]
  }
}

function* producer() {
  const [n = try choose()] = values("producer", [undefined])
  yield n
}

function recursive(depth: number): number!! {
  const [n = try choose()] = values("recursive", [undefined])
  return depth === 0 ? n : try recursive(depth - 1)
}

// expect-result: {"same":true,"capture":[8,[3,4]],"method":19,"arrow":7,"byName":7,"producer":[7],"recursive":7}
export function main() {
  const expected = reference()
  const actual = [try nested(), try loopTarget(), try target(), try restTarget(), try elision()]
  const same = JSON.stringify(actual) === JSON.stringify(expected)
  const capture = try captures()
  const method = try new Reader().read(2)
  const arrow = try (() => { const [n = try choose()] = values("arrow", [undefined]); return n })()
  const byName = try retry(() => { const [n = try choose()] = values("byName", [undefined]); return n }, { times: 0 })
  const produced: number[] = []
  for (const n of producer()) produced.push(n)
  const recursion = try recursive(1)
  return { same, capture, method, arrow, byName, producer: produced, recursive: recursion }
}
