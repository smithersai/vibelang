// A parameter that accepts a function or an Effect (design D39): a lambda
// whose return annotation is a contract is a function, and healthyProgram, a
// lambda without parameters whose variable annotation is a contract, is a
// program (L1).
import { route } from "./helpers.ts"

effect function health() {
  try Effect.sleep("1 millis")
  return "healthy"
}

const healthyProgram: string!! = effect { return try health() }

// expect-result: {"withParameter":"function: got req","pausing":"program: healthy","plain":"function: static"}
export effect function main() {
  return {
    withParameter: try route(effect (request): string!! => `got ${request}`),
    pausing: try route(healthyProgram),
    plain: try route(effect (): string!! => "static")
  }
}
