// expect-result: {"values":[1,3,4,5,6],"order":["scope","work"],"detached":7,"scoped":8}
import { Deferred, Effect, Scope } from "effect"
export effect function main() {
  const scope = try Scope.make()
  const order: string[] = []
  const ownedBy = () => { order.push("scope"); return scope }
  const work = () => { order.push("work"); return Effect.succeed(0) }
  join (fork.in(ownedBy()) work())

  const a = fork.in(scope) Effect.succeed(1)
  const c = fork.detached effect { return 3 }
  const d = fork . in (scope) Effect.succeed(4)
  const e = fork
    .detached Effect.succeed(5)
  const f = fork
    .
    in(try Effect.succeed(scope)) Effect.succeed(6)

  const done = try Deferred.make<number>()
  try effect { fork.detached Deferred.succeed(done, 7) }
  const scoped = try Effect.scoped(effect {
    const child = fork.scoped Effect.succeed(8)
    return join child
  })
  return {
    values: [join a, join c, join d, join e, join f],
    order,
    detached: try Deferred.await(done),
    scoped
  }
}
