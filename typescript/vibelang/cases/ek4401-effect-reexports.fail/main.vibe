// expect: EK0403
// VIP-4: a re-export grants no thrown-type contract. @effect/vitest
// re-exports vitest, so its assert and expect are vitest's declarations,
// which carry no @throws: each call, and each call of a method on what one
// returned, throws unknown, as the same functions imported from vitest do,
// and as the program's own method on a value Option.getOrThrow returned does.
import { Option } from "effect"
import { assert, expect } from "@effect/vitest"
import * as EffectVitest from "@effect/vitest"
import { expect as vitestExpect } from "vitest"
import type { Account } from "./account.ts"

export effect function reexported(n: number) {
  try Effect.sleep("1 millis")
  assert.strictEqual(n, 1)
  expect(n).toBe(1)
  EffectVitest.assert.isTrue(n > 0)
  return n
}

export effect function direct(n: number, account: Option.Option<Account>) {
  try Effect.sleep("1 millis")
  vitestExpect(n).toBe(1)
  Option.getOrThrow(account).close()
  return n
}
