// expect: TS2322
// A service of shape string is its own requirement: providing another
// service of the same shape leaves it unprovided (D93, D281).
service Primary: string
service Replica: string

effect function read() {
  return try Primary
}

export const program: string!! = Effect.provide(read(), Layer.succeed(Replica, "replica"))

// Spec rule: docs/design/src/005-services.md#373bba7eb9c687a5
// Chapter 005: same-shaped service keys remain distinct identifiers in R (decl-service-type-distinct.fail).
