// expect: TS2362 TS2365
declare const x: unknown
const subtract = (x as number!!) - 1
const product = x as number!! * 2
const comparison = x as number!! < 3
const chosen = x as number!! ? 1 : 2
const negative = x as number!! - 1
export {}

