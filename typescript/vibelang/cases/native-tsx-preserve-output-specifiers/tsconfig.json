{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "out"
  },
  "vibe": {
    "effectGlobals": false,
    "effectModules": false
  },
  "include": [
    "*.vibe",
    "*.tsx"
  ]
}
