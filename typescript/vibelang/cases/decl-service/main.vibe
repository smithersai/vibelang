// expect-result: {"name":"Ada","missing":"No user 7","region":"eu","approved":"released v1"}
error UserNotFound { id: string }

export service Users {
  find(id: string): string!UserNotFound
  readonly region: string

  static readonly layer = Layer.succeed(Users, {
    find: effect (id: string) => {
      if (id === "42") return "Ada"
      throw new UserNotFound({ id })
    },
    region: "eu"
  })
}

export control Approval {
  approve(request: string): boolean!!
}

effect function release(version: string) {
  if (!try Approval.approve(`deploy ${version}`)) return "declined"
  return `released ${version}`
}

effect function greet(id: string) {
  try {
    return try Users.find(id)
  } catch (error) {
    return `No user ${error.id}`
  }
}

export effect function main() {
  const approved = try handle(effect { return try release("v1") }, Approval, {
    effect approve(_request, continuation) {
      return try resume(continuation, true)
    }
  })
  return try Effect.provide(effect { return ({ name: try greet("42"), missing: try greet("7"), region: (try Users()).region, approved }) }, Users.layer)
}
