
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"name":"Ada","missing":"No user 7","region":"eu","approved":"released v1"}
error UserNotFound { id: string }

export service Users {
  find(id: string): string!UserNotFound
  readonly region: string

}

export const UsersLive = Layer.succeed(Users, {
  find: effect (id: string) => {
    if (id === "42") return "Ada"
    throw new UserNotFound({ id })
  },
  region: "eu"
})

export service Approval {
  approve(request: string): boolean!!
}

effect function release(version: string) {
  if (!try (try Approval).approve(`deploy ${version}`)) return "declined"
  return `released ${version}`
}

effect function greet(id: string) {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: try (try Users).find(id) };
  }, effect (error) => {
    return { kind: "return:" as const, value: `No user ${error.id}` };
  });
return $nativeTryCompletion.value;
}
}

export effect function main() {
  const approved = try Effect.provideService(release("v1"), Approval, { effect approve(_request: string) { return true } })
  return try Effect.provide(effect { return ({ name: try greet("42"), missing: try greet("7"), region: (try Users).region, approved }) }, UsersLive)
}
