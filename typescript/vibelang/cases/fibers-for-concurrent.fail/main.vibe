// expect: EK1903 EK1904
export effect function leaves() {
  for concurrent (const n of [1, 2]) {
    if (n === 1) break
  }
}

export effect function returns() {
  for concurrent (const n of [1, 2]) {
    if (n === 2) return
  }
}

