// expect: EK4801
// A statement that names a program without calling it runs nothing: the
// program went on past `interrupt` and exited 0. Data stays data (D24), so
// a Config, a call that returns a function, and a function that needs
// arguments stay quiet.
effect function work() {
  try Console.log("work")
}

effect function greet(name: string) {
  try Console.log(name)
}

const Port = Config.Number("PORT")

function unsubscribe(): () => void!! {
  return effect () => try Console.log("unsubscribed")
}

export effect function main() {
  try Console.log("before")
  interrupt
  work
  yieldNow
  Console.log
  greet
  Port
  unsubscribe()
  try Console.log("after interrupt")
}
