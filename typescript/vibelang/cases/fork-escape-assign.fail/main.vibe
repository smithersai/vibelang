// expect: EK4838
// A fiber assigned to a binding or property declared outside the region
// that owns it outlives that region, which interrupts it on exit (D409).
function heartbeat() {
  try sleep("1 minute")
}

interface Monitor {
  mutable fiber: Fiber<void> | undefined
}

let current: Fiber<void> | undefined

export function global() {
  current = fork heartbeat()
}

export function property(monitor: Monitor) {
  monitor.fiber = fork heartbeat()
}

// Each iteration of a loop body is a region; last is declared outside it.
export function lastOfLoop() {
  let last: Fiber<void> | undefined
  for (const n of [1, 2]) {
    last = fork heartbeat()
  }
  return "loop"
}

export function throughBinding(monitor: Monitor) {
  const fiber = fork heartbeat()
  monitor.fiber = fiber
}

// Only a const or let of the region may hold the fiber.
export function inVar() {
  var fiber = fork heartbeat()
  try Fiber.interrupt(fiber)
}

export class Worker {
  fiber: Fiber<void> | undefined = undefined

  start() {
    this.fiber = fork heartbeat()
  }
}
