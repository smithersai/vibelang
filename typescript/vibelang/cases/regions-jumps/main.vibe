import * as $nativeTryEffect1 from "effect/Effect";

import * as $nativeTryEffect from "effect/Effect";
// try, catch, and finally in an Effect function compile to regions: closures
// whose return, break, and continue leave them as completion records that the
// enclosing generator dispatches. The results and the finally order are
// JavaScript's.

error Boom { n: number }

const events: string[] = []

effect function risky(n: number) {
  if (n % 3 === 0) throw new Boom({ n })
  return n
}

// Labeled break and continue, an unlabeled continue, and a return from catch.
effect function loop(stopAt: number) {
  let total = 0
  outer: for (let i = 1; i <= 10; i++) {
    for (let j = 0; j < 2; j++) {
      { const $nativeTryCompletion = try $nativeTryEffect.onExit($nativeTryEffect.catch(effect {
        if (i === stopAt) return { kind: "break:outer" as const };
        if (j === 1) return { kind: "continue:outer" as const };
        if (i % 2 === 0) return { kind: "continue:" as const };
        total += try risky(i)
      
;return { kind: "normal" } as const;
}, effect (e) => {
        events.push(`caught ${e.n}`)
        if (e.n === 9) return { kind: "return:" as const, value: -total };
      
;return { kind: "normal" } as const;
}), () => effect {
        events.push(`finally ${i}.${j}`)
      });
if ($nativeTryCompletion.kind === "break:outer") break outer;
if ($nativeTryCompletion.kind === "continue:outer") continue outer;
if ($nativeTryCompletion.kind === "continue:") continue;
if ($nativeTryCompletion.kind === "return:") return $nativeTryCompletion.value;
}
    }
  }
  return total
}

// A return inside a region inside a catch leaves both regions.
effect function nested(n: number) {
  { const $nativeTryCompletion2 = try $nativeTryEffect2.onExit($nativeTryEffect2.catch(effect {
    return { kind: "return:" as const, value: try risky(n) };
  }, effect (e) => {
    { const $nativeTryCompletion1 = try $nativeTryEffect1.onExit($nativeTryEffect1.catch(effect {
      return { kind: "return:" as const, value: try risky(e.n * 3) };
    }, effect () => {
      events.push("inner catch")
      return { kind: "return:" as const, value: -1 };
    }), () => effect {
      events.push("inner finally")
    });
return { kind: "return:" as const, value: $nativeTryCompletion1.value };
}
  }), () => effect {
    events.push("outer finally")
  });
return $nativeTryCompletion2.value;
}
}

// break out of a labeled try, a destructured catch binding, a try as the body
// of an if, and a switch inside a region.
effect function shapes(flag: boolean) {
  let out = ""
  block: { const $nativeTryCompletion3 = try $nativeTryEffect3.catch(effect {
    try risky(9)
  
;return { kind: "normal" } as const;
}, effect ($nativeTryError) => {
let { n } = $nativeTryError;

    out += `caught ${n};`
    if (flag) return { kind: "break:block" as const };
    out += "not broken;"
  
;return { kind: "normal" } as const;
});
if ($nativeTryCompletion3.kind === "break:block") break block;
}
  if (flag) { const $nativeTryCompletion4 = try $nativeTryEffect4.catch(effect { try risky(3) 
;return { kind: "normal" } as const;
}, effect () => { out += "embedded;" 
;return { kind: "normal" } as const;
});

}
  { const $nativeTryCompletion5 = try $nativeTryEffect5.onExit(effect {
    switch (try risky(4)) {
      case 4:
        out += "four;"
        break
      default:
        out += "other;"
    }
  
;return { kind: "normal" } as const;
}, () => effect {
    out += "switched"
  });

}
  return out
}

// Explicit outer bindings retain values after the region.
effect function hoisted() {
  let first: number | undefined
  let i: number | undefined
  { const $nativeTryCompletion6 = try $nativeTryEffect6.onExit(effect {
    first = try risky(1)
    for (i = 0; i < 2; i++) first += i
  
;return { kind: "normal" } as const;
}, () => effect {
    events.push("hoisted")
  });

}
  return `${first} ${i}`
}

// A region's closure sees the method's this.
const counter = {
  count: 0,
  effect bump(n: number): number!! {
    { const $nativeTryCompletion7 = try $nativeTryEffect7.onExit($nativeTryEffect7.catch(effect {
      this.count += try risky(n)
    
;return { kind: "normal" } as const;
}, effect (e) => {
      this.count -= 100
    
;return { kind: "normal" } as const;
}), () => effect {
      this.count += 1000
    });

}
    return this.count
  }
}

// expect-result: {"this":[1001,1901],"stop8":13,"stop11":-13,"nested":[1,-1],"shapes":["caught 9;embedded;four;switched","caught 9;not broken;four;switched"],"hoisted":"2 2","events":["finally 1.0","finally 1.1","finally 2.0","finally 2.1","caught 3","finally 3.0","finally 3.1","finally 4.0","finally 4.1","finally 5.0","finally 5.1","finally 6.0","finally 6.1","finally 7.0","finally 7.1","finally 8.0","finally 1.0","finally 1.1","finally 2.0","finally 2.1","caught 3","finally 3.0","finally 3.1","finally 4.0","finally 4.1","finally 5.0","finally 5.1","finally 6.0","finally 6.1","finally 7.0","finally 7.1","finally 8.0","finally 8.1","caught 9","finally 9.0","outer finally","inner catch","inner finally","outer finally","hoisted"]}
export effect function main() {
  const stop8 = try loop(8)
  const stop11 = try loop(11)
  const nestedResults = [try nested(1), try nested(3)]
  const bumps = [try counter.bump(1), try counter.bump(3)]
  return { this: bumps, stop8, stop11, nested: nestedResults, shapes: [try shapes(true), try shapes(false)], hoisted: try hoisted(), events }
}
