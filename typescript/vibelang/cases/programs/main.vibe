// A lambda with no parameters where Effect expects an Effect is a program
// (design D7): Effect's combinators get a program they can run again,
// race, time out, or provide, and nothing runs until they do.
import { Context, Effect, Layer, Schedule } from "effect"

class Greeter extends Context.Service<Greeter, { readonly greet: (name: string) => Effect.Effect<string> }>()("Greeter") {}

let attempts = 0

effect function flaky() {
  attempts++
  if (attempts < 3) try Effect.fail("not yet")
  return `ok after ${attempts}`
}

effect function slow(label: string) {
  try Effect.sleep("200 millis")
  return label
}

effect function fast(label: string) {
  try Effect.sleep("1 millis")
  return label
}

effect function retried() {
  return try Effect.retry(effect { return try flaky() }, Schedule.recurs(5))
}

effect function raced() {
  return try Effect.race(effect { return try slow("slow") }, effect { return try fast("fast") })
}

effect function timedOut() {
  return try Effect.catch(effect { return try Effect.timeout(effect { return try slow("slow") }, "5 millis") }, effect (e) => e._tag)
}

// An array and a record of programs where Effect.all expects Effects.
effect function both() {
  const list = try Effect.all([effect { return try fast("a") }, effect { return try fast("b") }])
  const record = try Effect.all({ c: effect { return try fast("c") }, d: effect { return try fast("d") } })
  return `${list.join("")}${record.c}${record.d}`
}

// A lambda stored in a variable is an Effect function: calling it runs it,
// from scratch, each time.
effect function stored() {
  let runs = 0
  const job = effect (): string!! => {
    runs++
    return try fast(`run ${runs}`)
  }
  const first = try job()
  const second = try job()
  return `${first}, ${second}`
}

// An Effect function nested in another, each decided by its own position.
effect function grid(xs: ReadonlyArray<number>, ys: ReadonlyArray<number>) {
  return (try Effect.forEach(xs, effect (x) => (try Effect.forEach(ys, effect (y) => try fast(`${x}${y}`))).join(" "))).join(" | ")
}

// The object literal's property is expected to be a function returning an
// Effect, through Layer.succeed's NoInfer<S>: the lambda is an Effect function.
const GreeterLive = Layer.succeed(Greeter, {
  greet: effect (name) => `hello ${name}`
})

effect function greeted() {
  return try Effect.flatMap(Greeter, effect (greeter) => try greeter.greet("ada"))
}

// expect-result: {"retried":"ok after 3","raced":"fast","timedOut":"TimeoutError","both":"abcd","stored":"run 1, run 2","grid":"13 14 | 23 24","greeted":"hello ada"}
export effect function main() {
  return {
    retried: try retried(),
    raced: try raced(),
    timedOut: try timedOut(),
    both: try both(),
    stored: try stored(),
    grid: try grid([1, 2], [3, 4]),
    greeted: try Effect.provide(effect { return try greeted() }, GreeterLive)
  }
}
