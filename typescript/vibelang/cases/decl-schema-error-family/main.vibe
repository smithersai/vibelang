// expect-result: {"encoded":{"_tag":"NotStored","key":"a","attempts":2},"decoded":"not stored after 2","evicted":{"_tag":"Evicted","key":"b","at":3,"by":"lru"},"throughExpired":{"_tag":"Evicted","key":"b","at":3,"by":"lru"},"decodedEvicted":["Evicted",true],"base":{"_tag":"StoreError","key":"s"},"decodedBase":["StoreError",false],"subclass":[false,{"_tag":"NotStored","key":"a","attempts":2}],"abstract":{"_tag":"OverQuota","limit":1,"used":2},"envelope":{"id":"e","error":{"_tag":"Late","key":"l"}},"unknownTag":true,"caught":"NotStored","json":{"_tag":"NotStored","key":"a","attempts":2}}
// D304: a value of a family base's type may be any of its subclasses, so the
// base's schema encodes and decodes each of them, as well as its own instances.




import { $schemaErrorFamily } from "vibelang-runtime"

import { $schemaErrorMember } from "vibelang-runtime"

import { $schemaErrorFamily as $ErrorSchemaFamily } from "vibelang-runtime"

export class StoreError extends Schema.TaggedError<StoreError>()("StoreError" as string, {
    key: Schema.String,
}) {
  static {
    $ErrorSchemaFamily(this);
  }
}

export class NotStored extends StoreError.extend<NotStored>("NotStored")({
    _tag: Schema.tag("NotStored"),
    attempts: Schema.Number,
    /** An intermediate base widens its own tag for its subclasses. */
}) {
static {
    $schemaErrorMatcher(this, "NotStored");
    $schemaErrorMember(this);
}


  describe(): string {
    return `not stored after ${this.attempts}`
  }
}

/** An intermediate base widens its own tag for its subclasses. */
export class Expired extends StoreError.extend<Expired>("Expired")({
    _tag: Schema.tag("Expired" as string),
    at: Schema.Number,
}) {
static {
    $schemaErrorMatcher(this, "Expired");
    $schemaErrorFamily(this);
}
}

export class Evicted extends Expired.extend<Evicted>("Evicted")({
    _tag: Schema.tag("Evicted"), by: Schema.String,
    /** An abstract base has a family's tag type without a _tag field. */
}) {
static {
    $schemaErrorMatcher(this, "Evicted");
    $schemaErrorMember(this);
}
}

/** An abstract base has a family's tag type without a _tag field. */
export abstract schema error Quota { limit: number }

export class OverQuota extends Quota.extend<OverQuota>("OverQuota")({
    _tag: Schema.tag("OverQuota"), used: Schema.Number,
    /** A schema built from the base before a subclass is declared lists it too. */
}) {
static {
    $schemaErrorMatcher(this, "OverQuota");
    $schemaErrorMember(this);
}
}

/** A schema built from the base before a subclass is declared lists it too. */
schema Envelope { readonly id: string; readonly error: StoreError }

export class Late extends StoreError
    .extend<Late>("Late")({
    _tag: Schema.tag("Late")
}) {
static {
    $schemaErrorMatcher(this, "Late");
    $schemaErrorMember(this);
}
}

effect function fail(error: StoreError): never!StoreError {
  throw error
}

function describe(value: StoreError): string {
  return match (value) {
    when NotStored(let error): error.describe();
    default: value._tag;
  }
}

export effect function main() {
  const notStored = new NotStored({ key: "a", attempts: 2 })
  const evicted = new Evicted({ key: "b", at: 3, by: "lru" })
  const encode = Schema.encodeSync(StoreError)
  const decode = Schema.decodeUnknownSync(StoreError)
  const decodedEvicted = decode({ _tag: "Evicted", key: "c", at: 4, by: "ttl" })
  const decodedBase = decode({ _tag: "StoreError", key: "s" })
  return {
    encoded: encode(notStored),
    decoded: describe(decode(encode(notStored))),
    evicted: encode(evicted),
    throughExpired: Schema.encodeSync(Expired)(evicted),
    decodedEvicted: [decodedEvicted._tag, decodedEvicted instanceof Evicted],
    base: encode(new StoreError({ key: "s" })),
    decodedBase: [decodedBase._tag, decodedBase instanceof NotStored],
    subclass: [Schema.is(NotStored)(new StoreError({ key: "s" })), Schema.encodeSync(NotStored)(notStored)],
    abstract: Schema.encodeSync(Quota)(new OverQuota({ limit: 1, used: 2 })),
    envelope: Schema.encodeSync(Envelope)({ id: "e", error: new Late({ key: "l" }) }),
    unknownTag: Option.isNone(Schema.decodeUnknownOption(StoreError)({ _tag: "Unknown", key: "x" })),
    caught: fail(notStored) catch (e) => encode(e)._tag,
    json: Schema.encodeSync(Schema.toCodecJson(StoreError))(notStored)
  }
}
