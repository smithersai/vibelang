// expect: EK0801
// Appendix B: EK0801 — spec-rule: docs/design/src/900-appendices.md#15024e67333072eb
// Promote this configurable warning to an error so the rejection harness checks its trigger.
declare const resource: Disposable
export effect function load() { using r = resource; return 1 }

// Chapter 900: Appendix B EK0801 using in effect code warning — spec-rule: docs/design/src/900-appendices.md#0cbfacbce69e50d1

// Manual forms retain their compiler contracts without automatic repairs.
// rule-evidence: docs/design/src/008-runtime.md#runtime-guarantees | `using` in effect code gets a warning (`EK0801`), with a manual change to `acquireDisposable` inside `scoped`; the warning does not change disposal semantics.

export function plainDisposal() { using retained = resource; return 1 }
