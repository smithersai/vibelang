// expect: EK1013
// Error, schema, schema error, service, and control declarations use
// ; or a new line between fields (D278, D128). A comma reports EK1013.
// The schema at the end is a declaration body; TypeScript object types
// nested in a schema still allow commas.

error OutOfStock { sku: string, available: number }

abstract error Missing {
  path: string,
  reason: string,
}

error Gone extends Missing { since: number, by: string }

schema error Rejected { sku: string, reason: string }

service Stock {
  region: string,
  count(sku: string): number!!
}

control Ask {
  limit: number,
  ask(): number!!
}

schema Item { sku: string, available: number }
