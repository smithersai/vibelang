// expect: EK1013
// Root error payload fields below admit shared comma separators. Other
// declaration/class punctuation retains its existing EK1013 diagnostic.

error OutOfStock { sku: string, available: number }

abstract error Missing {
  path: string,
  reason: string,
}

error Gone extends Missing { since: number, by: string }

schema error Rejected { sku: string, reason: string }

service Stock {
  region: string,
  count(sku: string): number!!
}

control Ask {
  limit: number,
  ask(): number!!
}

schema Item { sku: string, available: number }
