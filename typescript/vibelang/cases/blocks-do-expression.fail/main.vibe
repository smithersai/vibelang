// expect: EK0201 EK0201 EK0201 EK0201 EK0205 EK0203
// TC39's early errors for do expressions (VIP-2).
function noElse(n: number) {
  return do {
    if (n > 1) {
      "big"
    }
  }
}

function endsInDeclaration() {
  return do {
    const a = 1
  }
}

function endsInLoop() {
  return do { while (false) {} }
}

function endsInLabeledDeclaration() {
  return do { done: { let x = 1; break done } }
}

function jumpInLoopHead(xs: number[][]) {
  for (const x of do { if (xs.length === 0) { break } xs }) {}
  return 0
}

function varInParameter(x = do { var y = 1; y }) {
  return x
}

export function main() {
  return [noElse(2), endsInDeclaration(), endsInLoop(), endsInLabeledDeclaration(), jumpInLoopHead([]), varInParameter()]
}

