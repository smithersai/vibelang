// expect-result: {"all":["user 1",3],"record":{"user":"user 2","count":3},"held":["user 3",3],"failFast":"Boom","settled":["Success","Failure"],"race":"fast","raceFailure":"Boom","raceBlocks":"got user 4","any":"fast","deferred":"ready","tie":"a","raceDo":"got user 5","templates":["user 6!",3],"templateRace":"fast!"}
import { join as $tryJoinFiber } from "effect/Fiber"
import { all as $tryAllEffects } from "effect/Effect"
import { $global as $tryGlobals } from "vibelang-runtime"
import { map as $tryMapResults } from "effect/Effect"
error Boom { n: number }

effect function getUser(id: string): string!! {
  try sleep("5 millis")
  return `user ${id}`
}

effect function count(): number!! {
  try sleep("2 millis")
  return 3
}

effect function slow(): string!! {
  try sleep("1 second")
  return "slow"
}

effect function fast(): string!! {
  try sleep("1 millis")
  return "fast"
}

effect function boom(): string!Boom! {
  try sleep("1 millis")
  throw new Boom({ n: 1 })
}

// try.all starts each program in its own fiber and keeps the shape.
effect function all() {
  const [user, n] = (try.all [effect { return try getUser("1") }, effect { return try count() }])
  return [user, n]
}

effect function record() {
  return (try $tryMapResults($tryAllEffects({ user: effect { return try getUser("2") }, count: effect { return try count() } }, { concurrency: "unbounded" }), ($tryResults) => $tryGlobals.Object.fromEntries(["user","count"].map(($tryKey) => [$tryKey, $tryResults[$tryKey as keyof typeof $tryResults]])) as unknown as typeof $tryResults))
}

// A fiber already running is awaited, not restarted.
effect function held() {
  const user = fork getUser("3")
  return (try.all [$tryJoinFiber(user), effect { return try count() }])
}

// A failure interrupts the rest and propagates.
effect function failFast() {
  try {
    (try.all [effect { return try slow() }, effect { return try boom() }])
    return "no"
  } catch (e) {
    return e._tag
  }
}

// all with mode "result" never fails; each outcome is a Result.
effect function settled() {
  const outcomes = (try $tryAllEffects([effect { return try count() }, effect { return try boom() }], { concurrency: "unbounded", mode: "result" }))
  return (outcomes as ReadonlyArray<(typeof outcomes)[number]>).map((outcome) => outcome._tag)
}

// try.race: the first to finish wins, success or failure.
effect function race() {
  return (try.race [effect { return try slow() }, effect { return try fast() }])
}

effect function raceFailure() {
  try {
    return (try.race [effect { return try slow() }, effect { return try boom() }])
  } catch (e) {
    return e._tag
  }
}

effect function raceBlocks() {
  return (try.race [
    effect { return try do {
      try sleep("1 second")
      "timeout"
    } },
    effect { return try do {
      const user = try getUser("4");
      `got ${user}`
    } }
  ])
}

// try.any: the first to succeed wins.
effect function anyWins() {
  return (try.any [effect { return try boom() }, effect { return try fast() }])
}

effect function deferred() {
  const ready = try Deferred.make<string>()
  try Deferred.succeed(ready, "ready")
  return (try.race [effect { return try ready.await() }, effect { return try slow() }])
}

// Of elements ready at once, the first written wins.
effect function tie() {
  return (try.race [effect { return try Effect.succeed("a") }, effect { return try Effect.succeed("b") }])
}

// A do expression gives an element statements; it is passed by name.
effect function raceDo() {
  return (try.race [
    effect { return try do {
      try sleep("1 second")
      "timeout"
    } },
    effect { return try do {
      const user = try getUser("5")
      "got " + user
    } }
  ])
}

// An element passed by name may be any expression that runs a program.
effect function templates() {
  const [user, n] = (try.all [effect { return `${try getUser("6")}!` }, effect { return try count() }])
  return [user, n]
}

effect function templateRace() {
  return (try.race [effect { return `${try slow()}!` }, effect { return `${try fast()}!` }])
}

export effect function main() {
  return {
    all: try all(),
    record: try record(),
    held: try held(),
    failFast: try failFast(),
    settled: try settled(),
    race: try race(),
    raceFailure: try raceFailure(),
    raceBlocks: try raceBlocks(),
    any: try anyWins(),
    deferred: try deferred(),
    tie: try tie(),
    raceDo: try raceDo(),
    templates: try templates(),
    templateRace: try templateRace()
  }
}
