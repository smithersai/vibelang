// expect-result: {"written":"done","after":1,"same":3,"held":1,"withValue":2,"falls":["undefined","after"],"stops":["undefined","after"],"breaks":["undefined","after"],"continues":["undefined","undefined","after"]}
// D351 and the owner's ruling: undefined is added only for non-return completion.
control Step { next(): void!! }

// The example from Chapter 9, with the owner's corrected type for n.
function written(): number | string!! {
  try {
    try Step.next()
    try Step.next()
    return 1
  } handle Step.next() {
    const n: number | string = try resume()
    return typeof n === "number" ? n.toFixed(1) : "done"
  }
}

// A resumed clause's fallthrough adds no undefined when the try returns.
function after(): number!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    const n: number = try resume()
    n.toFixed(0)
  }
  return 0
}

// A dependent return already within H is accepted without an annotation.
function same() {
  try {
    try Step.next()
    try Step.next()
    return 1
  } handle Step.next() {
    const n = try resume()
    return n + 1
  }
}

function held() {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    const n = try resume()
    return n
  }
}

function withValue(): number!! {
  try {
    try Step.next()
    return 1
  } handle Step.next() {
    const n: number = try resumeWith(() => undefined)
    return n + 1
  }
}

// A resumed clause's normal completion preserves the block's completion.
function falls(): string[]!! {
  const seen: string[] = []
  try {
    try Step.next()
  } handle Step.next() {
    const n: string[] | undefined = try resume()
    seen.push(String(n))
  }
  seen.push("after")
  return seen
}

// A clause that does not resume can add normal completion to H.
function stops(): string[]!! {
  const seen: string[] = []
  let count = 0
  try {
    try Step.next()
    try Step.next()
    return seen
  } handle Step.next() {
    count++
    if (count === 1) {
      const n: string[] | undefined = try resume()
      seen.push(String(n))
    }
  }
  seen.push("after")
  return seen
}

function breaks(): string[]!! {
  const seen: string[] = []
  for (const round of [1, 2]) {
    try {
      try Step.next()
      break
    } handle Step.next() {
      const n: string[] | undefined = try resume()
      seen.push(String(n))
    }
  }
  seen.push("after")
  return seen
}

function continues(): string[]!! {
  const seen: string[] = []
  for (const round of [1, 2]) {
    try {
      try Step.next()
      continue
    } handle Step.next() {
      const n: string[] | undefined = try resume()
      seen.push(String(n))
    }
  }
  seen.push("after")
  return seen
}

export function main() {
  return { written: try written(), after: try after(), same: try same(), held: try held(), withValue: try withValue(), falls: try falls(), stops: try stops(), breaks: try breaks(), continues: try continues() }
}
