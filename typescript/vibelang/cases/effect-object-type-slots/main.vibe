import { Effect } from "effect"
export type ErrorOnly = number!{ readonly x: 1 }
export type Full = number!{ readonly x: 1 }!never
export type Empty = number!{}
export type Requirement = number!string!{ readonly service: number }
export type Both = number!{ readonly x: 1 }!{ readonly service: number }
export type Method = { read(): number!{ readonly x: 1 }!{ readonly service: number } }
export type Callable = () => number!{ readonly x: 1 }!{ readonly service: number }
export type OptionalRequirement = number!!({ readonly service: number })
type Same<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
type Check<T extends true> = T
export type Proof = [
 Check<Same<ErrorOnly, Effect.Effect<number, { readonly x: 1 }, never>>>,
 Check<Same<Full, Effect.Effect<number, { readonly x: 1 }, never>>>,
 Check<Same<Empty, Effect.Effect<number, {}, never>>>,
 Check<Same<Requirement, Effect.Effect<number, string, { readonly service: number }>>>,
 Check<Same<Both, Effect.Effect<number, { readonly x: 1 }, { readonly service: number }>>>,
 Check<Same<Method, { read(): Effect.Effect<number, { readonly x: 1 }, { readonly service: number }> }>>,
 Check<Same<Callable, () => Effect.Effect<number, { readonly x: 1 }, { readonly service: number }>>>,
 Check<Same<OptionalRequirement, Effect.Effect<number, never, { readonly service: number }>>>
]
export effect function legacy(): number!string! { return 1 }
export effect function legacyEmptyError(): number!! { return 2 }
export effect function main() { return [try legacy(), try legacyEmptyError()] }
