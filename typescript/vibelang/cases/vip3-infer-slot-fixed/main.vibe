// expect-result: ["Ada","Ada","Ada","Ada","Ada"]
// What vibelang --fix --fix-vip-only writes for vip3-infer-slot.fail (VIP-3, amended
// 2026-11-02): each Effect slot that was written infer now holds the type the
// checker inferred for it, and everything, whose slots were all infer, has no
// annotation. Its declaration file is the .fail case's, and it runs.
error Gone { id: string }
service Users { find(id: string): string!Gone }

const UsersLive = Layer.succeed(Users, {
  effect find(id: string) {
    if (id === "") throw new Gone({ id })
    return "Ada"
  }
})

export effect function errors(id: string): Effect.Effect<string, Gone, Users> {
  return try (try Users).find(id)
}

export effect function needs(id: string): Effect.Effect<string, Gone, Users> {
  return try (try Users).find(id)
}

export effect function value(id: string): Effect.Effect<{ name: string; }, Gone, Users> {
  return { name: try (try Users).find(id) }
}

export effect function bang(id: string): string!Gone!Users {
  return try (try Users).find(id)
}

export const everything = effect (id: string) => try (try Users).find(id)

export effect function main() {
  provide UsersLive {
    return [try errors("1"), try needs("2"), (try value("3")).name, try bang("4"), try everything("5")]
  }
}
// Chapter 007: a call whose handlers hold an - spec-rule: docs/design/src/007-tooling.md#c4f94b604fb5354e
// Chapter 900: EK1010 diagnostic - spec-rule: docs/design/src/900-appendices.md#0e765a0946d1e3ad

effect function raise<E>(error: E): never!E { throw error }

export function recover(error: Gone): Effect.Effect<string, never, never> {
  return raise(error) |> Effect.catchTag(%, "Gone", effect (caught) => caught.id)
}

export function recoverUsingUsers(program: Effect.Effect<never, Gone, never>): Effect.Effect<string, Gone, Users> {
  return Effect.catchTag(program, "Gone", effect (caught) => {
    const users = try Users
    return try users.find(caught.id)
  })
}
