// expect-result: {"concise":"Failure","passes":"Success","block":"Failure","nested":"Failure"}
// A function declared to return an Effect returns a program from either arm
// of a returned conditional, as it does from each `return` (D269). The
// concise form used to compile as a plain function whose success was the
// function literal of the first arm, so the program never ran.
import * as Effect from "effect/Effect"

type Hook = (n: number) => void!!

const concise: Hook = (n) => n > 0 ? () => die("crash") : Effect.void

const block: Hook = (n) => {
  if (n > 0) return () => die("crash")
  return Effect.void
}

const nested: Hook = (n) => n > 1 ? Effect.void : n > 0 ? () => die("crash") : Effect.void

export function main() {
  return {
    concise: (try exit(concise(1)))._tag,
    passes: (try exit(concise(0)))._tag,
    block: (try exit(block(1)))._tag,
    nested: (try exit(nested(1)))._tag
  }
}
