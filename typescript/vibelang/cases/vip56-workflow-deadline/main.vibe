// expect-result: {"fast":"ok:a","slow":"DeadlineExceeded: Workflow Slow exceeded its deadline (25 millis).","failed":"bad:b"}
// VIP-56: `static readonly deadline` bounds a workflow run durably across
// waits without delaying normal completion or typed failures.
task Work {
  effect call(id: string): string!string {
    if (id === "b") throw `bad:${id}`
    return `ok:${id}`
  }
}

export workflow Fast {
  static readonly deadline = "5 seconds"
  effect call(id: string): string!string {
    try Experimental.Durable.sleep("5 millis")
    return try Work(id)
  }
}

export workflow Slow {
  static readonly deadline = "25 millis"
  effect call(id: string): string!string {
    try Experimental.Durable.sleep("5 seconds")
    return try Work(id)
  }
}

export workflow Failing {
  static readonly deadline = "5 seconds"
  effect call(id: string): string!string {
    return try Work(id)
  }
}

export effect function main() {
  const layers = Layer.mergeAll(Fast.layer, Slow.layer, Failing.layer)
  provide Layer.provideMerge(layers, Experimental.Durable.memory) {
    const fast = try Fast("a")
    const slowExit = try Effect.exit(Slow("slow"))
    const slow = Exit.isFailure(slowExit)
      ? Cause.squash(slowExit.cause) instanceof Experimental.Durable.DeadlineExceeded
        ? "DeadlineExceeded"
        : String(Cause.squash(slowExit.cause))
      : slowExit.value
    const failed = try Failing("b").pipe(Effect.catch((e) => Effect.succeed(e)))
    return { fast, slow, failed }
  }
}
