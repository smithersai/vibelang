// expect-result: {"full":"Ada","noDependencies":1,"inferred":"Ada","neither":3,"onlyDependencies":2,"arrow":2,"find":"none","either":4,"unwrap":5}
// D309: the Effect<...> spelling stays valid beside the ! form. This is
// terse-contracts as 0.0.8's vibelang --fix rewrote it under D308, which
// still compiles and runs unchanged: infer R where a ! form on a function
// with a body left the dependencies out, and nothing elsewhere.
error NotFound { id: string }
error Timeout

service Users {
  find(id: string): Effect<string, NotFound>
  count(): Effect<number>
}

const UsersLive = Layer.succeed(Users, {
  effect find(id: string) {
    if (id !== "42") throw new NotFound({ id })
    return "Ada"
  },
  effect count() {
    return 2
  }
})

effect function full(id: string): Effect<string, NotFound, Users> {
  return try Users.find(id)
}

effect function noDependencies(n: number): Effect<number, Timeout> {
  if (n < 0) throw new Timeout()
  return n
}

effect function inferred(id: string): Effect<string, NotFound, infer R> {
  return try Users.find(id)
}

effect function neither(): Effect<number> {
  return 3
}

effect function onlyDependencies(): Effect<number, never, Users> {
  return try Users.count()
}

const arrow = effect (n: number): Effect<number, Timeout, infer R> => try noDependencies(n) + 1

type Finder = (id: string) => Effect<string, NotFound>
type Maybe = Effect<number> | undefined
type Nested = Effect<Effect<number>, NotFound>

effect function find(finder: Finder, id: string): Effect<string> {
  return finder(id) catch "none"
}

effect function either(program: Maybe): Effect<number> {
  return program === undefined ? 0 : try program()
}

const five: Effect<number> = Effect.sync(() => 5)

effect function unwrap(program: Nested): Effect<number, NotFound> {
  const inner = try program()
  return try inner()
}

export effect function main() {
  provide UsersLive {
    return {
      full: try full("42"),
      noDependencies: try noDependencies(1),
      inferred: try inferred("42"),
      neither: try neither(),
      onlyDependencies: try onlyDependencies(),
      arrow: try arrow(1),
      find: try find(effect (id) => { if (id === "7") throw new NotFound({ id }); return id }, "7"),
      either: try either(Effect.succeed(4)),
      unwrap: try unwrap(Effect.succeed(five))
    }
  }
}
