// VibeLang code compiled against the declarations alone: the error classes
// retain native source narrowing; handwritten constructor arms need a fallback.
import { Denied, NotFound, Timeout } from "../../out/main.js"

function viaVibe(e: NotFound | Timeout | Denied) {
  return match (e) {
    when NotFound: `missing ${e.id}`;
    when Timeout: `timeout ${e.ms}`;
    when Denied: `denied ${e.user}`;
    default: "outside";
  }
}

export function results() {
  return [viaVibe(new NotFound({ id: "1" })), viaVibe(new Timeout({ ms: 5 })), viaVibe(new Denied({ code: "d", user: "ada" }))]
}
