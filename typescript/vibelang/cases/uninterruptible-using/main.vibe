// expect-result: {"masked":true,"released":true,"restored":"Failure","returned":"lease"}

// An uninterruptible block that owns a using resource finishes when its fiber
// is interrupted, and releases the resource when the block ends.
effect function masked() {
  const started = try Deferred.make<void>()
  const done = try Deferred.make<string>()
  const released = try Deferred.make<boolean>()
  const fiber = fork {
    uninterruptible {
      using lease = try Effect.acquireRelease(Effect.succeed("lease"), effect () => try Deferred.succeed(released, true))
      try Deferred.succeed(started, undefined)
      try sleep("20 millis")
      try Deferred.succeed(done, lease)
    }
  }
  try started.await()
  try fiber.interrupt()
  return { masked: try Deferred.isDone(done), released: try Deferred.isDone(released) }
}

// restore inside such a block brings back the interruptibility the block began with.
effect function restored() {
  const started = try Deferred.make<string>()
  const fiber = fork {
    uninterruptible {
      using lease = try Effect.acquireRelease(Effect.succeed("lease"), effect () => Effect.void)
      restore {
        try Deferred.succeed(started, lease)
        try sleep("1 second")
      }
    }
  }
  try started.await()
  try fiber.interrupt()
  return (try exit(fiber.join()))._tag
}

// A return inside the block returns from the function, after the release.
effect function returned() {
  uninterruptible {
    using lease = try Effect.acquireRelease(Effect.succeed("lease"), effect () => Effect.void)
    return lease
  }
}

export effect function main() {
  return { ...try masked(), restored: try restored(), returned: try returned() }
}
