// expect: EK0501
// A generator method is a JavaScript generator, whose body is plain code
// (Chapter 8; VIP-1: it is not marked effect): try there, which would run an
// Effect, is EK0501. Data, plain calls, an Effect the method yields unrun, a
// program the method yields as a function, and a call yield* delegates to
// are fine.
effect function work(n: number): number!! {
  try sleep("1 millis")
  return n
}

function double(n: number): number {
  return n * 2
}

const literal = {
  *items() {
    yield try work(3)
  },
}

class Bag {
  *[Symbol.iterator]() {
    yield double(4)
    yield effect () => try work(4)
    yield try work(5)
    yield work(5)
  }

  static *all() {
    yield try work(6)
  }

  *delegated() {
    yield* [double(7)]
  }
}

export function count() {
  return [...literal.items(), ...new Bag(), ...Bag.all(), ...new Bag().delegated()].length
}
