// expect: EK4701
// A class arm counts toward exhaustiveness only for a closed class (D407,
// D428, D501): an error class, one that extends effect's YieldableError
// wherever it is declared, that declares no [Symbol.hasInstance] or
// [customMatcher] of its own. viaTs's Missing, a Data.TaggedError class of a
// .ts file, is one. An arm over Error, or over a class with its own
// membership test, removes nothing, so each match needs a default arm.
import { Missing } from "./errors.ts"

error Gone { id: string }

class Picky extends Data.TaggedError("Picky")<{
    readonly id: string;
}> {

  static [Symbol.hasInstance](value: unknown): boolean {
    return false
  }
}

export function viaTs(e: Missing | Gone) {
  return match (e) {
    when Missing: "missing";
    when Gone: "gone";
  }
}

export function viaHasInstance(e: Picky | Gone) {
  return match (e) {
    when Picky: "picky";
    when Gone: "gone";
  }
}

export function viaError(e: Gone) {
  return match (e) {
    when Error: "error";
  }
}
