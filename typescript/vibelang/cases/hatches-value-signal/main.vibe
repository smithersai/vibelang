// A hatch called as a value runs through the runtime's sync, which passes
// an async function the AbortSignal in the parameter after its inputs,
// as a direct call does (D230, D232). Interruption aborts the signal. A rest
// or defaulted parameter gets no signal. VibeLang code calls a hatch only
// under its own name (EK4410, D432), so the calls of hatches as values are
// TypeScript's, in this module, where the runtime's sync is an ordinary
// function (D330).
module foreign {
  import { sync as run } from "vibelang-runtime"

  export async function hasSignal(signal: AbortSignal) {
    return signal instanceof AbortSignal && !signal.aborted
  }
  export async function echo(value: number, signal: AbortSignal) {
    return { value, signal: signal instanceof AbortSignal }
  }
  export function untilAborted(events: string[], signal: AbortSignal): Promise<string> {
    return new Promise((resolve) => signal.addEventListener("abort", () => {
      events.push("aborted")
      resolve("aborted")
    }))
  }
  export async function count(...xs: number[]) {
    return xs.length
  }
  export async function defaulted(a: number, b: number = 5) {
    return a + b
  }
  export async function untilAbortedAsync(events: string[], signal: AbortSignal): Promise<string> {
    return untilAborted(events, signal)
  }
  export const value = () => run(hasSignal)
  export const input = () => run(echo, 42)
  export const rest = () => run(count, 1, 2)
  export const sum = () => run(defaulted, 1)
  export const waiting = (events: string[]) => run(untilAbortedAsync, events)
}
import { hasSignal, value, input, rest, sum, waiting } from foreign

// expect-result: {"direct":true,"value":true,"input":{"value":42,"signal":true},"rest":2,"defaulted":6,"timedOut":"timed out","events":["aborted"]}
export function main() {
  const events: string[] = []
  const direct = try sync(hasSignal)
  const timedOut = timeout(waiting(events), "10 millis") catch "timed out"
  return { direct, value: try value(), input: try input(), rest: try rest(), defaulted: try sum(), timedOut, events }
}
