import { Effect, Option, Exit, Result } from "effect"
export function union(s: boolean) { return match(s) { when true: 1 as const; when false: "no" as const; } }
export function narrow(s: {_tag:"A"; id:string|number}|{_tag:"B"; value:number}) {
 return match(s) { when {_tag:"A", let id} and if (typeof id === "string"): id.toUpperCase(); default: s._tag; }
}
export function boolean(s:string|number) { const yes:boolean = s is String; if(s is String) return s.length; return yes ? 0 : s * 2 }
export function both(s:{a:number;b:number}|null) { return match(s) { when {a:let a} and {b:let b}: a+b; default: 0; } }
export function option(s:Option.Option<number>) { return match(s) { when Option.Some(let n): n; when Option.None: 0; } }
export function result(s:Result.Result<number,string>) { return match(s) { when Result.Success(let n): n; when Result.Failure(let e): e.length; } }
export function exit(s:Exit.Exit<number,string>) { return match(s) { when Exit.Success(let n): n; when Exit.Failure(let c): c.reasons.length; } }
