// A function whose body is a single result returns its Effect without a
// generator (D274): Effect.suspend for a program, Effect.sync for a value,
// Effect.void for an empty body. The body runs each time the Effect runs and
// never when the function is called, and a throw in it is a defect.
// A program result.
export effect function step(n: number) {
  return try Effect.succeed(n + 1)
}

// A program result whose argument records each time the body runs.
export effect function record(runs: string[], n: number) {
  return try Effect.succeed((runs.push("record"), n))
}

// An empty body.
export const ignore = (event: string): Effect<void, never, never> => {}

// A value beside a program becomes Effect.succeed(value).
export const resolve = effect (cached: string | undefined, load: () => Effect<string, never, never>): Effect<string, never, never> =>
  cached === undefined ? try load() : cached

// A throw while building the result.
export const first = (items: string[]): Effect<string, never, never> => items[0]!.toUpperCase()

// A method's thunk sees the method's this.
export class Greeter {
  constructor(readonly name: string) {}

  effect greet(): Effect<string, never, never> {
    return `hello ${this.name}`
  }
}
