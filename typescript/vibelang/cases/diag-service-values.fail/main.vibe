// expect: EK4503
service Users { region: string; find(id: string): string!! }
export function main() {
  const region = Users.region
  const find = Users.find
  return [region, find]
}

export effect function direct() { return try Users.find("id") }
export effect function implementation() { return (try Users()).region }
export const keyMember = Users.key

export const topLevelRegion = Users.region
export const topLevelFind = Users.find
