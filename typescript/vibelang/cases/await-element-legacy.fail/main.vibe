// expect: EK4613 EK4609 EK4610 EK1023
// This source compiled on VibeLang 0.0.10, where await.all ran a program
// value and an Exit, waited for a fiber and a Deferred, and converted a
// function to its program. Every element is now a program by syntax whose
// result is its value (D394); await-element-legacy-fixed is what
// vibelang --fix writes.
function work(n: number) {
  try sleep("1 millis")
  return n
}

export function main() {
  const program: number!! = Effect.succeed(1)
  const fiber = fork work(2)
  const ready = try Deferred.make<number>()
  try Deferred.succeed(ready, 3)
  const exited = Exit.succeed(5)
  const values = await.all [program, fiber, ready, () => work(4), exited]
  const raced = await.race [() => {
    try sleep("1 millis")
    return "block"
  }]
  return { values, raced }
}
