import { Effect } from "effect"
import { values, events } from "./helper.js"
effect function boom(): number!string! { throw "boom" }
effect function main() {
 try { const [n = try boom()] = values(); events.push("body:"+n) } catch { events.push("caught") }
 try Console.log(events.join(","))
}
Effect.runPromise(main())
