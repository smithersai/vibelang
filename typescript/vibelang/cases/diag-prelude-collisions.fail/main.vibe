// expect: TS2709 TS2707 TS2351 TS2339
// A name the prelude settles (D310, D311) can mean what the program did not
// mean. The error keeps its meaning and a note names it and the way to the
// other one: Message and Command are Effect's modules, Worker is Effect's
// namespace while ambient types keep their names; Number remains
// JavaScript's and Headers is Effect's namespace.
// prelude-collision-imports runs the imports the notes suggest.
export function send(m: Message) { return m }
export function run(c: Command) { return c }
export function start() { return new Worker("./worker.js") }
export function post(w: Worker.Worker<string, string>) { return w.postMessage("x") }
export function add() { return Number.sum(1, 2) }
export function headers() { return Headers.fromInput({}) }
