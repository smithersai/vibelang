// expect: EK1004
// A module's top level is not inside a program, so using there has no block
// to release it in (Chapter 6). A class static block runs at the top level too.
declare function open(path: string): Disposable

using log = open("/var/log/app.log")

export class Registry {
  static {
    using scope = open("/tmp/registry")
  }
}

{
  using block = open("/tmp/block")
}

export effect function read() {
  using file = open("/tmp/a")
  return 1
}
