// expect: EK4838
// A function that refers to an owned fiber captures it, and
// nothing in the source shows that the function finishes before the region
// does, so every such capture is an error (D409).
effect function heartbeat() {
  try sleep("1 minute")
}

let saved: unknown

export effect function returned() {
  const fiber = fork heartbeat()
  return effect () => fiber
}

export effect function declared() {
  const fiber = fork heartbeat()
  function current() {
    return fiber
  }
  return current
}

export effect function method() {
  const fiber = fork heartbeat()
  return {
    effect current() {
      return fiber
    }
  }
}

export effect function stored() {
  const fiber = fork heartbeat()
  saved = effect () => fiber
}

// The function never leaves the region, but it still captures the fiber.
export effect function local() {
  const fiber = fork heartbeat()
  const stop = effect () => try Fiber.interrupt(fiber)
  try stop()
}

export effect function blockParam() {
  const fiber = fork heartbeat()
  return try within("watch", effect () => {
    return try Fiber.interrupt(fiber)
  })
}

// A function passed as a call's last argument captures the owned fiber as
// any other function does.
effect function within(name: string, body: () => void!!) {
  try log(name)
  return try body()
}
