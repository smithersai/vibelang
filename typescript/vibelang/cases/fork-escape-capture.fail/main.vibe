// expect: EK4838
// A function or block param that refers to an owned fiber captures it, and
// nothing in the source shows that the function finishes before the region
// does, so every such capture is an error (D409).
function heartbeat() {
  try sleep("1 minute")
}

let saved: unknown

export function returned() {
  const fiber = fork heartbeat()
  return () => fiber
}

export function declared() {
  const fiber = fork heartbeat()
  function current() {
    return fiber
  }
  return current
}

export function method() {
  const fiber = fork heartbeat()
  return {
    current() {
      return fiber
    }
  }
}

export function stored() {
  const fiber = fork heartbeat()
  saved = () => fiber
}

// The function never leaves the region, but it still captures the fiber.
export function local() {
  const fiber = fork heartbeat()
  const stop = () => Fiber.interrupt(fiber)
  try stop()
}

export function blockParam() {
  const fiber = fork heartbeat()
  return try within("watch") {
    return try Fiber.interrupt(fiber)
  }
}

// A block param is its call's last argument (S2); this callee takes its
// program last, so the block still captures the owned fiber.
function within(name: string, body: () => void!!) {
  try log(name)
  return try body()
}
