// A const that holds a plain arrow recurses as a function declaration does:
// on the JavaScript stack, as plain JavaScript (VIP-1). That holds for an
// expression or a block body, an exported const, a cycle through a function
// declaration, and an arrow that a function's body declares. (Before VIP-1,
// D412 moved deep plain recursion onto heap frames; no VIP keeps that.)
// expect-result: {"countdown":0,"sum":500500,"even":false,"depth":1000,"nested":1000,"mapped":[0,0]}
const countdown = (n: number): number => n === 0 ? 0 : countdown(n - 1)

const sum = (n: number): number => {
  if (n === 0) return 0
  return n + sum(n - 1)
}

const isEven = (n: number): boolean => n === 0 ? true : isOdd(n - 1)

function isOdd(n: number): boolean {
  return n === 0 ? false : isEven(n - 1)
}

export const depth = (n: number): number => n === 0 ? 0 : 1 + depth(n - 1)

function nested(limit: number) {
  const step = (n: number): number => n >= limit ? n : step(n + 1)
  return step(0)
}

export effect function main() {
  return {
    countdown: countdown(1000),
    sum: sum(1000),
    even: isEven(1001),
    depth: depth(1000),
    nested: nested(1000),
    mapped: [3, 4].map(countdown),
  }
}
