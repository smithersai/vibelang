// expect-result: {"keys":["FetchIssues","billing/Charge","Triage"],"options":[{"retryPolicy":{"initialMs":1000,"factor":2,"maxMs":4000,"maxAttempts":3}},{"key":"billing/Charge"},{"maxRounds":2}],"counts":[1,1,1],"calls":["fetch smithersai/smithers","fetch effect/effect"],"words":["chore","chore",2]}
// Tasks and a workflow run on Experimental.Durable; the same input joins the recorded run (VIP-55, VIP-44).
schema Issue { number: number; title: string }

const calls: Array<string> = []

// A task's A!E annotation is its durable boundary.
task FetchIssues {
  static readonly retryPolicy = { initialMs: 1000, factor: 2, maxMs: 4000, maxAttempts: 3 }
  effect call(repo: string): ReadonlyArray<Issue>!string {
    if (repo === "") throw "no repository"
    try sync(() => { calls.push(`fetch ${repo}`) })
    return [{ number: 1, title: repo }]
  }
}

// A task with no body: its implementation is supplied separately.
task Charge {
  static readonly key = "billing/Charge"
  effect call(order: string, cents: number): number!string
}

export workflow Triage {
  static readonly maxRounds = 2
  effect call(repo: string) {
    const issues = try FetchIssues(repo)
    return issues.length
  }
}

// The words stay identifiers wherever no declaration starts.
const task = { name: "chore" }
const workflow = task as { name: string }
const spawn = (n: number) => n + 1

export effect function main() {
  provide Layer.provideMerge(Triage.layer, Experimental.Durable.memory) {
    const first = try Triage("smithersai/smithers")
    const again = try Triage("smithersai/smithers")
    const other = try Triage("effect/effect")
    return {
      keys: [FetchIssues.key, Charge.key, Triage.key],
      options: [FetchIssues.options, Charge.options, Triage.options],
      counts: [first, again, other],
      calls,
      words: [task.name, workflow.name, spawn(1)]
    }
  }
}
