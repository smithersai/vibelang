export function choose(value: boolean): 1 {
  return match (value) {
    when true: 1;
    default: match (void 0 as unknown) { when 0: (void 0 as never); };
  }
}
export async function asyncChoose(value: boolean): Promise<1> {
  return match (value) {
    when true: 1;
    default: match (void 0 as unknown) { when 0: (void 0 as never); };
  }
}
export effect function effectChoose(value: boolean): 1!! {
  return match (value) {
    when true: 1;
    default: match (void 0 as unknown) { when 0: (void 0 as never); };
  }
}
