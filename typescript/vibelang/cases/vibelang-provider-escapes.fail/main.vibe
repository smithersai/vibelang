// expect: EK9201
// A provider's member must fit the service member's contract (Chapter 4).
// Without Effect.orDie, DbError escapes find, whose contract allows only
// UserNotFound, in an object literal provider and in an implementing class.
import { Data, Effect, Layer } from "effect"

class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}
class DbError extends Data.TaggedError("DbError")<{ readonly reason: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect.Effect<User, UserNotFound, never>
}

service Database {
  query(sql: string): Effect.Effect<ReadonlyArray<User>, DbError, never>
}

export const UsersLive = Layer.effect(Users, effect {
  const db = try Database()
  return {
    effect find(id) {
      const rows = try db.query(`select ${id}`)
      if (rows.length === 0) return try Effect.fail(new UserNotFound({ id }))
      return try Effect.succeed(rows[0])
    }
  }
})

export class UsersFlaky implements Users {
  effect find(id: string) {
    return try Effect.fail(new DbError({ reason: `no connection for ${id}` }))
  }
}
