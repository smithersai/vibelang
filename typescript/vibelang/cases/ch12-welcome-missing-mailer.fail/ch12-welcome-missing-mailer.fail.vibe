// expect: EK9202
// Chapter 12 "Checking a written contract", verbatim: welcome needs Mailer, but its contract says
// R = Users.

class UserNotFound extends TaggedError("UserNotFound")<{ readonly id: string }> {}
class MailError extends TaggedError("MailError")<{ readonly reason: string }> {}

interface User {
  id: string
  name: string
  email: string
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

service Mailer {
  send(to: string, body: string): Effect<void, MailError, never>
}

export effect function welcome(id: string): Effect<string, UserNotFound | MailError, Users> {
  const user = try Users.find(id)
  try Mailer.send(user.email, "Welcome")
  return user.name
}
