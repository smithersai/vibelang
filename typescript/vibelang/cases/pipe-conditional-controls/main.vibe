// expect-result: [1,1,1,11,6,0,2,"small"]
// The valid neighbours of EK2301 (Appendix A, ConditionalExpression): a
// parenthesized pipe as the test, a parenthesized conditional as the body,
// a pipe in either branch, and ?? inside a pipe body.
function f(n: number) { return n + 1 }
function values(one: number, ok: boolean, nothing: number | undefined) {
  return [
    (one |> %) ? 1 : 2,
    one |> (% ? 1 : 2),
    ok ? 1 : 2 |> % + 10,
    (ok ? 1 : 2) |> % + 10,
    ok ? 5 |> f(%) : 0,
    !ok ? 5 |> f(%) : 0,
    nothing |> % ?? 1 |> f(%),
    (one |> f(%) |> % > 2) ? "big" : "small",
  ]
}
export effect function main() {
  return values(1, true, undefined)
}
