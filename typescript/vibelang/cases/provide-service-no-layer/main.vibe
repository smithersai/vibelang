// provide Key = value { ... } is Layer.succeed inside Effect.provide.
// Native layer scope and memo maps apply to service entries too.
// VIP-12 gives service entries and written Layers identical provider behavior.
export service Greeting {
  text(): string!!
}

service Names {
  name(): string!!
}

const NamesLive = Layer.succeed(Names, {
  effect name() { return "Ada" }
})

const events: string[] = []

effect function scope(): string!! {
  const memo = try Effect.serviceOption(Layer.CurrentMemoMap)
  return Option.isSome(memo) ? "layer" : "no layer"
}

function greeting(text: string): Greeting.Shape {
  events.push(text)
  return { text: effect () => text }
}

function names() {
  events.push("names")
  return NamesLive
}

export effect function single(): string!! {
  provide Greeting = { text: effect () => "hi" } {
    return `${try Greeting.text()}, ${try scope()}`
  }
}

export effect function two(): string!! {
  provide Greeting = { text: effect () => "hi" }, Names = { name: effect () => "Bo" } {
    return `${try Names.name()} ${try Greeting.text()}, ${try scope()}`
  }
}

// A Layer the source writes still builds one.
export effect function layer(): string!! {
  provide NamesLive {
    return `${try Names.name()}, ${try scope()}`
  }
}

// Providers evaluate in source order, Layers and services alike.
export effect function mixed(): string!! {
  events.length = 0
  provide Greeting = greeting("first"), names() {
    provide names(), Greeting = greeting("last") {
      return `${try Names.name()} ${try Greeting.text()}, ${try scope()}, ${events.join(" ")}`
    }
  }
}

// The innermost block wins, and the later of two entries for one key.
export effect function nested(): string!! {
  provide Greeting = { text: effect () => "outer" } {
    provide Greeting = { text: effect () => "early" }, Greeting = { text: effect () => "inner" } {
      return try Greeting.text()
    }
  }
}

// One pass through a one-service block, for the run-loop count.
export effect function once(): number!! {
  provide Greeting = { text: effect () => "hi" } {
    return (try Greeting.text()).length
  }
}

// The same statements, for the native Effect.provide counterpart.
export effect function bare() {
  return (try Greeting.text()).length
}
