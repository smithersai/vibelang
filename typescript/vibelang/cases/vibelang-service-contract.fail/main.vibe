// expect: TS7010
// Bodyless methods accept plain or Effect returns; an omitted return type follows noImplicitAny (TS7010).
import { Effect } from "effect"

service Rates {
  lookup(currency: string): number
  convert(amount: number): Effect.Effect<number>
  latest()
  readonly base: string
  refresh(): Effect.Effect<void, never, never>
}
