// expect: EK2101
// A service member has no body to infer from, so it states its full
// contract, Effect<A, E, R> (Chapter 14). A bare return type, a partial
// Effect, and a missing annotation are each EK2101; value members take any
// type.
import { Effect } from "effect"

service Rates {
  lookup(currency: string): number
  convert(amount: number): Effect.Effect<number>
  latest()
  readonly base: string
  refresh(): Effect.Effect<void, never, never>
}
