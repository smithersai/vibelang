// expect-result: {"value":"ADA","branch":"big","caught":"recovered","plain":7,"raced":"fast","exit":"Success"}
error Boom

effect function getName(): string!! {
  return "Ada"
}

effect function fail(): number!Boom {
  throw new Boom()
}

effect function slow(): string!! {
  try sleep("1 second")
  return "slow"
}

// The value of a do expression is the completion value of its last statement.
effect function value() {
  return do {
    const name = try getName()
    name.toUpperCase()
  }
}

function branch(n: number) {
  const size = do {
    if (n > 10) {
      "big"
    } else {
      "small"
    }
  }
  return size
}

effect function caught() {
  return do {
    try {
      try fail()
      "unreachable"
    } catch (e) {
      "recovered"
    }
  }
}

function plain() {
  return do { const a = 3; a + 4 }
}

// Where a parameter expects a program, a do expression is passed, not run.
effect function raced() {
  return try race(do { try sleep("1 millis"); "fast" }, slow())
}

effect function exited() {
  return (try Effect.exit(do { try getName() }))._tag
}

export effect function main() {
  return { value: try value(), branch: branch(42), caught: try caught(), plain: plain(), raced: try raced(), exit: try exited() }
}
