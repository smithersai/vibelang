// expect: EK2128 EK2128

export effect function main(): readonly unknown[]!never!never {
  const events: number[] = []
  class C { effect *values() { yield 1; return events.push(2) } }
  const object = { effect *values() { yield 3; return events.push(4) } }
  const first = try Stream.runCollect(new C().values())
  const second = try Stream.runCollect(object.values())
  return [first, second, events]
}
