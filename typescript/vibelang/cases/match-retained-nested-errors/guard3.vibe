import * as M from "effect/encoding/Csv"
export function witness():boolean[][]{
const copy={_tag:"CsvError", ["~effect/encoding/Csv/CsvError"]:"~effect/encoding/Csv/CsvError"};
const subjects:unknown[]=[copy,{_tag:"CsvError"},null,{}];
return subjects.map(s=>[match(s){when M.CsvError:true;default:false;},match(s){when M.CsvError(let e):e===s;default:false;},match(s){when M.CsvError():true;default:false;},match(s){when M.CsvError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.CsvError["_tag"]|undefined{return match(s){when M.CsvError(let error):error._tag;default:undefined;}}
// VIP-7 subpath retained error guard and subject extraction; rule: docs/design/vips/0007-match.md#79509f2932b181d9
