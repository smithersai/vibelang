import * as M from "effect/encoding/EncodingError"
export function witness():boolean[][]{
const copy={_tag:"EncodingError", ["~effect/encoding/EncodingError"]:"~effect/encoding/EncodingError"};
const subjects:unknown[]=[copy,{_tag:"EncodingError"},null,{}];
return subjects.map(s=>[match(s){when M.EncodingError:true;default:false;},match(s){when M.EncodingError(let e):e===s;default:false;},match(s){when M.EncodingError():true;default:false;},match(s){when M.EncodingError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.EncodingError["_tag"]|undefined{return match(s){when M.EncodingError(let error):error._tag;default:undefined;}}
