import * as M from "effect/http/Headers"
export function witness():boolean[][]{
const copy={_tag:"HeaderParseError", ["~effect/http/Headers/HeaderParseError"]:"~effect/http/Headers/HeaderParseError"};
const subjects:unknown[]=[copy,{_tag:"HeaderParseError"},null,{}];
return subjects.map(s=>[match(s){when M.HeaderParseError:true;default:false;},match(s){when M.HeaderParseError(let e):e===s;default:false;},match(s){when M.HeaderParseError():true;default:false;},match(s){when M.HeaderParseError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.HeaderParseError["_tag"]|undefined{return match(s){when M.HeaderParseError(let error):error._tag;default:undefined;}}
