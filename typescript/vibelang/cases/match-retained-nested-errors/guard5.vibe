import * as M from "effect/encoding/JsonArray"
export function witness():boolean[][]{
const copy={_tag:"JsonArrayError", ["~effect/encoding/JsonArray/JsonArrayError"]:"~effect/encoding/JsonArray/JsonArrayError"};
const subjects:unknown[]=[copy,{_tag:"JsonArrayError"},null,{}];
return subjects.map(s=>[match(s){when M.JsonArrayError:true;default:false;},match(s){when M.JsonArrayError(let e):e===s;default:false;},match(s){when M.JsonArrayError():true;default:false;},match(s){when M.JsonArrayError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.JsonArrayError["_tag"]|undefined{return match(s){when M.JsonArrayError(let error):error._tag;default:undefined;}}
