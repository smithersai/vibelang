import * as M from "effect/graphql/GraphQLClientError"
export function witness():boolean[][]{
const copy={_tag:"GraphQLClientError", ["~effect/graphql/GraphQLClientError"]:"~effect/graphql/GraphQLClientError"};
const subjects:unknown[]=[copy,{_tag:"GraphQLClientError"},null,{}];
return subjects.map(s=>[match(s){when M.GraphQLClientError:true;default:false;},match(s){when M.GraphQLClientError(let e):e===s;default:false;},match(s){when M.GraphQLClientError():true;default:false;},match(s){when M.GraphQLClientError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.GraphQLClientError["_tag"]|undefined{return match(s){when M.GraphQLClientError(let error):error._tag;default:undefined;}}
