import * as M from "effect/http/HttpBody"
export function witness():boolean[][]{
const copy={_tag:"HttpBodyError", ["~effect/http/HttpBody/HttpBodyError"]:"~effect/http/HttpBody/HttpBodyError"};
const subjects:unknown[]=[copy,{_tag:"HttpBodyError"},null,{}];
return subjects.map(s=>[match(s){when M.HttpBodyError:true;default:false;},match(s){when M.HttpBodyError(let e):e===s;default:false;},match(s){when M.HttpBodyError():true;default:false;},match(s){when M.HttpBodyError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.HttpBodyError["_tag"]|undefined{return match(s){when M.HttpBodyError(let error):error._tag;default:undefined;}}
