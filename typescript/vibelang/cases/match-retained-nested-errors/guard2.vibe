import * as M from "effect/crypto/CryptoError"
export function witness():boolean[][]{
const copy={_tag:"CryptoError", ["~effect/crypto/CryptoError"]:"~effect/crypto/CryptoError"};
const subjects:unknown[]=[copy,{_tag:"CryptoError"},null,{}];
return subjects.map(s=>[match(s){when M.CryptoError:true;default:false;},match(s){when M.CryptoError(let e):e===s;default:false;},match(s){when M.CryptoError():true;default:false;},match(s){when M.CryptoError(let a,let b):true;default:false;}]);
}
export function narrow(s:unknown):M.CryptoError["_tag"]|undefined{return match(s){when M.CryptoError(let error):error._tag;default:undefined;}}
