// expect-result: {"race":1,"any":2}
// try.race and try.any run each element in its own fiber, so an element
// that handles its own control operations runs (chapter 9, "Handlers and
// concurrency").
control Ask { ask(): number!! }

effect function answered(n: number) {
  try {
    return try Ask.ask()
  } handle Ask.ask() {
    try resume(n)
  }
}

effect function late() {
  try sleep("1 second")
  return 0
}

export effect function main() {
  return {
    race: (try.race [effect { return try answered(1) }, effect { return try late() }]),
    any: (try.any [effect { return try late() }, effect { return try answered(2) }])
  }
}
