// expect-result: {"greeting":"Hello, Ada","early":"early","count":2,"both":"Ada 1","context":"Context"}
error NotFound { id: string }

service Names {
  name(id: string): string!NotFound
}

service Counter {
  next(): number!!
}

const NamesLive = Layer.succeed(Names, {
  name(id) {
    if (id === "42") return "Ada"
    throw new NotFound({ id })
  }
})

const CounterLive = Layer.effect(Counter) {
  const count = try Ref.make(0)
  return {
    next() {
      try Ref.update(count, (n) => n + 1)
      return try Ref.get(count)
    }
  }
}

// The block provides Names, so the function needs no services.
function greeting(id: string): string!NotFound! {
  provide NamesLive {
    return `Hello, ${try Names.name(id)}`
  }
}

// A return inside a provide block returns from the enclosing function.
function early() {
  for (const step of [1, 2, 3]) {
    provide CounterLive {
      if (step === 1) return "early"
    }
  }
  return "late"
}

// One layer instance serves the whole block.
function counted() {
  provide CounterLive {
    try Counter.next()
    return try Counter.next()
  }
}

// An array of layers provides all of their services.
function both(): string!NotFound! {
  provide [NamesLive, CounterLive] {
    return `${try Names.name("42")} ${try Counter.next()}`
  }
}

// A Context provides its services just as Effect.provide does.
function context(): string!NotFound! {
  const names = Context.make(Names, { name: () => "Context" })
  provide names {
    return try Names.name("42")
  }
}

export function main() {
  return { greeting: try greeting("42"), early: try early(), count: try counted(), both: try both(), context: try context() }
}
