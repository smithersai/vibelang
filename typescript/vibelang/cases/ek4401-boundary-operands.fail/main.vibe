// expect: EK4401
// EK4401's note suggests try around a plain call, with the bindings the call
// reads as inputs (D230). try's function cannot run an Effect, so an argument
// or a receiver that runs one is an input too, which runs before the hatch
// (D232), named after the callee's parameter. The other fix is trusted (D249).
import { type Shelf, sortTitles } from "./legacy.ts"

abstract class Todos {
  abstract list(): Effect<ReadonlyArray<{ title: string }>, never, never>
  abstract shelf(): Effect<Shelf, never, never>
}

export effect function sorted() {
  return sortTitles(Todos.list())
}

export effect function shelved() {
  return Todos.shelf().titles()
}

export effect function plain(titles: ReadonlyArray<{ title: string }>) {
  Effect.sleep("1 millis")
  return sortTitles(titles)
}
