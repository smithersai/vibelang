// expect: EK3201 TS2322
// A runner's program may need only what the runner provides (D38). EK3201
// names each service that nothing provides, at a program runner and at a
// test, in place of TypeScript's error about the argument's type. A test
// that layer(…) registers may need that layer's services.
import { Effect } from "effect"
import { NodeRuntime } from "@effect/platform-node"
import { it, layer } from "@effect/vitest"

service Todos {
  list(): Effect.Effect<ReadonlyArray<string>, never, never>
}

service Clock2 {
  now(): Effect.Effect<number, never, never>
}

const TodosTest = Layer.succeed(Todos, { list: effect () => ["a"] })

effect function count() {
  return (try Todos.list()).length
}

effect function stamped() {
  return `${try count()} at ${try Clock2.now()}`
}

NodeRuntime.runMain(effect () => {
  try Effect.log(try count())
})

Effect.runPromise(effect { return try stamped() })

it.effect("counts", effect () => {
  try count()
})

layer(TodosTest)("with todos", (it) => {
  it.effect("counts", effect () => {
    try count()
  })
})

it.effect("provides its own", effect () => {
  try Effect.provide(effect { return try count() }, TodosTest)
})

it.effect("keeps the errors in its body", effect () => {
  const total: string = try count()
})
