// A namespace import of a module declaration is its module namespace object (D403).
// expect-result: [42, 42, 42, 42, 7, "[object Module]", true]
module impl {
  const value = 42
  export { value as "__proto__", value as constructor, value as "two words", value as "quote\"name" }
  export { other as "re-export" } from "./other.ts"
}
import * as ns from impl
export { "__proto__" as protoValue, "two words" as "two words" } from impl
export effect function main() {
  return [ns["__proto__"], ns.constructor, ns["two words"], ns['quote"name'], ns["re-export"],
    try sync(() => Object.prototype.toString.call(ns)), try sync(() => Object.getPrototypeOf(ns) === null)]
}
