// Platform work goes through Effect's services, imported by name, with no
// wrapper module: the replacements that EK4402 suggests compile as written,
// and a program runs them with the layers that main provides, here Effect's
// own POSIX Path and a FileSystem test double.
import { FileSystem, layerNoop } from "effect/FileSystem"
import { Path, layer as PosixPath } from "effect/Path"
import { Digest, SecureRandom } from "effect/crypto"
import { Stdio } from "effect/Stdio"
import { HttpClient } from "effect/http"
import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"

effect function notes(directory: string) {
  const file = try Path.join(directory, "notes.txt")
  return [file, try FileSystem.readFileString(file)]
}

export const status = effect () => try ChildProcessSpawner.string(ChildProcess.make("git", ["status"]))
export const token = effect () => try SecureRandom.randomBytes(16)
export const id = effect () => try SecureRandom.uuidV4()
export const page = effect (url: string) => try HttpClient.get(url)
export const args = effect () => try Stdio.args()
export const here = effect () => try Path.resolve()
export const scratch = effect () => try FileSystem.makeTempDirectory()
export const sha = effect (bytes: Uint8Array) => try Digest.digest(Digest.sha256, bytes)

const Files = layerNoop({ readFileString: effect (path) => `read ${path}` })

// expect-result: ["/srv/notes.txt","read /srv/notes.txt"]
export effect function main() {
  provide PosixPath, Files {
    return try notes("/srv")
  }
}
