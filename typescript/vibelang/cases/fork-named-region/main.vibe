import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// expect-result: {"events":["if: after","stop if","if without braces: after","stop if without braces","bare: after","stop bare","stop loop 1","stop loop 2","loop: after","do: after","stop do","stop try","try: finally"]}
// A fiber belongs to the innermost region the source names, never to braces
// (D408). An if branch, a bare block, and a do block own nothing, so their
// fibers live until the function's body exits; one iteration of a loop body
// owns its fibers with or without braces; a try block owns its own.
const events: string[] = []

effect function ticker(name: string, started: Deferred.Deferred<void>) {
  { const $nativeTryCompletion = try $nativeTryEffect.onExit(effect {
    try Deferred.succeed(started, undefined)
    while (true) try sleep("1 millis")
  
;return { kind: "normal" } as const;
}, () => effect {
    events.push(`stop ${name}`)
  });

}
}

effect function branch(flag: boolean) {
  const started = try Deferred.make<void>()
  if (flag) {
    fork ticker("if", started)
  }
  if (flag) try started.await()
  events.push("if: after")
}

effect function branchWithoutBraces(flag: boolean) {
  const started = try Deferred.make<void>()
  if (flag) fork ticker("if without braces", started)
  if (flag) try started.await()
  events.push("if without braces: after")
}

effect function bare() {
  const started = try Deferred.make<void>();
  {
    fork ticker("bare", started)
    try started.await()
  }
  events.push("bare: after")
}

effect function loop() {
  const started = [try Deferred.make<void>(), try Deferred.make<void>()]
  for (const n of [1, 2]) (fork ticker(`loop ${n}`, started[n - 1]), try started[n - 1].await())
  events.push("loop: after")
}

effect function doBlock() {
  const started = try Deferred.make<void>()
  const marked = do {
    fork ticker("do", started)
    try started.await()
    "marked"
  }
  events.push(`do: after`)
  return marked
}

effect function guarded() {
  const started = try Deferred.make<void>()
  { const $nativeTryCompletion1 = try $nativeTryEffect1.onExit(effect {
    fork ticker("try", started)
    try started.await()
  
;return { kind: "normal" } as const;
}, () => effect {
    events.push("try: finally")
  });

}
}

export effect function main() {
  try branch(true)
  try branchWithoutBraces(true)
  try bare()
  try loop()
  try doBlock()
  try guarded()
  return { events }
}
