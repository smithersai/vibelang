import { Effect } from "effect"
import { items } from "./native.js"
function witness():unknown {const log:string[]=[];try{const value=match(items(log,true,true)){when [{value:0}]:"hit";default:"miss";};return [value,log]}catch(e){return [e instanceof AggregateError?e.errors.map((x:Error)=>x.message):[(e as Error).message],log]}}
export function main():Effect.Effect<unknown> {return Effect.sync(witness)}
