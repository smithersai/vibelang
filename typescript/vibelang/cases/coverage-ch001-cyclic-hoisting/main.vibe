import "./consumer.ts"
export effect function program() {
 class Base { ping() { return 7 } }
 class Derived extends Base {
  effect go() { try Effect.yieldNow; return super.ping() }
 }
 return try new Derived().go()
}
export effect function main() { return try program() }

