export function probe(): unknown {
  const events: unknown[] = []
  var x = 7
  function observe(label: string, f: () => unknown): void {
    try { events.push([label, f()]) }
    catch (e) { events.push([label, e instanceof Error ? e.name : String(e)]) }
  }
  for (const empty of [false, true]) {
    let read: () => unknown = () => 0
    const cells: (() => unknown)[] = []
    let same: () => unknown = () => 0
    let local: () => unknown = () => 0
    outer: alias: for (var { value: x } of do {
      read = (): unknown => x
      same = read
      observe("before", read)
      { const x = 5; local = () => x }
      empty ? [] : [{ value: 1 }, { value: 2 }]
    }) {
      events.push(["identity", read === same])
      observe("during", read)
      cells.push(() => x)
      x += 10
      continue alias
    }
    observe("after", read)
    x = 99
    observe("mutated", read)
    observe("local", local)
    events.push(["cells", cells.map(f => f())])
  }
  return events
}
