// Plain JavaScript code can hold a function that delays a running call.
effect function seven(): number!! { try sleep("0 millis"); return 7 }

class Counter {
  get next() { return effect () => try seven() }
}

effect function later(program = effect () => try seven()) {
  return try program()
}

effect function typed(program: number!! = effect { return try seven() }) {
  return try program()
}

// expect-result: [7,7,7,7]
export effect function main() {
  class Job {
    program = effect () => try seven()
  }
  return [try new Counter().next(), try later(), try typed(), try new Job().program()]
}
