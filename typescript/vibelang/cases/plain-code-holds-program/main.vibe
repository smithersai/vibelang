// Plain JavaScript code can hold a function that delays a running call.
function seven(): number!! { try sleep("0 millis"); return 7 }

class Counter {
  get next() { return () => seven() }
}

function later(program = () => seven()) {
  return try program()
}

function typed(program: number!! = () => seven()) {
  return try program()
}

// expect-result: [7,7,7,7]
export function main() {
  class Job {
    program = () => seven()
  }
  return [try new Counter().next(), try later(), try typed(), try new Job().program()]
}
