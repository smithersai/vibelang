// A function without the effect modifier is plain JavaScript (VIP-1), and its
// try, catch, and finally are JavaScript's: its catch sees every exception,
// a TypeError included. (Before VIP-1, D13 rethrew anything but an expected
// failure, so length(undefined) was a defect.)
import { Data, Effect, Exit } from "effect"

class Invalid extends Data.TaggedError("Invalid")<{ readonly n: number }> {}

export function clamp(n: number) {
  try {
    if (n > 10) raise(new Invalid({ n }))
    return n
  } catch (e) {
    return (e as { n: number }).n > 100 ? -100 : -10
  }
}

// A catch that destructures what it caught, which catches a TypeError too and
// binds n undefined.
export function length(value: any) {
  try {
    if (value === 0) raise(new Invalid({ n: 0 }))
    return value.length
  } catch (e) {
    const { n } = e as { n?: number }
    return n
  }
}

// A catch without a binding that rethrows, caught by an outer catch.
export function rethrown(n: number) {
  try {
    try {
      if (n < 0) raise(new Invalid({ n }))
      return n
    } catch {
      raise("negative")
    } finally {
      steps.push(`finally ${n}`)
    }
  } catch (e) {
    return e
  }
}

const steps: string[] = []

// expect-result: {"clamp":[5,-10,-100],"length":[0,3],"defect":["Success"],"rethrown":["negative",2],"steps":["finally -1","finally 2"]}
export effect function main() {
  const defect = try Effect.exit(effect { return try Effect.suspend(effect () => length(undefined)) })
  return {
    clamp: [clamp(5), clamp(50), clamp(500)],
    length: [length(0), length("abc")],
    defect: Exit.isFailure(defect) ? (defect.cause.reasons as ReadonlyArray<(typeof defect.cause.reasons)[number]>).map((reason) => reason._tag) : ["Success"],
    rethrown: [rethrown(-1), rethrown(2)],
    steps
  }
}

// A synchronous VibeLang function never throws (Will, 2026-10-31): the throw
// these tests need lives in raise.ts, which keeps JavaScript's throw.
import { raise } from "./raise.js"
