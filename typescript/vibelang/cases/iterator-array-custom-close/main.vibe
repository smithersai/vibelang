import { Effect } from "effect"
import { customArray, subclassArray, proxyArray, events } from "./helper.js"
effect function boom(): never!string { throw "boom" }
effect function main() {
 effect {
   for (const n of customArray()) { try boom() }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("array", events.join(","))
 events.length = 0
 const iterable: Iterable<number> = customArray()
 effect {
   for (const n of iterable) { try boom() }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("iterable", events.join(","))
 events.length = 0
 effect {
   for (const n of subclassArray()) { try boom() }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("subclass", events.join(","))
 events.length = 0
 effect {
   for (const n of proxyArray()) { try boom() }
 } catch effect () => {
   events.push("caught")
 }
 try Console.log("proxy", events.join(","))

}
Effect.runPromise(main())
