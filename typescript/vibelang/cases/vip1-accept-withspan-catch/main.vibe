// expect-result: {"found":[3,"load"],"missing":["none","load"],"argument":[7,1]}
// VIP-1 flip acceptance case 10 (t3code pullRequestStatsPersistence.vibe:17).
// e catch h runs e (VIP-5), in a call argument too, as try e does, so
// withSpan(e catch h, "load") passes withSpan the caught value, not a program.
// To span the caught program, build it as an Effect: effect { return e catch h }.
let runs = 0
const parse = (key: string): number!string => effect {
  if (key === "bad") throw "bad"
  return key.length
}

const spanName = (): string!! => effect {
  const span = try Effect.currentSpan catch () => undefined
  return span?.name ?? "no span"
}

interface Persistence {
  readonly load: (key: string) => [Option.Option<number>, string]!!
}

export const persistence: Persistence = {
  load: effect (key) =>
    try withSpan(
      effect {
        return effect {
          const value = try parse(key)
          return [Option.some(value), try spanName()] as [Option.Option<number>, string]
        } catch effect () => [Option.none<number>(), try spanName()] as [Option.Option<number>, string]
      },
      "load",
    ),
}

const counted: number!string = effect { runs += 1; return 7 }
const identity = <A>(a: A): A => a

const show = (o: Option.Option<number>) => Option.isSome(o) ? o.value : "none"

export effect function main() {
  const [found, foundSpan] = try persistence.load("abc")
  const [missing, missingSpan] = try persistence.load("bad")
  // catch in an argument runs its head before the call, as try does.
  const argument = identity(counted catch () => 0)
  return { found: [show(found), foundSpan], missing: [show(missing), missingSpan], argument: [argument, runs] }
}
