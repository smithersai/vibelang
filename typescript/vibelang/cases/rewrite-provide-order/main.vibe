import "vibelang/platform/node"
const events: string[] = []
const cold: number!! = Effect.succeed(7)
const holder = {
  get program(): number!! { events.push("program"); return cold }
}
function layer() { events.push("layer"); return Layer.empty }
function label(): string { events.push("label"); return "span" }
function run() { return try Effect.provide(holder.program, try layer()) }
export function main() {
  try Console.log(try run(), events.join(","))
}
