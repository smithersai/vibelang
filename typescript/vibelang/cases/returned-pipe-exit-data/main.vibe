// expect-result: {"suspended":"Failure","block":"Failure","concise":"Failure","subtype":7,"code":"lost"}
// A pipe whose last stage is a call that runs gives that call's success, as
// the call does without the pipe (D24, D154). Returned from a function whose
// Effect contract comes from a generic parameter, an Exit that pipe produces
// is the function's success, not a program to run a second time (S5-1).
// A last stage that returns a subtype as data still delegates, as the bare
// call does.
import * as Cause from "effect/Cause"
import * as Effect from "effect/Effect"
import * as Exit from "effect/Exit"

error Lost { code: string }

const work = effect (): number!Lost! => {
  throw new Lost({ code: "lost" })
}

const held = effect <A, E>(effect: A!E!) => try Effect.map(effect, (value) => value)

export effect function main() {
  const suspended = try Effect.suspend(effect () => work() |> Effect.exit(%) |> try Effect.ensuring(%, Effect.void))
  const block = try held(effect {
    const before = 1
    return work() |> try Effect.exit(%)
  })
  const concise = try held(effect { return work() |> try Effect.exit(%) })
  const subtype = try held(effect { return 7 |> Exit.succeed(%) })
  const failure = Exit.isFailure(block) ? Cause.squash(block.cause) : undefined
  return {
    suspended: suspended._tag,
    block: block._tag,
    concise: concise._tag,
    subtype,
    code: failure instanceof Lost ? failure.code : "none"
  }
}
