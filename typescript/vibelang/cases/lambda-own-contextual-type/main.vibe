// A lambda passed where a bare type parameter is expected, as to
// check<T>(actual: T), fixes T to its own type, so after inference its
// contextual type is that type. It says nothing about the lambda's form: the
// lambda writes it, here `: infer _`, a plain function that returns an Effect
// subtype as data (D24, D500).
// Reading the lambda's own return type to decide its form re-entered it:
// TS7024, "Function implicitly has return type 'any'".
module labels {
  import * as Effect from "effect/Effect"

  export interface Labeled<A> extends Effect.Effect<A> {
    readonly label: string
  }

  export const labeled = <A>(label: string, value: A): Labeled<A> => Object.assign(Effect.succeed(value), { label })

  export const check = <T>(actual: T): T => actual

  export const checkWith = <T>(actual: T, message?: string): T => message === undefined ? actual : actual
}

import { check, checkWith, labeled } from labels

const one = check((): infer _ => labeled("one", 1))
const two = checkWith((): infer _ => labeled("two", 2), "with a message")
const names = [one().label, two().label]

// expect-result: ["one","two",2]
export function main() {
  return [...names, try two()()]
}
