// expect: EK4838
// A concurrent operand permits direct reads, not escapes or captures below it.
let escaped: Fiber<void> | undefined

function keep(fiber: Fiber<void>) {}
function within(body: () => void!!) { try body() }

export function settledAssignment() {
  const f = fork sleep("1 minute")
  await.allSettled [do { escaped = f; 1 }]
}

export function racedStore(box: { mutable fiber?: Fiber<void> }) {
  const f = fork sleep("1 minute")
  await.race [do { box.fiber = f; 1 }]
}

export function anyCall() {
  const f = fork sleep("1 minute")
  await.any [keep(f)]
}

export function awaitCapture() {
  const f = fork sleep("1 minute")
  await.all [within(() => { try Fiber.interrupt(f) })]
}

export function forkAssignment() {
  const f = fork sleep("1 minute")
  const g = fork { escaped = f }
  join g
}

export function forkReturn() {
  const f = fork sleep("1 minute")
  const g = fork { return f }
  join g
}

export function forkObject() {
  const f = fork sleep("1 minute")
  const g = fork { return { f } }
  join g
}

export function forkArray() {
  const f = fork sleep("1 minute")
  const g = fork { return [f] }
  join g
}

export function forkBlockParam() {
  const f = fork sleep("1 minute")
  const g = fork within { try Fiber.interrupt(f) }
  join g
}

export function concurrentAssignment() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { escaped = f }
}

export function concurrentCall() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { try keep(f) }
}

export function concurrentCapture() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) {
    const stop = () => { try Fiber.interrupt(f) }
    try stop()
  }
}

export function concurrentBlockParam() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { try within { try Fiber.interrupt(f) } }
}
