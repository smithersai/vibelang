// expect: EK4838
// A concurrent operand permits direct reads, not escapes or captures below it.
let escaped: Fiber<void> | undefined

function keep(fiber: Fiber<void>) {}
effect function within(body: () => void!!) { try body() }

export effect function settledAssignment() {
  const f = fork sleep("1 minute")
  try.allSettled [effect { escaped = f; return 1 }]
}

export effect function racedStore(box: { mutable fiber?: Fiber<void> }) {
  const f = fork sleep("1 minute")
  try.race [effect { box.fiber = f; return 1 }]
}

export effect function anyCall() {
  const f = fork sleep("1 minute")
  try.any [effect { return keep(f) }]
}

export effect function awaitCapture() {
  const f = fork sleep("1 minute")
  try.all [effect { return try within(effect () => { try Fiber.interrupt(f) }) }]
}

export effect function forkAssignment() {
  const f = fork sleep("1 minute")
  const g = fork { escaped = f }
  join g
}

export effect function forkReturn() {
  const f = fork sleep("1 minute")
  const g = fork { return f }
  join g
}

export effect function forkObject() {
  const f = fork sleep("1 minute")
  const g = fork { return { f } }
  join g
}

export effect function forkArray() {
  const f = fork sleep("1 minute")
  const g = fork { return [f] }
  join g
}

export effect function forkBlockParam() {
  const f = fork sleep("1 minute")
  const g = fork within { try Fiber.interrupt(f) }
  join g
}

export effect function concurrentAssignment() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { escaped = f }
}

export effect function concurrentCall() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { keep(f) }
}

export effect function concurrentCapture() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) {
    const stop = effect () => { try Fiber.interrupt(f) }
    try stop()
  }
}

export effect function concurrentBlockParam() {
  const f = fork sleep("1 minute")
  for concurrent (const n of [1]) { try within { try Fiber.interrupt(f) } }
}
