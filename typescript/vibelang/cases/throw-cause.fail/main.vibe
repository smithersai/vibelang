// expect: EK2140 EK2140 EK2140 EK2140
// `throw` fails with the value it is given (D406), so throwing a Cause would
// make the Cause object an expected failure: each throw below whose operand's
// type is a Cause, or a union with one, is EK2140. Effect.failCause(cause)
// fails with every reason the cause holds; a throw of unknown is allowed.
error Missing

effect function rethrown() {
  const outcome = try exit(Effect.die("boom"))
  if (outcome is Exit.Failure(let cause)) throw cause
  return 1
}

effect function either(cause: Cause<string> | Missing) {
  throw cause
}

effect function inExpression(cause: Cause<never>, value: number | undefined) {
  return value ?? throw cause
}

function plain(cause: Cause<never>) {
  try { throw cause } catch { return 0 }
}

effect function widened(cause: Cause<never>) {
  const value: unknown = cause
  throw value
}

effect function restored(cause: Cause<string>) {
  try Effect.failCause(cause)
}
