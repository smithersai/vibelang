import { Context, Effect } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
service Users {
  static readonly key = "coverage/Users"
  readonly value: number
  read(): number
  identity<A>(value: A): A
}
service Flags {
  static readonly key = "coverage/Flags"
  static readonly defaultValue = () => ({ enabled: true })
  enabled: boolean
}
abstract class Ordinary { abstract value: string }
class Concrete extends Ordinary { value = "ordinary" }
type Shape = { readonly value: number; read(): number; identity<A>(value: A): A }
export const shape: Equal<Users.Shape, Shape> = true
export const nativeShape: Equal<Users.Shape, Context.Service.Shape<typeof Users>> = true
effect function read(): number!!Users { return (try Users).value }
export const requirement: Equal<ReturnType<typeof read>, Effect.Effect<number, never, Users>> = true
export effect function main() {
  const a = try Effect.provideService(read(), Users, { value: 7, read: () => 8, identity: <A>(x: A) => x })
  const b = (try Flags).enabled
  const c = try Effect.provideService(effect { return (try Flags).enabled }, Flags, { enabled: false })
  return [a, b, c, new Concrete().value, "Shape" in Users, Users.key]
}

