// expect-result: [true,[1,2]]
import { Stream } from "effect"

// VIP-21 marks a Stream producer explicitly with effect function*.
export effect function* numbers() {
  yield 1
  yield 2
}

export effect function main() {
  const stream: Stream.Stream<number, never, never> = numbers()
  return [Stream.isStream(stream), try Stream.runCollect(stream)]
}
