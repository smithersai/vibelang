// expect: EK0107
// VIP-1 rejects these legacy arguments reads in methods with defaults,
// rest parameters and rewritten parameters. Keep each original witness
// as a diagnostic regression instead of claiming it is runnable.
export class Counter {
  effect defaulted(a: number, step = 1): number!! {
    const bump = effect () => {
      const tick = try Effect.sync(() => step)
      return arguments[0]++
    }
    return try bump()
  }

  effect rest(...values: number[]): number!! {
    const bump = effect () => {
      const tick = try Effect.sync(() => values.length)
      return arguments[0]++
    }
    return try bump()
  }

  effect written(a: number): number!! {
    a += 0
    const bump = effect () => {
      const tick = try Effect.sync(() => a)
      return arguments[0]++
    }
    return try bump()
  }

  effect identity(a: number, step = 1) {
    const tick = try Effect.sync(() => step)
    const read = effect () => {
      const next = try Effect.sync(() => 0)
      return arguments
    }
    return try read() === arguments
  }
}
