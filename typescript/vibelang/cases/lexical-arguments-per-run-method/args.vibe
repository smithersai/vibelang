// A method whose parameters bind on every run (a default, a rest parameter
// or a parameter it writes) forwards its this and arguments to a generator
// that fnUntraced calls on each run. A nested Effect arrow that reads
// arguments reads that run's arguments object, not one shared by every run.
export class Counter {
  effect defaulted(a: number, step = 1): number!! {
    const bump = effect () => {
      const tick = try Effect.sync(() => step)
      return arguments[0]++
    }
    return try bump()
  }

  effect rest(...values: number[]): number!! {
    const bump = effect () => {
      const tick = try Effect.sync(() => values.length)
      return arguments[0]++
    }
    return try bump()
  }

  effect written(a: number): number!! {
    a += 0
    const bump = effect () => {
      const tick = try Effect.sync(() => a)
      return arguments[0]++
    }
    return try bump()
  }

  effect identity(a: number, step = 1) {
    const tick = try Effect.sync(() => step)
    const read = effect () => {
      const next = try Effect.sync(() => 0)
      return arguments
    }
    return try read() === arguments
  }
}
