// expect: EK0201 EK0201 EK0203 EK0203
// rule-evidence: docs/design/vips/tc39-do-expressions/README.md#d343b586e1079ca5
// rule-evidence: docs/design/vips/tc39-do-expressions/README.md#variable-statements-at-the-end | For the same declaration, the specific `do` errors replace `EK0107` (VIP-34): a final `var` reports `EK0201`, a `var` in a parameter list reports `EK0203`, and a final `var` in a parameter list reports both.
// A final var outside a parameter list: EK0201 only, never EK0107.
export function finalInBody() { return do { var n = 1 } }
export effect function finalInEffectBody() { return do { var n = 2 } }
// A nonfinal var in a parameter list: EK0203 only, never EK0107.
export function nonfinalInParameter(x = do { var n = 3; n }) { return x }
export const arrowParameter = (x = do { var n = 4; n }) => x
