// expect: EK4402
// Chapter 10 "Promises". fetch is a platform API, which D5 makes uncallable
// from .vibe code; D6 points at HttpClient instead. The function that
// Effect.tryPromise wraps is TypeScript, as the try hatch it replaced was
// (VIP-5), so only the call outside it is EK4402.

class HttpError extends TaggedError("HttpError")<{ readonly url: string; readonly cause: unknown }> {}

effect function fetchJson(url: string) {
  const pending = fetch(url)
  return try Effect.tryPromise({
    try: () => pending.then((response) => response.json()),
    catch: (cause) => new HttpError({ url, cause })
  })
}
