// expect-result: [["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Failure","TypeError"],["Success",7],["Success",9],["Success",11],["get","key","get","argument","argument","call:9","argument","call:11"]]
import { Effect } from "effect"
import { inspect } from "./inspect.js"
// rule-evidence: docs/design/src/008-runtime.md#unchecked-delegation | An unchecked result does not erase the callee's thrown contract: a call through `any` still needs a failure boundary, while a callable declared in `.vibe` outside a `module` body with an `any` result has thrown type `never`.
type Producer = (_n: number) => any
const events: string[] = []
function argument() { events.push("argument"); return 1 }
effect function fn(make: Producer | null | undefined) { return try make?.(argument()) }
effect function method(obj: { run?: Producer }) { return try obj.run?.(argument()) }
effect function receiver(obj: { run: Producer } | null | undefined) { return try obj?.run(argument()) }
effect function both(obj: { run?: Producer } | null | undefined) { return try obj?.run?.(argument()) }
effect function key(obj: { run?: Producer }) { return try obj[(events.push("key"), "run")]?.(argument()) }
effect function nested(make: Producer | null | undefined) { return try make?.(try Effect.sync(argument)) }
effect function block(make: Producer | null | undefined) { return try make?.(do { events.push("argument"); 1 }) }
export effect function main() {
 const missing = { get run(): any { events.push("get"); return undefined } }
 const present = { value: 9, run(_n: number) { events.push("call:" + this.value); return Effect.succeed(this.value) } }
 const viaNested: any = (_n: number) => { events.push("call:11"); return Effect.succeed(11) }
 return [
  inspect(try Effect.exit(fn(undefined))),
  inspect(try Effect.exit(fn(null))),
  inspect(try Effect.exit(method(missing))),
  inspect(try Effect.exit(receiver(undefined))),
  inspect(try Effect.exit(both(null))),
  inspect(try Effect.exit(key(missing))),
  inspect(try Effect.exit(nested(undefined))),
  inspect(try Effect.exit(block(undefined))),
  inspect(try Effect.exit(fn((_n: number) => Effect.succeed(7)))),
  inspect(try Effect.exit(method(present))),
  inspect(try Effect.exit(nested(viaNested))),
  events
 ]
}
