// expect: EK4503
// A member the service declares wins over the key's own members (D41), so
// reading one through the key is EK4503 even when the key, a class and an
// Effect Context key, has a member of the same name.
service Person { name: string }

export effect function readName() {
  provide Person = { name: "Ada" } {
    return Person.name
  }
}

service Shadowed {
  length: number
  prototype: string
  caller: string
  arguments: string
  call: string
  apply: string
  bind: string
  toString: string
  toLocaleString: string
  valueOf: string
  hasOwnProperty: string
  isPrototypeOf: string
  propertyIsEnumerable: string
  key: string
  pipe: string
  of: string
  use: string
  useSync: string
  context: string
  toJSON: string
  Service: string
  Identifier: string
}

service Named { name(): string!! }
service Plain { region: string }

export function length() { return Shadowed.length }
export function prototype() { return Shadowed.prototype }
export function caller() { return Shadowed.caller }
export function args() { return Shadowed.arguments }
export function call() { return Shadowed.call }
export function apply() { return Shadowed.apply }
export function bind() { return Shadowed.bind }
export function toString() { return Shadowed.toString }
export function toLocaleString() { return Shadowed.toLocaleString }
export function valueOf() { return Shadowed.valueOf }
export function hasOwnProperty() { return Shadowed.hasOwnProperty }
export function isPrototypeOf() { return Shadowed.isPrototypeOf }
export function propertyIsEnumerable() { return Shadowed.propertyIsEnumerable }
export function key() { return Shadowed.key }
export function pipe() { return Shadowed.pipe }
export function of() { return Shadowed.of }
export function use() { return Shadowed.use }
export function useSync() { return Shadowed.useSync }
export function context() { return Shadowed.context }
export function toJSON() { return Shadowed.toJSON }
export function service() { return Shadowed.Service }
export function identifier() { return Shadowed.Identifier }
export function nested() { return [1].map(() => Person.name) }
export function method() { return Named.name }

// Valid: a call, the implementation, the key's members that the service does
// not declare, and the module's top level, where the member rules do not apply (D90).
export effect function called() { return try Named.name() }
export effect function implementation() { return [(try Person()).name, (try Shadowed()).length, (try Shadowed()).key] }
export function keyMembers() { return [Plain.name, Plain.key] }
export const className = Person.name

// Valid: a local schema's interface extends Schema.Schema.Type, a type.
export effect function typed() {
  schema Local { value: string }
  return try Schema.decodeUnknownEffect(Local)({ value: "v" })
}
