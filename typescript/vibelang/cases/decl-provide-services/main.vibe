// expect-result: {"single":"hi","mixed":"Ada hi","module":7,"qualified":7,"both":"Ada 7","called":"Ada hi"}
// provide Key = value provides one service (D173). Every function here
// declares no dependencies (!!), so each provide block must remove the keys
// its body needs.
service Greeting {
  text(): string!!
}

service Names {
  name(): string!!
}

const NamesLive = Layer.succeed(Names, {
  effect name() { return "Ada" }
})

const fixedRandom = { nextIntUnsafe: (): number => 7, nextDoubleUnsafe: (): number => 0.25 }

effect function single(): string!! {
  provide Greeting = { text: effect () => "hi" } {
    return try Greeting.text()
  }
}

// Layers and services mix in one list.
effect function mixed(): string!! {
  provide NamesLive, Greeting = { text: effect () => "hi" } {
    return `${try Names.name()} ${try Greeting.text()}`
  }
}

// An effect module stands for its key of the same name: Random is Random.Random.
effect function module(): number!! {
  provide Random = fixedRandom {
    return try Random.nextInt()
  }
}

effect function qualified(): number!! {
  provide Random.Random = fixedRandom {
    return try Random.nextInt()
  }
}

effect function both(): string!! {
  provide NamesLive, Random = fixedRandom {
    return `${try Names.name()} ${try Random.nextInt()}`
  }
}

// The call shape means the same: provide(...) { ... } is provide ... { ... }.
effect function called(): string!! {
  provide(NamesLive, Greeting = { text: effect () => "hi" }) {
    return `${try Names.name()} ${try Greeting.text()}`
  }
}

export effect function main() {
  return { single: try single(), mixed: try mixed(), module: try module(), qualified: try qualified(), both: try both(), called: try called() }
}
