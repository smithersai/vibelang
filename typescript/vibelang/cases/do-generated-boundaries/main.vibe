}
function types() {
  const [x = do { 7 }] = [] as number[]
  const [y = do { 7 }] = [] as number[]
  const a: number = x
  const b: number = y
  return [a, b]
}
export function main() {
  const logs = Array.from({length: 8}, () => [] as string[])
  return Effect.succeed([
