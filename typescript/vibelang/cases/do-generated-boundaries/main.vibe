// expect-result: [[9,["start","closed"]],[7,["start","closed","after"]],[4,["start","closed","after"]],["close",["start","closed"]],["source",["start","closed"]],[12,["start","finally","closed"]],[null,["start","closed"]],[1,2,["start","closed","start","closed","start","closed"]],[7,7]]
import { holes, throwValue } from "./native-default-iterator.js"
function returned(log: string[]) {
  const [x = match (true) { default: do { return 9 }; }, y = log.push("wrong")] = holes(log)
  log.push("after")
  return x
}
function normal(log: string[], present: boolean) {
  const read = () => x
  const [x = match (true) { default: do { if (present) { return 99 }; 7 }; }] = holes(log, false, present)
  log.push("after")
  return read()
}
function closing(log: string[]) {
  try {
    const [x = do { return 9 }] = holes(log, true)
    return x
  } catch (e) { return e }
}
function throwing(log: string[], fail: boolean) {
