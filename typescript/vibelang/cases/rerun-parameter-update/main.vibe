// Reusing an Effect never reuses a parameter binding.
export const compact = (n: number): Effect<number, never, never> => ++n
export const expanded = (n: number): Effect<number, never, never> => {
  const result = ++n
  return result
}
export effect function declared(n: number): Effect<number, never, never> { return ++n }
export const expression = effect function (n: number): Effect<number, never, never> { return ++n }
export effect function declaredProgram(n: number): Effect<number, never, never> { return try Effect.succeed(++n) }
export const closure = (n: number): Effect<() => number, never, never> => () => ++n
