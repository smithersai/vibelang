// expect-result: [2,3]
// A forked program that handles its own control operations runs: its
// handler is installed on the child's fiber (chapter 9, "Handlers and
// concurrency").
control Ask { ask(): number!! }

function answered(n: number) {
  try {
    return try Ask.ask()
  } handle Ask.ask() {
    try resume(n)
  }
}

export function main() {
  const byName = fork answered(2)
  const block = fork {
    try {
      return try Ask.ask()
    } handle Ask.ask() {
      try resume(3)
    }
  }
  return [join byName, join block]
}
