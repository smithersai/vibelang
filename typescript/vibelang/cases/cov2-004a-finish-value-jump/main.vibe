import { Effect } from "effect"
function probe(): unknown {
  const log: string[] = []
  function* numbers() { try { yield 1; yield 2 } finally { log.push("closed") } }
  const value = match (numbers()) { when [let a, ...]: a; default: -1; }
  function first() { return match (numbers()) { when [let a, ...]: do { return a }; default: -1; } }
  return [value, first(), log]
}
export function main(): Effect.Effect<unknown> { return Effect.sync(probe) }
