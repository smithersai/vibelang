import { Context, Effect } from "effect"
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
export type Shape = { readonly value: string }
service Port: Shape { static readonly key = "coverage/Port" }
service DefaultPort: Shape {
  static readonly key = "coverage/DefaultPort"
  static readonly defaultValue = () => ({ value: "default" })
}
export const exact: Equal<Port.Shape, Shape> = true
export const defaultExact: Equal<DefaultPort.Shape, Shape> = true
export effect function main() {
  const a = try Effect.provideService(effect { return (try Port).value }, Port, { value: "provided" })
  return [a, (try DefaultPort).value, "Shape" in Port, "Shape" in DefaultPort]
}

