// expect: EK4402
// D310: Node.js reaches .vibe code only through Effect's services or by
// escaping to TypeScript. A value imported from a platform module is EK4402
// at the import, and a platform global is EK4402 wherever the code uses it:
// a call, a new, a tagged template, a property read, or a value held.
// Boundaries and the module's top level are no exception.
import { readFile } from "node:fs/promises"
import fs from "fs"
import * as os from "node:os"
import { createServer, type Server } from "node:http"
import { Effect } from "effect"
import { setup } from "./setup.ts"

export function load(path: string) {
  return try Effect.tryPromise(() => readFile(path, "utf8"))
}

export function exists(path: string) {
  return try Effect.sync(() => fs.existsSync(path))
}

export function cores() {
  return try Effect.sync(() => os.cpus().length)
}

export function signals() {
  return Object.keys(os.constants.signals)
}

export function get(url: string) {
  return try Effect.tryPromise(() => fetch(url))
}

export function later() {
  return try Effect.promise(() => new Promise((resolve) => setTimeout(resolve, 10)))
}

export function log(message: string) {
  console.log(message)
}

export function port() {
  const { env } = process
  return env.PORT
}

export function socket(url: string) {
  return new WebSocket(url)
}

// Allowed: a type from a platform module, and web standards. The imports
// above already report createServer and os.
export const configured = setup(createServer, os.EOL)

export function serve(server: Server) {
  return server
}

export function host(url: string) {
  return new URL(url).host
}

export function size(text: string) {
  return new TextEncoder().encode(text).length
}
