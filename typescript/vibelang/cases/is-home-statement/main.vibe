// expect: EK0705
// Unbraced bodies cannot host lexical is bindings; the repair adds a written block.
export function initializer(x: unknown) {
  const id = (x is { id: let found }) ? found : 0
  return id
}
export function returned(x: unknown) {
  return x is { id: let id } && id === 1
}
export const concise = (x: unknown) => x is { id: let id } && id === 2
export effect function thrown(x: { message: string } | null) {
  return (effect {
    throw (x is { message: let message }) ? new Error(message) : new Error("none")
  }) catch (e) => e.message
}
export function unbraced(x: unknown) {
  if (typeof x === "object") return x is { n: let n } && typeof n === "number" ? n : -1
  return -1
}
export class Counted {
  static count = 0
  static {
    const start = ({ n: 4 } is { n: let n }) ? n : 0
    Counted.count = start
  }
}
export function expressionStatement(x: { a: number; b: number } | null) {
  let total = 0
  x is { a: let a, b: let b } && (total = a + b)
  return total
}
export effect function main() {
  return [
    initializer({ id: 1 }),
    initializer({}),
    returned({ id: 1 }),
    returned({ id: 2 }),
    concise({ id: 2 }) ? 2 : 0,
    try thrown(null),
    unbraced({ n: 3 }),
    Counted.count,
    expressionStatement({ a: 3, b: 4 }),
  ]
}

// Manual forms retain their compiler contracts without automatic repairs.
// rule-evidence: docs/design/src/900-appendices.md#appendix-b-diagnostics | | `EK0705` | an `is` lexical binding in an unbraced statement body (matching `TS1156`; add braces), or one that would need formal-parameter or catch-parameter initialization as its home; use an explicit local block preserving the intended result and call phase; also a binding in an `enum` member initializer, which has no lexical home | 7 | [Pattern matching](004-match.md#is-bindings-in-parameter-initialization) |

export function explicitPatternHome(value: unknown) {
  { if (value is { id: let id }) return id }
  return undefined
}
