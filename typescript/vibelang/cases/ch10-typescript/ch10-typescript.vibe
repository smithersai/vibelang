import * as $nativeTryEffect3 from "effect/Effect";
import * as $nativeTryEffect2 from "effect/Effect";
import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// Chapter 10. Working with TypeScript.
import {
  Database,
  DatabaseTest,
  DbError,
  fetchGreeting,
  findUser,
  formatName,
  loadAvatar,
  parsePort,
  parsePortTrusted,
  StorageTest,
  UserNotFound,
  type User
} from "./ch10-helpers.ts"

class ConfigError extends TaggedError("ConfigError")<{ readonly cause: unknown }> {}
class HttpError extends TaggedError("HttpError")<{ readonly url: string; readonly cause: unknown }> {}

interface Config {
  port: number
}

service Users {
  find(id: string): Effect<User, UserNotFound, never>
}

// Using TypeScript Effect code from VibeLang

export effect function title(id: string) {
  return (try findUser(id)).name.toUpperCase()
}
// Effect<string, UserNotFound | DbError, Database>

// Services written as Context.Service classes in TypeScript are used like .vibe services.
effect function rowCount(id: string) {
  return (try (try Database).query("select * from users where id = $1", [id])).length
}

// Generator-style code stays in TypeScript: see ch10-effect-gen.fail.vibe (EK1002).

// Plain functions

effect function parseConfig(text: string) {
  return try Effect.try({
    try: () => JSON.parse(text) as Config,
    catch: (cause) => new ConfigError({ cause })
  })
}
// Effect<Config, ConfigError, never>

// Chapter 2's profileCard. NOTE: D5 makes the proposal's bare `formatName(user)` an error (EK4401,
// see ch02-plain-ts-call.fail.vibe), so the plain call is wrapped in Effect.try; the claim below is the
// proposal's, from before D5.
effect function profileCard(id: string) {
  const user = try (try Users).find(id)
  return {
    title: try Effect.try(() => formatName(user)),   // a plain call behind a boundary
    avatar: try loadAvatar(user.id)                  // returns an Effect, so the call runs it
  }
}
// Effect<{ title: string; avatar: Avatar }, UserNotFound | AvatarError, Users | Storage>

// A throwing plain function behind a boundary, with the typed failure caught.
effect function portOrDefault(text: string) {
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try Effect.try({ try: () => parsePort(text), catch: (cause) => new ConfigError({ cause }) })) };
  }, effect (e) => {
    return { kind: "return:" as const, value: (80) };
  });
return $nativeTryCompletion.value;
}
}

// D249: a TypeScript function with a trusted contract, a trusted(impl, [PortError]) value, is
// called bare; its listed class joins E.
effect function portFrom(text: string) {
  return parsePortTrusted(text)
}
// Effect<number, PortError, never>

// Promises
// NOTE: the proposal calls fetch, a platform API (D5: EK4402, see ch10-fetch.fail.vibe); a local
// Promise-returning helper stands in for it.
effect function fetchJson(url: string) {
  const response = try Effect.tryPromise({
    try: () => fetchGreeting(url),
    catch: (cause) => new HttpError({ url, cause })
  })
  return response.greeting
}

// Callbacks into plain JavaScript (the rejected callback is ch10-map-pausing-callback.fail.vibe)

function trimAll(ids: ReadonlyArray<string>) {
  const trimmed = ids.map((id) => id.trim())         // fine
  return trimmed
}

const UsersTest = Layer.succeed(Users, {
  find: effect (id) => ({ id, name: "Ada", email: "ada@example.com" })
})

effect function scenario() {
  const upper = try title("1")
  let missing = "none"
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    try title("2")
  
;return { kind: "normal" } as const;
}, effect (e) => {
    missing = e._tag
  
;return { kind: "normal" } as const;
});

}
  const rows = try rowCount("1")
  const config = try parseConfig(`{"port":8080}`)
  let badConfig = "none"
  { const $nativeTryCompletion2 = try $nativeTryEffect2.catch(effect {
    try parseConfig("{")
  
;return { kind: "normal" } as const;
}, effect (e) => {
    badConfig = e._tag
  
;return { kind: "normal" } as const;
});

}
  const card = try profileCard("1")
  const defaultPort = try portOrDefault("x")
  const trustedPort = try portFrom("9090")
  let badPort = "none"
  { const $nativeTryCompletion3 = try $nativeTryEffect3.catch(effect {
    try portFrom("x")
  
;return { kind: "normal" } as const;
}, effect (e) => {
    badPort = e._tag
  
;return { kind: "normal" } as const;
});

}
  const greeting = try fetchJson("ada")
  const trimmed = trimAll([" a ", "b "])
  return { upper, missing, rows, port: config.port, badConfig, card, defaultPort, trustedPort, badPort, greeting, trimmed }
}

// expect-result: {"upper":"ADA","missing":"UserNotFound","rows":1,"port":8080,"badConfig":"ConfigError","card":{"title":"Ada <ada@example.com>","avatar":{"userId":"1","url":"https://img.example.com/1.png"}},"defaultPort":80,"trustedPort":9090,"badPort":"PortError","greeting":"hello ada","trimmed":["a","b"]}
export effect function main() {
  return try Effect.provide(effect { return try scenario() }, Layer.mergeAll(DatabaseTest, StorageTest, UsersTest))
}
