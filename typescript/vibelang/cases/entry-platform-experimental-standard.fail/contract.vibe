// expect: EK2002
// Effect's NodeServices.layer provides Effect's FileSystem, not the
// experimental one (D313), so a contract that needs nothing is wrong.
import { NodeServices } from "@effect/platform-node"

export effect function executable(path: string): void!PlatformError! {
  provide NodeServices.layer {
    try Experimental.FileSystem.access(path, { executable: true })
  }
}
