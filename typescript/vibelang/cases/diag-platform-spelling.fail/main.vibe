// expect: TS2304 TS2552
// Process is not in scope: its module is Experimental.Process.
// The note shows an explicit service lookup, Effect run and provider.
// TypeScript would suggest Node's process, which EK4402 bans in
// .vibe code. A TypeScript hatch keeps ordinary spelling suggestions,
// so its misspelling still suggests process.
export function host() {
  return Process.hostname()
}

export effect function pid() {
  return try sync(() => proces.pid)
}

export function exclusive() {
  return Locks.hold("a")
}
