{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "out",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "schema/*.vibe",
    "query/*.ts"
  ],
  "vibelang": {
    "declarationImportStyle": ".ts"
  }
}
