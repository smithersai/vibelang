// expect: EK0501
// Chapter 11 "Where programs start": try loadConfig() runs a program, but a module's top level is
// ordinary JavaScript, not an effect function (VIP-26). Without try, loadConfig() builds the
// Effect unrun (VIP-1).

interface AppConfig {
  port: number
}

effect function loadConfig() {
  try Effect.sleep("1 millis")
  const config: AppConfig = { port: 8080 }
  return config
}

export const config = try loadConfig()
