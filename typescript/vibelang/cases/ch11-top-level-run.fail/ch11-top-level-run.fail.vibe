// expect: EK1001
// Chapter 11 "Where programs start": loadConfig() runs a program, but a module's top level is not
// inside one.

interface AppConfig {
  port: number
}

effect function loadConfig() {
  try Effect.sleep("1 millis")
  const config: AppConfig = { port: 8080 }
  return config
}

export const config = loadConfig()
