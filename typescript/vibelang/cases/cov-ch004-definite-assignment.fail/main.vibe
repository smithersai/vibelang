// expect: TS2454 TS2448
// Chapter 004, definite-assignment: docs/design/src/004-match.md#1dc52fa39ccfe037
// Chapter 004, definite-assignment: docs/design/src/004-match.md#ea4df5ee858d4974
// Chapter 004, definite-assignment: docs/design/src/004-match.md#da86b43a622f9060
// A number binding requires TS2454; any/unknown follow native TypeScript exemptions.
export function read(s: number[]) { if (s is [1, let value]) return value; return value; }
export function before(s: unknown) { const early = value; const ok = s is let value; return [ok, early]; }

// Chapter 004 rule: These bindings take part in TypeScript's definite-assignment and use-before-declaration checks, as a `let` assigned where the pattern runs would.

// Chapter 004 rule: A read on a path where the binding may not have run, because short-circuiting skipped it or the pattern failed before reaching it, is `TS2454`; a read before the binding's position in its scope is `TS2448`.

// Chapter 004 rule: Conversely, in `if (s is [1, let value]) { use(value) }`, the enclosing block contains `value`, but a failure of the first element can leave a later read in TDZ.
