// Chapter 002: Effect block internal jumps
import { Effect } from "effect"
export effect function main() {
 const a = try effect { let n = 0; for (let i=0;i<4;i++) { if(i===1) continue; if(i===3) break; n += i }; return try Effect.succeed(n) }
 const b = try (effect () => { return try Effect.succeed(2) })()
 return [a,b]
}
