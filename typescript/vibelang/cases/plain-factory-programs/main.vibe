// expect-result: [0,7,7,2,11,11,4,13,5,11,6]
import { makeRuntime, stored, runs, useIt, useGenericFactory } from "./program.vibe"
export function main() {
  const before = runs
  const localFactory = (options: { n: number }): infer _ => {
    const p: Effect.Effect<{ n: number }, never, never> = () => {
      const service = try makeRuntime(options)
      return service
    }
    return p
  }
  const service = try localFactory({ n: 7 })
  const again = try localFactory({ n: 7 })
  const afterLocal = runs
  const firstStored = try stored()
  const secondStored = try stored()
  const afterStored = runs
  const directResult = try useIt({ n: 13 })
  const afterDirect = runs
  const genericResult = try useGenericFactory()
  return [before, service.n, again.n, afterLocal, firstStored.n, secondStored.n, afterStored, directResult, afterDirect, genericResult, runs]
}
