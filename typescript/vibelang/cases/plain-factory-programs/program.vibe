export let runs = 0
export const makeRuntime = (options: { n: number }): infer _ => {
  const n = options.n
  const p: Effect.Effect<{ n: number }, never, never> = () => {
    runs++
    return { n }
  }
  return p
}
// D262, D500: importing this module holds a program without running it; each
// run calls makeRuntime and runs the program it returns.
export const stored: Effect.Effect<{ n: number }, never, never> = () => makeRuntime({ n: 11 })

// This body has no other Effect operation to force generator lowering.
export function useIt(options: { n: number }): number!! {
  const service = try makeRuntime(options)
  return service.n
}

function identity<A>(value: A): A {
  const p: A = value
  return p
}
// The instantiated call type, rather than the generic's plain body, decides.
export function useGenericFactory() {
  const service = try identity(stored)
  return service.n
}
