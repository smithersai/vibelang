export let runs = 0
export const makeRuntime = (options: { n: number }): infer _ => {
  const n = options.n
  const p: Effect.Effect<{ n: number }, never, never> = effect {
    runs++
    return { n }
  }
  return p
}
// Importing this module holds a program without running it; each run calls
// makeRuntime and runs the program it returns with try (VIP-1, VIP-5).
export const stored: Effect.Effect<{ n: number }, never, never> = effect { return try makeRuntime({ n: 11 }) }

export effect function useIt(options: { n: number }): number!! {
  const service = try makeRuntime(options)
  return service.n
}

function identity<A>(value: A): A {
  const p: A = value
  return p
}
// identity is plain: it returns stored unrun, and try runs it.
export effect function useGenericFactory() {
  const service = try identity(stored)
  return service.n
}
