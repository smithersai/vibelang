// VIP-6 native-fork-options
export effect function main(){
 const n=4
 const a=try Effect.forkChild(Effect.succeed(n),{startImmediately:true})
 const b=try Effect.forkChild(Effect.succeed(n+1),{uninterruptible:"inherit"})
 return [join a,join b]
}
// VIP-6 native-fork-options
