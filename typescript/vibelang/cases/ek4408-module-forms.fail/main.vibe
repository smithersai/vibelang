// expect: EK4408 EK4408 EK4408 EK4408 TS1203
// A module declaration stands at a file's top level, is not exported, and
// is declared once (D283). In a .vibe file module never means a namespace,
// and a module's body is an ES module.
export module shared {
  export const one = 1
}

module text {
  export const two = 2
}

module text {
  export const three = 3
}

module legacy {
  const value = 4
  export = value
}

declare module ambient {
  export const four: number
}

function nested() {
  module inner {
    export const five = 5
  }
  return 5
}

import { two } from text

export function main() {
  return two + nested()
}
