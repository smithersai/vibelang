import "vibelang/platform/node"
error A { n: number }
error B { n: number }
const e = { n: 100 }
effect function fail(n: number): number!A | B {
  if (n === 1) throw new A({ n: 1 })
  throw new B({ n: 2 })
}
effect function recover(n: number) {
  return try Effect.catchTags(fail(n), {
    A: effect (e) => e.n,
    B: effect () => e.n
  })
}
effect function nested(n: number) {
  return try Effect.catchTags(fail(n), {
    A: effect (problem) => ({ problem }).problem.n + try (effect (problem: number) => problem)(10),
    B: effect (other) => e.n + other.n - other.n
  })
}
export effect function main() {
  try Console.log(try recover(1), try recover(2))
  try Console.log(try nested(1), try nested(2))
}
