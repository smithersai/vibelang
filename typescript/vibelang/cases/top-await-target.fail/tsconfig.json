{
  "compilerOptions": {
    "target": "ES2016",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": [],
    "rewriteRelativeImportExtensions": true,
    "outDir": "out"
  },
  "include": [
    "*.vibe"
  ],
  "vibe": {
    "effectGlobals": false,
    "effectModules": false
  }
}
