// expect: EK0403
// opencode stats/core geo.ts: a guard proves a property, then a plain TypeScript
// call reads it. Effect.try's function does not know what the guard proved.
import { double } from "./plain.ts"

type Options = { readonly p?: number }

export const ternary = effect (o: Options) => {
  return o.p ? double(o.p) : 0
}

export const nested = effect (o: Options, n: number) => {
  const v = o.p ? double(o.p) : n > 0 ? double(n) : double(0)
  return v
}

export const both = effect (o: Options) => {
  return o.p !== undefined && double(o.p) > 0
}

export const block = effect (o: Options) => {
  if (o.p) {
    const r = double(o.p)
    return r
  }
  return 0
}

export const early = effect (o: Options) => {
  if (!o.p) return 0
  return double(o.p)
}
