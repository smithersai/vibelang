// expect-result: {"plainOnce":"number","effectOnce":"effect","count":1,"stored":[[2,4],[2,4]],"held":105,"picked":42,"built":0,"ran":7,"runs":3,"unions":[-4,-4]}
// Conformance probes of written forms (D500, Chapter 30): each compiles with
// the meaning its text gives, and no effect runs more or fewer times than
// its source says.
import { once } from "./helpers.ts"

let count = 0
let runs = 0
function double(n: number): number {
  return n * 2
}
function unannotatedDouble(n: number) {
  return n * 2
}
function triple(n: number) {
  return n * 3
}
function logged(n: number) {
  runs++
  return n + 100
}
const load: number!! = effect {
  runs++
  return 42
}
function pick(p: number!!): infer _ {
  return p
}
effect function work(): number!! {
  runs++
  return 7
}

// Stored functions keep the form they were declared with.
const twin = double
const api = { double }

export effect function main() {
  // A literal where both forms fit is plain unless its annotation says Effect.
  const plainOnce = once(() => {
    count++
    return count
  })
  const effectOnce = once(effect (): number!! => {
    count++
    return count
  })
  // A holder of Effect functions runs the one it holds, once.
  let g = unannotatedDouble
  g = logged
  const held = g(5)
  // A plain function returning a program: a VibeLang call runs it, once.
  const picked = pick(load)
  // An arrow holds a program: building it runs nothing, calling it runs once.
  const before = runs
  const p = effect () => try try work()
  const built = runs - before
  const ran = try p()
  // A union of functions of one form calls the one chosen, in that form.
  const unions = [(ran > 0 ? unannotatedDouble : triple)(-2), (ran > 0 ? double : Math.abs)(-2)]
  return { plainOnce, effectOnce, count, stored: [[1, 2].map(twin), [1, 2].map(api.double)], held, picked, built, ran, runs, unions }
}
