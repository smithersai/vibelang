// expect: EK4401
// Chapter 2 "Calling TypeScript", verbatim. formatName is a plain TypeScript function
// ((user: User) => string). D5 makes a bare call to it an error: it needs Effect.try or a
// trusted contract. loadAvatar returns an Effect, so that call is fine.

import { formatName, loadAvatar, UserNotFound, type User } from "./ch10-helpers.ts"

abstract class Users {
  abstract find(id: string): Effect<User, UserNotFound, never>
}

function profileCard(id: string) {
  const user = try Users.find(id)
  return {
    title: formatName(user),                 // a plain call
    avatar: try loadAvatar(user.id)              // returns an Effect, so the call runs it
  }
}
// Effect<{ title: string; avatar: Avatar }, UserNotFound | AvatarError, Users | Storage>
