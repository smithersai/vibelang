// try runs a value whose type is an Effect (VIP-5). An Exit, a union of two
// Effects, replays its outcome, and throw fails with a tagged error instance
// (VIP-4). A plain call that returns such a value returns data.
import { Data, Effect, Exit } from "effect"

class EmptyDocument extends Data.TaggedError("EmptyDocument")<{ readonly documentId: string }> {}

export effect function replay<A, E>(outcome: Exit.Exit<A, E>) {
  return try outcome
}

function emptyDocumentError(documentId: string) {
  return new EmptyDocument({ documentId })
}

export effect function rejectDocument(documentId: string) {
  const error = emptyDocumentError(documentId) // data, not a failure
  throw error // throw fails with it
}

type Equals<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
export const replayType: Equals<ReturnType<typeof replay<number, string>>, Effect.Effect<number, string, never>> = true
export const rejectType: Equals<ReturnType<typeof rejectDocument>, Effect.Effect<never, EmptyDocument, never>> = true

// expect-result: {"value":42,"replayedFailure":"EmptyDocument d1","rejection":"EmptyDocument d2"}
export effect function main() {
  const value = try replay(try sync((): Exit.Exit<number> => Exit.succeed(42)))
  const replayedFailure = try Effect.flip(effect { return try replay(try sync((): Exit.Exit<never, EmptyDocument> => Exit.fail(new EmptyDocument({ documentId: "d1" })))) })
  const rejection = try Effect.flip(effect { return try rejectDocument("d2") })
  return {
    value,
    replayedFailure: `${replayedFailure._tag} ${replayedFailure.documentId}`,
    rejection: `${rejection._tag} ${rejection.documentId}`
  }
}
