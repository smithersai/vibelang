      (super.tag satisfies Tag)`x${mark("substitution")}`,
      (<Tag>super.tag)`x${mark("substitution")}`,
      (((super.tag as Tag)!) satisfies Tag)`x${mark("substitution")}`,
      super[(mark("key"), "tag")]`x${mark("substitution")}`,
      super[(mark("key"), "tag")]!`x${mark("substitution")}`,
      (super[(mark("key"), "tag")])`x${mark("substitution")}`,
      (super[(mark("key"), "tag")] as Tag)`x${mark("substitution")}`,
      (super[(mark("key"), "tag")] satisfies Tag)`x${mark("substitution")}`,
      (<Tag>super[(mark("key"), "tag")])`x${mark("substitution")}`,
      (((super[(mark("key"), "tag")] as Tag)!) satisfies Tag)`x${mark("substitution")}`
    ]
    const optional = (super.method as Method)?.(mark("optional-arg"))
    const absent = (super.absent!)?.(mark("must-not-run"))
    const detached = ((mark("detach"), super.method) as Method)(mark("detached-arg"))
    const declaredOptional = super.optionalMethod!(2)
    const generic = (super.generic<number>)(2)
    return { calls, tags, optional, absent: absent === undefined, detached, generic, declaredOptional }
  }
