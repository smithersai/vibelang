// VIP-1 Bindings: erased wrappers keep the native super Reference.
type Method = (value: number) => number
type Tag = (parts: TemplateStringsArray, value: number) => number
const events: string[] = []
let poisonReads = 0
function mark(name: string) { events.push(name); return 2 }
function method(this: { n: number } | undefined, value: number) {
  events.push("method")
  return (this?.n ?? -1000) + value
}
function tag(this: { n: number } | undefined, parts: TemplateStringsArray, value: number) {
  events.push("tag")
  return (this?.n ?? -1000) + value + Number(Object.isFrozen(parts) && parts.raw[0] === "x")
}
for (const fn of [method, tag]) {
  for (const key of ["call", "apply", "bind"]) {
    Object.defineProperty(fn, key, { get() { poisonReads++; return () => -999 } })
  }
}
