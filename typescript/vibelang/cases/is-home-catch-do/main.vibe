// expect-result: [1,true]
// VIP-5 keeps statement catches in plain code; VIP-7 supplies a local do home.
import { raise } from "./foreign.js"
export function caught(value: any, n: number) {
  const result: unknown[] = []
  try { raise(value) } catch ({ code = do { const ok = (n is let c); result.push(c); ok } }: any) { result.push(code) }
  return result
}
export effect function main() { return caught({}, 1) }
