// A service with `static readonly defaultValue` is a Context.Reference (D40):
// code that uses it needs no provider, so it never joins R, and
// Effect.provideService overrides it for a region. Factories and layers
// are declared beside the service.
import { Effect, Layer } from "effect"

interface Session {
  user: string
}

service Sessions {
  get(token: string): Effect.Effect<Session | undefined, never, never>
  set(token: string, session: Session): Effect.Effect<void, never, never>

}

function makeSessions(): Sessions.Shape {
  const entries = new Map<string, Session>()
  const impl: Sessions.Shape = {
    get: effect (token: string) => try Effect.succeed(entries.get(token)),
    set: effect (token: string, session: Session) => try Effect.sync(() => { entries.set(token, session) })
  }
  return impl
}

const SessionsLive = Layer.sync(Sessions, () => makeSessions())

service FeatureFlags {
  readonly newCheckout: boolean
  static readonly defaultValue: () => FeatureFlags.Shape = () => ({ newCheckout: false })
}

export effect function checkoutPage(cartId: string) {
  return (try FeatureFlags).newCheckout ? `new ${cartId}` : `classic ${cartId}`
}

export effect function login(user: string) {
  try Sessions.set("t1", { user })
  const session = try Sessions.get("t1")
  return session?.user ?? "nobody"
}

// expect-result: {"classic":"classic c1","fresh":"new c2","session":"ada"}
export effect function main() {
  return {
    classic: try checkoutPage("c1"),
    fresh: try Effect.provideService(effect { return try checkoutPage("c2") }, FeatureFlags, { newCheckout: true }),
    session: try Effect.provide(effect { return try login("ada") }, SessionsLive)
  }
}
