// expect: TS2345
// A function literal never turns into a program because a parameter expects
// an Effect (VIP-2), so pipe is Effect's ordinary function however it is
// imported: a stage that takes an Effect rejects a function, and a stage that
// takes anything gets the function.
import { pipe as flow } from "effect"
import * as Fn from "effect/Function"

effect function task() {
  try yieldNow()
  return 7
}

function inspect(value: number!!): string
function inspect(value: unknown): string
function inspect(value: unknown): string {
  return Effect.isEffect(value) ? "program" : "function"
}

export function main() {
  return [
    flow(effect () => try task(), Effect.retry({ times: 0 })),
    Fn.pipe(effect () => try task(), Effect.retry({ times: 0 })),
    flow(effect () => 5, inspect)
  ]
}
