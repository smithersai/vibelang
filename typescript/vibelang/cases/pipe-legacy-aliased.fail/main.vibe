// expect: TS2345 EK1023
// Effect's pipe is recognized by the declaration its callee resolves to, not
// its spelling: imported as flow, or read as Function.pipe, a pipe whose
// first argument VibeLang 0.0.10 made a program by look-ahead gets the same
// migration diagnostics as pipe.
import { pipe as flow } from "effect"
import * as Fn from "effect/Function"

function task() {
  try yieldNow()
  return 7
}

function inspect(value: number!!): string
function inspect(value: unknown): string
function inspect(value: unknown): string {
  return Effect.isEffect(value) ? "program" : "function"
}

export function main() {
  return [
    flow(() => task(), Effect.retry({ times: 0 })),
    Fn.pipe(() => task(), Effect.retry({ times: 0 })),
    flow(() => 5, inspect)
  ]
}
