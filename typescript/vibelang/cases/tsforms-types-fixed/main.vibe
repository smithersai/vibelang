// expect-result: {"loaded":3,"checked":"ok","held":"held","callback":4,"maybe":5,"nested":6,"kept":7}
// An Effect type written with its type arguments draws EK4833 (D287); its
// fix writes the ! form, which the parser expands to the same type. In a
// return annotation too, an omitted slot is never. Explicit infer channels
// keep their long form. The directive keeps one qualified spelling.
// tsforms-types-fixed is what vibelang --fix writes.
error Missing { id: string }

effect function load(id: string): number!Missing {
  if (id === "") throw new Missing({ id })
  return id.length
}

effect function checked(program: number!Missing): Effect.Effect<string, never, infer R> {
  const n = program catch () => -1
  return n >= 0 ? "ok" : "missing"
}

const held: string!! = effect { return "held" }
const six: number!! = effect { return 6 }

type Callback = (n: number) => number!!
const callback: Callback = effect (n) => n + 1

effect function maybe(program: (number!!) | undefined): number!! {
  return program === undefined ? 0 : try program
}

effect function nested(program: (number!!)!!): number!! {
  const inner = try program
  return try inner
}

effect function kept(
  // @vibelang-diagnostics-next-line EK4833:off
  program: Effect.Effect<number>
): number!! {
  return try program
}

export effect function main() {
  return {
    loaded: try load("abc"),
    checked: try checked(load("x")),
    held: try held,
    callback: try callback(3),
    maybe: try maybe(Effect.succeed(5)),
    nested: try nested(Effect.succeed(six)),
    kept: try kept(Effect.succeed(7))
  }
}
