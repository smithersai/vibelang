// expect-result: {"loaded":3,"checked":"ok","held":"held","callback":4,"maybe":5,"nested":6,"kept":7}
// An Effect type written with its type arguments draws EK4833 (D287); its
// fix writes the ! form, which the parser expands to the same type. In a
// return annotation too, an omitted slot is never. Explicit infer channels
// keep their long form. The directive keeps one qualified spelling.
// tsforms-types-fixed is what vibelang --fix writes.
error Missing { id: string }

function load(id: string): number!Missing {
  if (id === "") throw new Missing({ id })
  return id.length
}

function checked(program: number!Missing): Effect.Effect<string, never, infer R> {
  const n = program() catch -1
  return n >= 0 ? "ok" : "missing"
}

const held: string!! = Effect.sync(() => "held")
const six: number!! = Effect.sync(() => 6)

type Callback = (n: number) => number!!
const callback: Callback = (n) => n + 1

function maybe(program: (number!!) | undefined): number!! {
  return program === undefined ? 0 : program()
}

function nested(program: (number!!)!!): number!! {
  const inner = program()
  return inner()
}

function kept(
  // @vibelang-diagnostics-next-line EK4833:off
  program: Effect.Effect<number>
): number!! {
  return program()
}

export function main() {
  return {
    loaded: load("abc"),
    checked: checked(load("x")),
    held: held(),
    callback: callback(3),
    maybe: maybe(Effect.succeed(5)),
    nested: nested(Effect.succeed(six)),
    kept: kept(Effect.succeed(7))
  }
}
