// expect-result: {"described":["waiting","parcel-8 by post","rejected: no address (none)"],"loads":[0,3,7],"sent":true,"same":true,"different":false,"matched":"parcel-8","guard":[false,true],"note":"left at the door","fromObject":["parcel-8","none"]}
// data declares a tagged union with Effect's own Data.TaggedEnum (D307): the
// type, the constructors, $is, $match and structural equality are Effect's,
// and a match narrows a tag pattern to its variant.

/** A parcel on its way. */
export data Delivery {
  Waiting
  /** Handed to the carrier. */
  Sent { tracking: string; carrier?: string }
  Rejected { reason: string; note?: string }
}

export data LoadState<A, E> {
  Idle
  Loaded { value: A }
  Failed { error: E }
}

// A match without default covers every variant. An optional field is read from
// the narrowed subject: a `let` binding would require the field to be present.
export function describe(delivery: Delivery) {
  return match (delivery) {
    when { _tag: "Waiting" }: "waiting";
    when { _tag: "Sent", let tracking }: `${tracking} by ${delivery.carrier ?? "post"}`;
    when { _tag: "Rejected", let reason }: `rejected: ${reason} (${delivery.note ?? "none"})`;
  }
}

function size(state: LoadState<ReadonlyArray<string>, string>) {
  return match (state) {
    when { _tag: "Idle" }: 0;
    when { _tag: "Loaded", let value }: value.length;
    when { _tag: "Failed", let error }: error.length;
  }
}

// A tag pattern's other properties can hold patterns of their own.
function noted(delivery: Delivery) {
  return match (delivery) {
    when { _tag: "Rejected", reason: "absent" }: delivery.note ?? "";
    default: "";
  }
}

// A subject of no tagged type narrows through the data type's own $is guard.
function trackingOf(value: object) {
  if (Delivery.$is("Sent")(value)) return value.tracking
  return "none"
}

export effect function main() {
  const waiting = Delivery.Waiting()
  const sent = Delivery.Sent({ tracking: "parcel-8" })
  const rejected = Delivery.Rejected({ reason: "no address" })
  for (const delivery of [waiting, sent, rejected]) try Console.log(describe(delivery))
  let matched = ""
  // is narrows: sent.tracking is a string in the branch.
  if (sent is { _tag: "Sent" }) matched = sent.tracking
  const isRejected = Delivery.$is("Rejected")
  return {
    described: [describe(waiting), describe(sent), describe(rejected)],
    loads: [size(LoadState.Idle()), size(LoadState.Loaded({ value: ["a", "b", "c"] })), size(LoadState.Failed({ error: "offline" }))],
    sent: sent is { _tag: "Sent" },
    same: Equal.equals(sent, Delivery.Sent({ tracking: "parcel-8" })),
    different: Equal.equals(sent, Delivery.Sent({ tracking: "parcel-9" })),
    matched,
    guard: [isRejected(sent), isRejected(rejected)],
    note: noted(Delivery.Rejected({ reason: "absent", note: "left at the door" })),
    fromObject: [trackingOf(sent), trackingOf({ tracking: "unsent" })]
  }
}
