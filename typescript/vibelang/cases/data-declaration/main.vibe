// expect-result: {"described":["waiting","parcel-8 by post","rejected: no address (none)"],"loads":[0,3,7],"sent":true,"same":true,"different":false,"matched":"parcel-8","guard":[false,true],"note":"left at the door","fromObject":["parcel-8","none"]}
// data declares a tagged union with Effect's own Data.TaggedEnum (D307): the
// type, the constructors, $is, $match and structural equality are Effect's,
// and match narrows a variant pattern by its tag.

/** A parcel on its way. */
export data Delivery {
  Waiting
  /** Handed to the carrier. */
  Sent { tracking: string; carrier?: string }
  Rejected { reason: string; note?: string }
}

export data LoadState<A, E> {
  Idle
  Loaded { value: A }
  Failed { error: E }
}

// A match without default covers every variant, so its last arm needs no test (D294).
export function describe(delivery: Delivery) {
  return match (delivery) {
    when Delivery.Waiting: "waiting";
    when Delivery.Sent { let tracking, let carrier }: `${tracking} by ${carrier ?? "post"}`;
    when Delivery.Rejected { let reason, let note }: `rejected: ${reason} (${note ?? "none"})`;
  }
}

function size(state: LoadState<ReadonlyArray<string>, string>) {
  return match (state) {
    when LoadState.Idle: 0;
    when LoadState.Loaded { let value }: value.length;
    when LoadState.Failed { let error }: error.length;
  }
}

// A variant's fields can hold patterns of their own.
function noted(delivery: Delivery) {
  return match (delivery) {
    when Delivery.Rejected { reason: "absent", let note }: note ?? "";
    default: "";
  }
}

// A subject of no tagged type narrows to the variant's values.
function trackingOf(value: object) {
  if (value is Delivery.Sent) return value.tracking
  return "none"
}

export function main() {
  const waiting = Delivery.Waiting()
  const sent = Delivery.Sent({ tracking: "parcel-8" })
  const rejected = Delivery.Rejected({ reason: "no address" })
  for (const delivery of [waiting, sent, rejected]) try Console.log(try describe(delivery))
  let matched = ""
  // is narrows: sent.tracking is a string in the branch.
  if (sent is Delivery.Sent) matched = sent.tracking
  const isRejected = Delivery.$is("Rejected")
  return {
    described: [try describe(waiting), try describe(sent), try describe(rejected)],
    loads: [try size(LoadState.Idle()), try size(LoadState.Loaded({ value: ["a", "b", "c"] })), try size(LoadState.Failed({ error: "offline" }))],
    sent: sent is Delivery.Sent,
    same: Equal.equals(sent, Delivery.Sent({ tracking: "parcel-8" })),
    different: Equal.equals(sent, Delivery.Sent({ tracking: "parcel-9" })),
    matched,
    guard: [isRejected(sent), isRejected(rejected)],
    note: try noted(Delivery.Rejected({ reason: "absent", note: "left at the door" })),
    fromObject: [try trackingOf(sent), try trackingOf({ tracking: "unsent" })]
  }
}
