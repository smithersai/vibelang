export function plain(x:unknown):unknown {
  if (x is { id:let $id }) return $id
  return 0
}
export function constant(x:unknown):unknown {
  if (x is { id:const $$id }) return $$id
  return 0
}
export function escaped(x:unknown):unknown {
  if (x is { id:let $\u0069d }) return $id
  return 0
}
export function generated(x:unknown):unknown {
  if (x is { id:let $match1 }) return $match1
  return 0
}
export function mutable(x:unknown):unknown {
  if (x is { id:let $is1 }) { $is1=9; return $is1 }
  return 0
}
export const arrow = (x:unknown):boolean => x is { id:let $extracted2 }
