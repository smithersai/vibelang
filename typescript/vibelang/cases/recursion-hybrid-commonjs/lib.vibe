export effect function boom(n: number): number!! {
  if (n === 0) return (null as any).x
  return try boom(n - 1)
}
let defaults = 0
function nextDefault(): number { defaults++; return 3 }
export effect function complex(n: number, { value } = { value: nextDefault() }, ...rest: number[]): number!! {
  return n === 0 ? value + rest.length : try complex(n - 1, { value }, ...rest)
}
export function defaultCount(): number { return defaults }
export effect function args(n: number, ...rest: number[]): number!! {
  if (n === 0) return 1 + rest.length + rest.length
  return try args(n - 1, ...rest)
}

// VIP-1: call-time parameter binding does not start the body.
let bodyStarts = 0
export effect function coldProbe(): number!! { bodyStarts++; return bodyStarts }
export function probeStarts(): number { return bodyStarts }
