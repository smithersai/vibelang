import { odd } from "./odd.vibe"

export default effect function down(n: number): number!! {
  return n === 0 ? 0 : try down(n - 1)
}
export effect function even(n: number): boolean!! {
  return n === 0 ? true : try odd(n - 1)
}
export function tree(n: number): number {
  if (n === 0) return 1
  if (n % 2 === 0) return tree(n - 1)
  return [n - 1].map(x => tree(x))[0]
}
export effect function guarded(n: number): number!! {
  try {
    if (n === 0) return try ((foreignSyntaxErrorClass: typeof SyntaxError) => Effect.catch(Effect.try({ try: () => JSON.parse("7"), catch: (error) => error }), (error) => error instanceof foreignSyntaxErrorClass ? Effect.fail(error) : Effect.die(error)))(SyntaxError)
    return try guarded(n - 1)
  } catch (e) {
    return -1
  }
}
error Stop { value: number }
export effect function caught(n: number): number!! {
  try {
    if (n === 0) throw new Stop({ value: 7 })
    return try caught(n - 1)
  } catch (e) {
    return 7
  }
}
export effect function typed(n: number): number!Stop {
  if (n === 0) throw new Stop({ value: 9 })
  return try typed(n - 1)
}
export effect function catchTyped(n: number) {
  try { return try typed(n) } catch (e) { return e.value }
}
export effect function boom(n: number): number!! {
  if (n === 0) return (null as any).x
  return try boom(n - 1)
}
let defaults = 0
function nextDefault(): number { defaults++; return 3 }
export effect function complex(n: number, { value } = { value: nextDefault() }, ...rest: number[]): number!! {
  return n === 0 ? value + rest.length : try complex(n - 1, { value }, ...rest)
}
export function defaultCount(): number { return defaults }
export effect function args(n: number, ...rest: number[]): number!! {
  if (n === 0) return 1 + rest.length + rest.length
  return try args(n - 1, ...rest)
}

// VIP-1: call-time parameter binding does not start the body.
let bodyStarts = 0
export effect function coldProbe(): number!! { bodyStarts++; return bodyStarts }
export function probeStarts(): number { return bodyStarts }
