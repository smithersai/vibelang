// expect: EK4802
// Where a function's success type names no value (void, unknown, any, or a
// type parameter its call infers), any value is a success value, so a
// returned Effect value or program literal is data (D24, D269), where Effect
// code would run it. EK4802 is an error here (tsconfig.json).

// A written unknown success.
export const literal = effect (n: number): unknown!! => {
  const copy = n
  return effect () => copy + 1
}
export const held = effect (n: number): unknown!! => {
  const program: unknown!! = effect { return n + 1 }
  return program
}

// A program literal under a type parameter, inferred from the held program.
interface Api { refresh: () => void!! }
export const make = (refresh: void!!): Api => ({
  refresh: effect () => try withSpan(effect { return refresh }, "Api.refresh")
})

// A callback whose call writes an unknown success.
export const startBody = effect (body: unknown!unknown!never) =>
  try Effect.withFiber<unknown, unknown, never>(effect (fiber) => {
    return fiber === undefined ? Effect.interrupt : body
  })

// A callback whose success is a type parameter.
const announce: void!! = Console.log("chunk")
export effect function main() {
  Stream.make(1, 2) |> try Stream.run(%, Sink.forEach(effect (_n: number) => announce))
}

// A program literal under a type parameter.
interface S { go: (n: number) => void!! }
export const s: S = {
  go: effect (n) => try Effect.uninterruptibleMask(effect (restore) => {
    return effect () => {
      try Console.log("ran", n)
    }
  })
}

// Not reported: the success type names the program, or the value runs.
export const kept = effect (n: number): (unknown!!)!! => {
  const program: unknown!! = effect { return n + 1 }
  return program
}
export const ran = effect () => Stream.make(1) |> try Stream.run(%, Sink.forEach(effect (_n: number) => try announce()))
export const factory = (n: number): number!! => {
  const copy = n
  return effect { return copy + 1 }
}

// A catalog handler whose field's success is unknown.
interface Entry { handler: (payload: unknown) => unknown!string }
export const entry: Entry = { handler: effect () => Clock.currentTimeMillis }

// An Effect with structure of its own, such as an Exit, under a written unknown success.
export effect function raced(): unknown!! {
  return Exit.succeed(1)
}

// An arm of a callback whose success is a type parameter.
export const step = effect (n: number) => try Effect.suspend(effect () => n === 1 ? Effect.interrupt : { resumedAt: n })
