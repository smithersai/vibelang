// expect-result: ["waiting","parcel-8",true,false]
// A data value is matched by its tag with an object pattern, which tests the
// tag property on the subject; the data type's $is helper is not called, and
// the file imports no $is. expected/main.js pins the emit.
data Delivery {
  Waiting
  Sent { tracking: string }
}

function describe(delivery: Delivery): string {
  return match (delivery) {
    when { _tag: "Waiting" }: "waiting";
    when { _tag: "Sent", let tracking }: tracking;
  }
}

function isSent(value: unknown): boolean {
  return value is { _tag: "Sent" }
}

export effect function main() {
  return [describe(Delivery.Waiting()), describe(Delivery.Sent({ tracking: "parcel-8" })), isSent(Delivery.Sent({ tracking: "x" })), isSent({ tracking: "x" })]
}
