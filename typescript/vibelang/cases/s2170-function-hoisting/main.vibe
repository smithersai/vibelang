import named from "./named.vibe"
import anonymous from "./anonymous.vibe"
import { getEarly } from "./cycle.js"

// Module bindings must be available even before the declaration is reached.
const top = atTop
function atTop(n: number) {
  try sleep("1 millis")
  return n * 2
}

function inBody(n: number) {
  "use strict"
  return try twice(n)
  // This declaration is unreachable as a statement, but its binding hoists.
  function twice(x: number) {
    try sleep("1 millis")
    return x * 2
  }
}

function inBlock(n: number) {
  let result = 0
  {
    const offset = 1
    result = try twice(n)
    function twice(x: number) {
      try sleep("1 millis")
      return x * 2 + offset
    }
  }
  // A sibling block gets its own binding.
  {
    result += try twice(n)
    function twice(x: number) {
      try sleep("1 millis")
      return x * 3
    }
  }
  return result
}

function mutual(n: number) {
  const result = try even(n)
  function even(x: number): boolean!! {
    try sleep("1 millis")
    return x === 0 ? true : try odd(x - 1)
  }
  function odd(x: number): boolean!! {
    try sleep("1 millis")
    return x === 0 ? false : try even(x - 1)
  }
  return result
}

function plain(n: number): number {
  return twice(n)
  function twice(x: number): number {
    return x * 2
  }
}

function inSwitch(n: number) {
  switch (n) {
    case 0:
      return try twice(3)
    default:
      function twice(x: number) {
        try sleep("1 millis")
        return x * 2
      }
      return try twice(n)
  }
}

// Calls stay cold: source defaults and destructuring run only in the Effect.
const order: string[] = []
const seed = (): number => { order.push("default"); return 5 }
function forwarded() {
  const result = try later()
  function later({ n } = { n: seed() }, ...rest: number[]) {
    try sleep("1 millis")
    return n + rest.length
  }
  return result
}

// expect-result: {"top":4,"body":6,"block":11,"mutual":[true,false],"plain":8,"switch":6,"forwarded":5,"order":["default"],"named":9,"anonymous":5,"early":6}
export function main() {
  return { top: try top(2), body: try inBody(3), block: try inBlock(2), mutual: [try mutual(4), try mutual(3)], plain: plain(4), switch: try inSwitch(0), forwarded: try forwarded(), order, named: try named(3), anonymous: try anonymous(2), early: try getEarly() }
}
