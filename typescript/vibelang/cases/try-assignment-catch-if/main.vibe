// expect-result: [0,"observed","created","updated","Other",["create","create","update","create"]]
import * as Effect from "effect/Effect"
interface Item { readonly id: string }
type Err = { readonly _tag: "Conflict" } | { readonly _tag: "Other" }
type Mode = "create" | "conflict" | "other"
const events: string[] = []

effect function create(mode: Mode): Effect.Effect<Item, Err> {
  events.push("create")
  if (mode === "conflict") { const problem: Err = { _tag: "Conflict" }; throw problem }
  if (mode === "other") { const problem: Err = { _tag: "Other" }; throw problem }
  return { id: "created" }
}
effect function update(): Effect.Effect<Item> {
  events.push("update")
  return { id: "updated" }
}
export effect function caught(observed: Item | undefined, mode: Mode) {
  let current = observed
  if (current === undefined) {
    current = try Effect.catchIf(
      create(mode),
      (e): e is { readonly _tag: "Conflict" } => e._tag === "Conflict",
      effect () => try update()
    )
    return current.id
  }
  return current.id
}

type Errors<T> = T extends Effect.Effect<infer _A, infer E, infer _R> ? E : never
type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2)
  ? ((<T>() => T extends B ? 1 : 2) extends (<T>() => T extends A ? 1 : 2) ? true : false)
  : false
type Assert<T extends true> = T
type UnhandledError = Assert<Equal<Errors<ReturnType<typeof caught>>, { readonly _tag: "Other" }>>

export effect function main() {
  const before = events.length
  const observed = try caught({ id: "observed" }, "other")
  const created = try caught(undefined, "create")
  const updated = try caught(undefined, "conflict")
  const failed = try Effect.match(caught(undefined, "other"), {
    onFailure: (e) => e._tag, onSuccess: (value) => value
  })
  return [before, observed, created, updated, failed, events]
}
