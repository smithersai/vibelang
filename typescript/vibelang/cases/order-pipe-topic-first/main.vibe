// expect-result: {"getter":[7,["source","getter"]],"rebound":2,"stable":8}
// A pipe evaluates its left side before its body (chapter 13). A topic that
// stands alone takes the left side's place only when what the body evaluates
// before it can neither run code nor change: a getter that reads the callee,
// or a let that the left side assigns, runs after the left side.
function getter() {
  const trace: string[] = []
  const sink = {
    get take() {
      trace.push("getter")
      return (x: number): number => x
    }
  }
  function source() {
    trace.push("source")
    return 7
  }
  const value = source() |> sink.take(%)
  return [value, trace]
}

function rebound() {
  let fn = (x: number): number => 1
  function source() {
    fn = (x: number): number => 2
    return 7
  }
  return source() |> fn(%)
}

function increment(n: number) { return n + 1 }

export function main() {
  return { getter: getter(), rebound: rebound(), stable: 7 |> increment(%) }
}
