// expect-result: {"exitTag":"Failure","yielded":true,"interrupted":true}
error Boom

function boom() {
  throw new Boom()
}

function exitTag() {
  const result = try exit(boom())
  return result._tag
}

function yielded() {
  try yieldNow()
  try yieldNow(5)
  return true
}

function interrupted() {
  const fiber = fork {
    try interrupt()
  }
  return (try exit(fiber.join()))._tag === "Failure"
}

export function main() {
  return { exitTag: try exitTag(), yielded: try yielded(), interrupted: try interrupted() }
}
