// expect-result: {"load":[1,"none"],"loadEffect":[2,"none"],"block":[3,"none"],"runs":6}
// VIP-1 flip acceptance case 11 (t3code queryPersistence.vibe:32; spec
// ruling 2026-11-01 00:50Z): e catch h runs e (VIP-5), so in an effect block
// return Effect.asSome(x) catch () => Option.none() returns an Option, like
// Effect.asSome(x).pipe(Effect.catch(() => Effect.succeedNone())).
let runs = 0
const parse = (s: string): number!string => effect {
  runs += 1
  if (s === "bad") throw "bad"
  return Number(s)
}

const show = (o: Option.Option<number>) => Option.isSome(o) ? o.value : "none"

// The plain handler: its result is the fallback.
export const load = effect (s: string) => {
  return Effect.asSome(parse(s)) catch () => Option.none()
}

// The effect handler: it runs its Effect.
export const loadEffect = effect (s: string) => {
  return Effect.asSome(parse(s)) catch effect () => try Effect.succeedNone
}

// The real site: inside effect { }, under a written Option type.
export const block = (s: string): Option.Option<number>!! =>
  effect { return Effect.asSome(parse(s)) catch () => Option.none() }

export effect function main() {
  const l = [show(try load("1")), show(try load("bad"))]
  const e = [show(try loadEffect("2")), show(try loadEffect("bad"))]
  const b = [show(try block("3")), show(try block("bad"))]
  return { load: l, loadEffect: e, block: b, runs }
}
