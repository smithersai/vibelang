// expect-result: {"found":"Ada","missing":"missing 0","record":{"ok":true},"fallback":"Grace","stub":[true,"gone"],"held":2,"free":"program"}
// Effect.succeed and Effect.fail where the call runs draw EK4834 (D288): a
// running Effect.succeed(x) is x, and a running Effect.fail(e) fails as
// throw e does. A call passed by name, or one whose removal would turn a
// lambda that returns an Effect into a plain function, draws nothing.
// tsforms-direct-fixed is what vibelang --fix writes.
error Missing { id: number }

function find(id: number) {
  if (id === 0) throw new Missing({ id })
  return "Ada"
}

function lookup(id: number) {
  find(id)
  const name = "Grace"
  return name
}

interface Store {
  readonly read: () => boolean!Missing
  readonly gone: () => never!Missing
}

const store: Store = {
  read: () => true,
  gone: () => throw new Missing({ id: 1 })
}

function record(): { ok: boolean }!! {
  return { ok: true }
}

export function main() {
  const stubbed = store.gone() catch () => "gone"
  const free = { run: () => Effect.succeed("program") } as unknown as { run: () => string!! }
  return {
    found: find(1),
    missing: find(0) catch (e) => `missing ${e.id}`,
    record: record(),
    fallback: lookup(1),
    stub: [store.read(), stubbed],
    held: retry(Effect.succeed(2), Schedule.recurs(1)),
    free: free.run()
  }
}
