// expect-result: {"found":"Ada","missing":"missing 0","record":{"ok":true},"fallback":"Grace","stub":[true,"gone"],"held":2,"free":"program"}
// Effect.succeed and Effect.fail that try runs draw EK4834 (D288): a running
// Effect.succeed(x) is x, and a running Effect.fail(e) fails as throw e does.
// A call no try runs builds a program and draws nothing.
// tsforms-direct-fixed is what vibelang --fix writes.
error Missing { id: number }

effect function find(id: number) {
  if (id === 0) throw new Missing({ id })
  return "Ada"
}

effect function lookup(id: number) {
  try find(id)
  const name = "Grace"
  return name
}

interface Store {
  readonly read: () => boolean!Missing
  readonly gone: () => never!Missing
}

const store: Store = {
  read: effect () => true,
  gone: effect () => throw new Missing({ id: 1 })
}

effect function record(): { ok: boolean }!! {
  return { ok: true }
}

export effect function main() {
  const stubbed = store.gone() catch () => "gone"
  const free = { run: () => Effect.succeed("program") } as unknown as { run: () => string!! }
  return {
    found: try find(1),
    missing: find(0) catch (e) => `missing ${e.id}`,
    record: try record(),
    fallback: try lookup(1),
    stub: [try store.read(), stubbed],
    held: try retry(Effect.succeed(2), Schedule.recurs(1)),
    free: try free.run()
  }
}
