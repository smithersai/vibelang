// Chapter 13. Which functions compile to plain JavaScript.

service Settings {
  scale(): Effect<number, never, never>
}

const order: string[] = []

function double(n: number): number {
  return n * 2
}

effect function area(w: number, h: number) {
  return double(w) * double(h) * try Settings.scale()
}

// Evaluation order (Codex review finding 6): the proposal's generated area moves both double calls
// after Settings.scale(); source order must be kept. tracedDouble makes the order observable.
function tracedDouble(n: number) {
  order.push(`double ${n}`)
  return n * 2
}

effect function tracedArea(w: number, h: number) {
  return tracedDouble(w) * tracedDouble(h) * try Settings.scale()
}

// Recursion
// NOTE: D10 runs pure recursion on the JavaScript stack, so sumTo stays well under the host limit here.

effect function sumTo(n: number): Effect<number, never, never> {
  return n === 0 ? 0 : n + try sumTo(n - 1)
}

effect function gcd(a: number, b: number): Effect<number, never, never> {
  return b === 0 ? a : try gcd(b, a % b)        // a call to itself in tail position: compiled to a loop
}

// D9: a pure .vibe function passed where JavaScript expects a plain function passes its plain variant.
function doubleAll(xs: ReadonlyArray<number>) {
  return xs.map(double)
}

const SettingsTest = Layer.succeed(Settings, {
  scale: effect () => {
    order.push("scale")
    return 10
  }
})

effect function scenario() {
  const plain = try area(2, 3)
  const traced = try tracedArea(2, 3)
  return {
    double: double(4),
    area: plain,
    traced,
    order,
    sumTo: try sumTo(1000),
    gcd: try gcd(48, 18),
    doubled: doubleAll([1, 2, 3])
  }
}

// expect-result: {"double":8,"area":240,"traced":240,"order":["scale","double 2","double 3","scale"],"sumTo":500500,"gcd":6,"doubled":[2,4,6]}
export effect function main() {
  return try Effect.provide(effect { return try scenario() }, SettingsTest)
}
