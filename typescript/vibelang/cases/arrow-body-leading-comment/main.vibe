// expect-result: [[1,2],"ab",3,[1],3,5]
// An expression body that follows a comment still answers its value: the
// lowering keeps the expression on the line of its return.
error Bad { message: string }

const later = (n: number): number!! => {
  try sleep("1 millis")
  return n
}

const both = (): readonly [number, number]!! =>
  // Both run at once.
  Effect.all([later(1), later(2)], { concurrency: "unbounded" })

const joined = (): string!! =>
  /* the parts, in order */
  Effect.map(Effect.all([later(1), later(2)]), () => "ab")

const traced = (n: number): number!! =>
  // first line
  // second line
  later(n)

const parse = (text: string) =>
  // The comment sits between the arrow and its body.
  try Effect.try({ try: () => ((text) => JSON.parse(text) as unknown)(text), catch: (cause) => new Bad({ message: String(cause) }) })

const step = (n: number) =>
  // A comment before a sync hatch.
  sync((n) => n + 1, n)

const stepped = (n: number) =>
  /* A block comment
     over two lines. */
  step(n)

export function main() {
  return [try both(), try joined(), try traced(3), try parse("[1]"), try step(2), try stepped(4)]
}
