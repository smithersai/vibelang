import { Data } from "effect"

// An error declaration declares what the Effect TypeScript in
// typescript/main.ts declares, a Data.TaggedError class with no member,
// marker or namespace of VibeLang (D501), from foldkit managedResource.

// foldkit: managedResource.
/** A managed resource was read while it was not acquired. */
export error ResourceNotAvailable { resource: string }

// error Timeout, with no fields, is Data.TaggedError("Timeout") with no
// type argument (chapter 3), declared Timeout_base, not Timeout_base<{}>.
export error Timeout

export error Gone {
  get message(): string {
    return "gone"
  }
}

// Detail 273 / foldkit-90: the written class has a distinct declaration
// spelling; the safe fixer retains it when declarations are enabled.
export class MissingBuildId extends Data.TaggedError("MissingBuildId")<{}> {}

export error TimeoutWithBraces {}

// VIP-13 VIP-13 fieldless declarations keep the no-type-argument ABI; rule: docs/design/vips/0013-error-declarations.md#c635f510892d8d91

