// expect-result: {"joined":7,"pair":[7,7],"record":{"a":7},"interrupted":true,"method":true,"all":true,"operand":7,"raced":7,"loop":[7,7],"chosen":7,"done":7}
// The places an owned fiber's value may go (D409): a const or let of its
// region and reads of it, join with an array or object literal operand,
// the Fiber functions whose result holds no Fiber and their methods, and a
// fork operand, await element, or for concurrent body in the region.
effect function slow(): number!! {
  try sleep("5 millis")
  return 7
}

effect function forever(): number!! {
  try sleep("1 minute")
  return 0
}

effect function joined() {
  const fiber = fork slow()
  const alias = fiber
  return join alias
}

effect function pair() {
  const a = fork slow()
  const b = fork slow()
  return join [a, b]
}

effect function record() {
  const a = fork slow()
  return join { a }
}

effect function interrupted() {
  const fiber = fork forever()
  try Fiber.interrupt(fiber)
  const exit = try Fiber.await(fiber)
  return Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause)
}

effect function method() {
  const fiber = fork forever()
  try fiber.interrupt()
  return Exit.isFailure(try fiber.await())
}

effect function all() {
  const a = fork forever()
  const b = fork forever()
  try Fiber.interruptAll([a, b])
  return Exit.isFailure(try Fiber.await(a)) && Exit.isFailure(try Fiber.await(b))
}

effect function operand() {
  const fiber = fork slow()
  const waiter = fork { return join fiber }
  return join waiter
}

effect function raced() {
  const fiber = fork slow()
  return await.race [join fiber, do { try sleep("1 second"); 0 }]
}

effect function loop() {
  const fiber = fork slow()
  const seen: number[] = []
  for concurrent (const n of [1, 2]) {
    seen.push(join fiber)
  }
  return seen
}

effect function chosen(first: boolean) {
  let fiber = first ? fork slow() : fork forever()
  return join fiber
}

effect function done() {
  const fiber = do { fork slow() }
  return join fiber
}

export effect function main() {
  return {
    joined: try joined(),
    pair: try pair(),
    record: try record(),
    interrupted: try interrupted(),
    method: try method(),
    all: try all(),
    operand: try operand(),
    raced: try raced(),
    loop: try loop(),
    chosen: try chosen(true),
    done: try done()
  }
}
