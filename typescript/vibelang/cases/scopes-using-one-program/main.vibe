// using is one Effect program for every initializer (D490):
// Effect.acquireRelease(e, release, { interruptible: true }) in the block's
// Scope, which runs e with the interruptibility in force where the using
// stands, as yield* runs it, whatever e's type. Under
// timeout(…, "100 millis") a pause in e is cut short and using registers
// nothing: a Lease-typed and an object-typed lease that waits before it makes
// its lease ("scoped", "object"), an openDb() that waits and returns a
// Disposable without requiring Scope ("plain"), and waitLease(): Lease!! and
// waitLeaseWide(): Lease!!Scope with one body ("narrow", "wide"). A lease
// made through acquireRelease before the wait is disposed once
// ("acquiredFirst"). Effect.acquireDisposable masks its acquire, so written
// using db = Effect.acquireDisposable(() => openDb(…)), the initializer
// waits out the pause, then its value is disposed once ("acquireDisposable").
// Each list ends with how the deadline ended, after every release ran.
// expect-result: {"scoped":["TimeoutError"],"object":["TimeoutError"],"acquiredFirst":["dispose first","TimeoutError"],"plain":["TimeoutError"],"narrow":["TimeoutError"],"wide":["TimeoutError"],"acquireDisposable":["opened","disposed","TimeoutError"]}
export effect function main() {
  return {
    scoped: try deadline(effect (seen) => try holdScoped(seen)),
    object: try deadline(effect (seen) => try holdObject(seen)),
    acquiredFirst: try deadline(effect (seen) => try holdAcquiredFirst(seen)),
    plain: try deadline(effect (seen) => try holdPlain(seen)),
    narrow: try deadline(effect (seen) => try holdNarrow(seen)),
    wide: try deadline(effect (seen) => try holdWide(seen)),
    acquireDisposable: try deadline(effect (seen) => try holdMasked(seen))
  }
}

// A pause the deadline cuts short, and one a masked acquire waits out.
const long = "2 seconds"
const short = "300 millis"

class Lease {
  seen: string[]
  name: string
  constructor(seen: string[], name: string) {
    this.seen = seen
    this.name = name
  }
  [Symbol.dispose](): void {
    this.seen.push(`dispose ${this.name}`)
  }
}

// Runs work under a 100 ms deadline and returns what it recorded, then how
// the deadline ended.
effect function deadline(work: (seen: string[]) => void!!) {
  const seen: string[] = []
  try {
    try Effect.timeout(effect { return try work(seen) }, "100 millis")
    seen.push("finished")
  } catch (e) {
    seen.push(e._tag)
  }
  return seen
}

effect function lease(seen: string[]): Lease!!Scope {
  try sleep(long)
  seen.push("leased")
  return new Lease(seen, "scoped")
}

effect function leaseObject(seen: string[]): object!!Scope {
  try sleep(long)
  seen.push("leased")
  return {}
}

effect function leaseFirst(seen: string[]): Lease!!Scope {
  const made = try Effect.acquireRelease(effect { return new Lease(seen, "first") }, effect (l) => l[Symbol.dispose]())
  try sleep(long)
  seen.push("waited")
  return made
}

effect function openDb(seen: string[], pause: Duration.Input) {
  try sleep(pause)
  seen.push("opened")
  return { [Symbol.dispose](): void { seen.push("disposed") } }
}

effect function waitLease(seen: string[], name: string): Lease!! {
  try sleep(long)
  seen.push("leased")
  return new Lease(seen, name)
}

effect function waitLeaseWide(seen: string[], name: string): Lease!!Scope {
  try sleep(long)
  seen.push("leased")
  return new Lease(seen, name)
}

effect function holdScoped(seen: string[]) {
  using held = try lease(seen)
  seen.push("body")
}

effect function holdObject(seen: string[]) {
  using held = try leaseObject(seen)
  seen.push("body")
}

effect function holdAcquiredFirst(seen: string[]) {
  using held = try leaseFirst(seen)
  seen.push("body")
}

effect function holdPlain(seen: string[]) {
  using db = try openDb(seen, long)
  seen.push("body")
}

effect function holdNarrow(seen: string[]) {
  using held = try waitLease(seen, "narrow")
  seen.push("body")
}

effect function holdWide(seen: string[]) {
  using held = try waitLeaseWide(seen, "wide")
  seen.push("body")
}

effect function holdMasked(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openDb(seen, short) })
  seen.push("body")
}
