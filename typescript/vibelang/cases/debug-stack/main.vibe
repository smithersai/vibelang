// vibelang --sourceMap maps generated JavaScript to .vibe lines (D36), inside
// lowered generators and region closures, and each generator is named after
// its source, so a stack trace names the VibeLang function.
class NotFound extends TaggedError("NotFound")<{ readonly id: number }> {}

interface Account {
  owner: { name: string } | undefined
}

effect function ownerName(account: Account) {
  try Effect.yieldNow()
  return account.owner!.name
}

effect function lookup(id: number) {
  try Effect.yieldNow()
  throw new NotFound({ id })
}

effect function audited(account: Account) {
  try {
    try Effect.yieldNow()
    return account.owner!.name.length
  } finally {
    try Effect.yieldNow()
  }
}

// A recursive function refers to itself, so its generator is an object
// literal's method, which binds no name: countdown(n - 1, seen) still calls
// the Effect function.
effect function countdown(n: number, seen: number[]): Effect<number[], never, never> {
  try Effect.yieldNow()
  seen.push(n)
  if (n > 0) try countdown(n - 1, seen)
  return seen
}

// A body that is one expression returns its Effect without a generator. The
// thunk that evaluates it is still named after the function; Effect calls it
// as a method, so the frame also names the receiver's class, PrimitiveImpl.
effect function logOwner(account: Account) {
  return try Console.log(account.owner!.name)
}

export effect function crash() {
  return try ownerName({ owner: undefined })
}

export effect function missing() {
  return try lookup(7)
}

export effect function region() {
  return try audited({ owner: undefined })
}

export effect function counted() {
  return try countdown(3, [])
}

export effect function direct() {
  return try logOwner({ owner: undefined })
}
