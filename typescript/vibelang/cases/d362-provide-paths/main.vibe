// expect-result: {"common":1,"tuple":3,"spread":1,"context":4,"default":5,"events":["eval:layer","eval:value","eval:layer"],"builds":1,"provided":6}
service Common { shared: number }
service Left { left: number }
service Right { right: number }
const CommonLive = Layer.succeed(Common, { shared: 1 })
const LeftLive = Layer.succeed(Left, { left: 2 })
const RightLive = Layer.succeed(Right, { right: 3 })

service Default {
  next(value: number): number!!
  static readonly default = { effect next(value) { return value + 1 } }
}

effect function common(flag: boolean): number!! {
  const provider = flag ? Layer.mergeAll(CommonLive, LeftLive) : Layer.mergeAll(CommonLive, RightLive)
  provide provider { return (try Common()).shared }
}

effect function tuple(): number!! {
  const providers: readonly [Layer.Layer<Common>, Layer.Layer<Left>] = [CommonLive, LeftLive]
  provide providers { return (try Common()).shared + (try Left()).left }
}

effect function spread(): number!! {
  const extra: Layer.Layer<Right>[] = []
  const required: readonly [Layer.Layer<Common>] = [CommonLive]
  provide [...extra, ...required, Layer.empty] { return (try Common()).shared }
}

effect function context(): number!! {
  provide Context.make(Common, { shared: 4 }) { return (try Common()).shared }
}

export effect function main() {
  const events: string[] = []
  const live = Layer.effect(Left) { events.push("build"); return { left: 2 } }
  function layer() { events.push("eval:layer"); return live }
  function value() { events.push("eval:value"); return { right: 4 } }
  let provided = 0
  provide layer(), Right = value(), layer() {
    provided = (try Left()).left + (try Right()).right
  }
  return {
    common: try common(true), tuple: try tuple(), spread: try spread(), context: try context(), default: try Default.next(4),
    events: events.slice(0, 3), builds: events.filter((event) => event === "build").length, provided
  }
}
