// expect-result: ["other","No match arm matched 2","No match arm matched 2"]
// A match calls the runtime's $is to test a class pattern, and the last arm
// of a match that covers its subject checks its test with $assertMatch,
// which calls $noMatch when the subject is outside its type (D405). They are
// the runtime's, whatever the file declares: a module-level or local binding
// spelled the same is a binding of its own. A match without default must
// cover its subject (D346), so the subjects are the literal type 1, and a
// cast passes 2.
const $is = (_: unknown, __: unknown): boolean => true
const $noMatch = (_: unknown): string => "captured"
const $assertMatch = (_: unknown, __: unknown): void => {}

error Bad { id: string }

function classOf(value: unknown) {
  return match (value) { when Bad: "bad"; default: "other" }
}

function classify(n: 1): string {
  return match (n) { when 1: "one" }
}

function nested(n: 1): string {
  const $noMatch = (_: unknown): string => "captured"
  const $assertMatch = (_: unknown, __: unknown): void => {}
  return match (n) { when 1: "one" }
}

// The unmatched subject is a defect; a hatch reads its message.
export effect function main() {
  const unmatched = try sync((outer: (n: 1) => string, inner: (n: 1) => string) => {
    const message = (f: (n: 1) => string) => {
      try {
        return f(2 as 1)
      } catch (e) {
        return (e as Error).message
      }
    }
    return [message(outer), message(inner)]
  }, classify, nested)
  return [classOf(42), ...unmatched]
}
