// An Effect value is a program, and calling it runs it (Chapter 5): a read
// of the clock, the program Effect.cached returns, a Config, and a Context
// key, which yields its service.
import { Clock, Config, Context, Effect, Layer } from "effect"

class Greeter extends Context.Service<Greeter, { readonly greet: (name: string) => Effect.Effect<string> }>()("Greeter") {}

const GreeterLive = Layer.succeed(Greeter, { greet: effect (name) => `hello ${name}` })

const Port = Config.withDefault(Config.Port("PORT"), 3000)

let loads = 0

effect function loadConfig() {
  loads++
  try Effect.sleep("1 millis")
  return { port: 8080 }
}

effect function cachedTwice() {
  const cached = try Effect.cached(effect { return try loadConfig() })
  const first = try cached()
  const second = try cached()
  return [first.port, second.port, loads]
}

effect function greeted() {
  const greeter = try Greeter()
  return try greeter.greet("ada")
}

// expect-result: {"clock":"number","cached":[8080,8080,1],"port":3000,"greeted":"hello ada"}
export effect function main() {
  return {
    clock: typeof try Clock.currentTimeMillis(),
    cached: try cachedTwice(),
    port: try Port(),
    greeted: try Effect.provide(effect { return try greeted() }, GreeterLive)
  }
}
