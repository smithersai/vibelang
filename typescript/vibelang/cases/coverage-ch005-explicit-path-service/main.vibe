effect function program() {
 const path=try Path.Path
 const url=try Effect.try(()=>new URL(import.meta.url))
 const file=try path.fromFileUrl(url)
 return path.basename(path.dirname(file))
}
export effect function main() { provide Path.layer { return try program() } }

