import { Effect } from "effect"
let runs = 0
effect function load(n: number): Effect.Effect<unknown, never, never> {
  runs++
  return n
}
function known(n: number) { runs++; return n }
effect function failing(): Effect.Effect<unknown, string, never> { throw "failed" }
export effect function piped(n: number): Effect.Effect<number, never, never> {
  return (load(n) as Effect.Effect<number>) |> try Effect.map(%, (x) => x + 1)
}
export effect function typed(): Effect.Effect<number, never, never> {
  return (known(2) as Effect.Effect<number>) |> try Effect.map(%, (x) => x + 1)
}
export effect function erased(): Effect.Effect<number, never, never> {
  return (failing() as Effect.Effect<number>) |> try Effect.map(%, (x) => x + 1)
}
// expect-result: {"value":2,"typed":3,"direct":4,"repeated":[4,4],"compound":7,"failure":"failed","runs":6}
export effect function main() {
  const value = try piped(1)
  const typedValue = try typed()
  const direct = try Effect.map(known(3) as Effect.Effect<number>, (x) => x + 1)
  const repeated = (known(4) as Effect.Effect<number>) |> try Effect.all([%, %])
  const compound = ((known(5) + 1) as Effect.Effect<number>) |> try Effect.map(%, (x) => x + 1)
  const failure = try Effect.flip(erased())
  return { value, typed: typedValue, direct, repeated, compound, failure, runs }
}
