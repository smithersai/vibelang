// expect: EK3201
// An input that no wire argument provides stays in the layer's In, as with
// Layer.provide, and is reported where the program's requirements must be
// empty: here, at the runner (D27).
import { Effect, Layer } from "effect"
import { wire } from "vibelang-runtime"

service Smtp {
  deliver(to: string): Effect.Effect<void, never, never>
}

service Mailer {
  send(to: string): Effect.Effect<void, never, never>
}

const MailerLive = Layer.effect(Mailer, effect {
  const smtp = try Smtp()
  return { send: effect (to: string) => try smtp.deliver(to) }
})

const AppLive = wire(MailerLive)

effect function welcome() {
  try Mailer.send("ada@example.com")
}

export effect function main() {
  try Effect.provide(effect { return try welcome() }, AppLive)
}

Effect.runFork(effect { return try main() })
