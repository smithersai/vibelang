// expect: EK4839
import { Option } from "effect"
export const n = Option.match(Option.some(1), { onNone: () => 0, onSome: n => n })

// Appendix B: EK4839 — spec-rule: docs/design/src/900-appendices.md#d2e90f50f3d93f78

// Appendix B: retained TypeScript-form warning codes — spec-rule: docs/design/src/900-appendices.md#44f3b4ad3c1cdb61

// Manual forms retain their compiler contracts without automatic repairs.
// rule-evidence: docs/design/src/007-tooling.md#typescript-spellings-with-vibelang-forms | Retain comments between arguments, and check unsupported patterns, handlers and return types before changing a `Match` chain.

export const manualLiteralMatch = (value: number): string =>
  match (value) { when 0: "zero"; default: "other"; }
