// Where Effect.all expects an iterable or a record of Effects, an iterable or
// a record of programs converts element by element (design D49): a tuple
// literal, a record literal, a Set, and a Map's values.
effect function prepare(n: number) {
  try Effect.sleep("1 millis")
  return n * 2
}

effect function collected() {
  const tuple = try Effect.all([effect { return 12 }, effect { return "ready" }] as const)
  const object = try Effect.all({ count: effect { return 12 }, status: effect { return "ready" } })
  const iterable = new Set([effect () => try prepare(3), effect () => try prepare(5)])
  const set = try Effect.all(iterable, { concurrency: 2 })
  const jobs = new Map([["a", effect () => try prepare(1)], ["b", effect () => try prepare(2)]])
  const values = try Effect.all(jobs.values())
  return { tuple, object, set, values }
}

// expect-result: {"tuple":[12,"ready"],"object":{"count":12,"status":"ready"},"set":[6,10],"values":[2,4]}
export effect function main() {
  return try collected()
}
