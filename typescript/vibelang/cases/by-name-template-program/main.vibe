import { sql, write, type Statement } from "./sql.ts"

const encode = (n: number): string => String(n)

// No call in the template: write receives the statement and runs it.
export effect function literal(): void!! {
  try write(sql`INSERT INTO literal VALUES (${1})`)
}

// RecallSemantic.upsert: database.write(sql`... ${vectorBytes(vector.vector)} ...`).
// A call in an interpolation must preserve the statement as the tail program.
export effect function interpolatedCall(): void!! {
  try write(sql`INSERT INTO interpolated_call VALUES (${encode(1)})`)
}

effect function encoded(n: number) {
  try Effect.sleep("1 millis")
  return String(n)
}

export effect function effectfulOperand(): void!! {
  // encoded is an Effect function: try runs it in the interpolation (VIP-5).
  try write(sql`INSERT INTO operand VALUES (${try encoded(2)})`)
}

// A plain tag function returns its Statement unrun (VIP-1).
function localSql(parts: TemplateStringsArray, ...values: ReadonlyArray<unknown>): Statement {
  return sql(parts, ...values)
}

export effect function localTemplate(): void!! {
  try write(localSql`INSERT INTO local VALUES (${encode(3)})`)
}
