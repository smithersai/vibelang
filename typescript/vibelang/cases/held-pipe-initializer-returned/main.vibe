// A declared Effect const holds a pipe initializer (D269, D154): the pipe's
// value is its body's, so the body builds a program and the left side,
// passed by name to the body's program parameter, runs only when the const
// is run, each time it is run.
const make = (state: { mutable runs: number }): number!! => {
  state.runs++
  return state.runs
}

export const forwarded = (state: { mutable runs: number }): number!! => {
  const program: number!! = make(state) |> Effect.map(%, (n) => n * 10) |> Effect.map(%, (n) => n + 1)
  return program
}

// expect-result: [[0,0],[11,21,11,21],[2,2]]
export function main() {
  const local = { runs: 0 }
  const viaForward = { runs: 0 }
  const program: number!! = make(local) |> Effect.map(%, (n) => n * 10) |> Effect.map(%, (n) => n + 1)
  const factory: number!! = forwarded(viaForward)
  const before = [local.runs, viaForward.runs]
  const values = [try program(), try program(), try factory(), try factory()]
  return [before, values, [local.runs, viaForward.runs]]
}
