// expect: EK9204 EK9204 EK9204 EK9204
// A catch receives typed failures only (D13, D282), so a catch whose try
// block fails with no expected error can never run: Option.getOrThrow's
// exception and a JavaScript TypeError are defects that pass through it.
// EK9204 is a warning by default; this project makes it an error.
// TypeScript's complaint about e._tag on never is covered.
import { Console, Data, Effect, Option } from "effect"

class Missing extends Data.TaggedError("Missing")<{}> {}

effect function firstAdmin(names: ReadonlyArray<string>) {
  try {
    try Effect.succeed(0)
    return Option.getOrThrow(Option.fromNullishOr(names.find((name) => name.startsWith("admin"))))
  } catch (e) {
    return e._tag
  }
}

// A plain function's catch receives typed failures only too (D282).
function parse(text: string) {
  try {
    return text.length
  } catch {
    return -1
  }
}

// These catches can run: the try blocks fail with Missing.
effect function live(names: ReadonlyArray<string>) {
  try {
    if (names.length === 0) throw new Missing()
    try Console.log(names[0])
  } catch (e) {
    return e._tag
  }
  return "found"
}

// A written contract's E and R are never, but its call still runs an Effect.
effect function infallible(): Effect.Effect<number, never, never> {
  return try Effect.succeed(1)
}
effect function annotatedCall() {
  try {
    return try infallible()
  } catch (e) {
    return e._tag
  }
}

// In an Effect function, a try block that fails with nothing is dead as well.
effect function plainBlock() {
  try Effect.succeed(0)
  try { return "ok" } catch { return "fallback" }
}
