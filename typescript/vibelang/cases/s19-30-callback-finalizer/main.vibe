import { Effect, Fiber } from "effect"

// S19-30's original repro: abort resolves pending only after cleanup finishes.
export effect function waitWithAsyncCleanup(log: Array<string>) {
  return try callback((log: Array<string>, resume: Resume<string, never>, signal: AbortSignal) => {
    const pending = new Promise<string>((resolve) => {
      signal.addEventListener("abort", () => setTimeout(() => {
        log.push("cleanup finished")
        resolve("aborted")
      }, 10), { once: true })
    })
    pending.then((value) => resume(value))
    return () => pending.then(() => undefined)
  }, log)
}

export effect function waitWithEffectCleanup(log: Array<string>) {
  return try callback((log: Array<string>, _resume: Resume<string, never>, signal: AbortSignal) => {
    // The finalizer runs after abort and is awaited, just as Effect.callback.
    return Effect.promise(() => new Promise<void>((resolve) => setTimeout(() => {
      log.push(signal.aborted ? "cleanup finished" : "not aborted")
      resolve()
    }, 10)))
  }, log)
}

export effect function waitWithSyncCleanup(log: Array<string>) {
  return try callback((log: Array<string>, _resume: Resume<string, never>) => {
    // Sync cleanup retains the original void callback assignability.
    return () => log.push("cleanup finished")
  }, log)
}

// expect-result: [["cleanup finished","interrupt returned"],["cleanup finished","interrupt returned"],["cleanup finished","interrupt returned"]]
export effect function main() {
  const promise: Array<string> = []
  const effect: Array<string> = []
  const sync: Array<string> = []
  const first = try Effect.forkChild(waitWithAsyncCleanup(promise), { startImmediately: true })
  try Fiber.interrupt(first)
  promise.push("interrupt returned")
  const second = try Effect.forkChild(waitWithEffectCleanup(effect), { startImmediately: true })
  try Fiber.interrupt(second)
  effect.push("interrupt returned")
  const third = try Effect.forkChild(waitWithSyncCleanup(sync), { startImmediately: true })
  try Fiber.interrupt(third)
  sync.push("interrupt returned")
  return [promise, effect, sync]
}
