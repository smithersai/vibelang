import { callback } from "vibelang-runtime"


import { schedule, cancel } from "./timers.js"
// Capture values in the thunk. Await the name before constructing its Effect.
error Rejected { reason: string }

type Pair = readonly [number, number]

effect function readName() {
  try Effect.sleep("1 millis")
  return "ada"
}

// expect-result: {"sum":5,"shouted":"ADA","awaited":"hi!","pair":7,"most":2,"parsed":{"n":1},"mapped":"Rejected","asyncMapped":"Rejected","waited":2,"read":40,"listed":3}
export effect function main() {
  const sum = try Effect.sync(() => 2 + 3)
  const name = try readName()
  const shouted = try Effect.sync(() => name.toUpperCase())
  const awaited = try Effect.promise(async (signal) => signal.aborted ? "aborted" : "hi!")
  const pairOf: Pair = [3, 4]
  const pair = try Effect.sync(() => pairOf[0] + pairOf[1])
  const most = try Effect.sync(() => Math.max(1, 2))
  const parsed = try Effect.try({ try: () => JSON.parse('{"n":1}'), catch: (error) => new Rejected({ reason: String(error) }) })
  let mapped = "none"
  effect {
    try Effect.try({ try: () => JSON.parse("{"), catch: (error) => new Rejected({ reason: String(error) }) })
  } catch effect (error) => {
    mapped = error._tag
  }
  let asyncMapped = "none"
  effect {
    try Effect.tryPromise({ try: () => (async (n) => { throw new Error(String(n)) })(7), catch: (error) => new Rejected({ reason: String(error) }) })
  } catch effect (error) => {
    asyncMapped = error._tag
  }
  const waited = try callback((ms, resume) => {
    const timer = schedule(() => resume(ms), ms)
    return () => cancel(timer)
  }, 2)
  const read = try callback((n, resume: Resume<number, Rejected>) => {
    if (n > 0) resume(n * 10)
    else resume.fail(new Rejected({ reason: "empty" }))
  }, 4)
  const listed = try Effect.sync(() => [1, 2, 3].length)
  return { sum, shouted, awaited, pair, most, parsed, mapped, asyncMapped, waited, read, listed }
}
