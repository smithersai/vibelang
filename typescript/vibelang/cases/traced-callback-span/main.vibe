// expect-result: ["Reader.list","Reader.fires"]
function list() {
  return try withSpan(() => {
    try yieldNow()
    return (try Effect.currentSpan()).name
  }, "Reader.list")
}
const reader = {
  fires: () => withSpan(() => {
    try yieldNow()
    return (try Effect.currentSpan()).name
  }, "Reader.fires")
}
export function main() { return [try list(), try reader.fires()] }
