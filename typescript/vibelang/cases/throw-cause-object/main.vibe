// `throw` fails with the value it is given (VIP-4), a Cause object
// included: in an Effect function `throw cause` is Effect.fail(cause), whose
// one reason is a Fail holding the Cause, and in a plain function it is
// JavaScript's throw. Effect.failCause(cause) fails with every reason the
// cause holds instead.
effect function rethrown() {
  const outcome = try exit(Effect.die("boom"))
  if (outcome is Exit.Failure(let cause)) throw cause
  return 1
}

effect function inExpression(cause: Cause<never>, value: number | undefined) {
  return value ?? throw cause
}

effect function restored(cause: Cause<never>) {
  try Effect.failCause(cause)
}

function plain(cause: Cause<never>): string {
  try { throw cause } catch (e) { return e === cause ? "same object" : "another value" }
}

function shape(outcome: Exit<unknown, unknown>): string {
  if (outcome is Exit.Success(let value)) return "Success"
  return outcome.cause.reasons.map((reason) => reason._tag === "Fail" && Cause.isCause(reason.error) ? "Fail(Cause(" + reason.error.reasons.map((inner) => inner._tag).join("+") + "))" : reason._tag).join("+")
}

// expect-result: {"thrown":"Fail(Cause(Die))","viaFail":"Fail(Cause(Die))","inExpression":"Fail(Cause(Die))","restored":"Die","plain":"same object"}
export effect function main() {
  const died = try exit(Effect.die("boom"))
  if (died is Exit.Success(let value)) return value
  const cause = died.cause
  return {
    thrown: shape(try exit(rethrown())),
    viaFail: shape(try exit(Effect.fail(cause))),
    inExpression: shape(try exit(inExpression(cause, undefined))),
    restored: shape(try exit(restored(cause))),
    plain: plain(cause)
  }
}
