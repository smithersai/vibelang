// expect-result: {"or":[0,7],"nullish":[null,8],"and":[0,0],"log":["or-left","or-left","or-right","nullish-left","nullish-left","nullish-right","and-left","and-left"]}
// An argument is evaluated once, as JavaScript evaluates it (VIP-1 retires
// D147's by-name arguments): value(a) || value(b) is JavaScript's || over two
// Effects, which picks the left one, always truthy, so retry runs only the
// left call. An effect block that runs each side with try tests the values.
const log: string[] = []

effect function value(name: string, n: number | undefined) {
  try Effect.yieldNow
  log.push(name)
  return n
}

export effect function main() {
  const or = [
    try retry(value("or-left", 0) || value("or-right", 7), { times: 0 }),
    try retry(effect { return try value("or-left", 0) || try value("or-right", 7) }, { times: 0 })
  ]
  const nullish = [
    try retry(value("nullish-left", undefined) ?? value("nullish-right", 8), { times: 0 }),
    try retry(effect { return try value("nullish-left", undefined) ?? try value("nullish-right", 8) }, { times: 0 })
  ]
  const and = [
    try retry(effect { return (try value("and-left", 0) && try value("and-right", 9)) }, { times: 0 }),
    try retry(effect { return try value("and-left", 0) && try value("and-right", 9) }, { times: 0 })
  ]
  return { or, nullish, and, log }
}
