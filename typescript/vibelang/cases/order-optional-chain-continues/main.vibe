// expect-result: {"absent":null,"present":5,"element":null,"present element":6,"call":null,"present call":3}
// A ?. skips the rest of its chain when the value before it is absent
// (chapter 13). try box?.read() gives undefined for an absent box, as await
// does (VIP-5), and the ?. after it skips the access.
class Box {
  size = 5
  effect read() {
    try Effect.yieldNow
    return { value: this.size, items: [this.size + 1] }
  }
}

effect function value(box: Box | undefined) {
  return (try box?.read())?.value ?? null
}

effect function element(box: Box | undefined) {
  return (try box?.read())?.items[0] ?? null
}

effect function call(make: (() => { value: number }!!) | undefined) {
  return (try make?.())?.value ?? null
}

export effect function main() {
  return {
    absent: try value(undefined),
    present: try value(new Box()),
    element: try element(undefined),
    "present element": try element(new Box()),
    call: try call(undefined),
    "present call": try call(effect () => ({ value: 3 }))
  }
}
