// A callback declared to return a plain value or an Effect, as
// Arbitrary.checkEffect's property is, takes the plain form unless its return
// annotation makes it an Effect function (D112, D500).
import { Arbitrary, Schema } from "effect"
import { probe } from "./helpers.ts"

function isSmall(n: number) {
  try Effect.sleep("1 millis")
  return n < 10
}

const Count = Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 100 }))

function roundTrip() {
  const result = try Arbitrary.checkEffect(Arbitrary.schema(Count), (count): boolean!Schema.SchemaError!never => {
    const wire = try Schema.encodeEffect(Schema.FiniteFromString)(count)
    return try Schema.decodeEffect(Schema.FiniteFromString)(wire) === count
  }, { runs: 20, seed: "count-round-trip" })
  return result._tag
}

// expect-result: {"plain":"plain: true","pausing":"effect: true","roundTrip":"Passed"}
export function main() {
  return {
    plain: try probe((n): boolean => n > 0),
    pausing: try probe((n): boolean!! => isSmall(n)),
    roundTrip: try roundTrip()
  }
}
