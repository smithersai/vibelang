// expect: EK4857 EK4857 EK4857 EK4857 EK4857
// Chapter 900: EK4857 legacy written infer return slots - spec-rule: docs/design/src/900-appendices.md#6b45fa73e5783959
// An unmarked callable is plain (VIP-1): returning an Effect leaves it unrun,
// so each channel written infer is the channel of the Effect the body returns.
// vibelang --fix writes those types, which preserve the declaration and the
// plain runtime; it never removes an unmarked callable's annotation.
export function failure(): number!string { return Effect.fail("missing") }
export function success(): number!never { return Effect.succeed(1) }
export function every(): string!never!never { return Effect.succeed("ready") }
export const object = { m(): number!never!never { return Effect.succeed(2) } }
export function shorthand(): boolean!never!never { return Effect.succeed(true) }
