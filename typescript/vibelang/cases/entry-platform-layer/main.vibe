// D312: the file names its platform, and main needs FileSystem and Path,
// which @effect/platform-node's NodeServices.layer provides, so the entry
// statement provides that layer around main: main writes no provide.
import "vibelang/platform/node"
import { FileSystem } from "effect/FileSystem"
import { Path } from "effect/Path"

export effect function main() {
  try Console.log(try FileSystem.readFileString(try Path.join("data", "config.json")))
}
