// A provide inside main wins over the entry's layer for the code inside it,
// as Effect.provide does; Path still comes from the entry's layer.
import "vibelang/platform/node"
import { FileSystem, layerNoop } from "effect/FileSystem"
import { Path } from "effect/Path"

export effect function main() {
  const file = try Path.join("data", "config.json")
  provide layerNoop({ readFileString: effect () => "read through main's own layer" }) {
    try Console.log(try FileSystem.readFileString(file))
  }
}
