import { Effect } from "effect"
// VIP-21 plain generators and VIP-20 native for-await stay JavaScript.
export effect function main(): Effect.Effect<Array<number | undefined>> {
 function* native() { yield 3; return 4 }
 const g = native()
 const a = g.next().value, b = g.next().value
 const total = try Effect.promise(async () => {
   async function* values() { yield 1; yield 2 }
   let sum = 0
   for await (const n of values()) sum += n
   return sum
 })
 return [a, b, total]
}

// docs/design/vips/0020-for-try.md#b1409ab8abae0453 | VIP-20 native-generator-and-async-iteration
// It mirrors `for await` over AsyncIterables, which keeps its JavaScript meaning (VIP-5).

// docs/design/vips/0021-producers.md#d5bd4200fdb4ee91 | VIP-21 native-generator-and-async-iteration
// A plain `function*` stays a JavaScript generator.
