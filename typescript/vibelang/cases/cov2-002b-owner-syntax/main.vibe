import { Effect } from "effect"
export effect function main() {
 const scope = try Scope.make()
 const a = fork . in(scope) Effect.succeed(1)
 const b = fork . detached Effect.succeed(2)
 const c = try Effect.scoped(effect { const f = fork . scoped Effect.succeed(3); return join f })
 const x = fork Effect.succeed(4), y = fork Effect.succeed(5)
 const values = [join a, join b, c, join x, join y]
 try Scope.close(scope, Exit.void)
 return values
}

