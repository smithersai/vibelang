// A service has two types (D501), as Effect's Context.Service class has. As a
// type, its name is the identifier, Effect's instance type, which carries the
// service's key. Name.Shape, which Effect spells Context.Service.Shape<typeof
// Name>, is the members, the type of an implementation: providers check an
// implementation against it, and `implements Name` in a .vibe file checks a
// class against it. Name() returns the implementation typed as the shape, as
// `yield* Name` does, so a parameter that takes it is typed Name.Shape.
error NotFound { id: string }

service Users {
  find(id: string): string!NotFound
  readonly region: string
}

service Flags {
  readonly beta: boolean
  static readonly defaultValue: () => Flags.Shape = () => ({ beta: true })
}

export interface SearchApi {
  find(query: string): string!!
}

// Any type can be a shape: Search() is a SearchApi and Prefix() a string,
// as Context.Service<Search, SearchApi> and Context.Service<Prefix, string>.
service Search: SearchApi
service Prefix: string

class UsersInMemory implements Users {
  readonly region = "memory"
  effect find(id: string) {
    if (id !== "1") throw new NotFound({ id })
    return "Ada"
  }
}

const fake: Users.Shape = { region: "fake", find: effect (id: string) => `fake ${id}` }
const shaped: Context.Service.Shape<typeof Users> = fake

// A plain object has the shape, so a parameter that takes one has that type.
function regionOfShape(users: Users.Shape) {
  return users.region
}

function regionOf(users: Users.Shape) {
  return users.region
}

effect function lookup(id: string) {
  const users = try Users()
  return `${try Users.find(id)} in ${regionOf(users)}, beta ${(try Flags()).beta}`
}

effect function search(query: string) {
  const engine: SearchApi = try Search()
  const prefix: string = try Prefix()
  return `${prefix}${try engine.find(query)}`
}

const UsersLive = Layer.succeed(Users, new UsersInMemory())

const UsersEffect = Layer.effect(Users) {
  return { region: "effect", find: effect (id) => `effect ${id}` }
}

effect function provided(id: string) {
  provide Users = shaped {
    return try lookup(id)
  }
}

effect function searched(query: string) {
  provide Search = { find: effect (q: string) => `hit:${q}` }, Prefix = "> " {
    return try search(query)
  }
}

// expect-result: {"live":"Ada in memory, beta true","effect":"effect 2 in effect, beta true","service":"fake 3 in fake, beta false","block":"fake 4 in fake, beta true","missing":"NotFound","shape":"fake","search":"> hit:q"}
export effect function main() {
  return {
    live: try Effect.provide(effect { return try lookup("1") }, UsersLive),
    effect: try Effect.provide(effect { return try lookup("2") }, UsersEffect),
    service: try Effect.provideService(effect { return try Effect.provideService(effect { return try lookup("3") }, Flags, { beta: false }) }, Users, fake),
    block: try provided("4"),
    missing: (try Effect.flip(effect { return try Effect.provide(effect { return try lookup("9") }, UsersLive) }))._tag,
    shape: regionOfShape(fake),
    search: try searched("q")
  }
}
