// expect-result: [0,0,"00ff",0,1]
import { Effect } from "effect"
import * as Digest from "effect/crypto/Digest"

let rawCalls = 0
let hexCalls = 0
const service = {
  digest: (_: Digest.Algorithm, bytes: Uint8Array) => Effect.sync(() => { rawCalls++; return bytes }),
  digestHex: (_: Digest.Algorithm, bytes: Uint8Array) => Effect.sync(() => { hexCalls++; return "00ff" })
}
export effect function main() {
  const program = effect {
    return try (try Digest.Digest).digestHex(Digest.sha256, new Uint8Array([0, 255]))
  }
  const coldRaw = rawCalls
  const coldHex = hexCalls
  const value = try Effect.provideService(program, Digest.Digest, service)
  return [coldRaw, coldHex, value, rawCalls, hexCalls]
}
