import { Effect, Stream } from "effect"
effect function* values() {
 const { n = do { yield 9; 7 } } = {} as {n?: number}
 yield n
}
export effect function main() {
 const { x = do { try Effect.succeed(7) } } = {} as {x?: number}
 const [y = try Effect.succeed(8)] = [] as number[]
 return { x, y, values: try Stream.runCollect(values()) }
}
