// D311 reaches the experimental services (D313) too: with no import,
// Experimental.Process.pid() calls the Process service, as
// Experimental.Process.Process.pid() does, Experimental.Process() is the
// implementation, and the type Experimental.Process is the service. The
// module's exports keep their meaning: Experimental.Process.layerTest.
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"

function hex(bytes: Uint8Array) {
  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
}

effect function facts() {
  const pid = try Experimental.Process.pid()
  return {
    same: pid === try Experimental.Process.Process.pid(),
    positive: pid > 0,
    running: try Experimental.Process.isRunning(pid),
    host: typeof try Experimental.Process.hostname() === "string",
  }
}

export effect function alive(process: Experimental.Process, pid: number) {
  return try process.isRunning(pid)
}

export effect function faked() {
  provide Experimental.Process.layerTest({ platform: Effect.succeed("win32") }) {
    return try Experimental.Process.platform()
  }
}

export effect function mac(key: Redacted<Uint8Array>, data: Uint8Array) {
  return try Experimental.Crypto.hmac("SHA-256", key, data)
}

export effect function executable(path: string) {
  return try Experimental.FileSystem.access(path, { executable: true })
}

export effect function lock(name: string) {
  return try Experimental.Locks.hold(name)
}

// expect-result: {"same":true,"positive":true,"running":true,"host":true,"alive":true,"faked":"win32","mac":"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"}
export effect function main() {
  provide ExperimentalNodeServices.layer {
    const key = Redacted.make(new TextEncoder().encode("Jefe"))
    const digest = try mac(key, new TextEncoder().encode("what do ya want for nothing?"))
    return { ...try facts(), alive: try alive(try Experimental.Process(), try Experimental.Process.pid()), faked: try faked(), mac: hex(digest) }
  }
}
