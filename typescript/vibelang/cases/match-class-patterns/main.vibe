// expect-result: {"sameName":["A a","timeout 5.0","A b"],"sameNameIs":["A a","timeout","A b"],"family":["app /p","other o"],"shape":["circle","square 2","circle","No match arm matched [object Object]"],"parity":["even","odd 3","neither"],"shapeOrCount":["circle","none","some 4","No match arm matched [object Object]"],"positions":[["square 2"],"No match arm matched [object Object]","square 2","No match arm matched [object Object]","logged","No match arm matched [object Object]"]}
// An error class's matcher tests _tag (chapter 4, VIP-13), so two error
// classes that share a name match each other, as with Effect's catchTag, and
// a value cast to a class type matches by its tag. A family's base still
// covers its subclasses, but not an unrelated error with the same fields
// (D278), and is narrows as match does. D294 keeps the last arm's tests of a
// match that tests a class, because a value's type does not prove its tag: a
// value cast to a class type whose tag no arm names, and one that passes a
// class arm to reach an Option arm, each throw the proposal's TypeError
// instead of taking the last arm (D405). A class with a custom matcher is not
// closed, so its arm covers nothing and its match needs a default arm (D407,
// D428).
import * as A from "./a.vibe"
import * as B from "./b.vibe"

error Timeout { ms: number }
error AppError { _tag: string; code: string }
error Missing extends AppError { path: string }
error Other { code: string }

error Circle { r: number }
error Square { side: number }

class Even {
  readonly _tag = "Even"
  constructor(readonly n: number) {}
}

// Only an instance with an odd n is an Odd.
class Odd {
  readonly _tag = "Odd"
  constructor(readonly n: number) {}
  static [customMatcher](subject: unknown) {
    return subject instanceof Odd && subject.n % 2 === 1
  }
}

type Failure = A.NotFound | B.NotFound | Timeout

function sameName(e: Failure) {
  return match (e) {
    when A.NotFound: `A ${e.id}`;
    when Timeout: `timeout ${e.ms.toFixed(1)}`;
    when B.NotFound: `B ${e.id}`;
  }
}

function sameNameIs(e: Failure) {
  if (e is A.NotFound) return `A ${e.id}`
  if (e is Timeout) return "timeout"
  return `B ${e.id}`
}

function family(e: Missing | Other) {
  return match (e) {
    when AppError: `app ${e.path}`;
    when Other: `other ${e.code}`;
  }
}

function shape(s: Circle | Square) {
  return match (s) {
    when Circle: "circle";
    when Square: `square ${s.side}`;
  }
}

function parity(n: Even | Odd) {
  return match (n) {
    when Even: "even";
    when Odd: `odd ${n.n}`;
    default: "neither";
  }
}

function shapeOrCount(x: Circle | Option.Option<number>) {
  return match (x) {
    when Circle: "circle";
    when Option.None: "none";
    when Option.Some(let n): `some ${n}`;
  }
}

// The last arm keeps its check in each position a match lowers to (D214):
// a statement, inside an expression, and in an Effect function.
function shapeStatement(s: Circle | Square, log: Array<string>) {
  match (s) {
    when Circle: log.push("circle");
    when Square: log.push(`square ${s.side}`);
  }
  return log
}

function shapeExpression(s: Circle | Square) {
  const label = match (s) {
    when Circle: "circle";
    when Square: `square ${s.side}`;
  }
  return label
}

effect function shapeEffect(s: Circle | Square) {
  match (s) {
    when Circle: try Effect.log("circle");
    when Square: try Effect.log(`square ${s.side}`);
  }
  return "logged"
}

// The program's value, or the message of the defect it dies with.
effect function settle<A>(program: A!!) {
  return match (try exit(program)) {
    when Exit.Success(let value): value;
    when Exit.Failure(let cause): (Cause.squash(cause) as Error).message;
  }
}

export effect function main() {
  const circle = { _tag: "Circle", r: 1 } as unknown as Circle
  const stray = { _tag: "Triangle", r: 1 } as unknown as Circle
  return {
    sameName: [sameName(new A.NotFound({ id: "a" })), sameName(new Timeout({ ms: 5 })), sameName(new B.NotFound({ id: "b" }))],
    sameNameIs: [sameNameIs(new A.NotFound({ id: "a" })), sameNameIs(new Timeout({ ms: 5 })), sameNameIs(new B.NotFound({ id: "b" }))],
    family: [family(new Missing({ code: "m", path: "/p" })), family(new Other({ code: "o" }))],
    shape: [shape(new Circle({ r: 1 })), shape(new Square({ side: 2 })), shape(circle), try settle(shape(stray))],
    parity: [parity(new Even(2)), parity(new Odd(3)), try settle(parity(new Odd(2)))],
    shapeOrCount: [shapeOrCount(new Circle({ r: 1 })), shapeOrCount(Option.none()), shapeOrCount(Option.some(4)), try settle(shapeOrCount(stray))],
    positions: [
      shapeStatement(new Square({ side: 2 }), []), try settle(shapeStatement(stray, [])),
      shapeExpression(new Square({ side: 2 })), try settle(shapeExpression(stray)),
      try shapeEffect(new Square({ side: 2 })), try settle(shapeEffect(stray))
    ]
  }
}
