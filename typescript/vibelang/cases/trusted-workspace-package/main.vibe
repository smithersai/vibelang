// VIP-4/VIP-30: package trust is ignored; explicit bridges preserve defects.
import { data, explode, program } from "@smthrs/twin"
export effect function succeeds() {
  return [try orDie(Effect.try({ try: () => data(), catch: error => error })), try program()]
}
export effect function defects() {
  return try orDie(Effect.try({ try: () => explode(), catch: error => error }))
}
