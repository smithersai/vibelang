// expect: EK4301
// A function that declares using compiles to frames (D54), so a callback
// with using cannot be the plain function that Array.prototype.map or
// Effect.sync calls, whether its using holds a TypeScript Disposable or
// acquires an Effect resource.
abstract class Pool {
  abstract acquire(): Effect<{ id: number }, never, Scope>
}

function timer(name: string) {
  return { name, [Symbol.dispose]() {} }
}

export function names(ids: string[]) {
  return ids.map((id) => {
    using t = timer(id)
    return t.name
  })
}

export function connections(ids: string[]) {
  return ids.map((id) => {
    using conn = Pool.acquire()
    return `${id} ${conn.id}`
  })
}

export function synced() {
  return try Effect.sync(() => {
    using t = timer("sync")
    return t.name
  })
}
