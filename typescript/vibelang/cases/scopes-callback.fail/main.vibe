// expect: TS2850 TS2339
// A plain callback is plain JavaScript (VIP-1), so its using holds a
// TypeScript Disposable, as Array.prototype.map and Effect.sync call it; an
// Effect there is TypeScript's own error (TS2850): using acquires no resource.
service Pool {
  acquire(): Effect<{ id: number }, never, Scope>
}

function timer(name: string) {
  return { name, [Symbol.dispose]() {} }
}

export function names(ids: string[]) {
  return ids.map((id) => {
    using t = timer(id)
    return t.name
  })
}

export function connections(ids: string[]) {
  return ids.map((id) => {
    using conn = Pool.acquire()
    return `${id} ${conn.id}`
  })
}

export effect function synced() {
  return try Effect.sync(() => {
    using t = timer("sync")
    return t.name
  })
}
