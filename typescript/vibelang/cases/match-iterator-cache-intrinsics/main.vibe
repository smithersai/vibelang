// expect-result: [[[1,[2]],0],[7,0],[[1,[2]],0]]
import { Effect } from "effect"
import { changedMaps, changeMaps } from "./native-map.js"

export function main() {
  return Effect.sync(() => {
    const reuse = changedMaps(() => match ([1, 2]) {
      when [1, ...] and if (changeMaps()): [];
      when [let first, ...let tail]: [first, tail];
      default: [];
    })
    const close = changedMaps(() => match ([1, 2]) {
      when [1, ...] and if (changeMaps()): 0;
      default: 7;
    })
    const create = changedMaps(() => match ([1, 2]) {
      when [let first, ...let tail]: [first, tail];
      default: [];
    }, true)
    return [reuse, close, create]
  })
}
