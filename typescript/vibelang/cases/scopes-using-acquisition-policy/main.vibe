// An acquisition decides whether its acquire step can be interrupted, inside
// using as outside it, since using adds no mask: using is one Effect program
// for every initializer, which runs it with the interruptibility in force
// where the using stands (D490). Under timeout(…, "100 millis"):
// - using socket = connect(…), whose acquireRelease(…, { interruptible: true })
//   waits, is cut at the wait ("interruptible"); with the acquisition inside
//   an uninterruptible { } block of a helper the initializer calls
//   ("helperMask"), or with the initializer
//   Effect.uninterruptible(() => connect(…)) ("effectMask"), it waits.
// - A nested using keeps its acquisition's policy: openDb binds using lock =
//   acquireLock(…), an interruptible acquisition that waits, so
//   using db = openDb(…) is cut at the lock's wait and the lock's acquisition
//   registers nothing, whether openDb returns a Disposable without requiring
//   Scope ("nestedPlain") or returns its database through acquireRelease, so
//   that it requires Scope ("nestedScoped"). Written
//   using db = Effect.acquireDisposable(() => openDb(…)), the lock's wait runs
//   under acquireDisposable's mask, which the lock's restore gives back, and
//   each resource is released once ("nestedMasked").
// - Effect.acquireDisposable masks its acquire, but interruptible { } and
//   Effect.interruptibleMask set the fiber interruptible under any mask, as
//   Effect's do, so a wait inside either is cut and nothing is disposed
//   ("interruptibleBlock", "interruptibleMask"). With the wait outside them
//   ("outside"), or inside an inner acquireRelease(…, { interruptible: true })
//   ("inner"), it waits, and each resource is released once.
// Each list ends with how the deadline ended, after every release ran.
// expect-result: {"interruptible":["TimeoutError"],"helperMask":["connected","released","TimeoutError"],"effectMask":["connected","released","TimeoutError"],"nestedPlain":["TimeoutError"],"nestedScoped":["TimeoutError"],"nestedMasked":["locked","opened","unlocked","disposed","TimeoutError"],"interruptibleBlock":["TimeoutError"],"interruptibleMask":["TimeoutError"],"outside":["opened","disposed","TimeoutError"],"inner":["ticketed","opened","disposed","ticket released","TimeoutError"]}
export effect function main() {
  return {
    interruptible: try deadline(effect (seen) => try holdSocket(seen)),
    helperMask: try deadline(effect (seen) => try holdHelperMask(seen)),
    effectMask: try deadline(effect (seen) => try holdEffectMask(seen)),
    nestedPlain: try deadline(effect (seen) => try holdNestedPlain(seen)),
    nestedScoped: try deadline(effect (seen) => try holdNestedScoped(seen)),
    nestedMasked: try deadline(effect (seen) => try holdNestedMasked(seen)),
    interruptibleBlock: try deadline(effect (seen) => try holdInterruptibleBlock(seen)),
    interruptibleMask: try deadline(effect (seen) => try holdInterruptibleMask(seen)),
    outside: try deadline(effect (seen) => try holdOutside(seen)),
    inner: try deadline(effect (seen) => try holdInner(seen))
  }
}

// A pause the deadline cuts short, and one a masked acquire waits out.
const long = "2 seconds"
const short = "300 millis"

// Runs work under a 100 ms deadline and returns what it recorded, then how
// the deadline ended.
effect function deadline(work: (seen: string[]) => void!!) {
  const seen: string[] = []
  try {
    try Effect.timeout(effect { return try work(seen) }, "100 millis")
    seen.push("finished")
  } catch (e) {
    seen.push(e._tag)
  }
  return seen
}

effect function connect(seen: string[], pause: Duration.Input) {
  return try Effect.acquireRelease(
    effect {
      try sleep(pause)
      seen.push("connected")
      return { socket: "open" }
    },
    effect () => {
      seen.push("released")
    },
    { interruptible: true }
  )
}

effect function connectMasked(seen: string[], pause: Duration.Input) {
  uninterruptible {
    return try connect(seen, pause)
  }
}

effect function acquireLock(seen: string[], pause: Duration.Input) {
  return try Effect.acquireRelease(
    effect {
      try sleep(pause)
      seen.push("locked")
      return { held: true }
    },
    effect () => {
      seen.push("unlocked")
    },
    { interruptible: true }
  )
}

function disposable(seen: string[]) {
  seen.push("opened")
  return { [Symbol.dispose](): void { seen.push("disposed") } }
}

// Its using supplies the lock's Scope, so openLocked requires no Scope.
effect function openLocked(seen: string[], pause: Duration.Input) {
  using lock = try acquireLock(seen, pause)
  return disposable(seen)
}

// It returns its database through acquireRelease, so it requires Scope.
effect function openLockedScoped(seen: string[], pause: Duration.Input) {
  using lock = try acquireLock(seen, pause)
  seen.push("opened")
  return try Effect.acquireRelease(effect { return ({ name: "db" }) }, effect () => {
    seen.push("closed")
  })
}

effect function openInterruptible(seen: string[], pause: Duration.Input) {
  interruptible {
    try sleep(pause)
  }
  return disposable(seen)
}

effect function openInterruptibleMask(seen: string[], pause: Duration.Input) {
  try Effect.interruptibleMask(effect () => {
    try sleep(pause)
  })
  return disposable(seen)
}

effect function openDb(seen: string[], pause: Duration.Input) {
  try sleep(pause)
  return disposable(seen)
}

effect function openInner(seen: string[], pause: Duration.Input) {
  const ticket = try Effect.acquireRelease(
    effect {
      try sleep(pause)
      seen.push("ticketed")
      return "ticket"
    },
    effect () => {
      seen.push("ticket released")
    },
    { interruptible: true }
  )
  return disposable(seen)
}

effect function holdSocket(seen: string[]) {
  using socket = try connect(seen, long)
  seen.push("body")
}

effect function holdHelperMask(seen: string[]) {
  using socket = try connectMasked(seen, short)
  seen.push("body")
}

effect function holdEffectMask(seen: string[]) {
  using socket = try Effect.uninterruptible(effect { return try connect(seen, short) })
  seen.push("body")
}

effect function holdNestedPlain(seen: string[]) {
  using db = try openLocked(seen, long)
  seen.push("body")
}

effect function holdNestedScoped(seen: string[]) {
  using db = try openLockedScoped(seen, long)
  seen.push("body")
}

effect function holdNestedMasked(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openLocked(seen, short) })
  seen.push("body")
}

effect function holdInterruptibleBlock(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openInterruptible(seen, long) })
  seen.push("body")
}

effect function holdInterruptibleMask(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openInterruptibleMask(seen, long) })
  seen.push("body")
}

effect function holdOutside(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openDb(seen, short) })
  seen.push("body")
}

effect function holdInner(seen: string[]) {
  using db = try Effect.acquireDisposable(effect { return try openInner(seen, short) })
  seen.push("body")
}
