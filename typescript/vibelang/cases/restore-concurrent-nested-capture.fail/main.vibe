// expect: EK2202 EK2202 EK2202 EK2202 EK2202
export effect function outer() {
  uninterruptible {
    for concurrent (const item of [1]) {
      const arrow = effect () => { restore {} };
      effect function declaration() { restore {} }
      const block = effect { restore {} };
      class Nested { effect method() { restore {} } }
      effect function* producer() { restore {}; yield 1 }
      const ownMask = effect () => { uninterruptible { restore {} } };
