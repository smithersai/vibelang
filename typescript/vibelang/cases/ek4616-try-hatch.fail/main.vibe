// expect: EK4616 EK4616
// try(…) is no longer a hatch (VIP-5): try runs an Effect, and Effect.try or
// Effect.tryPromise wraps code that may throw or reject. EK4616's quick fix
// writes the wrapper, binding the hatch's inputs to its arrow's parameters.
error Bad { cause: unknown }

export effect function main() {
  try yieldNow()
  const n = try((text: string) => JSON.parse(text), (cause) => new Bad({ cause }), "1")
  const m = try(async () => 1)
  return [n, m]
}
