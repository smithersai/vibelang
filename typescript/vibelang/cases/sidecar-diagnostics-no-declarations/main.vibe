// expect-result: 1
// A sidecar is the compiler's own output, so a project that asks for no
// declarations does not fail on what one cannot print: what declaration emit
// reports is a warning there, and an error where the project emits them.
export const value = new (class {
  private hidden = 1
  read() { return this.hidden }
})()

export effect function main() {
  return value.read()
}
