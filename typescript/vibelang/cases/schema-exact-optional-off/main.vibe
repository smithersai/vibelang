export schema S { mutable plain?: string; readonly frozen?: number; mutable loose?: string | undefined; mutable nested?: { mutable value?: boolean }; mutable converted?: Schema.NumberFromString; readonly broad?: Schema.Unknown; readonly anything?: Schema.Any }
