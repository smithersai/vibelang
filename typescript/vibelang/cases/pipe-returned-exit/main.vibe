// expect-result: [true,true,7,true,9,5]
// More shapes beside returned-pipe-exit-data: a pipe returned from a block
// under restore, a pipe of two stages, and a plain callback under a written
// number success. A pipe's value is its body's (VIP-23): an Exit a running body
// succeeds with is data, as for the call without the pipe.
const settled = effect (effect: number!string!): Exit.Exit<number, string>!! =>
  try Effect.suspend(effect () => Effect.exit(effect) |> try Effect.ensuring(%, Effect.void))

const masked = effect (effect: number!string!): Exit.Exit<number, string>!! =>
  try Effect.uninterruptibleMask(effect (restore) => {
    return restore(Effect.exit(effect)) |> try Effect.ensuring(%, Effect.void)
  })

const chained = effect (effect: number!string!): Exit.Exit<number, string>!! =>
  try Effect.suspend(effect () => Effect.exit(effect) |> Effect.ensuring(%, Effect.void) |> try Effect.tap(%, effect () => try Console.log("settled")))

// A plain callback returns what it evaluates to: the Exit stays the program
// suspend runs, as Effect.suspend(() => Exit.succeed(n)) does (VIP-1).
const fromValue = effect (n: number): number!! => try Effect.suspend(() => n |> Exit.succeed(%))

export effect function main() {
  const failed = try settled(Effect.fail("boom"))
  const ok = try masked(Effect.succeed(7))
  const tapped = try chained(Effect.succeed(9))
  return [
    Exit.isFailure(failed),
    Exit.isSuccess(ok),
    Exit.isSuccess(ok) ? ok.value : -1,
    Exit.isSuccess(tapped),
    Exit.isSuccess(tapped) ? tapped.value : -1,
    try fromValue(5),
  ]
}
