// expect-result: [[42],[1,2]]
// await.all and for concurrent call the runtime's $awaitAll and
// $forConcurrent. Functions of the file spelled the same are functions of
// their own, and the forms still start fibers and run their bodies.
function $awaitAll(xs: unknown[]) { return "hijacked" }
function $forConcurrent(xs: number[], n: number, f: (n: number) => void) { return 999 }

effect function work() {
  try sleep("1 millis")
  return 42
}

export effect function main() {
  const result = await.all [work()]
  const seen: number[] = []
  for concurrent(2) (const n of [1, 2]) seen.push(n)
  return [result, seen.sort()]
}
