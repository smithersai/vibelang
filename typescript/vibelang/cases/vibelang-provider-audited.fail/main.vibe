// expect: EK3101
// A member that looks a service up each time it is called needs that
// service in the caller's Context, so the contract must declare it (Chapter
// 4, "Requirements that would leak"). Capturing it when the layer is built,
// as Database is here, is the other fix.
import { Data, Effect, Layer } from "effect"

class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Users {
  find(id: string): Effect.Effect<User, UserNotFound, never>
}

service Database {
  query(sql: string): Effect.Effect<User | undefined, never, never>
}

service Audit {
  record(entry: string): Effect.Effect<void, never, never>
}

export const UsersAudited = Layer.effect(Users, effect {
  const db = try Database()
  return {
    effect find(id) {
      try Audit.record(`users.find ${id}`)
      const user = try db.query(`select ${id}`)
      if (user === undefined) return try Effect.fail(new UserNotFound({ id }))
      return try Effect.succeed(user)
    }
  }
})

export class UsersLogged implements Users {
  effect find(id: string) {
    try Audit.record(`find ${id}`)
    return try Effect.fail(new UserNotFound({ id }))
  }
}
