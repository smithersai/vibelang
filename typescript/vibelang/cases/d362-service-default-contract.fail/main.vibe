// expect: EK2001 EK3101
error Failed
service Audit { record(): void!! }

service Flaky {
  read(): number!!
  static readonly default = {
    read() { throw new Failed() }
  }
}

service Leaky {
  read(): number!!
  static readonly default = {
    read() { try Audit.record(); return 1 }
  }
}

export function example() { return try Flaky.read() + try Leaky.read() }
