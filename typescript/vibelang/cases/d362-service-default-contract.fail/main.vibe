// expect: EK9201 EK3101
error Failed
service Audit { record(): void!! }

service Flaky {
  read(): number!!
  static readonly defaultValue = () => ({
    effect read() { throw new Failed() }
  })
}

service Leaky {
  read(): number!!
  static readonly defaultValue = () => ({
    effect read() { try (try Audit).record(); return 1 }
  })
}

export effect function example() { return try (try Flaky).read() + try (try Leaky).read() }

