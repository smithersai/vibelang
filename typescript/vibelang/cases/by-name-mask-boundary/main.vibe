import { write, publish, operand, transaction, writeValue, twice, make } from "./probe.js"

// Explicit function signatures expose program positions to both compilers.
const repeat: (program: Effect.Effect<number>) => Effect.Effect<number[]> = twice

export function commitThenPublish(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(write())
    try publish()
  })
}

export function withOperand(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(write(operand()))
    try publish()
  })
}

export function withTopic(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    write() |> try restore(%)
    try publish()
  })
}

export function withValue(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(writeValue())
    try publish()
  })
}

export function withOptional(): void!! {
  const writer: { write?: typeof write } = { write }
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(writer.write?.())
    try publish()
  })
}

export function withTag(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(transaction`commit`)
    try publish()
  })
}

export function withThis(this: { write: typeof write }): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(this.write())
    try publish()
  })
}

export function withMethod(): void!! {
  try Effect.uninterruptibleMask((restoreInterruptibility) => {
    const restore: (program: Effect.Effect<void>) => Effect.Effect<void> = restoreInterruptibility
    try restore(writeValue.interruptible())
    try publish()
  })
}

export function lazyTwice() {
  return try repeat(make())
}
