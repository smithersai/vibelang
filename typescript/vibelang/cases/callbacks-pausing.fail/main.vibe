// expect: EK4301
// A callback that can pause, passed where JavaScript calls it synchronously
// (design D9): Array.prototype.map and forEach call their callbacks on a
// JavaScript stack frame that cannot pause, so each of these is EK4301.
import { Console } from "effect"
import { find } from "./helpers.ts"

function findId(id: string) {
  return (try find(id)).id
}

export function lambdas(ids: ReadonlyArray<string>) {
  const found = ids.map((id) => find(id))
  ids.forEach((id) => Console.log(id))
  return found
}

export function named(ids: ReadonlyArray<string>) {
  return ids.map(findId)
}
