// expect: EK0501
// A plain callback cannot use try (EK0501). An explicitly written
// effect function remains a value with its Effect return type; TypeScript
// accepts that value at void destinations and forEach drops its program.
// Neither destination supplies a function-kind conversion (VIP-1/detail303).
import { Console } from "effect"
import { find } from "./helpers.ts"

effect function findId(id: string) {
  return (try find(id)).id
}

export function lambdas(ids: ReadonlyArray<string>) {
  const found = ids.map((id) => try find(id))
  ids.forEach((id) => try Console.log(id))
  return found
}

export function named(ids: ReadonlyArray<string>) {
  ids.forEach(findId)
  return ids.map(findId)
}
