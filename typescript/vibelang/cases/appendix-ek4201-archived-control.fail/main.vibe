// The archived EK4201 input below reports EK3501 and the TypeScript errors of
// its unresolved control class, never EK4201.

import { Fiber } from "effect"

abstract class Ask extends Control {
  abstract ask(question: string): Effect<number, never, never>
}

effect function forked() {
  return try handle(effect {
    const child = fork Ask.ask("in a child fiber")
    return try Fiber.join(child)
  }, Ask, {
    effect ask(question, k) { return try resume(k, question.length) }
  })
}
