// expect: EK2119
// opus-5: a value computed from a saved resume result changes the answer.
control Ask { ask(): number!! }

function prog() {
  const a = try Ask.ask()
  const b = try Ask.ask()
  return a + b
}

function run() {
  try {
    return try prog()
  } handle Ask.ask() {
    const r = try resume(1)
    return r.toFixed(1)
  }
}

export function main() { try log(`result: ${try run()}`) }
