// A plain holder acquired with Effect.acquireRelease, whose release disposes
// holder.value, closes a JavaScript Disposable once: the acquisition records
// its release, registered inside the protected acquisition (D25, D401). The
// holder is no longer needed, since using adds no release to a value that an
// acquisition recorded (scopes-using-effect-release), but it still works.
// The Disposable throws when it is closed twice, so each run shows exactly
// one close: on success, typed failure, defect, and pending interruption.
module files {
  export function open(events: string[]) {
    let closed = false
    events.push("open")
    return {
      [Symbol.dispose](): void {
        if (closed) throw new Error("closed twice")
        closed = true
        events.push("closed")
      }
    }
  }
}
import { open } from files

error Bad {}

function acquire(events: string[]) {
  return try Effect.acquireRelease(
    () => ({ value: try sync((log: string[]) => open(log), events) }),
    (holder) => sync((h) => h.value[Symbol.dispose](), holder)
  )
}

function describe(outcome: Exit.Exit<void, Bad>) {
  if (Exit.isSuccess(outcome)) return "success"
  if (Exit.hasDies(outcome)) return "defect"
  if (Exit.hasFails(outcome)) return "failure"
  return Exit.hasInterrupts(outcome) ? "interrupted" : "other"
}

function run(ending: string) {
  const events: string[] = []
  const outcome = try exit(() => {
    using file = try acquire(events)
    events.push("body")
    if (ending === "fail") throw new Bad()
    if (ending === "die") try Effect.die("boom")
  })
  return [try describe(outcome), events]
}

function pending() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()
  function work() {
    using file = try Effect.acquireRelease(
      () => {
        try Deferred.succeed(entered, undefined)
        try Deferred.await(gate)
        return { value: try sync((log: string[]) => open(log), events) }
      },
      (holder) => sync((h) => h.value[Symbol.dispose](), holder)
    )
    events.push("never runs")
  }
  const child = try Effect.forkChild(work())
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  const outcome = try Fiber.await(child)
  return [try describe(outcome), events]
}

// expect-result: {"succeeds":["success",["open","body","closed"]],"fails":["failure",["open","body","closed"]],"dies":["defect",["open","body","closed"]],"pending":["interrupted",["open","closed"]]}
export function main() {
  return { succeeds: try run("succeed"), fails: try run("fail"), dies: try run("die"), pending: try pending() }
}
