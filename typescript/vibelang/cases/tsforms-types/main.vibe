// expect-result: {"loaded":3,"checked":"ok","held":"held","callback":4,"maybe":5,"nested":6,"kept":7}
// An explicit Effect type draws EK4833 (D287); a safe fix writes ! without
// adding grouping or changing declarations (details260/277). Other positions
// and explicit infer channels retain the qualified type. An omitted slot is
// never, and the directive keeps an additional qualified spelling.
// tsforms-types-fixed is what vibelang --fix writes.
error Missing { id: string }

effect function load(id: string): Effect.Effect<number, Missing, never> {
  if (id === "") throw new Missing({ id })
  return id.length
}

effect function checked(program: Effect.Effect<number, Missing>): Effect.Effect<string, never, infer R> {
  const n = program catch () => -1
  return n >= 0 ? "ok" : "missing"
}

const held: Effect.Effect<string> = Effect.sync(() => "held")
const six: Effect.Effect<number> = Effect.sync(() => 6)

type Callback = (n: number) => Effect.Effect<number>
const callback: Callback = effect (n) => n + 1

effect function maybe(program: Effect.Effect<number> | undefined): number!! {
  return program === undefined ? 0 : try program
}

effect function nested(program: Effect.Effect<Effect.Effect<number>>): number!! {
  const inner = try program
  return try inner
}

effect function kept(
  // @vibelang-diagnostics-next-line EK4833:off
  program: Effect.Effect<number>
): number!! {
  return try program
}

export effect function main() {
  return {
    loaded: try load("abc"),
    checked: try checked(load("x")),
    held: try held,
    callback: try callback(3),
    maybe: try maybe(Effect.succeed(5)),
    nested: try nested(Effect.succeed(six)),
    kept: try kept(Effect.succeed(7))
  }
}
