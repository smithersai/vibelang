export function throwOverride(): unknown { try { return do { try { 1; } finally { raise(8); } }; } catch (error) { return error; } }
export function continueOverride(): number {
  let total = 0;
  for (let i = 0; i < 3; i++) {
    const value = do { try { i; } finally { if (i < 2) continue; 99; } };
    total += value;
  }
  return total;
}
export function differentNormalType(): number { return do { try { 1; } finally { "discarded"; } }; }
export function differentAbruptType(): unknown { return do { label: { try { 1; } finally { "final"; break label; } } }; }
// The pinned do algorithm applies UpdateEmpty to abrupt completions too: the inner do carries 7.
export function nestedDoBreak(): unknown { return do { label: { try { 1; } finally { (do { 7; break label; }); } } }; }

