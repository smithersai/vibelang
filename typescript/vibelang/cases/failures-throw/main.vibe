import * as $nativeTryEffect4 from "effect/Effect";
import * as $nativeTryEffect3 from "effect/Effect";
import * as $nativeTryEffect2 from "effect/Effect";
import * as $nativeTryEffect1 from "effect/Effect";
import * as $nativeTryEffect from "effect/Effect";
// throw is Effect.fail (D46): the thrown value is an expected failure, and its
// type joins the function's E. A catch handles the try block's expected
// failures and receives their union, which instanceof and _tag narrow.
import { Data, Effect } from "effect"

export class InvalidId extends Data.TaggedError("InvalidId")<{ readonly raw: string }> {}
export class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}

export interface User {
  id: string
  name: string
}

const guest: User = { id: "0", name: "Guest" }
const users = new Map<string, User>([["42", { id: "42", name: "Ada" }]])

// A throw is enough to make a function an Effect: Effect<number, InvalidId, never>.
export effect function parseId(raw: string) {
  if (!/^\d+$/.test(raw)) throw new InvalidId({ raw })
  return Number(raw)
}

export effect function find(id: string) {
  const user = users.get(id)
  if (user === undefined) throw new UserNotFound({ id })
  return user
}

// The catch handles UserNotFound; InvalidId escapes from before the try.
export effect function lookup(raw: string) {
  const id = try parseId(raw)
  { const $nativeTryCompletion = try $nativeTryEffect.catch(effect {
    return { kind: "return:" as const, value: (try find(String(id))) };
  }, effect (e) => {
    return { kind: "return:" as const, value: (guest) };
  });
return $nativeTryCompletion.value;
}
}

// e is InvalidId | UserNotFound; after the instanceof test it is InvalidId,
// which the rethrow adds to E.
export effect function lookupOrGuest(raw: string) {
  { const $nativeTryCompletion1 = try $nativeTryEffect1.catch(effect {
    return { kind: "return:" as const, value: (try find(String(try parseId(raw)))) };
  }, effect (e) => {
    if (e instanceof UserNotFound) return { kind: "return:" as const, value: (guest) };
    throw e
  });
return $nativeTryCompletion1.value;
}
}

// Any value can be thrown; a fresh literal widens as in a return type.
export effect function oops(n: number) {
  if (n > 1) throw "bad"
  if (n > 0) throw new Error("worse")
  return n
}

// _tag narrows the caught union too.
export effect function describe(raw: string) {
  { const $nativeTryCompletion2 = try $nativeTryEffect2.catch(effect {
    return { kind: "return:" as const, value: ((try find(String(try parseId(raw)))).name) };
  }, effect (e) => {
    switch (e._tag) {
      case "InvalidId":
        return { kind: "return:" as const, value: (`invalid ${e.raw}`) };
      case "UserNotFound":
        return { kind: "return:" as const, value: (`missing ${e.id}`) };
      default: throw e;
    }
});
return $nativeTryCompletion2.value;
}
}

// A lambda that can throw is an Effect function too.
const doubled = effect (n: number): number!InvalidId! => {
  if (n < 0) throw new InvalidId({ raw: String(n) })
  return n * 2
}

// expect-result: {"found":"Ada","missing":"Guest","orGuest":"Guest","invalid":"InvalidId","oops":["bad","worse",0],"describe":["Ada","invalid x","missing 7"],"lambda":[42,"InvalidId"]}
export effect function main() {
  let invalid = "none"
  { const $nativeTryCompletion3 = try $nativeTryEffect3.catch(effect {
    try lookupOrGuest("x")
  
;return { kind: "normal" } as const;
}, effect (e) => {
    invalid = e._tag
  
;return { kind: "normal" } as const;
});

}
  const failures: Array<string | number> = []
  for (const n of [2, 1, 0]) {
    { const $nativeTryCompletion4 = try $nativeTryEffect4.catch(effect {
      failures.push(try oops(n))
    
;return { kind: "normal" } as const;
}, effect (e) => {
      failures.push(typeof e === "string" ? e : e.message)
    
;return { kind: "normal" } as const;
});

}
  }
  return {
    found: (try lookup("42")).name,
    missing: (try lookup("7")).name,
    orGuest: (try lookupOrGuest("7")).name,
    invalid,
    oops: failures,
    describe: [try describe("42"), try describe("x"), try describe("7")],
    lambda: [try doubled(21), try Effect.catch(effect { return try doubled(-1) }, effect (e) => e._tag)]
  }
}
