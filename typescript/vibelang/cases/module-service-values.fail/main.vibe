// expect: TS2339
// A module namespace and a service key retain their native TypeScript
// properties. Neither Path.sep nor Path.Path.sep projects a Shape member.
// Read (try Path.Path).sep instead, as VIP-10 requires.
// Terminal.columns is absent too: read try Terminal.Terminal first, then
// run its columns Effect with try, as VIP-5 requires.
// module-service-values runs both explicit lookup forms.
export function main() {
  const sep = Path.sep
  const columns = Terminal.columns
  const viaKey = Path.Path.sep
  // rule-evidence: docs/design/src/900-appendices.md#appendix-b-diagnostics
  const nativeKey: string = Path.Path.key
  return [sep, columns, viaKey, nativeKey]
}

