// expect-result: ["waiting",1]
// An arm's matcher expression is evaluated once per match, in the last arm
// as in any other: the getter that supplies this arm's class runs once, as it
// does when the match has a default arm.
class Ready {}
class Waiting {}

let reads = 0

const registry = {
  get Waiting(): typeof Waiting {
    reads++
    return Waiting
  }
}

function label(x: Ready | Waiting) {
  return match (x) {
    when Ready: "ready";
    when registry.Waiting: "waiting";
  }
}

export effect function main() {
  return [label(new Waiting()), reads]
}
