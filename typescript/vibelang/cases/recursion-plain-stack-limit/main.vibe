// VIP-1: native plain recursion RangeError
// docs/design/vips/0001-effect-and-async-functions.md#b402ca04c0a18979
// VIP-1: native plain recursion RangeError
// expect-result: "RangeError"
// The fixed test runtime has a finite stack; the spec gives no portable depth.
import { observe } from "./observe.ts"
function depth(n: number): number { return n === 0 ? 0 : 1 + depth(n - 1) }
export effect function main() {
  return try Effect.try(() => observe(() => depth(100000)))
}

// Spec rule: docs/design/src/001-functions.md#b402ca04c0a18979
// Chapter 001: plain recursion reaches a RangeError at native stack depth; Effect recursion has a separate 100000-call control (recursion-plain-stack-limit).

