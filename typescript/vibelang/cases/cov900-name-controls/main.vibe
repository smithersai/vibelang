export effect function fork(): number!! { return 2 }
const declaredFork = fork
const o = { effect join(): number!! { return 3 } }
const effect = (x: number) => x + 1
const names = { fork: 4, join: 5 }
export effect function main() {
 return [try declaredFork(), try o.join(), effect(5), names.fork, names.join]
}
