// VIP-40: the parser commits on module, an identifier, then a brace — spec-rule: docs/design/vips/0040-module-declarations.md#d481e68133ed0ab7
// A line break between the name and the brace is allowed, as in TC39.
module text
{
  export const n = 1
}

import { n } from text

// expect-result: 1
export effect function main() {
  return n
}
