// expect-result: [2,"set-by-constructor","set-by-constructor",true]
// Decoding invokes a Schema constructor override after successful validation.
// rule-evidence: docs/design/src/007-tooling.md#effects-type-aware-lint
// rule-evidence: docs/design/src/900-appendices.md#transitional-compiler-diagnostics
let calls = 0

class Overridden extends Schema.Class<Overridden>("Overridden")({ a: Schema.String }) {
  declare readonly extra: string

  constructor(props: { readonly a: string }, options?: Schema.MakeOptions) {
    super(props, options)
    calls++
    Object.defineProperty(this, "extra", { value: "set-by-constructor" })
  }
}

export effect function main() {
  const decoded = try Schema.decodeUnknownEffect(Overridden)({ a: "x" })
  const again = try Schema.decodeUnknownEffect(Overridden)({ a: "y" })
  return [calls, decoded.extra, again.extra, decoded !== again]
}
