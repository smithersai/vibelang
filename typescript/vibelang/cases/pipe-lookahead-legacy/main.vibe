// expect-result: "function"
// pipe is Effect's ordinary function: its first argument is the value it is,
// whatever its first stage takes (VIP-2).
function inspect(value: number!!): string
function inspect(value: unknown): string
function inspect(value: unknown): string {
  return Effect.isEffect(value) ? "program" : "function"
}

export effect function main() {
  return pipe(effect () => 5, inspect)
}
