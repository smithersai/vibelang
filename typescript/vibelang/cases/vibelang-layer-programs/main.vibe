// A Layer.effect program whose result is context sensitive, an object
// literal whose methods and arrows have untyped parameters, still infers the
// layer's E and R (D7): find's id is typed by the service, and Database is a
// requirement of building the layer, not of calling Users.find.
import { Data, Effect, Layer } from "effect"

class UserNotFound extends Data.TaggedError("UserNotFound")<{ readonly id: string }> {}

interface User {
  id: string
  name: string
}

service Database {
  lookup(id: string): Effect.Effect<User | undefined, never, never>
}

service Users {
  find(id: string): Effect.Effect<User, UserNotFound, never>
  count(): Effect.Effect<number, never, never>
}

const DatabaseLive = Layer.succeed(Database, {
  lookup: effect (id: string) => try Effect.succeed(id === "1" ? { id, name: "Ada" } : undefined)
})

const UsersLive = Layer.effect(Users, effect {
  const db = try Database()
  return {
    effect find(id) {
      const user = try db.lookup(id)
      if (user === undefined) return try Effect.fail(new UserNotFound({ id }))
      return try Effect.succeed(user)
    },
    count: effect () => 1
  }
})

type Equals<A, B> = (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false
export const inferred: Equals<typeof UsersLive, Layer.Layer<Users, never, Database>> = true

// expect-result: {"name":"Ada","count":1,"missing":"UserNotFound"}
export effect function main() {
  return try Effect.provide(effect {
    const name = (try Users.find("1")).name
    const count = try Users.count()
    const missing = (try Effect.flip(effect { return try Users.find("9") }))._tag
    return { name, count, missing }
  }, Layer.provide(UsersLive, DatabaseLive))
}
