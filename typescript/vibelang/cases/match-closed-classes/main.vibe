// Chapter 007 / generated tag, custom matcher and retained fixed guard distinction: docs/design/src/007-tooling.md#6a91c4b25b602d72
// Generated error declarations retain their finite cases. Expanded native
// constructor arms retain source narrowing and use explicit fallback coverage.
// Legacy D407/D428 constructor-only coverage is superseded by VIP-7.


import { $errorSubclass } from "vibelang-runtime"
import { $ErrorArgs } from "vibelang-runtime"

import { TaggedError as $ErrorTaggedError } from "vibelang-runtime"

error Gone { id: string }
class AppError extends $ErrorTaggedError("AppError" as string)<{
    readonly _tag: string;
    readonly code: string;
}> {
}
class Missing extends $errorSubclass(AppError, "Missing") {
declare readonly _tag: "Missing";
readonly declare path: string;
constructor(args: $ErrorArgs<typeof AppError, Pick<Missing, "path">>) {
    super(args);
}
}
class Expired extends $errorSubclass(AppError, "Expired") {
declare readonly _tag: "Expired";
}
schema error Bad { reason: string }

function closed(e: Gone | Missing | Expired | Bad) {
  return match (e) {
    when Gone: "gone";
    when Missing: `missing ${e.path}`;
    when Expired: "expired";
    when Bad: "bad";
    default: "outside";
  }
}

function family(e: Missing | Expired) {
  return match (e) {
    when AppError: e.code;
    default: "outside";
  }
}

function effects(e: Cause.NoSuchElementError | Gone) {
  return match (e) {
    when Cause.NoSuchElementError: "none";
    when Gone: "gone";
    default: "outside";
  }
}

// expect-result: {"closed":["gone","missing /p","expired","bad"],"family":["m","x"],"effects":["none","gone"]}
export effect function main() {
  return {
    closed: [closed(new Gone({ id: "1" })), closed(new Missing({ code: "m", path: "/p" })), closed(new Expired({ code: "x" })), closed(new Bad({ reason: "r" }))],
    family: [family(new Missing({ code: "m", path: "/p" })), family(new Expired({ code: "x" }))],
    effects: [effects(new Cause.NoSuchElementError()), effects(new Gone({ id: "2" }))]
  }
}
