// expect: EK0401
// D269: a factory's body runs as plain JavaScript when it is called, and
// synchronous VibeLang code never throws (Will, 2026-10-31), so a throw there
// is EK0401. The returned program fails instead: return () => { throw … }.
export error Missing { reason: string }

export const refuse = (reason: string): Effect.Effect<never, Missing, never> => {
  if (reason === "") throw new Missing({ reason })
  return effect { throw new Missing({ reason }) }
}
