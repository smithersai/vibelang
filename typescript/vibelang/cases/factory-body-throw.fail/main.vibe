// expect: EK2115
// D282 with D269: a factory's body runs as plain JavaScript when it is
// called, and a plain function never fails, so a throw there is EK2115. The
// returned program fails instead: return () => { throw … }.
export error Missing { reason: string }

export const refuse = (reason: string): Effect.Effect<never, Missing, never> => {
  if (reason === "") throw new Missing({ reason })
  return effect { throw new Missing({ reason }) }
}
