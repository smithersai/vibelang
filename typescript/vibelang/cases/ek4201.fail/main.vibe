// expect: EK4201
// A control operation inside a combinator that runs it on another fiber
// cannot reach the handler on this fiber (chapter 9). The calls in allowed()
// stay on this fiber or handle the operation inside the branch.
import { Data, Effect, Stream } from "effect"
import { Control, handle, resume } from "vibelang-runtime"

class Busy extends Data.TaggedError("Busy")<{}> {}

abstract class Approval extends Control {
  abstract approve(request: string): Effect.Effect<boolean, Busy, never>
}

export effect function concurrent(ids: ReadonlyArray<string>) {
  return try Effect.forEach(ids, effect (id) => try Approval.approve(id), { concurrency: 4 })
}

export effect function raced() {
  return try Effect.race(effect { return try Approval.approve("a") }, effect { return try Approval.approve("b") })
}

export effect function timed() {
  return try Effect.timeout(effect { return try Approval.approve("slow") }, "1 second")
}

// A producer runs on a fiber of its own (VIP-21), whatever consumes it.
function* approvals(ids: ReadonlyArray<string>) {
  for (const id of ids) yield try Approval.approve(id)
}

export effect function collected(ids: ReadonlyArray<string>) {
  return try Stream.runCollect(approvals(ids))
}

export effect function looped(ids: ReadonlyArray<string>) {
  let approved = 0
  for (const ok of approvals(ids)) if (ok) approved++
  return approved
}

export effect function allowed(ids: ReadonlyArray<string>) {
  const sequential = try Effect.forEach(ids, effect (id) => try Approval.approve(id))
  const one = try Effect.forEach(ids, effect (id) => try Approval.approve(id), { concurrency: 1 })
  const inside = try Effect.forEach(ids, effect (id) =>
    try handle(effect { return try Approval.approve(id) }, Approval, {
      approve: effect (_request, k) => try resume(k, true)
    }),
    { concurrency: 4 })
  return [sequential, one, inside]
}
