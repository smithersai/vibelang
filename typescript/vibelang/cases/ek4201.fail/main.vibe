// expect: EK4201
// A control operation inside a combinator that runs it on another fiber
// cannot reach the handler on this fiber (chapter 9). The calls in allowed()
// stay on this fiber or handle the operation inside the branch.
import { Data, Effect, Stream } from "effect"
import { Control, handle, resume } from "vibelang-runtime"

class Busy extends Data.TaggedError("Busy")<{}> {}

abstract class Approval extends Control {
  abstract approve(request: string): Effect.Effect<boolean, Busy, never>
}

export function concurrent(ids: ReadonlyArray<string>) {
  return try Effect.forEach(ids, (id) => Approval.approve(id), { concurrency: 4 })
}

export function raced() {
  return try Effect.race(() => Approval.approve("a"), () => Approval.approve("b"))
}

export function timed() {
  return try Effect.timeout(() => Approval.approve("slow"), "1 second")
}

// A producer used as a Stream runs on a fiber of its own (D26).
function* approvals(ids: ReadonlyArray<string>) {
  for (const id of ids) yield try Approval.approve(id)
}

export function collected(ids: ReadonlyArray<string>) {
  return try Stream.runCollect(approvals(ids))
}

export function looped(ids: ReadonlyArray<string>) {
  let approved = 0
  for (const ok of approvals(ids)) if (ok) approved++
  return approved
}

export function allowed(ids: ReadonlyArray<string>) {
  const sequential = try Effect.forEach(ids, (id) => Approval.approve(id))
  const one = try Effect.forEach(ids, (id) => Approval.approve(id), { concurrency: 1 })
  const inside = try Effect.forEach(ids, (id) =>
    handle(() => Approval.approve(id), Approval, {
      approve: (_request, k) => resume(k, true)
    }),
    { concurrency: 4 })
  return [sequential, one, inside]
}
