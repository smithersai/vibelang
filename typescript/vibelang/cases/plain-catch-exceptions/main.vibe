// D282 (amends D260): a plain function's catch receives typed failures only.
// The exceptions from coercion, a getter, a revoked proxy, and a prototype
// lookup are JavaScript exceptions, so each passes through its catch
// unchanged, and EK9204 says the catch can never run. JSON.parse's shipped
// contract makes its SyntaxError a typed failure, which the catch receives.
import { primitive, getter, revoked, prototype } from "./fixtures.js"

export const f = (x: unknown): string => {
  try {
    return String(x)
  } catch {
    return ""
  }
}

export const messageOf = (x: { message: string }): string => {
  try { return x.message } catch (e) {
    return "never"
  }
}

export const prototypeOf = (x: object): string => {
  try { Object.getPrototypeOf(x); return "ok" } catch { return "" }
}

export const parseOr = (text: string): string => {
  try { JSON.parse(text); return "parsed" } catch (e) {
    const caught: SyntaxError = e
    return caught instanceof SyntaxError ? "syntax" : "other"
  }
}

export { primitive, getter, revoked, prototype }
