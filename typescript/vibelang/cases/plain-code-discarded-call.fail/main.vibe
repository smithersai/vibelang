// expect: EK4801
// A constructor, a static block and an accessor are plain JavaScript (VIP-1):
// a call there gives the Effect unrun, so a statement that discards it, or a
// program it names, discards a program that never runs.
effect function work() { try sleep("1 millis"); return 1 }

class Box {
  constructor() { work() }
  static { work() }
  get value() { work(); return 1 }
  set value(_value: number) { work() }
}

class References {
  constructor() { work }
  static { work }
}
