// runtime witness
// rule-evidence: docs/design/src/002-running.md#77f679a26f083bde
// Chapter 002: Write `x catch effect (e) => { B }` for an Effect handler, or `x catch (e) => { B }` for a plain fallback.
// rule-evidence: docs/design/src/002-running.md#052cefbb0e6acb87
// Chapter 002: Both explicit repairs have `Success(0)` in these counterparts.
// rule-evidence: docs/design/src/002-running.md#d712f7fedca0d812
// Chapter 002: `e catch h` runs `e`.
// rule-evidence: docs/design/src/002-running.md#5c95e362ed7afe23
// Chapter 002: `h` is evaluated only on failure.
// rule-evidence: docs/design/src/002-running.md#ce6fb4678236c23d
// Chapter 002: An `effect` block is an ordinary operand, so `effect { try write(x); try close() } catch effect (e) => try log(e)` replaces the banned `try { } catch { }` statement:
// rule-evidence: docs/design/src/002-running.md#659323a3b6e4b300
// Chapter 002: | `x catch h`, `h` a plain function: `x catch (e) => f(e)` is `(e) => Effect.succeed(f(e))`, and `x catch () => guest` is `() => Effect.succeed(guest)`.
import { Effect } from "effect"
export effect function main() {
 let n = 0
 const a = effect { try Effect.sync(() => { n += 1 }); throw "bad" } catch (e) => 0
 const b = effect { throw "bad" } catch effect (e) => try Effect.succeed(0)
 const c = Effect.succeed(7) catch () => { n += 100; return 0 }
 return [a,b,c,n]
}
