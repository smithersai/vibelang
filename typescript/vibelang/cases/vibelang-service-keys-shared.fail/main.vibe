// expect: EK3001
// Two services with the same key would share one slot in a Context (D1). The
// key is the package, the module path, and the class name, so two classes
// named Local in one module collide.
// Its project emits no declarations, so the sidecar cannot name Local (TS4058)
// only where a .ts file imports the module, and none does (foldkit-33).
import { Effect } from "effect"

export function first() {
  service Local {
    value(): Effect.Effect<number, never, never>
  }
  return Local
}

export function second() {
  service Local {
    value(): Effect.Effect<string, never, never>
  }
  return Local
}
