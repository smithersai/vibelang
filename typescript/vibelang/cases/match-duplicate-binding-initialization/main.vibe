// expect-result: [["ReferenceError"],0,["ReferenceError"],["ReferenceError"],0,1,"s",["ReferenceError"],4,["ReferenceError"],1,3,["ReferenceError"],0]
// Chapter 4 keeps the pinned duplicate-initialization rule inside one
// top-level pattern: same-keyword bindings of one name share a cell, a second
// one that runs throws ReferenceError, and only a later alternative of the or
// whose failed alternative bound the name may replace it.
import { Effect } from "effect"
effect function list(a: unknown) { return match (a) { when [let x, let x]: x; default: 0; } }
effect function both(a: unknown) { return match (a) { when let x and let x: x; default: 0; } }
effect function object(a: unknown) { return match (a) { when { p: let x, q: let x }: x; default: 0; } }
effect function replace(a: unknown) { return match (a) { when [let x and String] or { length: let x }: x; default: 0; } }
effect function twoOrs(a: unknown) { return match (a) { when ([9] or [let y]) and ({ k: 9 } or { k: let y }): y; default: -1; } }
effect function skipped(a: unknown) { return match (a) { when ([9] or [let y]) and ({ k: let y } or { j: 1 }): y; default: -1; } }
effect function outside(a: unknown) { return match (a) { when ([let x and 5] or [6]) and let x: x; default: -1; } }
effect function outer(a: unknown) { return match (a) { when (([let x and 5] or [6]) and { length: 2 }) or { length: let x }: x; default: -1; } }
effect function alternatives(a: unknown) { return match (a) { when [1, let x] or [let x, 1]: x; default: -1; } }
function inIf(a: unknown): unknown { if (a is { p: let v, q: let v }) return v; return 0 }
effect function exitOf(e: unknown!!) { const r = try exit(e); return r._tag === "Success" ? r.value : r.cause.reasons.map((x) => x._tag === "Die" ? String((x.defect as Error).name) : x._tag) }
export effect function main() {
  return [
    try exitOf(list([1, 2])), try exitOf(list([1])), try exitOf(both(3)), try exitOf(object({ p: 1, q: 2 })), try exitOf(object({ p: 1 })),
    try exitOf(replace([5])), try exitOf(replace(["s"])), try exitOf(twoOrs(Object.assign([4], { k: 6 }))), try exitOf(skipped(Object.assign([4], { j: 1 }))),
    try exitOf(outside([6])), try exitOf(outer([6])), try exitOf(alternatives([3, 1])), try exitOf(Effect.sync(() => inIf({ p: 1, q: 2 }))), try exitOf(Effect.sync(() => inIf({ p: 1 })))
  ]
}
