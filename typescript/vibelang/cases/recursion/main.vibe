// Functions that call each other write their contracts: a failure that
// reaches a function only through its call cycle is stated, not inferred, so
// each function here names both Even and Odd.
export class Even extends TaggedError("Even")<{ readonly n: number }> {}
export class Odd extends TaggedError("Odd")<{ readonly n: number }> {}

export effect function isOdd(n: number): Effect<boolean, Even | Odd, never> {
  if (n === 7) throw new Odd({ n })
  if (n === 0) return false
  return try isEven(n - 1)
}

export effect function isEven(n: number): Effect<boolean, Even | Odd, never> {
  if (n === 100) throw new Even({ n })
  if (n === 0) return true
  return try isOdd(n - 1)
}

// A caller outside the cycle reads the written contracts.
export effect function parity(n: number) {
  try {
    return try isEven(n) ? "even" : "odd"
  } catch (e) {
    return e._tag
  }
}

// A self-recursive function writes its contract too, even though its success
// type does not depend on itself: total is declared as a number.
interface Entry {
  size: number
  children: ReadonlyArray<string>
}

export class Missing extends TaggedError("Missing")<{ readonly path: string }> {}

const tree = new Map<string, Entry>([
  ["/", { size: 0, children: ["a", "b"] }],
  ["/a", { size: 10, children: [] }],
  ["/b", { size: 0, children: ["c"] }],
  ["/b/c", { size: 32, children: [] }]
])

effect function stat(path: string) {
  const entry = tree.get(path)
  if (entry === undefined) throw new Missing({ path })
  return entry
}

export effect function totalSize(path: string): Effect<number, Missing, never> {
  const entry: Entry = try stat(path)
  let total = entry.size
  for (const child of entry.children) total += try totalSize(path === "/" ? `/${child}` : `${path}/${child}`)
  return total
}

// expect-result: {"parity":["even","odd","Odd","Even"],"size":42}
export effect function main() {
  return { parity: [try parity(4), try parity(3), try parity(8), try parity(100)], size: try totalSize("/") }
}
