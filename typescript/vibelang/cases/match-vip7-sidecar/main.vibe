import { Effect } from "effect"
export error E { n:number }
export schema error S { id:string }
export function read(x:unknown):unknown{return match(x){when E(let e):e.n;when S(let e):e.id;default:"other";}}
export function main():Effect.Effect<readonly unknown[]>{return Effect.sync(()=>[read({_tag:"E",n:1}),read({_tag:"S",id:"x"}),read({})])}
