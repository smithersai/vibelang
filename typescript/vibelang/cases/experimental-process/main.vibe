// expect-result: {"pid":true,"platform":true,"running":true,"missing":"NotFound","refused":"BadArgument","fake":"win32"}
import { ExperimentalNodeProcess } from "vibelang-runtime/experimental/platform-node"
import { layerTest, Process } from "vibelang-runtime/experimental/Process"

effect function observe() {
  const pid = try Process.pid()
  return {
    pid: pid > 0,
    platform: typeof try Process.platform() === "string",
    running: try Process.isRunning(pid),
    missing: Process.kill(4194000) catch (e) => e.reason._tag,
    refused: Process.isRunning(0) catch (e) => e.reason._tag,
  }
}

effect function fakePlatform() {
  provide layerTest({ platform: Effect.succeed("win32") }) {
    return try Process.platform()
  }
}

export effect function main() {
  provide ExperimentalNodeProcess.layer {
    return { ...try observe(), fake: try fakePlatform() }
  }
}
