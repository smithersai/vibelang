// rule-evidence: docs/design/vips/0014-effect-modules-in-scope.md#decision
// VIP-14: with the DOM library loaded, the platform-specific names Request,
// Option, Cache, FileSystem, Scheduler and Console mean Effect's modules bare,
// in values and in types.
// expect-result: [true,true,true,true,true,true,1]
import { modules } from "./modules.ts"

const some: Option.Option<number> = Option.some(1)

export effect function main() {
  return [
    Request === modules.Request,
    Option === modules.Option,
    Cache === modules.Cache,
    FileSystem === modules.FileSystem,
    Scheduler === modules.Scheduler,
    Console === modules.Console,
    Option.getOrElse(some, () => 0),
  ]
}
