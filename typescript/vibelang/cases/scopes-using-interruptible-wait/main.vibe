// using adds no mask (D490): an initializer that waits and returns a
// Disposable without requiring Scope runs with the interruptibility in force
// where the using stands, so an interruption that arrives while it waits
// ends the wait, and using registers and disposes nothing.
// expect-result: []
export effect function main() {
  const events: string[] = []
  const entered = try Deferred.make<void>()
  const gate = try Deferred.make<void>()
  effect function open() {
    try Deferred.succeed(entered, undefined)
    try Deferred.await(gate)
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }
  effect function work() { using resource = try open() }
  const child = try Effect.forkChild(effect { return try work() })
  try Deferred.await(entered)
  child.interruptUnsafe(98765)
  try Deferred.succeed(gate, undefined)
  try Fiber.await(child)
  return events
}
