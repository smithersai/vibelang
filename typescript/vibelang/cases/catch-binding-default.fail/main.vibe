// expect: EK9201 EK9202
// A catch binding's defaults run in the handler, after the try block, so a
// contract must allow what they raise and need (D13): failing can fail with
// Fallback, and needing needs Lookup.
error Fallback
service Lookup { value: number }

effect function fallback(): number!Fallback! { throw new Fallback() }

export effect function failing(): number!! {
  try { throw {} as { id?: number } }
  catch ({ id = try fallback() }) { return id }
}

export effect function needing(): number!! {
  try { throw {} as { id?: number } }
  catch ({ id = (try Lookup()).value }) { return id }
}
