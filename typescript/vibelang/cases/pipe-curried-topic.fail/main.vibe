// expect: TS2345 EK2301
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
// The stage's default must match the concrete schema; a missing topic stays invalid.
export const wrong = Schema.String |> Schema.withDecodingDefaultKey(Effect.succeed(123))(%)
export const missing = Schema.String |> Schema.withDecodingDefaultKey(Effect.succeed("default"))
