import { Effect, Match } from "effect"
export function choose(value: unknown): string {
  return Match.value(value).pipe(
    Match.when(Match.instanceOf(String), (): string => "hit"),
    Match.orElse((): string => "miss"))
}
export function main() { return Effect.succeed(["x", new String("x"), "", new String(""), 7, null].map(choose)) }
