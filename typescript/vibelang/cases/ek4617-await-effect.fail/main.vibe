// expect: EK0103
// docs/design/vips/0001-effect-and-async-functions.md#f3c80247f74fd1a4
// VIP-1: await is not Effect execution
// An async function means what it means in TypeScript (VIP-1): await waits
// for a promise. An Effect goes through runPromise first (VIP-5), so awaiting
// one is EK0103; awaiting a promise is fine.
export async function load() {
  return 1
}

export const loadAll = async () => [await load()]

export class Repo {
  async find(id: string) {
    await sleep("1 millis")
    return id
  }
}
