// expect: EK2003
// A method's plain return annotation is its type in the declaration file and
// through any interface its class satisfies, so a method that runs an Effect
// under one is EK2003, as a function is (D74). Each method below would return
// an unrun Effect where its annotation promises a number, and read would hide
// its requirement, Count. method-effect-contract-dts writes their contracts.
service Count { n: number }

interface CounterApi { count(): number }

export class Counter {
  count(): number {
    sleep("1 millis")
    return 42
  }
  read(): number {
    return Count().n
  }
  static make(): number {
    sleep("1 millis")
    return 1
  }
}

export const tally = {
  next(): number {
    sleep("1 millis")
    return 1
  }
}

export function main() {
  const counter: CounterApi = new Counter()
  try Console.log(counter.count() + 1)
}
