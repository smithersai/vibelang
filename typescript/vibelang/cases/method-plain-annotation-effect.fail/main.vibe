// expect: EK0501 EK4801 TS2339
// A method without the effect modifier is plain (VIP-1), whatever its
// annotation, so a method that runs an Effect with try is EK0501, as a
// function is. Its quick fix marks the method effect; method-effect-contract-dts
// writes their contracts.
service Count { n: number }

interface CounterApi { count(): number }

export class Counter {
  count(): number {
    try sleep("1 millis")
    return 42
  }
  read(): number {
    return (try Count).n
  }
  static make(): number {
    try sleep("1 millis")
    return 1
  }
}

export const tally = {
  next(): number {
    try sleep("1 millis")
    return 1
  }
}

export effect function main() {
  const counter: CounterApi = new Counter()
  try Console.log(counter.count() + 1)
}
