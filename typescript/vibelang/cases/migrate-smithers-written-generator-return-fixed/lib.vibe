
type Outcome = { readonly kind: "ok"; readonly value: number }
export const observed: number[] = []

export const event = (bad: boolean) => (effect (): Outcome!string!never => {
  if (bad) throw "bad"
  observed.push(1)
  return { kind: "ok", value: 7 }
})()

export const clock = () => (effect (): Outcome!never!never => {
  return { kind: "ok", value: 9 }
})()
