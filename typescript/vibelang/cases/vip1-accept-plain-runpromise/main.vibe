// expect-result: {"render":7,"isPromise":true,"page":"page:/a"}
import { render, renderPage } from "./lib.vibe"

export effect function main() {
  const pending = render()
  const isPromise = pending instanceof Promise
  const v = try Effect.promise(() => pending)
  const page = try Effect.promise(() => renderPage({ path: "/a" }))
  return { render: v, isPromise, page }
}
