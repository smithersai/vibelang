export error MissingUser { id: string }

export function findUser(id: string): string!MissingUser! {
  if (id === "") throw new MissingUser({ id })
  return id
}

export service Accounts {
  balance(id: string): number!MissingUser
}

export function total(id: string) {
  return Accounts.balance(id)
}

export const AccountsLive = Layer.effect(Accounts, effect {
  const rate = 2
  return {
    balance(id) {
      return id.length * rate
    }
  }
})

export function balanceWith(id: string) {
  provide AccountsLive {
    return Accounts.balance(id)
  }
}

export function recover(id: string) {
  try {
    return findUser(id)
  } catch (e) {
    return match (e) {
      when MissingUser: e.id;
    }
  }
}

export control Approval {
  approve(request: string): boolean!!
}

export function approved(version: string) {
  try {
    return Approval.approve(version) ? "approved" : "declined"
  } handle Approval.approve(request) {
    resume(request.startsWith("v"))
  }
}

export schema Place {
  city: string
}

export schema Profile {
  name: string
  tier: "free" | "pro"
  home: Place
}

export function tierOf(profile: Profile) {
  return profile.tier
}
