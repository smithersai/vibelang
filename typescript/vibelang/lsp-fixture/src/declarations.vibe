export error MissingUser { id: string }

export effect function findUser(id: string): string!MissingUser! {
  if (id === "") throw new MissingUser({ id })
  return id
}

export service Accounts {
  balance(id: string): number!MissingUser
}

export effect function total(id: string) {
  return try (try Accounts).balance(id)
}

export const AccountsLive = Layer.effect(Accounts, effect {
  const rate = 2
  return {
    effect balance(id) {
      return id.length * rate
    }
  }
})

export effect function balanceWith(id: string) {
  provide AccountsLive {
    return try (try Accounts).balance(id)
  }
}

export effect function recover(id: string) {
  return findUser(id) catch (e) => match (e) {
    when MissingUser: e.id;
  }
}

export service Approval {
  approve(request: string): boolean!!
}

export effect function approved(version: string) {
  provide Approval = { effect approve(request) { return request.startsWith("v") } } {
    return (try (try Approval).approve(version)) ? "approved" : "declined"
  }
}

export schema Place {
  city: string
}

export schema Profile {
  name: string
  tier: "free" | "pro"
  home: Place
}

export function tierOf(profile: Profile) {
  return profile.tier
}
