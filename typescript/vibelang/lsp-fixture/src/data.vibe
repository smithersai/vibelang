// A data type (D307): hover, completion and go to definition on its variants.
export data Delivery {
  Waiting
  Sent { tracking: string }
  Rejected { reason: string }
}

export function describe(delivery: Delivery) {
  return match (delivery) {
    when { _tag: "Waiting" }: "waiting";
    when { _tag: "Sent", let tracking }: tracking;
    when { _tag: "Rejected", let reason }: reason;
  }
}

export const sent = Delivery.Sent({ tracking: "parcel-8" })
export const waiting = Delivery.Waiting()

export function latest(deliveries: ReadonlyArray<Delivery>): string {
  return match (deliveries.at(-1)) {
    when { _tag: "Sent", let tracking }: `latest ${tracking}`;
    default: "none";
  }
}
