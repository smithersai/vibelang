// Hover Markdown in a .vibe file: VibeLang's notes, then a rule, then the JSDoc.

/** Greets someone by name. */
export function greet(name: string) {
  sleep("1 millis")
  return `Hello, ${name}`
}

export function shout(name: string) {
  sleep("1 millis")
  return name.toUpperCase()
}

export function welcome() {
  const greeting = greet("Ada")
  const loud = shout("Ada")
  return greeting + loud
}
