// Catch expressions (VIP-5): a fallback function, and a handler that matches the failure.
error Missing { id: string }
error Late

effect function findUser(id: string): string!(Missing | Late)! {
  if (id === "") throw new Missing({ id })
  if (id === "late") throw new Late()
  return id
}

export effect function userOrGuest(id: string) {
  return findUser(id) catch () => "guest"
}

export effect function describeUser(id: string) {
  return findUser(id) catch (failure) => match (failure) {
    when Missing: `missing ${failure.id}`;
    when Late: "late";
  }
}
