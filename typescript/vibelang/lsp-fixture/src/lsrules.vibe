// Rules from Effect's language service (D240), with their quick fixes.
service Name {
  value(): string!!
}

service Greeting {
  text(): string!!
}

const NameLive = Layer.succeed(Name, {
  effect value() {
    return "Ada"
  }
})

const GreetingLive = Layer.effect(Greeting, effect {
  const name = try Name
  return {
    effect text() {
      return `Hello, ${try name.value()}`
    }
  }
})

export effect function discard(program: Effect.Effect<number>) {
  program
  // @vibelang-diagnostics-next-line EK4801:off
  program
  return 0
}

export effect function greet() {
  provide NameLive {
    provide GreetingLive {
      return try (try Greeting).text()
    }
  }
}

export const recover = Effect.catchAll
