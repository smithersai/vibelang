// Await in effect code is EK0102, repaired with join or try Deferred.await.
effect function count(): number!! {
  return 1
}

export effect function joinOld() {
  const f = fork count()
  return await f
}

export effect function waitOld() {
  const d = try Deferred.make<number>()
  try Deferred.succeed(d, 2)
  return await d
}

import type { Fiber as FiberType, Deferred as DeferredType } from "effect"
export async function nativeFiber(f: FiberType.Fiber<number>) { return await f }
export async function nativeDeferred(d: DeferredType.Deferred<number>) { return await d }
