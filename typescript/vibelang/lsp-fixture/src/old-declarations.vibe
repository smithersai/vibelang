// Older spellings: EK2120 and EK2121 warn, and their quick fixes write
// service without class and the Layer.effect block.
service class Greeting {
  text(): string!!
}

layer GreetingLive: Greeting {
  const word = "hi"
  effect text() { return word }
}

export effect function greetingOld() {
  provide GreetingLive {
    return try (try Greeting).text()
  }
}
