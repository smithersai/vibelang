// Retired service class and layer declarations report EK0909 and EK2121.
// Their quick fixes write service without class and the Layer.effect block.
service class Greeting {
  text(): string!!
}

layer GreetingLive: Greeting {
  const word = "hi"
  effect text() { return word }
}

export effect function greetingOld() {
  provide GreetingLive {
    return try (try Greeting).text()
  }
}
