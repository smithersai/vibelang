{
  "key": "platform:ipv6-zone-predicate",
  "oracle": "Node26 net.isIPv6; Effect owns bare parsing, while the additional pure predicate retains native ASCII zones without numeric bounds.",
  "cases": [
    { "input": "::1", "expected": true },
    { "input": "fe80::1%eth0", "expected": true },
    { "input": "::1%4294967296", "expected": true },
    { "input": "::1%0000004294967296", "expected": true },
    { "input": "::1%💩", "expected": false },
    { "input": "::1%eth_0", "expected": false },
    { "input": "::1%", "expected": false },
    { "input": "::1%1%2", "expected": false },
    { "input": "::1%eth0:1-2.3", "expected": true },
    { "input": "::ffff:127.0.0.1%eth0", "expected": true },
    { "input": "::ffff:127.000.0.1", "expected": false },
    { "input": "127.0.0.1", "expected": false },
    { "input": "[::1%eth0]", "expected": false },
    { "input": " :::1 ", "expected": false }
  ]
}
