{
  "name": "vibelang-runtime",
  "version": "0.0.11",
  "description": "The VibeLang continuation kernel and generated-code runtime helpers.",
  "keywords": [
    "vibelang",
    "effect",
    "runtime",
    "continuations"
  ],
  "homepage": "https://vibelang.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/vibelang.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/smithersai/vibelang/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/entry.js",
      "bun": "./dist/entry.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/kernel.d.ts",
      "import": "./dist/kernel/kernel.js",
      "default": "./dist/kernel/kernel.js"
    },
    "./data-methods": {
      "types": "./dist/data-methods.d.ts",
      "import": "./dist/data-methods.js",
      "default": "./dist/data-methods.js"
    },
    "./experimental": {
      "types": "./dist/experimental/index.d.ts",
      "import": "./dist/experimental/index.js",
      "default": "./dist/experimental/index.js"
    },
    "./experimental/Crypto": {
      "types": "./dist/experimental/Crypto.d.ts",
      "import": "./dist/experimental/Crypto.js",
      "default": "./dist/experimental/Crypto.js"
    },
    "./experimental/FileSystem": {
      "types": "./dist/experimental/FileSystem.d.ts",
      "import": "./dist/experimental/FileSystem.js",
      "default": "./dist/experimental/FileSystem.js"
    },
    "./experimental/Locks": {
      "types": "./dist/experimental/Locks.d.ts",
      "import": "./dist/experimental/Locks.js",
      "default": "./dist/experimental/Locks.js"
    },
    "./experimental/Process": {
      "types": "./dist/experimental/Process.d.ts",
      "import": "./dist/experimental/Process.js",
      "default": "./dist/experimental/Process.js"
    },
    "./experimental/platform-browser": {
      "types": "./dist/experimental/platform-browser/index.d.ts",
      "import": "./dist/experimental/platform-browser/index.js",
      "default": "./dist/experimental/platform-browser/index.js"
    },
    "./experimental/platform-bun": {
      "types": "./dist/experimental/platform-bun/index.d.ts",
      "import": "./dist/experimental/platform-bun/index.js",
      "default": "./dist/experimental/platform-bun/index.js"
    },
    "./experimental/platform-node": {
      "types": "./dist/experimental/platform-node/index.d.ts",
      "import": "./dist/experimental/platform-node/index.js",
      "default": "./dist/experimental/platform-node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && bun test"
  },
  "peerDependencies": {
    "@effect/platform-browser": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "effect": "4.0.6"
  },
  "peerDependenciesMeta": {
    "@effect/platform-browser": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@types/node": "26.6.5",
    "effect": "4.0.6",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1",
    "bun": ">=1.4"
  }
}
