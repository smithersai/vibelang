{
  "name": "vibelang-unplugin",
  "version": "0.0.12",
  "description": "Compile VibeLang source modules with vibelang in webpack, Rollup, Rolldown, esbuild, Rspack, and Bun",
  "keywords": [
    "vibelang",
    "effect",
    "unplugin",
    "webpack-plugin",
    "rollup-plugin",
    "rolldown-plugin",
    "esbuild-plugin",
    "rspack-plugin",
    "bun-plugin"
  ],
  "homepage": "https://vibelang.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/vibelang.git",
    "directory": "packages/unplugin"
  },
  "bugs": {
    "url": "https://github.com/smithersai/vibelang/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "import": "./src/webpack.js"
    },
    "./rollup": {
      "types": "./src/rollup.d.ts",
      "import": "./src/rollup.js"
    },
    "./rolldown": {
      "types": "./src/rolldown.d.ts",
      "import": "./src/rolldown.js"
    },
    "./esbuild": {
      "types": "./src/esbuild.d.ts",
      "import": "./src/esbuild.js"
    },
    "./rspack": {
      "types": "./src/rspack.d.ts",
      "import": "./src/rspack.js"
    },
    "./bun": {
      "types": "./src/bun.d.ts",
      "import": "./src/bun.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.js"
    },
    "./deferred": {
      "types": "./src/deferred.d.ts",
      "import": "./src/deferred.js"
    },
    "./bun/register": {
      "types": "./src/bun-register.d.ts",
      "import": "./src/bun-register.js"
    },
    "./rolldown/register": {
      "types": "./src/register.d.ts",
      "import": "./src/register-rolldown.js",
      "require": "./src/register-rolldown.js"
    },
    "./esbuild/register": {
      "types": "./src/register.d.ts",
      "import": "./src/register-esbuild.js",
      "require": "./src/register-esbuild.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "sh test/run.sh"
  },
  "dependencies": {
    "unplugin": "3.4.0"
  },
  "peerDependencies": {
    "vibelang": "0.0.12"
  },
  "devDependencies": {
    "@rspack/core": "2.2.8",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "fast-glob": "3.3.3",
    "rolldown": "1.2.13",
    "rollup": "4.64.5",
    "vite": "8.3.4",
    "webpack": "5.111.1",
    "vite7": "npm:vite@7.3.6"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  }
}
