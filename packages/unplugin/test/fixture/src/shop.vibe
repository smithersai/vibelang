import { receipt } from "./format.vibe"
import type { Order } from "./order.ts"
import { teaStock } from "./stock.ts"

export error OutOfStock { item: string }

service Inventory {
  stock(item: string): number!OutOfStock
}

const InventoryLive = Layer.succeed(Inventory, {
  stock(item) {
    if (item === "tea") return teaStock
    throw new OutOfStock({ item })
  }
})

function place(order: Order) {
  try {
    const available = Inventory.stock(order.item)
    if (order.quantity > available) return receipt("only", available, order.item)
    return receipt("ordered", order.quantity, order.item)
  } catch (error) {
    return `no ${error.item}`
  }
}

export function shop() {
  return Effect.provide(() => [
    place({ item: "tea", quantity: 2 }),
    place({ item: "tea", quantity: 5 }),
    place({ item: "coffee", quantity: 1 })
  ], InventoryLive)
}
