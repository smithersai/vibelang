import { receipt } from "./format.vibe"
import type { Order } from "./order.ts"
import { teaStock } from "./stock.ts"

export error OutOfStock { item: string }

service Inventory {
  stock(item: string): number!OutOfStock
}

const InventoryLive = Layer.succeed(Inventory, {
  effect stock(item) {
    if (item === "tea") return teaStock
    throw new OutOfStock({ item })
  }
})

effect function place(order: Order) {
  try {
    const available = try Inventory.stock(order.item)
    if (order.quantity > available) return try receipt("only", available, order.item)
    return try receipt("ordered", order.quantity, order.item)
  } catch (error) {
    return `no ${error.item}`
  }
}

export effect function shop() {
  return try Effect.provide(effect { return [
    try place({ item: "tea", quantity: 2 }),
    try place({ item: "tea", quantity: 5 }),
    try place({ item: "coffee", quantity: 1 })
  ] }, InventoryLive)
}
