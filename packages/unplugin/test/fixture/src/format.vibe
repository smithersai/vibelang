// The compiler rewrites shop.vibe's import of this module to ./format.js.
// Its module declaration (D283) is TypeScript, compiled to a module of its
// own, format.vibe.text.js, which is not on disk: every bundler loads it from
// the project's compile (D403). Its import of ./stock.ts resolves from here.
module text {
  import { separator } from "./stock.ts"

  export function line(verb: string, quantity: number, item: string): string {
    return [verb, String(quantity), item].join(separator)
  }
}

import { line } from text

export function receipt(verb: string, quantity: number, item: string) {
  return sync((verb, quantity, item) => line(verb, quantity, item), verb, quantity, item)
}
