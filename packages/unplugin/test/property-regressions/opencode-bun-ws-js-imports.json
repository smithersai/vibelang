        "suffix": ".js",
        "query": ""
      },
      {
        "prefix": "./",
        "name": "Effect",
        "suffix": ".js",
        "query": ""
      },
      {
        "prefix": "./",
        "name": "index",
        "suffix": ".js",
        "query": ""
      },
      {
        "prefix": "./util/",
        "name": "leaf",
        "suffix": "",
        "query": ""
      }
    ]
  }
}
