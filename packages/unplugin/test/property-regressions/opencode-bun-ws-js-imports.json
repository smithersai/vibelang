        "directory": "src/util",
        "name": "leaf",
        "kind": ".vibe"
      },
      {
        "directory": "src",
        "name": "index",
        "kind": ".ts"
      },
      {
        "directory": "node_modules/dep/lib",
        "name": "index",
        "kind": ".js"
      },
      {
        "directory": "node_modules/dep",
        "name": "Effect",
        "kind": ".js"
      }
    ],
    "depProject": false,
    "importers": [
      {
        "directory": "src",
        "vibe": false
