// The mutation self-test's fixture: total's contract is written, so the fork
// and stock TypeScript print the same declaration. run.sh --self-test changes
// its A, E, R, and export in a copy of the mapper's main.d.ts and checks that
// the harness reports each change.
export class Tally {
  readonly count: number = 0
}

export function total(n: number): number!RangeError!Tally {
  if (n < 0) throw new RangeError("negative")
  return n
}

// Unexported, so only the probe exports print it. Its type depends on its
// lambda's form: the self-test flips the lambda to the Effect-function form
// and checks that the harness reports ticks.
function ticks() {
  return Effect.sync(() => 1)
}
