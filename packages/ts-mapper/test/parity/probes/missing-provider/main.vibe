// A probe: main needs the Mailer service and nothing provides it, so the
// runner must reject the program on the mapper side, as the fork does (EK3201).
service Mailer {
  send(to: string): Effect<void, never, never>
}

effect function welcome() {
  try Mailer.send("ada@example.com")
}

export effect function main() {
  try welcome()
}

Effect.runFork(effect { return try main() }) // probe-error: TS2345 Mailer
