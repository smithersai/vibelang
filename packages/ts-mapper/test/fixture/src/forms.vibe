// Each form a lambda, a block, or an argument takes (L1), whose virtual
// TypeScript types forms-check.ts pins.
export error NotFound { id: string }

effect function find(id: string): string!NotFound! {
  if (id === "") throw new NotFound({ id })
  return id
}

// The Effect function form: forEach's callback.
export effect function each(ids: ReadonlyArray<string>) {
  return try Effect.forEach(ids, effect (id) => try find(id))
}

// The program form: retry's first argument.
export effect function retried() {
  return try Effect.retry(effect { return try find("x") }, { times: 1 })
}

// By name: timeout's first argument is a program, so the call does not run.
export effect function timed() {
  return try Effect.timeout(find("x"), "1 second")
}

// A dual's data-first form: the arrow is the program withSpan wraps.
export effect function spanned() {
  return try Effect.withSpan(effect {
    return try find("y")
  }, "load")
}
