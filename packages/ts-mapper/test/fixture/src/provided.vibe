service Greeting {
  text(): string!!
}

const SilentLive = Layer.succeed(Greeting, { text: () => "" })

// provide Key = value projects to $provideEntries, which stock TypeScript
// types as Effect.provide: the block's requirements drop Greeting.
export function provided() {
  provide Greeting = { text: () => "hi" } {
    return Greeting.text()
  }
}

export function mixed() {
  provide SilentLive, Greeting = { text: () => "hi" } {
    return Greeting.text()
  }
}
