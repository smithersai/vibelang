service Greeting {
  text(): string!!
}

const SilentLive = Layer.succeed(Greeting, { text: effect () => "" })

// provide Key = value projects to $provideEntries, which stock TypeScript
// types as Effect.provide: the block's requirements drop Greeting.
export effect function provided() {
  provide Greeting = { text: effect () => "hi" } {
    return try Greeting.text()
  }
}

export effect function mixed() {
  provide SilentLive, Greeting = { text: effect () => "hi" } {
    return try Greeting.text()
  }
}
