error EmptyName { name: string }

effect function shout(text: string): string!! {
  return text.toUpperCase()
}

export effect function greet(name: string) {
  if (name.length === 0) throw new EmptyName({ name })
  const loud = try shout(name)
  console.log(loud)
  const count: number = loud
  return `Hello, ${loud}!`
}
