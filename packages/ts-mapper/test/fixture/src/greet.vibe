error EmptyName { name: string }

function shout(text: string): string!! {
  return text.toUpperCase()
}

export function greet(name: string) {
  if (name.length === 0) throw new EmptyName({ name })
  const loud = shout(name)
  console.log(loud)
  const count: number = loud
  return `Hello, ${loud}!`
}
