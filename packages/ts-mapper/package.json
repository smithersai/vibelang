{
  "name": "vibelang-ts-mapper",
  "private": true,
  "version": "0.0.1",
  "description": "VibeLang's TypeScript 7 content mapper: stock tsc and the TypeScript 7 language server check .vibe files.",
  "keywords": ["vibelang", "effect", "typescript", "content-mapper"],
  "homepage": "https://vibelang.sh",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./prelude": { "types": "./prelude.d.ts" },
    "./package.json": "./package.json"
  },
  "files": ["bin", "prelude.d.ts"],
  "typescript": {
    "contentMapper": {
      "exec": ["./bin/vibelang-mapper"],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "peerDependencies": {
    "effect": "4.1.0",
    "vibelang-runtime": "0.0.1"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "7.1.0-beta"
  }
}
