{
  "name": "vibelang",
  "version": "0.0.11",
  "description": "The VibeLang compiler and language server: a readable syntax for Effect that compiles to JavaScript with TypeScript declarations",
  "keywords": [
    "vibelang",
    "effect",
    "typescript",
    "compiler",
    "language-server"
  ],
  "homepage": "https://vibelang.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/vibelang.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/smithersai/vibelang/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./project": {
      "types": "./project.d.mts",
      "default": "./project.mjs"
    },
    "./register": "./register.mjs",
    "./eslint": "./eslint.mjs",
    "./knip": "./knip.mjs",
    "./bun": "./bun.mjs",
    "./prettier": "./prettier.mjs",
    "./format": "./format.mjs",
    "./ast-grep": "./ast-grep.mjs"
  },
  "bin": {
    "vibelang": "bin/vibelang",
    "vibelang-format": "bin/vibelang-format",
    "vibelang-ast-grep": "bin/vibelang-ast-grep"
  },
  "files": [
    "bin",
    "editor",
    "agents.mjs",
    "cache.mjs",
    "diagnostics.mjs",
    "dprint-plugin.json",
    "eslint.mjs",
    "knip.mjs",
    "project.mjs",
    "relative-imports.mjs",
    "paths-imports.mjs",
    "project.d.mts",
    "register.mjs",
    "bun.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "skills/vibelang/SKILL.md",
    "format.mjs",
    "prettier.mjs",
    "ast-grep.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "vibelang-darwin-arm64": "0.0.11",
    "vibelang-darwin-x64": "0.0.11",
    "vibelang-linux-arm64": "0.0.11",
    "vibelang-linux-x64": "0.0.11",
    "@vibelang/cli-win32-arm64": "0.0.11",
    "@vibelang/cli-win32-x64": "0.0.11"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dependencies": {
    "dprint": "0.64.3"
  }
}
