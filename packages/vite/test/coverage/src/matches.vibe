error Oops { n: number }

effect function step(payload: number): number!Oops! {
  if (payload < 0) throw new Oops({ n: payload })
  return payload
}

export function label(s: "draft" | "review" | "published"): string {
  return match (s) { when "draft": "D"; when "review": "R"; when "published": "P"; }
}

export function sized(n: number): string {
  const kind = match (n) { when 0: "zero"; default: "some"; }
  return kind
}

export effect function describe(n: number): string!Oops! {
  const v = try step(n)
  return match (v) { when 0: "zero"; default: "some"; }
}
