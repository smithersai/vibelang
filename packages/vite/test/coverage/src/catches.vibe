error Oops { n: number }
error Bad { code: string }

effect function step(payload: number): number!Oops! {
  if (payload < 0) throw new Oops({ n: payload })
  return payload
}

const mapped = (cause: Oops): Bad => new Bad({ code: String(cause.n) })

export effect function load(n: number): number!Bad! {
  const a = step(n) catch effect (cause) => throw mapped(cause)
  return a + 1
}

export effect function loadDirect(n: number): number!Bad! {
  return step(n) catch effect (cause) => throw mapped(cause)
}

export effect function orZero(n: number): number!! {
  return step(n) catch () => 0
}

export effect function neverLoaded(n: number): number!Bad! {
  return step(n) catch effect (cause) => throw mapped(cause)
}
