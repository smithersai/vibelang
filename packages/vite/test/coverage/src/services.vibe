error Bad { code: string }

service Users {
  find(id: string): string!Bad
}

export const UsersLive = Layer.succeed(Users, {
  find(id) {
    if (id !== "42") throw new Bad({ code: id })
    return "Ada"
  }
})

export function nameOf(id: string): string!!Users {
  return Users.find(id) catch () => "missing"
}

export function greet(id: string): string!Bad!Users {
  const name = Users.find(id)
  return `hi ${name}`
}

export function neverGreeted(id: string): string!Bad!Users {
  const name = Users.find(id)
  return `bye ${name}`
}
