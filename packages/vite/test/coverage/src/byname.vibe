error Oops { n: number }

effect function step(payload: number): number!Oops! {
  if (payload < 0) throw new Oops({ n: payload })
  return payload
}

export effect function timed(n: number) {
  return try timeout(step(n), "1 second")
}

export effect function pair(n: number): number!Oops! {
  const [x, y] = try Effect.all([step(n), step(n + 1)])
  return x + y
}

export effect function retried(n: number): number!Oops! {
  return try retry(step(n), { times: 2 })
}

export effect function neverRetried(n: number): number!Oops! {
  return try retry(step(n), { times: 2 })
}
