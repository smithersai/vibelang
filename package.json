{
  "name": "vibelang",
  "version": "0.0.1",
  "description": "VibeLang: the programming language for agents. TypeScript-derived, with typed failures, capability contexts, hermetic comptime, and durable execution compiled in.",
  "type": "module",
  "main": "./dist/compiler.js",
  "types": "./dist/compiler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./package.json": "./package.json",
    "./vibe": {
      "types": "./dist/vibe.d.ts",
      "default": "./dist/vibe.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./runtime": {
      "types": "./poc/dist/runtime/index.d.ts",
      "default": "./poc/dist/runtime/index.js"
    },
    "./schema-runtime": {
      "types": "./poc/dist/build/schema-runtime.d.ts",
      "default": "./poc/dist/build/schema-runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions.d.ts",
      "default": "./dist/exceptions.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.ts",
      "default": "./dist/unplugin.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./agent/bun": {
      "types": "./poc/dist/agent/bun.d.ts",
      "default": "./poc/dist/agent/bun.js"
    },
    "./concurrency": {
      "types": "./dist/concurrency.d.ts",
      "default": "./dist/concurrency.js"
    },
    "./concurrency/bun": {
      "types": "./poc/dist/concurrency/index.d.ts",
      "default": "./poc/dist/concurrency/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./durable/authoring": {
      "types": "./poc/dist/durable/authoring.d.ts",
      "default": "./poc/dist/durable/authoring.js"
    },
    "./durable/artifact": {
      "types": "./poc/dist/durable/artifact.d.ts",
      "default": "./poc/dist/durable/artifact.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "default": "./dist/durable.js"
    },
    "./durable/source-compiler": {
      "types": "./poc/dist/durable/source-compiler.d.ts",
      "default": "./poc/dist/durable/source-compiler.js"
    },
    "./durable/bun": {
      "types": "./poc/dist/durable/index.d.ts",
      "default": "./poc/dist/durable/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "default": "./dist/result.js"
    }
  },
  "bin": {
    "tsc": "./bin/vibec.js",
    "vibe": "./bin/vibe.js",
    "vibec": "./bin/vibec.js",
    "vtsc": "./bin/vibec.js"
  },
  "scripts": {
    "clean:dist": "node scripts/clean-root-dist.mjs",
    "clean:poc": "node scripts/clean-poc-dist.mjs",
    "build:poc": "npm run clean:poc && node node_modules/typescript/lib/tsc.js -p poc/tsconfig.emit.json && node scripts/copy-poc-assets.mjs",
    "build": "npm run clean:dist && npm run build:poc && node node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "check": "node scripts/brand-gate.mjs && npm run build:poc && node node_modules/typescript/lib/tsc.js -p tsconfig.build.json --noEmit && node node_modules/typescript/lib/tsc.js -p tsconfig.compat.json && node scripts/go-test-gate.mjs",
    "test": "npm run build && node node_modules/typescript/lib/tsc.js -p tsconfig.compat.json && node node_modules/typescript/lib/tsc.js -p poc/tsconfig.json && node scripts/node-test-gate.mjs && node scripts/poc-test-gate.mjs && node scripts/go-test-gate.mjs && node scripts/oracle-differential.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "gate:premerge": "npm run verify:pack",
    "release:verify": "npm run gate:premerge && npm --prefix docs run build",
    "typescript:fork:status": "node scripts/vendor-typescript.mjs status",
    "typescript:fork:verify": "node scripts/vendor-typescript.mjs verify",
    "typescript:vendor": "node scripts/vendor-typescript.mjs sync",
    "vibec:build": "node scripts/build-vibec.mjs build",
    "vibec:verify-reproducible": "node scripts/build-vibec.mjs verify",
    "prepack": "npm run test",
    "gate:brand": "node scripts/brand-gate.mjs",
    "gate:docs": "node scripts/docs-snippets-gate.mjs",
    "diagnostics:reference": "node scripts/diagnostics-reference.mjs",
    "diagnostics:check": "node scripts/diagnostics-reference.mjs --check",
    "rename:vibelang": "node scripts/rename-to-vibelang.mjs"
  },
  "keywords": [
    "vibelang",
    "typescript",
    "typescript-derived",
    "typed-errors",
    "dependency-injection",
    "comptime",
    "durable-execution",
    "agents",
    "effect",
    "language"
  ],
  "homepage": "https://vibelang.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersai/vibelang.git"
  },
  "license": "MIT",
  "files": [
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "dist",
    "poc/dist",
    "docs/COMPATIBILITY_API.md",
    "docs/TYPESCRIPT_FORK.md",
    "typescript-fork.json",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "incur": "^0.5.1",
    "unplugin": "3.3.0"
  },
  "devDependencies": {
    "@farmfe/core": "1.7.11",
    "@rsbuild/core": "2.2.4",
    "@rspack/core": "2.2.3",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "rolldown": "1.2.7",
    "rollup": "4.63.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "webpack": "5.110.3"
  }
}
